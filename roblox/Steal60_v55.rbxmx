 {id="hero_collection_42",category="hero",name="Хромовый страж · Турбо",description="Оригинальный 3D-костюм: закрытый шлем, бронированные плечи",price=425,color=C(98,124,150),accent=C(156,221,249),style="sentinel",silhouette="sentinel",tier=2},
 {id="hero_collection_43",category="hero",name="Хромовый страж · Элитный",description="Оригинальный 3D-костюм: закрытый шлем, бронированные плечи",price=446,color=C(118,140,163),accent=C(164,224,249),style="sentinel",silhouette="sentinel",tier=3},
 {id="hero_collection_44",category="hero",name="Хромовый страж · Легендарный",description="Оригинальный 3D-костюм: закрытый шлем, бронированные плечи",price=467,color=C(137,157,176),accent=C(173,227,250),style="sentinel",silhouette="sentinel",tier=4},
 {id="hero_collection_45",category="hero",name="Хромовый страж · Абсолют",description="Оригинальный 3D-костюм: закрытый шлем, бронированные плечи",price=422,color=C(156,173,189),accent=C(182,230,250),style="sentinel",silhouette="sentinel",tier=5},
 {id="hero_collection_46",category="hero",name="Солнечный рыцарь · Первый",description="Оригинальный 3D-костюм: световой венец, реактор и плащ",price=443,color=C(179,94,43),accent=C(255,227,116),style="solar",silhouette="solar",tier=1},
 {id="hero_collection_47",category="hero",name="Солнечный рыцарь · Турбо",description="Оригинальный 3D-костюм: световой венец, реактор и плащ",price=464,color=C(187,112,66),accent=C(255,229,127),style="solar",silhouette="solar",tier=2},
 {id="hero_collection_48",category="hero",name="Солнечный рыцарь · Элитный",description="Оригинальный 3D-костюм: световой венец, реактор и плащ",price=485,color=C(196,129,90),accent=C(255,231,138),style="solar",silhouette="solar",tier=3},
 {id="hero_collection_49",category="hero",name="Солнечный рыцарь · Легендарный",description="Оригинальный 3D-костюм: световой венец, реактор и плащ",price=506,color=C(204,147,113),accent=C(255,234,149),style="solar",silhouette="solar",tier=4},
 {id="hero_collection_50",category="hero",name="Солнечный рыцарь · Абсолют",description="Оригинальный 3D-костюм: световой венец, реактор и плащ",price=461,color=C(212,165,136),accent=C(255,236,160),style="solar",silhouette="solar",tier=5},
 {id="pet_orb",category="pet",name="Дрон-искатель",description="Четыре вращающихся ротора с мятными кончиками лопастей и живые глаза",price=115,color=C(99,219,255),movement="fly"},
 {id="pet_fox",category="pet",name="Лисёнок",description="Один цельный пушистый хвост с белым кончиком",price=210,color=C(243,146,75),movement="ground"},
 {id="pet_bot",category="pet",name="Мятный робот",description="Капсульный корпус, экран-улыбка и светящееся сердце",price=300,color=C(139,221,191),movement="ground"},
 {id="pet_star",category="pet",name="Звёздный спутник",description="Живая золотая звезда с улыбкой и сияющими лучами",price=490,color=C(252,211,78),movement="fly"},
