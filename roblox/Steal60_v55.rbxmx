     Vector3.new(side*(.77+i*.23),.43+i*.09,-.08),i%2==0 and C(255,224,110) or C(247,163,80),side*.27)
   end
   orb('Колечко_глаза',side*.26,.52,-.78,.17,.21,.055,C(113,60,50))
   orb('Огонёк_в_глазу',side*.26-.026,.55,-.85,.06,.09,.03,pearl)
  end
  for i=1,3 do
   bar('Чешуйки_на_груди_'..i,0,.08-i*.18,-.52,.36+i*.1,.065,.11,
       i==2 and C(255,218,92) or C(177,77,59))
  end
 elseif id=='pet_ufo' then
  for i=1,8 do
   local a=i*math.pi/4
   orb('Стальной_болт',math.cos(a)*.84,-.12,math.sin(a)*.72,.09,.085,.09,C(176,196,209),Enum.Material.Metal)
  end
  bar('Рамка_стекла',0,.47,-.51,.51,.06,.12,graphite,nil,Enum.Material.Metal)
