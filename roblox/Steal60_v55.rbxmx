local function row(name,y,sz,tint)
    local t=Instance.new("TextLabel")
    t.Name=name;t.BackgroundTransparency=1
    t.Position=UDim2.fromOffset(12,y)
    t.Size=UDim2.new(1,-24,0,sz+4)
    t.TextColor3=tint;t.Font=Enum.Font.GothamBold
    t.TextSize=sz;t.TextXAlignment=Enum.TextXAlignment.Left
    t.TextTruncate=Enum.TextTruncate.AtEnd
    t.Parent=panel
    return t
end
local title=row("Title",7,11,C(255,207,115))
local job=row("Contract",27,14,C(245,245,247))
local status=row("RoadStatus",54,11,C(162,208,220))
local hint=row("Bonus",73,10,C(143,214,166))
while panel.Parent do
    local name=player:GetAttribute("RoadContractTitle")
    local money=player:GetAttribute("RoadContractReward") or 0
    title.Text="СПЕЦЗАКАЗ / ГОРОДСКИЕ СОБЫТИЯ"
    job.Text=name and (name.."  ·  +"..tostring(money).."$") or "Загрузка контракта..."
    local event=player:GetAttribute("RoadEventHint")
    status.Text=(event and event~="") and event or "Ищи машины с золотой меткой ★"
    hint.Text=(player:GetAttribute("RoadCheckpointCount") or 0)&gt;0 and "Объезд полиции: +10% за поездку" or "Проезжай посты по свободной полосе"
    task.wait(.45)
end
</ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX_THEFT_HUD_V9_001"><Properties><string name="Name">TheftHUD</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Salon theft progress HUD with clearer progression preview.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local player = Players.LocalPlayer
local gui = script.Parent
local C = Color3.fromRGB
local AccessoryConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"):WaitForChild("AccessoryConfig"))

local panel = Instance.new("Frame")
panel.Name = "TheftProgress"
panel.AnchorPoint = Vector2.new(1,0)
panel.Position = UDim2.new(1,-18,0,340)
panel.Size = UDim2.fromOffset(290,150)
panel.BackgroundColor3 = C(21,26,38)
panel.BackgroundTransparency = .10
panel.BorderSizePixel = 0
panel.Parent = gui
local function updateVisibility()
    panel.Visible = player:GetAttribute("Steal60DetailsOpen") == true and player:GetAttribute("Steal60MenuOpen") ~= true
end
player:GetAttributeChangedSignal("Steal60DetailsOpen"):Connect(updateVisibility)
player:GetAttributeChangedSignal("Steal60MenuOpen"):Connect(updateVisibility)
updateVisibility()
local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0,12)
corner.Parent = panel
local stroke = Instance.new("UIStroke")
stroke.Color = C(102,190,161)
stroke.Transparency = .42
stroke.Parent = panel

local function makeLabel(name,pos,size,txt,color,font,pt)
    local t=Instance.new("TextLabel")
    t.Name=name
    t.BackgroundTransparency=1
    t.Position=pos
    t.Size=size
    t.TextXAlignment=Enum.TextXAlignment.Left
    t.TextYAlignment=Enum.TextYAlignment.Top
    t.Font=font or Enum.Font.GothamMedium
    t.TextSize=pt or 12
    t.TextColor3=color or C(224,235,244)
    t.TextWrapped=true
    t.Text=txt or ""
    t.Parent=panel
    return t
end

makeLabel("Title", UDim2.fromOffset(13,8), UDim2.new(1,-26,0,18), "НАЛЁТЫ НА САЛОНЫ", C(139,242,195), Enum.Font.GothamBold, 15)
local iconBack = Instance.new("Frame")
iconBack.Position = UDim2.fromOffset(13,34)
iconBack.Size = UDim2.fromOffset(52,52)
iconBack.BackgroundColor3 = C(31,44,60)
iconBack.BorderSizePixel = 0
iconBack.Parent = panel
local ic = Instance.new("UICorner")
ic.CornerRadius = UDim.new(0,10)
ic.Parent = iconBack
local iconTitle = Instance.new("TextLabel")
iconTitle.BackgroundTransparency = 1
iconTitle.Size = UDim2.new(1,0,1,0)
iconTitle.Font = Enum.Font.GothamBlack
iconTitle.TextSize = 28
iconTitle.Text = "1"
iconTitle.TextColor3 = C(255,215,110)
iconTitle.Parent = iconBack

local progress = makeLabel("Progress", UDim2.fromOffset(75,34), UDim2.new(1,-88,0,18), "Налёт на салон: 0/50", C(243,245,248), Enum.Font.GothamBold, 15)
local itemName = makeLabel("ItemName", UDim2.fromOffset(75,56), UDim2.new(1,-88,0,18), "Следующая деталь", C(103,217,245), Enum.Font.GothamBold, 13)
local desc = makeLabel("Desc", UDim2.fromOffset(75,78), UDim2.new(1,-88,0,16), "+0% к деньгам за угоны", C(198,211,225), Enum.Font.GothamMedium, 12)
local footer = makeLabel("Footer", UDim2.fromOffset(13,119), UDim2.new(1,-26,0,14), "", C(126,255,176), Enum.Font.GothamBold, 11)

local bar = Instance.new("Frame")
bar.Position = UDim2.fromOffset(75,108)
bar.Size = UDim2.new(1,-88,0,7)
bar.BackgroundColor3 = C(50,61,74)
bar.BorderSizePixel = 0
bar.Parent = panel
local bc = Instance.new("UICorner")
bc.CornerRadius = UDim.new(0,4)
bc.Parent = bar
local fill = Instance.new("Frame")
fill.Size = UDim2.fromScale(0,1)
fill.BackgroundColor3 = C(102,240,184)
fill.BorderSizePixel = 0
fill.Parent = bar
local fc = Instance.new("UICorner")
fc.CornerRadius = UDim.new(0,4)
fc.Parent = fill

local function update()
    local count = tonumber(player:GetAttribute("TheftCount")) or 0
    local level = tonumber(player:GetAttribute("TheftLevel")) or 1
    local untilTime = tonumber(player:GetAttribute("TheftCooldownUntil")) or 0
    local bonus = tonumber(player:GetAttribute("TheftIncomeBoostPct")) or 0
    local remain = math.max(0, math.ceil(untilTime - workspace:GetServerTimeNow()))
    local need = AccessoryConfig.SALON_STEALS_PER_DROP
    local current=count%need
    local zone=math.clamp(math.floor(tonumber(player:GetAttribute("LastHeistZone")) or 1),1,5)
    local pool={}
    for _,part in ipairs(AccessoryConfig.List) do
        if part.zone==zone then table.insert(pool,part) end
    end
    local part=pool[(math.floor(count/need)%#pool)+1]
    progress.Text = ("Налёт на салон: %d/%d"):format(current,need)
    itemName.Text = "Пример: "..part.name
    itemName.TextColor3 = part.color
    desc.Text = ("Район %d · +%d%% (случайная деталь)"):format(zone,part.basePct)
    fill.Size = UDim2.new(math.clamp(current/need,0,1),0,1,0)
    fill.BackgroundColor3 = part.color
    iconTitle.Text = "★"
    iconTitle.TextColor3 = part.color
    footer.Text = remain &gt; 0 and (("Откат: %d:%02d  ·  суммарный бонус: +%d%%"):format(math.floor(remain/60), remain%60, bonus)) or (("Готов к налёту  ·  суммарный бонус: +%d%%"):format(bonus))
end
for _, attr in ipairs({"TheftCount","TheftLevel","TheftCooldownUntil","TheftIncomeBoostPct","LastHeistZone","Steal60MenuOpen","Steal60DetailsOpen"}) do
    player:GetAttributeChangedSignal(attr):Connect(update)
end
update()
task.spawn(function()
    while panel.Parent do
        task.wait(1)
        update()
        updateVisibility()
    end
end)
</ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX_TUTORIAL_HUD_V14"><Properties><string name="Name">TutorialHUD</string><ProtectedString name="Source">-- A compact coach, a persistent handbook and a server-selected world marker.
local Players=game:GetService('Players')
local RS=game:GetService('ReplicatedStorage')
local player=Players.LocalPlayer;local gui=script.Parent
local Config=require(RS:WaitForChild('Shared'):WaitForChild('TutorialConfig'))
local remotes=RS:WaitForChild('Remotes');local action=remotes:WaitForChild('TutorialAction')
local C=Color3.fromRGB;local snapshot={index=1,total=#Config.Steps,done={}};local collapsed=false
local function round(p,r)local c=Instance.new('UICorner');c.CornerRadius=UDim.new(0,r);c.Parent=p end
local function label(parent,pos,size,pt,color,bold)
 local t=Instance.new('TextLabel');t.BackgroundTransparency=1;t.Position=pos;t.Size=size;t.Font=bold and Enum.Font.GothamBold or Enum.Font.Gotham
 t.TextSize=pt;t.TextColor3=color;t.TextWrapped=true;t.TextXAlignment=Enum.TextXAlignment.Left;t.Parent=parent;return t
end
local function button(parent,text,pos,size,fn)
 local b=Instance.new('TextButton');b.Text=text;b.Position=pos;b.Size=size;b.Font=Enum.Font.GothamBold;b.TextSize=12
 b.BackgroundColor3=C(108,231,184);b.TextColor3=C(15,34,40);b.BorderSizePixel=0;b.Parent=parent;round(b,8)
 b.Activated:Connect(fn);return b
end
local coach=Instance.new('Frame');coach.Name='Steal60LessonCoach';coach.AnchorPoint=Vector2.new(0,1);coach.Position=UDim2.new(0,16,1,-105)
coach.Size=UDim2.new(.92,0,0,218);coach.BackgroundColor3=C(14,27,40);coach.BackgroundTransparency=.04;coach.BorderSizePixel=0;coach.Parent=gui;round(coach,13)
local limit=Instance.new('UISizeConstraint');limit.MaxSize=Vector2.new(390,218);limit.Parent=coach
local stroke=Instance.new('UIStroke');stroke.Color=C(103,232,190);stroke.Transparency=.2;stroke.Parent=coach
local progress=label(coach,UDim2.fromOffset(14,8),UDim2.new(1,-54,0,20),11,C(113,235,185),true)
local title=label(coach,UDim2.fromOffset(14,29),UDim2.new(1,-28,0,27),17,C(245,249,252),true)
local body=label(coach,UDim2.fromOffset(14,61),UDim2.new(1,-28,0,90),13,C(203,218,232),false)
body.TextYAlignment=Enum.TextYAlignment.Top
local status=label(coach,UDim2.fromOffset(14,150),UDim2.new(1,-28,0,22),11,C(255,218,134),true)
local nextButton=button(coach,'ПОНЯТНО →',UDim2.new(1,-153,1,-40),UDim2.fromOffset(139,29),function()
 if snapshot.id then action:FireServer('read',snapshot.id)end
end)
local book
local function openBook()
 if book then book:Destroy();book=nil;return end
 book=Instance.new('Frame');book.Name='Steal60Handbook';book.AnchorPoint=Vector2.new(.5,.5);book.Position=UDim2.fromScale(.5,.48)
 book.Size=UDim2.fromScale(.90,.79);book.BackgroundColor3=C(14,25,40);book.BorderSizePixel=0;book.Parent=gui;round(book,14)
 local cap=Instance.new('UISizeConstraint');cap.MaxSize=Vector2.new(730,640);cap.Parent=book
 local h=label(book,UDim2.fromOffset(18,9),UDim2.new(1,-88,0,35),20,C(236,247,244),true);h.Text='СПРАВОЧНИК';h.TextSize=18
 button(book,'✕',UDim2.new(1,-51,0,10),UDim2.fromOffset(35,31),function()book:Destroy();book=nil end)
 button(book,'ПОВТОРИТЬ УРОКИ БЕЗ СБРОСА ИНВЕНТАРЯ',UDim2.fromOffset(12,50),UDim2.new(1,-24,0,31),function()action:FireServer('restart');book:Destroy();book=nil;collapsed=false end)
 local scroll=Instance.new('ScrollingFrame');scroll.Position=UDim2.fromOffset(12,92);scroll.Size=UDim2.new(1,-24,1,-104);scroll.BackgroundTransparency=1
 scroll.BorderSizePixel=0;scroll.ScrollBarThickness=5;scroll.CanvasSize=UDim2.new();scroll.AutomaticCanvasSize=Enum.AutomaticSize.Y;scroll.Parent=book
 local layout=Instance.new('UIListLayout');layout.Padding=UDim.new(0,9);layout.Parent=scroll
 for i,step in ipairs(Config.Steps)do
  local card=Instance.new('Frame');card.Size=UDim2.new(1,-8,0,135);card.BackgroundColor3=C(27,43,59);card.BorderSizePixel=0;card.LayoutOrder=i;card.Parent=scroll;round(card,9)
  local done=snapshot.done and snapshot.done[step.id]
  local h=label(card,UDim2.fromOffset(12,7),UDim2.new(1,-24,0,26),14,done and C(123,237,182)or C(237,239,245),true)
  h.Text=(done and'✓ 'or(snapshot.id==step.id and'➤ 'or''))..i..'. '..step.title
  local d=label(card,UDim2.fromOffset(12,37),UDim2.new(1,-24,0,91),13,C(195,213,228),false);d.Text=step.body;d.TextYAlignment=Enum.TextYAlignment.Top
 end
end
button(coach,'СПРАВОЧНИК',UDim2.fromOffset(14,178),UDim2.fromOffset(132,29),openBook)
button(coach,'−',UDim2.new(1,-38,0,6),UDim2.fromOffset(25,24),function()collapsed=true;coach.Visible=false end)
local help=button(gui,'ОБУЧЕНИЕ',UDim2.new(0,16,1,-48),UDim2.fromOffset(174,33),function()
 if snapshot.index&gt;#Config.Steps then openBook()else collapsed=not collapsed end
end)
help.BackgroundColor3=C(36,65,77);help.TextColor3=C(173,241,220)
local guide=Instance.new('Part');guide.Name='Steal60TutorialMarker';guide.Anchored=true;guide.Size=Vector3.one;guide.Transparency=1
 guide.CanCollide=false;guide.CanTouch=false;guide.CanQuery=false;guide.Parent=workspace
local beacon=Instance.new('BillboardGui');beacon.Adornee=guide;beacon.Size=UDim2.fromOffset(225,62);beacon.StudsOffsetWorldSpace=Vector3.new(0,4,0)
beacon.AlwaysOnTop=true;beacon.MaxDistance=1800;beacon.Parent=guide
local marker=label(beacon,UDim2.new(),UDim2.fromScale(1,1),13,C(143,255,194),true)
marker.BackgroundTransparency=.12;marker.BackgroundColor3=C(17,48,43);marker.TextXAlignment=Enum.TextXAlignment.Center;round(marker,9)
local function draw()
 local step=snapshot.id and Config.ById[snapshot.id]
 help.Text=step and('ОБУЧЕНИЕ · '..snapshot.index..'/'..#Config.Steps)or'СПРАВОЧНИК'
 coach.Visible=step~=nil and not collapsed and book==nil
 beacon.Enabled=step~=nil and player:GetAttribute('TutorialTargetPosition')~=nil and not collapsed and book==nil
 if not step then return end
 local inMenu=player:GetAttribute('Steal60MenuOpen')==true
 if inMenu then
  coach.AnchorPoint=Vector2.new(.5,1);coach.Position=UDim2.new(.5,0,1,-8);coach.Size=UDim2.new(.94,0,0,96);limit.MaxSize=Vector2.new(730,96)
  title.Position=UDim2.fromOffset(14,6);title.Size=UDim2.new(1,-160,0,22);title.TextSize=14
  body.Position=UDim2.fromOffset(14,31);body.Size=UDim2.new(1,-28,0,59);body.TextSize=12
  progress.Visible=false;status.Visible=false
  nextButton.Position=UDim2.new(1,-153,0,5)
 else
  coach.AnchorPoint=Vector2.new(0,1);coach.Position=UDim2.new(0,16,1,-105);coach.Size=UDim2.new(.92,0,0,218);limit.MaxSize=Vector2.new(390,218)
  title.Position=UDim2.fromOffset(14,29);title.Size=UDim2.new(1,-28,0,27);title.TextSize=17
  body.Position=UDim2.fromOffset(14,61);body.Size=UDim2.new(1,-28,0,90);body.TextSize=13
  progress.Visible=true;status.Visible=true;nextButton.Position=UDim2.new(1,-153,1,-40)
 end
 -- Compact mode keeps only the lesson and the required action over an open shop.
 for _,child in ipairs(coach:GetChildren())do if child:IsA('TextButton')and child~=nextButton then child.Visible=not inMenu end end
 progress.Text=('ОБУЧЕНИЕ · ШАГ %d ИЗ %d'):format(snapshot.index,#Config.Steps)
 title.Text=step.title;body.Text=step.body
 if step.id=='store'or step.id=='place'or step.id=='star'or step.id=='copies'then
  body.Text='Предмет: '..(snapshot.itemName or'Ёлочка-ароматизатор')..'. '..step.body
 end
 nextButton.Visible=step.lesson==true;nextButton.Active=snapshot.canRead==true
 nextButton.BackgroundColor3=snapshot.canRead and C(108,231,184)or C(72,94,107)
 nextButton.Text=snapshot.canRead and'ПОНЯТНО →'or(snapshot.awaitingLoot and'НУЖЕН ПРЕДМЕТ'or'СНАЧАЛА К NPC')
 if snapshot.awaitingLoot then body.Text='На полках пока нет доходного предмета. Доставь ещё одну машину, затем продолжим урок.'end
 if step.id=='copies'then body.Text=('Предмет: %s. Доставляй машины из района %d: учебный заказ выбирает нужную добычу в одном из слотов. Собери 5 копий для звезды.'):format(snapshot.itemName or'учебный предмет',snapshot.itemZone or 1)end
 if step.id=='copies'then status.Text=('Нужно 5 копий: %d/5 · ★ %d/5'):format(math.min(5,snapshot.copies or 0),snapshot.stars or 0)
 elseif step.id=='star'then status.Text=(snapshot.itemName or'Предмет')..' · пора улучшить до ★1'
 elseif step.lesson then status.Text=snapshot.canRead and'Прочитай подсказку и продолжай.'or'Открой магазин у отмеченного NPC.'
 else status.Text='Шаг подтвердится после действия в игре.'end
 if snapshot.awaitingLoot then status.Text='Доставь машину из первого района.'end
 local pos=player:GetAttribute('TutorialTargetPosition')
 if pos then
  guide.Position=pos;local root=player.Character and player.Character:FindFirstChild('HumanoidRootPart')
  marker.Text='▼ '..step.title..(root and('\n'..math.floor((root.Position-pos).Magnitude)..' ст.')or'')
 end
end
remotes:WaitForChild('TutorialUpdate').OnClientEvent:Connect(function(payload)
 if type(payload)~='table'then return end
 if payload.id~=snapshot.id then collapsed=false end;snapshot=payload;draw()
end)
player:GetAttributeChangedSignal('Steal60MenuOpen'):Connect(draw)
action:FireServer('request')
task.spawn(function()while gui.Parent do draw();task.wait(.25)end;guide:Destroy()end)
</ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX_V33_ECONOMY_HUD"><Properties><string name="Name">EconomyHUD</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- STEAL60 v35 | Three DISTINCT in-world shop interfaces and transparent workshop controls.
-- Client renders data; all purchases, prices and swaps are checked by server.
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local Marketplace = game:GetService("MarketplaceService")
local Input = game:GetService("UserInputService")
local player = Players.LocalPlayer
local gui = script.Parent
local remotes = RS:WaitForChild("Remotes")
local openRemote = remotes:WaitForChild("OpenEconomyNPC")
local getData = remotes:WaitForChild("GetMenuData")
local buyCoin = remotes:WaitForChild("BuyCoinUpgrade")
local buyDiamond = remotes:WaitForChild("BuyUpgrade")
local buyVIP = remotes:WaitForChild("BuyVIP")
local manage = remotes:WaitForChild("ManageWorkshop")
local Config = RS:WaitForChild("Shared"):WaitForChild("Config")
local Monetization = require(Config:WaitForChild("MonetizationConfig"))
local VIP = require(Config:WaitForChild("VIPConfig"))
local C = Color3.fromRGB

local function fmt(n)
    local v = math.max(0, math.floor(tonumber(n) or 0))
    return tostring(v):reverse():gsub("(%d%d%d)","%1 "):reverse():gsub("^ ","")
end
local function round(obj,rad)
    local x=Instance.new("UICorner"); x.CornerRadius=UDim.new(0,rad); x.Parent=obj
end
local function label(parent,name,size,pos,textValue,font,pt,color)
    local t=Instance.new("TextLabel")
    t.Name=name;t.Size=size;t.Position=pos;t.BackgroundTransparency=1
    t.Text=tostring(textValue or "");t.Font=font or Enum.Font.Gotham
    t.TextSize=pt or 13;t.TextColor3=color or C(222,231,239)
    t.TextWrapped=true;t.TextXAlignment=Enum.TextXAlignment.Left
    t.TextYAlignment=Enum.TextYAlignment.Center;t.Parent=parent
    return t
end
local function button(parent,textValue,pos,size,callback,enabled)
    local b=Instance.new("TextButton")
    b.Size=size;b.Position=pos;b.Font=Enum.Font.GothamBold;b.TextSize=12
    b.TextWrapped=true;b.Text=tostring(textValue or "")
    b.TextColor3=enabled==false and C(161,170,181) or C(15,28,37)
    b.BackgroundColor3=enabled==false and C(65,75,85) or C(111,222,173)
    b.BorderSizePixel=0;b.AutoButtonColor=enabled~=false
    b.Active=enabled~=false;b.Parent=parent;round(b,9)
    if callback and enabled~=false then b.Activated:Connect(callback) end
    return b
end
local panel=Instance.new("Frame")
panel.Name="Steal60NPCShopV35"
panel.Size=UDim2.new(.9,0,.8,0)
panel.AnchorPoint=Vector2.new(.5,.5)
panel.Position=UDim2.fromScale(.5,.47)
panel.BackgroundColor3=C(14,23,38)
panel.BorderSizePixel=0;panel.Visible=false;panel.Parent=gui;round(panel,14)
local limit=Instance.new("UISizeConstraint")
limit.MaxSize=Vector2.new(760,650);limit.MinSize=Vector2.new(320,340);limit.Parent=panel
local outline=Instance.new("UIStroke")
outline.Thickness=2;outline.Transparency=.23;outline.Color=C(84,207,193);outline.Parent=panel
local header=label(panel,"ShopHeader",UDim2.new(1,-90,0,43),UDim2.fromOffset(19,9),"МАСТЕРСКАЯ",Enum.Font.GothamBlack,22,C(246,247,250))
local close=button(panel,"✕",UDim2.new(1,-58,0,12),UDim2.fromOffset(42,38),function() end,true)
close.BackgroundColor3=C(115,46,58);close.TextColor3=C(255,240,245);close.TextSize=20
local subtitle=label(panel,"ShopSubtitle",UDim2.new(1,-32,0,28),UDim2.fromOffset(18,52),"",Enum.Font.GothamMedium,12,C(156,207,219))
local tabs=Instance.new("Frame")
tabs.Name="WorkshopTabs";tabs.Position=UDim2.fromOffset(16,85)
tabs.Size=UDim2.new(1,-32,0,39);tabs.BackgroundTransparency=1;tabs.Parent=panel
local rowTabs=Instance.new("UIListLayout")
rowTabs.FillDirection=Enum.FillDirection.Horizontal;rowTabs.Padding=UDim.new(0,8);rowTabs.Parent=tabs
local selectionPanel=Instance.new("Frame")
selectionPanel.Name="SelectionBar";selectionPanel.Position=UDim2.fromOffset(16,130)
selectionPanel.Size=UDim2.new(1,-32,0,51);selectionPanel.BackgroundColor3=C(28,48,62)
selectionPanel.BorderSizePixel=0;selectionPanel.Visible=false;selectionPanel.Parent=panel;round(selectionPanel,10)
local pickText=label(selectionPanel,"PickText",UDim2.new(1,-220,1,0),UDim2.fromOffset(11,0),"Выбери два предмета",Enum.Font.GothamBold,12,C(230,240,244))
local swapButton=button(selectionPanel,"⇄ ПОМЕНЯТЬ",UDim2.new(1,-199,0,6),UDim2.fromOffset(184,39),nil,false)
local scroll=Instance.new("ScrollingFrame")
scroll.Name="ShopContent";scroll.Position=UDim2.fromOffset(15,132)
scroll.Size=UDim2.new(1,-30,1,-146);scroll.BackgroundColor3=C(19,31,47)
scroll.BorderSizePixel=0;scroll.ScrollBarThickness=6;scroll.AutomaticCanvasSize=Enum.AutomaticSize.Y
scroll.CanvasSize=UDim2.new();scroll.Parent=panel;round(scroll,10)
local contentLayout=Instance.new("UIListLayout")
contentLayout.Padding=UDim.new(0,8);contentLayout.Parent=scroll
local notice=label(panel,"ShopNotice",UDim2.new(1,-36,0,28),UDim2.fromOffset(18,52),"",Enum.Font.GothamMedium,12,C(252,215,124))
notice.Visible=false

local vendor="coins"
local tab="coins"
local selection={}
local selectedShelf=nil
local lastShelfTap=0
local targetSlot=nil
local selectedStorage=nil
local currentData=nil
local drawing=false
local draw
local rebuildTabs
local updateSelection
local lastRequested=0

local function clearContent()
    for _,x in ipairs(scroll:GetChildren()) do
        if x~=contentLayout then x:Destroy() end
    end
end
local function feedback(message)
    notice.Text=tostring(message)
    notice.Visible=true
    subtitle.Visible=false
    local deadline=os.clock()+2.2
    lastRequested=deadline
    task.delay(2.3,function()
        if lastRequested==deadline then notice.Visible=false;subtitle.Visible=true end
    end)
end
local function refreshAfter()
    task.delay(.45,function()
        if panel.Visible then draw() end
    end)
end
local function makeCard(icon,titleText,detailText,color,actions,h)
    h=h or 83
    local card=Instance.new("Frame")
    card.Name="ProductCard";card.Size=UDim2.new(1,-11,0,h)
    card.BackgroundColor3=C(34,47,66);card.BorderSizePixel=0;card.Parent=scroll;round(card,11)
    local art=label(card,"ProductIcon",UDim2.fromOffset(55,55),UDim2.fromOffset(9,12),icon,Enum.Font.GothamBlack,25,color or C(255,208,127))
    art.TextXAlignment=Enum.TextXAlignment.Center;art.BackgroundTransparency=0;art.BackgroundColor3=C(21,35,53);round(art,9)
    local actionWidth=(actions and #actions&gt;0) and 155 or 0
    local left=77
    local right=actionWidth&gt;0 and actionWidth+15 or 13
    local titleLine=label(card,"ProductName",UDim2.new(1,-left-right,0,25),UDim2.fromOffset(left,11),titleText,Enum.Font.GothamBold,15,color or C(241,244,248))
    titleLine.TextTruncate=Enum.TextTruncate.AtEnd
    local details=label(card,"ProductDetails",UDim2.new(1,-left-right,0,h-39),UDim2.fromOffset(left,34),detailText,Enum.Font.GothamMedium,12,C(187,207,223))
    details.TextYAlignment=Enum.TextYAlignment.Top
    details.RichText=true -- star/stage text intentionally includes Roblox rich-text tags
    if actions and #actions&gt;0 then
        local eachHeight=(#actions&gt;1) and 42 or 47
        local gap=(#actions&gt;1) and 5 or 0
        local totalHeight=eachHeight*#actions+gap*(#actions-1)
        for i,act in ipairs(actions) do
            local ypos=math.floor((h-totalHeight)/2)+(i-1)*(eachHeight+gap)
            local b=button(card,act.text,UDim2.new(1,-actionWidth-9,0,ypos),UDim2.fromOffset(actionWidth,eachHeight),act.func,act.enabled~=false)
            if act.tint then b.BackgroundColor3=act.tint;b.TextColor3=act.enabled==false and C(160,168,182) or C(17,30,39) end
        end
    end
    return card
end

local function workspaceMessage(message)
    feedback(message)
end
local function performMove(action,a,b)
    manage:FireServer(action,a,b)
    selectedShelf=nil
    selectedStorage=nil
    targetSlot=nil
    selection={}
    refreshAfter()
end
local function useShelf(index,empty)
    if empty then
        if selectedStorage then
            performMove("placeShelf",index,selectedStorage)
            feedback("Предмет установлен на полку "..tostring(index)..".")
        else
            targetSlot=index
            tab="storage"
            rebuildTabs()
            draw()
        end
        return
    end
    if selectedShelf==index and os.clock()-lastShelfTap&lt;.60 then
        performMove("storeShelf",index)
        feedback("Предмет отправлен в инвентарь. Место освободилось.")
    elseif selectedShelf and selectedShelf~=index then
        performMove("swapShelf",selectedShelf,index)
        feedback("Места на полках поменялись.")
    else
        selectedShelf=index
        lastShelfTap=os.clock()
        pickText.Text="Выбрана позиция "..index.." · нажми ещё раз или выбери другой предмет."
        workspaceMessage("Место "..index.." выбрано. Нажми другой предмет для обмена или нажми ещё раз, чтобы убрать в инвентарь.")
    end
end
local function selectAccessory(id)
    if selection[1] and selection[1]~=id then
        performMove("swapAccessories",selection[1],id)
        feedback("Коллекционные предметы поменялись местами.")
    else
        selection={id}
        feedback("Теперь нажми другую деталь для перестановки.")
    end
end

updateSelection=function()
    local workshop=vendor=="workshop"
    local show=workshop
    selectionPanel.Visible=show
    tabs.Visible=workshop
    if show then
        swapButton:Destroy()
        if tab=="shelf" then
            local n=currentData and #(currentData.shelfStorage or {}) or 0
            pickText.Text=selectedStorage and "Выбран предмет из инвентаря. Нажми ПУСТОЕ МЕСТО." or "Кликни предмет → другой для обмена; дважды → инвентарь."
            swapButton=button(selectionPanel,"ИНВЕНТАРЬ  "..n,UDim2.new(1,-199,0,6),UDim2.fromOffset(184,39),function()
                selectedShelf=nil
                targetSlot=nil
                tab="storage"
                rebuildTabs()
                draw()
            end,true)
        elseif tab=="storage" then
            pickText.Text=targetSlot and ("ВЫБРАНА ПОЛКА №"..targetSlot.." · выбери предмет") or "В инвентаре хранятся вещи, снятые с полок."
            swapButton=button(selectionPanel,"← К ПОЛКАМ",UDim2.new(1,-199,0,6),UDim2.fromOffset(184,39),function()
                targetSlot=nil
                tab="shelf"
                rebuildTabs()
                draw()
            end,true)
        else
            pickText.Text="Нажми два коллекционных предмета, чтобы поменять их местами."
            swapButton=button(selectionPanel,"КОЛЛЕКЦИЯ ★",UDim2.new(1,-199,0,6),UDim2.fromOffset(184,39),nil,false)
        end
        scroll.Position=UDim2.fromOffset(15,190)
        scroll.Size=UDim2.new(1,-30,1,-204)
    else
        scroll.Position=UDim2.fromOffset(15,89)
        scroll.Size=UDim2.new(1,-30,1,-102)
    end
end
local function makeTapTarget(card,callback)
    local tap=Instance.new("TextButton")
    tap.Name="ItemTapArea"
    tap.Size=UDim2.new(1,-168,1,0)
    tap.Position=UDim2.new()
    tap.BackgroundTransparency=1
    tap.Text=""
    tap.ZIndex=4
    tap.Parent=card
    tap.Activated:Connect(callback)
    return tap
end

rebuildTabs=function()
    for _,obj in ipairs(tabs:GetChildren()) do if obj~=rowTabs then obj:Destroy() end end
    if vendor~="workshop" then tabs.Visible=false;return end
    for _,v in ipairs({{"shelf","ПОЛКИ"},{"storage","ИНВЕНТАРЬ"},{"accessories","КОЛЛЕКЦИЯ ★"}}) do
        local t=Instance.new("TextButton")
        t.Name="Tab_"..v[1];t.Text=v[2];t.Font=Enum.Font.GothamBold
        t.TextSize=12;t.TextColor3=C(238,244,250)
        t.BackgroundColor3=v[1]==tab and C(60,112,124) or C(32,60,76)
        t.Size=UDim2.new(1/3,-6,1,-1);t.BorderSizePixel=0;t.Parent=tabs;round(t,8)
        t.Activated:Connect(function()
            tab=v[1]
            selectedShelf=nil
            selectedStorage=nil
            targetSlot=nil
            selection={}
            rebuildTabs()
            draw()
        end)
    end
end

draw=function()
    if not panel.Visible or drawing then return end
    drawing=true
    local ok,data=pcall(function() return getData:InvokeServer() end)
    clearContent()
    if not ok or type(data)~="table" then
        makeCard("!","Данные загружаются","Закрой и открой торговца через секунду.",C(255,160,132))
        drawing=false;return
    end
    currentData=data
    if vendor=="coins" then
        header.Text="МАСТЕР · УЛУЧШЕНИЯ ЗА $"
        subtitle.Text="Доступно всем игрокам · монеты $ "..fmt(data.money)
        outline.Color=C(90,216,150)
        makeCard("$","УЛУЧШЕНИЯ ЗА МОНЕТЫ","Все обычные навыки покупаются за заработанные деньги. Алмазы не нужны.",C(143,234,170),nil,76)
        for _,up in ipairs(data.coinUpgrades or {}) do
            local maximum=up.level&gt;=up.max or up.cost==nil
            local price=up.cost or 0
            local sufficient=(tonumber(data.money) or 0)&gt;=price
            local txt=maximum and "МАКС" or ("УЛУЧШИТЬ\n"..fmt(price).." $")
            local info=("Уровень %d/%d   ·   %s"):format(up.level,up.max,up.detail or "")
            if up.id=="security" then
                info=info.."\nОбщий уровень (монеты + алмазы). NPC ловит чаще; игроков лишь задерживает."
            end
            if not maximum and not sufficient then info=info.."\nНе хватает монет" end
            makeCard(up.icon or "$",up.name,info,C(140,239,172),{{text=txt,func=function()
                buyCoin:FireServer(up.id);refreshAfter()
            end,enabled=not maximum and sufficient}},88)
        end
    elseif vendor=="diamonds" then
        header.Text="VIP · МАГАЗИН АЛМАЗОВ"
        subtitle.Text="Баланс 💎 "..fmt(data.diamonds).." · все покупки здесь — только за алмазы"
        outline.Color=C(95,191,255)
        local untilAt=math.floor(tonumber(data.vipUntil) or 0)
        local rem=math.max(0,untilAt-math.floor(workspace:GetServerTimeNow()))
        local status="VIP НЕ АКТИВЕН"
        if data.vipPermanent then status="VIP БЕССРОЧНО"
        elseif data.vipActive and rem&gt;0 then
            status=("VIP до %s UTC · осталось %d д. %d ч."):format(os.date("!%d.%m.%Y %H:%M",untilAt),math.floor(rem/86400),math.floor(rem%86400/3600))
        end
        makeCard("♛",status,("+%d%% денег за угон · +%d%% XP взломщика · касса %d ч."):format(VIP.BONUS_COINS_PCT,VIP.BONUS_XP_PCT,VIP.CASH_HOURS),C(254,209,109),nil,77)
        for _,plan in ipairs(VIP.Plans) do
            local enabled=not data.vipPermanent and (tonumber(data.diamonds) or 0)&gt;=plan.diamonds
            makeCard(plan.icon or "♛",plan.name, ("Длительность: %d дней. При продлении оставшиеся дни сохраняются."):format(plan.days),C(250,217,134),{{text="КУПИТЬ VIP\n"..fmt(plan.diamonds).." 💎",func=function()
                buyVIP:FireServer(plan.id);refreshAfter()
            end,enabled=enabled}},84)
        end
        makeCard("◆","АЛМАЗНЫЕ УЛУЧШЕНИЯ","Премиальные бонусы. Обычную прокачку можно пройти без доната.",C(135,198,252),nil,72)
        for _,up in ipairs(data.upgrades or {}) do
            local maximum=up.level&gt;=up.max or up.cost==nil
            local sufficient=(tonumber(data.diamonds) or 0)&gt;=(up.cost or 0)
            makeCard("◆",up.name,("Уровень %d/%d  ·  %s"):format(up.level,up.max,up.description or ""),C(145,202,248),{{text=maximum and "МАКС" or ("УЛУЧШИТЬ\n"..fmt(up.cost).." 💎"),func=function()
                buyDiamond:FireServer(up.id);refreshAfter()
            end,enabled=not maximum and sufficient}},86)
        end
        makeCard("💎","ПОПОЛНИТЬ АЛМАЗЫ","Наборы приобретаются за Robux. ID товаров нужно настроить перед релизом.",C(115,212,252),nil,76)
        for _,prod in ipairs(Monetization.Products) do
            local valid=(tonumber(prod.assetId) or 0)&gt;0
            makeCard("💎",prod.name,valid and "Официальная покупка Roblox" or "Покупки пока выключены: Product ID = 0",C(120,210,255),{{text=valid and "ЗА ROBUX" or "НЕДОСТУПНО",func=function()
                Marketplace:PromptProductPurchase(player,prod.assetId)
            end,enabled=valid}},80)
        end
    elseif vendor=="workshop" and tab=="shelf" then
        header.Text="МАСТЕРСКАЯ · ПОЛКИ"
        subtitle.Text="1 нажатие — выбрать, 2 быстро — в инвентарь. Выбери другой предмет — обмен."
        outline.Color=C(244,188,96)
        if not data.shelf or #data.shelf==0 then
            makeCard("▣","Полки пустые","Доставляй угнанные машины и находи предметы.",C(200,208,220))
        end
        for index,item in ipairs(data.shelf or {}) do
            if item.locked then
                makeCard("?",("%d. ПРЕДМЕТ НЕИЗВЕСТНОЙ ВЕРСИИ"):format(index),"Предмет сохранён, но отсутствует в текущем каталоге. Не удаляй его.",C(202,179,143),nil,81)
            elseif item.empty then
                local c=makeCard("+",("МЕСТО %d · СВОБОДНО"):format(index),"Нажми сюда, чтобы выбрать вещь из инвентаря.",C(119,218,173),nil,72)
                makeTapTarget(c,function() useShelf(index,true) end)
            else
                local star=tonumber(item.stars) or 0
                local copies=tonumber(item.copies) or 0
                local cost=tonumber(item.cost) or 0
                local details=("+%s $/ч  ·  копий %d/5\nДвойной тап / клик: снять с полки"):format(fmt((tonumber(item.income) or 0)*3600),copies)
                local c=makeCard("▣",("%d. %s  ★%d/5"):format(index,item.name,star),details,C(255,213,125),{
                    {text=star&gt;=5 and "МАКС" or ("★ УЛУЧШИТЬ\n"..fmt(cost).." $"),func=function()
                        manage:FireServer("upgradeShelf",item.id)
                        refreshAfter()
                    end,enabled=star&lt;5 and copies&gt;=5 and (tonumber(data.money) or 0)&gt;=cost,tint=C(129,232,163)}
                },100)
                if item.id==player:GetAttribute("TutorialItemId")and not player:GetAttribute("TutorialComplete")then
                    local outline=Instance.new("UIStroke");outline.Color=C(120,240,180);outline.Thickness=2;outline.Parent=c
                end
                makeTapTarget(c,function()
                    useShelf(index,false)
                    if selectedShelf==index then c.BackgroundColor3=C(44,84,87) end
                end)
                if selectedShelf==index then c.BackgroundColor3=C(44,84,87) end
            end
        end
    elseif vendor=="workshop" and tab=="storage" then
        header.Text="ИНВЕНТАРЬ · ДОХОДНЫЕ ПРЕДМЕТЫ"
        local store=data.shelfStorage or {}
        subtitle.Text=("Сейчас в инвентаре %d / %d · выбери предмет и пустое место"):format(#store,data.shelfStorageMax or 48)
        outline.Color=C(140,204,255)
        if #store==0 then
            makeCard("□","ИНВЕНТАРЬ ПУСТ","Нажми дважды на предмет на полке, чтобы переместить сюда. Потом нажми пустое место.",C(201,225,235),nil,100)
        end
        for index,item in ipairs(store) do
            makeCard("▣",("%d. %s  ★%d/5"):format(index,item.name,item.stars or 0),
                ("Район %d · +%s $/ч"):format(item.zone or 1,fmt((item.income or 0)*3600)),C(151,218,249),{
                {text=targetSlot and ("ПОСТАВИТЬ В №"..targetSlot) or "ВЫБРАТЬ ПРЕДМЕТ",func=function()
                    if targetSlot then
                        local slot=targetSlot
                        performMove("placeShelf",slot,item.slot or index)
                        tab="shelf"
                        rebuildTabs()
                        feedback("Предмет перенесён в позицию "..slot)
                    else
                        selectedStorage=index
                        tab="shelf"
                        rebuildTabs()
                        draw()
                        feedback("Предмет выбран. Нажми свободное место на полке.")
                    end
                end,enabled=true,tint=C(112,217,194)}
            },88)
        end
    elseif vendor=="workshop" and tab=="accessories" then
        header.Text="МАСТЕРСКАЯ · КОЛЛЕКЦИЯ ★"
        subtitle.Text="5 одинаковых деталей заполняют звезду · процентный бонус складывается."
        outline.Color=C(244,188,96)
        local byId={}
        for _,a in ipairs(data.theftParts or {}) do byId[a.id]=a end
        local order={};local seen={}
        for _,id in ipairs(data.accessoryOrder or {}) do
            if byId[id] and not seen[id] then table.insert(order,byId[id]);seen[id]=true end
        end
        for _,a in ipairs(data.theftParts or {}) do
            if not seen[a.id] then table.insert(order,a);seen[a.id]=true end
        end
        for i,item in ipairs(order) do
            local highlighted=table.find(selection,item.id)~=nil
            local details=("РАЙОН %d  ·  %s  ·  +%d%% к деньгам\n%s\n%s"):format(
                item.zone or 1,item.owned and "НАЙДЕНО" or "НЕ НАЙДЕНО",item.pct or 0,
                item.stars or "☆☆☆☆☆",item.progress or "0/5")
            local card=makeCard(item.owned and "★" or "☆",item.name,details,
                item.owned and C(255,210,127) or C(150,163,180),{{text=highlighted and "● ВЫБРАНО" or "ВЫБРАТЬ",func=function() selectAccessory(item.id) end,tint=C(112,217,194)}},112)
            if highlighted then card.BackgroundColor3=C(44,84,87) end
        end
    end
    updateSelection()
    drawing=false
end

local function setOpen(open)
    panel.Visible=open
    player:SetAttribute("Steal60MenuOpen",open)
    if open then
        rebuildTabs()
        updateSelection()
        draw()
    else
        selection={}
    end
end
close.Activated:Connect(function() setOpen(false) end)
openRemote.OnClientEvent:Connect(function(kind)
    if kind~="coins" and kind~="diamonds" and kind~="workshop" then
        panel.Visible=false
        return
    end
    vendor=kind
    tab=kind=="workshop" and "shelf" or kind
    selection={}
    selectedShelf=nil
    selectedStorage=nil
    targetSlot=nil
    setOpen(true)
end)
Input.InputBegan:Connect(function(input,processed)
    if not processed and input.KeyCode==Enum.KeyCode.Escape and panel.Visible then
        setOpen(false)
    end
end)
remotes:WaitForChild("CurrencyUpdate").OnClientEvent:Connect(function()
    if panel.Visible then task.defer(draw) end
end)
</ProtectedString></Properties></Item><Item class="LocalScript" referent="RBXGEN_V37_CosmeticHUD">
          <Properties>
            <string name="Name">CosmeticHUD</string>
            <ProtectedString name="Source">-- STEAL60 v38: character skins (+0-10%) and one-time pet license (+0-50%).
-- All prices and rewards are authoritative on the server; this is display/actions only.
local Players=game:GetService("Players")
local RS=game:GetService("ReplicatedStorage")
local Input=game:GetService("UserInputService")
local RunService=game:GetService("RunService")
local player=Players.LocalPlayer
local remotes=RS:WaitForChild("Remotes")
local dataRequest=remotes:WaitForChild("GetMenuData")
local openNpc=remotes:WaitForChild("OpenEconomyNPC")
local action=remotes:WaitForChild("CosmeticAction")
local update=remotes:WaitForChild("CosmeticUpdate")
local currency=remotes:WaitForChild("CurrencyUpdate")
local Config=require(RS.Shared.Config.CosmeticConfig)
local catalogPreviews=RS:WaitForChild("Steal60CatalogPreviews")
local PetVisuals=require(RS.Shared.PetVisualLibrary)
local PetAnimation=require(RS.Shared.PetAnimationLibrary)
local CarVisuals=require(RS.Shared.CarVisualLibrary)
local CarArt=require(RS.Shared.CarCosmeticArt)
local AuraVisuals=require(RS.Shared.AuraVisualLibrary)
local Cars=require(RS.Shared.Config.Cars)
local gui=script.Parent
local C=Color3.fromRGB
local state="hero"
local heroPage=1
local petPage=1
local selectedCarId=nil
local HERO_PAGE_SIZE=8
local PET_PAGE_SIZE=12
local busy=false
local colorBg=C(13,23,36)
local colorCard=C(34,50,67)
local colorAccent=C(117,235,193)
local function fmt(n)
 return tostring(math.floor(tonumber(n) or 0)):reverse():gsub("(%d%d%d)","%1 "):reverse():gsub("^ ","")
end
local function corner(p,r)
 local x=Instance.new("UICorner")
 x.CornerRadius=UDim.new(0,r)
 x.Parent=p
end
local function text(parent,s,size,pos,pt,col,bold)
 local t=Instance.new("TextLabel")
 t.BackgroundTransparency=1
 t.Text=s
 t.Size=size
 t.Position=pos
 t.Font=bold and Enum.Font.GothamBold or Enum.Font.Gotham
 t.TextSize=pt or 13
 t.TextColor3=col or C(222,233,242)
 t.TextXAlignment=Enum.TextXAlignment.Left
 t.TextYAlignment=Enum.TextYAlignment.Center
 t.TextWrapped=true
 t.Parent=parent
 return t
end
local function button(parent,s,size,pos,callback,color,enabled)
 local b=Instance.new("TextButton")
 b.Text=s
 b.Size=size
 b.Position=pos or UDim2.new()
 b.TextWrapped=true
 b.Font=Enum.Font.GothamBold
 b.TextSize=12
 b.TextColor3=C(13,27,37)
 b.BackgroundColor3=color or colorAccent
 b.BorderSizePixel=0
 b.Active=enabled~=false
 b.AutoButtonColor=enabled~=false
 if enabled==false then b.BackgroundColor3=C(81,96,107) end
 b.Parent=parent
 corner(b,8)
 if callback then b.Activated:Connect(function()
  if enabled==false or busy then return end
  busy=true
  callback()
  task.delay(.45,function() busy=false end)
 end) end
 return b
end
local function box(parent,h,col)
 local b=Instance.new("Frame")
 b.Size=UDim2.new(1,-14,0,h)
 b.BackgroundColor3=col or colorCard
 b.BorderSizePixel=0
 b.Parent=parent
 corner(b,11)
 return b
end

local panel=Instance.new("Frame")
panel.Name="CosmeticShopV44"
panel.AnchorPoint=Vector2.new(.5,.5)
panel.Position=UDim2.fromScale(.5,.5)
panel.Size=UDim2.new(.9,0,.86,0)
panel.BackgroundColor3=C(11,19,32)
panel.BorderSizePixel=0
panel.Visible=false
panel.Parent=gui
corner(panel,14)
local limiter=Instance.new("UISizeConstraint")
limiter.MaxSize=Vector2.new(850,720)
limiter.MinSize=Vector2.new(300,340)
limiter.Parent=panel
local outline=Instance.new("UIStroke")
outline.Color=C(123,208,251)
outline.Transparency=.25
outline.Thickness=2
outline.Parent=panel
text(panel,"ATELIER 60  ·  ПРЕМИАЛЬНЫЕ ОБРАЗЫ",UDim2.new(1,-90,0,37),UDim2.fromOffset(18,8),20,C(246,248,255),true)
local subtitle=text(panel,"",UDim2.new(1,-32,0,27),UDim2.fromOffset(18,50),12,C(150,214,224))
local function setOpen(open)
 panel.Visible=open
 player:SetAttribute("Steal60MenuOpen",open)
end
button(panel,"✕",UDim2.fromOffset(39,36),UDim2.new(1,-51,0,10),function() setOpen(false) end,C(175,83,100)).TextColor3=C(255,255,255)
local tabs=Instance.new("Frame")
tabs.Size=UDim2.new(1,-32,0,38)
tabs.Position=UDim2.fromOffset(16,85)
tabs.BackgroundTransparency=1
tabs.Parent=panel
local tabLayout=Instance.new("UIListLayout")
tabLayout.FillDirection=Enum.FillDirection.Horizontal
 tabLayout.Padding=UDim.new(0,5)
tabLayout.Parent=tabs
local scroller=Instance.new("ScrollingFrame")
scroller.Position=UDim2.fromOffset(16,132)
scroller.Size=UDim2.new(1,-32,1,-146)
scroller.BackgroundColor3=C(22,35,49)
scroller.ScrollBarThickness=6
scroller.BorderSizePixel=0
scroller.AutomaticCanvasSize=Enum.AutomaticSize.Y
scroller.CanvasSize=UDim2.new()
scroller.Parent=panel
corner(scroller,10)
local layout=Instance.new("UIListLayout")
layout.Padding=UDim.new(0,8)
layout.Parent=scroller
local modes={{"hero","ГЕРОЙ"},{"pet","ПИТОМЕЦ"},{"paint","КРАСКА"},{"skin","АВТО"},{"aura","АУРА"}}
local render
local function send(verb,category,id,targetCarId)
 action:FireServer(verb,category,id,targetCarId)
 task.delay(.55,function()
  if panel.Visible then render() end
 end)
end
local function notice(s)
 local b=box(scroller,36,C(25,51,58))
 text(b,s,UDim2.new(1,-18,1,-8),UDim2.fromOffset(9,4),12,C(176,231,210),true)
end
local function mastery(category,data)
 local hero=category=="hero"
 local level=math.clamp(math.floor(tonumber(hero and data.heroSkinBonusLevel or data.petBonusLevel) or 0),0,hero and 10 or 50)
 local max=hero and Config.HERO_MAX or Config.PET_MAX
 local unlocked=not hero and data.petUnlocked==true or false
 if hero then
  for id,yes in pairs(data.cosmeticsOwned or {}) do
   local def=Config.ById[id]
   if yes==true and def and def.category=="hero" then unlocked=true;break end
  end
 end
 local b=box(scroller,hero and 100 or 118,C(30,49,63))
 local title=hero and "МАСТЕРСТВО ГЕРОЯ" or "МАСТЕРСТВО ПИТОМЦА"
 text(b,title,UDim2.new(1,-25,0,24),UDim2.fromOffset(14,8),15,C(245,249,252),true)
 text(b,("+%d%% / +%d%% ко ВСЕМ монетам и доходу кассы"):format(level,max),
  UDim2.new(1,-25,0,24),UDim2.fromOffset(14,29),13,C(126,244,190),true)
 if not unlocked then
  text(b,hero and "Сначала купи любой скин героя." or "Сначала открой питомца — один раз за монеты или алмазы.",
   UDim2.new(1,-25,0,32),UDim2.fromOffset(14,61),12,C(178,196,213))
  return
 end
 if level&gt;=max then
  text(b,"МАКСИМАЛЬНЫЙ УРОВЕНЬ · открыто навсегда",UDim2.new(1,-25,0,29),UDim2.fromOffset(14,63),13,C(253,216,117),true)
  return
 end
 local startX=14
 if hero then
  local gems=Config.heroUpgradeDiamonds(level)
  local coins=Config.heroUpgradeCoins(level)
  button(b,("+1%% · %s $"):format(fmt(coins)),UDim2.new(.5,-18,0,34),UDim2.fromOffset(startX,62),function()
   send("upgradeHeroCoins","hero",nil)
  end,C(146,229,177),(tonumber(data.money) or 0)&gt;=coins)
  button(b,("+1%% · %d 💎"):format(gems),UDim2.new(.5,-18,0,34),UDim2.new(.5,4,0,62),function()
   send("upgradeHeroDiamonds","hero",nil)
  end,C(129,218,250),(tonumber(data.diamonds) or 0)&gt;=gems)
 else
  local coin=Config.petUpgradeCoins(level)
  local gem=Config.petUpgradeDiamonds(level)
  button(b,("+1%% · %s $"):format(fmt(coin)),UDim2.new(.5,-18,0,34),UDim2.fromOffset(startX,66),function()
   send("upgradePetCoins","pet",nil)
  end,C(146,229,177),(tonumber(data.money) or 0)&gt;=coin)
  button(b,("+1%% · %d 💎"):format(gem),UDim2.new(.5,-18,0,34),UDim2.new(.5,4,0,66),function()
   send("upgradePetDiamonds","pet",nil)
  end,C(129,218,250),(tonumber(data.diamonds) or 0)&gt;=gem)
 end
end
local function petLicense(data)
 if data.petUnlocked==true then
  notice("Все облики питомца открыты. Меняй внешний вид бесплатно — бонус сохраняется.")
  return
 end
 local b=box(scroller,121,C(47,42,65))
 text(b,"ОТКРЫТЬ ПИТОМЦА НАВСЕГДА",UDim2.new(1,-24,0,25),UDim2.fromOffset(14,7),15,C(252,225,179),true)
 text(b,"Одной покупки достаточно. Все нынешние и будущие облики — бесплатно!",
  UDim2.new(1,-24,0,34),UDim2.fromOffset(14,34),12,C(199,208,228))
 button(b,("ОТКРЫТЬ · %s $"):format(fmt(Config.PET_LICENSE_COINS)),UDim2.new(.5,-19,0,38),UDim2.fromOffset(14,76),function()
  send("unlockPetCoins","pet","pet_orb")
 end,C(149,229,174),(tonumber(data.money) or 0)&gt;=Config.PET_LICENSE_COINS)
 button(b,("ОТКРЫТЬ · %d 💎"):format(Config.PET_LICENSE_DIAMONDS),UDim2.new(.5,-19,0,38),UDim2.new(.5,5,0,76),function()
  send("unlockPetDiamonds","pet","pet_orb")
 end,C(140,222,247),(tonumber(data.diamonds) or 0)&gt;=Config.PET_LICENSE_DIAMONDS)
end
-- Each preview uses a studio-lit scene with a subtle turntable camera.
-- No animations/controllers are allocated per card; stale cameras are dropped on rerender.
local previewTurntables={}
local previewPets={}
local function registerTurntable(view,cam,focus,radius,height,phase)
 previewTurntables[#previewTurntables+1]={view=view,cam=cam,focus=focus,r=radius,h=height,phase=phase or 0}
end
local lastPreviewStep=0
RunService.RenderStepped:Connect(function(dt)
 if not panel.Visible then return end
 lastPreviewStep+=dt
 if lastPreviewStep&lt;.055 then return end
 local t=os.clock()
 lastPreviewStep=0
 for _,entry in ipairs(previewTurntables) do
  if entry.view.Parent and entry.cam.Parent then
   local a=t*.22+entry.phase
   local x=math.sin(a)*entry.r*.29+entry.r*.55
   local z=-math.cos(a)*entry.r*.36-entry.r*.82
   entry.cam.CFrame=CFrame.lookAt(entry.focus+Vector3.new(x,entry.h,z),entry.focus)
  end
 end
end)
local function studioCard(b,def)
 local border=Instance.new('UIStroke')
 border.Thickness=def.premiumDesign and 1.8 or 1
 border.Transparency=def.premiumDesign and .14 or .56
 border.Color=def.accent or def.color or C(88,160,191)
 border.Parent=b
 local grad=Instance.new('UIGradient')
 grad.Rotation=15
 grad.Color=ColorSequence.new(C(37,54,72),C(20,32,48))
 grad.Parent=b
 local mark=Instance.new('Frame')
 mark.Size=UDim2.new(0,4,1,-18)
 mark.Position=UDim2.fromOffset(4,9)
 mark.BackgroundColor3=def.accent or def.color or colorAccent
 mark.BorderSizePixel=0
 mark.Parent=b
 corner(mark,3)
end
local function add3DPreview(container,def)
 local view=Instance.new("ViewportFrame");view.Name="RealCatalogOutfit"
 view.Position=UDim2.fromOffset(9,9);view.Size=UDim2.fromOffset(176,192)
 view.BackgroundColor3=C(18,28,45);view.Ambient=C(155,172,205);view.LightColor=C(255,242,215)
 view.LightDirection=Vector3.new(-.7,-1,-.9);view.BorderSizePixel=0;view.Parent=container;corner(view,10)
 local template=catalogPreviews:FindFirstChild(def.catalogLook)
 if not template or template:GetAttribute("CatalogReady")~=true then
  text(view,catalogPreviews:GetAttribute(def.catalogLook.."_Unavailable")and"Roblox не загрузил этот образ"or"Загружаем образ Roblox…",UDim2.new(1,-12,1,-12),UDim2.fromOffset(6,6),12,C(195,213,228),true)
  return view
 end
 local world=Instance.new("WorldModel");world.Parent=view
 local model=template:Clone();model.Parent=world
 local bounds,size=model:GetBoundingBox();local focus=bounds.Position
 local radius=math.max(size.Y*1.55,size.X*1.65)
 local camera=Instance.new("Camera");camera.FieldOfView=33;camera.Parent=view;view.CurrentCamera=camera
 camera.CFrame=CFrame.lookAt(focus+Vector3.new(radius*.25,radius*.10,-radius),focus)
 registerTurntable(view,camera,focus,radius,radius*.10,.15)
 return view
end
-- Real 3D sculpted pet preview, not the old colour swatch.
local function petPreview(container,def)
 local view=Instance.new("ViewportFrame")
 view.Name="Pet3DPreview"
 view.Position=UDim2.fromOffset(9,9)
 view.Size=UDim2.fromOffset(176,192)
 view.BackgroundColor3=C(16,31,46)
 view.Ambient=C(206,214,230)
 view.LightColor=C(254,249,228)
 view.LightDirection=Vector3.new(-.8,-1,-.8)
 view.BorderSizePixel=0
 view.Parent=container
 corner(view,10)
 local wm=Instance.new("WorldModel")
 wm.Parent=view
 local platform=Instance.new('Part')
 platform.Name='PetStudioPlinth';platform.Size=Vector3.new(3.7,.13,3.4)
 platform.CFrame=CFrame.new(0,-1.20,0);platform.Anchored=true;platform.CanCollide=false
 platform.Color=C(43,61,76);platform.Material=Enum.Material.Metal;platform.Parent=wm
 local pet=PetVisuals.create(def)
 pet.Parent=wm
 pet:SetAttribute("CosmeticId",def.id);pet:SetAttribute("PetMovementType",def.movement or "fly")
 previewPets[#previewPets+1]=pet
 local camera=Instance.new("Camera")
 camera.FieldOfView=38
 local focus=Vector3.new(0,.10,0)
 camera.CFrame=CFrame.lookAt(Vector3.new(3.1,1.8,-4.7),focus)
 camera.Parent=view
 view.CurrentCamera=camera
 registerTurntable(view,camera,focus,5.0,1.65,1.0)
 return view
end

-- Each car is a separate cosmetic target, not a global player-wide colour.
local function pickCars(data)
 local cars={}
 for _,entry in ipairs(data.catalog or {}) do
  if entry.owned then cars[#cars+1]=entry end
 end
 table.sort(cars,function(a,b)
  if a.displaySlot and not b.displaySlot then return true end
  if b.displaySlot and not a.displaySlot then return false end
  return (a.valueScore or 0)&gt;(b.valueScore or 0)
 end)
 local valid=false
 for _,c in ipairs(cars) do if c.id==selectedCarId then valid=true end end
 if not valid then selectedCarId=cars[1] and cars[1].id or nil end
 return cars
end
local function vehicleSelector(data)
 local cars=pickCars(data)
 local panel=box(scroller,102,C(30,54,67))
 text(panel,"МАШИНА ДЛЯ ПОКРАСКИ / СТИЛЯ",UDim2.new(1,-20,0,21),UDim2.fromOffset(12,5),13,C(123,245,203),true)
 if #cars==0 then
  text(panel,"Сначала угони машину. Купленные цвета останутся в коллекции.",UDim2.new(1,-20,0,49),UDim2.fromOffset(12,28),13,C(217,222,232))
  return
 end
 local idx=1
 for i,car in ipairs(cars) do if car.id==selectedCarId then idx=i break end end
 local c=cars[idx]
 local paint=(data.carCosmetics or {})[c.id] or {}
 local colName=Config.ById[paint.paint] and Config.ById[paint.paint].name or "Заводской цвет"
 text(panel,("%d/%d   %s %s"):format(idx,#cars,c.name,c.displaySlot and ("· ВИТРИНА "..c.displaySlot) or "· КОЛЛЕКЦИЯ"),
  UDim2.new(1,-20,0,23),UDim2.fromOffset(12,30),13,C(240,247,255),true)
 text(panel,("Покраска: %s · отдельно для этого ID"):format(colName),UDim2.new(1,-20,0,17),UDim2.fromOffset(12,52),11,C(178,218,236))
 button(panel,"◀ ПРЕД.",UDim2.new(.49,-12,0,28),UDim2.fromOffset(10,70),function()
  selectedCarId=cars[((idx-2)%#cars)+1].id
  render()
 end,C(113,201,231),#cars&gt;1)
 button(panel,"СЛЕД. ▶",UDim2.new(.49,-12,0,28),UDim2.new(.51,0,0,70),function()
  selectedCarId=cars[(idx%#cars)+1].id
  render()
 end,C(113,201,231),#cars&gt;1)
end
-- Lightweight native 3D car; a colour/styling preview for the SELECTED car ID.
-- It is a schematic, not a promise of identical geometry to every vehicle class.
local function previewCar(container,def)
 local view=Instance.new("ViewportFrame");view.Name="ActualCarStyle3D"
 view.Size=UDim2.fromOffset(176,192);view.Position=UDim2.fromOffset(9,9)
 view.BorderSizePixel=0;view.BackgroundColor3=C(17,29,43)
 view.Ambient=C(157,179,203);view.LightColor=C(255,247,224)
 view.LightDirection=Vector3.new(-.7,-1,-.6);view.Parent=container;corner(view,10)
 local world=Instance.new("WorldModel");world.Parent=view
 local selected=Cars.ById[selectedCarId]or Cars[1]
 local model=CarVisuals.build(selected,selected.class);model.Parent=world
 CarArt.finish(model,def.category=="paint"and def or nil,def.category=="skin"and def or nil)
 local bounds,size=model:GetBoundingBox();local focus=bounds.Position
 local radius=math.max(size.X,size.Z)*1.12
 local cam=Instance.new("Camera");cam.FieldOfView=36;cam.Parent=view;view.CurrentCamera=cam
 cam.CFrame=CFrame.lookAt(focus+Vector3.new(radius*.65,radius*.37,-radius*.80),focus)
 registerTurntable(view,cam,focus,radius,radius*.37,.65)
 return view
end

-- In-store aura uses a full 3D mannequin with stylised floating effect markers.
local function aura3D(container,def)
 local view=Instance.new("Frame");view.Name="MovementTrailSwatch"
 view.Size=UDim2.fromOffset(176,192);view.Position=UDim2.fromOffset(9,9)
 view.BorderSizePixel=0;view.BackgroundColor3=C(17,29,43);view.Parent=container;corner(view,10)
 for side=0,1 do
  for i=0,17 do
   local piece=Instance.new("Frame");piece.BorderSizePixel=0;piece.BackgroundColor3=def.color
   piece.Size=UDim2.new(.047,0,0,math.max(1,7-i*.28));piece.Position=UDim2.new(.84-i*.044,0,.37+side*.16,math.sin(i*.28)*3)
   piece.BackgroundTransparency=.18+i*.044;piece.Parent=view;corner(piece,3)
  end
 end
 text(view,"➜",UDim2.fromScale(.4,.3),UDim2.fromScale(.52,.56),28,def.color,true)
 text(view,"СЛЕД ПРИ ДВИЖЕНИИ",UDim2.new(1,-10,0,30),UDim2.new(0,5,1,-33),10,C(204,222,232),true)
 return view
end

local function itemCard(def,data)
 local ownedTable=data.cosmeticsOwned or {}
 local equipped=data.cosmeticsEquipped or {}
 local owned=ownedTable[def.id]==true or (def.category=="pet" and data.petUnlocked==true)
 local isCar=def.category=="paint" or def.category=="skin"
 local target=(data.carCosmetics or {})[selectedCarId or ""] or {}
 local selected=(isCar and target[def.category]==def.id) or ((not isCar) and equipped[def.category]==def.id)
 local isHero=def.category=="hero"
 if isHero and Config.heroLookId(equipped.hero)==def.catalogLook then selected=true end
 local catalogReady=not isHero or catalogPreviews:GetAttribute(def.catalogLook)==true
 local isPet=def.category=="pet"
 local b=box(scroller,126)
 local extended=isHero or isPet or def.category=="aura" or isCar
 local wide=panel.AbsoluteSize.X&gt;=610
 local x=wide and 201 or 130
 local headerY=wide and 19 or 13
 local actionY=wide and 206 or 176
 if extended then
  b.Size=UDim2.new(1,-14,0,wide and 250 or 221)
  studioCard(b,def)
  local view
  if isHero then view=add3DPreview(b,def)
  elseif isPet then view=petPreview(b,def)
  elseif isCar then view=previewCar(b,def)
  else view=aura3D(b,def) end
  if view then
   view.Size=UDim2.fromOffset(wide and 176 or 111,wide and 188 or 145)
  end
  local title=text(b,def.name,UDim2.new(1,-x-12,0,38),UDim2.fromOffset(x,headerY),wide and 17 or 13,C(251,246,227),true)
  title.TextYAlignment=Enum.TextYAlignment.Top
  local desc=text(b,def.description,UDim2.new(1,-x-12,0,wide and 82 or 90),UDim2.fromOffset(x,wide and 66 or 49),wide and 13 or 11,C(192,212,229))
  desc.TextYAlignment=Enum.TextYAlignment.Top
  if isHero then
   text(b,"ОДЕЖДА ROBLOX · ЗА АЛМАЗЫ",UDim2.new(1,-x-12,0,21),UDim2.fromOffset(x,wide and 157 or 142),wide and 11 or 10,def.accent or colorAccent,true)
  elseif isCar then
   text(b,selectedCarId and "ДЛЯ ВЫБРАННОЙ МАШИНЫ" or "СНАЧАЛА ВЫБЕРИ МАШИНУ",
    UDim2.new(1,-x-12,0,21),UDim2.fromOffset(x,wide and 157 or 142),11,C(121,236,196),true)
  elseif isPet then
   text(b,def.movement=="fly" and "ЛЕТАЕТ ЗА ВЛАДЕЛЬЦЕМ" or "ЕДЕТ НА БАГАЖНИКЕ",
    UDim2.new(1,-x-12,0,21),UDim2.fromOffset(x,wide and 157 or 142),11,C(121,236,196),true)
  end
 else
  local sw=Instance.new("Frame")
  sw.BackgroundColor3=def.color
  sw.Size=UDim2.fromOffset(52,52)
  sw.Position=UDim2.fromOffset(11,10)
  sw.BorderSizePixel=0
  sw.Parent=b
  corner(sw,9)
  if def.accent then
   local strip=Instance.new("Frame")
   strip.Size=UDim2.new(1,-12,0,10)
   strip.Position=UDim2.fromOffset(6,35)
   strip.BackgroundColor3=def.accent
   strip.BorderSizePixel=0
   strip.Parent=sw
   corner(strip,4)
  end
  text(b,def.name,UDim2.new(1,-86,0,23),UDim2.fromOffset(75,8),14,C(251,246,227),true)
  text(b,def.description,UDim2.new(1,-86,0,40),UDim2.fromOffset(75,30),11,C(178,200,218))
 end
 if isCar and not selectedCarId then
  text(b,"Нет купленных машин в каталоге",UDim2.new(1,-22,0,32),UDim2.fromOffset(11,136),12,C(240,185,145))
 elseif isPet and not owned then
  text(b,"Нужно открыть питомца один раз (кнопки выше)",
   UDim2.new(1,-22,0,33),UDim2.fromOffset(11,137),12,C(185,193,209),true)
 elseif isHero and not catalogReady then
  text(b,catalogPreviews:GetAttribute(def.catalogLook.."_Unavailable")and"Образ недоступен в Roblox. Покупка отключена."or"Образ Roblox загружается. Покупка доступна после загрузки.",UDim2.new(1,-22,0,34),UDim2.fromOffset(11,actionY),11,C(185,202,218))
 elseif owned then
  if selected then
   button(b,"НАДЕТО ✓",UDim2.new(.5,-17,0,34),UDim2.fromOffset(11,actionY),nil,C(91,139,151),false)
   button(b,"СНЯТЬ",UDim2.new(.5,-17,0,34),UDim2.new(.5,6,0,actionY),function()
    if isCar then send("unequipCar",def.category,def.id,selectedCarId)
    else send("unequip",def.category,def.id) end
   end,C(172,172,184))
  else
   button(b,isCar and "ПРИМЕНИТЬ К МАШИНЕ" or (isPet and "НАДЕТЬ БЕСПЛАТНО" or "НАДЕТЬ"),
    UDim2.new(1,-22,0,34),UDim2.fromOffset(11,actionY),function()
    if isCar then send("equipCar",def.category,def.id,selectedCarId)
    else send("equip",def.category,def.id) end
   end,C(120,229,185))
  end
 elseif isHero then
  button(b,("КУПИТЬ НАВСЕГДА · %d 💎"):format(def.price),UDim2.new(1,-22,0,34),UDim2.fromOffset(11,actionY),function()
   send("buyDiamonds",def.category,def.id)
  end,C(132,213,247),(tonumber(data.diamonds)or 0)&gt;=def.price)
 else
  button(b,("КУПИТЬ · %d 💎"):format(def.price),UDim2.new(1,-22,0,34),UDim2.fromOffset(11,actionY),function()
   send("buyDiamonds",def.category,def.id)
  end,C(132,213,247),(tonumber(data.diamonds) or 0)&gt;=def.price)
 end
end
render=function()
 if not panel.Visible then return end
 local ok,data=pcall(function()return dataRequest:InvokeServer() end)
 if not ok or type(data)~="table" then return end
 subtitle.Text=("$ %s  ·  💎 %s   |   БОНУСЫ — НА ВСЕ МОНЕТЫ И КАССУ"):format(fmt(data.money),fmt(data.diamonds))
 for _,child in ipairs(tabs:GetChildren()) do if child~=tabLayout then child:Destroy() end end
 for _,opt in ipairs(modes) do
  local category=opt[1]
  local btn=button(tabs,opt[2],UDim2.new(1/#modes,-5,1,0),UDim2.new(),function()
   state=category
   render()
  end,state==category and C(131,229,192) or C(69,100,123))
  btn.TextSize=11
 end
 previewTurntables={}
 previewPets={}
 for _,child in ipairs(scroller:GetChildren()) do if child~=layout then child:Destroy() end end
 if state=="hero" or state=="pet" then
  if state=="hero"then
   local ownAvatar=box(scroller,89,C(30,57,68))
   text(ownAvatar,"МОЙ ROBLOX-АВАТАР",UDim2.new(.53,-14,0,26),UDim2.fromOffset(12,7),14,C(229,243,239),true)
   text(ownAvatar,"Вернуть свою одежду, лицо и аксессуары. Костюмы остаются в коллекции.",UDim2.new(.53,-14,0,44),UDim2.fromOffset(12,34),11,C(182,211,216))
   local equipped=data.cosmeticsEquipped and data.cosmeticsEquipped.hero
   button(ownAvatar,equipped and "ВЕРНУТЬ МОЙ АВАТАР"or"СВОЙ АВАТАР УЖЕ НАДЕТ",UDim2.new(.45,-12,0,48),UDim2.new(.55,0,0,20),function()
    send("unequip","hero",nil)
   end,C(133,229,202),equipped~=nil)
  end
  mastery(state,data)
  if state=="pet" then petLicense(data) end
 elseif state=="paint" or state=="skin" then
  vehicleSelector(data)
  notice("Краска или стиль покупается один раз и применяется только к выбранной модели автомобиля. Другие машины не меняются. 3D-превью показывает выбранную модель.")
 else
  notice("Аура оставляет шлейф и затухающие частицы при движении. На месте эффект не создаётся.")
 end
 if state=="hero" then
  local total=0
  for _,def in ipairs(Config.List) do if def.category=="hero"and not def.hiddenFromShop then total+=1 end end
  local pages=math.max(1,math.ceil(total/HERO_PAGE_SIZE))
  heroPage=math.clamp(heroPage,1,pages)
  notice(("ОБРАЗЫ ROBLOX · %d разных образов · %d/%d"):format(total,heroPage,pages))
  local pager=box(scroller,44,C(27,53,69))
  button(pager,"◀ НАЗАД",UDim2.new(.35,-10,0,34),UDim2.fromOffset(8,5),function()
   heroPage=math.max(1,heroPage-1);scroller.CanvasPosition=Vector2.new(0,0);render()
  end,C(121,216,247),heroPage&gt;1)
  text(pager,("%d / %d"):format(heroPage,pages),UDim2.new(.26,0,0,34),UDim2.new(.37,0,0,5),13,C(239,247,255),true)
  button(pager,"ДАЛЬШЕ ▶",UDim2.new(.34,-7,0,34),UDim2.new(.66,0,0,5),function()
   heroPage=math.min(pages,heroPage+1);scroller.CanvasPosition=Vector2.new(0,0);render()
  end,C(121,216,247),heroPage&lt;pages)
 end
 if state=="pet" then
  local count=0
  for _,def in ipairs(Config.List) do if def.category=="pet" then count+=1 end end
  local pages=math.max(1,math.ceil(count/PET_PAGE_SIZE))
  petPage=math.clamp(petPage,1,pages)
  notice(("%d уникальных 3D-питомцев · все доступны сразу после лицензии · сейчас показаны все варианты"):format(count))
  local pager=box(scroller,44,C(27,53,69))
  button(pager,"◀ НАЗАД",UDim2.new(.35,-10,0,34),UDim2.fromOffset(8,5),function()
   petPage=math.max(1,petPage-1);scroller.CanvasPosition=Vector2.new(0,0);render()
  end,C(121,216,247),petPage&gt;1)
  text(pager,("%d / %d"):format(petPage,pages),UDim2.new(.26,0,0,34),UDim2.new(.37,0,0,5),13,C(239,247,255),true)
  button(pager,"ДАЛЬШЕ ▶",UDim2.new(.34,-7,0,34),UDim2.new(.66,0,0,5),function()
   petPage=math.min(pages,petPage+1);scroller.CanvasPosition=Vector2.new(0,0);render()
  end,C(121,216,247),petPage&lt;pages)
 end
 local heroIndex=0
 local petIndex=0
 for _,def in ipairs(Config.List) do
  if def.category==state and not(state=="hero"and def.hiddenFromShop)then
   if state=="hero" then
    heroIndex+=1
    if heroIndex&gt;(heroPage-1)*HERO_PAGE_SIZE and heroIndex&lt;=heroPage*HERO_PAGE_SIZE then itemCard(def,data) end
   elseif state=="pet" then
    petIndex+=1
    if petIndex&gt;(petPage-1)*PET_PAGE_SIZE and petIndex&lt;=petPage*PET_PAGE_SIZE then itemCard(def,data) end
   else
    itemCard(def,data)
   end
  end
 end
end
catalogPreviews:GetAttributeChangedSignal("Revision"):Connect(function()
 task.delay(.25,function()if panel.Visible and state=="hero"then render()end end)
end)
player:GetAttributeChangedSignal("Steal60ShowCarPaint"):Connect(function()
 local id=player:GetAttribute("Steal60ShowCarPaint")
 if typeof(id)=="string" and id~="" then
  selectedCarId=id
  state="paint"
  setOpen(true)
  render()
 end
end)

openNpc.OnClientEvent:Connect(function(kind)
 if kind~="cosmetics" then
  setOpen(false)
  return
 end
 state="hero"
 setOpen(true)
 render()
end)
update.OnClientEvent:Connect(function() if panel.Visible then task.defer(render) end end)
currency.OnClientEvent:Connect(function() if panel.Visible then task.defer(render) end end)
Input.InputBegan:Connect(function(input,processed)
 if not processed and input.KeyCode==Enum.KeyCode.Escape and panel.Visible then setOpen(false) end
end)


----------------------------------------------------------------------
-- STEAL60 V45 / PET &amp; AURA ANIMATION -- CLIENT ONLY, NO NETWORK DELAY
-- Anchored visual parts and follow positioning animate locally; server owns cosmetics inventory.
----------------------------------------------------------------------
task.spawn(function()
 local pets=workspace:WaitForChild("Steal60CosmeticPets",30)
 if not pets then return end
 local followState={}
 local ray=RaycastParams.new()
 ray.FilterType=Enum.RaycastFilterType.Exclude
 ray.IgnoreWater=true
 local function animatePet(model,t)
  local owner=Players:GetPlayerByUserId(model:GetAttribute("PetOwnerUserId")or 0)
  local root=owner and owner.Character and owner.Character:FindFirstChild("HumanoidRootPart")
  local v=root and root.AssemblyLinearVelocity or Vector3.zero
  PetAnimation.step(model,t,Vector3.new(v.X,0,v.Z).Magnitude,model:GetAttribute("PetMounted")==true)
 end
 local function animateAura(character,t)
  local root=character:FindFirstChild("HumanoidRootPart")
  if root then AuraVisuals.step(root,t)end
 end
 -- All clients calculate pet poses from the owner's locally interpolated character.
 -- Absolutely no server-side pet PivotTo to fight with these transforms.
 local function updateFollow(model,dt,t)
  if not model:IsA("Model") or not model.PrimaryPart then return end
  local id=model:GetAttribute("PetOwnerUserId")
  local petId=model:GetAttribute("CosmeticId")
  local owner=typeof(id)=="number" and Players:GetPlayerByUserId(id)
  local char=owner and owner.Character
  local root=char and char:FindFirstChild("HumanoidRootPart")
  if not root then followState[model]=nil;return end
  local float=model:GetAttribute("PetMovementType")~="ground"
  local hum=char:FindFirstChildOfClass("Humanoid")
  local seat=hum and hum.SeatPart
  local vehicle=seat and seat:IsA("VehicleSeat") and seat:FindFirstAncestorOfClass("Model")
  local body=vehicle and vehicle:GetAttribute("Drivable") and
      (vehicle:FindFirstChild("Body",true) or vehicle.PrimaryPart)
  local onCar=body~=nil and body:IsA("BasePart")
  if model:GetAttribute("PetMounted")~=onCar then
   model:SetAttribute("PetMounted",onCar)
  end
  local desired
  if onCar then
   local rear=-math.max(2.4,body.Size.X*.36)
   local height=body.Size.Y*.5+(float and 2.20 or (model:GetAttribute("PetGroundOffset")or .92))
   local lateral=float and -1.5 or 0
   desired=body.CFrame*CFrame.new(rear,height,lateral)*CFrame.Angles(0,-math.pi/2,0)
  else
   local offset=root.CFrame*CFrame.new(float and 3.55 or 3.25,0,float and 3.65 or 3.9)
   local y
   if float then
    y=root.Position.Y+1.75+math.sin(t*3.1+id*.013)*.22
   else
    local st=followState[model]
    if not st or t-(st.lastGround or 0)&gt;.095 then
     ray.FilterDescendantsInstances={char,model,vehicle or char}
     local hit=workspace:Raycast(offset.Position+Vector3.new(0,9,0),Vector3.new(0,-25,0),ray)
     if not st then st={};followState[model]=st end
     st.ground=hit and hit.Position.Y or (root.Position.Y-2.8)
     st.lastGround=t
    end
    local vel=root.AssemblyLinearVelocity
    local speed=Vector3.new(vel.X,0,vel.Z).Magnitude
    local hop=speed&gt;2 and math.max(0,math.sin(t*math.min(15,6.2+speed*.34)))*.06 or 0
    y=(st and st.ground or root.Position.Y-2.8)+(model:GetAttribute("PetGroundOffset")or .89)+hop
   end
   local v=root.AssemblyLinearVelocity
   local dir=Vector3.new(v.X,0,v.Z)
   local speed=dir.Magnitude
   if speed&lt;2 then
    local forward=root.CFrame.LookVector
    dir=Vector3.new(forward.X,0,forward.Z)
   end
   if dir.Magnitude&lt;.01 then dir=Vector3.new(0,0,-1) end
   local pos=Vector3.new(offset.Position.X,y,offset.Position.Z)
   desired=CFrame.lookAt(pos,pos+dir.Unit)
   if not float then
    local gait=math.clamp((speed-1.0)/10.5,0,1)
    local cycle=t*(5.8+speed*.42)
    local bounce=math.abs(math.sin(cycle))*.11*gait
    local pitch=math.sin(cycle)*.09*gait
    local roll=math.sin(cycle*.5)*.045*gait*(petId=="pet_fox" and 1.35 or 1.0)
    desired=desired*CFrame.new(0,bounce,0)*CFrame.Angles(pitch,0,roll)
   end
  end
  local current=model.PrimaryPart.CFrame
  local distance=(current.Position-desired.Position).Magnitude
  local state=followState[model]
  if not state then state={};followState[model]=state end
  if onCar or distance&gt;55 or state.mounted~=onCar then
   model.PrimaryPart.CFrame=desired
  else
   local response=float and 11.5 or 13.5
   local alpha=1-math.exp(-math.min(dt,.10)*response)
   model.PrimaryPart.CFrame=current:Lerp(desired,alpha)
  end
  state.mounted=onCar
 end
 RunService.RenderStepped:Connect(function(dt)
  local now=os.clock()
  if panel.Visible then
   for _,pet in ipairs(previewPets)do
    if pet.Parent then PetAnimation.step(pet,now,0,false)end
   end
  end
  for _,model in ipairs(pets:GetChildren()) do
   updateFollow(model,dt,now)
   animatePet(model,now)
  end
  for _,viewer in ipairs(Players:GetPlayers())do
   if viewer.Character then animateAura(viewer.Character,now)end
  end
  for model in pairs(followState) do
   if not model.Parent then followState[model]=nil;PetAnimation.release(model) end
  end
 end)
end)
</ProtectedString>
          </Properties>
        </Item>
      </Item>
    </Item>
