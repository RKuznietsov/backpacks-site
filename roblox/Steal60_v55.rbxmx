        <Item class="ModuleScript" referent="RBX0">
          <Properties>
            <string name="Name">Rarity</string>
            <ProtectedString name="Source">-- ModuleScript: ReplicatedStorage/Shared/Rarity
local Rarity = {}

Rarity.Order = { "common", "rare", "epic", "legendary" }

Rarity.Info = {
	common    = { name = "Обычная",     color = Color3.fromRGB(200, 200, 200), incomeMult = 1  },
	rare      = { name = "Редкая",      color = Color3.fromRGB(70, 140, 255),  incomeMult = 2  },
	epic      = { name = "Эпическая",   color = Color3.fromRGB(170, 80, 255),  incomeMult = 5  },
	legendary = { name = "Легендарная", color = Color3.fromRGB(255, 190, 40),  incomeMult = 15 },
}

-- Взвешенный выбор: weights = { common = 70, rare = 20, ... }
function Rarity.roll(weights, rng)
	rng = rng or Random.new()
	local total = 0
	for _, w in pairs(weights) do
		total += w
	end
	local pick = rng:NextNumber() * total
	for _, key in ipairs(Rarity.Order) do
		local w = weights[key]
		if w then
			pick -= w
			if pick &lt;= 0 then
				return key
			end
		end
	end
	return Rarity.Order[1]
end

return Rarity
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX1">
          <Properties>
            <string name="Name">TrackLayout</string>
            <ProtectedString name="Source">-- ModuleScript: ReplicatedStorage/Shared/TrackLayout
-- Геометрия трассы по оси X.
--   [0 .. SalonZoneLength]            зона салонов
--   перекрёсток 1 -&gt; район 1 -&gt; перекрёсток 2 -&gt; район 2 -&gt; ...
local Settings = require(script.Parent.Config.Settings)
local Districts = require(script.Parent.Config.Districts)

local T = Settings.Track
local STEP = T.IntersectionLength + T.DistrictLength

local Layout = {}
Layout.Count = #Districts

-- Начало самого района (после перекрёстка)
function Layout.districtStart(i)
	return T.SalonZoneLength + T.IntersectionLength + (i - 1) * STEP
end

function Layout.districtEnd(i)
	return Layout.districtStart(i) + T.DistrictLength
end

-- Начало перекрёстка перед районом
function Layout.intersectionStart(i)
	return Layout.districtStart(i) - T.IntersectionLength
end

-- 0 = зона салонов, иначе номер района (перекрёсток относится к району за ним)
function Layout.indexAt(x)
	if x &lt; T.SalonZoneLength then
		return 0
	end
	return math.min(Layout.Count, math.floor((x - T.SalonZoneLength) / STEP) + 1)
end

function Layout.trackEnd()
	return Layout.districtEnd(Layout.Count)
end

return Layout
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX2">
          <Properties>
            <string name="Name">HackMath</string>
            <ProtectedString name="Source">-- Steal60 HackMath V5. Shared display curves; all taps validated on SERVER time.
local HackMath = {}

-- t is time from the round's synchronized server start.
function HackMath.markerPos(t, period, mode)
    if t &lt;= 0 then return 0 end
    -- The dial is a real clockwise sweep: a full, constant-speed 360° per
    -- period, without easing/oscillating like a bouncing bar.
    if mode == "dial" then return (t / period) % 1 end
    local phase=(t / period) % 2
    return phase &lt;= 1 and phase or (2 - phase)
end

function HackMath.zonePos(t, period, mode, round, center, width)
    if mode == "signal" then
        -- The target sweeps slowly independently of the cursor.
        local wave = .055 * math.sin(t / period * math.pi * .65 + (round or 1) * 1.29)
        return math.clamp(center + wave, width / 2 + .04, 1 - width / 2 - .04)
    end
    return center
end

function HackMath.accuracy(t, period, mode, round, center, width, tolerance)
    local pos = HackMath.markerPos(t, period, mode)
    local goal = HackMath.zonePos(t, period, mode, round, center, width)
    local delta=math.abs(pos-goal)
    if mode=="dial" then delta=math.min(delta,1-delta) end
    local ok = delta &lt;= width / 2 + (tolerance or 0)
    local quality = 1 - math.clamp(delta / (width / 2 + .01), 0, 1)
    return ok, quality, pos, goal
end

-- Compatibility helpers used by existing code.
function HackMath.barPos(t, period)
    return HackMath.markerPos(t, period, "pins")
end
function HackMath.isHit(delta, period, center, width, tolerance)
    local ok = HackMath.accuracy(delta, period, "pins", 1, center, width, tolerance)
    return ok
end

return HackMath
</ProtectedString>
          </Properties>
        </Item>
        <Item class="Folder" referent="RBX8">
