        <Item class="ModuleScript" referent="RBX_STEAL60_V53_WardrobeService"><Properties><string name="Name">WardrobeService</string><ProtectedString name="Source">-- Real Roblox HumanoidDescriptions, with serialized application and exact avatar restoration.
local RS=game:GetService('ReplicatedStorage')
local Config=require(RS.Shared.Config.CosmeticConfig)
local Owner=require(script.Parent.OwnerService)
local Styles=require(RS.Shared.AvatarStyleLibrary)
local Outfit=require(RS.Shared.AvatarOutfit)
local Net=require(script.Parent.Net)
local M={};local templates={};local states={};local started=false
local previous=RS:FindFirstChild('Steal60CatalogPreviews');if previous then previous:Destroy()end
local previews=Instance.new('Folder');previews.Name='Steal60CatalogPreviews';previews.Parent=RS
local function cleanupLegacy(char)
 for _,name in ipairs({'Steal60HeroSkin','Steal60VendorSignature'})do local old=char:FindFirstChild(name);if old then old:Destroy()end end
 for _,obj in ipairs(char:GetDescendants())do
  if obj:IsA('BasePart')or obj:IsA('Decal')or obj:IsA('Texture')then
   for _,key in ipairs({'Steal60BodyTransparency','Steal60FaceTransparency','Steal60SavedTransparency'})do
    local before=obj:GetAttribute(key)
    if before~=nil then obj.Transparency=before;obj:SetAttribute(key,nil)end
   end
  end
 end
end
function M.init()
 if started then return end;started=true
 local remaining=#Config.CatalogOrder
 for _,key in ipairs(Config.CatalogOrder)do
  task.spawn(function()
   local preset=Config.CatalogLooks[key]
   local ok,rig=pcall(Owner.catalogRig,preset)
   if ok and rig and rig:GetAttribute('MarketplaceLook')==true then
    local hum=rig:FindFirstChildOfClass('Humanoid')
    local loaded,desc=pcall(function()return hum:GetAppliedDescription()end)
    if loaded and desc then
     templates[key]={description=desc,role=preset.role}
     rig.Name=key;rig:PivotTo(CFrame.new())
     for _,obj in ipairs(rig:GetDescendants())do
      if obj:IsA('BasePart')then obj.Anchored=true;obj.CanCollide=false;obj.CanTouch=false;obj.CanQuery=false
      elseif obj:IsA('BaseScript')then obj:Destroy()end
     end
     rig:SetAttribute('CatalogReady',true);rig.Parent=previews
     previews:SetAttribute(key,true);previews:SetAttribute('Revision',(previews:GetAttribute('Revision')or 0)+1)
    else rig:Destroy()end
   elseif ok and rig then rig:Destroy()end
   if not templates[key]then
    previews:SetAttribute(key..'_Unavailable',true);previews:SetAttribute('Revision',(previews:GetAttribute('Revision')or 0)+1)
    warn('[Steal60 Wardrobe] Catalog outfit unavailable: '..key)
   end
   remaining-=1
   if remaining==0 then previews:SetAttribute('LoadFinished',true)end
  end)
 end
end
function M.isReady(def)return def and templates[def.catalogLook]~=nil end
local function run(player,state)
 while player.Parent and not state.dead do
  local revision=state.revision;local look=state.look
  local char=player.Character;local hum=char and char:FindFirstChildOfClass('Humanoid')
  if not char or not hum then break end
  if state.character~=char then
   if state.original then state.original:Destroy()end
   state.character=char;state.original=nil;state.changed=false
  end
  if not look and not state.changed then
   cleanupLegacy(char)
   if state.hadSelection then Net.notify(player,'Твой Roblox-аватар восстановлен. Купленные образы сохранены.','good');state.hadSelection=false end
   break
  end
  local deadline=os.clock()+20
  while player.Parent and player.Character==char and revision==state.revision and not player:HasAppearanceLoaded()and os.clock()&lt;deadline do task.wait(.1)end
  if player.Character~=char or revision~=state.revision then continue end
  if not player:HasAppearanceLoaded()then
   Net.notify(player,'Внешность Roblox ещё загружается. Попробуй надеть образ чуть позже.','info');break
  end
  if not state.original then
   cleanupLegacy(char)
   local ok,description=pcall(function()return hum:GetAppliedDescription()end)
   if not ok then break end
   state.original=description
  end
  while look and not templates[look]and not previews:GetAttribute('LoadFinished')and revision==state.revision and player.Parent and os.clock()&lt;deadline do task.wait(.1)end
  if revision~=state.revision or player.Character~=char then continue end
  local entry=look and templates[look]
  if look and not entry then
   Net.notify(player,'Этот каталожный образ сейчас не загрузился. Твой аватар сохранён.','info');break
  end
  cleanupLegacy(char)
  local description=entry and Outfit.compose(state.original,entry.description)or state.original:Clone()
  local ok,err=pcall(function()hum:ApplyDescriptionResetAsync(description)end);description:Destroy()
  if not ok then
   warn('[Steal60 Wardrobe] ApplyDescription failed: '..tostring(err))
   -- Restore immediately, even when the failed API call partially modified the rig.
   if state.original then
    local original=state.original:Clone();pcall(function()hum:ApplyDescriptionResetAsync(original)end);original:Destroy()
   end
   state.changed=false
   Net.notify(player,'Roblox не применил образ. Возвращён твой аватар.','info')
  else state.changed=look~=nil end
  if player.Character==char and revision==state.revision then
   if ok and entry and entry.role then pcall(Styles.applyVendorSignature,char,entry.role)end
   char:SetAttribute('Steal60CatalogLook',ok and look or nil)
   if ok and not look then Net.notify(player,'Твой Roblox-аватар восстановлен. Купленные образы сохранены.','good');state.hadSelection=false end
   if M.onApplied then pcall(M.onApplied,player)end
  end
  if revision==state.revision then break end
 end
 state.running=false
end
function M.request(player,def)
 M.init()
 local state=states[player]
 local look=def and def.catalogLook or nil
 if state and state.character==player.Character and state.look==look and(state.running or state.changed==(look~=nil))then return end
 if not state then state={revision=0};states[player]=state end
 state.look=look;if look then state.hadSelection=true end;state.revision+=1
 if not state.running then
  state.running=true
  task.spawn(function()
   local ok,err=pcall(run,player,state);state.running=false
   if not ok then
    warn('[Steal60 Wardrobe] Worker failed: '..tostring(err))
    if player.Parent then Net.notify(player,'Roblox не завершил смену внешности. Попробуй ещё раз.','info')end
   end
  end)
 end
end
function M.remove(player)
 local state=states[player]
 if state then state.dead=true;state.revision+=1;if state.original then state.original:Destroy();state.original=nil end end
 states[player]=nil
end
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_STEAL60_V55_TutorialService"><Properties><string name="Name">TutorialService</string><ProtectedString name="Source">-- Server-owned onboarding. Clients can acknowledge explanations, never gameplay steps.
local Players=game:GetService('Players')
local RS=game:GetService('ReplicatedStorage')
local Workspace=game:GetService('Workspace')
local Data=require(script.Parent.DataService)
local Net=require(script.Parent.Net)
local Config=require(RS.Shared.TutorialConfig)
local Progress=require(RS.Shared.TutorialProgress)
local Loot=require(RS.Shared.Config.Loot)
local M={};local sessions={};local started=false
local function session(player)
 local s=sessions[player];if not s then s={index=0,openedAt=0,lastAction=-10};sessions[player]=s end;return s
end
local function saveSoon(player,s)
 s.dirty=true;if s.saving then return end;s.saving=true
 task.spawn(function()
  while s.dirty and player.Parent do
   s.dirty=false;task.wait(.5)
   if Data.canSave(player)then Data.saveNow(player)end
  end
  s.saving=false
 end)
end
local function target(player,step,s)
 if not step then return nil end
 local ctx=s.context or{};local kind=step.target
 if kind=='starter'then
  local root=player.Character and player.Character:FindFirstChild('HumanoidRootPart')
  local origin=root and root.Position or Vector3.zero
  local best,score=nil,math.huge;local districts=Workspace:FindFirstChild('Districts');local data=Data.get(player)
  local item=Loot.ById[Progress.ensure(data).itemId]
  local wantedZone=step.id=='copies'and item and item.zone or nil
  if districts then for _,car in ipairs(districts:GetDescendants())do
   if car:IsA('Model')and car:GetAttribute('State')=='available'and(car:GetAttribute('RequiredHack')or 1)&lt;=(data.hackLevel or 1)and(not wantedZone or car:GetAttribute('DistrictIndex')==wantedZone)then
    local position=car:GetPivot().Position;local cost=(position-origin).Magnitude+(car:GetAttribute('TutorialStarter')and 0 or 250)
    if cost&lt;score then best=position;score=cost end
   end
  end end
  return best or(wantedZone and ctx.zones and ctx.zones[wantedZone])or ctx.starter
 elseif kind=='thief'then
  local thieves=Workspace:FindFirstChild('Thieves')
  if thieves then for _,rig in ipairs(thieves:GetChildren())do if rig:GetAttribute('SalonOwnerId')==player.UserId and rig.PrimaryPart then return rig.PrimaryPart.Position end end end
  return ctx.till
 end
 return ctx[kind]
end
function M.sync(player,force)
 local data=Data.get(player);if not data or not player.Parent then return end
 local s=session(player);local p=Progress.ensure(data)
 if not p.done.loot and not Progress.owns(data,p.itemId)then
  for _,list in ipairs({data.shelf or{},data.shelfStorage or{}})do
   for _,it in ipairs(list)do if Loot.ById[it.id]then p.itemId=it.id;break end end
   if Progress.owns(data,p.itemId)then break end
  end
 end
 if s.context and s.context.hasRide and p.done.ride and not p.done.helper and not s.context.hasRide()then Progress.record(data,'ride_lost')end
 local index=Progress.advance(data,Config.Steps);local step=Config.Steps[index]
 local changed=index~=s.index
 if changed then s.index=index;s.openedAt=os.clock();saveSoon(player,s)end
 local legacy=step and({start=1,lock=2,delivery=3,ride=4,helper=5})[step.id]or 6
 data.tutorialStage=legacy
 player:SetAttribute('TutorialStage',legacy)
 player:SetAttribute('TutorialStep',step and step.id or nil)
 player:SetAttribute('TutorialStepIndex',index)
 player:SetAttribute('TutorialComplete',step==nil)
 player:SetAttribute('TutorialDefenceLearned',p.done.defend==true)
 local position=target(player,step,s)
 player:SetAttribute('TutorialTargetPosition',position)
 player:SetAttribute('TutorialItemId',p.itemId)
 local item=Loot.ById[p.itemId]
 local canRead=step and step.lesson==true
 local awaitingLoot=step and step.id=='loot'and not Progress.owns(data,p.itemId)
 if awaitingLoot then canRead=false;player:SetAttribute('TutorialTargetPosition',target(player,Config.ById.start,s))end
 if canRead and({cosmetics='cosmetics',pets='cosmetics',diamonds='diamonds',parts='workshop'})[step.id]then
  canRead=p.signals['open_'..({cosmetics='cosmetics',pets='cosmetics',diamonds='diamonds',parts='workshop'})[step.id]]==true
 end
 if changed or force then
  Net.TutorialUpdate:FireClient(player,{index=index,total=#Config.Steps,id=step and step.id,canRead=canRead,
   awaitingLoot=awaitingLoot,itemId=p.itemId,itemZone=item and item.zone or 1,itemName=item and item.name or'учебный предмет',copies=tonumber((data.lootCopies or{})[p.itemId])or 0,
   stars=tonumber((data.lootRanks or{})[p.itemId])or 0,done=table.clone(p.done)})
 end
end
function M.bind(player,context)session(player).context=context;M.sync(player,true)end
function M.event(player,event,id)
 local data=Data.get(player);if not data then return end
 Progress.record(data,event,id);M.sync(player,true)
end
function M.vendor(player,kind)
 local data=Data.get(player);if not data then return end
 local p=Progress.ensure(data);p.signals['open_'..kind]=true
 if kind=='workshop'then Progress.record(data,'workshop_open')end
 M.sync(player,true)
end
function M.lootOverride(player,zone)
 local data=Data.get(player);if not data then return nil end
 local id=Progress.forcedLoot(data);local def=id and Loot.ById[id]
 if def and def.zone==zone then return def end
 return nil
end
function M.usedLootOverride(player)
 local data=Data.get(player);if data then local p=Progress.ensure(data);p.forcedDrops+=1 end
end
function M.isFirstHeist(player)
 local data=Data.get(player);if not data then return false end
 return not Progress.ensure(data).done.delivery
end
function M.init()
 if started then return end;started=true
 Net.TutorialAction.OnServerEvent:Connect(function(player,action,id)
  local s=session(player)
  if typeof(action)~='string'or os.clock()-s.lastAction&lt;.2 then return end;s.lastAction=os.clock()
  if action=='request'then M.sync(player,true);return end
  if action=='restart'then
   local data=Data.get(player);if not data then return end
   Progress.restart(data);M.sync(player,true);return
  end
  if action~='read'or typeof(id)~='string'or #id&gt;32 then return end
  local data=Data.get(player);if not data then return end
  local index=Progress.advance(data,Config.Steps);local step=Config.Steps[index]
  if not step or step.id~=id or not step.lesson then return end
  local needed=({cosmetics='cosmetics',pets='cosmetics',diamonds='diamonds',parts='workshop'})[id]
  if needed and not Progress.ensure(data).signals['open_'..needed]then return end
  if Progress.lesson(data,step)then M.sync(player,true)end
 end)
 local function onPlayer(player)
  Data.onLoaded(player,function(data)Progress.rejoin(data);M.sync(player,true)end)
  local function onCharacter(char)
   -- Carrying a car cannot survive respawn; always recover even if death occurred before the first listener.
   M.event(player,'heist_failed')
   local hum=char:WaitForChild('Humanoid',8)
   if hum then hum.Died:Connect(function()M.event(player,'heist_failed')end)end
  end
  player.CharacterAdded:Connect(onCharacter)
  if player.Character then task.spawn(onCharacter,player.Character)end
 end
 Players.PlayerAdded:Connect(onPlayer)
 for _,player in ipairs(Players:GetPlayers())do onPlayer(player)end
 Players.PlayerRemoving:Connect(function(player)sessions[player]=nil end)
 task.spawn(function()
  while true do task.wait(2)
   for player in pairs(sessions)do if player.Parent then M.sync(player,true)end end
  end
 end)
end
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_STEAL60_V55_NPCNavigator"><Properties><string name="Name">NPCNavigator</string><ProtectedString name="Source">-- Physical humanoid navigation. Failed paths stop/replan; they never fall back to teleporting.
local Pathfinding=game:GetService('PathfindingService')
local Workspace=game:GetService('Workspace')
local M={};M.__index=M
function M.new(rig)
 local self=setmetatable({rig=rig,hum=rig:FindFirstChildOfClass('Humanoid'),root=rig:FindFirstChild('HumanoidRootPart'),tracks={}},M)
 self.ray=RaycastParams.new();self.ray.FilterType=Enum.RaycastFilterType.Exclude;self.ray.FilterDescendantsInstances={rig};self.ray.RespectCanCollide=true
 self.hum.AutoRotate=true
 for _,p in ipairs(rig:GetDescendants())do if p:IsA('BasePart')then p.Anchored=false end end
 self.root.CanCollide=false;pcall(function()self.root:SetNetworkOwner(nil)end)
 local animator=self.hum:FindFirstChildOfClass('Animator')or Instance.new('Animator');animator.Parent=self.hum
 for name,id in pairs({idle=507766666,walk=507777826,run=507767714})do
  local animation=Instance.new('Animation');animation.AnimationId='rbxassetid://'..id
  local ok,track=pcall(function()return animator:LoadAnimation(animation)end);animation:Destroy()
  if ok then track.Looped=true;track.Priority=name=='idle'and Enum.AnimationPriority.Idle or Enum.AnimationPriority.Movement;self.tracks[name]=track end
 end
 self:setMotion('idle');return self
end
function M:alive()return self.rig.Parent~=nil and self.root.Parent~=nil and self.hum.Health&gt;0 end
function M:setMotion(name)
 if self.action and name~='idle'then self.action:Stop(.15);self.action:Destroy();self.action=nil end
 if self.motion==name then return end;self.motion=name
 for key,track in pairs(self.tracks)do if key==name then track:Play(.18)else track:Stop(.18)end end
end
function M:gesture()
 local animator=self.hum:FindFirstChildOfClass('Animator');if not animator then return end
 local animation=Instance.new('Animation');animation.AnimationId='rbxassetid://507770453'
 local ok,track=pcall(function()return animator:LoadAnimation(animation)end);animation:Destroy()
 if ok then
  if self.action then self.action:Destroy()end;self.action=track;track.Priority=Enum.AnimationPriority.Action;track:Play(.15)
 end
end
function M:stop()
 if self:alive()then self.hum:MoveTo(self.root.Position)end;self:setMotion('idle')
end
function M:blocked(goal)
 local delta=Vector3.new(goal.X-self.root.Position.X,0,goal.Z-self.root.Position.Z)
 if delta.Magnitude&lt;.15 then return false end
 local length=math.min(delta.Magnitude,1.6)
 local hit=Workspace:Blockcast(CFrame.new(self.root.Position),Vector3.new(2.3,3.6,2.3),delta.Unit*length,self.ray)
 return hit~=nil
end
function M:go(goal,cancel,seconds)
 local deadline=os.clock()+(seconds or 18)
 for attempt=1,3 do
  if not self:alive()or(cancel and cancel())or os.clock()&gt;=deadline then self:stop();return false end
  local path=Pathfinding:CreatePath({AgentRadius=1.65,AgentHeight=5.5,AgentCanJump=false,AgentCanClimb=false,WaypointSpacing=4})
  local ok=pcall(function()path:ComputeAsync(self.root.Position,goal)end)
  if not ok or path.Status~=Enum.PathStatus.Success then path:Destroy();self:stop();return false end
  local waypoints=path:GetWaypoints();local retry=false
  for _,wp in ipairs(waypoints)do
   if not self:alive()or(cancel and cancel())then path:Destroy();self:stop();return false end
   local flat=Vector3.new(wp.Position.X-self.root.Position.X,0,wp.Position.Z-self.root.Position.Z)
   if flat.Magnitude&gt;1.5 then
    self:setMotion(self.hum.WalkSpeed&gt;17 and'run'or'walk');self.hum:MoveTo(wp.Position)
    local best=flat.Magnitude;local lastProgress=os.clock();local lastCommand=os.clock()
    while self:alive()do
     if(cancel and cancel())or os.clock()&gt;=deadline then path:Destroy();self:stop();return false end
     flat=Vector3.new(wp.Position.X-self.root.Position.X,0,wp.Position.Z-self.root.Position.Z)
     if flat.Magnitude&lt;=1.6 then break end
     if flat.Magnitude&lt;best-.15 then best=flat.Magnitude;lastProgress=os.clock()end
     if self:blocked(wp.Position)or os.clock()-lastProgress&gt;1.5 then retry=true;break end
     if os.clock()-lastCommand&gt;.7 then self.hum:MoveTo(wp.Position);lastCommand=os.clock()end
     task.wait(.08)
    end
   end
   if retry or not self:alive()then break end
  end
  path:Destroy()
  local distance=Vector3.new(goal.X-self.root.Position.X,0,goal.Z-self.root.Position.Z).Magnitude
  if self:alive()and not retry and distance&lt;=2.8 then self:stop();return true end
  self:stop();task.wait(.15)
 end
 return false
end
function M:lookAt(position,cancel,duration)
 self:stop();local begin=os.clock();local from=self.root.CFrame
 local destination=CFrame.lookAt(self.root.Position,Vector3.new(position.X,self.root.Position.Y,position.Z))
 while self:alive()and os.clock()-begin&lt;(duration or .35)do
  if cancel and cancel()then return false end
  local alpha=math.clamp((os.clock()-begin)/(duration or .35),0,1);alpha=alpha*alpha*(3-2*alpha)
  self.root.CFrame=from:Lerp(destination,alpha);task.wait(.04)
 end
 return self:alive()
end
function M:destroy()
 if self.action then self.action:Stop();self.action:Destroy();self.action=nil end
 for _,track in pairs(self.tracks)do track:Stop();track:Destroy()end
end
return M
</ProtectedString></Properties></Item></Item>
      <Item class="Script" referent="RBX29">
        <Properties>
          <string name="Name">Main</string>
          <bool name="Disabled">true</bool>
          <ProtectedString name="Source">-- Script: ServerScriptService/Main
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local Services = script.Parent:WaitForChild("Services")
local Shared = ReplicatedStorage:WaitForChild("Shared")

local CollisionService = require(Services:WaitForChild("CollisionService"))
local DataService = require(Services:WaitForChild("DataService"))
local SeasonLeaderboardService = require(Services:WaitForChild("SeasonLeaderboardService"))
local Net = require(Services:WaitForChild("Net"))
local TrackBuilder = require(Services:WaitForChild("TrackBuilder"))
local DistrictManager = require(Services:WaitForChild("DistrictManager"))
local ParkingService = require(Services:WaitForChild("ParkingService"))
local OwnerService = require(Services:WaitForChild("OwnerService"))
local PoliceService = require(Services:WaitForChild("PoliceService"))
local DriveService = require(Services:WaitForChild("DriveService"))
local DeliveryService = require(Services:WaitForChild("DeliveryService"))
local SalonService = require(Services:WaitForChild("SalonService"))
local HackService = require(Services:WaitForChild("HackService"))
local HeistService = require(Services:WaitForChild("HeistService"))
local RoadEventService = require(Services:WaitForChild("RoadEventService"))
local RoadChallengeService = require(Services:WaitForChild("RoadChallengeService"))
local UpgradeService = require(Services:WaitForChild("UpgradeService"))
local MonetizationService = require(Services:WaitForChild("MonetizationService"))
local Tutorial = require(Services:WaitForChild("TutorialService"))
local CosmeticService = require(Services:WaitForChild("CosmeticService"))

local Districts = require(Shared.Config.Districts)
local CarClasses = require(Shared.Config.CarClasses)
local Cars = require(Shared.Config.Cars)
local Rarity = require(Shared.Rarity)
local Layout = require(Shared.TrackLayout)

print("[Steal60] Main запущен")
Net.init()
DriveService.init()
CollisionService.init()
DataService.init()
Tutorial.init()
MonetizationService.init()
TrackBuilder.init()
SeasonLeaderboardService.init()
DistrictManager.init()
ParkingService.init()
OwnerService.init()
PoliceService.init()
DeliveryService.init()
RoadEventService.init()
RoadChallengeService.init()
HeistService.init()
SalonService.init()
UpgradeService.init()
CosmeticService.init()
HackService.init()

----------------------------------------------------------------------
-- Клиентский скрипт (мини-игра, уведомления, езда) кладём каждому игроку в PlayerGui
----------------------------------------------------------------------
local clientTemplate = ServerStorage:WaitForChild("ClientTemplates"):WaitForChild("ClientMain")

local function giveClient(player)
	local playerGui = player:WaitForChild("PlayerGui")
	if playerGui:FindFirstChild("Steal60Client") then
		return
	end
	local screen = Instance.new("ScreenGui")
	screen.Name = "Steal60Client"
	screen.ResetOnSpawn = false
	screen.Parent = playerGui
	clientTemplate:Clone().Parent = screen
    local nav = ServerStorage.ClientTemplates:FindFirstChild("RouteHUD")
    if nav then nav:Clone().Parent = screen end
    local runHUD = ServerStorage.ClientTemplates:FindFirstChild("HeistHUD")
    if runHUD then runHUD:Clone().Parent = screen end
    local eventHUD = ServerStorage.ClientTemplates:FindFirstChild("RoadChallengeHUD")
    if eventHUD then eventHUD:Clone().Parent = screen end
    local theftHUD = ServerStorage.ClientTemplates:FindFirstChild("TheftHUD")
    if theftHUD then theftHUD:Clone().Parent = screen end
    local economy = ServerStorage.ClientTemplates:FindFirstChild("EconomyHUD")
    if economy then economy:Clone().Parent = screen end
    local cosmetic = ServerStorage.ClientTemplates:FindFirstChild("CosmeticHUD")
    if cosmetic then cosmetic:Clone().Parent = screen end
    local tutorial = ServerStorage.ClientTemplates:FindFirstChild("TutorialHUD")
    if tutorial then tutorial:Clone().Parent = screen end
end

----------------------------------------------------------------------
-- ВРЕМЕННО (до этапов 5-6): награда за доставку и рост уровня взлома
----------------------------------------------------------------------
DeliveryService.onDelivered(function(player, info)
	local data = DataService.get(player)
	if not data then
		return
	end
    local isNew = DataService.addToCatalog(player, info.carId, info.rarity, info.variantId)
    local firstSuccess = data.botUnlocked ~= true
    if firstSuccess then
        data.botUnlocked = true
        player:SetAttribute("HelperUnlocked", true)
        Net.notify(player, "ПЕРВАЯ ДОСТАВКА! ПОМОЩНИК ОТКРЫТ. Теперь бери машину с витрины — помощник вернёт её при следующем взломе.", "good")
    end

	local variantMult = 1
	for _, v in ipairs(Cars.Variants) do
		if v.id == info.variantId then
			variantMult = v.incomeMult
		end
	end
	local reward = math.floor(CarClasses[info.classId].baseValue * Rarity.Info[info.rarity].incomeMult * variantMult * 0.25)
    local payout, runResult = HeistService.onDelivered(player, info, reward, isNew)
    -- Extra rewards are calculated from the delivered car and persisted server contract.
    local eventBonus, eventResult = RoadChallengeService.onDelivered(player, info, reward)
    local cosmeticBonusPct=require(Shared.Config.CosmeticConfig).coinBonusPct(data)
    payout += math.floor(eventBonus*(1+cosmeticBonusPct/100)+.5)
    DataService.addMoney(player, payout, true)
    if eventResult ~= "" then runResult ..= " · " .. eventResult end
    player:SetAttribute("HeistCarrying", false)
    SalonService.openCar(player, info, isNew, payout)
    SalonService.refresh(player) -- may have won a new accessory on delivery
    Tutorial.event(player,"delivered")
    Net.notify(player, ("Доставлено! +%d$ · %s%s"):format(
        payout, runResult, (isNew and " · НОВАЯ МАШИНА!" or "") .. (firstSuccess and " · ПОМОЩНИК ОТКРЫТ!" or "")), "good")
end)

----------------------------------------------------------------------
-- ВРЕМЕННО (тест): плашки на экране и быстрая ходьба в Studio
----------------------------------------------------------------------
local function makeLabel(gui, y, height)
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromOffset(340, height)
	label.Position = UDim2.fromOffset(10, y)
	label.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
	label.BackgroundTransparency = 0.3
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextSize = 20
	label.Font = Enum.Font.GothamBold
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Text = ""
	label.Parent = gui
	return label
end

local function setupDebug(player)
	if RunService:IsStudio() then
		local function apply(char)
			local hum = char:WaitForChild("Humanoid")
			hum.WalkSpeed = 50
		end
		player.CharacterAdded:Connect(apply)
		if player.Character then
			task.spawn(apply, player.Character)
		end
	end

	task.spawn(function()
		local gui = Instance.new("ScreenGui")
		gui.Name = "TrackDebug"
		gui.ResetOnSpawn = false
		local label = makeLabel(gui, 190, 90)
		gui.Parent = player:WaitForChild("PlayerGui")

		while player.Parent do
			local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			if hrp then
				local x = hrp.Position.X
				local idx = Layout.indexAt(x)
				local name = idx == 0 and "Зона салонов" or Districts[idx].name
				local list = DistrictManager.getLoadedIndices()
				label.Text = ("Район: %s\nЗагружены: %s\nX: %d"):format(
					name, #list &gt; 0 and table.concat(list, ", ") or "-", math.floor(x))
			end
			task.wait(0.3)
		end
	end)
end

local function setupStats(player)
	print("[Steal60] Жду данные игрока " .. player.Name)
	DataService.onLoaded(player, function(data)
        print("[Steal60] Данные загружены: " .. player.Name .. ", деньги = " .. data.money)
        if data.botUnlocked ~= true and next(data.catalog or {}) == nil then
            task.delay(5,function()
                if player.Parent and not player:GetAttribute("HelperUnlocked") then
                    Net.notify(player,"НАЧАЛО: первая машина пешком! Угони её и привези на ЗЕЛЁНУЮ площадку СВОЕГО салона, чтобы открыть помощника!","info")
                end
            end)
        end
		if player:FindFirstChild("leaderstats") then
			return
		end

		local stats = Instance.new("Folder")
		stats.Name = "leaderstats"
		local hack = Instance.new("IntValue")
		hack.Name = "Взлом"
		hack.Parent = stats
        local money=Instance.new("IntValue")
        money.Name="Деньги"
        money.Parent=stats
        local gems=Instance.new("IntValue")
        gems.Name="Алмазы"
        gems.Parent=stats
		stats.Parent = player

        while player.Parent do
            hack.Value = data.hackLevel
            money.Value=math.floor(data.money)
            gems.Value=math.floor(data.diamonds or 0)
            task.wait(1)
        end
	end)
end

local function onPlayer(player)
    if #Players:GetPlayers() &gt; 8 then
        player:Kick("Сервер рассчитан на 8 игроков. Попробуй другой сервер.")
        return
    end
    task.spawn(giveClient, player)
	setupStats(player)
    -- Beginning on foot: players run to the guaranteed tutorial car in the first district.
    local function giveRunSpeed(character)
        local humanoid = character:WaitForChild("Humanoid", 8)
        if humanoid then humanoid.WalkSpeed = 23 end
    end
    player.CharacterAdded:Connect(giveRunSpeed)
    if player.Character then task.spawn(giveRunSpeed, player.Character) end
	-- Cinematic edition: legacy studio debug boxes disabled; RouteHUD shows district and route progress.
end

Players.PlayerAdded:Connect(onPlayer)
for _, player in ipairs(Players:GetPlayers()) do
	onPlayer(player)
end
</ProtectedString>
        </Properties>
      </Item>
    </Item>
    <Item class="StringValue" referent="RBX1001">
      <Properties>
        <string name="Name">CarPackInfo</string>
        <string name="Value">Steal60 Stylized Realism v4: 150 original unbranded collectible cars, five gameplay tiers. Specialized roof profiles, glass, body contours, wheels with 8-12 metallic spokes, brake calipers, front DRLs, rear LEDs, cabin, bumpers, side aero, wings. Native Roblox Part geometry (not MeshPart). Built dynamically when cars spawn during Play. 12 legacy catalog IDs preserved. No external assets needed. High-detail mode; cap streaming for performance. This file is not a photorealistic 3D model pack.</string>
      </Properties>
    </Item>
  <Item class="StringValue" referent="RBX1002"><Properties><string name="Name">InstallationNotes</string><string name="Value">Steal60 v55 — готовый файл .rbxmx, без ZIP.

Питомцы:
Причина прежнего расхождения найдена в геометрии Roblox: примитив Ball сохраняет сферическую форму, тогда как модели были рассчитаны как вытянутые/приплюснутые объёмы. Все круглые формы десяти питомцев теперь используют SpecialMesh с MeshType Sphere, Scale (1,1,1) и размерами родительской детали. Это соответствует документации Roblox о свободном изменении размеров Sphere по трём осям. Черепашка дополнительно пересобрана: широкий зелёный панцирь, утопленные щитки, короткие цельные лапки, соединённая шея и более выразительная мордочка. Анимация её лап стала мягче. Кинематика без физического разлёта, один лисий хвост, цельный кошачий хвост и четыре ротора дрона сохранены.

Образы:
Шесть комплектов: AQUA PILOT, ЗОЛОТОЙ МАГНАТ, DJ МАНГО, ЛУННЫЙ СТРАЖ, NEON RUNNER и АЛЫЙ РЕЙСЕР. Используются реальные каталожные аксессуары Roblox и одежда; четыре разных головных аксессуара, а не процедурная броня из треугольников. Каждая карточка показывает загруженную модель. Загрузка комплектов независимая; частично загруженный комплект нельзя купить. Образы продаются только за алмазы одной кнопкой; сервер проверяет цену, наличие алмазов и владение. Ошибка сохранения откатывает покупку. Старое владение и ID сохранены. Тело, размеры и анимации игрока сохраняются; ВЕРНУТЬ МОЙ АВАТАР работает как прежде. Доступность и внешний вид сторонних вещей зависят от Roblox при запуске.

Воришка:
Новый физический NPC с Animator и PathfindingService идёт с улицы через центральный вход, останавливается перед кассой, поворачивается и делает жест рукой. При побеге проходит посещённый маршрут в обратном порядке. Проверяется свободное место перед телом; неудачный путь останавливает/перестраивает движение, прямого перемещения сквозь стены нет. Боковое стекло стало препятствием для пешеходов. Прогнать NPC можно только владельцу, рядом и в пределах видимости. Деньги забираются после подхода к кассе и паузы; охрана по-прежнему может помешать. Учебный налёт не отнимает и не выдаёт деньги.

Обучение:
25 последовательных уроков с серверными контрольными точками: первая машина, замок, доставка, получение предмета, мастерская, снятие с полки, установка обратно, касса, поездка с витрины, фактический возврат помощником, пять копий предмета, первая звезда, закрепление машины, доход, охрана, учебный воришка. Далее — объяснения коллекционных деталей, типов замков, районов, событий, косметики, питомца, алмазов/VIP и PvP. Платить, покупать питомца или искать второго игрока для завершения обучения не требуется.
Для первой звезды один слот добычи заменяется нужным предметом за настоящую доставку из района этого предмета. Лимит помощи — пять выпадений на профиль; повтор уроков лимит не сбрасывает и дополнительных предметов без доставки не выдаёт. Все обычные требования улучшения (5 копий и монеты) сохраняются.
Отмена/ошибка первого взлома возвращает к выбору машины. После перезахода недоставленная машина не считается сохранённой; неполученный возврат помощника можно начать заново. Прогресс хранится в tutorialV2; сохранения, инвентарь и старое владение не очищаются. У ветеранов сохраняются уже освоенные начальные действия. Кнопка ОБУЧЕНИЕ → СПРАВОЧНИК → ПОВТОРИТЬ УРОКИ запускает цепочку снова без очистки имущества; выполненная прокачка и звёзды учитываются. У новичка обычные налёты включаются после урока защиты; у старого профиля продолжают работать обычные налёты.

Установка для проверки:
1. Сохраните копию карты и свои Developer Product ID/изменённые настройки.
2. Остановите Play. Уберите прежний установочный пакет Steal60 из Workspace, если он там остался.
3. Вставьте Steal60_v55.rbxmx через Insert from File в Workspace. Запустите Play с одним установочным пакетом.
4. Проверьте черепашку и остальных питомцев; комплект героя и покупку за алмазы; обучение через кнопку слева снизу. Учебный воришка появляется на уроке 16, когда игрок рядом с салоном.
Перенос модулей установщиком выполняется при Play; изменения тестового запуска не сохраняются в Edit автоматически. Roblox Product ID в исходном пакете не создаются этим обновлением: для продажи алмазов в опубликованной игре нужны ваши настроенные Developer Product ID.

Проверки:
XML разобран повторно; все 64 скрипта скомпилированы Luau. Проверены 400 поз десяти питомцев и Sphere-меши, соединения хвостов, четыре ротора и следы-ауры; сохранение тела/размеров и возврат аватара; обработка недоступных комплектов и откат покупки; реальный код мастерской (полка/инвентарь/первая звезда); цепочка обучения, перезаход, потерянная поездка и запрет поддельных клиентских подтверждений; навигация NPC при блокировке, неудачном пути и отмене, маршрут входа/побега и безопасность учебного налёта. Это автоматические проверки исходного кода в макете API.
Roblox Studio/Engine здесь не запускался. Фактический вид в игре, доступность каталожных вещей, построение навигационной сетки в вашей карте, анимации Roblox и настоящее сохранение DataStore требуют проверки в Studio. Не заявляется проверка всех этих условий в живом движке.
</string></Properties></Item><Item class="StringValue" referent="RBX_CINEMATIC_README"><Properties><string name="Name">README_Import</string><string name="Value">Steal60 v55 — готовый файл .rbxmx, без ZIP.

