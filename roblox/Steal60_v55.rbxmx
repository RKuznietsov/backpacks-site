-- Camera-relative compass above the avatar (not a static arrow glyph).
local headGuide=Instance.new("Frame")
headGuide.Name="OverheadGarageCompass"
headGuide.AnchorPoint=Vector2.new(.5,.5)
headGuide.Size=UDim2.fromOffset(70,84)
headGuide.BackgroundTransparency=1
headGuide.Visible=false
headGuide.ZIndex=35
headGuide.Parent=gui
local compassDisc=Instance.new("Frame")
compassDisc.Name="CompassRing"
compassDisc.AnchorPoint=Vector2.new(.5,0)
compassDisc.Position=UDim2.fromScale(.5,0)
compassDisc.Size=UDim2.fromOffset(59,59)
