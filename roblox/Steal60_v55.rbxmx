        <Item class="ModuleScript" referent="RBX_STEAL60_PET_VISUAL_LIB_V41">
          <Properties>
            <string name="Name">PetVisualLibrary</string>
            <ProtectedString name="Source">-- STEAL60 v41: original stylised pet sculptures; same geometry in game and shop preview.
-- All parts are purely visual, anchored and non-colliding. No third-party assets.
local M={}
local C=Color3.fromRGB
local DARK=C(28,38,55)
local WHITE=C(247,244,229)
local BLACK=C(13,23,35)
local GOLD=C(255,208,94)
-- Ball primitives stay spherical in Roblox. Sphere meshes preserve all three design axes.
local function visualShape(p,shape)
 if shape==Enum.PartType.Ball then
  p.Shape=Enum.PartType.Block;p:SetAttribute('PetEllipsoid',true)
  local mesh=Instance.new('SpecialMesh');mesh.Name='Ellipsoid';mesh.MeshType=Enum.MeshType.Sphere
  mesh.Scale=Vector3.new(1,1,1);mesh.Parent=p
 else p.Shape=shape or Enum.PartType.Block end
end
local function make(m,name,size,pos,color,shape,mat,rotation)
 local p=Instance.new("Part")
 p.Name=name;p.Size=size;p.CFrame=CFrame.new(pos)*(rotation or CFrame.new())
 visualShape(p,shape)
 p.Color=color or WHITE;p.Material=mat or Enum.Material.SmoothPlastic
 p.TopSurface=Enum.SurfaceType.Smooth;p.BottomSurface=Enum.SurfaceType.Smooth
 p.Anchored=true;p.Massless=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false
 p.CastShadow=false;p.Parent=m
 return p
end
local function ball(m,n,x,y,z,sx,sy,sz,col,mat)
 return make(m,n,Vector3.new(sx,sy,sz),Vector3.new(x,y,z),col,Enum.PartType.Ball,mat)
end
local function plate(m,n,x,y,z,sx,sy,sz,col,ang,mat)
 return make(m,n,Vector3.new(sx,sy,sz),Vector3.new(x,y,z),col,nil,mat,ang and CFrame.Angles(0,0,ang) or nil)
end
local function eye(m,x,y,z,scale)
 scale=scale or 1
 ball(m,"Белок",x,y,z,.26*scale,.33*scale,.11,WHITE)
 ball(m,"Зрачок",x,y,z-.075,.115*scale,.20*scale,.085,BLACK)
 ball(m,"Блик",x-.039*scale,y+.074*scale,z-.124,.05,.06,.035,WHITE,Enum.Material.Neon)
end
local function gem(m,n,x,y,z,col,sz)
 ball(m,n,x,y,z,sz or .15,sz or .15,.11,col,Enum.Material.Neon)
end
local function legs(m,col,front,dist)
 for _,x in ipairs({-dist,dist}) do
  for _,z in ipairs({front,front+.8}) do
   ball(m,"Лапка",x,-.58,z,.33,.34,.36,col)
  end
 end
end
local function animal(m,id,col)
 local cream=C(245,232,207)
 local isFox=id=="pet_fox"
 local isCat=id=="pet_cat"
 local isDog=id=="pet_dog"
 -- Larger face, smaller haunches, tiny feet: toy-like silhouette.
 ball(m,"Тело",0,-.15,.34,1.15,.92,1.21,col)
 ball(m,"Голова",0,.45,-.31,1.44,1.25,1.14,col)
 ball(m,"Щечки",0,.18,-.84,.86,.47,.26,cream)
 legs(m,col,-.23,.37)
 for _,x in ipairs({-.37,.37}) do eye(m,x,.54,-.89,1.05) end
 ball(m,"Нос",0,.18,-1.0,.22,.18,.14,isCat and C(237,132,170) or BLACK)
 plate(m,"Улыбка",0,.035,-.982,.16,.06,.06,C(135,80,92))
 if isDog then
  for _,x in ipairs({-.65,.65}) do
   plate(m,"Свисающее_ухо",x,.51,-.09,.32,.87,.40,C(116,79,64),x&lt;0 and -.25 or .25)
  end
  plate(m,"Язык",0,-.16,-1.015,.18,.27,.07,C(246,114,154))
  ball(m,"Хвост",0,.05,1.09,.24,.27,.59,col)
 elseif isCat then
  for _,x in ipairs({-.49,.49}) do
   plate(m,"Кошачье_ухо",x,1.03,-.26,.34,.66,.28,col,x&lt;0 and -.32 or .32)
   plate(m,"Розовое_ухо",x,1.09,-.42,.17,.34,.06,C(254,171,212),x&lt;0 and -.26 or .26)
   for i=1,2 do
    plate(m,"Ус",x*1.6,.12+(i-1)*.13,-.94,.40,.035,.035,cream,x&lt;0 and .14 or -.14)
   end
  end
  ball(m,"Пушистый_хвост",.52,-.03,1.03,.35,.35,.95,col)
 else -- fox
  for _,x in ipairs({-.48,.48}) do
   plate(m,"Лисье_ухо",x,1.02,-.26,.37,.75,.29,col,x&lt;0 and -.28 or .28)
   plate(m,"Внутри_уха",x,1.09,-.42,.18,.35,.06,C(246,173,155),x&lt;0 and -.28 or .28)
  end
  ball(m,"Белая_грудка",0,-.28,-.19,.54,.65,.23,cream)
  ball(m,"Пушистый_хвост",.49,-.08,1.05,.54,.52,1.06,col)
  ball(m,"Кончики_хвоста",.52,-.12,1.47,.43,.42,.28,cream)
 end
 ball(m,"Ошейник",0,-.16,-.41,1.02,.12,.85,DARK)
 gem(m,"Бирка",0,-.2,-.92,GOLD,.13)
end
local function robot(m,col)
 plate(m,"Торс",0,-.20,.26,1.21,.84,.87,DARK)
 plate(m,"Корпус",0,.46,-.21,1.44,1.17,.78,col)
 plate(m,"Лицевой_дисплей",0,.49,-.655,1.17,.72,.10,BLACK)
 for _,x in ipairs({-.34,.34}) do
  plate(m,"Глаз_пиксель",x,.52,-.72,.22,.27,.06,C(114,254,221),nil,Enum.Material.Neon)
  plate(m,"Колено",x,-.67,.21,.33,.33,.42,col)
  ball(m,"Ступня",x,-.83,-.07,.4,.22,.60,DARK)
  plate(m,"Антенна",x*.9,1.22,-.19,.085,.44,.08,DARK)
  ball(m,"Сигнал",x*.9,1.46,-.19,.19,.19,.19,C(255,195,101),Enum.Material.Neon)
 end
 plate(m,"Рюкзак",0,-.08,.80,.73,.72,.36,C(54,68,83))
 gem(m,"Эмблема",0,.02,-.68,C(234,196,114),.12)
end
local function turtle(m,col)
 ball(m,"Тело",0,-.30,.14,1.30,.67,1.23,C(164,221,160))
 ball(m,"Панцирь",0,.11,.39,1.63,.91,1.42,C(46,104,95))
 ball(m,"Светлая_центральная_пластина",0,.49,.30,.83,.16,.78,col)
 for _,x in ipairs({-.53,.53}) do
  ball(m,"Боковая_пластина",x,.26,.42,.52,.13,.82,C(99,177,133))
  for _,z in ipairs({-.31,.8}) do
   ball(m,"Лапа",x*1.3,-.57,z,.43,.31,.43,col)
  end
 end
 ball(m,"Голова",0,.05,-.77,.96,.82,.91,col)
 for _,x in ipairs({-.25,.25}) do eye(m,x,.14,-1.17,.80) end
 ball(m,"Носик",0,-.08,-1.2,.17,.11,.12,C(63,113,100))
 ball(m,"Хвост",0,-.30,1.14,.25,.25,.50,col)
end
local function drone(m,col)
 -- Quad-rotor rather than a plain luminous sphere.
 plate(m,"Обшивка",0,.05,0,1.35,.47,.88,DARK)
 ball(m,"Сенсорная_голова",0,.30,-.08,.89,.72,.94,col,Enum.Material.Metal)
 ball(m,"Лицевая_оптика",0,.28,-.58,.54,.37,.18,BLACK)
 ball(m,"Линза",0,.29,-.69,.30,.25,.09,C(95,229,255),Enum.Material.Neon)
 gem(m,"Сигнальный_диод",0,.61,-.19,GOLD,.12)
 for _,x in ipairs({-1.02,1.02}) do
  for _,z in ipairs({-.43,.50}) do
   plate(m,"Луч_рамы",x*.65,.10,z*.70,.78,.13,.17,DARK,x&lt;0 and .12 or -.12)
   ball(m,"Роторный_кожух",x,.09,z,.57,.17,.57,col,Enum.Material.Metal)
   plate(m,"Лопасть",x,.20,z,.77,.035,.13,C(174,233,242))
   plate(m,"Перекрестная_лопасть",x,.21,z,.13,.035,.77,C(174,233,242))
  end
 end
end
local function star(m,col)
 ball(m,"Ядро_звезды",0,0,0,.98,.95,.57,col)
 for i=1,5 do
  local a=(i-1)*2*math.pi/5+math.pi/2
  plate(m,"Пятиконечная_звезда",math.cos(a)*.58,math.sin(a)*.58,0,.43,.89,.42,col,a-math.pi/2)
  ball(m,"Кончик_звезды",math.cos(a)*.91,math.sin(a)*.91,0,.26,.27,.33,col)
 end
 for _,x in ipairs({-.27,.27}) do eye(m,x,.11,-.36,.72) end
 plate(m,"Улыбка",0,-.20,-.44,.26,.07,.05,C(134,91,55))
 gem(m,"Звездная_искринка",.78,.78,-.13,C(255,248,183),.16)
end
local function cloud(m,col)
 for _,c in ipairs({{-0.55,.00,.1,.85},{0.06,.28,.0,1.1},{.61,.02,.04,.82},{-.01,-.31,.1,1.20}}) do
  ball(m,"Облако",c[1],c[2],c[3],c[4],c[4]*.76,.90,col)
 end
 for _,x in ipairs({-.32,.32}) do eye(m,x,.01,-.70,.72) end
 plate(m,"Сонная_улыбка",0,-.24,-.68,.27,.055,.05,C(100,142,167))
 for _,x in ipairs({-.68,.68}) do gem(m,"Румянец",x,-.18,-.51,C(247,178,200),.14) end
 gem(m,"Сияющая_звезда",0,.75,.06,GOLD,.18)
end
local function phoenix(m,col)
 ball(m,"Корпус_птицы",0,-.25,.17,.77,1.05,.78,col)
 ball(m,"Голова_птицы",0,.47,-.40,.78,.81,.76,col)
 plate(m,"Клюв",0,.22,-.85,.31,.25,.38,GOLD,-.15)
 for _,x in ipairs({-.26,.26}) do eye(m,x,.50,-.71,.67) end
 for _,x in ipairs({-1,1}) do
  for i=1,4 do
   plate(m,"Пламенное_перо_крыла",x*(.58+i*.18),.01+i*.125,.08+i*.055,.28,.92-i*.08,.20,i%2==0 and GOLD or C(255,154,90),x*-.60)
  end
  plate(m,"Лапка",x*.23,-.85,-.06,.16,.27,.20,C(100,67,63))
 end
 for i=-1,1 do
  plate(m,"Хвостовое_перо",i*.24,-.62,.72,.22,.79,.18,i==0 and GOLD or C(248,124,82),i*.30)
 end
 for i=-1,1 do plate(m,"Хохолок",i*.18,1.01,-.30,.17,.44,.21,i==0 and GOLD or C(255,153,85),i*.28) end
end
local function ufo(m,col)
 ball(m,"Тарелка",0,-.10,0,1.98,.38,1.76,C(52,77,92),Enum.Material.Metal)
 ball(m,"Кромка",0,-.09,0,2.3,.18,2.07,col,Enum.Material.Metal)
 ball(m,"Купол",0,.36,0,1.12,.81,1.03,C(151,222,233),Enum.Material.Glass)
 ball(m,"Пилот",0,.24,-.09,.55,.56,.51,C(96,203,169))
 for _,x in ipairs({-.16,.16}) do
  ball(m,"Глаза_пилота",x,.32,-.51,.11,.16,.08,BLACK)
 end
 for i=0,7 do
  local a=i*math.pi/4
  gem(m,"Навигационный_фонарь",math.cos(a)*1.02,-.10,math.sin(a)*.85,i%2==0 and GOLD or C(90,241,222),.13)
 end
 ball(m,"Энергетический_двигатель",0,-.44,0,.83,.20,.72,C(85,217,243),Enum.Material.Neon)
end
-- v43: added readable facial features, different silhouettes, and layered detailing.
-- All decorative elements are deliberately small and non-colliding, but not single-pixel effects.
local function detail(m,id,col)
 local silver=C(186,207,225)
 local navy=C(31,49,74)
 local cyan=C(102,237,247)
 local rosy=C(245,141,159)
 local orange=C(255,158,72)
 local soft=C(248,238,210)
 local function spot(name,x,y,z,sx,sy,sz,c)
  return ball(m,name,x,y,z,sx,sy,sz,c)
 end
 if id=="pet_fox" or id=="pet_cat" or id=="pet_dog" then
  -- Layered front fur, brows, little toes, collar and a named emblem.
  spot("Грудка_пух",0,-.28,-.34,.58,.69,.19,soft)
  for _,side in ipairs({-1,1}) do
   spot("Бровь",side*.37,.87,-.88,.36,.085,.11,id=="pet_dog" and navy or soft)
   spot("Пятнышко_щёки",side*.59,.11,-.93,.22,.12,.12,id=="pet_fox" and soft or rosy)
   for i=1,3 do
    spot("Пальчики_лапы",side*(.26+(i-2)*.105),-.74,-.46,.11,.10,.19,col)
   end
  end
  plate(m,"Тканевый_ремешок",0,-.19,-.45,1.18,.11,.16,navy)
  gem(m,"Блестящий_адресник",0,-.25,-.97,GOLD,.22)
  if id=="pet_fox" then
   for i=1,3 do
    ball(m,"Прядь_хвоста",.50+math.sin(i)*.10,-.05,1.01+i*.13,.34,.32,.36,i==3 and soft or col)
   end
   spot("Белый_кончик_мордочки",0,.17,-1.08,.36,.22,.17,soft)
  elseif id=="pet_cat" then
   for _,side in ipairs({-1,1}) do
    for i=1,3 do
     plate(m,"Усы_кошки",side*(.64+i*.13),.08+(i-2)*.12,-.93,.31,.026,.04,soft,side*((i-2)*.14))
    end
   end
   spot("Нагрудный_жетон",0,-.30,-.59,.26,.25,.12,GOLD)
  else
   for _,side in ipairs({-1,1}) do spot("Веснушка",side*.42,.15,-1.02,.09,.09,.05,navy) end
   plate(m,"Складка_языка",0,-.20,-1.07,.08,.18,.05,C(250,183,188))
  end
 elseif id=="pet_turtle" then
  -- Turtle has a raised scaly hexagonal-shell-like pattern and cuffed paws.
  for _,x in ipairs({-.55,0,.55}) do
   for _,z in ipairs({-.10,.43,.86}) do
    local h=math.max(0,1-math.abs(x)*.55-math.abs(z-.35)*.37)
    spot("Щиток_панциря",x,.50+h*.065,z,.37,.115,.31,(x==0 and z==.43) and GOLD or C(94,174,136))
   end
  end
  for _,side in ipairs({-1,1}) do
   spot("Щека_черепашки",side*.36,-.12,-1.12,.22,.15,.12,soft)
   for _,z in ipairs({-.28,.75}) do
    spot("Коготок",side*.75,-.73,z-.24,.18,.13,.20,soft)
   end
  end
 elseif id=="pet_bot" then
  for _,side in ipairs({-1,1}) do
   plate(m,"Плечевой_шарнир",side*.74,.15,.08,.30,.30,.50,silver)
   spot("Шестигранная_кнопка",side*.23,-.13,-.70,.14,.15,.10,GOLD)
   plate(m,"Провод_торса",side*.35,-.42,-.65,.12,.25,.13,cyan,nil,Enum.Material.Neon)
   plate(m,"Коленная_броня",side*.37,-.69,-.10,.42,.19,.20,navy)
  end
  plate(m,"Панель_реактора",0,-.20,-.70,.38,.22,.15,cyan,nil,Enum.Material.Neon)
  for i=1,4 do spot("Вентиляционная_решетка",-.32+i*.13,.16,-.72,.06,.045,.04,silver) end
 elseif id=="pet_orb" then
  -- Drone: visible rotor axles, struts, underside camera and heat vents.
  for _,x in ipairs({-1.02,1.02}) do
   for _,z in ipairs({-.43,.50}) do
    plate(m,"Шпиндель",x,.19,z,.14,.22,.14,navy)
    spot("Кожух_двигателя",x,.31,z,.23,.18,.23,silver)
    gem(m,"Огонёк_пропеллера",x,.36,z,cyan,.095)
   end
  end
  ball(m,"Нижняя_камера",0,-.33,-.30,.36,.36,.35,navy,Enum.Material.Metal)
  spot("Объектив_камеры",0,-.34,-.53,.18,.18,.10,cyan)
  for i=1,3 do plate(m,"Вентиляция",-.30+i*.16,.48,.15,.09,.045,.34,silver) end
 elseif id=="pet_phoenix" then
  -- Feathery layered wing tips and a fiery chest instead of a glowing blob.
  for _,side in ipairs({-1,1}) do
   for i=1,5 do
    plate(m,"Второй_ряд_маховых_перьев",side*(.75+i*.19),-.23+i*.10,.18,.16,.62,.09,
     i%2==0 and orange or GOLD,-side*.47,Enum.Material.SmoothPlastic)
   end
   spot("Сверкающий_глаз",side*.25,.55,-.77,.095,.13,.08,navy)
  end
  for i=1,4 do plate(m,"Искры_хвоста",(i-2.5)*.12,-.75,.94+i*.08,.13,.53,.12,
    i%2==0 and GOLD or orange,(i-2.5)*.16,Enum.Material.Neon) end
  spot("Сердце_феникса",0,-.10,-.34,.32,.37,.20,GOLD)
 elseif id=="pet_ufo" then
  for i=0,11 do
   local angle=i*math.pi/6
   local x=math.cos(angle)*.96
   local z=math.sin(angle)*.79
   spot("Световой_иллюминатор",x,-.12,z,.13,.10,.13,i%2==0 and cyan or GOLD)
  end
  plate(m,"Панель_управления_пилота",0,.31,-.63,.44,.15,.10,navy)
  for _,side in ipairs({-1,1}) do
   plate(m,"Опорная_стойка",side*.46,-.46,.20,.12,.33,.14,silver)
   spot("Опорная_пятка",side*.46,-.62,.20,.25,.10,.31,navy)
  end
 elseif id=="pet_star" then
  for i=1,5 do
   local a=(i-1)*math.pi*2/5+math.pi/2
   spot("Сверкающая_грань",math.cos(a)*.63,math.sin(a)*.63,-.28,.18,.34,.09,soft)
  end
  for _,side in ipairs({-1,1}) do spot("Румянец_звезды",side*.46,-.13,-.46,.20,.13,.07,rosy) end
  spot("Кристалл_центра",0,.02,-.39,.22,.25,.14,GOLD)
 elseif id=="pet_cloud" then
  for _,side in ipairs({-1,1}) do spot("Слой_щек",side*.55,-.14,-.63,.31,.21,.16,soft) end
  for i=1,4 do
   ball(m,"Хрустальная_капля",(i-2.5)*.36,-.57-(i%2)*.12,.13,.11,.30,.13,cyan,Enum.Material.Glass)
  end
  spot("Бантик_облачка",0,.68,-.17,.30,.19,.16,rosy)
 end
end


-- V45: readable layered detailing from all camera angles; no neon spheres as pets.
-- Detail parts are welded to the same rig and remain non-colliding.
local function detailV45(m,id,col)
 local dark=C(27,36,55)
 local pearl=C(253,245,220)
 local glint=C(122,246,238)
 local function bead(name,x,y,z,s,color)
  return ball(m,name,x,y,z,s,s,s,color or pearl)
 end
 local function strip(name,x,y,z,sx,sy,sz,color,rotation)
  return plate(m,name,x,y,z,sx,sy,sz,color,rotation)
 end
 if id=="pet_fox" or id=="pet_cat" or id=="pet_dog" then
  -- Fur volume, nose texture, eyebrows and visible articulated paws.
  for _,sgn in ipairs({-1,1}) do
   for i=1,3 do
    bead("Пушок_щеки",sgn*(.54+i*.045),.09+i*.095,-.79-i*.022,.10+i*.014,col)
   end
   strip("Упругая_лапа",sgn*.37,-.56,-.18,.31,.41,.32,C(74,67,72),sgn*.10)
   bead("Глаз_отражение",sgn*.37-.035,.69,-1.015,.06,pearl)
  end
  bead("Кнопка_носа",0,.22,-1.14,.115,id=="pet_cat" and C(248,156,183) or dark)
  for i=1,3 do
   strip("Пушистая_спинка",0,.13,1.05+(i-2)*.19,.81,.18,.22,col,(i-2)*.13)
  end
 elseif id=="pet_turtle" then
  for i=1,6 do
   local a=i*math.pi/3
   bead("Рельеф_панциря",math.cos(a)*.63,.55,math.sin(a)*.51+.38,.12,C(224,193,103))
  end
  strip("Кромка_панциря",0,.11,1.07,1.49,.16,.22,C(37,93,78))
  for _,side in ipairs({-1,1}) do
   bead("Складочка_щеки",side*.36,-.10,-1.13,.13,C(218,245,164))
  end
 elseif id=="pet_bot" then
  for _,side in ipairs({-1,1}) do
   strip("Рука_манипулятор",side*.84,.01,.06,.27,.66,.31,col,side*.21)
   bead("Шарнир_манипулятора",side*.84,-.31,.06,.18,dark)
   strip("Панель_ботинка",side*.34,-.76,-.30,.32,.08,.22,glint)
  end
  strip("Экран_сердце",0,-.10,-.72,.39,.27,.06,C(94,223,190))
 elseif id=="pet_orb" then
  for _,side in ipairs({-1,1}) do
   strip("Карбоновая_тяга",side*.59,.14,-.42,.84,.10,.13,C(115,132,151),side*.17)
   strip("Защитный_кант",side*1.02,.0,.5,.79,.10,.15,dark,side*.19)
  end
  strip("Улыбка_светодиод",0,.10,-.72,.25,.05,.07,C(111,235,243))
 elseif id=="pet_phoenix" then
  for _,side in ipairs({-1,1}) do
   for i=1,3 do
    strip("Мягкое_подперо",side*(1.12+i*.13),.17+i*.16,.08,.17,.51,.13,i==3 and pearl or C(246,166,70),side*.34)
   end
   bead("Золотая_шпора",side*.25,-.92,-.11,.09,C(251,216,89))
  end
  strip("Гребень_огня",0,1.16,-.22,.22,.53,.16,C(255,196,69),.10)
 elseif id=="pet_ufo" then
  for i=1,10 do
   local a=i*2*math.pi/10
   bead("Иллюминатор_кабины",math.cos(a)*.58,.47,math.sin(a)*.54,.085,C(173,242,231))
  end
  strip("Тяга_двигателя",0,-.55,0,.35,.24,.38,C(96,226,254))
 elseif id=="pet_cloud" then
  for i=1,5 do
   local a=i*2*math.pi/5
   bead("Мягкая_завитушка",math.cos(a)*.62,.29,math.sin(a)*.38+.05,.20,pearl)
  end
  bead("Сонная_щека",.45,-.06,-.63,.16,C(253,180,211))
 elseif id=="pet_star" then
  for i=1,5 do
   local a=i*2*math.pi/5
   bead("Хрустальный_луч",math.cos(a)*1.02,math.sin(a)*1.02,-.06,.13,pearl)
  end
  strip("Пластинка_луча",0,.10,-.55,.15,.40,.05,C(255,249,196))
 end
end

-- V47: small readable sculptural features for the 10 original companions.
-- Works identically in the shop preview and follower rig; no external assets.
local function detailV47(m,id,col)
 local pearl=C(249,238,213)
 local graphite=C(31,43,60)
 local leather=C(91,70,63)
 local ice=C(194,234,242)
 local function orb(name,x,y,z,sx,sy,sz,c,mat)
  return ball(m,name,x,y,z,sx,sy,sz,c,mat)
 end
 local function bar(name,x,y,z,sx,sy,sz,c,rot,mat)
  return plate(m,name,x,y,z,sx,sy,sz,c,rot,mat)
 end
 local function wedge(name,size,position,color,angle)
  local p=Instance.new('WedgePart')
  p.Name=name;p.Size=size;p.CFrame=CFrame.new(position)*CFrame.Angles(0,0,angle or 0)
  p.Color=color;p.Material=Enum.Material.SmoothPlastic
  p.Anchored=true;p.Massless=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false
  p.CastShadow=false;p.Parent=m
  return p
 end
 if id=='pet_fox' or id=='pet_cat' or id=='pet_dog' then
  -- Layered irises / eyelids make the eyes readable from farther away.
  for _,side in ipairs({-1,1}) do
   orb('Тёплая_радужка',side*.37,.56,-.99,.14,.20,.055,
      id=='pet_cat' and C(111,216,157) or id=='pet_fox' and C(159,114,67) or C(117,169,216))
   orb('Чёрный_зрачок',side*.37,.56,-1.030,.074,.15,.048,graphite)
   orb('Живой_блик',side*.37-.044,.65,-1.07,.047,.055,.024,C(255,255,246))
   bar('Линия_века',side*.37,.84,-.93,.31,.06,.07,
       id=='pet_dog' and leather or C(152,97,70),side*.09)
   orb('Подушечка_пальцев',side*.35,-.80,-.54,.20,.06,.14,
       id=='pet_cat' and C(243,158,187) or leather)
  end
  bar('Тканевая_пряжка',0,-.23,-1.028,.22,.21,.065,C(196,200,199),nil,Enum.Material.Metal)
  orb('Сердце_адресника',0,-.29,-1.09,.105,.12,.04,C(233,178,79),Enum.Material.Metal)
  if id=='pet_fox' then
   for _,side in ipairs({-1,1}) do
    wedge('Угловая_щёчка',Vector3.new(.26,.41,.22),Vector3.new(side*.58,.11,-.95),pearl,side*.24)
    bar('Белая_бровка',side*.33,.86,-.89,.38,.08,.11,pearl,side*.12)
   end
   for i=1,3 do
    bar('Хвостовой_ворс_'..i,.45,-.10,1.28+i*.12,.45-i*.05,.085,.19,
        i==3 and pearl or C(205,113,67),(i-2)*.16)
   end
  elseif id=='pet_cat' then
   for i=-1,1 do
    bar('Полоска_на_лбу_'..i,i*.15,.97,-.81,.075,.29,.10,C(104,90,161),i*.18)
   end
   for _,side in ipairs({-1,1}) do
    orb('Точка_усов',side*.19,.11,-1.083,.065,.055,.045,graphite)
    orb('Точка_усов',side*.29,.09,-1.09,.045,.05,.043,graphite)
    bar('Узор_на_боку',side*.49,-.17,.56,.07,.29,.38,C(104,90,161),side*.17)
   end
  else -- dog
   for _,side in ipairs({-1,1}) do
    orb('Пятнышко_уша',side*.70,.35,-.29,.22,.48,.14,C(112,79,69))
    orb('Веснушки_морды',side*.25,.11,-1.095,.07,.055,.04,leather)
    orb('Бровь_пса',side*.39,.86,-.87,.24,.08,.08,C(122,96,72))
   end
   bar('Ремешок_шлеи',0,-.15,.82,1.07,.10,.14,leather)
  end
 elseif id=='pet_turtle' then
  for _,side in ipairs({-1,1}) do
   for i=1,3 do
    orb('Краевая_чешуйка',side*(.38+i*.11),.50,.03+i*.30,.24,.09,.22,
         i==2 and C(198,208,122) or C(83,160,111))
   end
   orb('Блик_глаза_черепашки',side*.25,.23,-1.27,.065,.07,.04,C(255,255,236))
  end
  bar('Мягкая_улыбка',0,-.26,-1.20,.36,.045,.06,C(64,105,92))
  for i=1,4 do
   bar('Шов_на_панцире_'..i,(i-2.5)*.25,.56,.36,.06,.08,.63,C(55,130,98),nil,Enum.Material.Metal)
  end
 elseif id=='pet_bot' then
  for _,side in ipairs({-1,1}) do
   bar('Пластина_щёки',side*.56,.42,-.64,.17,.33,.12,C(199,216,222),nil,Enum.Material.Metal)
   orb('Щёчный_шарнир',side*.69,.43,-.57,.16,.16,.16,graphite,Enum.Material.Metal)
   bar('Резиновая_рукоять',side*.85,-.34,.05,.22,.21,.28,C(55,78,87))
