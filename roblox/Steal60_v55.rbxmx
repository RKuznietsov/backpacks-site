   bar('Веко_облачка',side*.32,.16,-.77,.26,.047,.09,C(109,146,166),side*.08)
   orb('Розовая_щёчка',side*.56,-.18,-.65,.22,.12,.065,C(252,191,203))
  end
  for i=1,3 do
   orb('Дождевая_капля',(i-2)*.38,-.74-(i%2)*.11,.20,.14,.25,.12,C(136,208,227),Enum.Material.Glass)
  end
 end
end

-- V48: extra readable silhouettes and facial/body micro-features.
-- Focus on cleaner shapes from gameplay distance, especially the fox.
local function detailV48(m,id,col)
 local ivory=C(248,240,224)
 local charcoal=C(29,35,45)
 local warm=C(221,164,108)
 local cool=C(111,153,174)
 local function orb(name,x,y,z,sx,sy,sz,c,mat)
  return ball(m,name,x,y,z,sx,sy,sz,c,mat)
 end
 local function bar(name,x,y,z,sx,sy,sz,c,rot,mat)
  return plate(m,name,x,y,z,sx,sy,sz,c,rot,mat)
 end
 if id=='pet_fox' then
  for _,side in ipairs({-1,1}) do
   bar('V48_Усик_лисы_верх_'..side,side*.47,.06,-1.08,.33,.030,.03,ivory,side*.14)
   bar('V48_Усик_лисы_низ_'..side,side*.49,-.03,-1.05,.28,.028,.03,ivory,side*.07)
   orb('V48_Пушок_уха_'..side,side*.54,1.07,-.34,.16,.30,.12,ivory)
   orb('V48_Пушок_груди_'..side,side*.21,-.02,-.76,.24,.33,.12,ivory)
  end
  for i=1,3 do
   bar('V48_Хвост_кольцо_'..i,.48,-.10,1.09+i*.19,.44-i*.05,.05,.17,i==3 and ivory or warm,(i-2)*.14)
  end
 elseif id=='pet_cat' then
  for _,side in ipairs({-1,1}) do
   bar('V48_Усик_кота_'..side,side*.44,.03,-1.09,.31,.025,.03,ivory,side*.10)
   bar('V48_Усик_кота2_'..side,side*.46,-.05,-1.05,.26,.025,.03,ivory,side*.04)
  end
  for i=1,2 do
   bar('V48_Кольцо_хвоста_'..i,.05,-.03,.97+i*.27,.22,.05,.14,C(114,98,170))
  end
 elseif id=='pet_dog' then
  for _,side in ipairs({-1,1}) do
   orb('V48_Мягкая_скула_'..side,side*.38,-.02,-.98,.16,.11,.08,warm)
   bar('V48_Усик_пса_'..side,side*.38,.02,-1.07,.18,.020,.02,ivory,side*.02)
  end
  for i=1,3 do
   orb('V48_Заклёпка_ошейника_'..i,-.18+i*.18,-.16,-1.05,.06,.06,.03,C(226,206,111),Enum.Material.Metal)
  end
 elseif id=='pet_turtle' then
  for i=1,5 do
   bar('V48_Панцирь_сегмент_'..i,(i-3)*.18,.70,.18,.05,.05,.82,C(58,120,88),nil,Enum.Material.Metal)
  end
 elseif id=='pet_bot' then
  for _,side in ipairs({-1,1}) do
   bar('V48_Кабель_'..side,side*.62,-.12,.23,.07,.28,.07,C(64,89,98),nil,Enum.Material.Metal)
  end
  orb('V48_Светодиод',0,.36,-.78,.09,.09,.03,C(145,255,235),Enum.Material.Neon)
 elseif id=='pet_orb' then
  for _,side in ipairs({-1,1}) do
   bar('V48_Балка_рамы_'..side,side*.77,.21,.02,.06,.08,1.16,cool,nil,Enum.Material.Metal)
  end
 elseif id=='pet_phoenix' then
  for _,side in ipairs({-1,1}) do
   for i=1,3 do
    bar('V48_Перо_слой_'..side..'_'..i,side*(.60+i*.20),.30+i*.13,.02,.10,.26,.12,
        i==1 and C(255,209,99) or C(255,154,74),side*.18)
   end
  end
 elseif id=='pet_ufo' then
  for i=1,6 do
   local a=i*math.pi/3
   orb('V48_Огни_кольца_'..i,math.cos(a)*.98,-.02,math.sin(a)*.82,.09,.05,.07,C(147,255,226),Enum.Material.Neon)
  end
 elseif id=='pet_star' then
  for _,side in ipairs({-1,1}) do
   bar('V48_Лучик_щека_'..side,side*.49,-.11,-.34,.16,.18,.06,C(255,227,130),side*.18)
  end
 elseif id=='pet_cloud' then
  for i=1,3 do
   orb('V48_Светлая_подушка_'..i,(i-2)*.32,.18,.32,.33,.22,.23,C(238,247,255))
  end
 end
end

-- V51 sculpted companions. Major features are modelled at gameplay scale.
-- Animation pivots move whole paws/tails/wings, including their decorations.
local function atelier(m,id,col)
 local cream=C(255,240,207)
 local ink=C(26,35,61)
 local gold=C(244,190,75)
 local mint=C(100,236,215)
 local activeGroup=nil
 local function P(name,size,cf,c,shape,mat,kind)
  local p=Instance.new(kind or 'Part');p.Name=name;p.Size=size;p.CFrame=cf;p.Color=c
  if p:IsA('Part')then visualShape(p,shape) end;p.Material=mat or Enum.Material.SmoothPlastic
  p.TopSurface=Enum.SurfaceType.Smooth;p.BottomSurface=Enum.SurfaceType.Smooth
  p.Anchored=true;p.Massless=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.CastShadow=true
  if activeGroup then p:SetAttribute('PetMotionGroup',activeGroup) end
  p.Parent=m;return p
 end
 local function O(n,x,y,z,sx,sy,sz,c,mat,rot)
  return P(n,Vector3.new(sx,sy,sz),CFrame.new(x,y,z)*(rot or CFrame.new()),c,Enum.PartType.Ball,mat)
 end
 local function B(n,x,y,z,sx,sy,sz,c,rot,mat)
  return P(n,Vector3.new(sx,sy,sz),CFrame.new(x,y,z)*(rot or CFrame.new()),c,nil,mat)
 end
 local function W(n,x,y,z,sx,sy,sz,c,rot)
  return P(n,Vector3.new(sx,sy,sz),CFrame.new(x,y,z)*(rot or CFrame.new()),c,nil,nil,'WedgePart')
 end
 local function motion(n,kind,x,y,z,side,fn)
  local p=B(n,x,y,z,.05,.05,.05,ink);p.Transparency=1
  p:SetAttribute('PetMotionPivot',true);p:SetAttribute('PetAnimationKind',kind);p:SetAttribute('PetAnimationSide',side)
  local prev=activeGroup;activeGroup=n;fn();activeGroup=prev
 end
 local function eye(x,y,z,s,iris)
  local layer=O('EyeSocket',x,y,z,.45*s,.55*s,.17*s,ink)
  layer:SetAttribute('PetBlinkOpen',true);layer:SetAttribute('PetBlinkBaseTransparency',0)
  local layer=O('IvoryEye',x,y+.018*s,z-.055*s,.36*s,.43*s,.15*s,cream)
  layer:SetAttribute('PetBlinkOpen',true);layer:SetAttribute('PetBlinkBaseTransparency',0)
  local layer=O('JewelIris',x+.022*s,y-.012*s,z-.140*s,.255*s,.34*s,.09*s,iris)
  layer:SetAttribute('PetBlinkOpen',true);layer:SetAttribute('PetBlinkBaseTransparency',0)
  local layer=O('Pupil',x+.024*s,y,z-.188*s,.15*s,.24*s,.055*s,ink)
  layer:SetAttribute('PetBlinkOpen',true);layer:SetAttribute('PetBlinkBaseTransparency',0)
  local layer=O('CatchLight',x-.050*s,y+.103*s,z-.220*s,.092*s,.106*s,.036*s,C(255,255,250),Enum.Material.Neon)
  layer:SetAttribute('PetBlinkOpen',true);layer:SetAttribute('PetBlinkBaseTransparency',0)
  local layer=O('TinyCatchLight',x+.075*s,y-.07*s,z-.217*s,.043*s,.045*s,.029*s,C(255,255,250),Enum.Material.Neon)
  layer:SetAttribute('PetBlinkOpen',true);layer:SetAttribute('PetBlinkBaseTransparency',0)
  local lid=O('ClosedEye',x,y,z-.24*s,.37*s,.055*s,.055*s,ink);lid.Transparency=1;lid:SetAttribute('PetBlinkLid',true)
 end
 local function jewel(n,x,y,z,s,c)
  O(n..'Setting',x,y,z,s*1.24,s*1.24,.13,gold,Enum.Material.Metal)
  W(n..'Upper',x,y+s*.12,z-.07,s*.68,s*.68,.15,c,CFrame.Angles(0,math.pi/2,0))
  W(n..'Lower',x,y-s*.12,z-.07,s*.68,s*.68,.15,c,CFrame.Angles(0,math.pi/2,math.pi))
  O(n..'Shine',x-s*.09,y+s*.12,z-.16,s*.12,s*.23,.025,cream)
 end
 local function paws(bodyColor,tipColor)
  for _,side in ipairs({-1,1})do for i,z in ipairs({-.30,.63})do
   local x=side*.46
   motion('Paw_'..side..'_'..i,i==1 and 'walkFront' or 'walkBack',x,-.30,z,side,function()
    O('PlushLeg',x,-.51,z,.40,.55,.42,bodyColor)
    O('RoundPaw',x,-.76,z-.10,.46,.32,.53,tipColor)
    for j=-1,1 do O('PawToe',x+j*.10,-.79,z-.33,.085,.10,.065,cream)end
   end)
  end end
 end
 if id=='pet_fox' or id=='pet_cat' or id=='pet_dog' then
  local fox=id=='pet_fox';local cat=id=='pet_cat';local dog=id=='pet_dog'
  local fur=fox and C(241,146,62)or cat and C(153,134,235)or C(209,163,102)
  local shadow=fur:Lerp(ink,.18)
  O('PearBody',0,-.15,.37,1.24,1.05,1.29,shadow)
  O('FullChest',0,-.23,-.19,.83,.84,.42,cream)
  paws(fur,fox and C(105,64,58)or cream)
  motion('HeadPose','head',0,.25,-.26,1,function()
  O('SculptedHead',0,.58,-.26,1.63,1.43,1.31,fur)
  for _,s in ipairs({-1,1})do
   O('FluffyCheek',s*.59,.22,-.71,.62,.53,.49,cream)
   W('CheekTuft',s*.76,.22,-.53,.19,.46,.49,fur,CFrame.Angles(0,0,-s*.45))
   eye(s*.37,.64,-.87,1.0,fox and C(72,182,170)or cat and C(103,230,195)or C(93,171,224))
   O('SoftBlush',s*.62,.28,-.96,.19,.105,.055,C(244,153,152))
   if not dog then
    local ear=CFrame.new(s*.56,1.28,-.16)*CFrame.Angles(0,0,-s*.18)
    for _,half in ipairs({-1,1})do
     P('PointedEar',Vector3.new(.27,.91,.33),ear*CFrame.new(half*.165,0,0)*CFrame.Angles(0,-half*math.pi/2,0),shadow,nil,nil,'WedgePart')
     P('VelvetInnerEar',Vector3.new(.05,.61,.21),ear*CFrame.new(half*.105,-.025,-.155)*CFrame.Angles(0,-half*math.pi/2,0),C(255,186,183),nil,nil,'WedgePart')
    end
   else
    O('FoldedEar',s*.76,.72,-.05,.40,1.03,.51,C(136,87,66),nil,CFrame.Angles(0,0,-s*.23))
    O('EarTip',s*.83,.29,-.13,.31,.42,.40,C(155,103,74))
   end
  end
  for i=-1,1 do
   O('ForeheadTuft',i*.17,1.20,-.45,.26,.35,.32,i==0 and cream or fur,nil,CFrame.Angles(0,0,-i*.23))
  end
  O('MuzzleLeft',-.18,.20,-.96,.43,.32,.30,cream)
  O('MuzzleRight',.18,.20,-.96,.43,.32,.30,cream)
  O('ButtonNose',0,.29,-1.135,.21,.15,.13,cat and C(236,128,161)or ink)
  for _,s in ipairs({-1,1})do O('Smile',s*.075,.105,-1.105,.17,.045,.045,C(127,74,75),nil,CFrame.Angles(0,0,s*.25))end
  if dog then O('HappyTongue',0,-.005,-1.08,.18,.22,.075,C(247,128,163))end
  end)
  O('Collar',0,-.10,-.29,1.13,.18,.85,ink)
  jewel('CompanionMedallion',0,-.18,-.78,.24,fox and mint or C(255,199,95))
  if fox then
   motion('FoxTail','tail',.18,-.13,.87,1,function()
    O('FoxTailBase',.32,-.01,1.23,.57,.62,1.15,fur,nil,CFrame.Angles(-.14,.20,0))
    O('FoxTailCurve',.53,.13,1.65,.46,.52,.76,fur,nil,CFrame.Angles(-.20,.14,0))
    O('IvoryTailTip',.59,.22,1.91,.39,.44,.47,cream,nil,CFrame.Angles(-.22,.10,0))
   end)
  elseif cat then
   motion('CrescentTail','tail',.42,-.20,.88,1,function()
    local p0=Vector3.new(.42,-.20,.88);local p1=Vector3.new(1.05,-.08,1.30)
    local p2=Vector3.new(.99,1.15,1.10);local p3=Vector3.new(.40,1.12,1.03)
    for i=0,13 do
     local t=i/13;local u=1-t
     local p=p0*u^3+p1*(3*u*u*t)+p2*(3*u*t*t)+p3*t^3
     local diameter=.34-.085*t
     O('ConnectedCatTail_'..i,p.X,p.Y,p.Z,diameter,diameter,diameter,t&gt;.76 and cream or fur)
    end
   end)
   for _,s in ipairs({-1,1})do for j=1,2 do
    B('FineWhisker',s*.66,.16-j*.085,-1.0,.39,.025,.025,cream,CFrame.Angles(0,0,s*(.11-j*.13)))
   end end
  else
   motion('HappyTail','tail',0,-.15,1,1,function()
    O('CurledTail',.22,.17,1.18,.35,.62,.59,fur,nil,CFrame.Angles(-.35,0,-.4))
    O('CreamTailTip',.35,.45,1.08,.29,.31,.37,cream)
   end)
   -- Goggles share the head pose instead of floating as the dog looks around.
   activeGroup='HeadPose'
   for _,s in ipairs({-1,1})do
    O('AviatorRim',s*.33,1.10,-.76,.47,.34,.17,gold,Enum.Material.Metal)
    O('AviatorLens',s*.33,1.10,-.86,.33,.23,.09,C(82,180,206),Enum.Material.Glass)
   end
   activeGroup=nil
  end
 elseif id=='pet_turtle' then
  local green=C(143,220,158);local light=C(245,231,166)
  O('TurtleBody',0,-.17,.20,1.51,.54,1.47,green)
  O('SoftPlastron',0,-.31,.19,1.32,.23,1.37,light)
  O('ShellBorder',0,-.015,.30,1.97,.23,1.77,C(188,238,155))
  O('LowDomedShell',0,.18,.30,1.85,.75,1.65,C(47,161,101))
  O('CentralScute',0,.522,.30,.73,.095,.73,C(91,200,114))
  for _,side in ipairs({-1,1})do
   O('ShellScute',side*.43,.423,.30,.64,.16,.83,C(67,180,105))
   for _,z in ipairs({-.13,.73})do O('ShellScute',side*.28,.443,z,.62,.15,.52,C(108,208,125))end
  end
  for _,side in ipairs({-1,1})do for i,z in ipairs({-.35,.63})do
   motion('TurtleFoot'..side..'_'..i,i==1 and 'walkFront'or'walkBack',side*.53,-.22,z,side,function()
    O('ShortTurtleLeg',side*.59,-.30,z,.51,.34,.48,green)
    O('TurtleFoot',side*.68,-.41,z-.06,.52,.25,.55,green)
    for toe=-1,1 do O('SmallTurtleClaw',side*.68+toe*.105,-.44,z-.29,.055,.055,.085,light)end
   end)
  end end
  O('TurtleNeck',0,-.04,-.48,.70,.49,.78,green)
  O('ShortTurtleTail',0,-.21,1.03,.23,.20,.36,green)
  motion('TurtleHeadPose','head',0,-.01,-.62,1,function()
   O('TurtleHead',0,.025,-.94,1.01,.81,.96,C(159,230,164))
   O('CreamLowerJaw',0,-.16,-1.17,.64,.24,.41,light)
   for _,side in ipairs({-1,1})do
    local iris=O('GentleTurtleEye',side*.265,.16,-1.344,.205,.255,.085,C(24,51,43));iris:SetAttribute('PetBlinkOpen',true)
    local glint=O('TurtleEyeGlint',side*.265-.036,.217,-1.396,.069,.08,.027,cream,Enum.Material.Neon);glint:SetAttribute('PetBlinkOpen',true)
    local lid=O('ClosedTurtleEye',side*.265,.16,-1.393,.20,.044,.029,C(53,114,68));lid.Transparency=1;lid:SetAttribute('PetBlinkLid',true)
    O('TurtleCheek',side*.36,-.04,-1.337,.16,.085,.045,C(250,168,151))
    O('TurtleNostril',side*.065,-.055,-1.419,.028,.033,.023,C(84,144,94))
   end
   O('TurtleSmile',0,-.145,-1.419,.19,.033,.029,C(55,103,65))
  end)
 elseif id=='pet_bot' then
  O('CapsuleTorso',0,-.23,.14,1.15,1.02,.90,ink)
  O('PearlChest',0,-.13,-.28,.91,.70,.28,C(173,240,221))
  O('HelmetShell',0,.63,-.14,1.56,1.30,1.15,C(163,231,222))
  O('CurvedScreen',0,.66,-.65,1.31,.86,.36,ink)
  for _,s in ipairs({-1,1})do
   O('DigitalEye',s*.30,.70,-.839,.24,.31,.07,mint,Enum.Material.Neon)
   O('RobotCheek',s*.46,.43,-.80,.14,.07,.035,C(255,173,167))
   O('Headphone',s*.77,.63,-.10,.23,.53,.55,cream)
   motion('RobotFoot'..s,'walkFront',s*.36,-.48,.08,s,function()
    O('RoundBoot',s*.36,-.78,-.08,.47,.36,.68,cream)
    B('BootInlay',s*.36,-.78,-.42,.27,.10,.06,gold)
   end)
   O('Shoulder',s*.67,-.07,.08,.31,.36,.35,cream)
   B('Antenna',s*.39,1.32,-.10,.06,.39,.06,gold)
   O('AntennaSignal',s*.39,1.53,-.10,.17,.17,.17,mint,Enum.Material.Neon)
  end
  O('ScreenSmile',0,.47,-.83,.25,.05,.04,cream)
  jewel('HeartBattery',0,-.11,-.46,.22,gold)
 elseif id=='pet_phoenix' then
  local amber=C(255,158,63)
  O('BirdBody',0,-.22,.18,.89,1.05,.88,amber)
  O('IvoryBreast',0,-.17,-.22,.65,.83,.26,cream)
  O('BirdHead',0,.61,-.34,1.04,1.04,.98,amber)
  for _,s in ipairs({-1,1})do eye(s*.25,.65,-.76,.68,C(81,187,170))end
  W('GoldenBeak',0,.35,-.88,.24,.23,.35,gold,CFrame.Angles(0,math.pi/2,0))
  for i=-1,1 do O('CrestPlume',i*.18,1.18,-.25,.19,.52,.27,i==0 and cream or gold,nil,CFrame.Angles(0,0,-i*.27))end
  for _,s in ipairs({-1,1})do
   motion('FeatherWing'..s,'wing',s*.36,.02,.22,s,function()
    for i=0,6 do
     O('SculptedFlightFeather',s*(.55+i*.18),.16-i*.075,.21+i*.06,.27,.78-i*.055,.18,i%2==0 and cream or C(255,204,102),nil,CFrame.Angles(0,0,-s*(.42+i*.13)))
    end
    for i=0,3 do O('WingCoverlet',s*(.55+i*.16),.26-i*.07,.08,.30,.43,.19,amber,nil,CFrame.Angles(0,0,-s*.55))end
   end)
   O('BirdFoot',s*.22,-.83,-.04,.20,.22,.38,gold)
  end
  motion('PhoenixTail','tail',0,-.39,.50,1,function()
   for i=-1,1 do O('LongTailFeather',i*.24,-.49,1.03,.27,.20,1.08,i==0 and cream or gold,nil,CFrame.Angles(-.12,i*.18,0))end
  end)
 elseif id=='pet_star' then
  O('StarCore',0,0,0,1.08,1.02,.61,C(255,210,94))
  for i=0,4 do local a=i*math.pi*2/5
   O('RoundedRay',math.sin(a)*.60,math.cos(a)*.60,0,.39,.95,.42,C(255,211,99),nil,CFrame.Angles(0,0,-a))
   O('RayFacet',math.sin(a)*.76,math.cos(a)*.76,-.15,.16,.35,.10,cream,nil,CFrame.Angles(0,0,-a))
  end
  for _,s in ipairs({-1,1})do eye(s*.25,.10,-.31,.63,C(188,121,65));O('StarBlush',s*.41,-.17,-.32,.13,.08,.06,C(255,155,150))end
  O('StarSmile',0,-.22,-.41,.23,.05,.04,ink)
  jewel('StarCrown',0,.72,-.30,.16,mint)
 elseif id=='pet_cloud' then
  for _,v in ipairs({{-.55,.02,.05,.92},{0,.28,.08,1.14},{.59,.02,.05,.91},{0,-.25,.06,1.20}})do O('CloudPuff',v[1],v[2],v[3],v[4],v[4]*.75,.98,C(225,244,255))end
  for _,s in ipairs({-1,1})do eye(s*.31,.03,-.49,.69,C(142,174,219));O('CloudBlush',s*.55,-.19,-.48,.19,.10,.07,C(255,173,193))end
  O('CloudSmile',0,-.24,-.56,.23,.05,.035,ink)
  local rainbow={C(255,165,186),C(255,219,132),C(139,224,197),C(158,190,244)}
  for layer,c in ipairs(rainbow)do
   for i=0,11 do local a=i*math.pi/11
    local rad=.78+layer*.10
    O('RainbowPearl',math.cos(a)*rad,.20+math.sin(a)*rad,.38,.17,.17,.18,c)
   end
  end
  for _,s in ipairs({-1,1})do O('CloudRainDrop',s*.44,-.73,.02,.17,.31,.18,C(151,218,249),Enum.Material.Glass)end
 elseif id=='pet_orb' or id=='pet_ufo' then
  local ufo=id=='pet_ufo'
  if ufo then
   O('SaucerLower',0,-.10,.05,2.16,.46,1.92,ink,Enum.Material.Metal)
   O('PearlSaucer',0,.05,.05,2.21,.29,1.96,C(164,235,216),Enum.Material.Metal)
   O('AlienBody',0,.28,.02,.58,.65,.48,C(99,208,166))
   O('AlienHead',0,.65,-.06,.69,.67,.60,C(119,235,185))
   for _,s in ipairs({-1,1})do eye(s*.17,.68,-.36,.48,C(110,165,212))end
   local glass=O('ClearCockpit',0,.56,.02,1.19,1.08,1.10,C(175,225,244),Enum.Material.Glass);glass.Transparency=.53
   for i=0,11 do local a=i*math.pi/6
    O('NavigationPearl',math.cos(a)*1.01,.06,.05+math.sin(a)*.89,.12,.12,.12,i%2==0 and gold or mint,Enum.Material.Neon)
   end
   O('TractorCore',0,-.40,.05,.68,.18,.61,mint,Enum.Material.Neon)
  else
   O('AeroBody',0,.03,.03,1.22,.57,1.09,C(78,106,143),Enum.Material.Metal)
   O('PearlDome',0,.23,-.04,1.02,.67,.94,C(179,236,244))
   O('CameraScreen',0,.22,-.49,.78,.47,.27,ink)
   for _,s in ipairs({-1,1})do eye(s*.20,.25,-.60,.50,C(85,209,213))end
   for _,s in ipairs({-1,1})do for _,z in ipairs({-.48,.52})do
    local x=s*.95
    B('RotorArm',s*.65,.04,z*.7,.86,.10,.14,gold,CFrame.Angles(0,-s*z*.2,0),Enum.Material.Metal)
    for i=0,11 do local a=i*math.pi/6
     O('DuctGuard',x+math.cos(a)*.39,.08,z+math.sin(a)*.39,.18,.12,.18,C(148,227,234),Enum.Material.Metal)
    end
    motion('Rotor'..s..'_'..z,'rotor',x,.13,z,s*(z&lt;0 and -1 or 1),function()
     B('Propeller',x,.15,z,.70,.035,.11,ink)
     B('PropellerCross',x,.15,z,.11,.035,.70,ink)
     O('RotorHub',x,.19,z,.14,.12,.14,gold,Enum.Material.Metal)
     for _,tip in ipairs({-1,1})do B('MovingRotorTip',x+tip*.30,.177,z,.13,.025,.12,mint)end
    end)
   end end
  end
 end
end

function M.create(def)
 local model=Instance.new("Model")
 model.Name="Питомец · "..tostring(def.name or def.id)
 local base=make(model,"Root",Vector3.new(.1,.1,.1),Vector3.new(),DARK)
 base.Transparency=1
 model.PrimaryPart=base
 local col=def.color or C(117,210,203)
 local id=def.id
 atelier(model,id,col)
 -- Purely visual, anchored parts. The client computes every pose; no physics joints.
 local minY=math.huge;local count=0;local groups=0
 for _,p in ipairs(model:GetDescendants())do
  if p:IsA("BasePart")then
   p.Anchored=true;p.Massless=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false
   if p~=base then
    p:SetAttribute("PetBindCFrame",base.CFrame:ToObjectSpace(p.CFrame))
    p:SetAttribute("PetBaseTransparency",p.Transparency)
    count+=1
    if p:GetAttribute("PetMotionPivot")then groups+=1 end
   end
   if p.Transparency&lt;1 then
    for _,sx in ipairs({-1,1})do for _,sy in ipairs({-1,1})do for _,sz in ipairs({-1,1})do
     minY=math.min(minY,(p.CFrame*Vector3.new(sx*p.Size.X/2,sy*p.Size.Y/2,sz*p.Size.Z/2)).Y)
    end end end
   end
  end
 end
 model:SetAttribute("PetGroundOffset",minY&lt;math.huge and -minY or .89)
 model:SetAttribute("PetVisualSchema",55)
 model:SetAttribute("PetKinematicPartCount",count)
 model:SetAttribute("PetAnimationGroupCount",groups)
 base.Anchored=true

 return model
end
return M
</ProtectedString>
