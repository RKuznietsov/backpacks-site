corner(compassDisc,40);stroke(compassDisc,C(100,241,179))
local guideArrow=text(compassDisc,UDim2.fromScale(1,1),UDim2.new(),"▲",C(120,255,181),Enum.Font.GothamBlack)
guideArrow.Name="DirectionNeedle"
guideArrow.TextSize=42
guideArrow.TextXAlignment=Enum.TextXAlignment.Center
guideArrow.TextYAlignment=Enum.TextYAlignment.Center
guideArrow.ZIndex=36
local guideText=text(headGuide,UDim2.fromOffset(110,19),UDim2.new(.5,-55,0,62),"ГАРАЖ",C(218,255,237),Enum.Font.GothamBold)
guideText.TextSize=11
guideText.TextXAlignment=Enum.TextXAlignment.Center
guideText.ZIndex=36
local garageTarget=nil
local garageDistance=0
local displayedNeedle=0
RunService.RenderStepped:Connect(function(dt)
    local character=player.Character
    local head=character and (character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart"))
    local camera=workspace.CurrentCamera
    if not garageTarget or not head or not camera or menuOpen() then
        headGuide.Visible=false
        return
    end
    local screenPos,visible=camera:WorldToViewportPoint(head.Position+Vector3.new(0,4.5,0))
    if not visible or screenPos.Z&lt;=0 then
        headGuide.Visible=false
        return
    end
    local toward=Vector3.new(garageTarget.X-head.Position.X,0,garageTarget.Z-head.Position.Z)
    local forward=Vector3.new(camera.CFrame.LookVector.X,0,camera.CFrame.LookVector.Z)
    local right=Vector3.new(camera.CFrame.RightVector.X,0,camera.CFrame.RightVector.Z)
    if toward.Magnitude&lt;.05 or forward.Magnitude&lt;.05 or right.Magnitude&lt;.05 then
        headGuide.Visible=false
        return
    end
    local angle=math.deg(math.atan2(right.Unit:Dot(toward.Unit),forward.Unit:Dot(toward.Unit)))
    local diff=(angle-displayedNeedle+180)%360-180
    displayedNeedle=(displayedNeedle+diff*math.min(1,dt*12))%360
    guideArrow.Rotation=displayedNeedle
    guideText.Text=("ГАРАЖ · %d ст."):format(math.floor(garageDistance))
    headGuide.Position=UDim2.fromOffset(screenPos.X,screenPos.Y)
    headGuide.Visible=true
end)
local speed=Instance.new("Frame");speed.Name="SpeedWidget"
speed.AnchorPoint=Vector2.new(1,1);speed.Position=UDim2.new(1,-18,1,-20)
speed.Size=UDim2.fromOffset(194,108);speed.BackgroundColor3=C(13,23,34)
speed.BackgroundTransparency=.04;speed.BorderSizePixel=0;speed.Parent=gui
corner(speed,14);stroke(speed,C(95,212,226));speed.Visible=false
local spN=text(speed,UDim2.fromOffset(150,55),UDim2.fromOffset(14,17),"000",C(245,245,248),Enum.Font.GothamBlack)
spN.TextSize=42
local spLabel=text(speed,UDim2.fromOffset(100,20),UDim2.fromOffset(107,67),"STUDS/S",C(106,217,238),Enum.Font.GothamBold)
spLabel.TextSize=11
local spCaption=text(speed,UDim2.fromOffset(120,17),UDim2.fromOffset(16,84),"DRIVE MODE",C(142,156,173),Enum.Font.GothamMedium)
spCaption.TextSize=11
local last=0
RunService.Heartbeat:Connect(function(dt)
 last+=dt;if last&lt;.18 then return end;last=0
 if menuOpen() then
  mission.Visible=false
  speed.Visible=false
  compass.Visible=false
  beacon.Enabled=false
  garageTarget=nil
  return
 end
 mission.Visible=true
 local char=player.Character
 local root=char and char:FindFirstChild("HumanoidRootPart")
 if not root then speed.Visible=false compass.Visible=false beacon.Enabled=false garageTarget=nil return end
 local district=Layout.indexAt(root.Position.X)
 district=math.clamp(district,0,#Districts)
 local current=district==0 and "ЗОНА САЛОНОВ" or string.upper(Districts[district].name)
 name.Text=current
 local accent=palette[math.max(1,district)]
 eyebrow.TextColor3=accent
 fill.BackgroundColor3=accent
 local hackStat=(player:FindFirstChild("leaderstats") and player.leaderstats:FindFirstChild("Взлом"))
 local hackLevel=hackStat and hackStat.Value or 1
 local xpNow=player:GetAttribute("HeistXP") or 0
 local xpNeed=math.max(1, player:GetAttribute("HeistXPNeed") or 12)
 objective.Text=("Взлом %d  ·  XP %d/%d"):format(hackLevel, xpNow, xpNeed)
 fill.Size=UDim2.new(math.clamp(xpNow/xpNeed,0,1),0,1,0)
 local carrying=player:GetAttribute("HeistCarrying") == true
 compass.Visible=false -- overhead compass is the sole navigation indicator
 garageTarget=nil
 if carrying then
  local dx=player:GetAttribute("DeliveryX")
  local dz=player:GetAttribute("DeliveryZ")
  if dx and dz then
   beacon.Enabled=true
   marker.Position=Vector3.new(dx,3,dz)
   local from=Vector2.new(root.Position.X,root.Position.Z)
   local to=Vector2.new(dx,dz)-from
   local distance=to.Magnitude
   local hum=char:FindFirstChildOfClass("Humanoid")
   local seat=hum and hum.SeatPart
   local car=seat and seat:IsA("VehicleSeat") and seat:FindFirstAncestorOfClass("Model")
   local body=car and (car:FindFirstChild("Body",true) or car.PrimaryPart)
   local fwd=body and body.CFrame.RightVector or root.CFrame.LookVector
   local direction=Vector2.new(fwd.X,fwd.Z)
   local glyph="↑"
   if direction.Magnitude&gt;.05 and distance&gt;4 then
    local dp=direction.Unit:Dot(to.Unit)
    local cross=direction.X*to.Y-direction.Y*to.X
    if dp&lt;-.48 then glyph="↓" elseif cross&gt;.22 then glyph="←" elseif cross&lt;-.22 then glyph="→" end
   end
   arrow.Text=glyph
   cLabel.Text=("ТВОЙ САЛОН №%s\n%d студов до парковки"):format(tostring(player:GetAttribute("DeliveryPlot") or "?"),math.floor(distance))
   garageTarget=Vector3.new(dx,root.Position.Y,dz)
   garageDistance=distance
   if distance &lt; 36 then
    detailInfo.Text="Зелёная парковка твоего салона — остановись здесь"
   else
    detailInfo.Text=("Доставка в салон №%s · %d студов до парковки"):format(tostring(player:GetAttribute("DeliveryPlot") or "?"),math.floor(distance))
   end
  else
   beacon.Enabled=false
   detailInfo.Text="Вези машину к своему гаражу"
  end
 elseif district==0 then
  beacon.Enabled=false
  detailInfo.Text="Зона выбора цели и подготовки к угону"
 else
  beacon.Enabled=false
  local minLevel, maxLevel = HackRequirements.range(district)
  detailInfo.Text=("Район %d / 5 · нужен взлом %d–%d · выше шанс более редких машин"):format(district, minLevel, maxLevel)
 end
 local hum=char:FindFirstChildOfClass("Humanoid")
 local seat=hum and hum.SeatPart
 local car=seat and seat:IsA("VehicleSeat") and seat:FindFirstAncestorOfClass("Model")
 local driving=car and car:GetAttribute("Drivable")
 speed.Visible=driving and true or false
 if driving then
  local p=car.PrimaryPart or car:FindFirstChildWhichIsA("BasePart",true)
  local velocity=tonumber(car:GetAttribute("ArcadeSpeed")) or (p and p.AssemblyLinearVelocity.Magnitude or root.AssemblyLinearVelocity.Magnitude)
  spN.Text=string.format("%03d",math.floor(math.clamp(velocity,0,999)))
 end
end)
</ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX_GAMEPLAY_V2_HeistHUD"><Properties><string name="Name">HeistHUD</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- STEAL60 GAMEPLAY EDITION / player HUD. DISPLAY ONLY, no client rewards.
local Players = game:GetService("Players")
local player = Players.LocalPlayer
local gui = script.Parent
local C = Color3.fromRGB
local function text(parent, name, size, pos, font, pt, color, value)
    local t = Instance.new("TextLabel")
    t.Name = name
    t.Size = size
    t.Position = pos
    t.BackgroundTransparency = 1
    t.Font = font
    t.TextSize = pt
    t.TextColor3 = color
    t.TextXAlignment = Enum.TextXAlignment.Left
    t.Text = value
    t.Parent = parent
    return t
end
local function rounded(obj, radius)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, radius)
    corner.Parent = obj
end
local panel = Instance.new("Frame")
panel.Name = "HeistProgress"
panel.Position = UDim2.new(0, 12, 0, 13)
panel.Size = UDim2.fromOffset(282, 192)
panel.BorderSizePixel = 0
panel.BackgroundColor3 = C(14, 23, 35)
panel.BackgroundTransparency = .07
panel.Parent = gui
-- Read-only details stay off-screen until player chooses "ДЕТАЛИ".
local function updateVisibility()
    panel.Visible=player:GetAttribute("Steal60DetailsOpen")==true and player:GetAttribute("Steal60MenuOpen")~=true
end
player:GetAttributeChangedSignal("Steal60DetailsOpen"):Connect(updateVisibility)
player:GetAttributeChangedSignal("Steal60MenuOpen"):Connect(updateVisibility)
updateVisibility()
rounded(panel, 13)
local outline = Instance.new("UIStroke")
outline.Color = C(86, 190, 194)
outline.Transparency = .50
outline.Thickness = 1
outline.Parent = panel
text(panel, "Title", UDim2.new(1,-20,0,22), UDim2.fromOffset(13,8), Enum.Font.GothamBlack, 14, C(122,224,219), "ОПЕРАЦИЯ / 60 SEC")
local header = text(panel, "Streak", UDim2.new(1,-20,0,20), UDim2.fromOffset(13,30), Enum.Font.GothamBold, 13, C(244,240,224), "Серия: 0 · Следующая цель")
local xp = text(panel, "XP", UDim2.new(1,-20,0,19), UDim2.fromOffset(13,54), Enum.Font.GothamMedium, 12, C(192,202,217), "Взлом · XP 0/12")
local base = Instance.new("Frame")
base.Name="XPTrack";base.Position=UDim2.fromOffset(14,77)
base.Size=UDim2.new(1,-28,0,5);base.BorderSizePixel=0
base.BackgroundColor3=C(49,62,76);base.Parent=panel;rounded(base,3)
local fill = Instance.new("Frame")
fill.Name="XPFill";fill.Size=UDim2.fromScale(0,1)
fill.BackgroundColor3=C(99,218,162);fill.BorderSizePixel=0;fill.Parent=base;rounded(fill,3)
text(panel, "QuestHeading", UDim2.new(1,-20,0,18), UDim2.fromOffset(13,87), Enum.Font.GothamBold, 11, C(116,188,205), "ЕЖЕДНЕВНЫЕ КОНТРАКТЫ")
local questLabels = {}
for i=1,3 do
    local label=text(panel, "Daily"..i, UDim2.new(1,-25,0,17), UDim2.fromOffset(14,105+(i-1)*18), Enum.Font.GothamMedium, 12, C(204,213,223), "—")
    questLabels[i]=label
end
local status=text(panel, "Status", UDim2.new(1,-25,0,20), UDim2.fromOffset(14,166), Enum.Font.GothamBold, 11, C(244,192,110), "Доставка: без жёсткого таймера")
local names={
    {key="completed",title="Доставки",goal=3},
    {key="precise",title="Точный взлом",goal=2},
    {key="rare",title="Редкая машина",goal=1},
}
local function update()
    if not player:GetAttribute("DataLoaded") then
        header.Text="Загрузка прогресса..."
        return
    end
    local streak=player:GetAttribute("HeistStreak") or 0
    local level=(player:FindFirstChild("leaderstats") and player.leaderstats:FindFirstChild("Взлом"))
    local lv=level and level.Value or 1
    header.Text=("СЕРИЯ x%d  ·  ВЗЛОМ %d"):format(streak,lv)
    local cur=player:GetAttribute("HeistXP") or 0
    local needed=math.max(1,player:GetAttribute("HeistXPNeed") or 12)
    xp.Text=("ПРОГРЕСС НАВЫКА   %d / %d XP"):format(cur,needed)
    fill.Size=UDim2.new(math.clamp(cur/needed,0,1),0,1,0)
    for i,m in ipairs(names) do
        local value=player:GetAttribute("HeistQuest_"..m.key) or 0
        local claimed=player:GetAttribute("HeistQuestClaimed_"..m.key) == true
        local label=questLabels[i]
        label.Text=(claimed and "✓  " or "•  ")..m.title..("   %d/%d"):format(value,m.goal)
        label.TextColor3=claimed and C(108,233,160) or C(211,218,230)
    end
    if player:GetAttribute("HeistCarrying") then
        status.Text="ЦЕЛЬ: ЗЕЛЁНАЯ ПАРКОВКА ТВОЕГО САЛОНА"
        status.TextColor3=C(255,209,115)
    elseif player:GetAttribute("HelperUnlocked") ~= true then
        status.Text="ПЕРВЫЙ УГОН: БЕГИ ПЕШКОМ К МАШИНЕ"
        status.TextColor3=C(255,208,115)
    else
        local grade=player:GetAttribute("HeistLastGrade")
        if grade then
            status.Text=("ПОСЛЕДНИЙ ЗАЕЗД: %s · НОВАЯ ЦЕЛЬ"):format(grade)
        else
            status.Text="НАЙДИ МАШИНУ И ПРОЙДИ ВЗЛОМ"
        end
        status.TextColor3=C(125,222,199)
    end
end
-- Poll cheap attributes, no remotes or per-frame UI allocations.
task.spawn(function()
    while panel.Parent do
        update()
        task.wait(.35)
    end
end)
