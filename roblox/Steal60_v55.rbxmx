          <Properties>
            <string name="Name">CollisionService</string>
            <ProtectedString name="Source">-- ModuleScript: ServerScriptService/Services/CollisionService
-- Отключает столкновения игроков, ботов и машин между собой.
local PhysicsService = game:GetService("PhysicsService")
local Players = game:GetService("Players")

local Settings = require(game.ReplicatedStorage.Shared.Config.Settings)
local GROUPS = Settings.CollisionGroups

local CollisionService = {}

local function ensureGroup(name)
	local ok = pcall(function()
		PhysicsService:RegisterCollisionGroup(name)
	end)
	-- ok == false означает, что группа уже существует — это нормально
	return ok
end

-- Назначить группу всем BasePart внутри модели (и следить за новыми частями)
function CollisionService.apply(model, groupName)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CollisionGroup = groupName
		end
	end
	model.DescendantAdded:Connect(function(d)
		if d:IsA("BasePart") then
			d.CollisionGroup = groupName
		end
	end)
end

function CollisionService.applyPlayer(model)
	CollisionService.apply(model, GROUPS.Players)
end

function CollisionService.applyVehicle(model)
	CollisionService.apply(model, GROUPS.Vehicles)
end

function CollisionService.init()
	ensureGroup(GROUPS.Players)
	ensureGroup(GROUPS.Vehicles)
    ensureGroup(GROUPS.Decor)
    -- Pedestrians can walk on sidewalks and enter buildings, but vehicles only
    -- collide with the flat road/ground. Raised decorative edges cannot act as ramps.
    PhysicsService:CollisionGroupSetCollidable(GROUPS.Vehicles, GROUPS.Decor, false)

	-- Никто из своих групп не сталкивается ни с кем из игровых
	PhysicsService:CollisionGroupSetCollidable(GROUPS.Players, GROUPS.Players, false)
	PhysicsService:CollisionGroupSetCollidable(GROUPS.Vehicles, GROUPS.Vehicles, false)
	PhysicsService:CollisionGroupSetCollidable(GROUPS.Players, GROUPS.Vehicles, false)

	local function onPlayer(player)
		player.CharacterAdded:Connect(function(character)
			CollisionService.applyPlayer(character)
		end)
		if player.Character then
			CollisionService.applyPlayer(player.Character)
		end
	end

	Players.PlayerAdded:Connect(onPlayer)
	for _, p in ipairs(Players:GetPlayers()) do
		onPlayer(p)
	end
end

return CollisionService
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX12">
          <Properties>
            <string name="Name">DataService</string>
            <ProtectedString name="Source">-- ModuleScript: ServerScriptService/Services/DataService
-- Загрузка/сохранение данных игрока, сессионный замок, автосохранение.
--
-- Использование:
--   local profile = DataService.get(player)        -- таблица данных или nil
--   DataService.onLoaded(player, function(data) ... end)
--   DataService.addMoney(player, 100)

local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")

local Settings = require(game.ReplicatedStorage.Shared.Config.Settings)

local STORE_NAME = "Steal60_PlayerData_v1"
local SESSION_TIMEOUT = 120 -- сек: замок старше этого считается мёртвым
local MAX_RETRIES = 5

local store = DataStoreService:GetDataStore(STORE_NAME)

local DataService = {}

local profiles = {}      -- [player] = data
local waiting = {}       -- [player] = { callback, ... } ожидающие загрузки данных
local leaving = {}       -- [player] = true, пока идёт сохранение при выходе
local noSave = {}        -- [player] = true, если профиль временный (не сохранять)
local writeBusy = {} -- сериализация UpdateAsync в рамках сервера

local SEASON_EPOCH = 1793318400 -- UTC: 2026-10-30 00:00:00
local SEASON_SECONDS = 30*24*60*60
local moneyEarnedHandlers = {}
local function currentSeason()
    return math.max(0, math.floor((os.time()-SEASON_EPOCH)/SEASON_SECONDS))
end
local function reconcileSeason(data)
    local idx=currentSeason()
    if data.seasonIndex ~= idx then
        data.seasonIndex=idx
        data.seasonEarnings=0
    end
    return idx
end

function DataService.currentSeason()
    return currentSeason(), SEASON_EPOCH+currentSeason()*SEASON_SECONDS,
        SEASON_EPOCH+(currentSeason()+1)*SEASON_SECONDS
end

function DataService.onMoneyEarned(handler)
    table.insert(moneyEarnedHandlers,handler)
end

function DataService.getSeasonScore(player)
    local data=profiles[player]
    if not data then return nil end
    return reconcileSeason(data), math.max(0, math.floor(tonumber(data.seasonEarnings) or 0))
end

-- DEVELOPER / TEST ACCOUNT ONLY. Premium gems cannot be farmed by gameplay.
-- Change ENABLE_ONE_TIME_TEST_GRANT to false before public release.
-- The whitelist is server-side; other players have no free-gem path.
local ENABLE_ONE_TIME_TEST_GRANT = true
local TEST_ACCOUNT_USERNAME = "HarDvRaiN" -- Roblox username shown in earlier Studio Output
local TEST_GRANT_AMOUNT = 1000000
local TEST_GRANT_FLAG = "testGrant_1m_v24_20261030"

local DEFAULT_DATA = {
	version = 3,

	hackLevel = 1,
    hackXP = 0, -- XP for progression, persists between sessions
    dailyHeists = {}, -- UTC daily contracts and claimed rewards
    roadContract = {}, -- server-only special orders, saved between sessions
    money = 0, -- ordinary dollars: earned by gameplay and stored in till
    diamonds = 0, -- Premium-only currency: exclusively server-verified Robux Developer Product receipts.
    vipUntil = 0, -- absolute Unix seconds; time-limited VIP bought via diamonds. Never reset on logout.
    seasonEarnings = 0, -- earned via DataService.addMoney during current 30-day season
    seasonIndex = -1, -- old profiles begin the new season at zero
    botUnlocked = false, -- obtained after first successful delivery
    tutorialStage = 0, -- compatibility view; tutorialV2 contains ordered persistent lessons
    tutorialV2 = {},

    -- SALON PVP: persistent across sessions, never contains stolen player cars.
    theftCount = 0,      -- number of successful player-versus-player salon robberies
    theftLevel = 1,      -- auto-upgrades each 10 successful robberies, max 10
    theftNextAt = 0,    -- Unix timestamp of personal 5-minute cooldown
    theftParts = {},    -- existing accessory star/duplicate data
    accessoryOrder = {}, -- saved display order, optional; old data gets default order
    lootCopies = {}, -- counts by passive loot item, earned on each drop
    lootRanks = {}, -- passive item stars; 5 copies + coins per star
    coinUpgrades = {}, -- normal progression available without Robux
    cosmeticsOwned = {}, -- persistent, validated purchases for diamonds
    cosmeticsEquipped = {}, -- persistent category -&gt; cosmetic ID
    carCosmetics = {}, -- v42: carId -&gt; {paint,skin}; ownership stays account-wide
    heroSkinBonusLevel = 0, -- 0..10%, applies to ANY equipped hero skin
    petBonusLevel = 0, -- 0..50%, retained when switching pet appearance
    petUnlocked = false, -- one pet license; all appearances free once unlocked
    lastHeistZone = 1, -- last delivered car zone for salon-raid accessory reward
    v33Migrated = false, -- apply shelf inventory migration exactly once
    v36Migrated = false, -- shelf positions and storage migration, only once
    shelfStorage = {}, -- actual passive items in storage, separate from copies for ★
    v36Migrated = false, -- shelf positions and storage migration, only once
    shelfStorage = {}, -- actual passive items in storage, separate from copies for ★


	-- Улучшения (уровни прокачки; влияние считается в отдельных модулях)
	upgrades = {
		speed = 0,
		income = 0,
		botSpeed = 0,
		security = 0,
		shelves = 0,
	},

	-- Каталог украденных машин (постоянная коллекция):
	-- catalog[carId] = { count = 3, stars = 0, bestRarity = "rare", variants = { gold = true } }
	catalog = {},

	-- Витрина: последние угнанные и закреплённые вручную
	showcase = {
		recent = {}, -- массив carId, новые в начале
		pinned = {}, -- массив carId
	},

	-- Предметы на полках салона: { { id = "radio_fm", rarity = "rare" }, ... }
	shelf = {},
	shelfCapacity = 12,

	-- Касса: накопленные, но не снятые деньги
	till = 0,
	lastSeen = 0, -- os.time() последнего сохранения, для оффлайн-дохода

	penaltyUntil = 0, -- os.time() до которого заблокирован взлом
	processedReceipts = {}, -- [tostring(PurchaseId)] = true
	masterKeyTokens = 0,
	boostUntil = 0,
}

local function deepCopy(t)
	local c = {}
	for k, v in pairs(t) do
		c[k] = type(v) == "table" and deepCopy(v) or v
	end
	return c
end

-- Добавляет в data недостающие поля из DEFAULT_DATA (для миграции старых сохранений)
local function reconcile(data, default)
	for k, v in pairs(default) do
		if data[k] == nil then
			data[k] = type(v) == "table" and deepCopy(v) or v
		elseif type(v) == "table" and type(data[k]) == "table" and next(v) ~= nil then
			-- вложенные таблицы-словари с фиксированными ключами
			if k == "upgrades" or k == "showcase" then
				reconcile(data[k], v)
			end
		end
	end
end

local function retry(fn)
	local lastErr
	for i = 1, MAX_RETRIES do
		local ok, result = pcall(fn)
		if ok then
			return true, result
		end
		lastErr = result
		warn(("[DataService] попытка %d/%d не удалась: %s"):format(i, MAX_RETRIES, tostring(result)))
		task.wait(2 ^ (i - 1) * 0.5)
	end
	return false, lastErr
end

local function keyFor(player)
	return "Player_" .. player.UserId
end

-- Загрузка с захватом замка. Возвращает data или nil.
local function load(player)
	local key = keyFor(player)
	local claimed
	print("[DataService] Загружаю данные " .. player.Name)

	local ok, err = retry(function()
		return store:UpdateAsync(key, function(old)
			old = old or { data = nil, lock = nil }
			local now = os.time()
			local lock = old.lock
			if lock and lock.jobId ~= game.JobId and now - lock.time &lt; SESSION_TIMEOUT then
				claimed = nil -- занято другим сервером
				return nil    -- отмена записи
			end
			old.lock = { jobId = game.JobId, time = now }
			claimed = old.data or {}
			return old
		end)
	end)

	if not ok then
		warn("[DataService] не удалось загрузить данные " .. player.Name .. ": " .. tostring(err))
		return nil
	end
	if claimed == nil then
		warn("[DataService] данные игрока " .. player.Name .. " заняты другой сессией")
	else
		print("[DataService] Данные получены для " .. player.Name)
	end
	return claimed
end

-- Все записи в одном профиле последовательны, включая выдачу товаров.
local function withLock(player, callback)
    while writeBusy[player] do task.wait(0.05) end
    writeBusy[player] = true
    local ok, result = pcall(callback)
    writeBusy[player] = nil
    if not ok then
        warn("[DataService] write lock error: " .. tostring(result))
        return false
    end
    return result == true
end

local function save(player, release)
    local data = profiles[player]
    if not data or noSave[player] then return false end
    return withLock(player, function()
        data.lastSeen = os.time()
        local ok, result = retry(function()
            return store:UpdateAsync(keyFor(player), function(old)
                old = old or {}
                if old.lock and old.lock.jobId ~= game.JobId and os.time() - old.lock.time &lt; SESSION_TIMEOUT then
                    return nil
                end
                old.data = deepCopy(data)
                if release then
                    old.lock = nil
                else
                    old.lock = { jobId = game.JobId, time = os.time() }
                end
                return old
            end)
        end)
        if not ok or not result then
            warn("[DataService] save failed for " .. player.Name .. ": " .. tostring(result))
            return false
        end
        return true
    end)
end

-- Выдача продукта и отметка PurchaseId осуществляются В ОДНОМ UpdateAsync.
-- До успешной записи нельзя подтверждать чек в MarketplaceService.
function DataService.applyReceipt(player, purchaseId, applyFn)
    local profile = profiles[player]
    if not profile or noSave[player] or typeof(purchaseId) ~= "string" then return false end
    return withLock(player, function()
        local committed
        local ok, result = retry(function()
            return store:UpdateAsync(keyFor(player), function(old)
                old = old or {}
                if old.lock and old.lock.jobId ~= game.JobId and os.time() - old.lock.time &lt; SESSION_TIMEOUT then
                    return nil
                end
                local stored = old.data or {}
                reconcile(stored, DEFAULT_DATA)
                if stored.processedReceipts[purchaseId] then
                    committed = deepCopy(stored)
                    return old
                end
                local snapshot = deepCopy(profile)
                reconcile(snapshot, DEFAULT_DATA)
                applyFn(snapshot)
                snapshot.processedReceipts[purchaseId] = true
                snapshot.lastSeen = os.time()
                old.data = snapshot
                old.lock = { jobId = game.JobId, time = os.time() }
                committed = snapshot
                return old
            end)
        end)
        if not ok or not result or not committed or not committed.processedReceipts[purchaseId] then
            warn("[DataService] receipt not saved: " .. tostring(purchaseId))
            return false
        end
        -- Сохраняем исходную таблицу profile: на неё ссылаются другие сервисы.
        for key in pairs(profile) do profile[key] = nil end
        for key, value in pairs(committed) do profile[key] = value end
        return true
    end)
end

local function onPlayerAdded(player)
	waiting[player] = waiting[player] or {}

	local data = load(player)
	if not player.Parent then
		return -- игрок вышел во время загрузки
	end

	if data == nil then
		if RunService:IsStudio() then
			-- В Studio не мешаем разработке: временный профиль БЕЗ сохранения
			warn("[DataService] Studio: DataStore недоступен, использую временный профиль (не сохраняется). Проверь Experience Settings &gt; Security &gt; Enable Studio Access to API Services и что игра опубликована.")
			data = {}
			noSave[player] = true
		else
			-- Данные не загружены: не даём играть, чтобы не затереть прогресс
			player:Kick("Не удалось загрузить данные. Попробуйте зайти позже.")
			return
		end
	end

    reconcile(data, DEFAULT_DATA)
    -- v33: never reset old money, catalog, diamonds, shelves or stars.
    if data.v33Migrated ~= true then
        data.lootCopies=type(data.lootCopies)=="table" and data.lootCopies or {}
        for _,it in ipairs(data.shelf or {}) do
            if type(it)=="table" and type(it.id)=="string" then
                data.lootCopies[it.id]=(tonumber(data.lootCopies[it.id]) or 0)+1
            end
        end
        data.v33Migrated=true
    end
    -- Previous versions stored a dense list. Keep the old slot order and
    -- append explicit EMPTY slot markers, never deleting an owned item.
    data.shelfStorage=type(data.shelfStorage)=="table" and data.shelfStorage or {}
    if data.v36Migrated ~= true then
        data.shelf=type(data.shelf)=="table" and data.shelf or {}
        local capacity=math.max(#data.shelf,math.max(12,math.floor(tonumber(data.shelfCapacity) or 12)))
        for i=#data.shelf+1,capacity do
            data.shelf[i]={id="__empty"}
        end
        data.v36Migrated=true
    end
    data.version=3
    -- A saved absolute timestamp, not a session timer. Existing progress is untouched.
    data.vipUntil=math.clamp(math.floor(tonumber(data.vipUntil) or 0),0,4102444800)
    data.diamonds=math.clamp(math.floor(tonumber(data.diamonds) or 0),0,1000000000)
    local testGrantApplied=false
    -- A single explicit Roblox username is allowed to receive the developer grant.
    -- No RemoteEvent/client code can trigger this. No starter gems for other users.
    if ENABLE_ONE_TIME_TEST_GRANT
        and player.Name:lower()==TEST_ACCOUNT_USERNAME:lower()
        and data[TEST_GRANT_FLAG] ~= true then
        data.diamonds=math.min(1000000000,data.diamonds+TEST_GRANT_AMOUNT)
        data[TEST_GRANT_FLAG]=true
        testGrantApplied=true
        print(("[Steal60/TestDiamonds] Однократно выдано %d алмазов разработчику %s (%d)")
            :format(TEST_GRANT_AMOUNT,player.Name,player.UserId))
    end
    reconcileSeason(data)
	profiles[player] = data
	player:SetAttribute("DataLoaded", true)
    -- Save immediately so a quick test/exit doesn't lose a first-time grant.
    -- Without Studio API access the fallback profile is intentionally temporary.
    if testGrantApplied and not noSave[player] then
        task.spawn(function()
            if player.Parent then save(player,false) end
        end)
    end

	local callbacks = waiting[player] or {}
	waiting[player] = nil
	for _, cb in ipairs(callbacks) do
		task.spawn(cb, data)
	end
end

local function onPlayerRemoving(player)
	leaving[player] = true
	if profiles[player] then
		save(player, true)
	end
	profiles[player] = nil
	waiting[player] = nil
	noSave[player] = nil
	leaving[player] = nil
end

----------------------------------------------------------------------
-- Публичный API
----------------------------------------------------------------------

function DataService.get(player)
	return profiles[player]
end

-- Выполнить callback, когда данные игрока загружены (или сразу, если уже)
function DataService.onLoaded(player, callback)
	local data = profiles[player]
	if data then
		task.spawn(callback, data)
		return
	end
	-- Данные ещё грузятся: запоминаем callback
	waiting[player] = waiting[player] or {}
	table.insert(waiting[player], callback)
end

-- 'alreadyBonused' means the award already included hero+pet percentage,
-- for example a delivered vehicle or precomputed till. Never boost the same money twice.
function DataService.addMoney(player, amount, alreadyBonused)
    local data = profiles[player]
    if not data or type(amount)~="number" or amount ~= amount or
        amount == math.huge or amount == -math.huge then return false end
    reconcileSeason(data)
    if amount &gt; 0 and alreadyBonused ~= true then
        local cosmeticConfig = require(game.ReplicatedStorage.Shared.Config.CosmeticConfig)
        local pct = cosmeticConfig.coinBonusPct(data)
        amount = math.floor(amount*(1+pct/100)+0.5)
    end
    data.money = math.max(0, data.money + amount)
    if amount &gt; 0 then
        local gain=math.floor(amount)
        if gain &gt; 0 then
            data.seasonEarnings=math.max(0,math.floor(tonumber(data.seasonEarnings) or 0))+gain
            for _,handler in ipairs(moneyEarnedHandlers) do
                local ok,err=pcall(handler,player,data.seasonIndex,data.seasonEarnings)
                if not ok then warn("[Steal60] seasonal earnings hook failed: "..tostring(err)) end
            end
        end
    end
    return true
end

-- Diamonds are NEVER earned through addMoney / till / season score.
-- Only upgrades and Roblox receipt processing may change this balance.
function DataService.canSave(player)
    return profiles[player]~=nil and noSave[player]~=true
end
function DataService.spendDiamonds(player, amount)
    local data=profiles[player]
    if not data or typeof(amount)~="number" or amount~=amount or amount==math.huge or amount==-math.huge then return false end
    amount=math.floor(amount)
    if amount&lt;=0 or math.floor(tonumber(data.diamonds) or 0)&lt;amount then return false end
    data.diamonds=math.floor(data.diamonds)-amount
    return true
end
function DataService.spendMoney(player, amount)
	local data = profiles[player]
	if not data or amount &lt; 0 or data.money &lt; amount then
		return false
	end
	data.money -= amount
	return true
end

-- Записать машину в каталог. Возвращает true, если машина новая.
function DataService.addToCatalog(player, carId, rarity, variantId)
	local data = profiles[player]
	if not data then
		return false
	end
	local entry = data.catalog[carId]
	local isNew = entry == nil
	if isNew then
		entry = { count = 0, stars = 0, bestRarity = rarity, variants = {} }
		data.catalog[carId] = entry
	end
	entry.count += 1
	entry.variants[variantId] = true

	local Rarity = require(game.ReplicatedStorage.Shared.Rarity)
	local order = {}
	for i, r in ipairs(Rarity.Order) do
		order[r] = i
	end
	if order[rarity] &gt; order[entry.bestRarity] then
		entry.bestRarity = rarity
	end

	-- Витрина: последние угнанные (без дубликатов), максимум 20 в истории
	local recent = data.showcase.recent
	local idx = table.find(recent, carId)
	if idx then
		table.remove(recent, idx)
	end
	table.insert(recent, 1, carId)
	while #recent &gt; 20 do
		table.remove(recent)
	end

	return isNew
end

function DataService.saveNow(player)
	return save(player, false)
end

function DataService.init()
	Players.PlayerAdded:Connect(function(p)
		task.spawn(onPlayerAdded, p)
	end)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, p in ipairs(Players:GetPlayers()) do
		task.spawn(onPlayerAdded, p)
	end

	-- Автосохранение
	task.spawn(function()
		while true do
			task.wait(Settings.AutosaveInterval)
			for player in pairs(profiles) do
				if not leaving[player] then
					task.spawn(save, player, false)
				end
			end
		end
	end)

	-- Сохранение при закрытии сервера
	game:BindToClose(function()
		if RunService:IsStudio() then
			task.wait(1)
		end
		local pending = 0
		for player in pairs(profiles) do
			if not leaving[player] then
				pending += 1
				task.spawn(function()
					save(player, true)
					pending -= 1
				end)
			end
		end
		while pending &gt; 0 do
			task.wait()
		end
	end)
end

return DataService
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX13">
          <Properties>
            <string name="Name">TrackParts</string>
            <ProtectedString name="Source">-- ModuleScript: ServerScriptService/Services/TrackParts
-- Мелкие помощники для постройки декора.
local CollectionService = game:GetService("CollectionService")
local TrackParts = {}

-- pos: Vector3 или CFrame. collide=false отключает коллизии и запросы (дешевле).
function TrackParts.part(parent, name, size, pos, color, material, collide)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	if typeof(pos) == "CFrame" then
		p.CFrame = pos
	else
		p.CFrame = CFrame.new(pos)
	end
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
    -- Roads and ground stay physically solid. All other native geometry (including
    -- curbs, police barriers, showroom fittings, cones, signs, event props) remains
    -- visible and can still be solid for pedestrians without launching the car.
    if name == "Road" or name == "Ground" or name == "Intersection" then
        p.CollisionGroup = "Default"
    else
        p.CollisionGroup = "Steal60WorldDecor"
    end
	if collide == false then
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
	end
    if name == "Barricade" then
        CollectionService:AddTag(p,"S60SoftBarricade")
    end
    if name == "Barricade" or name == "Cone" then
        -- Arcade cars have no physical collisions; the DriveService performs
        -- swept 2D solid detection against these real visible obstacles.
        CollectionService:AddTag(p,"S60DriveObstacle")
    end
	p.Parent = parent
	return p
end

-- Вертикальный цилиндр (у Roblox ось цилиндра — X, поэтому поворачиваем)
function TrackParts.cylinderV(parent, name, height, diameter, pos, color, material)
	local p = TrackParts.part(parent, name, Vector3.new(height, diameter, diameter),
		CFrame.new(pos) * CFrame.Angles(0, 0, math.pi / 2), color, material)
	p.Shape = Enum.PartType.Cylinder
	return p
end

function TrackParts.ball(parent, name, diameter, pos, color, material, collide)
	local p = TrackParts.part(parent, name, Vector3.new(diameter, diameter, diameter), pos, color, material, collide)
	p.Shape = Enum.PartType.Ball
	return p
end

function TrackParts.pick(rng, list)
	return list[rng:NextInteger(1, #list)]
end

-- Надпись на грани детали
function TrackParts.signFace(part, face, text, textColor)
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 12
	gui.LightInfluence = 0
	gui.Parent = part

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.TextScaled = true
	label.Font = Enum.Font.GothamBold
	label.TextColor3 = textColor or Color3.new(1, 1, 1)
	label.Text = text
	label.Parent = gui
	return label
end

return TrackParts
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX14">
          <Properties>
            <string name="Name">DistrictBuilder</string>
            <ProtectedString name="Source">-- ModuleScript: ServerScriptService/Services/DistrictBuilder
-- Процедурно строит модель района (дорога, перекрёсток, декор, 8 парковочных мест).
-- Декор — простая заглушка из блоков; потом можно заменить своими моделями.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")
local Shared = ReplicatedStorage:WaitForChild("Shared")

local Settings = require(Shared.Config.Settings)
local Districts = require(Shared.Config.Districts)
local Layout = require(Shared.TrackLayout)
local P = require(script.Parent.TrackParts)
local Art = require(script.Parent.WorldArtDirector)

local part, pick = P.part, P.pick

local T = Settings.Track
local ROAD_HALF = T.RoadHalfWidth
local PARK_WIDTH = T.ParkingWidth
local WALK_WIDTH = T.SidewalkWidth
local ROAD_FULL_HALF = ROAD_HALF + PARK_WIDTH
local BUILD_FRONT = ROAD_FULL_HALF + WALK_WIDTH + 4 -- 42: куда упираются фасады домов
local GROUND_HALF = T.GroundHalfWidth

local WHITE = Color3.fromRGB(235, 235, 235)

----------------------------------------------------------------------
-- Темы районов
----------------------------------------------------------------------
local THEMES = {
	outskirts = {
		ground = Color3.fromRGB(125, 108, 82), groundMat = Enum.Material.Ground,
		road = Color3.fromRGB(62, 60, 58), sidewalk = Color3.fromRGB(150, 145, 135),
		accent = Color3.fromRGB(150, 90, 50),
		style = "garage", spacing = { 26, 40 },
		palette = {
			Color3.fromRGB(140, 100, 75), Color3.fromRGB(120, 125, 120),
			Color3.fromRGB(150, 130, 95), Color3.fromRGB(110, 95, 90),
		},
	},
	suburbs = {
		ground = Color3.fromRGB(110, 120, 100), groundMat = Enum.Material.Concrete,
		road = Color3.fromRGB(58, 58, 62), sidewalk = Color3.fromRGB(170, 170, 165),
		accent = Color3.fromRGB(80, 120, 170),
		style = "block", spacing = { 36, 52 },
		palette = {
			Color3.fromRGB(190, 185, 170), Color3.fromRGB(165, 170, 180),
			Color3.fromRGB(200, 170, 150), Color3.fromRGB(150, 160, 150),
		},
	},
	cottages = {
		ground = Color3.fromRGB(100, 150, 85), groundMat = Enum.Material.Grass,
		road = Color3.fromRGB(65, 65, 68), sidewalk = Color3.fromRGB(195, 190, 180),
		accent = Color3.fromRGB(70, 150, 90),
		style = "cottage", spacing = { 36, 50 },
		palette = {
			Color3.fromRGB(240, 215, 170), Color3.fromRGB(190, 215, 235),
			Color3.fromRGB(235, 190, 190), Color3.fromRGB(205, 235, 200),
		},
	},
	villas = {
		ground = Color3.fromRGB(95, 145, 90), groundMat = Enum.Material.Grass,
		road = Color3.fromRGB(55, 55, 60), sidewalk = Color3.fromRGB(215, 210, 200),
		accent = Color3.fromRGB(190, 150, 60),
		style = "villa", spacing = { 62, 80 },
		palette = {
			Color3.fromRGB(245, 235, 215), Color3.fromRGB(235, 225, 205),
			Color3.fromRGB(250, 245, 235),
		},
	},
	resort = {
		ground = Color3.fromRGB(228, 208, 150), groundMat = Enum.Material.Sand,
		road = Color3.fromRGB(50, 50, 58), sidewalk = Color3.fromRGB(235, 230, 220),
		accent = Color3.fromRGB(240, 90, 160),
		style = "resort", spacing = { 56, 76 },
		palette = {
			Color3.fromRGB(250, 250, 250), Color3.fromRGB(240, 245, 250),
		},
		accents = {
			Color3.fromRGB(240, 90, 160), Color3.fromRGB(60, 200, 220), Color3.fromRGB(255, 190, 50),
		},
	},
}

----------------------------------------------------------------------
-- Стили зданий. cx — центр по X, side = 1 или -1 (сторона дороги по Z)
----------------------------------------------------------------------
local STYLES = {}

function STYLES.garage(parent, cx, side, rng, theme)
	local w, d, h = rng:NextInteger(14, 22), rng:NextInteger(12, 18), rng:NextInteger(7, 10)
	local zc = side * (BUILD_FRONT + d / 2)
	part(parent, "Garage", Vector3.new(w, h, d), Vector3.new(cx, h / 2, zc), pick(rng, theme.palette), Enum.Material.Concrete)
	part(parent, "Roof", Vector3.new(w + 1, 0.6, d + 1), Vector3.new(cx, h + 0.3, zc), Color3.fromRGB(70, 60, 55), Enum.Material.Metal)
	part(parent, "Door", Vector3.new(w * 0.6, h * 0.7, 0.3), Vector3.new(cx, h * 0.35, side * (BUILD_FRONT - 0.15)),
		Color3.fromRGB(60, 60, 65), Enum.Material.CorrodedMetal, false)
	if rng:NextNumber() &lt; 0.5 then
		part(parent, "Fence", Vector3.new(w + 8, 3, 0.4), Vector3.new(cx, 1.5, side * (BUILD_FRONT - 2)),
			Color3.fromRGB(110, 85, 60), Enum.Material.Wood, false)
	end
end

function STYLES.block(parent, cx, side, rng, theme)
	local w, d, h = rng:NextInteger(24, 32), rng:NextInteger(16, 22), rng:NextInteger(30, 50)
	local zc = side * (BUILD_FRONT + d / 2)
	part(parent, "Block", Vector3.new(w, h, d), Vector3.new(cx, h / 2, zc), pick(rng, theme.palette), Enum.Material.Concrete)
	local y = 8
	while y &lt; h - 3 do
		part(parent, "Windows", Vector3.new(w * 0.9, 2.5, 0.3), Vector3.new(cx, y, side * (BUILD_FRONT - 0.1)),
			Color3.fromRGB(70, 90, 115), Enum.Material.Glass, false)
		y += 8
	end
end

function STYLES.cottage(parent, cx, side, rng, theme)
	local w, d, h = rng:NextInteger(16, 20), rng:NextInteger(14, 18), rng:NextInteger(9, 11)
	local setback = 10
	local zFront = side * (BUILD_FRONT + setback)
	local zc = side * (BUILD_FRONT + setback + d / 2)
	local lawnDepth = setback + d + 4
	part(parent, "Lawn", Vector3.new(w + 12, 0.1, lawnDepth), Vector3.new(cx, 0.05, side * (BUILD_FRONT + lawnDepth / 2)),
		Color3.fromRGB(95, 165, 80), Enum.Material.Grass, false)
	part(parent, "House", Vector3.new(w, h, d), Vector3.new(cx, h / 2, zc), pick(rng, theme.palette))
	part(parent, "Roof", Vector3.new(w + 2, 1, d + 2), Vector3.new(cx, h + 0.5, zc), Color3.fromRGB(150, 70, 55), Enum.Material.Slate)
	part(parent, "Chimney", Vector3.new(2, 5, 2), Vector3.new(cx + w / 3, h + 3, zc), Color3.fromRGB(120, 80, 70), Enum.Material.Brick)
	part(parent, "Door", Vector3.new(3, 6, 0.3), Vector3.new(cx, 3, zFront - side * 0.1), Color3.fromRGB(110, 70, 45), Enum.Material.Wood, false)
	if rng:NextNumber() &lt; 0.7 then
		local tx = cx + (w / 2 + 5) * (rng:NextNumber() &lt; 0.5 and 1 or -1)
		local tz = side * (BUILD_FRONT + 6)
		part(parent, "Trunk", Vector3.new(1.4, 6, 1.4), Vector3.new(tx, 3, tz), Color3.fromRGB(100, 70, 45), Enum.Material.Wood)
		P.ball(parent, "Crown", 7, Vector3.new(tx, 8.5, tz), Color3.fromRGB(60, 130, 60), Enum.Material.Grass, false)
	end
end

function STYLES.villa(parent, cx, side, rng, theme)
	local w, d, h = rng:NextInteger(30, 38), rng:NextInteger(24, 30), rng:NextInteger(14, 18)
	local setback = 18
	local zFront = side * (BUILD_FRONT + setback)
	local zc = side * (BUILD_FRONT + setback + d / 2)
	part(parent, "Villa", Vector3.new(w, h, d), Vector3.new(cx, h / 2, zc), pick(rng, theme.palette), Enum.Material.SmoothPlastic)
	part(parent, "Roof", Vector3.new(w + 2, 1.2, d + 2), Vector3.new(cx, h + 0.6, zc), Color3.fromRGB(85, 80, 90), Enum.Material.Slate)
	for i = 1, 4 do
		part(parent, "Column", Vector3.new(1.6, h * 0.8, 1.6),
			Vector3.new(cx + (i - 2.5) * w * 0.22, h * 0.4, zFront - side * 1.2),
			Color3.fromRGB(245, 240, 230), Enum.Material.Marble)
	end
	-- ворота и забор
	for _, dx in ipairs({ -6, 6 }) do
		part(parent, "GatePillar", Vector3.new(2, 8, 2), Vector3.new(cx + dx, 4, side * (BUILD_FRONT + 1)),
			Color3.fromRGB(190, 185, 175), Enum.Material.Marble)
	end
	for _, dx in ipairs({ -14, 14 }) do
		part(parent, "Fence", Vector3.new(14, 3.5, 0.4), Vector3.new(cx + dx, 1.75, side * (BUILD_FRONT + 1)),
			Color3.fromRGB(40, 40, 45), Enum.Material.Metal, false)
	end
	-- фонтан
	local fz = side * (BUILD_FRONT + 9)
	P.cylinderV(parent, "FountainBase", 1.2, 9, Vector3.new(cx, 0.6, fz), Color3.fromRGB(190, 190, 195), Enum.Material.Concrete)
	local water = P.cylinderV(parent, "Water", 1.4, 7, Vector3.new(cx, 0.65, fz), Color3.fromRGB(90, 170, 230), Enum.Material.Glass)
	water.Transparency = 0.3
end

function STYLES.resort(parent, cx, side, rng, theme)
	local w, d, h = rng:NextInteger(28, 36), rng:NextInteger(24, 30), rng:NextInteger(60, 90)
	local zFront = side * (BUILD_FRONT + 6)
	local zc = side * (BUILD_FRONT + 6 + d / 2)
	local accent = pick(rng, theme.accents)
	part(parent, "Hotel", Vector3.new(w, h, d), Vector3.new(cx, h / 2, zc), pick(rng, theme.palette), Enum.Material.SmoothPlastic)
	part(parent, "Accent", Vector3.new(5, h, 0.4), Vector3.new(cx, h / 2, zFront - side * 0.2), accent, Enum.Material.SmoothPlastic, false)
	local y = 6
	while y &lt; h - 4 do
		part(parent, "Windows", Vector3.new(w * 0.92, 3, 0.3), Vector3.new(cx, y, zFront - side * 0.1),
			Color3.fromRGB(130, 180, 215), Enum.Material.Glass, false)
		y += 7
	end
	part(parent, "Sign", Vector3.new(w * 0.6, 4, 1.2), Vector3.new(cx, h + 2.5, zFront), accent, Enum.Material.Neon, false)
	for _, dx in ipairs({ -(w / 2 + 6), w / 2 + 6 }) do
		local pz = side * (BUILD_FRONT - 4)
		part(parent, "PalmTrunk", Vector3.new(1, 12, 1), Vector3.new(cx + dx, 6, pz), Color3.fromRGB(130, 95, 60), Enum.Material.Wood, false)
		part(parent, "PalmLeaves", Vector3.new(10, 3, 10), Vector3.new(cx + dx, 12.5, pz), Color3.fromRGB(60, 160, 70), Enum.Material.Grass, false)
	end
end

----------------------------------------------------------------------
-- Сборка района
----------------------------------------------------------------------
local Builder = {}

function Builder.build(index)
	local def = Districts[index]
	local theme = THEMES[def.id]
	local rng = Random.new(1000 + index)

	local model = Instance.new("Model")
	model.Name = def.modelName
	model:SetAttribute("Index", index)
	model:SetAttribute("DistrictId", def.id)
	model:SetAttribute("CarClass", def.carClass)

	local decor = Instance.new("Folder")
	decor.Name = "Decor"
	decor.Parent = model
	local slots = Instance.new("Folder")
	slots.Name = "ParkSlots"
	slots.Parent = model

	local x0 = Layout.intersectionStart(index) -- начало перекрёстка
	local x1 = Layout.districtStart(index)     -- начало района
	local x2 = Layout.districtEnd(index)       -- конец района
	local roadCx = (x1 + x2) / 2

	-- земля под перекрёстком и районом
	part(model, "Ground", Vector3.new(x2 - x0, 2, GROUND_HALF * 2), Vector3.new((x0 + x2) / 2, -1, 0), theme.ground, theme.groundMat)

    -- Streamed lateral map limits keep a continuous boundary at every district.
    -- Anchored and solid for pedestrians, non-colliding for vehicles by group.
    for _, side in ipairs({-1, 1}) do
        local z = side * (GROUND_HALF - 4)
        local wall = part(model,"SideMapBoundary",Vector3.new(x2-x0,48,4),
            Vector3.new((x0+x2)/2,24,z),Color3.fromRGB(95,120,138),Enum.Material.SmoothPlastic)
        wall.Transparency=.62
        wall.CastShadow=false
        part(decor,"BorderNeonRail",Vector3.new(x2-x0,.6,1),
            Vector3.new((x0+x2)/2,3.7,z-side),Color3.fromRGB(98,216,223),Enum.Material.Neon,false)
    end

	-- перекрёсток
	part(model, "Intersection", Vector3.new(T.IntersectionLength, 0.4, T.CrossRoadHalf * 2),
		Vector3.new(x0 + T.IntersectionLength / 2, 0, 0), theme.road, Enum.Material.Asphalt)
	for _, xc in ipairs({ x0 + 4, x1 - 4 }) do -- пешеходные переходы
		for z = -ROAD_HALF + 2, ROAD_HALF - 2, 4 do
			part(decor, "Crosswalk", Vector3.new(3, 0.05, 2), Vector3.new(xc, 0.22, z), WHITE, Enum.Material.SmoothPlastic, false)
		end
	end

	-- дорога, тротуары, разметка
	part(model, "Road", Vector3.new(x2 - x1, 0.4, ROAD_FULL_HALF * 2), Vector3.new(roadCx, 0, 0), theme.road, Enum.Material.Asphalt)
	for _, side in ipairs({ 1, -1 }) do
		part(model, "Sidewalk", Vector3.new(x2 - x1, 0.8, WALK_WIDTH),
			Vector3.new(roadCx, 0, side * (ROAD_FULL_HALF + WALK_WIDTH / 2)), theme.sidewalk, Enum.Material.Concrete)
		part(decor, "EdgeLine", Vector3.new(x2 - x1, 0.05, 0.4), Vector3.new(roadCx, 0.22, side * ROAD_HALF),
			Color3.fromRGB(230, 200, 60), Enum.Material.SmoothPlastic, false)
	end
	for x = x1 + 10, x2 - 10, 20 do
		part(decor, "Dash", Vector3.new(8, 0.05, 0.5), Vector3.new(x, 0.22, 0), WHITE, Enum.Material.SmoothPlastic, false)
	end

	-- 8 парковочных мест: 4 с каждой стороны
	local n = 0
	for _, side in ipairs({ 1, -1 }) do
		for k = 1, 4 do
			n += 1
			local sx = x1 + T.DistrictLength * (2 * k - 1) / 8
			local sz = side * (ROAD_HALF + PARK_WIDTH / 2)
			local slot = part(slots, "ParkSlot_" .. n, Vector3.new(16, 0.05, 8), Vector3.new(sx, 0.22, sz),
				Color3.fromRGB(88, 88, 96), Enum.Material.Asphalt, false)
			slot:SetAttribute("Index", n)
			slot:SetAttribute("DistrictIndex", index)
			slot:SetAttribute("Side", side)
			for _, dz in ipairs({ -4, 4 }) do
				part(decor, "SlotLine", Vector3.new(16, 0.06, 0.3), Vector3.new(sx, 0.23, sz + dz), WHITE, Enum.Material.SmoothPlastic, false)
			end
		end
	end

	-- фонари
	for _, side in ipairs({ 1, -1 }) do
		for x = x1 + 30, x2 - 10, 60 do
			local lz = side * (ROAD_FULL_HALF + 2)
			part(decor, "LampPole", Vector3.new(0.6, 12, 0.6), Vector3.new(x, 6, lz), Color3.fromRGB(50, 50, 55), Enum.Material.Metal, false)
			part(decor, "LampBulb", Vector3.new(2, 0.6, 2), Vector3.new(x, 12.3, lz), Color3.fromRGB(255, 240, 180), Enum.Material.Neon, false)
		end
	end

	-- Cinematic Art Director creates the district gate.

	-- здания по обеим сторонам
	local style = STYLES[theme.style]
	local built = 0
	for _, side in ipairs({ 1, -1 }) do
		local x = x1 + 25
		while x &lt; x2 - 25 do
			style(decor, x, side, rng, theme)
			x += rng:NextInteger(theme.spacing[1], theme.spacing[2])
			built += 1
			if built % 4 == 0 then
				task.wait() -- не вешаем сервер одним кадром
			end
		end
	end

	-- лёгкие препятствия на проезжей части: конусы, их можно сбить
	local obstacles = Instance.new("Folder")
	obstacles.Name = "Obstacles"
	obstacles.Parent = model
	for _ = 1, 8 do
		local ox = x1 + rng:NextInteger(60, T.DistrictLength - 60)
		local oz = rng:NextInteger(-15, 15)
		local cone = P.cylinderV(obstacles, "Cone", 2.4, 1.6, Vector3.new(ox, 1.4, oz), Color3.fromRGB(255, 120, 30), Enum.Material.SmoothPlastic)
		cone.Anchored = true
		cone.CanCollide = false
		cone.CanQuery = false
		cone.CanTouch = false
		CollectionService:RemoveTag(cone, "S60DriveObstacle")
		CollectionService:AddTag(cone, "S60KnockdownCone")
	end

	-- конец трассы
	if index == Layout.Count then
		local wall = part(model, "EndWall", Vector3.new(4, 100, GROUND_HALF * 2), Vector3.new(x2 + 2, 50, 0), Color3.fromRGB(35, 35, 40), Enum.Material.Concrete)
		P.signFace(wall, Enum.NormalId.Left, "КОНЕЦ ТРАССЫ · скоро новые районы")
	end

    Art.decorateDistrict(model,index,x0,x1,x2)
	return model
end

return Builder
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX15">
          <Properties>
            <string name="Name">TrackBuilder</string>
            <ProtectedString name="Source">-- ModuleScript: ServerScriptService/Services/TrackBuilder
-- Строит постоянную часть мира: зона салонов, дорога, спавн, туман.
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")

local Settings = require(Shared.Config.Settings)
local Layout = require(Shared.TrackLayout)
local P = require(script.Parent.TrackParts)
local Art = require(script.Parent.WorldArtDirector)

local T = Settings.Track
local ROAD_HALF = T.RoadHalfWidth
local ROAD_FULL_HALF = ROAD_HALF + T.ParkingWidth
local WALK = T.SidewalkWidth

local TrackBuilder = {}

local function addPlotLabel(pad, text)
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(110, 28)
    bb.MaxDistance = 40
	bb.StudsOffset = Vector3.new(0, 3, 0)
	bb.Adornee = pad
	bb.Parent = pad

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 0.3
	label.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
	label.TextColor3 = Color3.new(1, 1, 1)
	label.Font = Enum.Font.GothamBold
	label.TextScaled = true
	label.Text = text
	label.Parent = bb
end

function TrackBuilder.init()
	local core = Instance.new("Model")
	core.Name = "TrackCore"

	local x0, x1 = -60, T.SalonZoneLength
	local len, cx = x1 - x0, (x0 + x1) / 2

	P.part(core, "Ground", Vector3.new(len, 2, T.GroundHalfWidth * 2), Vector3.new(cx, -1, 0), Color3.fromRGB(120, 125, 130), Enum.Material.Concrete)
	P.part(core, "Road", Vector3.new(len, 0.4, ROAD_FULL_HALF * 2), Vector3.new(cx, 0, 0), Color3.fromRGB(60, 60, 62), Enum.Material.Asphalt)

	for _, side in ipairs({ 1, -1 }) do
		P.part(core, "Sidewalk", Vector3.new(len, 0.8, WALK), Vector3.new(cx, 0, side * (ROAD_FULL_HALF + WALK / 2)), Color3.fromRGB(190, 190, 185), Enum.Material.Concrete)
		P.part(core, "EdgeLine", Vector3.new(len, 0.05, 0.4), Vector3.new(cx, 0.22, side * ROAD_HALF), Color3.fromRGB(230, 200, 60), Enum.Material.SmoothPlastic, false)
	end
	for x = x0 + 10, x1 - 10, 20 do
		P.part(core, "Dash", Vector3.new(8, 0.05, 0.5), Vector3.new(x, 0.22, 0), Color3.fromRGB(235, 235, 235), Enum.Material.SmoothPlastic, false)
	end

    -- Continuous limits for pedestrians. Cars cannot ram these: world decor
    -- and Vehicles have no collision, and DriveService handles soft roadway bounds.
    for _, side in ipairs({-1, 1}) do
        local edgeZ = side * (T.GroundHalfWidth - 4)
        local wall = P.part(core, "SideMapBoundary", Vector3.new(len, 48, 4),
            Vector3.new(cx, 24, edgeZ), Color3.fromRGB(95, 120, 138), Enum.Material.SmoothPlastic)
        wall.Transparency = .62
        wall.CastShadow = false
        P.part(core, "BorderNeonRail", Vector3.new(len, .6, 1.0),
            Vector3.new(cx, 3.7, edgeZ - side * 1.0), Color3.fromRGB(98, 216, 223), Enum.Material.Neon, false)
    end
    P.part(core, "StartMapBoundary", Vector3.new(4, 48, T.GroundHalfWidth * 2),
        Vector3.new(x0-4,24,0),Color3.fromRGB(96,120,139), Enum.Material.SmoothPlastic).Transparency=.65

    -- PERMANENT map edges independent of streamed districts. Long Roblox Parts
    -- are split into 650-stud sections; safety floor catches accidental falls.
    -- All parts are anchored and invisible. Pedestrians hit the bounds; arcade
    -- vehicles already have their own server-enforced limits.
    local worldEnd=Layout.trackEnd()+18
    local startX=x0-35
    for segmentX=startX,worldEnd,650 do
        local length=math.min(650,worldEnd-segmentX)
        if length&gt;0 then
            local midpoint=segmentX+length*.5
            local floor=P.part(core,"SafetyFloor",Vector3.new(length,1,T.GroundHalfWidth*2-10),
                Vector3.new(midpoint,-6,0),Color3.fromRGB(40,58,62),Enum.Material.SmoothPlastic)
            floor.Transparency=1
            floor.CastShadow=false
            for _,side in ipairs({-1,1}) do
                local wall=P.part(core,"PermanentMapEdge",Vector3.new(length,90,5),
                    Vector3.new(midpoint,44,side*(T.GroundHalfWidth-5)),Color3.fromRGB(35,53,65),Enum.Material.SmoothPlastic)
                wall.Transparency=1
                wall.CastShadow=false
            end
        end
    end
    local finish=P.part(core,"PermanentMapEnd",Vector3.new(5,90,T.GroundHalfWidth*2),
        Vector3.new(worldEnd,44,0),Color3.fromRGB(35,53,65),Enum.Material.SmoothPlastic)
    finish.Transparency=1
    finish.CastShadow=false

	-- 8 участков под салоны: по 4 с каждой стороны (этап 5 построит на них салоны)
	local plots = Instance.new("Folder")
	plots.Name = "SalonPlots"
	plots.Parent = core
	for _, side in ipairs({ 1, -1 }) do
		for k = 1, 4 do
			local idx = (side == 1 and 0 or 4) + k
			local pad = P.part(plots, "SalonPlot_" .. idx, Vector3.new(70, 0.3, 44),
				Vector3.new(60 + (k - 1) * 85, 0.15, side * 64), Color3.fromRGB(110, 145, 110), Enum.Material.Grass)
			pad:SetAttribute("PlotIndex", idx)
            -- Owner name is already on the fascia. No floating plot billboard.
		end
	end

	-- свой спавн
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "SpawnLocation"
	spawn.Anchored = true
	spawn.Size = Vector3.new(10, 1, 10)
	spawn.Position = Vector3.new(15, 0.7, 0)
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Transparency = 0.6
	spawn.Color = Color3.fromRGB(255, 200, 60)
	spawn.Parent = core

	-- арка зоны доставки: сюда нужно заехать на угнанной машине
	local archX = T.SalonZoneLength - 20
	for _, side in ipairs({ 1, -1 }) do
		P.part(core, "DeliveryPillar", Vector3.new(2, 16, 2), Vector3.new(archX, 8, side * (ROAD_FULL_HALF + 2)),
			Color3.fromRGB(60, 60, 68), Enum.Material.Metal)
	end
	local beam = P.part(core, "DeliveryBeam", Vector3.new(3, 5, (ROAD_FULL_HALF + 4) * 2), Vector3.new(archX, 18.5, 0),
		Color3.fromRGB(40, 150, 80))
	P.signFace(beam, Enum.NormalId.Right, "SALONS AHEAD / OWN GARAGE")

    Art.decorateCore(core,T)
	core.Parent = Workspace

    -- Last-resort anti-void rescue when the floor has not streamed in yet.
    -- Does not touch seated players or alter successful deliveries.
    task.spawn(function()
        while core.Parent do
            task.wait(.50)
            for _,player in ipairs(Players:GetPlayers()) do
                local character=player.Character
                local root=character and character:FindFirstChild("HumanoidRootPart")
                local hum=character and character:FindFirstChildOfClass("Humanoid")
                if root and hum and hum.Health&gt;0 and not hum.SeatPart then
                    local p=root.Position
                    if p.Y &lt; -12 or math.abs(p.Z)&gt;T.GroundHalfWidth-7 or p.X &lt; x0-21 or p.X&gt;Layout.trackEnd()+12 then
                        root.AssemblyLinearVelocity=Vector3.zero
                        root.AssemblyAngularVelocity=Vector3.zero
                        character:PivotTo(CFrame.new(
                            math.clamp(p.X,x0+2,Layout.trackEnd()-8),
                            4,math.clamp(p.Z,-T.GroundHalfWidth+13,T.GroundHalfWidth-13)))
                    end
                end
            end
        end
    end)

	-- убираем стандартные Baseplate и SpawnLocation шаблона Studio
	for _, child in ipairs(Workspace:GetChildren()) do
		if child.Name == "Baseplate" or (child:IsA("SpawnLocation") and child ~= spawn) then
			child:Destroy()
		end
	end

	-- туман скрывает подгрузку районов вдали
    Lighting.ClockTime = 16.5
    Lighting.Brightness = 2.3
    Lighting.Ambient = Color3.fromRGB(115, 125, 140)
    Lighting.OutdoorAmbient = Color3.fromRGB(160, 165, 175)
    Lighting.EnvironmentDiffuseScale = 0.65
    Lighting.EnvironmentSpecularScale = 0.7
    Lighting.FogColor = Settings.Fog.Color
	Lighting.FogStart = Settings.Fog.Start
	Lighting.FogEnd = Settings.Fog.End
    Art.setupLighting()
end

return TrackBuilder
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX16">
          <Properties>
            <string name="Name">DistrictManager</string>
            <ProtectedString name="Source">-- ModuleScript: ServerScriptService/Services/DistrictManager
-- Держит в мире только районы рядом с игроками: текущий ±1.
-- Остальные не существуют вовсе (экономия памяти и отрисовки).
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")

local Settings = require(Shared.Config.Settings)
local Layout = require(Shared.TrackLayout)
local Builder = require(script.Parent.DistrictBuilder)

local LOAD = Settings.DistrictLoad

local DistrictManager = {}

local folder
local loaded = {}      -- [index] = model
local loading = {}     -- [index] = true
local unusedSince = {} -- [index] = os.clock()
local loadedCbs = {}
local unloadedCbs = {}

local function neededSet()
	local set = {}
	for _, player in ipairs(Players:GetPlayers()) do
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if hrp then
			local idx = Layout.indexAt(hrp.Position.X)
			local lo = math.max(1, idx - LOAD.Behind)
			local hi = math.max(lo, math.min(Layout.Count, idx + LOAD.Ahead))
			for i = lo, hi do
				set[i] = true
			end
		end
	end
	return set
end

local function loadDistrict(i)
	if loaded[i] or loading[i] then
		return
	end
	loading[i] = true
	local ok, result = pcall(Builder.build, i)
	loading[i] = nil
	if not ok then
		warn("[DistrictManager] ошибка постройки района " .. i .. ": " .. tostring(result))
		return
	end
	result.Parent = folder
	loaded[i] = result
	for _, cb in ipairs(loadedCbs) do
		task.spawn(cb, i, result)
	end
end

local function unloadDistrict(i)
	local model = loaded[i]
	if not model then
		return
	end
	for _, cb in ipairs(unloadedCbs) do
		task.spawn(cb, i, model)
	end
	loaded[i] = nil
	unusedSince[i] = nil
	model:Destroy()
end

local function step()
	local needed = neededSet()
	local now = os.clock()

	for i = 1, Layout.Count do
		if needed[i] then
			unusedSince[i] = nil
			if not loaded[i] and not loading[i] then
				task.spawn(loadDistrict, i)
			end
		end
	end

	for i in pairs(loaded) do
		if not needed[i] then
			unusedSince[i] = unusedSince[i] or now
			if now - unusedSince[i] &gt;= LOAD.UnloadDelay then
				unloadDistrict(i)
			end
		end
	end
end

----------------------------------------------------------------------
-- API
----------------------------------------------------------------------
function DistrictManager.isLoaded(i)
	return loaded[i] ~= nil
end

function DistrictManager.getModel(i)
	return loaded[i]
end

function DistrictManager.getLoadedIndices()
	local list = {}
	for i in pairs(loaded) do
		table.insert(list, i)
	end
	table.sort(list)
	return list
end

-- cb(index, model): вызывается после появления района в мире (этап 3: спавн машин)
function DistrictManager.onLoaded(cb)
	table.insert(loadedCbs, cb)
	for i, model in pairs(loaded) do
		task.spawn(cb, i, model)
	end
end

-- cb(index, model): вызывается перед удалением района
function DistrictManager.onUnloaded(cb)
	table.insert(unloadedCbs, cb)
end

function DistrictManager.init()
	folder = Instance.new("Folder")
	folder.Name = "Districts"
	folder.Parent = Workspace

	task.spawn(function()
		while true do
			local ok, err = pcall(step)
			if not ok then
				warn("[DistrictManager] " .. tostring(err))
			end
			task.wait(LOAD.CheckInterval)
		end
	end)
end

return DistrictManager
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX17">
          <Properties>
            <string name="Name">CarFactory</string>
            <ProtectedString name="Source">-- ModuleScript: ServerScriptService/Services/CarFactory
-- Создаёт машины и держит пул, чтобы не пересоздавать модели.
--
-- Свои модели: положи Model в ServerStorage/CarModels с именем = id машины из Cars.lua
-- (например "city_sedan"). Если модели нет, CarVisuals генерирует оригинальный кузов.
-- Начало координат модели = центр на земле, перед машины = +X.
-- Чтобы работала покраска вариаций, у кузовных частей поставь атрибут Paintable = true,
-- а у подсветки днища (для «Неона») атрибут NeonTrim = true. Часть с именем "Body" —
-- место для надписи и подсказки.
-- Стандартные 30 кузовов генерируются без внешних ассетов.
local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")

local Rarity = require(Shared.Rarity)
local CarClasses = require(Shared.Config.CarClasses)
local Cars = require(Shared.Config.Cars)
local CollisionService = require(script.Parent.CollisionService)
local P = require(script.Parent.TrackParts)

local CarVisuals = require(script.Parent.CarVisuals)

local CarFactory = {}

local MAX_POOL_PER_CAR = 6

local poolFolder = ServerStorage:FindFirstChild("CarPool")
if not poolFolder then
	poolFolder = Instance.new("Folder")
	poolFolder.Name = "CarPool"
	poolFolder.Parent = ServerStorage
end
local pool = {} -- [carId] = { model, ... }
local promptHandlers = {} -- [state] = function(player, car)

-- Кто обрабатывает нажатие E на машине, зависит от её состояния (State)
function CarFactory.setPromptHandler(state, fn)
	promptHandlers[state] = fn
end

local PALETTES = {
	junk = { Color3.fromRGB(140, 100, 75), Color3.fromRGB(120, 125, 120), Color3.fromRGB(150, 130, 95), Color3.fromRGB(110, 120, 150) },
	regular = { Color3.fromRGB(190, 60, 60), Color3.fromRGB(60, 110, 190), Color3.fromRGB(200, 200, 200), Color3.fromRGB(60, 150, 100) },
	sport = { Color3.fromRGB(220, 50, 40), Color3.fromRGB(240, 140, 30), Color3.fromRGB(40, 40, 50), Color3.fromRGB(60, 90, 200) },
	premium = { Color3.fromRGB(25, 25, 30), Color3.fromRGB(235, 235, 240), Color3.fromRGB(70, 75, 85), Color3.fromRGB(100, 20, 30) },
	super = { Color3.fromRGB(245, 210, 40), Color3.fromRGB(230, 30, 30), Color3.fromRGB(20, 20, 24), Color3.fromRGB(240, 240, 245) },
}

local VARIANT_STYLE = {
	retro = { color = Color3.fromRGB(235, 215, 170), material = Enum.Material.SmoothPlastic },
	neon = { color = Color3.fromRGB(255, 60, 170), material = Enum.Material.SmoothPlastic, trim = Color3.fromRGB(0, 230, 255) },
	gold = { color = Color3.fromRGB(255, 200, 40), material = Enum.Material.Metal },
}

----------------------------------------------------------------------
-- Внешний вид каждой из 150 машин создаёт CarVisuals.build (без asset IDs).
----------------------------------------------------------------------

----------------------------------------------------------------------
-- Надпись, подсветка редкости, подсказка
----------------------------------------------------------------------
local function adorneePart(model)
	return model:FindFirstChild("Body", true) or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
end

local function makeLine(parent, index)
	local l = Instance.new("TextLabel")
	l.Size = UDim2.new(1, 0, 1 / 3, 0)
	l.Position = UDim2.new(0, 0, (index - 1) / 3, 0)
	l.BackgroundTransparency = 1
	l.Font = Enum.Font.GothamBold
	l.TextScaled = true
	l.TextStrokeTransparency = 0.3
	l.TextColor3 = Color3.new(1, 1, 1)
	l.Name = "Line" .. index
	l.Parent = parent
	return l
end

local function setupExtras(model)
	local adornee = adorneePart(model)
	if not adornee then
		warn("[CarFactory] у модели " .. model.Name .. " нет частей")
		return
	end

    -- Anchor ABOVE the entire car bounding box, not inside Body.  Keeps text
    -- readable even when a roof or long SUV body obstructs the camera.
    local bounds,boundsSize=model:GetBoundingBox()
    local anchor=Instance.new("Attachment")
    anchor.Name="CarLabelRoofAnchor"
    local worldPos=bounds.Position+Vector3.new(0,boundsSize.Y*.5+2.75,0)
    anchor.Position=adornee.CFrame:PointToObjectSpace(worldPos)
    anchor.Parent=adornee
    local bb=Instance.new("BillboardGui")
    bb.Name="CarLabel"
    bb.Size=UDim2.fromOffset(195,62)
    bb.StudsOffsetWorldSpace=Vector3.new(0,.55,0)
    bb.AlwaysOnTop=true
    bb.MaxDistance=52
    bb.Adornee=anchor
    bb.Parent=adornee
	for i = 1, 3 do
		makeLine(bb, i)
	end

	local hl = Instance.new("Highlight")
	hl.Name = "RarityHighlight"
	hl.Adornee = model
	hl.FillTransparency = 1
	hl.OutlineTransparency = 0
	hl.DepthMode = Enum.HighlightDepthMode.Occluded
	hl.Enabled = false
	hl.Parent = model

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "StealPrompt"
	prompt.ActionText = "Угнать"
	prompt.HoldDuration = 0.6
	prompt.MaxActivationDistance = 10
    prompt.RequiresLineOfSight = false
    -- UI appears above the roof/bonnet instead of inside the door panel.
    -- Input range/trigger is unchanged, and no separate physics part is needed.
    prompt.UIOffset=Vector2.new(34,-95)
    prompt.Parent = adornee
	prompt.Triggered:Connect(function(player)
		local handler = promptHandlers[model:GetAttribute("State")]
		if handler then
			task.spawn(handler, player, model)
		end
	end)
end

local function findVariant(variantId)
	for _, v in ipairs(Cars.Variants) do
		if v.id == variantId then
			return v
		end
	end
	return Cars.Variants[1]
end

----------------------------------------------------------------------
-- Публичный API
----------------------------------------------------------------------

-- Достаёт машину из пула или создаёт. Возвращает model, isNew.
function CarFactory.acquire(carDef, classId)
	local list = pool[carDef.id]
	if list and #list &gt; 0 then
		return table.remove(list), false
	end

	local model
	local source = ServerStorage:FindFirstChild("CarModels")
	source = source and source:FindFirstChild(carDef.id)
	if source then
		model = source:Clone()
	else
		model = CarVisuals.build(carDef, classId)
	end

	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
            d.Anchored = true
            d.CanCollide = false
        end
    end
    -- Центр модели привязываем к кузову, иначе после езды GetPivot() остаётся на старом месте
	local mainPart = adorneePart(model)
	if mainPart then
		local offset = mainPart.CFrame:ToObjectSpace(model:GetPivot())
		model.PrimaryPart = mainPart
		mainPart.PivotOffset = offset
	end

	setupExtras(model)
	CollisionService.applyVehicle(model)
	model:SetAttribute("PoolId", carDef.id)
	return model, true
end

-- Применяет редкость и вариацию, обновляет надписи, цвет и подсветку
function CarFactory.dress(model, carDef, classId, rarity, variantId, rng)
	local classDef = CarClasses[classId]
	local variant = findVariant(variantId)
	local info = Rarity.Info[rarity]

	model.Name = carDef.name
	model:SetAttribute("CarId", carDef.id)
	model:SetAttribute("ClassId", classId)
	model:SetAttribute("Rarity", rarity)
	model:SetAttribute("Variant", variant.id)
	model:SetAttribute("RequiredHack", classDef.requiredHack)

	-- покраска
	local style = VARIANT_STYLE[variant.id]
	local palette = PALETTES[classId] or PALETTES.regular
	local baseColor = P.pick(rng, palette)
    if carDef.paints and #carDef.paints &gt; 0 then
        local hex = carDef.paints[rng:NextInteger(1, #carDef.paints)]
        local n = tonumber(hex, 16)
        if n then
            baseColor = Color3.fromRGB(math.floor(n / 65536) % 256, math.floor(n / 256) % 256, n % 256)
        end
    end
    model:SetAttribute("CosmeticApplied",nil)
    for _,part in ipairs(model:GetDescendants()) do
        if part:IsA("BasePart") then
            part:SetAttribute("CosmeticBaseColor",nil)
            part:SetAttribute("CosmeticBaseMaterial",nil)
            part:SetAttribute("CosmeticBaseTransparency",nil)
        end
    end
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			if d:GetAttribute("Paintable") then
				d.Color = style and style.color or baseColor
				d.Material = style and style.material or Enum.Material.SmoothPlastic
			elseif d:GetAttribute("NeonTrim") then
				if style and style.trim then
					d.Color = style.trim
					d.Material = Enum.Material.Neon
					d.Transparency = 0
				else
					d.Transparency = 1
				end
			end
		end
	end

	-- подсветка редкости (только выше обычной)
	local hl = model:FindFirstChild("RarityHighlight")
	if hl then
		hl.OutlineColor = info.color
		hl.Enabled = rarity ~= "common"
	end

	-- надпись
	local adornee = adorneePart(model)
	local bb = adornee and adornee:FindFirstChild("CarLabel")
    if bb then
        bb.Size=UDim2.fromOffset(195,62)
        bb.StudsOffsetWorldSpace=Vector3.new(0,.55,0)
        bb.MaxDistance=52
        bb.Line3.Visible=true
        bb.Line1.Text = carDef.name
		bb.Line1.TextColor3 = info.color
		local second = info.name
		if variant.id ~= "default" then
			second = second .. " · " .. variant.name
		end
		bb.Line2.Text = second
		bb.Line2.TextColor3 = Color3.new(1, 1, 1)
		bb.Line3.Text = ("Взлом %d+"):format(model:GetAttribute("RequiredHack") or classDef.requiredHack)
		bb.Line3.TextColor3 = Color3.fromRGB(190, 190, 190)
	end

	local prompt = adornee and (adornee:FindFirstChild("StealPrompt") or adornee:FindFirstChild("SalonRidePrompt"))
    if prompt then
        prompt.Name="StealPrompt"
        prompt.ObjectText = carDef.name
		prompt.ActionText = "Угнать"
        prompt.Enabled = true
    end
    local theftPrompt=adornee and adornee:FindFirstChild("SalonTheftPrompt")
    if theftPrompt then theftPrompt.Enabled=false end
end

-- Показывает «ЗАНЯТО» и отключает подсказку (busy = true), либо возвращает как было
function CarFactory.setBusy(model, busy)
	local adornee = adorneePart(model)
	if not adornee then
		return
	end
	local prompt = adornee:FindFirstChild("StealPrompt")
	if prompt then
		prompt.Enabled = not busy
	end
	local bb = adornee:FindFirstChild("CarLabel")
	if bb then
		if busy then
			bb.Line3.Text = "ЗАНЯТО"
			bb.Line3.TextColor3 = Color3.fromRGB(255, 90, 90)
		else
			local req = model:GetAttribute("RequiredHack") or 1
			bb.Line3.Text = ("Взлом %d+"):format(req)
			bb.Line3.TextColor3 = Color3.fromRGB(190, 190, 190)
		end
	end
end

-- One prompt for owner's ride and a second for burglars.
-- The longer theft hold does NOT delay the owner's normal ride.
function CarFactory.updateSalonSecurity(model,level)
    local adornee=adorneePart(model)
    if not adornee then return end
    local prompt=adornee:FindFirstChild("SalonTheftPrompt")
    if prompt then
        local secure=math.clamp(math.floor(tonumber(level) or 0),0,5)
        prompt.HoldDuration=2+0.5*secure
        prompt.ObjectText=("Чужой салон · охрана %d/5"):format(secure)
        prompt.UIOffset=Vector2.new(34,-95)
        model:SetAttribute("SalonSecurityLevel",secure)
        prompt.Enabled=true
    end
end
function CarFactory.setDisplay(model,security)
    local adornee=adorneePart(model)
    if not adornee then return end
    local ridePrompt=adornee:FindFirstChild("StealPrompt")
    if ridePrompt then
        ridePrompt.Name="SalonRidePrompt"
        ridePrompt.ActionText="Поехать"
        ridePrompt.ObjectText="Твоя машина"
        ridePrompt.KeyboardKeyCode=Enum.KeyCode.E
        ridePrompt.HoldDuration=.25
        ridePrompt.UIOffset=Vector2.new(34,-95)
        ridePrompt.Enabled=true
    end
    local theftPrompt=adornee:FindFirstChild("SalonTheftPrompt")
    if not theftPrompt then
        theftPrompt=Instance.new("ProximityPrompt")
        theftPrompt.Name="SalonTheftPrompt"
        theftPrompt.ActionText="Обчистить витрину"
        theftPrompt.KeyboardKeyCode=Enum.KeyCode.E
        theftPrompt.RequiresLineOfSight=false
        theftPrompt.MaxActivationDistance=10
        theftPrompt.UIOffset=Vector2.new(34,-95)
        theftPrompt.Parent=adornee
        theftPrompt.Triggered:Connect(function(player)
            if model:GetAttribute("State")~="display" then return end
            local handler=promptHandlers["displayTheft"]
            if handler then task.spawn(handler,player,model) end
        end)
    end
    CarFactory.updateSalonSecurity(model,security)
    local bb=adornee:FindFirstChild("CarLabel")
    if bb then
        -- Showroom vehicles are a single visual group, not six giant floating billboards.
        bb.Size=UDim2.fromOffset(135,43)
        bb.StudsOffsetWorldSpace=Vector3.new(0,.35,0)
        bb.MaxDistance=26
        bb.Line3.Visible=false
        bb.Line1.TextColor3=Color3.fromRGB(236,242,245)
    end
end

-- Машина, на которой едет владелец салона
function CarFactory.setRide(model)
	local adornee = adorneePart(model)
	local prompt = adornee and (adornee:FindFirstChild("StealPrompt") or adornee:FindFirstChild("SalonRidePrompt"))
	if prompt then
        prompt.Enabled = false
    end
    local other=adornee and adornee:FindFirstChild("SalonTheftPrompt")
    if other then other.Enabled=false end
    local bb = adornee and adornee:FindFirstChild("CarLabel")
	if bb then
		bb.Line3.Text = "ТВОЯ МАШИНА"
		bb.Line3.TextColor3 = Color3.fromRGB(120, 220, 255)
	end
end

-- Вернуть машину в пул
function CarFactory.release(model)
	if not model or not model.Parent and not model:GetAttribute("PoolId") then
		return
	end
	local id = model:GetAttribute("PoolId")
	local list = pool[id]
	if not list then
		list = {}
		pool[id] = list
	end
	if #list &gt;= MAX_POOL_PER_CAR then
		model:Destroy()
		return
	end
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
            d.Anchored = true
            d.CanCollide = false
        end
    end
    model:SetAttribute("State", nil)
	model:SetAttribute("LockedBy", nil)
	model:SetAttribute("OwnerId", nil)
	model:SetAttribute("SlotIndex", nil)
	model:SetAttribute("DriverId", nil)
	model.Parent = poolFolder
	table.insert(list, model)
end

return CarFactory
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX18">
          <Properties>
            <string name="Name">ParkingService</string>
            <ProtectedString name="Source">-- ModuleScript: ServerScriptService/Services/ParkingService
-- Расставляет машины на парковках загруженных районов, следит за состоянием мест,
-- пополняет их через 10-20 секунд после угона.
--
-- API для этапа 4 (угон):
--   ParkingService.onPromptTriggered(function(player, car) ... end)
--   ParkingService.tryLock(car, player) -&gt; bool   (true = машина была свободна и теперь «занята»)
--   ParkingService.unlock(car)                    (взлом не удался: снова свободна)
--   ParkingService.consume(car) -&gt; info | nil     (угнана: место освобождено, запущено пополнение)
--   ParkingService.recycle(car)                   (машина доставлена: вернуть в пул)
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")

local Settings = require(Shared.Config.Settings)
local Districts = require(Shared.Config.Districts)
local CarClasses = require(Shared.Config.CarClasses)
local Cars = require(Shared.Config.Cars)
local Rarity = require(Shared.Rarity)
local HackRequirements = require(Shared.Config.HackRequirements)

local CarFactory = require(script.Parent.CarFactory)
local DistrictManager = require(script.Parent.DistrictManager)

local ParkingService = {}

local rng = Random.new()
local active = {}   -- [districtIndex] = { model, carsFolder, slots = { slotState } }
local carSlot = {}  -- [carModel] = slotState (пока машина стоит на месте)
local promptCbs = {}
local stolenFolder

----------------------------------------------------------------------
-- Выбор случайной машины
----------------------------------------------------------------------
local function rollVariant()
	local total = 0
	for _, v in ipairs(Cars.Variants) do
		total += v.weight
	end
	local pick = rng:NextNumber() * total
	for _, v in ipairs(Cars.Variants) do
		pick -= v.weight
		if pick &lt;= 0 then
			return v
		end
	end
	return Cars.Variants[1]
end

local function spawnInSlot(slot)
	if slot.dead or slot.car then
		return
	end
	local info = active[slot.district]
	if not info then
		return
	end

	local classId = Districts[slot.district].carClass
	local list = Cars.ByClass[classId]
	if not list or #list == 0 then
		warn("[ParkingService] нет машин класса " .. tostring(classId))
		return
	end

	local carDef = list[rng:NextInteger(1, #list)]
	local rarity = Rarity.roll(CarClasses[classId].rarityWeights, rng)
    -- Guaranteed approachable first target on foot for every new player.
    -- Only the first slot in district one is fixed; other cars remain randomized.
    if slot.district == 1 and slot.part:GetAttribute("Index") == 1 then
        for _, def in ipairs(list) do
            if def.id == "rusty_hatch" then carDef = def break end
        end
        rarity = "common"
    end
	local variant = rollVariant()

	local car = CarFactory.acquire(carDef, classId)

    -- Clear any temporary event decorations when a pooled vehicle respawns.
    car:SetAttribute("RoadVIPId", nil)
    car:SetAttribute("RoadVIPBonus", nil)
    local vipGlow=car:FindFirstChild("RoadVIPGlow")
    if vipGlow then vipGlow:Destroy() end
    local anchor=car.PrimaryPart or car:FindFirstChildWhichIsA("BasePart", true)
    if anchor then
        local oldLabel=anchor:FindFirstChild("RoadVIPLabel")
        if oldLabel then oldLabel:Destroy() end
    end
	CarFactory.dress(car, carDef, classId, rarity, variant.id, rng)
    car:SetAttribute("RequiredHack", HackRequirements.get(slot.district, carDef, rarity))
    car:SetAttribute("BodyStyle", carDef.shape or "sedan")
    local isStarter = slot.district == 1 and slot.part:GetAttribute("Index") == 1
    car:SetAttribute("TutorialStarter", isStarter)
    local label = car:FindFirstChild("CarLabel", true)
    if label then
        local line = label:FindFirstChild("Line3")
        if line and line:IsA("TextLabel") then
            line.Text = isStarter and "ПЕРВЫЙ УГОН · УР. 1" or ("Взлом %d+"):format(car:GetAttribute("RequiredHack"))
            line.TextColor3 = isStarter and Color3.fromRGB(104,255,173) or Color3.fromRGB(212,220,230)
        end
    end
    local prompt = car:FindFirstChild("StealPrompt", true)
    if prompt and isStarter then
        prompt.ActionText = "Начать первый угон"
        prompt.ObjectText = "Piko 90 · учебная машина"
    end
	car:SetAttribute("DistrictIndex", slot.district)
	car:SetAttribute("State", "available")
	car:SetAttribute("LockedBy", nil)
    car:SetAttribute("DriverId", nil) -- pooled cars are never tied to a former driver
    car:SetAttribute("RecoverCooldownUntil", nil)
	CarFactory.setBusy(car, false)

	local pos = slot.part.Position
	local side = slot.part:GetAttribute("Side") or 1
	car:PivotTo(CFrame.new(pos.X, 0.25, pos.Z) * CFrame.Angles(0, side == 1 and 0 or math.pi, 0))
	car.Parent = info.carsFolder

	slot.car = car
	carSlot[car] = slot
end

local function scheduleRespawn(slot)
	local delay = rng:NextNumber(Settings.ParkingRespawnDelay[1], Settings.ParkingRespawnDelay[2])
	local token = {}
	slot.token = token
	task.delay(delay, function()
		if slot.token ~= token or slot.dead then
			return
		end
		spawnInSlot(slot)
	end)
end

----------------------------------------------------------------------
-- Районы: появились / исчезли
----------------------------------------------------------------------
local function onDistrictLoaded(index, model)
	local slotsFolder = model:FindFirstChild("ParkSlots")
	if not slotsFolder then
		return
	end
	local carsFolder = Instance.new("Folder")
	carsFolder.Name = "Cars"
	carsFolder.Parent = model

	local info = { model = model, carsFolder = carsFolder, slots = {} }
	active[index] = info

	for _, part in ipairs(slotsFolder:GetChildren()) do
		table.insert(info.slots, { part = part, district = index, dead = false })
	end

	-- расставляем по одной, чтобы не было скачка нагрузки
	task.spawn(function()
		for _, slot in ipairs(info.slots) do
			if slot.dead then
				break
			end
			spawnInSlot(slot)
			task.wait(0.05)
		end
	end)
end

local function onDistrictUnloaded(index, model)
	local info = active[index]
	active[index] = nil
	if not info then
		return
	end
	for _, slot in ipairs(info.slots) do
		slot.dead = true
		slot.token = nil
		if slot.car then
			carSlot[slot.car] = nil
			CarFactory.release(slot.car)
			slot.car = nil
		end
	end
end

----------------------------------------------------------------------
-- API
----------------------------------------------------------------------
function ParkingService.onPromptTriggered(cb)
	table.insert(promptCbs, cb)
end

function ParkingService.tryLock(car, player)
	if not car or car:GetAttribute("State") ~= "available" or not carSlot[car] then
		return false
	end
	car:SetAttribute("State", "busy")
	car:SetAttribute("LockedBy", player and player.UserId or 0)
	CarFactory.setBusy(car, true)
	return true
end

function ParkingService.unlock(car)
	if car and carSlot[car] and car:GetAttribute("State") == "busy" then
		car:SetAttribute("State", "available")
		car:SetAttribute("LockedBy", nil)
		CarFactory.setBusy(car, false)
	end
end

function ParkingService.consume(car)
	local slot = carSlot[car]
	if not slot then
		return nil
	end
	local info = {
		carId = car:GetAttribute("CarId"),
		classId = car:GetAttribute("ClassId"),
		rarity = car:GetAttribute("Rarity"),
		variantId = car:GetAttribute("Variant"),
        vipBonus = (car:GetAttribute("RoadVIPId") and tonumber(car:GetAttribute("RoadVIPBonus"))) or 0,
		districtIndex = slot.district,
	}
	carSlot[car] = nil
	slot.car = nil
	car:SetAttribute("State", "stolen")
	car.Parent = stolenFolder -- чтобы не удалиться вместе с районом
	if not slot.dead then
		scheduleRespawn(slot)
	end
	return info
end

-- Read-only collection of cars which are truly available to steal.
function ParkingService.getAvailableCars(districtIndex)
    local result={}
    local rec=active[districtIndex]
    if not rec then return result end
    for _,slot in ipairs(rec.slots) do
        local car=slot.car
        if car and car.Parent and car:GetAttribute("State")=="available" then
            table.insert(result,car)
        end
    end
    return result
end

function ParkingService.recycle(car)
	CarFactory.release(car)
end

function ParkingService.init()
	stolenFolder = Instance.new("Folder")
	stolenFolder.Name = "StolenCars"
	stolenFolder.Parent = Workspace

	CarFactory.setPromptHandler("available", function(player, car)
		for _, cb in ipairs(promptCbs) do
			task.spawn(cb, player, car)
		end
	end)

	DistrictManager.onLoaded(onDistrictLoaded)
	DistrictManager.onUnloaded(onDistrictUnloaded)
end

return ParkingService
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX19">
          <Properties>
            <string name="Name">Net</string>
            <ProtectedString name="Source">-- ModuleScript: ServerScriptService/Services/Net
-- RemoteEvent'ы между сервером и клиентом.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = {}

function Net.init()
	local folder = Instance.new("Folder")
	folder.Name = "Remotes"
	for _, name in ipairs({ "HackStart", "HackResult", "HackTap", "HackStep", "DriveInput", "RecoverCar", "Notify", "PinCar", "LootReveal", "BuyUpgrade", "CurrencyUpdate", "ShowTop100", "BuyCoinUpgrade", "ManageWorkshop", "OpenEconomyNPC", "BuyVIP", "CosmeticAction", "CosmeticUpdate", "TutorialAction", "TutorialUpdate" }) do
		local e = Instance.new("RemoteEvent")
		e.Name = name
		e.Parent = folder
		Net[name] = e
	end
    local top=Instance.new("RemoteFunction")
    top.Name="GetSeasonTop"
    top.Parent=folder
    Net.GetSeasonTop=top
	local f = Instance.new("RemoteFunction")
	f.Name = "GetMenuData"
	f.Parent = folder
	Net.GetMenuData = f
	folder.Parent = ReplicatedStorage
end

-- kind: "info" | "good" | "bad" | "closehack"
function Net.notify(player, text, kind)
	if Net.Notify and player and player.Parent then
		Net.Notify:FireClient(player, text, kind or "info")
	end
end

return Net
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX20">
          <Properties>
            <string name="Name">DriveService</string>
            <ProtectedString name="Source">-- Steal60 v15: server-controlled planar arcade vehicle movement.
-- No physical suspension/wheel collision = no sidewalk trampoline or wall-climbing.
-- Model PivotTo moves an upright anchored presentation car; the player sits in a VehicleSeat.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local RS = game:GetService("ReplicatedStorage")
local Shared = RS:WaitForChild("Shared")
local Settings = require(Shared.Config.Settings)
local Layout = require(Shared.TrackLayout)
local Monetization = require(script.Parent.MonetizationService)
local Net = require(script.Parent.Net)
local DriveService = {}
local active = {}
local started = false
local COOLDOWN = 45

local function bodyOf(car)
    return car and (car:FindFirstChild("Body",true) or car.PrimaryPart)
end
local function horizontal(v)
    local p = Vector3.new(v.X,0,v.Z)
    return p.Magnitude &gt; 0.01 and p.Unit or Vector3.xAxis
end
local function moveBody(car, body, newBodyCF)
    -- All visual parts are welded to the ONE anchored Body during a ride.
    -- Replicate just the root rigid assembly instead of 100+ CFrames/step.
    if car.Parent and body.Parent then body.CFrame=newBodyCF end
end
local function cfAt(pos, forward)
    local right = horizontal(forward)
    return CFrame.fromMatrix(pos,right,Vector3.yAxis)
end

-- Swept 2D AABB collision for KINEMATIC cars. A visible barrier or cone stops
-- the car just before contact, even when the car advances many studs per frame.
-- No physical impulse, bounce, or dangerous interaction with Roblox physics.
local function sweptBlock(fromPos,toPos,obstacle)
    local expandX=obstacle.Size.X*.5+2.6
    local expandZ=obstacle.Size.Z*.5+2.4
    local bx,bz=obstacle.Position.X,obstacle.Position.Z
    local fx,fz=fromPos.X-bx,fromPos.Z-bz
    local tx,tz=toPos.X-bx,toPos.Z-bz
    -- Permit a vehicle already inside the boundary to ESCAPE, but not push
    -- further into the obstacle.
    local inside=math.abs(fx)&lt;=expandX and math.abs(fz)&lt;=expandZ
    if inside then
        local distBefore=math.max(math.abs(fx)/expandX,math.abs(fz)/expandZ)
        local distAfter=math.max(math.abs(tx)/expandX,math.abs(tz)/expandZ)
        return distAfter&lt;distBefore-.005
    end
    local tMin,tMax=0,1
    local function slab(start,delta,extent)
        if math.abs(delta)&lt;.00001 then
            return math.abs(start)&lt;=extent
        end
        local a=(-extent-start)/delta
        local b=(extent-start)/delta
        if a&gt;b then a,b=b,a end
        tMin=math.max(tMin,a)
        tMax=math.min(tMax,b)
        return tMin&lt;=tMax
    end
    if not slab(fx,tx-fx,expandX) then return false end
    if not slab(fz,tz-fz,expandZ) then return false end
    return tMin&lt;=1 and tMax&gt;=0
end

-- Light temporary cones are toppled by a nearby moving car instead of forming a wall.
local function knockCones(fromPos,toPos,forward,speed)
    if math.abs(speed)&lt;7 then return end
    for _,cone in ipairs(CollectionService:GetTagged("S60KnockdownCone")) do
        if cone:IsA("BasePart") and cone.Parent and cone.Anchored and
            math.abs(cone.Position.X-toPos.X)&lt;5.0 and
            math.abs(cone.Position.Z-toPos.Z)&lt;4.8 then
            -- One launch per cone, rate-limited by changing Anchored immediately.
            cone.Anchored=false
            cone.CanCollide=true
            cone.CanTouch=true
            local mass=math.max(.1,cone.AssemblyMass)
            local side=(cone.Position.Z-toPos.Z)&gt;=0 and 1 or -1
            cone:ApplyImpulse((horizontal(forward)*48 + Vector3.new(0,28,side*20))*mass)
            cone:ApplyAngularImpulse(Vector3.new(9,side*25,13)*mass)
            task.delay(4,function()
                if cone.Parent then
                    cone.Anchored=true
                    cone.CanCollide=false
                    cone.CanTouch=false
                end
            end)
        end
    end
end

local function isRoadBlocked(current,candidate)
    for _,obstacle in ipairs(CollectionService:GetTagged("S60DriveObstacle")) do
        if obstacle:IsA("BasePart") and obstacle.Parent and not CollectionService:HasTag(obstacle,"S60KnockdownCone") and
           math.abs(current.X-obstacle.Position.X)&lt;75 and
           math.abs(current.Z-obstacle.Position.Z)&lt;40 and
           sweptBlock(current,candidate,obstacle) then
            return true
        end
    end
    return false
end
function DriveService.maxSpeedFor(data, player)
    local lvl=((data and data.upgrades and data.upgrades.speed) or 0) + .33*((data and data.coinUpgrades and data.coinUpgrades.speed) or 0)
    local raw=Settings.Drive.BaseSpeed+Settings.Drive.SpeedPerLevel*lvl
    return math.min(Settings.MaxCarSpeed,raw*(player and Monetization.speedMultiplier(player) or 1))
end
function DriveService.disable(car)
    if not car then return end
    local state=active[car]
    active[car]=nil
    local rig=car:FindFirstChild("DriveRig")
    local root=bodyOf(car)
    local retry=root and root:FindFirstChild("ReEnterStolenCar")
    if retry then retry:Destroy() end
    if rig then
        local seat=rig:FindFirstChild("DriverSeat")
        if seat and seat:IsA("VehicleSeat") and seat.Occupant then
            seat.Occupant.Sit=false
        end
        rig:Destroy()
    end
    local body=bodyOf(car)
    if body then
        local attachment=body:FindFirstChild("DriveAtt")
        if attachment then attachment:Destroy() end
    end
    for _,d in ipairs(car:GetDescendants()) do
        if d:IsA("BasePart") then
            d.AssemblyLinearVelocity=Vector3.zero
            d.AssemblyAngularVelocity=Vector3.zero
            d.Anchored=true
            d.CanCollide=false -- display/pooled cars never apply physics forces
            d.CanTouch=false
            d.CustomPhysicalProperties=nil
        end
    end
    car:SetAttribute("Drivable",nil)
    car:SetAttribute("MaxSpeed",nil)
    car:SetAttribute("ArcadeSpeed",nil)
end
function DriveService.enable(car,maxSpeed)
    local body=bodyOf(car)
    if not body or not body:IsA("BasePart") then return nil end
    DriveService.disable(car)
    local rig=Instance.new("Folder")
    rig.Name="DriveRig"
    rig.Parent=car
    local seat=Instance.new("VehicleSeat")
    seat.Name="DriverSeat"
    seat.Size=Vector3.new(1.8,.75,1.8)
    seat.CFrame=body.CFrame*CFrame.new(-body.Size.X*.06,-body.Size.Y*.06,0)*CFrame.Angles(0,-math.pi/2,0)
    seat.Transparency=1
    seat.CanCollide=false
    seat.CanTouch=false
    seat.HeadsUpDisplay=false
    seat.Anchored=true
    seat.MaxSpeed=0
    seat.Torque=0
    seat.Parent=rig
    -- Re-entry: the stolen car remains reserved for its thief until delivered.
    -- A vehicle with an empty seat offers a short E prompt to the same player.
    local reenter=Instance.new("ProximityPrompt")
    reenter.Name="ReEnterStolenCar"
    reenter.ActionText="Сесть за руль"
    reenter.ObjectText="Твоя текущая машина"
    reenter.KeyboardKeyCode=Enum.KeyCode.E
    reenter.HoldDuration=0
    reenter.MaxActivationDistance=10
    reenter.RequiresLineOfSight=false
    reenter.UIOffset=Vector2.new(0,-38)
    reenter.Enabled=false
    reenter.Parent=body
    local function updateReentry()
        if reenter.Parent then
            reenter.Enabled=seat.Parent~=nil and seat.Occupant==nil
        end
    end
    seat:GetPropertyChangedSignal("Occupant"):Connect(updateReentry)
    reenter.Triggered:Connect(function(player)
        if not player or not player.Parent or not car.Parent then return end
        if car:GetAttribute("DriverId")~=player.UserId then return end
        if seat.Occupant or not seat.Parent then return end
        local character=player.Character
        local hum=character and character:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health&lt;=0 or hum.SeatPart then return end
        local rootPart=character:FindFirstChild("HumanoidRootPart")
        if not rootPart or (rootPart.Position-body.Position).Magnitude&gt;16 then return end
        character:PivotTo(seat.CFrame*CFrame.new(0,2.3,0))
        seat:Sit(hum)
        task.delay(.25,function()
            if seat.Parent and hum.Parent and not seat.Occupant and not hum.Sit then
                seat:Sit(hum)
            end
        end)
    end)
    -- A SINGLE anchored presentation assembly; seat and geometry are rigidly
    -- attached to Body. No physics suspension or collisions with scenery.
    local axleGroups={}
    for _,part in ipairs(car:GetDescendants()) do
        if part:IsA("BasePart") and part~=body then
            part.CanCollide=false
            part.CanTouch=false
            part.Massless=true
            local wheelId=part:GetAttribute("WheelAssembly")
            if wheelId and part~=seat then
                axleGroups[wheelId]=axleGroups[wheelId] or {}
                table.insert(axleGroups[wheelId],part)
            else
                local weld=Instance.new("WeldConstraint")
                weld.Name="CarRigidMount";weld.Part0=body;weld.Part1=part;weld.Parent=rig
                part.Anchored=false
            end
        end
    end
    local steered={}
    for wheelId,parts in pairs(axleGroups) do
        local front=string.sub(wheelId,1,1)=="F"
        local axleCenter=parts[1]:GetAttribute("WheelAssemblyCenter")
        if typeof(axleCenter)=="Vector3" then
            local pivot=Instance.new("Part")
            pivot.Name="WheelPivot_"..wheelId
            pivot.Size=Vector3.new(.12,.12,.12)
            pivot.Transparency=1;pivot.CanCollide=false;pivot.CanTouch=false
            pivot.Massless=true
            pivot.CFrame=car:GetPivot()*CFrame.new(axleCenter)
            pivot.Anchored=false
            pivot.Parent=rig
            local motor=Instance.new("Motor6D")
            motor.Name="SteeringMotor_"..wheelId
            motor.Part0=body;motor.Part1=pivot
            motor.C0=body.CFrame:ToObjectSpace(pivot.CFrame)
            motor.C1=CFrame.identity
            motor.Parent=rig
            for _,part in ipairs(parts) do
                local weld=Instance.new("WeldConstraint")
                weld.Name="WheelRigidMount";weld.Part0=pivot;weld.Part1=part
                weld.Parent=rig
                part.Anchored=false
            end
            if front then table.insert(steered,{motor=motor,base=motor.C0}) end
        else
            for _,part in ipairs(parts) do
                local weld=Instance.new("WeldConstraint")
                weld.Part0=body;weld.Part1=part;weld.Parent=rig
                part.Anchored=false
            end
        end
    end
    body.Anchored=true
    body.CanCollide=false
    car:SetAttribute("Drivable",true)
    car:SetAttribute("MaxSpeed",maxSpeed)
    car:SetAttribute("ArcadeSpeed",0)
    active[car]={body=body,seat=seat,forward=horizontal(body.CFrame.RightVector),speed=0,
        throttle=0,steer=0,lastInput=0,ownerId=tonumber(car:GetAttribute("DriverId")),
        maxSpeed=math.clamp(maxSpeed or 60,10,Settings.MaxCarSpeed),
        lockedY=math.clamp(body.Position.Y,0.85,4.5),lastRecovery=-math.huge,
        wheelMotors=steered,visualSteer=0}
    return seat
end

local function rescue(player,car,automatic)
    local state=active[car]
    if not state or not car.Parent or not player or not player.Parent then return end
    if tonumber(car:GetAttribute("DriverId"))~=player.UserId or state.ownerId~=player.UserId then return end
    local occupant=state.seat.Occupant
    if not occupant or occupant.Parent~=player.Character then return end
    if os.clock()-state.lastRecovery &lt; (automatic and 7 or COOLDOWN) then return end
    if not automatic and math.abs(state.speed)&gt;9 then
        Net.notify(player,"Останови машину перед восстановлением.","info")
        return
    end
    local pos=state.body.Position
    local lim=pos.X &lt; Settings.Track.SalonZoneLength and 43.5 or 28.5
    local safe=Vector3.new(math.clamp(pos.X,-45,Layout.trackEnd()-9),state.lockedY,math.clamp(pos.Z,-lim,lim))
    moveBody(car,state.body,cfAt(safe,state.forward))
    state.speed=0
    car:SetAttribute("ArcadeSpeed",0)
    state.throttle=0
    state.steer=0
    state.lastRecovery=os.clock()
    Net.notify(player,"Машина ровно стоит на дороге.","good")
end

function DriveService.init()
    if started then return end
    started=true
    Net.RecoverCar.OnServerEvent:Connect(function(player,car)
        if typeof(car)=="Instance" and car:IsA("Model") then rescue(player,car,false) end
    end)
    Net.DriveInput.OnServerEvent:Connect(function(player,car,throttle,steer)
        if typeof(car)~="Instance" or not car:IsA("Model") then return end
        if typeof(throttle)~="number" or typeof(steer)~="number" then return end
        if throttle~=throttle or steer~=steer then return end
        local s=active[car]
        if not s or not s.seat.Parent then return end
        local occupant=s.seat.Occupant
        if not occupant or occupant.Parent~=player.Character then return end
        s.throttle=math.clamp(throttle,-1,1)
        s.steer=math.clamp(steer,-1,1)
        s.lastInput=os.clock()
    end)
    Players.PlayerRemoving:Connect(function(player)
        for _,s in pairs(active) do
            if s.seat.Occupant and s.seat.Occupant.Parent==player.Character then
                s.throttle=0;s.steer=0
            end
        end
    end)
    RunService.Heartbeat:Connect(function(dt)
        dt=math.min(dt,.07)
        for car,s in pairs(active) do
            if not car.Parent or not s.body.Parent or not s.seat.Parent then
                active[car]=nil
                continue
            end
            local hum=s.seat.Occupant
            local throttle,steer=0,0
            if not hum then
                -- Empty cars stop the instant a player exits or jumps out.
                -- Never continue sliding down the road on their own.
                if s.speed~=0 then
                    s.speed=0
                    car:SetAttribute("ArcadeSpeed",0)
                end
                s.throttle=0
                s.steer=0
                s.lastInput=0
            else
                if os.clock()-s.lastInput&lt;.45 then
                    throttle,steer=s.throttle,s.steer
                else
                    throttle=math.clamp(s.seat.ThrottleFloat,-1,1)
                    steer=math.clamp(s.seat.SteerFloat,-1,1)
                end
            end
            local pos=s.body.Position
            local limit=s.maxSpeed
            local drive=Settings.Drive
            local target=throttle*limit*(throttle&lt;0 and drive.ReverseFactor or 1)
            local accel=throttle==0 and drive.Coast or
                (s.speed*target&lt;0 and drive.Brake or
                (math.abs(target)&gt;math.abs(s.speed) and drive.Accel or drive.Coast))
            s.speed+=math.clamp(target-s.speed,-accel*dt,accel*dt)
            car:SetAttribute("ArcadeSpeed",math.abs(s.speed))
            local grip=math.clamp(math.abs(s.speed)/16,0,1)
            local angle=-steer*drive.TurnRate*grip*dt*(s.speed&gt;=0 and 1 or -1)
            if angle~=0 then
                s.forward=horizontal(CFrame.Angles(0,angle,0):VectorToWorldSpace(s.forward))
            end
            -- Actual modelled front wheel pivots follow input with eased steering.
            local desiredSteer=-math.rad(27)*steer*grip -- visual axle points toward actual turn
            s.visualSteer += (desiredSteer-s.visualSteer)*math.clamp(dt*9,0,1)
            for _,m in ipairs(s.wheelMotors) do
                if m.motor.Parent then
                    m.motor.C0=m.base*CFrame.Angles(0,s.visualSteer,0)
                end
            end
            local shift=s.forward*s.speed*dt
            local candidate=pos+shift
            local maxZ=pos.X &lt; Settings.Track.SalonZoneLength and 43.5 or 28.5
            -- Salon front starts around |Z|=52: cars stop BEFORE the walls and showroom.
            -- District sidewalks begin at |Z|=30: leave them for pedestrians only.
            local cx=math.clamp(candidate.X,-45,Layout.trackEnd()-9)
            local cz=math.clamp(candidate.Z,-maxZ,maxZ)
            local desired=Vector3.new(cx,s.lockedY,cz)
            knockCones(pos,desired,s.forward,s.speed)
            local clamped=desired
            if math.abs(cx-candidate.X)&gt;.005 or math.abs(cz-candidate.Z)&gt;.005 or isRoadBlocked(pos,clamped) then
                -- Contact with a real barricade or roadblock is SOLID in the arcade
                -- controller but light cones are handled separately above.
                s.speed=0
                car:SetAttribute("ArcadeSpeed",0)
                clamped=Vector3.new(pos.X,s.lockedY,pos.Z)
            end
            moveBody(car,s.body,cfAt(clamped,s.forward))
        end
    end)
    print("[Steal60/Drive v15] Kinematic ground-only arcade motion; building and curb jumps disabled")
end
return DriveService
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX21">
          <Properties>
            <string name="Name">OwnerService</string>
            <ProtectedString name="Source">-- ModuleScript: ServerScriptService/Services/OwnerService
-- Владелец машины: выбегает и бежит следом. Формальность и немного комедии, угрозы нет.
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")

local Settings = require(Shared.Config.Settings)
local CarClasses = require(Shared.Config.CarClasses)
local CollisionService = require(script.Parent.CollisionService)
local StyleLib = require(Shared.AvatarStyleLibrary)

local OwnerService = {}
local folder

local OUTFITS = {
    {name="Курьер", top=Color3.fromRGB(225,139,44), pants=Color3.fromRGB(52,65,82), hat="cap", trim=Color3.fromRGB(250,223,68)},
    {name="Бизнесмен", top=Color3.fromRGB(37,59,93), pants=Color3.fromRGB(42,47,63), hat="hair", trim=Color3.fromRGB(238,181,88)},
    {name="Спортсмен", top=Color3.fromRGB(63,181,126), pants=Color3.fromRGB(34,51,61), hat="cap", trim=Color3.fromRGB(233,243,242)},
    {name="Механик", top=Color3.fromRGB(46,106,150), pants=Color3.fromRGB(37,46,61), hat="helmet", trim=Color3.fromRGB(248,181,65)},
    {name="Турист", top=Color3.fromRGB(222,88,106), pants=Color3.fromRGB(85,74,92), hat="glasses", trim=Color3.fromRGB(240,237,214)},
    {name="Музыкант", top=Color3.fromRGB(161,91,201), pants=Color3.fromRGB(37,37,51), hat="hair", trim=Color3.fromRGB(101,225,236)},
    {name="Таксист", top=Color3.fromRGB(229,184,62), pants=Color3.fromRGB(57,76,79), hat="cap", trim=Color3.fromRGB(30,36,41)},
    {name="Охранник", top=Color3.fromRGB(72,82,95), pants=Color3.fromRGB(29,35,45), hat="glasses", trim=Color3.fromRGB(185,218,238)},
}

-- Fallback native details, used only if Avatar Marketplace accessories cannot load.
-- Chasing owners are randomly dressed with genuine Roblox catalog assets; vendors
-- in salons are intentionally NOT touched by this service.
local function decorate(rig, outfit, rng)
    local head = rig:FindFirstChild("Head")
    local torso = rig:FindFirstChild("UpperTorso") or rig:FindFirstChild("Torso")
    if not head or not torso then return end
    local function accessory(name, parentPart, size, offset, color, material, shape)
        local obj = Instance.new("Part")
        obj.Name = name
        obj.Size = size
        obj.Color = color
        obj.Material = material or Enum.Material.SmoothPlastic
        obj.CanCollide = false
        obj.CanTouch = false
        obj.CanQuery = false
        obj.Massless = true
        obj.Anchored = false
        obj.Shape = shape or Enum.PartType.Block
        obj.CFrame = parentPart.CFrame * offset
        obj.Parent = rig
        local weld = Instance.new("WeldConstraint")
        weld.Part0 = parentPart
        weld.Part1 = obj
        weld.Parent = obj
    end
    local dark = Color3.fromRGB(31,36,43)
    if outfit.hat == "cap" then
        accessory("Бейсболка",head,Vector3.new(1.18,.24,1.12),CFrame.new(0,.55,0),outfit.trim)
        accessory("Козырёк",head,Vector3.new(.92,.12,.45),CFrame.new(0,.55,-.66),outfit.trim)
    elseif outfit.hat == "helmet" then
        accessory("Шлем",head,Vector3.new(1.20,.33,1.12),CFrame.new(0,.57,0),outfit.trim)
        accessory("Шлем_забрало",head,Vector3.new(.98,.12,.22),CFrame.new(0,.24,-.56),dark)
    elseif outfit.hat == "hair" then
        accessory("Причёска",head,Vector3.new(1.14,.22,1.08),CFrame.new(0,.57,0),dark)
        accessory("Чёлка",head,Vector3.new(.76,.19,.19),CFrame.new(.08,.38,-.55),dark)
    else
        accessory("Очки",head,Vector3.new(1.06,.20,.15),CFrame.new(0,.07,-.55),dark)
        accessory("Дужка_очков",head,Vector3.new(.18,.08,.18),CFrame.new(0,.08,-.66),outfit.trim)
    end
    accessory("Нашивка",torso,Vector3.new(.58,.26,.10),CFrame.new(-.39,.18,-.40),outfit.trim,Enum.Material.Neon)
    if rng:NextNumber() &lt; .55 then
        accessory("Бейдж",torso,Vector3.new(.40,.27,.12),CFrame.new(.43,.20,-.43),Color3.fromRGB(229,230,219))
    end
    if rng:NextNumber() &lt; .40 then
        accessory("Рюкзак",torso,Vector3.new(1.3,1.3,.54),CFrame.new(0,-.07,.57),dark)
    end
end

-- Curated REAL Roblox Marketplace accessory IDs (original UGC items).
-- These are worn ONLY by temporary NPCs. We do not sell, clone or award assets.
-- Existing catalog selections from the source pack. Availability is checked by Roblox at runtime; IDs are editable here.
local ROBLOX_LOOKS={
 {name="Ночной рейсер", hair=8022080793, face=4258680288},
 {name="Кибер-хакер", hair=10376943185, face=138940480674278},
 {name="Модный угонщик", hair=17725600471, face=8263758282},
 {name="Тёмный агент", hair=14266974567, face=42847660},
 {name="Уличный гонщик", hair=96893826772238, face=125369932},
 {name="Ночной музыкант", hair=89315454377282, face=4258680288},
 {name="Техно-пилот", hair=126560380902288, face=138940480674278},
 {name="Кибер-охотник", hair=8022080793, face=11536969456},
}
-- Source pack catalog jacket selections: 96961653426478 = Tactical Techwear Vest,
-- 17638739844 = Techwear Jacket - Red, 71576448094265 = Blue Techwear Zip Up.
-- They belong to third-party creators; assets are requested from Roblox at runtime.
local VENDOR_STYLES={
 coins={look=2,jacket=96961653426478,primary=Color3.fromRGB(63,191,145),seed=101,silhouette="street",name="Мятный механик"},
 diamonds={look=4,jacket=71576448094265,primary=Color3.fromRGB(75,177,242),seed=202,silhouette="royal",name="Алмазный ведущий"},
 workshop={look=7,jacket=17638739844,primary=Color3.fromRGB(255,174,74),seed=303,silhouette="pilot",name="Турбо-мастер"},
 cosmetics={look=3,jacket=71576448094265,primary=Color3.fromRGB(192,125,242),seed=404,silhouette="astral",name="Звёздный стилист"},
}
local vendorTemplates={}
local vendorLoading={}
local lastMarketLook=0
local lastFallbackProfile=0
local function chooseMarketLook(rng)
 local n=rng:NextInteger(1,#ROBLOX_LOOKS)
 if #ROBLOX_LOOKS&gt;1 and n==lastMarketLook then
  n=n%#ROBLOX_LOOKS+1
 end
 lastMarketLook=n
 return ROBLOX_LOOKS[n]
end
local function applyMarketLook(desc,look)
 if not look then return end
 if look.hair then desc.HairAccessory=tostring(look.hair) end
 if look.face then desc.FaceAccessory=tostring(look.face) end
end
local function createAvatar(desc)
 local ok,rig=pcall(function()
  return Players:CreateHumanoidModelFromDescriptionAsync(desc,Enum.HumanoidRigType.R15)
 end)
 if not ok or not rig then return nil,false end
 local hasRealAccessory=false
 for _,child in ipairs(rig:GetChildren()) do
  if child:IsA("Accessory") then hasRealAccessory=true;break end
 end
 return rig,hasRealAccessory
end
local function makeRig(desc)
 local rig,marketOK=createAvatar(desc)
 if rig and marketOK then return rig,true end
 if rig then rig:Destroy() end
 -- One unavailable layered item must not prevent hair and face assets loading.
 pcall(function() desc:SetAccessories({},false) end)
 rig,marketOK=createAvatar(desc)
 if rig and marketOK then return rig,true end
 if rig then rig:Destroy() end
 desc.HairAccessory=""
 desc.FaceAccessory=""
 desc.HatAccessory=""
 desc.BackAccessory=""
 rig=createAvatar(desc)
 return rig,false
end

local PHRASES = {
	"Эй! Это моя машина!",
	"Стой! Я только за кофе вышел!",
	"Верни тачку, я опаздываю!",
	"Ой! Мои ключи!",
	"Подожди-ка! Там мой обед!",
}

function OwnerService.init()
	folder = Instance.new("Folder")
	folder.Name = "Owners"
	folder.Parent = Workspace
end

-- Простой NPC-человечек (yields). Возвращает Model или nil
function OwnerService.newRig(topColor,role)
 local style=role and VENDOR_STYLES[role]
 local rng=style and Random.new(style.seed) or Random.new()
 if style and vendorTemplates[role] then
  return vendorTemplates[role]:Clone()
 end
 if style and vendorLoading[role] then
  local deadline=os.clock()+15
  while vendorLoading[role] and os.clock()&lt;deadline do task.wait(.12) end
  if vendorTemplates[role] then return vendorTemplates[role]:Clone() end
 end
 if style then vendorLoading[role]=true end
 local desc=Instance.new("HumanoidDescription")
 desc.TorsoColor=topColor or (style and style.primary) or Color3.fromRGB(62,113,154)
 desc.LeftLegColor=Color3.fromRGB(40,48,66)
 desc.RightLegColor=Color3.fromRGB(40,48,66)
 desc.HeadColor=Color3.fromRGB(234,189,151)
 desc.LeftArmColor=desc.HeadColor
 desc.RightArmColor=desc.HeadColor
 local look=style and ROBLOX_LOOKS[style.look] or chooseMarketLook(rng)
 applyMarketLook(desc,look)
 if style and style.jacket then
  -- A genuine paid layered-clothing item, not a neon box in its place.
  pcall(function()
   desc:SetAccessories({{AssetId=style.jacket,AccessoryType=Enum.AccessoryType.Jacket,Order=1}},false)
  end)
 end
 local rig,marketOK=makeRig(desc)
 if rig then
  if not marketOK then
   warn("[Steal60 NPC] Roblox Avatar Shop accessories unavailable for "..tostring(role or "owner").."; used local fallback.")
   if style then
    StyleLib.apply(rig,{color=style.primary,accent=Color3.fromRGB(255,236,159),silhouette=style.silhouette,tier=3},{npc=true})
   else
    StyleLib.applyNPC(rig,rng)
   end
  end
  if style then StyleLib.applyVendorSignature(rig,role) end
  rig:SetAttribute("MarketplaceLook",marketOK)
  rig:SetAttribute("AppearanceRole",role or "owner")
  if style then rig:SetAttribute("AppearanceName",style.name) end
  if style and marketOK then
   -- Base NPC is reusable, each salon receives its own copy.
   rig.Archivable=true
   vendorTemplates[role]=rig:Clone()
  end
 end
 if style then vendorLoading[role]=nil end
 return rig
end

-- Reuse exactly the catalog loading pipeline already used by garage NPCs.
function OwnerService.catalogRig(profile)
 if profile.role then return OwnerService.newRig(nil,profile.role)end
 local desc=Instance.new("HumanoidDescription")
 desc.HeadColor=Color3.fromRGB(234,189,151);desc.LeftArmColor=desc.HeadColor;desc.RightArmColor=desc.HeadColor
 desc.TorsoColor=profile.color or Color3.fromRGB(55,83,106)
 desc.LeftLegColor=profile.pantsColor or Color3.fromRGB(35,43,60);desc.RightLegColor=desc.LeftLegColor
 applyMarketLook(desc,profile)
 if profile.hat then desc.HatAccessory=tostring(profile.hat)end
 if profile.jacket then desc:SetAccessories({{AssetId=profile.jacket,AccessoryType=Enum.AccessoryType.Jacket,Order=1}},false)end
 -- Shop previews must be the complete advertised look. NPC fallback rules do not apply here.
 local rig=createAvatar(desc);desc:Destroy()
 if not rig then return nil end
 local expected=(profile.hair and 1 or 0)+(profile.face and 1 or 0)+(profile.hat and 1 or 0)+(profile.jacket and 1 or 0)
 local actual=0
 for _,obj in ipairs(rig:GetChildren())do if obj:IsA('Accessory')then actual+=1 end end
 if actual&lt;expected then rig:Destroy();return nil end
 rig:SetAttribute('MarketplaceLook',true);rig:SetAttribute('RequiredCatalogAccessories',expected)
 return rig
end

function OwnerService.addBubble(rig, text)
	local head = rig:FindFirstChild("Head")
	if not head then
		return
	end
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(200, 40)
	bb.StudsOffset = Vector3.new(0, 3, 0)
	bb.Adornee = head
	bb.Parent = head
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundColor3 = Color3.new(1, 1, 1)
	label.BackgroundTransparency = 0.1
	label.TextColor3 = Color3.fromRGB(30, 30, 30)
	label.Font = Enum.Font.GothamBold
	label.TextScaled = true
	label.Text = text
	label.Parent = bb
	local corner = Instance.new("UICorner")
	corner.Parent = label
end

function OwnerService.spawn(car, classId)
	task.spawn(function()
		local rng = Random.new()
		local pos = car:GetPivot().Position
		local side = pos.Z &gt;= 0 and 1 or -1

		local desc = Instance.new("HumanoidDescription")
		local skin = Color3.fromHSV(rng:NextNumber(0.05, 0.1), rng:NextNumber(0.2, 0.5), rng:NextNumber(0.7, 1))
        local outfit = OUTFITS[rng:NextInteger(1, #OUTFITS)]
        desc.HeadColor = skin
        desc.LeftArmColor = skin
        desc.RightArmColor = skin
        desc.TorsoColor = outfit.top
        desc.LeftLegColor = outfit.pants
        desc.RightLegColor = outfit.pants
        desc.HeightScale = rng:NextNumber(.90,1.10)
        desc.WidthScale = rng:NextNumber(.88,1.08)
        desc.HeadScale = rng:NextNumber(.94,1.08)

        -- Pick a fresh premium-accessory combination EVERY spawn.
        local look=chooseMarketLook(rng)
        -- Independently mix real catalog hair and face accessories with clothing colours.
        local faceLook=ROBLOX_LOOKS[rng:NextInteger(1,#ROBLOX_LOOKS)]
        applyMarketLook(desc,{hair=look.hair,face=faceLook.face})
        local rig,marketOK=makeRig(desc)
        if not rig then return end

        rig.Name = "Владелец · " .. look.name
        rig:PivotTo(CFrame.new(pos.X + rng:NextNumber(-4,4), 4, side * 35))
        rig.Parent = folder
        -- Verify that Roblox actually attached a Catalog accessory.
        -- If unavailable, switch to the local original NPC costume.
        if not marketOK then
         local count=#StyleLib.NpcProfiles
         local profile=rng:NextInteger(1,count)
         if count&gt;1 and profile==lastFallbackProfile then profile=profile%count+1 end
         lastFallbackProfile=profile
         local profession=StyleLib.applyNPC(rig,rng,profile)
         rig.Name="Владелец · "..profession
        end
        rig:SetAttribute("MarketplaceLook",marketOK)
        rig:SetAttribute("AppearanceRole","owner")
        CollisionService.applyPlayer(rig)

		local hum = rig:FindFirstChildOfClass("Humanoid")
		local hrp = rig:FindFirstChild("HumanoidRootPart")
		if not hum or not hrp then
			rig:Destroy()
			return
		end
        hum.WalkSpeed = math.max(12, (CarClasses[classId] and CarClasses[classId].ownerSpeed) or 12)
		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		pcall(function()
			hrp:SetNetworkOwner(nil)
		end)

		local head = rig:FindFirstChild("Head")
		if head then
			local bb = Instance.new("BillboardGui")
			bb.Size = UDim2.fromOffset(200, 40)
			bb.StudsOffset = Vector3.new(0, 3, 0)
			bb.Adornee = head
			bb.Parent = head
			local label = Instance.new("TextLabel")
			label.Size = UDim2.fromScale(1, 1)
			label.BackgroundColor3 = Color3.new(1, 1, 1)
			label.BackgroundTransparency = 0.1
			label.TextColor3 = Color3.fromRGB(30, 30, 30)
			label.Font = Enum.Font.GothamBold
			label.TextScaled = true
			label.Text = PHRASES[rng:NextInteger(1, #PHRASES)]
			label.Parent = bb
			local corner = Instance.new("UICorner")
			corner.Parent = label
		end

		local t0 = os.clock()
		while os.clock() - t0 &lt; Settings.Steal.OwnerChaseTime and car.Parent and rig.Parent do
			hum:MoveTo(car:GetPivot().Position)
			task.wait(0.3)
		end
		rig:Destroy()
	end)
end

return OwnerService
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX22">
          <Properties>
            <string name="Name">PoliceService</string>
            <ProtectedString name="Source">-- ModuleScript: ServerScriptService/Services/PoliceService
-- Полиция: приезжает к игроку, который сработал сигнализацию, и отводит его на старт.
-- Без оружия и насилия: просто патрульная машина с мигалкой.
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")

local Settings = require(Shared.Config.Settings)
local Layout = require(Shared.TrackLayout)
local P = require(script.Parent.TrackParts)

local PoliceService = {}
local folder

local RED = Color3.fromRGB(255, 40, 40)
local BLUE = Color3.fromRGB(50, 90, 255)
local DARK = Color3.fromRGB(40, 40, 50)

local function buildCar()
    local m = Instance.new("Model")
    m.Name = "Полиция · Patrol GT"
    local white = Color3.fromRGB(225,233,239)
    local blue = Color3.fromRGB(27,48,86)
    local navy = Color3.fromRGB(21,30,47)
    local steel = Color3.fromRGB(111,135,148)
    local glass = Color3.fromRGB(37,67,95)
    local function piece(name,size,pos,color,material)
        local part = P.part(m,name,size,pos,color,material or Enum.Material.SmoothPlastic,false)
        part.CastShadow = true
        return part
    end
    piece("Undercarriage",Vector3.new(12.2,.47,5.8),Vector3.new(0,.84,0),navy,Enum.Material.Metal)
    piece("LowerBody",Vector3.new(12.1,1.35,5.85),Vector3.new(0,1.68,0),white)
    piece("Hood",Vector3.new(3.9,.36,5.45),Vector3.new(4.0,2.53,0),white)
    piece("Trunk",Vector3.new(2.3,.38,5.42),Vector3.new(-4.8,2.55,0),white)
    piece("Roof",Vector3.new(4.9,.25,4.4),Vector3.new(-.65,4.25,0),white)
    piece("CabinDark",Vector3.new(4.7,1.44,4.40),Vector3.new(-.55,3.40,0),glass,Enum.Material.Glass).Transparency=.18
    piece("Windshield",Vector3.new(.19,1.20,4.25),CFrame.new(1.93,3.34,0)*CFrame.Angles(0,0,math.rad(24)),glass,Enum.Material.Glass).Transparency=.16
    piece("RearWindow",Vector3.new(.18,1.12,4.12),CFrame.new(-3.04,3.37,0)*CFrame.Angles(0,0,math.rad(-24)),glass,Enum.Material.Glass).Transparency=.17
    for _,side in ipairs({-1,1}) do
        piece("SatinSideStripe",Vector3.new(11.6,.48,.12),Vector3.new(0,1.71,side*2.96),blue,Enum.Material.Metal)
        piece("DoorBlackBelt",Vector3.new(4.7,.11,.18),Vector3.new(-.55,2.61,side*2.96),navy,Enum.Material.Metal)
        piece("SideWindow",Vector3.new(3.96,.90,.12),Vector3.new(-.60,3.48,side*2.23),glass,Enum.Material.Glass).Transparency=.13
        piece("B_Pillar",Vector3.new(.15,1.09,.18),Vector3.new(-1.30,3.51,side*2.30),navy,Enum.Material.Metal)
        piece("SideMirror",Vector3.new(.62,.28,.50),Vector3.new(1.69,2.94,side*2.68),navy,Enum.Material.Metal)
        piece("FrontFender",Vector3.new(2.35,.64,.33),Vector3.new(3.28,1.92,side*2.88),white)
        piece("RearFender",Vector3.new(1.90,.65,.33),Vector3.new(-4.05,1.92,side*2.88),white)
        for _,wx in ipairs({-3.73,3.62}) do
            local tire = piece("SportTire",Vector3.new(.90,1.85,1.85),CFrame.new(wx,.95,side*3.0)*CFrame.Angles(0,math.pi/2,0),Color3.fromRGB(24,28,34))
            tire.Shape = Enum.PartType.Cylinder
            local rim = piece("ForgedRim",Vector3.new(.95,1.14,1.14),CFrame.new(wx,.95,side*3.44)*CFrame.Angles(0,math.pi/2,0),steel,Enum.Material.Metal)
            rim.Shape = Enum.PartType.Cylinder
            local center = piece("Hub",Vector3.new(.98,.33,.33),CFrame.new(wx,.95,side*3.52)*CFrame.Angles(0,math.pi/2,0),navy,Enum.Material.Metal)
            center.Shape = Enum.PartType.Cylinder
        end
        piece("WhiteHeadlight",Vector3.new(.16,.38,1.65),Vector3.new(6.15,2.08,side*1.92),Color3.fromRGB(198,237,250),Enum.Material.Neon)
        piece("RedTaillight",Vector3.new(.16,.35,1.60),Vector3.new(-6.16,2.20,side*1.92),Color3.fromRGB(252,62,68),Enum.Material.Neon)
        piece("SideDoorHandle",Vector3.new(.50,.10,.12),Vector3.new(-.65,2.65,side*3.03),steel,Enum.Material.Metal)
    end
    piece("PushBumper",Vector3.new(.40,.64,4.5),Vector3.new(6.31,1.10,0),navy,Enum.Material.Metal)
    piece("FrontAirGrille",Vector3.new(.20,.60,3.0),Vector3.new(6.19,1.70,0),navy,Enum.Material.Metal)
    piece("RearDiffuser",Vector3.new(.28,.42,4.1),Vector3.new(-6.20,1.12,0),navy,Enum.Material.Metal)
    local red = piece("RedLight",Vector3.new(1.1,.30,1.28),Vector3.new(-.65,4.60,1.00),RED,Enum.Material.Neon)
    local blueLight = piece("BlueLight",Vector3.new(1.1,.30,1.28),Vector3.new(-.65,4.60,-1.00),BLUE,Enum.Material.Neon)
    piece("LightbarFrame",Vector3.new(1.25,.14,3.4),Vector3.new(-.65,4.44,0),navy,Enum.Material.Metal)
    -- Clear signage with no external images. 3D-native SurfaceGui on side panels.
    for _,side in ipairs({-1,1}) do
        local labelPart = piece("PatrolBadge",Vector3.new(2.35,.58,.14),Vector3.new(-.18,1.77,side*3.06),navy,Enum.Material.Metal)
        local gui = Instance.new("SurfaceGui")
        gui.Face = side == 1 and Enum.NormalId.Front or Enum.NormalId.Back
        gui.LightInfluence = 0
        gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
        gui.PixelsPerStud = 18
        gui.Parent = labelPart
        local label = Instance.new("TextLabel")
        label.BackgroundTransparency=1
        label.Size=UDim2.fromScale(1,1)
        label.Text="PATROL 60"
        label.Font=Enum.Font.GothamBlack
        label.TextScaled=true
        label.TextColor3=white
        label.Parent=gui
    end
    m.WorldPivot = CFrame.new()
    return m
end

function PoliceService.init()
	folder = Instance.new("Folder")
	folder.Name = "PoliceCars"
	folder.Parent = Workspace
end

-- onDone вызывается, когда полиция «поймала» игрока
function PoliceService.dispatch(player, onDone)
	task.spawn(function()
		task.wait(Settings.Steal.PoliceDelay)
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if not hrp then
			onDone()
			return
		end

		local px = hrp.Position.X
		local startX = px + 260
		if startX &gt; Layout.trackEnd() - 20 then
			startX = px - 260
		end
		local startPos = Vector3.new(startX, 0.25, math.clamp(hrp.Position.Z, -14, 14))

		local car = buildCar()
		car:PivotTo(CFrame.new(startPos))
		car.Parent = folder
		local red, blue = car:FindFirstChild("RedLight"), car:FindFirstChild("BlueLight")

		local alive = true
		task.spawn(function()
			local flip = false
			while alive and car.Parent do
				flip = not flip
				red.Color = flip and RED or DARK
				blue.Color = flip and DARK or BLUE
				task.wait(0.2)
			end
		end)

		local started = os.clock()
		local arrested = false
		local conn
		conn = RunService.Heartbeat:Connect(function(dt)
			if arrested then
				return
			end
			local h = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			if not h or not car.Parent or os.clock() - started &gt; 25 then
				arrested = true
				conn:Disconnect()
				alive = false
				car:Destroy()
				onDone()
				return
			end
			local cur = car:GetPivot().Position
			local flat = Vector3.new(h.Position.X - cur.X, 0, h.Position.Z - cur.Z)
			if flat.Magnitude &lt; 9 then
				arrested = true
				conn:Disconnect()
				task.spawn(function()
					task.wait(1)
					onDone()
					task.wait(1.5)
					alive = false
					car:Destroy()
				end)
				return
			end
			local dir = flat.Unit
			local newPos = Vector3.new(cur.X + dir.X * Settings.Steal.PoliceSpeed * dt, 0.25, cur.Z + dir.Z * Settings.Steal.PoliceSpeed * dt)
			-- перед модели = +X, поэтому поворачиваем на 90 градусов
			car:PivotTo(CFrame.lookAt(newPos, newPos + dir) * CFrame.Angles(0, math.pi / 2, 0))
		end)
	end)
end

return PoliceService
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX23">
          <Properties>
            <string name="Name">DeliveryService</string>
            <ProtectedString name="Source">-- ModuleScript: ServerScriptService/Services/DeliveryService
-- Следит за угнанными машинами: доставка в зону салонов, брошенные, упавшие.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")

local Settings = require(Shared.Config.Settings)
local DriveService = require(script.Parent.DriveService)
local ParkingService = require(script.Parent.ParkingService)
local Net = require(script.Parent.Net)
local HeistService = require(script.Parent.HeistService)

local DeliveryService = {}

-- Deliveries are PERSONAL. Only the server-assigned pad for this player counts.
local stolen = {} -- [car] = {player, info, startedAt, lastOccupied, parkedSince, busy, ...}
local destinations = {} -- [player] = {center=Vector3, side=1/-1, plot=number}
local deliveredCbs = {}

local function seatOf(car)
    return car:FindFirstChildWhichIsA("VehicleSeat", true)
end

function DeliveryService.setDestination(player, center, side, plot)
    assert(typeof(center) == "Vector3", "Delivery pad must be a server Vector3")
    destinations[player] = { center=center, side=side &gt;= 0 and 1 or -1, plot=plot }
    player:SetAttribute("DeliveryX", center.X)
    player:SetAttribute("DeliveryZ", center.Z)
    player:SetAttribute("DeliveryPlot", plot)
end

function DeliveryService.clearDestination(player)
    destinations[player] = nil
    player:SetAttribute("DeliveryX", nil)
    player:SetAttribute("DeliveryZ", nil)
    player:SetAttribute("DeliveryPlot", nil)
end

-- Never teleport an owner who already exited and is walking on foot.
-- Only extract them when seated inside the specific car being recycled.
local function releasePlayer(player, car, nearPos)
    local char=player and player.Character
    local hum=char and char:FindFirstChildOfClass("Humanoid")
    local seat=hum and hum.SeatPart
    if not seat or not seat:IsDescendantOf(car) then return end
    hum.Sit=false
    hum.Jump=true
    task.wait(.15)
    if char and char.Parent and nearPos then
        char:PivotTo(CFrame.new(nearPos.X,math.max(3.5,nearPos.Y),nearPos.Z))
    end
end

-- 30x16 studs: use the exact dimensions of the visible green delivery outline.
-- Test all four body corners rather than a car's front bumper or arbitrary
-- model pivot. The small tolerance covers thin protruding decorative trim.
local function bodyInsideDeliveryBay(car,dest)
    local body=car:FindFirstChild("Body",true) or car.PrimaryPart
    if not body or not body:IsA("BasePart") then return false,nil end
    local pos=body.Position
    if pos.Y &lt; -10 or pos.Y &gt; 12 then return false,body end
    local halfLength=body.Size.X*.5+.15
    local halfWidth=body.Size.Z*.5+.15
    local cf=body.CFrame
    for _,sx in ipairs({-1,1}) do
        for _,sz in ipairs({-1,1}) do
            local corner=cf:PointToWorldSpace(Vector3.new(sx*halfLength,0,sz*halfWidth))
            if math.abs(corner.X-dest.center.X)&gt;14.9 or
                math.abs(corner.Z-dest.center.Z)&gt;7.9 then
                return false,body
            end
        end
    end
    return true,body
end

local function finish(car, rec, delivered, message, kind)
    stolen[car] = nil
    if delivered then
        rec.info.tripSeconds = math.max(0, os.clock() - rec.startedAt)
        rec.info.tripDistance = rec.tripDistance
        rec.info.tripSpeed = rec.tripSpeed
        rec.info.roadGates = math.clamp(tonumber(car:GetAttribute("RoadGateCount")) or 0, 0, 2)
        rec.info.policePassed = car:GetAttribute("PoliceEventPassed") == true
    else
        HeistService.onFailed(rec.player)
    end
    if rec.player and rec.player.Parent then rec.player:SetAttribute("HeistCarrying", false) end
    local pos = car:GetPivot().Position
    local target = rec.destination
    local exitPos = nil
    if delivered and target then
        exitPos = Vector3.new(target.center.X + 4, 4, target.center.Z + target.side * 11)
    elseif pos.Y &gt; -20 then
        exitPos = Vector3.new(pos.X, 4, pos.Z + (pos.Z &gt;= 0 and 6 or -6))
    end
    releasePlayer(rec.player, car, exitPos)
    DriveService.disable(car)
    ParkingService.recycle(car)
    if delivered then
        for _, cb in ipairs(deliveredCbs) do
            task.spawn(cb, rec.player, rec.info)
        end
    elseif message then
        Net.notify(rec.player, message, kind or "bad")
    end
end

function DeliveryService.track(car, player, info)
    local startX = car:GetPivot().Position.X
    for i = 1, 5 do car:SetAttribute("RoadGate_" .. i, nil) end
    car:SetAttribute("RoadGateCount", 0)
    car:SetAttribute("PoliceEventPassed", nil)
    stolen[car] = {
        player=player, info=info, lastOccupied=os.clock(),
        startedAt=os.clock(), tripDistance=math.max(0, startX - Settings.Track.SalonZoneLength),
        tripSpeed=tonumber(car:GetAttribute("MaxSpeed")) or Settings.Drive.BaseSpeed,
        destination=destinations[player], parkedSince=nil, busy=false,
    }
    local dest = destinations[player]
    if dest then
        Net.notify(player, ("ВЕЗИ МАШИНУ В САЛОН №%d! ПОЛНОСТЬЮ ПОСТАВЬ ЕЁ В ЗЕЛЁНУЮ РАМКУ И ОСТАНОВИСЬ. ВЫХОДИТЬ МОЖНО!"):format(dest.plot), "info")
    end
end

function DeliveryService.getCarrying(player)
	for car, rec in pairs(stolen) do
		if rec.player == player then
			return car
		end
	end
	return nil
end

-- cb(player, info): машина доставлена в зону салонов
function DeliveryService.onDelivered(cb)
	table.insert(deliveredCbs, cb)
end

function DeliveryService.init()
    Players.PlayerRemoving:Connect(function(player)
        destinations[player] = nil
        for car, rec in pairs(stolen) do
            if rec.player == player and not rec.busy then
                rec.busy = true
                task.spawn(finish, car, rec, false, nil)
            end
        end
    end)

    task.spawn(function()
        while true do
            task.wait(0.20)
            local now = os.clock()
            for car, rec in pairs(stolen) do
                if rec.busy then continue end
                if not car.Parent or not rec.player.Parent then
                    rec.busy = true
                    stolen[car] = nil
                    if car.Parent then task.spawn(finish, car, rec, false, nil) end
                    continue
                end
                local pos = car:GetPivot().Position
                local seat = seatOf(car)
                local driverHum = seat and seat.Occupant
                local isOwnerDriving = driverHum ~= nil and driverHum.Parent == rec.player.Character
                if isOwnerDriving then rec.lastOccupied = now end

                if pos.Y &lt; -50 then
                    rec.busy = true
                    task.spawn(finish, car, rec, false, "Машина упала с трассы. Попробуй другую!")
                elseif now - rec.lastOccupied &gt; Settings.Steal.AbandonTimeout then
                    rec.busy = true
                    task.spawn(finish, car, rec, false, "Ты бросил машину, и её забрали.")
                else
                    -- The tracked vehicle (not its driver) earns the delivery.
                    -- A stopped car entirely in the owner's outlined pad counts
                    -- whether the owner is seated OR has stepped away.
                    local dest=destinations[rec.player] or rec.destination
                    if dest then
                        local inPad,body=bodyInsideDeliveryBay(car,dest)
                        local v=body and body.AssemblyLinearVelocity or Vector3.zero
                        local physicalSpeed=Vector3.new(v.X,0,v.Z).Magnitude
                        local arcadeSpeed=math.abs(tonumber(car:GetAttribute("ArcadeSpeed")) or 0)
                        local parked=inPad and math.max(physicalSpeed,arcadeSpeed)&lt;=5
                        if parked then
                            if not rec.parkedSince then rec.parkedSince=now end
                            if now-rec.parkedSince&gt;=.65 then
                                rec.busy=true
                                task.spawn(finish,car,rec,true)
                            end
                        else
                            rec.parkedSince=nil
                        end
                    end
                end
            end
        end
    end)
    print("[Steal60/Delivery] Сдача автомобиля без водителя: рамка парковки, остановка 0.65 сек")
end

return DeliveryService
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX24">
          <Properties>
            <string name="Name">HackService</string>
            <ProtectedString name="Source">-- Steal60 V5. Three lock types, authoritative server-time tap validation.
-- The player sends only TAP/CANCEL; never trusts client-computed hit times.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Settings = require(Shared.Config.Settings)
local HackMath = require(Shared.HackMath)

local Services = script.Parent
local Net = require(Services.Net)
local DataService = require(Services.DataService)
local ParkingService = require(Services.ParkingService)
local DriveService = require(Services.DriveService)
local OwnerService = require(Services.OwnerService)
local PoliceService = require(Services.PoliceService)
local DeliveryService = require(Services.DeliveryService)
local SalonService = require(Services.SalonService)
local Monetization = require(Services.MonetizationService)
local HeistService = require(Services.HeistService)

local Tutorial=require(Services.TutorialService)
local HackService = {}
local rng = Random.new()
local sessions = {} -- player -&gt; live server-authoritative session
local policePending = {} -- player -&gt; prevent duplicate dispatch, fine and respawn

-- Variety without difficulty spikes: maximum 3 interactions per vehicle.
-- 10-12% quicker cursor and slightly narrower target than v25; mistakes stay soft.
local DIFFICULTY = {
    junk    = {rounds=1, width=.48, period=2.50, pool={"pins","wires"}},
    regular = {rounds=2, width=.44, period=2.38, pool={"pins","wires","dial","signal"}},
    sport   = {rounds=2, width=.41, period=2.30, pool={"dial","wires","signal","pins"}},
    premium = {rounds=2, width=.39, period=2.24, pool={"dial","signal","wires","pins"}},
    super   = {rounds=3, width=.37, period=2.31, pool={"signal","wires","dial","pins"}},
}
-- Deterministic rotating variety, so all four puzzles appear naturally.
-- Previously fully random selection could hide the fourth puzzle indefinitely.
local lastMode = {}
local modeCursor = {}
local MODE_CYCLE={"pins","wires","dial","signal"}
local function planModes(player, diff, tutorial)
    local modes={}
    local previous=lastMode[player]
    local cursor=modeCursor[player] or 0
    local eligible={}
    for _,mode in ipairs(diff.pool) do eligible[mode]=true end
    for i=1,diff.rounds do
        local chosen=nil
        if tutorial and i==1 then
            chosen="pins"
        else
            for step=1,#MODE_CYCLE do
                local idx=((cursor+step-1)%#MODE_CYCLE)+1
                local mode=MODE_CYCLE[idx]
                if eligible[mode] and mode~=previous then
                    chosen=mode
                    cursor=idx
                    break
                end
            end
        end
        if not chosen then chosen=diff.pool[1] end
        modes[i]=chosen
        previous=chosen
    end
    modeCursor[player]=cursor
    lastMode[player]=previous
    return modes
end
local SPAWN_POS = CFrame.new(15, 4, 0)

local function flashAlarm(car, seconds)
    if not car or not car.Parent then return end
    local highlight = car:FindFirstChild("RarityHighlight")
    local oldColor = highlight and highlight.OutlineColor
    local oldEnabled = highlight and highlight.Enabled
    task.spawn(function()
        local started = os.clock()
        local flip = false
        while os.clock() - started &lt; seconds and car.Parent do
            flip = not flip
            if highlight then
                highlight.Enabled = true
                highlight.OutlineColor = flip and Color3.fromRGB(255, 45, 58) or Color3.fromRGB(255, 180, 55)
            end
            task.wait(.17)
        end
        if highlight and highlight.Parent then
            highlight.Enabled = oldEnabled
            highlight.OutlineColor = oldColor
        end
    end)
end

local function caughtByPolice(player)
    if policePending[player] then return end
    policePending[player] = true
    PoliceService.dispatch(player, function()
        if not player.Parent then policePending[player] = nil return end
        local data = DataService.get(player)
        local fine = 0
        if data then
            data.penaltyUntil = os.time() + Settings.AlarmPenaltySeconds
            -- Small, capped fine comes from wallet only; no negative balances.
            fine = math.min(2500, math.floor(math.max(0, data.money or 0) * .04))
            if fine &gt; 0 then DataService.spendMoney(player, fine) end
        end
        local character = player.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if humanoid then humanoid.Sit = false humanoid.Jump = true end
        -- A personal ride must NOT respawn with the arrested avatar in its seat.
        SalonService.onArrested(player)
        Tutorial.event(player,"heist_failed")
        player:LoadCharacter()
        task.delay(.20, function()
            if player.Parent and player.Character and player.Character.Parent then
                player.Character:PivotTo(SPAWN_POS)
            end
        end)
        Net.notify(player, ("ПОЛИЦИЯ: штраф %d $! Возрождение пешком. Взлом закрыт на %d сек."):format(fine, Settings.AlarmPenaltySeconds), "bad")
        policePending[player] = nil
    end)
end

local function alarmFlow(player, car, required)
    HeistService.onFailed(player)
    Net.notify(player, ("Недостаточно навыка (нужен уровень %d). Сработала сигнализация!"):format(required), "bad")
    flashAlarm(car, Settings.Steal.AlarmSeconds)
    task.delay(Settings.Steal.AlarmSeconds, function()
        if car and car.Parent then ParkingService.unlock(car) end
    end)
    caughtByPolice(player)
end

local function successFlow(player, car, quality, mode)
    local data = DataService.get(player)
    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not data or not hum or hum.Health &lt;= 0 then
        ParkingService.unlock(car)
        return
    end
    local info = ParkingService.consume(car)
    if not info then
        Net.notify(player, "Эту машину уже забрали.", "bad")
        return
    end
    car:SetAttribute("DriverId", player.UserId) -- required for secure recovery and cleanup
    local seat = DriveService.enable(car, DriveService.maxSpeedFor(data, player))
    if not seat then
        ParkingService.recycle(car)
        return
    end
    car:SetAttribute("LockQuality", quality)
    car:SetAttribute("HackStyle", mode)
    info.lockQuality = quality
    DeliveryService.track(car, player, info)
    player:SetAttribute("HeistCarrying", true)
    Tutorial.event(player,"hack_success")
    OwnerService.spawn(car, info.classId)
    -- Move the avatar next to the stolen vehicle seat before seating.
    char:PivotTo(seat.CFrame * CFrame.new(0, 2.3, 0))
    seat:Sit(hum)
    task.delay(.30, function()
        if seat.Parent and hum.Parent and hum.SeatPart ~= seat and not hum.Sit then
            seat:Sit(hum)
        end
    end)
    local rating = quality &gt;= .81 and "ИДЕАЛЬНО" or (quality &gt;= .55 and "ЧИСТЫЙ ВЗЛОМ" or "ЗАМОК ОТКРЫТ")
    Net.notify(player, rating .. "! ДОВЕЗИ МАШИНУ ДО ЗЕЛЁНОЙ ПАРКОВКИ СВОЕГО САЛОНА и остановись.", "good")
end

local function zoneFor(diff, mode)
    if mode=="wires" then
        return {c=.5,w=1,target=rng:NextInteger(1,3)} -- server checks the chosen color
    end
    local half=diff.width/2
    return {c=rng:NextNumber(half+.08,1-half-.08),w=diff.width}
end

local function sendStep(player, session, state, quality)
    if not player.Parent then return end
    Net.HackStep:FireClient(player, {
        state = state,
        round = session.round,
        rounds = session.diff.rounds,
        period = session.diff.period,
        mode = session.modes[session.round],
        zone = session.zones[session.round],
        startAt = session.roundStart,
        strikes = session.strikes,
        helpLevel = session.roundMisses,
        quality = quality,
    })
end

local function failSession(player, session, why)
    if sessions[player] ~= session then return end
    sessions[player] = nil
    local car = session.car
    HeistService.onFailed(player)
    local data = DataService.get(player)
    Tutorial.event(player,"heist_failed")
    Net.HackStep:FireClient(player, { state = "alarm", reason = why or "Сигнализация!" })
    Net.notify(player, why or "Сигнализация! Повтори попытку позже.", "bad")
    flashAlarm(car, 3.5)
    task.delay(2.5, function()
        if car and car.Parent then ParkingService.unlock(car) end
    end)
    -- Failure during an active mini-game never summons police. Skill-level
    -- gating (before the mini-game) retains the original alarm/police mechanic.
end

local function startMinigame(player, car)
    local classId = car:GetAttribute("ClassId")
    local diff = DIFFICULTY[classId] or DIFFICULTY.regular
    local data = DataService.get(player)
    local modes=planModes(player,diff,Tutorial.isFirstHeist(player))
    local zones={}
    for i=1,diff.rounds do zones[i]=zoneFor(diff,modes[i]) end
    local session = {
        car = car, zones = zones, modes=modes, diff = diff, startedAt = os.clock(),
        round = 1, roundStart = workspace:GetServerTimeNow() + .85,
        strikes = 0, roundMisses = 0, sumQuality = 0, lastTap = 0,
    }
    sessions[player] = session
    Tutorial.event(player,"hack_started")

    -- Starts helper return only once, at beginning of new target's hacking.
    SalonService.onHackStarted(player)
    Net.HackStart:FireClient(player, {
        carName = car.Name,
        mode = modes[1],
        round = 1,
        rounds = diff.rounds,
        period = diff.period,
        zone = zones[1],
        startAt = session.roundStart,
        strikes = 0,
        helpLevel = 0,
    })

    -- Safety cleanup only. Ordinary mistimed taps NEVER fail the session.
    task.delay(math.max(120, Settings.Steal.SessionTimeout), function()
        if sessions[player] == session then
            failSession(player, session, "Время взлома вышло. Попробуй другую машину.")
        end
    end)
end

local function onPrompt(player, car)
    local data = DataService.get(player)
    if not data or sessions[player] then return end
    if DeliveryService.getCarrying(player) then
        Net.notify(player, "Сначала доставь угнанную машину!", "bad")
        return
    end
    local blocked = (data.penaltyUntil or 0) - os.time()
    if blocked &gt; 0 then
        Net.notify(player, ("Взлом снова станет доступен через %d с."):format(blocked), "bad")
        return
    end
    local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not root or (root.Position - car:GetPivot().Position).Magnitude &gt; 25 then return end
    if not ParkingService.tryLock(car, player) then
        Net.notify(player, "Машину уже взламывают.", "bad")
        return
    end
    local required = car:GetAttribute("RequiredHack") or 1
    local effective = data.hackLevel + Monetization.hackBonus(player)
    if effective &lt; required and (data.masterKeyTokens or 0) &gt; 0 then
        data.masterKeyTokens -= 1
        Net.notify(player, "Использована одноразовая отмычка.", "good")
        startMinigame(player, car)
    elseif effective &lt; required then
        alarmFlow(player, car, required)
    else
        startMinigame(player, car)
    end
end

local function onTap(player, action)
    local wireChoice=tonumber(type(action)=="string" and action:match("^wire_([123])$") or nil)
    if action ~= "tap" and action ~= "cancel" and not wireChoice then return end
    local s = sessions[player]
    if not s then return end
    local car = s.car
    if action == "cancel" then
        sessions[player] = nil
        local data = DataService.get(player)
        Tutorial.event(player,"heist_failed")
        if car and car.Parent then ParkingService.unlock(car) end
        Net.HackStep:FireClient(player, { state = "cancelled" })
        return
    end
    if not car or not car.Parent or car:GetAttribute("LockedBy") ~= player.UserId then
        failSession(player, s, "Машина недоступна.")
        return
    end
    local char = player.Character
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root or not humanoid or humanoid.Health &lt;= 0 or (root.Position - car:GetPivot().Position).Magnitude &gt; 27 then
        failSession(player, s, "Ты отошёл слишком далеко от замка.")
        return
    end

    local now = workspace:GetServerTimeNow()
    if now &lt; s.roundStart or now - s.lastTap &lt; .17 then return end
    s.lastTap = now
    local t = now - s.roundStart
    local z = s.zones[s.round]
    -- Validate against SERVER time; clients never submit hit positions.
    -- On the fourth tap of a difficult round, built-in assistance guarantees
    -- progress (low precision score), so newcomers are never stuck indefinitely.
    local currentMode=s.modes[s.round]
    if currentMode=="wires" and not wireChoice then return end
    if currentMode~="wires" and wireChoice then return end
    local ok,accuracy
    if currentMode=="wires" then
        ok=(wireChoice==z.target)
        accuracy=ok and 1 or 0
    else
        ok,accuracy=HackMath.accuracy(t,s.diff.period,currentMode,s.round,z.c,z.w,.045)
    end
    local assisted = (not ok) and s.roundMisses &gt;= 3 and t &gt;= .25
    if ok or assisted then
        local earnedQuality = assisted and .24 or (.52 + .48 * accuracy)
        s.sumQuality += earnedQuality
        s.roundMisses = 0
        if s.round &gt;= s.diff.rounds then
            sessions[player] = nil
            local quality = math.clamp(s.sumQuality / s.diff.rounds * (1 - .025 * math.min(s.strikes, 5)), 0, 1)
            Net.HackStep:FireClient(player, { state="success", quality=quality })
            successFlow(player, car, quality, currentMode)
        else
            s.round += 1
            -- A short pause shows the round change clearly and prevents rapid accidental taps.
            s.roundStart = now + 1.10
            sendStep(player, s, "next", earnedQuality)
        end
    else
        -- Soft miss: no alarm, no police, no lost progress. Make target wider.
        s.strikes += 1
        s.roundMisses += 1
        if currentMode ~= "wires" then
            local nextZone=zoneFor(s.diff,currentMode)
            nextZone.w=math.min(.67,s.diff.width+.085*s.roundMisses)
            nextZone.c=math.clamp(nextZone.c,nextZone.w/2+.035,1-nextZone.w/2-.035)
            s.zones[s.round]=nextZone
        end
        s.roundStart = now + .48
        sendStep(player, s, "retry", 0)
    end
end

function HackService.init()
    ParkingService.onPromptTriggered(onPrompt)
    Net.HackTap.OnServerEvent:Connect(onTap)
    -- Old HackResult endpoint is deliberately no longer accepted for rewards.
    Players.PlayerRemoving:Connect(function(player)
        policePending[player] = nil
        lastMode[player] = nil
        local session = sessions[player]
        if session then
            sessions[player] = nil
            if session.car and session.car.Parent then ParkingService.unlock(session.car) end
        end
    end)
end
return HackService
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX25">
          <Properties>
            <string name="Name">BotService</string>
            <ProtectedString name="Source">-- ModuleScript: ServerScriptService/Services/BotService
-- Бот-соучастник: забирает машину, на которой игрок приехал, и сам возвращает её в салон.
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")

local Services = script.Parent
local DriveService = require(Services.DriveService)
local OwnerService = require(Services.OwnerService)
local CollisionService = require(Services.CollisionService)

local BotService = {}
local folder

function BotService.init()
	folder = Instance.new("Folder")
	folder.Name = "Bots"
	folder.Parent = Workspace
end

-- dest = { x = центр участка по X, laneZ = полоса, final = Vector3 у входа в салон }
-- onArrive() вызывается, когда машина доехала
function BotService.returnCar(car, dest, speed, onArrive)
	task.spawn(function()
		DriveService.disable(car)
		car:SetAttribute("State", "ride_return")
		local pos = car:GetPivot().Position

		-- помощник подбегает к машине и «садится»
		local rig = OwnerService.newRig(Color3.fromRGB(60, 70, 90))
		if rig then
			rig.Name = "Помощник"
			rig:PivotTo(CFrame.new(pos.X + 8, 4, pos.Z + (pos.Z &gt;= 0 and -10 or 10)))
			rig.Parent = folder
			CollisionService.applyPlayer(rig)
			OwnerService.addBubble(rig, "Я заберу машину!")
			local hum = rig:FindFirstChildOfClass("Humanoid")
			local hrp = rig:FindFirstChild("HumanoidRootPart")
			if hum and hrp then
				hum.WalkSpeed = 24
				hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
				pcall(function()
					hrp:SetNetworkOwner(nil)
				end)
				hum:MoveTo(pos)
				local t0 = os.clock()
				while os.clock() - t0 &lt; 3 and rig.Parent and (hrp.Position - pos).Magnitude &gt; 7 do
					task.wait(0.1)
				end
			end
			rig:Destroy()
		end

		if car:GetAttribute("State") ~= "ride_return" then
			return -- машину уже убрали
		end

		-- едем: на свою полосу, вдоль трассы к салону, к входу
		local waypoints = {
			Vector3.new(pos.X, 0.25, dest.laneZ),
			Vector3.new(dest.x, 0.25, dest.laneZ),
			dest.final,
		}
		local cur = pos
		local dir = Vector3.new(-1, 0, 0)
		for _, wp in ipairs(waypoints) do
			while true do
				if car:GetAttribute("State") ~= "ride_return" then
					return
				end
				local dt = RunService.Heartbeat:Wait()
				local flat = Vector3.new(wp.X - cur.X, 0, wp.Z - cur.Z)
				local stepLen = speed * dt
				if flat.Magnitude &lt;= stepLen then
					cur = wp
					car:PivotTo(CFrame.lookAt(cur, cur + dir) * CFrame.Angles(0, math.pi / 2, 0))
					break
				end
				dir = flat.Unit
				cur = Vector3.new(cur.X + dir.X * stepLen, wp.Y, cur.Z + dir.Z * stepLen)
				car:PivotTo(CFrame.lookAt(cur, cur + dir) * CFrame.Angles(0, math.pi / 2, 0))
			end
		end

		if car:GetAttribute("State") == "ride_return" then
			onArrive()
		end
	end)
end

return BotService
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX26">
          <Properties>
            <string name="Name">ThiefService</string>
            <ProtectedString name="Source">-- A thief enters through the front, stops at the register, and retreats along the visited route.
local Workspace=game:GetService('Workspace')
local Tween=game:GetService('TweenService')
local Services=script.Parent
local Net=require(Services.Net)
local Data=require(Services.DataService)
local Owner=require(Services.OwnerService)
local Collision=require(Services.CollisionService)
local Navigator=require(Services.NPCNavigator)
local Tutorial=require(Services.TutorialService)
local M={};local folder
function M.init()
 folder=Workspace:FindFirstChild('Thieves')or Instance.new('Folder');folder.Name='Thieves';folder.Parent=Workspace
end
local function point(rec,u,v)return Vector3.new(rec.px+u,.55,rec.side*(42+v))end
function M.route(rec)
 -- Street -&gt; central forecourt -&gt; OPEN FACADE -&gt; lobby -&gt; front of the register.
 return {point(rec,-44,-8),point(rec,0,-8),point(rec,0,8),point(rec,0,17),point(rec,3.5,24)}
end
local function performRaid(rec,options)
 options=options or{};local training=options.training==true
 local player=rec.player;local data=Data.get(player)
 if not data or not player.Parent or(not training and(data.till or 0)&lt;50)then return end
 local rig=Owner.newRig(Color3.fromRGB(47,52,72));if not rig then return end
 if not player.Parent then rig:Destroy();return end
 local route=M.route(rec);rig.Name=training and'Учебный воришка'or'Воришка'
 local hum=rig:FindFirstChildOfClass('Humanoid');local root=rig:FindFirstChild('HumanoidRootPart')
 if not hum or not root then rig:Destroy();return end
 rig.PrimaryPart=root
 local rootHeight=hum.HipHeight+root.Size.Y*.5
 rig:PivotTo(CFrame.lookAt(route[1]+Vector3.new(0,rootHeight,0),route[2]+Vector3.new(0,rootHeight,0)))
 rig:SetAttribute('SalonOwnerId',player.UserId);rig:SetAttribute('TrainingRaid',training);rig:SetAttribute('RaidState','approach')
 rig.Parent=folder;Collision.applyPlayer(rig)
 local nav=Navigator.new(rig)
 local security=math.clamp((tonumber((data.upgrades or{}).security)or 0)+(tonumber((data.coinUpgrades or{}).security)or 0),0,5)
 hum.WalkSpeed=math.max(8,13-security*.7);hum.DisplayDistanceType=Enum.HumanoidDisplayDistanceType.None
 Owner.addBubble(rig,training and'Попробуй меня прогнать!'or'Тихо… кажется, касса без присмотра.')
 local prompt=Instance.new('ProximityPrompt');prompt.Name='ChaseThief';prompt.ActionText='Прогнать';prompt.ObjectText=rig.Name
 prompt.HoldDuration=.4;prompt.MaxActivationDistance=10;prompt.RequiresLineOfSight=true;prompt.Parent=root
 local chased=false;local connection
 connection=prompt.Triggered:Connect(function(who)
  if who~=player or chased or not prompt.Enabled or not nav:alive()then return end
  local actor=player.Character and player.Character:FindFirstChild('HumanoidRootPart')
  if not actor or(actor.Position-root.Position).Magnitude&gt;12 then return end
  local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude;params.FilterDescendantsInstances={rig,player.Character};params.RespectCanCollide=true
  if Workspace:Raycast(root.Position,actor.Position-root.Position,params)then return end
  chased=true;Tutorial.event(player,'thief_chased')
 end)
 Net.notify(player,training and'Учебный воришка у входа! Подойди и удерживай E. Касса в безопасности.'or'Воришка крадётся к салону. Перехвати его у входа и прогони E.','info')
 local visited=1;local outcome='gone'
 local function cancel()return chased or not player.Parent end
 for i=2,#route do
  if not nav:go(route[i],cancel,16)then break end;visited=i
 end
 if chased then outcome='chased'
 elseif visited==#route and nav:alive()and player.Parent then
  rig:SetAttribute('RaidState','look');nav:lookAt(rec.tillPos,cancel,.4)
  nav:gesture()
  local begin=os.clock();rig:SetAttribute('RaidState','grab')
  while nav:alive()and not cancel()and os.clock()-begin&lt;1.7 do task.wait(.1)end
  if chased then outcome='chased'elseif nav:alive()and player.Parent then outcome='stolen'end
 end
 prompt.Enabled=false;connection:Disconnect()
 local current=Data.get(player)
 if outcome=='stolen'and current and not training then
  if math.random()&lt;security*.12 then outcome='guard';Owner.addBubble(rig,'Охрана! Ухожу!');Net.notify(player,'Охранник заметил воришку. Касса цела.','good')
  else local loss=math.floor((current.till or 0)*.10);current.till-=loss;Owner.addBubble(rig,'Меня заметили! Бежать!');Net.notify(player,('Воришка забрал %d из кассы. Улучши охрану.'):format(loss),'bad')end
 elseif outcome=='chased'then
  Owner.addBubble(rig,'Ладно-ладно, уже ухожу!')
  if current and not training then local reward=math.max(10,math.floor((current.till or 0)*.02));Data.addMoney(player,reward);Net.notify(player,('Воришка прогнан! +%d $'):format(reward),'good')
  elseif training then Net.notify(player,'Воришка прогнан. Ты защитил салон!','good')end
 elseif training then Net.notify(player,'В учебном налёте касса не пострадала. Воришка вернётся — попробуй удержать E рядом с ним.','info')end
 rig:SetAttribute('RaidState','escape');hum.WalkSpeed=21
 -- Reverse only points already visited. Chasing outside cannot send the thief further indoors.
 for i=visited,1,-1 do if not player.Parent or not nav:go(route[i],function()return not player.Parent end,13)then break end end
 nav:stop();nav:destroy()
 if rig.Parent then
  rig:SetAttribute('RaidState','gone')
  for _,p in ipairs(rig:GetDescendants())do if p:IsA('BasePart')or p:IsA('Decal')then Tween:Create(p,TweenInfo.new(.55),{Transparency=1}):Play()end end
  task.wait(.6);rig:Destroy()
 end
end
function M.raid(rec,options)
 local ok,err=pcall(performRaid,rec,options)
 if not ok then
  if folder then for _,rig in ipairs(folder:GetChildren())do if rig:GetAttribute('SalonOwnerId')==rec.player.UserId then rig:Destroy()end end end
  warn('[Steal60 thief] '..tostring(err))
 end
end
return M
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX27">
          <Properties>
            <string name="Name">SalonService</string>
            <ProtectedString name="Source">-- ModuleScript: ServerScriptService/Services/SalonService
-- Салон игрока: участок, витрина (6 слотов), полки с предметами, касса, пассивный доход,
-- вскрытие угнанной машины («яйцо»), поездка на машине с витрины, бот, воришки, меню.
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")

local Settings = require(Shared.Config.Settings)
local CarClasses = require(Shared.Config.CarClasses)
local Cars = require(Shared.Config.Cars)
local Loot = require(Shared.Config.Loot)
local Rarity = require(Shared.Rarity)

local Services = script.Parent
local Net = require(Services.Net)
local DataService = require(Services.DataService)
local CarFactory = require(Services.CarFactory)
local DriveService = require(Services.DriveService)
local DeliveryService = require(Services.DeliveryService)
local Monetization = require(Services.MonetizationService)
local Upgrade = require(game.ReplicatedStorage.Shared.Config.UpgradeConfig)
local BotService = require(Services.BotService)
local ThiefService = require(Services.ThiefService)
local P = require(Services.TrackParts)
local SalonArt = require(Services.SalonArtDirector)
local OwnerService = require(Services.OwnerService)
local AccessoryConfig = require(Shared.Config.AccessoryConfig)
local CosmeticConfig = require(Shared.Config.CosmeticConfig)
local VIPConfig = require(Shared.Config.VIPConfig)
local CoinUpgrade=require(Shared.Config.CoinUpgradeConfig)

local Tutorial=require(Services.TutorialService)
local SalonService = {}

local rng = Random.new()
local salons = {}     -- [player] = rec
local plotTaken = {}  -- [plotIndex] = player
local salonsFolder, ridesFolder

local VARIANT_ORDER = { "gold", "neon", "retro", "default" }
local VARIANT_MULT = {}
for _, v in ipairs(Cars.Variants) do
	VARIANT_MULT[v.id] = v.incomeMult
end
local RARITY_INDEX = {}
for i, r in ipairs(Rarity.Order) do
	RARITY_INDEX[r] = i
end

-- Позиции слотов витрины в координатах участка: { u (влево-вправо), v (вглубь от дороги) }
-- Six independent 10.5-stud-wide bays in ONE row. Length faces the building,
-- leaving three studs between the widest native cars and no nose-to-tail overlap.
local SLOT_UV = { {-30,0}, {-20,0}, {-10,0}, {10,0}, {20,0}, {30,0} }

-- PvP salon burglary is a short temporary disruption, NOT a permanent transfer.
local THEFT_COOLDOWN = 5 * 60 -- after each successful raid, and after no-reward invalid attempts never consumed
local TARGET_PROTECTION = 5 * 60 -- one victim salon cannot be repeatedly farmed
local HIDE_SECONDS = 10
local MAX_LOSS = 2500  -- max stolen from accumulated till, not from owner's bank balance
local theftBusy = {} -- reentrancy protection per thief
local THEFT_PARTS = AccessoryConfig.List
local function partIncomeBoost(data)
    return AccessoryConfig.totalPct(data) / 100
end

local function theftAttributes(player, data)
    player:SetAttribute("TheftCount", data.theftCount or 0)
    player:SetAttribute("TheftLevel", data.theftLevel or 1)
    player:SetAttribute("TheftCooldownUntil", data.theftNextAt or 0)
    player:SetAttribute("TheftIncomeBoostPct", math.floor(partIncomeBoost(data)*100 + .5))
end

local function fmt(n)
	n = math.floor(n)
	local s = tostring(n)
	local out = s:reverse():gsub("(%d%d%d)", "%1 "):reverse()
	return (out:gsub("^ ", ""))
end

-- Участок: центр по X = rec.px, фасад на |z| = 42, вглубь до |z| = 86
local function toWorld(rec, u, v, y)
	return Vector3.new(rec.px + u, y, rec.side * (42 + v))
end

----------------------------------------------------------------------
-- Данные витрины и дохода
----------------------------------------------------------------------
local function bestVariant(entry)
	for _, id in ipairs(VARIANT_ORDER) do
		if entry.variants and entry.variants[id] then
			return id
		end
	end
	return "default"
end

-- Какие машины стоят на витрине: сначала закреплённые, потом последние угнанные
local function displayList(data, excludeId, player)
	local list = {}
	local used = {}
	local function add(id)
		if  #list &gt;= Monetization.showcaseSlots(player) or used[id] or id == excludeId or not data.catalog[id] then
			return
		end
		used[id] = true
		table.insert(list, id)
	end
	for _, id in ipairs(data.showcase.pinned) do
		add(id)
	end
    -- Never auto-fill by recency: display valuable/rare vehicles first.
    local ranked={}
    for id,entry in pairs(data.catalog) do
        local definition=Cars.ById[id]
        if definition and entry then
            local class=CarClasses[definition.class]
            local value=(class and class.baseValue or 10)
                *(Rarity.Info[entry.bestRarity] and Rarity.Info[entry.bestRarity].incomeMult or 1)
                *(VARIANT_MULT[bestVariant(entry)] or 1)
                *(1+.25*math.max(0,entry.stars or 0))
            ranked[#ranked+1]={id=id,score=value}
        end
    end
    table.sort(ranked,function(a,b)
        if a.score~=b.score then return a.score&gt;b.score end
        return a.id&lt;b.id
    end)
    for _,item in ipairs(ranked) do add(item.id) end
	return list
end

-- v36: shelf slots are fixed, including explicit empty entries. This avoids
-- compacting an array every time a player removes or relocates an item.
local EMPTY_SLOT="__empty"
local STORAGE_MAX=48
local function ensureShelfSlots(data)
    data.shelf=type(data.shelf)=="table" and data.shelf or {}
    data.shelfStorage=type(data.shelfStorage)=="table" and data.shelfStorage or {}
    local capacity=math.max(#data.shelf,math.max(12,math.floor(tonumber(data.shelfCapacity) or 12)))
    for i=#data.shelf+1,capacity do
        data.shelf[i]={id=EMPTY_SLOT}
    end
    return capacity
end
local function emptySlotIndex(data)
    for i=1,ensureShelfSlots(data) do
        local obj=data.shelf[i]
        if not obj or obj.id==EMPTY_SLOT then return i end
    end
    return nil
end
local function storeItem(data,item)
    if #data.shelfStorage&gt;=STORAGE_MAX then return false end
    table.insert(data.shelfStorage,{id=item.id,rarity=item.rarity})
    return true
end

local function computeIncome(data, player)
	local base = 0
	for _, item in ipairs(data.shelf) do
		local def = Loot.ById[item.id]
		if def then
			base += def.income * (1 + 0.20*math.clamp(math.floor(tonumber((data.lootRanks or {})[item.id]) or 0),0,5))
		end
	end

	-- бонус за машины на витрине
	local bonus = 0
	for _, id in ipairs(displayList(data, nil, player)) do
		local entry = data.catalog[id]
		local rMult = Rarity.Info[entry.bestRarity].incomeMult
		local vMult = VARIANT_MULT[bestVariant(entry)] or 1
		bonus += 0.05 * rMult * vMult * (1 + 0.25 * (entry.stars or 0))
	end

	local upgrade = 1 + 0.1 * (data.upgrades.income or 0) + .12 * ((data.coinUpgrades or {}).income or 0)
	local cosmeticBonusPct=CosmeticConfig.coinBonusPct(data)
    return base * (1 + bonus) * upgrade * Monetization.incomeMultiplier(player) * (1 + partIncomeBoost(data) + cosmeticBonusPct/100)
end

-- Money remains in the till indefinitely; ONLY further accumulation is capped.
-- VIP or the separate 48h pass raises the maximum, not the per-second rate.
local function tillCapacity(data,player)
    local hours=Monetization.tillHours(player)
    local rate=math.max(0,computeIncome(data,player))
    return rate*hours*3600,hours,rate
end
local function accrueTill(data,player,seconds,overrideHours)
    seconds=math.max(0,tonumber(seconds) or 0)
    local capacity,hours,rate=tillCapacity(data,player)
    if overrideHours then
        hours=overrideHours
        capacity=math.max(0,rate*hours*3600)
    end
    local current=math.max(0,tonumber(data.till) or 0)
    local added=math.min(rate*seconds,math.max(0,capacity-current))
    if added&gt;0 then data.till=current+added end
    return added,capacity,hours
end
----------------------------------------------------------------------
-- Постройка салона
----------------------------------------------------------------------
local function collect(player, rec)
	if player ~= rec.player then
		Net.notify(player, "Это касса чужого салона.", "bad")
		return
	end
	local data = DataService.get(player)
	if not data then
		return
	end
	local root=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not root or(root.Position-rec.tillPos).Magnitude&gt;10 then return end
	local amount = math.floor(data.till)
	if amount &lt;= 0 then
		Net.notify(player, "В кассе пока пусто.", "info")
		return
	end
	data.till -= amount
    Tutorial.event(player,"collect_till")
	DataService.addMoney(player, amount, true)
	rec.tillLabel.Text = "КАССА\n$ 0"
	Net.notify(player, ("Забрано из кассы: +%s"):format(fmt(amount)), "good")
end

local function buildSalon(rec)
	local model = Instance.new("Model")
	model.Name = "Salon_" .. rec.player.UserId

	local function W(u, v, y)
		return toWorld(rec, u, v, y)
	end

	P.part(model, "Floor", Vector3.new(66, 0.2, 40), W(0, 22, 0.4), Color3.fromRGB(235, 235, 240), Enum.Material.Marble)
	P.part(model, "BackWall", Vector3.new(66, 12, 1.5), W(0, 43, 6.3), Color3.fromRGB(70, 90, 120))
	P.part(model, "Roof", Vector3.new(66, 0.8, 30), W(0, 27, 12.5), Color3.fromRGB(50, 60, 80))
	for _, u in ipairs({ -31, 31 }) do
		for _, v in ipairs({ 13, 40 }) do
			P.part(model, "Pillar", Vector3.new(1.6, 12, 1.6), W(u, v, 6.3), Color3.fromRGB(200, 200, 205), Enum.Material.Marble)
		end
	end

    -- One exterior fascia sign is provided by SalonArtDirector.
    -- No second sign: two signs on the same facade caused the text collision.

    -- Outdoor forecourt between road and building: exactly six neat exhibit positions.
    -- The permanent track sidewalk spans |Z| = 30..38 and has top Y = .40.
    -- The old apron also had top Y = .40, overlapping the sidewalk for 8 studs;
    -- both surfaces fought for the same depth, producing severe flicker.
    -- Start the apron just beyond the sidewalk (|Z| &gt;= 38.1); pads and the
    -- central walkway continue to cover the transition at their own heights.
    local apron = P.part(model, "SixCarExhibitionApron", Vector3.new(72.2,.18,14.5),
        W(0,3.35,.31), Color3.fromRGB(42,49,61), Enum.Material.Concrete,false)
    local centerWalk=P.part(model,"CentralShowroomWalk",Vector3.new(10.0,.16,22.0),
        W(0,-.7,.36),Color3.fromRGB(31,41,50),Enum.Material.SmoothPlastic,false)
    P.part(model,"LobbyCarpet",Vector3.new(8.4,.09,10.0),
        W(0,9.1,.55),Color3.fromRGB(38,85,82),Enum.Material.Fabric,false)
    for _,dx in ipairs({-5.05,5.05}) do
        P.part(model,"WalkEdge",Vector3.new(.12,.16,21.8),W(dx,-.7,.55),Color3.fromRGB(84,139,150),Enum.Material.SmoothPlastic,false)
    end
    local exhibitionLabel=P.part(model,"Выставка_6_машин",Vector3.new(24,.06,.9),
        W(0,-11.1,.44),Color3.fromRGB(47,179,169),Enum.Material.Neon,false)
    exhibitionLabel:SetAttribute("Description","Шесть машин: три слева, три справа, проход по центру к входу")
    for i, uv in ipairs(SLOT_UV) do
        local pad=P.part(model,"ExhibitionSpot_"..i,Vector3.new(9.6,.15,18.6),
            W(uv[1],uv[2],.47),Color3.fromRGB(60,72,87),Enum.Material.Metal,false)
        pad:SetAttribute("ExhibitSlot",i)
        for _,dx in ipairs({-4.66,4.66}) do
            P.part(model,"SlotEdge",Vector3.new(.12,.16,18.3),W(uv[1]+dx,uv[2],.56),
                Color3.fromRGB(73,128,146),Enum.Material.SmoothPlastic,false)
        end
        P.part(model,"SlotRear",Vector3.new(9.45,.16,.12),W(uv[1],uv[2]+9.1,.57),
            Color3.fromRGB(73,128,146),Enum.Material.SmoothPlastic,false)
        rec.slotCFrames[i]=CFrame.new(W(uv[1],uv[2],.95))*
            CFrame.Angles(0,rec.side==1 and math.pi/2 or -math.pi/2,0)
    end

	-- касса
	local till = P.part(model, "Till", Vector3.new(6, 2.7, 3.8), W(3.5, 27, 1.83), Color3.fromRGB(31, 41, 54), Enum.Material.Metal, false)
    P.part(model,"Касса_терминал",Vector3.new(2.5,1.45,.46),W(3.5,27,4.65),Color3.fromRGB(31,42,55),Enum.Material.Metal,false)
    P.part(model,"Касса_экран",Vector3.new(1.68,.80,.10),W(3.5,26.7,4.68),Color3.fromRGB(60,153,130),Enum.Material.SmoothPlastic,false)
    P.part(model,"Денежный ящик",Vector3.new(3.4,.6,2.4),W(3.5,26.9,3.2),Color3.fromRGB(45,54,66),Enum.Material.Metal,false)
    -- Fixed counter-facing screen; readable without camera gymnastics.
    local statusFace=P.part(model,"Касса_табло",Vector3.new(5.7,2.0,.18),
        W(3.5,24.70,4.16),Color3.fromRGB(12,26,31),Enum.Material.SmoothPlastic,false)
    local cashGui=Instance.new("SurfaceGui")
    cashGui.Name="CashStatusScreen"
    cashGui.Face=rec.side==1 and Enum.NormalId.Front or Enum.NormalId.Back
    cashGui.SizingMode=Enum.SurfaceGuiSizingMode.PixelsPerStud
    cashGui.PixelsPerStud=38
    cashGui.LightInfluence=0
    cashGui.AlwaysOnTop=false
    cashGui.Parent=statusFace
    local label=Instance.new("TextLabel")
    label.Size=UDim2.fromScale(1,1)
    label.BackgroundColor3=Color3.fromRGB(12,26,31)
    label.BorderSizePixel=0
    label.TextColor3=Color3.fromRGB(136,255,178)
    label.Font=Enum.Font.GothamBold
    label.TextScaled=true
    label.TextWrapped=true
    label.Text="КАССА  $ 0"
    label.Parent=cashGui

	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Забрать деньги"
	prompt.ObjectText = "Касса"
	prompt.HoldDuration = 0.3
	prompt.MaxActivationDistance = 5.5
    prompt.UIOffset=Vector2.new(-40,105) -- place E interaction below the cash display
	prompt.RequiresLineOfSight = false
	prompt.Parent = till
	prompt.Triggered:Connect(function(plr)
		collect(plr, rec)
	end)

    rec.tillLabel = label
    rec.tillPos = till.Position

    -- Two helpful cartoon vendor NPCs + a workshop pedestal.
    -- The source of truth for prices/rewards is server-side in UpgradeService/SalonService.
    local function vendor(kind,u,v,accent,caption)
        -- Capture precisely this vendor's local fallback parts (not another shop's).
        local before={}
        for _,item in ipairs(model:GetChildren()) do before[item]=true end
        local at=W(u,v,2.35)
        local stand=P.part(model,"NPC_"..kind.."_Stand",Vector3.new(5.3,.65,4.3),W(u,v,.80),Color3.fromRGB(31,47,60),Enum.Material.Metal,false)
        local body=P.part(model,"NPC_"..kind.."_Body",Vector3.new(1.7,2.2,1),at+Vector3.new(0,1.25,0),accent,Enum.Material.SmoothPlastic,false)
        local head=P.part(model,"NPC_"..kind.."_Head",Vector3.new(1.4,1.4,1.4),at+Vector3.new(0,3.03,0),Color3.fromRGB(236,200,162),Enum.Material.SmoothPlastic,false)
        head.Shape=Enum.PartType.Ball
        P.part(model,"NPC_"..kind.."_Hair",Vector3.new(1.5,.35,1.45),at+Vector3.new(0,3.82,0),Color3.fromRGB(45,39,46),Enum.Material.SmoothPlastic,false)
        for _,x in ipairs({-1.12,1.12}) do
            P.part(model,"NPC_"..kind.."_Arm",Vector3.new(.48,1.9,.55),at+Vector3.new(x,1.50,0),Color3.fromRGB(222,191,155),Enum.Material.SmoothPlastic,false)
        end
        for _,x in ipairs({-.45,.45}) do
            P.part(model,"NPC_"..kind.."_Leg",Vector3.new(.60,1.4,.60),at+Vector3.new(x,-.30,0),Color3.fromRGB(30,36,50),Enum.Material.SmoothPlastic,false)
        end
        -- Visual identity matters: coin mechanic = green cap, VIP = cyan crown,
        -- organizer = orange helmet and work apron. No third-party meshes.
        if kind=="coins" then
            P.part(model,"NPC_Coin_GreenCap",Vector3.new(1.75,.39,1.45),at+Vector3.new(0,3.87,0),Color3.fromRGB(52,151,99),Enum.Material.SmoothPlastic,false)
            P.part(model,"NPC_Coin_CapVisor",Vector3.new(1.58,.13,.73),at+Vector3.new(0,3.81,-.72),Color3.fromRGB(23,106,72),Enum.Material.SmoothPlastic,false)
            P.part(model,"NPC_Coin_MechanicBelt",Vector3.new(1.84,.36,1.07),at+Vector3.new(0,.35,0),Color3.fromRGB(37,51,62),Enum.Material.Metal,false)
        elseif kind=="cosmetics" then
            P.part(model,"NPC_Cosmetic_Hat",Vector3.new(1.82,.42,1.48),at+Vector3.new(0,4.02,0),Color3.fromRGB(178,89,224),Enum.Material.SmoothPlastic,false)
            P.part(model,"NPC_Cosmetic_Star",Vector3.new(.82,.76,.13),at+Vector3.new(0,1.70,-.59),Color3.fromRGB(244,176,255),Enum.Material.Neon,false)
        elseif kind=="diamonds" then
            P.part(model,"NPC_VIP_CrownBand",Vector3.new(1.76,.34,1.51),at+Vector3.new(0,3.95,0),Color3.fromRGB(57,183,236),Enum.Material.Neon,false)
            for _,cx in ipairs({-.50,0,.50}) do
                P.part(model,"NPC_VIP_CrownGem",Vector3.new(.33,.55,.37),at+Vector3.new(cx,4.38,-.03),Color3.fromRGB(135,242,255),Enum.Material.Neon,false)
            end
            P.part(model,"NPC_VIP_Badge",Vector3.new(.78,.50,.13),at+Vector3.new(.27,1.68,-.61),Color3.fromRGB(57,212,255),Enum.Material.Neon,false)
        else
            P.part(model,"NPC_Workshop_Helmet",Vector3.new(1.72,.50,1.45),at+Vector3.new(0,3.98,0),Color3.fromRGB(246,165,59),Enum.Material.SmoothPlastic,false)
            P.part(model,"NPC_Workshop_Visor",Vector3.new(1.75,.16,.67),at+Vector3.new(0,3.77,-.68),Color3.fromRGB(158,95,37),Enum.Material.SmoothPlastic,false)
            P.part(model,"NPC_Workshop_Apron",Vector3.new(1.43,1.60,.13),at+Vector3.new(0,1.12,-.59),Color3.fromRGB(96,67,42),Enum.Material.SmoothPlastic,false)
        end
        -- V44: four recognisably different retail characters; hand-crafted shop
        -- accessories, facial features, clothing layers and small display props.
        local function glam(name,sz,ofs,col,mat,shape,rot)
            local obj=P.part(model,'NPC_'..kind..'_V44_'..name,sz,at+ofs,col,mat or Enum.Material.SmoothPlastic,false)
            if shape=='ball' then obj.Shape=Enum.PartType.Ball
            elseif shape=='cyl' then obj.Shape=Enum.PartType.Cylinder end
            if rot then obj.CFrame=obj.CFrame*rot end
            obj.CanCollide=false;obj.CanTouch=false;obj.CanQuery=false
            return obj
        end
        local coat=kind=='coins' and Color3.fromRGB(30,87,70) or
            (kind=='diamonds' and Color3.fromRGB(29,58,103) or
            (kind=='workshop' and Color3.fromRGB(125,80,48) or Color3.fromRGB(70,38,109)))
        local contrast=kind=='coins' and Color3.fromRGB(158,244,170) or
            (kind=='diamonds' and Color3.fromRGB(125,229,255) or
            (kind=='workshop' and Color3.fromRGB(246,196,116) or Color3.fromRGB(247,144,247)))
        local skin=Color3.fromRGB(236,200,162)
        glam('Tailored_vest',Vector3.new(1.52,1.70,.17),Vector3.new(0,1.35,-.54),coat,Enum.Material.Fabric)
        glam('Collar',Vector3.new(1.44,.18,1.14),Vector3.new(0,2.31,0),contrast,Enum.Material.Metal)
        glam('Belt',Vector3.new(1.76,.21,1.07),Vector3.new(0,.25,0),Color3.fromRGB(28,34,44),Enum.Material.Metal)
        glam('Belt_buckle',Vector3.new(.29,.19,.11),Vector3.new(0,.26,-.61),contrast,Enum.Material.Metal)
        for _,s in ipairs({-1,1}) do
            glam('Eye_'..s,Vector3.new(.17,.19,.11),Vector3.new(s*.32,3.10,-.67),Color3.fromRGB(21,37,56),Enum.Material.SmoothPlastic,'ball')
            glam('Eye_reflection_'..s,Vector3.new(.065,.065,.05),Vector3.new(s*.34-.03,3.15,-.75),Color3.fromRGB(240,252,255),Enum.Material.Neon,'ball')
            glam('Eyebrow_'..s,Vector3.new(.35,.08,.09),Vector3.new(s*.32,3.40,-.66),Color3.fromRGB(56,44,45))
            glam('Shoulder_'..s,Vector3.new(.64,.33,.81),Vector3.new(s*1.05,2.27,0),coat,Enum.Material.Fabric,'ball')
            glam('Cuff_'..s,Vector3.new(.55,.27,.62),Vector3.new(s*1.12,.83,0),contrast,Enum.Material.Metal)
            glam('Boot_'..s,Vector3.new(.68,.46,.79),Vector3.new(s*.45,-.89,-.08),Color3.fromRGB(20,26,40),Enum.Material.Metal)
        end
        glam('Nose',Vector3.new(.13,.17,.16),Vector3.new(0,2.94,-.76),skin,Enum.Material.SmoothPlastic,'ball')
        glam('Smile',Vector3.new(.35,.065,.10),Vector3.new(0,2.75,-.70),Color3.fromRGB(143,78,79))
        if kind=='coins' then
            -- Mechanic: stitched workshop overalls, goggles, spanner in hand.
            glam('Apron',Vector3.new(1.25,1.43,.11),Vector3.new(0,1.20,-.67),Color3.fromRGB(50,96,79),Enum.Material.Fabric)
            glam('Apron_pocket',Vector3.new(.67,.37,.13),Vector3.new(0,.97,-.77),Color3.fromRGB(26,58,54),Enum.Material.Fabric)
            glam('Wrench_handle',Vector3.new(.13,.97,.14),Vector3.new(1.21,.70,-.62),Color3.fromRGB(193,206,223),Enum.Material.Metal)
            glam('Wrench_head',Vector3.new(.42,.18,.16),Vector3.new(1.21,1.20,-.62),Color3.fromRGB(193,206,223),Enum.Material.Metal)
            for _,s in ipairs({-1,1}) do
                glam('Safety_goggles_'..s,Vector3.new(.37,.27,.17),Vector3.new(s*.34,3.18,-.79),Color3.fromRGB(110,220,206),Enum.Material.Glass)
            end
        elseif kind=='diamonds' then
            -- Royal VIP consultant with shoulder cape and gemstone jewellery.
            glam('Velvet_coat',Vector3.new(1.66,1.81,.24),Vector3.new(0,1.30,-.61),Color3.fromRGB(35,58,119),Enum.Material.Fabric)
            for _,s in ipairs({-1,1}) do
                glam('Shoulder_cape_'..s,Vector3.new(.75,1.15,.16),Vector3.new(s*.76,1.91,.55),Color3.fromRGB(69,92,169),Enum.Material.Fabric,nil,CFrame.Angles(0,0,s*.18))
                glam('Crown_spike_'..s,Vector3.new(.24,.62,.26),Vector3.new(s*.55,4.41,-.06),contrast,Enum.Material.Metal)
            end
            glam('Gem_royal',Vector3.new(.53,.53,.22),Vector3.new(0,1.63,-.85),contrast,Enum.Material.Neon,'ball')
            glam('Glasses',Vector3.new(.91,.13,.13),Vector3.new(0,3.13,-.77),Color3.fromRGB(26,48,79),Enum.Material.Metal)
        elseif kind=='workshop' then
            -- Engineer: safety goggles, tools, metallic forearm protectors.
            glam('Apron_leather',Vector3.new(1.43,1.50,.16),Vector3.new(0,1.26,-.71),Color3.fromRGB(108,65,34),Enum.Material.Fabric)
            for _,x in ipairs({-.40,0,.40}) do
                glam('Pocket_rivet',Vector3.new(.12,.12,.08),Vector3.new(x,.98,-.82),contrast,Enum.Material.Metal,'ball')
            end
            glam('Safety_visor_glass',Vector3.new(1.15,.34,.17),Vector3.new(0,3.17,-.77),Color3.fromRGB(241,217,147),Enum.Material.Glass)
            glam('Engineering_tablet',Vector3.new(.61,.81,.12),Vector3.new(-1.19,.99,-.66),Color3.fromRGB(23,49,62),Enum.Material.Metal)
            glam('Tablet_display',Vector3.new(.42,.54,.06),Vector3.new(-1.19,1.01,-.75),Color3.fromRGB(71,236,201),Enum.Material.Neon)
        else
            -- Fashion stylist: asymmetrical coat, jewellery, colour studio light.
            glam('Fashion_coat',Vector3.new(1.54,2.08,.22),Vector3.new(0,1.30,-.65),Color3.fromRGB(65,31,99),Enum.Material.Fabric)
            for _,side in ipairs({-1,1}) do
                glam('Fashion_epaulette_'..side,Vector3.new(.81,.22,.80),Vector3.new(side*1.00,2.30,0),contrast,Enum.Material.Metal,nil,CFrame.Angles(0,0,side*.14))
                glam('Sunglasses_'..side,Vector3.new(.42,.31,.13),Vector3.new(side*.34,3.13,-.79),Color3.fromRGB(31,21,59),Enum.Material.Glass)
                glam('Neon_lapel_'..side,Vector3.new(.16,.90,.12),Vector3.new(side*.45,1.57,-.78),contrast,Enum.Material.Neon,nil,CFrame.Angles(0,0,side*.16))
            end
            glam('Pendant',Vector3.new(.24,.34,.14),Vector3.new(0,1.67,-.87),Color3.fromRGB(255,213,243),Enum.Material.Neon,'ball')
            glam('Stylist_pointer',Vector3.new(.13,1.17,.13),Vector3.new(1.20,.81,-.60),Color3.fromRGB(221,197,249),Enum.Material.Metal)
            glam('Pointer_gem',Vector3.new(.29,.29,.29),Vector3.new(1.20,1.45,-.60),contrast,Enum.Material.Neon,'ball')
            -- Three sample colour swatches on a floor-standing cosmetic display.
            for i,color in ipairs({Color3.fromRGB(255,92,130),Color3.fromRGB(68,220,242),Color3.fromRGB(251,205,105)}) do
                glam('Showroom_color_sample_'..i,Vector3.new(.36,.53,.23),
                    Vector3.new(-2.45+(i-1)*.47,1.12,-.72),color,Enum.Material.Metal)
            end
            glam('Showroom_plinth',Vector3.new(1.66,.37,.76),Vector3.new(-2.02,.70,-.70),Color3.fromRGB(32,40,67),Enum.Material.Metal)
        end
        -- A front-facing emblem on the platform reinforces which menu E opens.
        local emblem=P.part(model,"NPC_"..kind.."_Emblem",Vector3.new(2.9,.54,.16),
            W(u,v-2.28,1.17),accent,Enum.Material.SmoothPlastic,false)
        local emblemGui=Instance.new("SurfaceGui")
        emblemGui.Face=Enum.NormalId.Front;emblemGui.SizingMode=Enum.SurfaceGuiSizingMode.PixelsPerStud
        emblemGui.PixelsPerStud=55;emblemGui.LightInfluence=0;emblemGui.Parent=emblem
        local symbol=Instance.new("TextLabel")
        symbol.Size=UDim2.fromScale(1,1);symbol.BackgroundTransparency=1
        symbol.Font=Enum.Font.GothamBlack;symbol.TextSize=22
        symbol.TextColor3=Color3.fromRGB(12,25,35)
        symbol.Text=kind=="coins" and "$" or (kind=="diamonds" and "VIP" or "\226\135\133")
        symbol.Parent=emblemGui
        local bb=Instance.new("BillboardGui")
        bb.Name="NPC_ShopLabel";bb.Adornee=head;bb.StudsOffsetWorldSpace=Vector3.new(0,1.5,0)
        bb.Size=UDim2.fromOffset(170,37);bb.MaxDistance=22;bb.Parent=head
        local txt=Instance.new("TextLabel");txt.Size=UDim2.fromScale(1,1)
        txt.BackgroundColor3=Color3.fromRGB(12,23,36);txt.BackgroundTransparency=.13
        txt.Font=Enum.Font.GothamBold;txt.TextSize=13;txt.TextColor3=accent;txt.Text=caption;txt.Parent=bb
        local pr=Instance.new("ProximityPrompt")
        pr.Name="ShopPrompt_"..kind;pr.KeyboardKeyCode=Enum.KeyCode.E;pr.ActionText="Открыть"
        pr.ObjectText=caption;pr.HoldDuration=.1;pr.MaxActivationDistance=9
        pr.RequiresLineOfSight=false;pr.Parent=stand
        pr.Triggered:Connect(function(plr)
            if plr==rec.player and Net.OpenEconomyNPC then
                local root=plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
                if not root or(root.Position-stand.Position).Magnitude&gt;14 then return end
                Tutorial.vendor(plr,kind)
                Net.OpenEconomyNPC:FireClient(plr,kind)
            else Net.notify(plr,"Это NPC чужого салона — используй свой магазин.","info") end
        end)
        local fallback={}
        for _,item in ipairs(model:GetChildren()) do
            if not before[item] and item:IsA("BasePart") and item~=stand and item~=emblem then
                fallback[#fallback+1]=item
            end
        end
        task.spawn(function()
            local rig=OwnerService.newRig(nil,kind)
            if not rig then return end -- Studio offline: keep original vendor visible.
            if not rec.player.Parent or not model.Parent then rig:Destroy();return end
            rig.Name="MarketplaceVendor_"..kind
            local root=rig:FindFirstChild("HumanoidRootPart")
            local vendorHum=rig:FindFirstChildOfClass("Humanoid")
            if not root or not vendorHum then rig:Destroy();return end
            local spot=W(u,v,1.125+vendorHum.HipHeight+root.Size.Y/2)
            local facing=Vector3.new(0,0,-rec.side)
            rig:PivotTo(CFrame.lookAt(spot,spot+facing))
            local hum=rig:FindFirstChildOfClass("Humanoid")
            if hum then
                hum.WalkSpeed=0
                hum.AutoRotate=false
                hum.DisplayDistanceType=Enum.HumanoidDisplayDistanceType.None
            end
            local root=rig:FindFirstChild("HumanoidRootPart")
            if root then root.Anchored=true;root.CanCollide=false end
            for _,part in ipairs(rig:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide=false;part.CanTouch=false;part.CanQuery=false
                end
            end
            rig.Parent=model
            -- Hide placeholder blocks only AFTER the premium avatar exists.
            for _,item in ipairs(fallback) do
                if item.Parent then item.Transparency=1;item.CanCollide=false end
            end
            local avatarHead=rig:FindFirstChild("Head")
            if avatarHead then bb.Adornee=avatarHead end
        end)
    end
    vendor("coins",-20,26,Color3.fromRGB(124,227,161),"МАСТЕР · МОНЕТЫ $")
    vendor("diamonds",20,26,Color3.fromRGB(112,208,252),"VIP · АЛМАЗЫ 💎")
    vendor("workshop",0,36,Color3.fromRGB(247,191,97),"МАСТЕРСКАЯ · ПОЛКИ")
    vendor("cosmetics",-12,36,Color3.fromRGB(215,139,247),"ОБРАЗЫ · ПИТОМЦЫ 💎")

    -- The TOP-100 panel is THE ENTIRE RIGHT SIDE WINDOW next to the cashier.
    -- Its surface faces inward (-X); the corresponding glazing/mullions are not
    -- generated in SalonArtDirector. Nothing sticks out into the car forecourt.
    local paneX=31.78 -- cashier-side wall; W's u-axis is world X on both plots
    local paneV=27 -- wall section stretches from v=12.6 to v=41.4
    local paneY=6.8
    local paneWidth=28.6 -- usable horizontal length along the wall (world Z)
    local paneHeight=9.4
    local tv=P.part(model,"Правая_Стена_Топ100",Vector3.new(.24,paneHeight,paneWidth),
        W(paneX,paneV,paneY),Color3.fromRGB(9,16,28),Enum.Material.SmoothPlastic,false)
    tv.CastShadow=false
    local edgeColor=Color3.fromRGB(73,126,149)
    for _,dy in ipairs({-paneHeight/2-.08,paneHeight/2+.08}) do
        P.part(model,"Экран_рамка_гориз",Vector3.new(.30,.16,paneWidth+.23),
            W(paneX,paneV,paneY+dy),edgeColor,Enum.Material.Metal,false)
    end
    for _,dv in ipairs({-paneWidth/2-.08,paneWidth/2+.08}) do
        P.part(model,"Экран_рамка_верт",Vector3.new(.30,paneHeight+.22,.16),
            W(paneX,paneV+dv,paneY),edgeColor,Enum.Material.Metal,false)
    end
    local tvGui=Instance.new("SurfaceGui")
    tvGui.Name="WorldTop100"
    tvGui.Face=Enum.NormalId.Left
    tvGui.SizingMode=Enum.SurfaceGuiSizingMode.PixelsPerStud
    tvGui.PixelsPerStud=50
    tvGui.LightInfluence=0
    tvGui.AlwaysOnTop=false
    tvGui.Parent=tv
    local panel=Instance.new("Frame")
    panel.Name="LeaderboardBackground"
    panel.BackgroundColor3=Color3.fromRGB(12,22,38)
    panel.BorderSizePixel=0;panel.Size=UDim2.fromScale(1,1);panel.Parent=tvGui
    local glow=Instance.new("UIStroke")
    glow.Color=Color3.fromRGB(43,186,194);glow.Thickness=3;glow.Transparency=.25;glow.Parent=panel
    local bar=Instance.new("Frame")
    bar.Size=UDim2.new(1,0,0,9);bar.BackgroundColor3=Color3.fromRGB(66,215,201)
    bar.BorderSizePixel=0;bar.Parent=panel
    local top=Instance.new("TextLabel")
    top.Size=UDim2.new(1,-52,0,53)
    top.Position=UDim2.fromOffset(24,13)
    top.BackgroundTransparency=1;top.TextXAlignment=Enum.TextXAlignment.Left
    top.Text="★  ТОП-10 УГОНЩИКОВ  /  30 ДНЕЙ"
    top.Font=Enum.Font.GothamBlack;top.TextSize=30
    top.TextColor3=Color3.fromRGB(244,205,118);top.Parent=panel
    local subtitle=Instance.new("TextLabel")
    subtitle.Size=UDim2.new(1,-52,0,25);subtitle.Position=UDim2.fromOffset(26,60)
    subtitle.BackgroundTransparency=1;subtitle.TextXAlignment=Enum.TextXAlignment.Left
    subtitle.Text="МОНЕТЫ, ЗАРАБОТАННЫЕ ЗА СЕЗОН  ·  СЕЗОННЫЙ РЕЙТИНГ"
    subtitle.Font=Enum.Font.GothamMedium;subtitle.TextSize=17
    subtitle.TextColor3=Color3.fromRGB(141,188,205);subtitle.Parent=panel
    local rows={}
    for rank=1,10 do
        local strip=Instance.new("Frame")
        strip.Name="EntryPanel"..rank
        strip.Size=UDim2.new(1,-50,0,31)
        strip.Position=UDim2.fromOffset(25,92+(rank-1)*33)
        strip.BorderSizePixel=0
        strip.BackgroundColor3=rank&lt;=3 and Color3.fromRGB(31,50,67) or (rank%2==0 and Color3.fromRGB(23,37,54) or Color3.fromRGB(18,30,47))
        strip.Parent=panel
        local c=Instance.new("UICorner");c.CornerRadius=UDim.new(0,4);c.Parent=strip
        local line=Instance.new("TextLabel")
        line.Name="Rank"..rank
        line.Size=UDim2.new(1,-18,1,0);line.Position=UDim2.fromOffset(9,0)
        line.BackgroundTransparency=1;line.TextXAlignment=Enum.TextXAlignment.Left
        line.Font=Enum.Font.GothamBold;line.TextSize=22
        line.TextColor3=rank&lt;=3 and Color3.fromRGB(249,207,118) or Color3.fromRGB(223,236,242)
        line.Text="";line.Parent=strip;rows[rank]=line
    end
    local footer=Instance.new("TextLabel")
    footer.Size=UDim2.new(1,-40,0,29)
    footer.Position=UDim2.new(0,22,1,-37)
    footer.BackgroundTransparency=1;footer.Font=Enum.Font.GothamBold
    footer.TextColor3=Color3.fromRGB(93,224,194);footer.TextSize=20
    footer.TextXAlignment=Enum.TextXAlignment.Center
    footer.Text="НАЖМИ E / КЛИКНИ · ОТКРЫТЬ ТОП-100";footer.Parent=panel
    local empty=Instance.new("TextLabel")
    empty.Name="SeasonEmptyState";empty.Position=UDim2.new(.07,0,.30,0)
    empty.Size=UDim2.new(.86,0,.38,0)
    empty.BackgroundColor3=Color3.fromRGB(12,22,38)
    empty.Text="СЕЗОН ПОКА ПУСТОЙ\nПервым заработай монеты и возглавь рейтинг!"
    empty.TextColor3=Color3.fromRGB(151,227,209)
    empty.Font=Enum.Font.GothamBold;empty.TextSize=30
    empty.TextWrapped=true;empty.Parent=panel
    rec.seasonTV={rows=rows,footer=footer,heading=top,empty=empty}
    local tvPrompt=Instance.new("ProximityPrompt")
    tvPrompt.Name="OpenSeasonTop100"
    tvPrompt.ActionText="Открыть топ-100"
    tvPrompt.ObjectText="Сезонный рейтинг"
    tvPrompt.KeyboardKeyCode=Enum.KeyCode.E
    tvPrompt.HoldDuration=0;tvPrompt.MaxActivationDistance=17
    tvPrompt.RequiresLineOfSight=false
    tvPrompt.Parent=tv
    tvPrompt.Triggered:Connect(function(plr)
        if Net.ShowTop100 and plr and plr.Parent then Net.ShowTop100:FireClient(plr) end
    end)
    local detector=Instance.new("ClickDetector")
    detector.Name="ClickTop100";detector.MaxActivationDistance=22;detector.Parent=tv
    detector.MouseClick:Connect(function(plr)
        if Net.ShowTop100 and plr and plr.Parent then Net.ShowTop100:FireClient(plr) end
    end)

    -- Decorative showroom guard: anchored native-parts rig that can PATROL.
    -- No Humanoid, no collisions, never catches thieves or interrupts F-hold.
    local guard=Instance.new("Model")
    guard.Name="Охранник · патруль"
    guard.Parent=model
    local p=W(-26,19,0)
    local guardUniforms={
        {Color3.fromRGB(36,58,80),Color3.fromRGB(20,28,39)},
        {Color3.fromRGB(58,67,84),Color3.fromRGB(27,31,41)},
        {Color3.fromRGB(33,83,80),Color3.fromRGB(22,37,42)},
        {Color3.fromRGB(97,58,64),Color3.fromRGB(38,26,33)},
        {Color3.fromRGB(71,64,99),Color3.fromRGB(28,27,45)},
    }
    local uniform=guardUniforms[math.random(1,#guardUniforms)]
    local coat,boot=uniform[1],uniform[2]
    local face=Color3.fromRGB(206,163,129)
    local leftLeg=P.part(guard,"Левая нога",Vector3.new(.68,1.86,.74),p+Vector3.new(-.45,1.50,0),boot,Enum.Material.Fabric,false)
    local rightLeg=P.part(guard,"Правая нога",Vector3.new(.68,1.86,.74),p+Vector3.new(.45,1.50,0),boot,Enum.Material.Fabric,false)
    P.part(guard,"Ботинок левый",Vector3.new(.75,.38,1.02),p+Vector3.new(-.45,.49,-.12),boot,Enum.Material.SmoothPlastic,false)
    P.part(guard,"Ботинок правый",Vector3.new(.75,.38,1.02),p+Vector3.new(.45,.49,-.12),boot,Enum.Material.SmoothPlastic,false)
    P.part(guard,"Куртка",Vector3.new(2.06,2.18,1.15),p+Vector3.new(0,3.46,0),coat,Enum.Material.Fabric,false)
    P.part(guard,"Ремень",Vector3.new(2.08,.18,1.19),p+Vector3.new(0,2.51,0),boot,Enum.Material.SmoothPlastic,false)
    P.part(guard,"Голова",Vector3.new(1.08,1.05,1.05),p+Vector3.new(0,5.10,0),face,Enum.Material.SmoothPlastic,false)
    P.part(guard,"Кепка",Vector3.new(1.37,.27,1.18),p+Vector3.new(0,5.72,0),boot,Enum.Material.SmoothPlastic,false)
    P.part(guard,"Козырёк",Vector3.new(1.34,.11,.47),p+Vector3.new(0,5.66,-.67),boot,Enum.Material.SmoothPlastic,false)
    for _,x in ipairs({-.26,.26}) do
        P.part(guard,"Глаз",Vector3.new(.11,.10,.075),p+Vector3.new(x,5.19,-.56),Color3.fromRGB(32,42,53),Enum.Material.SmoothPlastic,false)
    end
    local leftArm=P.part(guard,"Левая рука",Vector3.new(.49,1.92,.54),p+Vector3.new(-1.30,3.42,0),coat,Enum.Material.Fabric,false)
    local rightArm=P.part(guard,"Правая рука",Vector3.new(.49,1.92,.54),p+Vector3.new(1.30,3.42,0),coat,Enum.Material.Fabric,false)
    P.part(guard,"Рация",Vector3.new(.30,.47,.20),p+Vector3.new(1.20,3.12,-.41),boot,Enum.Material.Metal,false)
    local badge=P.part(guard,"Жетон",Vector3.new(.65,.38,.07),p+Vector3.new(-.42,3.90,-.61),Color3.fromRGB(181,219,230),Enum.Material.Metal,false)
    P.signFace(badge,Enum.NormalId.Front,"SEC")
    local guardLevelGui=Instance.new("BillboardGui")
    guardLevelGui.Name="GuardLevelStatus";guardLevelGui.Adornee=guard:FindFirstChild("Голова")
    guardLevelGui.StudsOffsetWorldSpace=Vector3.new(0,1.55,0)
    guardLevelGui.Size=UDim2.fromOffset(125,34);guardLevelGui.MaxDistance=22
    guardLevelGui.Parent=guard
    local guardText=Instance.new("TextLabel")
    guardText.Name="GuardLevelText";guardText.Size=UDim2.fromScale(1,1)
    guardText.BackgroundColor3=Color3.fromRGB(18,31,45);guardText.BackgroundTransparency=.16
    guardText.TextColor3=Color3.fromRGB(148,216,252);guardText.Text="ОХРАНА · 0/5"
    guardText.Font=Enum.Font.GothamBold;guardText.TextSize=13
    guardText.Parent=guardLevelGui
    rec.guardBadge=badge
    rec.guardLevelText=guardText
    rec.guardModel=guard
    rec.guardOriginPoint=p
    rec.guardOriginalPivot=guard:GetPivot()
    rec.guardSwingParts={leftArm,rightArm,leftLeg,rightLeg}
    rec.guardSwingOffsets={}
    for i,part in ipairs(rec.guardSwingParts) do
        rec.guardSwingOffsets[i]=rec.guardOriginalPivot:ToObjectSpace(part.CFrame)
    end

	local shelf = Instance.new("Folder")
	shelf.Name = "Shelf"
	shelf.Parent = model
	rec.shelfFolder = shelf

    -- Separate accessory showcase: permanently earned with each 50 PvP raids.
    local trophyStand = Instance.new("Folder")
    trophyStand.Name = "TheftAccessoryCollection"
    trophyStand.Parent = model
    rec.theftAccessoryFolder = trophyStand

    -- PERSONAL DELIVERY BAY: one player, one visible zone right in front of their salon.
    -- The parking strip spans |Z|=20..30; the showroom is beyond the sidewalk.
    local bay = P.part(model, "DeliveryZone", Vector3.new(30, .14, 16),
        Vector3.new(rec.px, .35, rec.side * 25),
        Color3.fromRGB(35, 76, 67), Enum.Material.SmoothPlastic, false)
    bay.Transparency = .58
    bay:SetAttribute("OwnerUserId", rec.player.UserId)
    bay:SetAttribute("PlotIndex", rec.plotIndex)
    -- Thin edge lines instead of a full neon floor and a large floating billboard.
    local borderColor = Color3.fromRGB(84, 157, 135)
    for _,dx in ipairs({-14.7,14.7}) do
        P.part(model,"DeliveryBoundarySide",Vector3.new(.16,.08,15.2),
            Vector3.new(rec.px+dx,.46,rec.side*25),borderColor,Enum.Material.SmoothPlastic,false)
    end
    for _,dz in ipairs({-7.7,7.7}) do
        P.part(model,"DeliveryBoundaryFront",Vector3.new(29.4,.08,.16),
            Vector3.new(rec.px,.46,rec.side*25+dz),borderColor,Enum.Material.SmoothPlastic,false)
    end
    local pole = P.part(model, "DeliveryBeacon", Vector3.new(.34, 3.5, .34),
        Vector3.new(rec.px + 14.5, 1.9, rec.side * 29),
        Color3.fromRGB(58, 106, 93), Enum.Material.Metal, false)
    local bb = Instance.new("BillboardGui")
    bb.Name="DeliverySign"
    bb.Size=UDim2.fromOffset(115,30)
    bb.StudsOffset=Vector3.new(0,2.6,0)
    bb.MaxDistance=34
    bb.AlwaysOnTop=false
    bb.Adornee=pole
    bb.Parent=pole
    local title=Instance.new("TextLabel")
    title.Size=UDim2.fromScale(1,1)
    title.BackgroundColor3=Color3.fromRGB(19,36,34)
    title.BackgroundTransparency=.16
    title.TextColor3=Color3.fromRGB(171,234,202)
    title.TextSize=13
    title.TextScaled=false
    title.Font=Enum.Font.GothamBold
    title.Text="ПАРКОВКА №"..rec.plotIndex
    title.Parent=bb
    local round=Instance.new("UICorner")
    round.CornerRadius=UDim.new(0,6)
    round.Parent=title
    SalonArt.decorate(model,rec,W)
	model.Parent = salonsFolder
	rec.model = model
end

-- Common native Roblox collectible sculptor, used by BOTH income shelf and star collection.
-- No MeshParts or external asset IDs. Every shape is non-colliding and anchored.
local function makeNativeCollectible(parent, itemId, at, accent, isOwned, yaw)
    local group=Instance.new("Model")
    group.Name="Предмет · "..itemId
    group.Parent=parent
    local grey=Color3.fromRGB(113,125,137)
    local color=isOwned and accent or grey
    local dark=Color3.fromRGB(30,38,50)
    local black=Color3.fromRGB(17,23,33)
    local steel=Color3.fromRGB(147,163,176)
    local light=isOwned and Color3.fromRGB(190,240,250) or steel
    local function box(name, size, delta, tint, mat)
        return P.part(group,name,size,at+delta,tint or color,mat or Enum.Material.SmoothPlastic,false)
    end
    local function sphere(name, diameter, delta, tint)
        local part=box(name,Vector3.new(diameter,diameter,diameter),delta,tint)
        part.Shape=Enum.PartType.Ball
        return part
    end
    -- Roblox cylinders point along local X, hence rotate them to face the visitor (-Z).
    local function frontDisc(name,diam,depth,delta,tint)
        local part=box(name,Vector3.new(depth,diam,diam),delta,tint or color,Enum.Material.Metal)
        part.Shape=Enum.PartType.Cylinder
        part.CFrame=CFrame.new(at+delta)*CFrame.Angles(0,math.pi/2,0)
        return part
    end
    local function ring(name,radius,tint)
        local segments=12
        local chord=2*radius*math.sin(math.pi/segments)
        for j=0,segments-1 do
            local theta=(j+.5)*2*math.pi/segments
            local offset=Vector3.new(radius*math.cos(theta),radius*math.sin(theta),-.47)
            local part=box(name..j,Vector3.new(chord+.02,.13,.15),offset,tint,Enum.Material.Metal)
            part.CFrame=CFrame.new(at+offset)*CFrame.Angles(0,0,theta+math.pi/2)
        end
    end
    local function screen(name,width,height,delta,screenColor)
        box(name.." корпус",Vector3.new(width+.12,height+.12,.14),delta+Vector3.new(0,0,.03),black)
        box(name,Vector3.new(width,height,.07),delta,screenColor or color,Enum.Material.Neon)
    end
    if itemId=="tree_fresh" or itemId=="air_freshener" then
        -- Stacked tapered evergreen, a brown stem and a visible hanging loop.
        box("Ствол ароматизатора",Vector3.new(.16,.54,.18),Vector3.new(0,-.56,-.02),Color3.fromRGB(135,94,67),Enum.Material.Wood)
        local evergreen=isOwned and Color3.fromRGB(74,210,118) or grey
        for k=0,2 do
            local y=-.28+k*.33
            box("Ветви ёлочки "..k,Vector3.new(1.22-k*.31,.29,.25),Vector3.new(0,y,-.02),evergreen)
            local cone=box("Крона "..k,Vector3.new(.90-k*.24,.40,.25),Vector3.new(0,y+.16,-.02),evergreen)
            cone.CFrame=CFrame.new(at+Vector3.new(0,y+.16,-.02))*CFrame.Angles(0,0,math.rad(45))
        end
        sphere("Отверстие для верёвки",.16,Vector3.new(0,.72,-.14),dark)
        box("Шнурок",Vector3.new(.07,.34,.07),Vector3.new(0,.84,0),steel)
    elseif itemId=="fm_radio" or itemId=="radio_old" or itemId=="radio_fm" then
        box("Магнитола - корпус",Vector3.new(2.55,1.18,.62),Vector3.new(0,0,.08),dark)
        box("Лицевая панель",Vector3.new(2.39,1.0,.10),Vector3.new(0,0,-.29),steel,Enum.Material.Metal)
        if itemId=="radio_old" then
            box("Кассетный отсек",Vector3.new(1.13,.57,.10),Vector3.new(-.23,0,-.37),black)
            box("Окошко кассеты",Vector3.new(.97,.41,.06),Vector3.new(-.23,0,-.44),Color3.fromRGB(70,92,112),Enum.Material.Glass)
            frontDisc("Левая катушка",.24,.05,Vector3.new(-.52,.00,-.48),steel)
            frontDisc("Правая катушка",.24,.05,Vector3.new(.07,.00,-.48),steel)
        else
            screen("FM дисплей",1.21,.49,Vector3.new(-.23,.08,-.41),color)
            for j=0,3 do
                box("Кнопка памяти "..j,Vector3.new(.17,.10,.07),Vector3.new(-.65+j*.25,-.32,-.39),black)
            end
        end
        frontDisc("Регулятор громкости",.36,.13,Vector3.new(.98,0,-.43),dark)
        frontDisc("Серебряный ободок",.20,.13,Vector3.new(.98,0,-.54),light)
    elseif itemId=="car_speakers" then
        for side=-1,1,2 do
            local x=side*.76
            box("Корпус колонки",Vector3.new(1.17,1.58,.73),Vector3.new(x,0,.06),dark)
            frontDisc("Басовый диффузор",.92,.12,Vector3.new(x,-.23,-.36),color)
            frontDisc("Защитная шайба",.32,.14,Vector3.new(x,-.23,-.45),black)
            frontDisc("Высокочастотный динамик",.34,.09,Vector3.new(x,.52,-.38),steel)
        end
    elseif itemId=="subwoofer" then
        box("Корпус сабвуфера",Vector3.new(2.15,1.85,.85),Vector3.new(0,0,.09),dark)
        frontDisc("Резиновый подвес",1.61,.12,Vector3.new(0,0,-.43),black)
        frontDisc("Мембрана",1.38,.14,Vector3.new(0,0,-.51),color)
        frontDisc("Пылезащитный колпачок",.53,.15,Vector3.new(0,0,-.60),black)
        box("Бас-рефлекс",Vector3.new(.26,.18,.13),Vector3.new(.83,-.68,-.42),steel)
    elseif itemId=="gps_unit" or itemId=="multimedia" or itemId=="dash_screen" then
        box("Навигатор корпус",Vector3.new(2.62,1.48,.33),Vector3.new(0,0,0),dark)
        screen("Карта навигатора",2.23,1.12,Vector3.new(0,.05,-.23),Color3.fromRGB(40,79,94))
        for j=-1,1,2 do
            box("Схема дороги",Vector3.new(.055,.84,.035),Vector3.new(j*.36,0,-.29),Color3.fromRGB(110,145,156))
        end
        box("Маршрут",Vector3.new(1.42,.075,.045),Vector3.new(0,-.13,-.32),color,Enum.Material.Neon)
        sphere("Пункт назначения",.23,Vector3.new(.52,-.13,-.37),light)
        box("Ножка навигатора",Vector3.new(.17,.42,.16),Vector3.new(0,-.88,.10),steel)
    elseif itemId=="led_trim" or itemId=="neon_kit" then
        for j=1,3 do
            local y=(j-2)*.43
            box("LED лента "..j,Vector3.new(2.52,.16,.19),Vector3.new(0,y,-.11),color,Enum.Material.Neon)
            for k=-3,3 do
                sphere("Диод",.085,Vector3.new(k*.31,y,-.23),light)
            end
        end
        box("Контроллер LED",Vector3.new(.48,.54,.39),Vector3.new(-.9,-.65,.15),dark)
    elseif itemId=="ambient_lighting" then
        box("Модуль салонного света",Vector3.new(2.32,1.40,.30),Vector3.new(0,0,.05),dark)
        for j=1,3 do
            local y=(j-2)*.41
            box("Световой контур",Vector3.new(1.92,.10,.12),Vector3.new(0,y,-.22),color,Enum.Material.Neon)
        end
        box("Кнопка оттенка",Vector3.new(.32,.32,.08),Vector3.new(.81,-.54,-.25),light)
    elseif itemId=="sport_gauges" then
        box("Панель приборов",Vector3.new(2.62,1.16,.42),Vector3.new(0,0,.08),dark)
        for j=-1,1 do
            local x=j*.75
            frontDisc("Ободок шкалы",.73,.07,Vector3.new(x,0,-.21),steel)
            frontDisc("Циферблат",.56,.07,Vector3.new(x,0,-.31),black)
            local needle=box("Стрелка приборов",Vector3.new(.30,.05,.045),Vector3.new(x+.10,.08,-.36),color)
            needle.CFrame=CFrame.new(at+Vector3.new(x+.10,.08,-.36))*CFrame.Angles(0,0,math.rad(40))
            sphere("Ось стрелки",.09,Vector3.new(x,0,-.37),light)
        end
    elseif itemId=="velour_mats" or itemId=="mats" then
        for side=-1,1,2 do
            local x=side*.64
            box("Велюровый коврик",Vector3.new(1.02,.13,1.53),Vector3.new(x,-.28,0),color,Enum.Material.Fabric)
            box("Окантовка коврика",Vector3.new(.86,.04,1.38),Vector3.new(x,-.20,0),dark,Enum.Material.Fabric)
            for j=-1,1 do
                box("Рельефная прострочка",Vector3.new(.06,.04,1.00),Vector3.new(x+j*.27,-.16,0),steel)
            end
        end
    elseif itemId=="seat_covers" or itemId=="cover_basic" or itemId=="leather" then
        for side=-1,1,2 do
            local x=side*.70
            box("Сиденье подушка",Vector3.new(1.02,.29,.94),Vector3.new(x,-.48,.21),color,Enum.Material.Fabric)
            local back=box("Чехол спинки",Vector3.new(.99,1.34,.23),Vector3.new(x,.23,.49),color,Enum.Material.Fabric)
            back.CFrame=CFrame.new(at+Vector3.new(x,.23,.49))*CFrame.Angles(math.rad(-7),0,0)
            box("Подголовник",Vector3.new(.64,.36,.26),Vector3.new(x,.89,.47),dark,Enum.Material.Fabric)
            box("Шов чехла",Vector3.new(.62,.04,.10),Vector3.new(x,.27,.31),steel)
        end
    elseif itemId=="sport_wheel" or itemId=="carbon_wheel" then
        -- True open twelve-segment steering rim rather than an opaque flat cylinder.
        ring("Оплётка спортивного руля",.80,dark)
        for j=0,2 do
            local theta=j*2*math.pi/3
            local x=.37*math.cos(theta)
            local y=.37*math.sin(theta)
            local spoke=box("Спица руля",Vector3.new(.64,.15,.14),Vector3.new(x,y,-.45),steel,Enum.Material.Metal)
            spoke.CFrame=CFrame.new(at+Vector3.new(x,y,-.45))*CFrame.Angles(0,0,theta)
        end
        frontDisc("Центральная ступица руля",.54,.19,Vector3.new(0,0,-.49),color)
        frontDisc("Кнопка сигнала",.23,.12,Vector3.new(0,0,-.62),dark)
    elseif itemId=="dash_camera" then
        box("Корпус видеорегистратора",Vector3.new(1.72,.71,.65),Vector3.new(0,-.04,.07),dark)
        frontDisc("Кольцо объектива",.53,.15,Vector3.new(.39,-.05,-.32),steel)
        frontDisc("Линза",.30,.12,Vector3.new(.39,-.05,-.43),Color3.fromRGB(31,91,139))
        box("Экран камеры",Vector3.new(.60,.38,.06),Vector3.new(-.50,-.06,-.32),color)
        box("Крепёж к стеклу",Vector3.new(.24,.43,.22),Vector3.new(0,.47,.06),steel)
        box("Присоска",Vector3.new(.95,.13,.55),Vector3.new(0,.76,.08),dark)
    elseif itemId=="carbon_kit" or itemId=="gold_kit" then
        local isGold=itemId=="gold_kit"
        local trim=isGold and Color3.fromRGB(245,199,69) or Color3.fromRGB(89,101,110)
        box("Передний сплиттер",Vector3.new(2.90,.16,.82),Vector3.new(0,-.46,.05),trim,Enum.Material.Metal)
        box("Аэродинамический плавник",Vector3.new(.18,.73,.57),Vector3.new(-.90,-.05,0),dark,Enum.Material.Metal)
        box("Крыло спойлера",Vector3.new(2.42,.15,.58),Vector3.new(0,.54,-.10),trim,Enum.Material.Metal)
        for side=-1,1,2 do
            box("Опора спойлера",Vector3.new(.13,.61,.14),Vector3.new(side*.70,.19,.09),dark)
        end
    else
        box("Корпус аксессуара",Vector3.new(1.82,1.12,.75),Vector3.zero,color,Enum.Material.Metal)
        box("Фасад",Vector3.new(1.44,.70,.12),Vector3.new(0,0,-.46),dark)
    end
    -- Star accessories stand along the LEFT wall (looking toward +X), whereas
    -- passive-income shelves face the salon entrance. Both use the same shapes.
    if yaw and math.abs(yaw)&gt;.001 then
        local center=CFrame.new(at)
        local rotation=CFrame.Angles(0,yaw,0)
        for _,piece in ipairs(group:GetDescendants()) do
            if piece:IsA("BasePart") then
                piece.CFrame=center*rotation*center:ToObjectSpace(piece.CFrame)
            end
        end
    end

end

local function renderShelf(rec)
    local data=DataService.get(rec.player)
    if not data or not rec.shelfFolder then return end
    ensureShelfSlots(data)
    local sigItems={tostring(data.shelfCapacity)}
    for _,item in ipairs(data.shelf) do
        table.insert(sigItems,tostring(item.id)..":"..tostring((data.lootRanks or {})[item.id] or 0))
    end
    local signature=table.concat(sigItems,"|")
    if rec.lastShelfRenderSignature==signature then return end
    rec.lastShelfRenderSignature=signature
    rec.shelfFolder:ClearAllChildren()
    local count=math.min(#data.shelf,data.shelfCapacity)
    local cols=6
    local rows=math.min(3,math.ceil(data.shelfCapacity/cols))
    local rich=Color3.fromRGB(255,207,101)
    for row=0,rows-1 do
        P.part(rec.shelfFolder,"Полка дохода_"..row,Vector3.new(62,.38,3.0),
            toWorld(rec,0,40,2.20+row*2.62),Color3.fromRGB(93,66,54),Enum.Material.Wood,false)
    end
    for i,item in ipairs(data.shelf) do
        if i&gt;rows*cols then break end
        local def=Loot.ById[item.id]
        if def then
            local row=math.floor((i-1)/cols)
            local col=(i-1)%cols
            local at=toWorld(rec,-27+col*10.8,39.3,3.35+row*2.62)
            local color=Rarity.Info[def.rarity].color
            local function shape(name,size,offset,c,material)
                return P.part(rec.shelfFolder,name,size,at+offset,c or color,
                    material or Enum.Material.SmoothPlastic,false)
            end
            local shelfVisuals={
                tree_fresh="tree_fresh",cover_basic="cover_basic",mats="mats",
                radio_old="radio_old",radio_fm="radio_fm",subwoofer="subwoofer",
                neon_kit="neon_kit",leather="leather",carbon_wheel="carbon_wheel",
                multimedia="multimedia",carbon_kit="carbon_kit",gold_kit="gold_kit"
            }
            makeNativeCollectible(rec.shelfFolder,shelfVisuals[def.id] or def.id,at,color,
                true,rec.side&lt;0 and math.pi or 0)
            shape("Витринный пьедестал",Vector3.new(3.1,.18,1.85),Vector3.new(0,-.88,0),
                Color3.fromRGB(33,43,57),Enum.Material.Metal)
            shape("Световой кант редкости",Vector3.new(3.16,.06,1.90),Vector3.new(0,-.78,0),
                color,Enum.Material.Neon)
            local anchor=shape("Метка дохода",Vector3.new(.15,.15,.15),Vector3.new(0,.89,0),color)
            anchor.Transparency=1
            local bb=Instance.new("BillboardGui")
            bb.Name="Доход_"..def.id
            bb.Adornee=anchor
            bb.Size=UDim2.fromOffset(134,35)
            bb.StudsOffset=Vector3.new(0,.98,0)
            bb.MaxDistance=18
            bb.Parent=anchor
            local l=Instance.new("TextLabel")
            l.Size=UDim2.fromScale(1,1)
            l.BackgroundColor3=Color3.fromRGB(20,25,38)
            l.BackgroundTransparency=.12
            l.TextColor3=color
            l.Font=Enum.Font.GothamBold
            l.TextScaled=false
            l.TextSize=12
            l.TextWrapped=true
            local lvl=math.clamp(math.floor(tonumber((data.lootRanks or {})[item.id]) or 0),0,5)
            l.Text=def.name.." ★"..lvl.."/5\n+"..math.floor(def.income*(1+.2*lvl)+.5).." $/сек"
            l.Parent=bb
        end
    end
end

local function makeAccessoryVisual(folder,part,at,owned)
    makeNativeCollectible(folder,part.id,at,part.color,owned,-math.pi/2)
end

local function renderTheftAccessories(rec)
    if not rec or not rec.player then return end
    local data=DataService.get(rec.player)
    local folder=rec.theftAccessoryFolder
    if not data or not folder then return end
    local progress={}
    for _,part in ipairs(THEFT_PARTS) do
        local have,level,copies=AccessoryConfig.read((data.theftParts or {})[part.id])
        progress[#progress+1]=part.id..":"..tostring(have)..":"..level..":"..copies
    end
    table.insert(progress,"ORDER:"..table.concat(data.accessoryOrder or {},","))
    local signature=table.concat(progress,"|")
    if rec.lastAccessoryRenderSignature==signature then return end
    rec.lastAccessoryRenderSignature=signature
    folder:ClearAllChildren()
    local COLS=6
    -- Single left-hand trophy wall: six columns, two vertical levels.
    P.part(folder,"Стена коллекции",Vector3.new(.38,9.6,28.4),
        toWorld(rec,-30.3,23.5,5.1),Color3.fromRGB(26,39,54),Enum.Material.Metal,false)
    for row=0,math.ceil(#THEFT_PARTS/COLS)-1 do
        P.part(folder,"Полка коллекции "..(row+1),Vector3.new(3.2,.20,28),
            toWorld(rec,-28.6,23.5,2.0+row*4.35),Color3.fromRGB(49,65,80),Enum.Material.Metal,false)
    end
    local ordered={}
    local used={}
    for _,id in ipairs(data.accessoryOrder or {}) do
        local part=AccessoryConfig.ById[id]
        if part and not used[id] then table.insert(ordered,part);used[id]=true end
    end
    for _,part in ipairs(THEFT_PARTS) do
        if not used[part.id] then table.insert(ordered,part) end
    end
    for i,part in ipairs(ordered) do
        local have,level,copies=AccessoryConfig.read((data.theftParts or {})[part.id])
        local row=math.floor((i-1)/COLS)
        local col=(i-1)%COLS
        local pos=toWorld(rec,-28.1,12.0+col*4.6,3.2+row*4.35)
        local base=P.part(folder,"Стенд_"..part.id,Vector3.new(3.7,.30,2.7),
            pos+Vector3.new(0,-1.28,0),have and Color3.fromRGB(70,83,98) or Color3.fromRGB(47,48,54),Enum.Material.Metal,false)
        local frame=P.part(folder,"Коллекционная панель_"..part.id,Vector3.new(.22,2.7,4.05),
            pos+Vector3.new(-1.75,.14,0),Color3.fromRGB(29,41,54),Enum.Material.Metal,false)
        frame:SetAttribute("AccessoryId",part.id)
        P.part(folder,"Коллекционная подсветка_"..part.id,Vector3.new(2.3,.06,3.1),
            pos+Vector3.new(0,-1.08,0),have and part.color or Color3.fromRGB(68,75,84),
            Enum.Material.SmoothPlastic,false)
        makeAccessoryVisual(folder,part,pos,have)
        local anchor=P.part(folder,"Метка_"..part.id,Vector3.new(.18,.18,.18),pos+Vector3.new(0,.8,0),
            Color3.fromRGB(60,72,89),Enum.Material.SmoothPlastic,false)
        anchor.Transparency=1
        local bb=Instance.new("BillboardGui")
        bb.Name="PartLabel";bb.Adornee=anchor;bb.Size=UDim2.fromOffset(126,37)
        bb.StudsOffset=Vector3.new(0,.78,0);bb.MaxDistance=13;bb.Parent=anchor
        local label=Instance.new("TextLabel")
        label.Size=UDim2.fromScale(1,1)
        label.BackgroundTransparency=.18
        label.BackgroundColor3=Color3.fromRGB(15,21,31)
        label.TextColor3=have and Color3.fromRGB(240,245,251) or Color3.fromRGB(157,161,168)
        label.Font=Enum.Font.GothamSemibold
        label.TextScaled=false
        label.TextSize=11
        label.TextWrapped=true
        label.RichText=true
        if have and level&gt;=AccessoryConfig.MAX_LEVEL then
            label.TextStrokeTransparency=.18
            label.TextStrokeColor3=Color3.fromRGB(255,201,43)
            label.BackgroundColor3=Color3.fromRGB(61,47,20)
            P.part(folder,"Золотое свечение",Vector3.new(3.6,.08,2.6),
                pos+Vector3.new(0,-1.08,0),Color3.fromRGB(255,215,72),Enum.Material.Neon,false)
        end
        local pct=have and AccessoryConfig.bonusPct(part,level) or 0
        label.Text=part.name.."\n"..(have and ("+"..pct.."% · "..copies.."/5") or "не найдена")
        label.Parent=bb
        local round=Instance.new("UICorner");round.CornerRadius=UDim.new(0,7);round.Parent=label
        -- Five star tips. One tip lights for each duplicate; the next 5 turn a full star.
        if have and level&lt;AccessoryConfig.MAX_LEVEL then
            local tipColor=AccessoryConfig.stageColor(level)
            local tips={{.5,.01},{.94,.32},{.77,.91},{.23,.91},{.06,.32}}
            local cornerGui=Instance.new("BillboardGui")
            cornerGui.Name="FiveCorners";cornerGui.Adornee=base
            cornerGui.Size=UDim2.fromOffset(47,44)
            cornerGui.StudsOffset=Vector3.new(0,1.7,0)
            cornerGui.MaxDistance=13;cornerGui.Parent=base
            local star=Instance.new("TextLabel")
            star.Name="Звезда_пять_углов"
            star.AnchorPoint=Vector2.new(.5,.5)
            star.Position=UDim2.fromScale(.5,.51)
            star.Size=UDim2.fromOffset(28,28)
            star.BackgroundTransparency=1
            star.Text="☆"
            star.TextScaled=true
            star.TextColor3=Color3.fromRGB(121,128,142)
            star.Parent=cornerGui
            for t,pair in ipairs(tips) do
                local tlabel=Instance.new("TextLabel")
                tlabel.Name="Corner_"..t
                tlabel.AnchorPoint=Vector2.new(.5,.5)
                tlabel.Position=UDim2.fromScale(pair[1],pair[2])
                tlabel.Size=UDim2.fromOffset(13,13)
                tlabel.BackgroundTransparency=1
                tlabel.Text="◆";tlabel.TextScaled=true
                tlabel.Font=Enum.Font.GothamBold
                tlabel.TextColor3=t&lt;=copies and tipColor or Color3.fromRGB(64,75,88)
                tlabel.Parent=cornerGui
            end
        end
    end
end

local function refreshShowcase(rec)
    local data=DataService.get(rec.player)
    if not data or not rec.model then return end

    local wanted=displayList(data,rec.rideCarId,rec.player)
    local desired={}
    for slot,carId in ipairs(wanted) do
        local hiddenUntil=rec.hiddenDisplays and rec.hiddenDisplays[carId] or 0
        if os.clock()&gt;=hiddenUntil and Cars.ById[carId] and data.catalog[carId] then
            desired[slot]=carId
        end
    end

    -- Only replace CHANGED slots. Every unchanged car keeps its Roblox Instance,
    -- paint color, Highlight and prompt: no more blinking on normal refreshes.
    for slot,oldCar in pairs(rec.displays) do
        local id=desired[slot]
        local entry=id and data.catalog[id]
        if not oldCar.Parent or id~=oldCar:GetAttribute("CarId") or
            not entry or oldCar:GetAttribute("Rarity")~=entry.bestRarity or
            oldCar:GetAttribute("Variant")~=bestVariant(entry) then
            CarFactory.release(oldCar)
            rec.displays[slot]=nil
        end
    end
    for slot,carId in pairs(desired) do
        local car=rec.displays[slot]
        if car then
            -- Refresh only the robbery hold time; do not respawn/dress the vehicle.
            CarFactory.updateSalonSecurity(car,math.min(5,(data.upgrades.security or 0)+((data.coinUpgrades or {}).security or 0)))
        else
            local def=Cars.ById[carId]
            local entry=data.catalog[carId]
            if def and entry and rec.slotCFrames[slot] then
                car=CarFactory.acquire(def,def.class)
                CarFactory.dress(car,def,def.class,entry.bestRarity,bestVariant(entry),rng)
                car:SetAttribute("State","display")
                car:SetAttribute("OwnerId",rec.player.UserId)
                car:SetAttribute("SlotIndex",slot)
                CarFactory.setDisplay(car,math.min(5,(data.upgrades.security or 0)+((data.coinUpgrades or {}).security or 0)))
                car:PivotTo(rec.slotCFrames[slot])
                car.Parent=rec.model
                rec.displays[slot]=car
            end
        end
    end
end

----------------------------------------------------------------------
-- Поездка на машине с витрины и бот
----------------------------------------------------------------------
local function returnRide(rec,reason)
	if rec.botBusy or not rec.rideCar then
		return
	end
	rec.botBusy = true
	local car = rec.rideCar
	local data = DataService.get(rec.player)
	local speed = math.min(Settings.MaxCarSpeed, (70 + 8 * ((data and data.upgrades.botSpeed) or 0)+((data and data.coinUpgrades and data.coinUpgrades.botSpeed) or 0)*.7) * (Monetization.has(rec.player, "secondBot") and 1.35 or 1))

	local dest = {
		x = rec.px,
		laneZ = rec.side * 10,
		final = Vector3.new(rec.px, 0.5, rec.side * 50),
	}
	BotService.returnCar(car, dest, speed, function()
		CarFactory.release(car)
		rec.rideCar = nil
		rec.rideCarId = nil
		rec.botBusy = false
		refreshShowcase(rec)
		if reason=="hack"then Tutorial.event(rec.player,"helper_returned")end
		Net.notify(rec.player, "Помощник вернул машину в салон.", "good")
	end)
end

-- Other players may temporarily 'steal' a displayed car at the owner's salon.
-- No one obtains the victim's catalog entry, car instance or permanent vehicle rights.
local function stealFromSalon(thief, car)
    if theftBusy[thief] then return end
    theftBusy[thief] = true
    -- No waits in transaction below; the server validates everything atomically.
    local ownerId = car:GetAttribute("OwnerId")
    local owner = typeof(ownerId) == "number" and Players:GetPlayerByUserId(ownerId) or nil
    local rec = owner and salons[owner] or nil
    local thiefData = DataService.get(thief)
    local ownerData = owner and DataService.get(owner) or nil
    local now = os.time()

    local function denied(message)
        Net.notify(thief, message, "info")
        theftBusy[thief] = nil
    end
    if not rec or not thiefData or not ownerData or not owner.Parent or owner == thief then
        denied("В этом салоне сейчас нельзя совершить кражу.")
        return
    end
    if thiefData.botUnlocked ~= true then
        denied("Сначала соверши свой первый угон и доставь машину в салон!")
        return
    end
    local char = thief.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not root or not hum or hum.Health &lt;= 0 or hum.SeatPart or
            (root.Position-car:GetPivot().Position).Magnitude &gt; 16 then
        denied("Подойди к машине пешком, чтобы обчистить чужую витрину.")
        return
    end
    local slot = car:GetAttribute("SlotIndex")
    local carId = car:GetAttribute("CarId")
    if car:GetAttribute("State") ~= "display" or type(slot) ~= "number" or
            type(carId) ~= "string" or rec.displays[slot] ~= car then
        denied("Эта машина уже недоступна.")
        return
    end
    local availableAt = tonumber(thiefData.theftNextAt) or 0
    if now &lt; availableAt then
        denied(("Следующая кража через %d сек."):format(availableAt - now))
        return
    end
    if now &lt; (rec.theftProtectedUntil or 0) then
        denied(("Салон недавно ограбили. Защита ещё %d сек."):format(rec.theftProtectedUntil - now))
        return
    end
    local till = math.max(0, tonumber(ownerData.till) or 0)
    if till &lt; 50 then
        denied("В чужой кассе почти нет налички. Выбери другой салон.")
        return
    end

    local level = math.clamp(tonumber(thiefData.theftLevel) or 1, 1, 10)
    -- Guard's ONLY PvP effect is making the F-key hold longer.
    -- The stolen cash percentage depends on thief skill, never on guard level.
    local pct = math.clamp(.04 + .002*(level-1), .015, .06)
    local stolen = math.min(MAX_LOSS, math.floor(till * pct))
    if stolen &lt; 1 then
        denied("В кассе недостаточно денег для кражи.")
        return
    end

    -- Successful raid: exact sum is transferred from owner TILL to thief wallet.
    ownerData.till = math.max(0, till - stolen)
    thiefData.theftNextAt = now + THEFT_COOLDOWN
    rec.theftProtectedUntil = now + TARGET_PROTECTION
    DataService.addMoney(thief, stolen)
    thiefData.theftCount = math.max(0, math.floor(tonumber(thiefData.theftCount) or 0)) + 1
    local count = thiefData.theftCount
    local nextLevel = math.min(10, 1 + math.floor(count / 10))
    local levelUp = nextLevel &gt; level
    thiefData.theftLevel = nextLevel

    -- Temporarily remove ONE displayed car; the victim permanently keeps it in catalog.
    rec.hiddenDisplays[carId] = os.clock() + HIDE_SECONDS
    refreshShowcase(rec)
    task.delay(HIDE_SECONDS, function()
        if salons[owner] == rec and rec.hiddenDisplays[carId] then
            rec.hiddenDisplays[carId] = nil
            refreshShowcase(rec)
            Net.notify(owner, "Машина вернулась на витрину. Коллекция не пострадала.", "good")
        end
    end)

    local partText = ""
    if count % 50 == 0 then
        local drop = AccessoryConfig.award(thiefData, rng, thiefData.lastHeistZone or 1)
        if drop then
            renderTheftAccessories(salons[thief] or {})
            partText = " · " .. AccessoryConfig.dropMessage(drop)
        else
            partText = " · Коллекция полностью прокачана"
        end
    end
    theftAttributes(thief, thiefData)
    if rec.tillLabel then rec.tillLabel.Text = "КАССА\n$ " .. fmt(ownerData.till) end
    Net.notify(thief, ("УДАЧНАЯ КРАЖА! +%s $ · %d/50 до детали%s%s"):format(
        fmt(stolen), count % 50, levelUp and (" · ВОРОВСТВО УР. "..nextLevel) or "", partText), "good")
    Net.notify(owner, ("НАЛЁТ НА САЛОН! Машина исчезла на %d сек., из кассы пропало %s $. "):format(
        HIDE_SECONDS, fmt(stolen)), "bad")
    theftBusy[thief] = nil
end

local function takeRide(player, car)
	local rec = salons[player]
    if car:GetAttribute("OwnerId") ~= player.UserId then
        Net.notify(player,"Чужой автомобиль: удерживай E для кражи. Охрана увеличивает время.","info")
        return
    end
    if not rec then return end
    local data = DataService.get(player)
    if not data or data.botUnlocked ~= true then
        Net.notify(player, "Сначала добеги пешком до первой машины и доставь её. Тогда откроется помощник!", "info")
        return
    end
	if rec.rideCar then
		Net.notify(player, "У тебя уже есть машина. Сначала верни её.", "bad")
		return
	end
	if DeliveryService.getCarrying(player) then
		return
	end
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not data or not hum then
        return
    end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp or (hrp.Position - car:GetPivot().Position).Magnitude &gt; 20 then return end

    local idx = car:GetAttribute("SlotIndex")
	rec.displays[idx] = nil
	rec.rideCar = car
	rec.rideCarId = car:GetAttribute("CarId")
	rec.rideLastOccupied = os.clock()
	car:SetAttribute("State", "ride")
	car:SetAttribute("DriverId", player.UserId)
	CarFactory.setRide(car)
	car.Parent = ridesFolder

    -- A display car is not physically drivable inside the glass showroom.
    -- Put it on the asphalt (away from display pads and walls) before seating.
    -- Road points toward positive X = the districts.
    local launchZ = rec.side * 12
    local launchX = rec.px + 5
    car:PivotTo(CFrame.new(launchX, 0.95, launchZ))
    local root = char:FindFirstChild("HumanoidRootPart")
    if root then root.AssemblyLinearVelocity = Vector3.zero end
	local seat = DriveService.enable(car, DriveService.maxSpeedFor(data, player))
	if seat then
        -- Seat:Sit may be ignored when the character is still in the showroom.
        -- Move the avatar near the new road seat first, then request seating.
        char:PivotTo(seat.CFrame * CFrame.new(0, 2.3, 0))
		seat:Sit(hum)
        task.delay(.3, function()
            if seat.Parent and hum.Parent and hum.SeatPart ~= seat and not hum.Sit then
                seat:Sit(hum)
            end
        end)
        task.spawn(function()
            for _=1,10 do
                if not player.Parent or not seat.Parent or player.Character~=char then return end
                if hum.SeatPart==seat then Tutorial.event(player,"ride_started");return end
                task.wait(.2)
            end
            if rec.rideCar==car and not rec.botBusy then returnRide(rec,"seat_failed")end
        end)
    else
        -- Avoid leaving the player's record blocked if car rig failed to spawn.
        rec.rideCar = nil
        rec.rideCarId = nil
        CarFactory.release(car)
        Net.notify(player, "Ошибка запуска машины. Попробуй ещё раз.", "bad")
	end
	refreshShowcase(rec) -- на освободившееся место встанет другая машина
	Net.notify(player, "Машина на дороге! W/S — газ, A/D — руль. Во время следующего взлома помощник вернёт её домой.", "info")
end

-- If police catch the owner after a failed lock, dismiss any personal ride.
-- Catalog stays permanent. This also prevents respawning inside a VehicleSeat.
function SalonService.onArrested(player)
    local rec = salons[player]
    if not rec or not rec.rideCar or rec.botBusy then return end
    local car = rec.rideCar
    rec.rideCar = nil
    rec.rideCarId = nil
    rec.rideLastOccupied = nil
    DriveService.disable(car) -- remove seat, welds and forces before pooling
    CarFactory.release(car)
    refreshShowcase(rec)
    Tutorial.event(player,"ride_lost")
end

-- Помощник начинает возврат предыдущей машины именно во время взлома
-- следующей машины, а не после его успешного завершения.
function SalonService.onHackStarted(player)
    local rec = salons[player]
    local data = DataService.get(player)
    if rec and rec.rideCar and not rec.botBusy and data and data.botUnlocked == true then
        returnRide(rec,"hack")
        Net.notify(player,"Помощник забирает твою машину. Дождись её возвращения.","good")
    end
end
-- Обратная совместимость для возможных старых вызовов.
SalonService.onStolen = SalonService.onHackStarted

----------------------------------------------------------------------
-- Вскрытие машины: «яйцо» с сюрпризом
----------------------------------------------------------------------
local function pickItem(rarity, classOrder)
    local zone=math.clamp(math.floor(tonumber(classOrder) or 1),1,5)
    for i = RARITY_INDEX[rarity], 1, -1 do
        local r = Rarity.Order[i]
        local pool = {}
        for _,item in ipairs(Loot) do
            if item.zone==zone and item.rarity==r then table.insert(pool,item) end
        end
        if #pool&gt;0 then return pool[rng:NextInteger(1,#pool)] end
    end
    local fallback={}
    for _,item in ipairs(Loot) do if item.zone==zone then table.insert(fallback,item) end end
    return #fallback&gt;0 and fallback[rng:NextInteger(1,#fallback)] or nil
end

function SalonService.openCar(player, info, isNew, carReward)
	local data = DataService.get(player)
	local rec = salons[player]
	if not data or not rec then
		return
	end
	local classDef = CarClasses[info.classId]
	local carDef = Cars.ById[info.carId]
	local entry = data.catalog[info.carId]

	-- повторный угон: каждая третья копия даёт звезду (больше предметов и доход)
	local gotStar = false
	if entry and not isNew and entry.count % 3 == 0 and (entry.stars or 0) &lt; 5 then
		entry.stars = (entry.stars or 0) + 1
		gotStar = true
	end

	local rolls = classDef.lootRolls + ((entry and entry.stars) or 0)
	local revealed = {}
	for roll = 1, rolls do
		local itemRarity = Rarity.roll(Loot.WeightsByCarRarity[info.rarity], rng)
        local tutorialDrop=roll==1 and Tutorial.lootOverride(player,classDef.order)or nil
		local item = tutorialDrop or pickItem(itemRarity, classDef.order)
		if item then
			local line = { name = item.name, rarity = item.rarity, income = item.income, sold = false, soldFor = 0 }
            ensureShelfSlots(data)
            data.lootCopies=data.lootCopies or {}
            data.lootCopies[item.id]=(tonumber(data.lootCopies[item.id]) or 0)+1
            if tutorialDrop then Tutorial.usedLootOverride(player)end
            local newItem={id=item.id,rarity=item.rarity}
            local empty=emptySlotIndex(data)
            if empty then
                data.shelf[empty]=newItem
            else
                -- Filled wall: equip a stronger drop, sending the displaced one
                -- to the actual storage if space is available.
                local worstIdx,worstIncome=nil,math.huge
                for i,it in ipairs(data.shelf) do
                    local d=Loot.ById[it.id]
                    local lvl=math.clamp(math.floor(tonumber((data.lootRanks or {})[it.id]) or 0),0,5)
                    local earning=d and d.income*(1+.20*lvl) or 0
                    if d and earning&lt;worstIncome then worstIdx,worstIncome=i,earning end
                end
                if worstIdx and item.income&gt;worstIncome then
                    local previous=data.shelf[worstIdx]
                    if not storeItem(data,previous) then
                        local old=Loot.ById[previous.id]
                        DataService.addMoney(player,old.income*20)
                    end
                    data.shelf[worstIdx]=newItem
                elseif storeItem(data,newItem) then
                    line.stored=true
                else
                    line.sold=true
                    line.soldFor=item.income*20
                    DataService.addMoney(player,line.soldFor)
                end
            end
			table.insert(revealed, line)
		end
	end

	renderShelf(rec)
	refreshShowcase(rec)
	Net.LootReveal:FireClient(player, {
		carName = carDef and carDef.name or "Машина",
		carRarity = info.rarity,
		isNew = isNew,
		gotStar = gotStar,
		items = revealed,
	})
end

----------------------------------------------------------------------
-- Меню (данные для клиента)
----------------------------------------------------------------------
local function menuData(player)
	local data = DataService.get(player)
	local rec = salons[player]
	if not data then
		return nil
	end

	local catalog = {}
    local display=displayList(data,rec and rec.rideCarId or nil,player)
	local owned = 0
	for _, def in ipairs(Cars) do
		local e = data.catalog[def.id]
		if e then
			owned += 1
		end
		table.insert(catalog, {
			id = def.id,
			name = def.name,
			className = CarClasses[def.class].name,
			order = CarClasses[def.class].order,
			owned = e ~= nil,
			count = e and e.count or 0,
			stars = e and e.stars or 0,
			bestRarity = e and e.bestRarity or nil,
            pinned = table.find(data.showcase.pinned, def.id) ~= nil,
            displaySlot = table.find(display, def.id),
            valueScore = e and math.floor((CarClasses[def.class].baseValue or 1)
                *(Rarity.Info[e.bestRarity] and Rarity.Info[e.bestRarity].incomeMult or 1)
                *(VARIANT_MULT[bestVariant(e)] or 1)*(1+.25*(e.stars or 0))) or 0,
		})
	end

    ensureShelfSlots(data)
    local shelf={}
    for index=1,math.max(#data.shelf,data.shelfCapacity) do
        local it=data.shelf[index]
        local d=it and Loot.ById[it.id]
        if d then
            local lvl=math.clamp(math.floor(tonumber((data.lootRanks or {})[it.id]) or 0),0,5)
            shelf[index]={slot=index,id=it.id,name=d.name,rarity=d.rarity,income=math.floor(d.income*(1+.2*lvl)+.5),baseIncome=d.income,stars=lvl,copies=(data.lootCopies or {})[it.id] or 0,cost=math.floor((80+d.income*35)*1.75^lvl+0.5),zone=d.zone}
        elseif it and it.id~=EMPTY_SLOT then
            -- Preserve unknown item IDs from future / older content releases.
            shelf[index]={slot=index,locked=true,id=it.id,name="Предмет другого обновления",income=0}
        else
            shelf[index]={slot=index,empty=true}
        end
    end
    local storage={}
    for index,it in ipairs(data.shelfStorage or {}) do
        local d=Loot.ById[it.id]
        if d then
            local lvl=math.clamp(math.floor(tonumber((data.lootRanks or {})[it.id]) or 0),0,5)
            storage[#storage+1]={slot=index,id=it.id,name=d.name,rarity=d.rarity,income=math.floor(d.income*(1+.2*lvl)+.5),stars=lvl,zone=d.zone}
        end
    end
    local upgrades = {}
    for _, def in ipairs(Upgrade) do
        local level = data.upgrades[def.id] or 0
        table.insert(upgrades, {
            id = def.id, name = def.name, description = def.description,
            level = level, max = def.max, cost = Upgrade.cost(def.id, level),
        })
    end
    return {
        catalog = catalog,
		owned = owned,
		total = #Cars,
		pinnedCount = #data.showcase.pinned,
        slots = Monetization.showcaseSlots(player),
        money = data.money,
        diamonds = data.diamonds or 0,
        cosmeticsOwned = data.cosmeticsOwned or {},
        cosmeticsEquipped = data.cosmeticsEquipped or {},
        carCosmetics = data.carCosmetics or {},
        heroSkinBonusLevel = math.clamp(math.floor(tonumber(data.heroSkinBonusLevel) or 0),0,10),
        petBonusLevel = math.clamp(math.floor(tonumber(data.petBonusLevel) or 0),0,50),
        petUnlocked = data.petUnlocked == true or (function()
            for id,owned in pairs(data.cosmeticsOwned or {}) do
                local def=CosmeticConfig.ById[id]
                if owned==true and def and def.category=="pet" then return true end
            end
            return false
        end)(),
        vipUntil = math.clamp(math.floor(tonumber(data.vipUntil) or 0),0,4102444800),
        vipPermanent = Monetization.has(player,"vip"),
        vipActive = Monetization.vipStatus(player),
        vipCoinBonus = VIPConfig.BONUS_COINS_PCT,
        vipXPBonus = VIPConfig.BONUS_XP_PCT,
        coinUpgrades=(function()
            local list={}
            for _,def in ipairs(CoinUpgrade) do
                local level=math.clamp(math.floor(tonumber((data.coinUpgrades or {})[def.id]) or 0),0,def.max)
                local total=def.id=="security" and math.min(5,level+math.floor(tonumber((data.upgrades or {}).security) or 0)) or level
                local price=total&gt;=def.max and nil or CoinUpgrade.cost(def.id,level)
                table.insert(list,{id=def.id,name=def.name,detail=def.detail,icon=def.icon,level=total,max=def.max,cost=price,coinLevel=level})
            end
            return list
        end)(),
        hackLevel = data.hackLevel,
        masterKeyTokens = data.masterKeyTokens or 0,
        boostSeconds = math.max(0, (data.boostUntil or 0) - os.time()),
        upgrades = upgrades,
        passes = Monetization.ownedPasses(player),
		shelf = shelf,
        shelfStorage = storage,
        shelfStorageMax = STORAGE_MAX,
		shelfCapacity = data.shelfCapacity,
        income = computeIncome(data,player),
        till = data.till,
        tillHours = Monetization.tillHours(player),
        tillCapacity = math.floor(tillCapacity(data,player)),
		plot = rec and rec.plotIndex or 0,
        theftCount = data.theftCount or 0,
        theftLevel = data.theftLevel or 1,
        theftNextAt = data.theftNextAt or 0,
        theftIncomeBonusPct = math.floor(partIncomeBoost(data)*100+.5),
        theftParts = AccessoryConfig.listForClient(data),
        accessoryOrder = data.accessoryOrder or {},
        lootCopies = data.lootCopies or {},
        accessoryCount = #AccessoryConfig.List,
	}
end

-- NPC workshop actions: client can request only validated swaps/upgrades.
local lastWorkshopAction={}
local function manageWorkshop(player,action,a,b)
    if typeof(action)~="string" then return end
    if os.clock()-(lastWorkshopAction[player] or 0)&lt;.2 then return end
    lastWorkshopAction[player]=os.clock()
    local data=DataService.get(player)
    if not data or not salons[player] then return end
    ensureShelfSlots(data)
    if action=="storeShelf" then
        if typeof(a)~="number" or a%1~=0 or a&lt;1 or a&gt;#data.shelf then return end
        local item=data.shelf[a]
        if not item or not Loot.ById[item.id] then return end
        if not storeItem(data,item) then
            Net.notify(player,"Хранилище заполнено (48 предметов).","bad")
            return
        end
        data.shelf[a]={id=EMPTY_SLOT}
        Tutorial.event(player,"store_item",item.id)
        renderShelf(salons[player])
        Net.notify(player,("%s отправлен в инвентарь. Позиция %d свободна."):format(Loot.ById[item.id].name,a),"good")
    elseif action=="placeShelf" then
        if typeof(a)~="number" or a%1~=0 or typeof(b)~="number" or b%1~=0 then return end
        if a&lt;1 or a&gt;#data.shelf or b&lt;1 or b&gt;#data.shelfStorage then return end
        if not data.shelf[a] or data.shelf[a].id~=EMPTY_SLOT then
            Net.notify(player,"Сначала освободи место или поменяй предметы местами.","bad")
            return
        end
        local item=data.shelfStorage[b]
        if not item or not Loot.ById[item.id] then return end
        data.shelf[a]=item
        table.remove(data.shelfStorage,b)
        Tutorial.event(player,"place_item",item.id)
        renderShelf(salons[player])
        Net.notify(player,("%s установлен в позицию %d."):format(Loot.ById[item.id].name,a),"good")
    elseif action=="swapShelf" then
        if typeof(a)~="number" or typeof(b)~="number" or a%1~=0 or b%1~=0 or a==b then return end
        if a&lt;1 or b&lt;1 or a&gt;#data.shelf or b&gt;#data.shelf then return end
        if data.shelf[a].id==data.shelf[b].id then
            Net.notify(player,"В этих позициях одинаковые предметы — внешне ничего не изменится.","info")
        else
            data.shelf[a],data.shelf[b]=data.shelf[b],data.shelf[a]
            renderShelf(salons[player])
            Net.notify(player,("Предметы на полках %d и %d поменяны местами."):format(a,b),"good")
        end
    elseif action=="swapAccessories" then
        if typeof(a)~="string" or typeof(b)~="string" or a==b or not AccessoryConfig.ById[a] or not AccessoryConfig.ById[b] then return end
        local order={}
        local used={}
        for _,id in ipairs(data.accessoryOrder or {}) do
            if AccessoryConfig.ById[id] and not used[id] then table.insert(order,id);used[id]=true end
        end
        for _,def in ipairs(THEFT_PARTS) do if not used[def.id] then table.insert(order,def.id) end end
        local i,j=table.find(order,a),table.find(order,b)
        if not i or not j then return end
        order[i],order[j]=order[j],order[i]
        data.accessoryOrder=order
        renderTheftAccessories(salons[player])
        Net.notify(player,"Коллекционные детали переставлены.","good")
    elseif action=="upgradeShelf" then
        if typeof(a)~="string" then return end
        local def=Loot.ById[a]
        if not def then return end
        local owned=false
        for _,it in ipairs(data.shelf) do if it.id==a then owned=true;break end end
        if not owned then
            for _,it in ipairs(data.shelfStorage or {}) do if it.id==a then owned=true;break end end
        end
        if not owned then return end
        data.lootRanks=data.lootRanks or {}
        data.lootCopies=data.lootCopies or {}
        local level=math.clamp(math.floor(tonumber(data.lootRanks[a]) or 0),0,5)
        if level&gt;=5 then Net.notify(player,"Этот предмет достиг 5 золотых звёзд.","info") return end
        if (tonumber(data.lootCopies[a]) or 0)&lt;5 then
            Net.notify(player,"Для звезды нужно собрать 5 одинаковых предметов.","info")
            return
        end
        local cost=math.floor((80+def.income*35)*1.75^level+.5)
        if not DataService.spendMoney(player,cost) then
            Net.notify(player,("Нужно %d $ для улучшения предмета."):format(cost),"bad") return
        end
        data.lootCopies[a]-=5
        data.lootRanks[a]=level+1
        Tutorial.sync(player,true)
        renderShelf(salons[player])
        Net.notify(player,("%s: ★ %d/5 · +%d%% дохода предмета!"):format(def.name,level+1,20*(level+1)),"good")
    end
    if Net.CurrencyUpdate then Net.CurrencyUpdate:FireClient(player,data.diamonds or 0) end
end

local function onPin(player, carId)
	if typeof(carId) ~= "string" then
		return
	end
	local data = DataService.get(player)
	local rec = salons[player]
	if not data or not rec or not data.catalog[carId] then
		return
	end
	local pinned = data.showcase.pinned
	local idx = table.find(pinned, carId)
	if idx then
		table.remove(pinned, idx)
	else
		if #pinned &gt;= Monetization.showcaseSlots(player) then
			Net.notify(player, "Все слоты витрины заняты закреплёнными машинами.", "bad")
			return
		end
		table.insert(pinned, carId)
	end
	refreshShowcase(rec)
    Tutorial.sync(player,true)
end

----------------------------------------------------------------------
-- Участки игроков
----------------------------------------------------------------------
local function plotPad(idx)
	local core = Workspace:FindFirstChild("TrackCore")
	local plots = core and core:FindFirstChild("SalonPlots")
	return plots and plots:FindFirstChild("SalonPlot_" .. idx)
end

local function setPlotLabel(idx, text)
	local pad = plotPad(idx)
	local bb = pad and pad:FindFirstChildOfClass("BillboardGui")
	local label = bb and bb:FindFirstChildOfClass("TextLabel")
	if label then
		label.Text = text
	end
end

local function teardown(player)
	local rec = salons[player]
	if not rec then
		return
	end
	salons[player] = nil
    DeliveryService.clearDestination(player)
	plotTaken[rec.plotIndex] = nil
	for _, car in pairs(rec.displays) do
		CarFactory.release(car)
	end
	if rec.rideCar then
		DriveService.disable(rec.rideCar)
		CarFactory.release(rec.rideCar)
	end
	if rec.model then
		rec.model:Destroy()
	end
	setPlotLabel(rec.plotIndex, "САЛОН " .. rec.plotIndex)
end

-- Decorative patrol around the walls, without diagonal wandering, collisions
-- or interfering with players. Stops, faces the next corridor, then walks.
local function startGuardPatrol(rec)
    local rig=rec.guardModel
    if not rig then return end
    rec.guardPatrolActive=true
    rig:SetAttribute("PatrolActive",true)
    local root=rec.guardOriginalPivot
    local rootY=root.Position.Y
    -- Perimeter corridors are axis-aligned and leave the center unobstructed.
    -- All movements are WORLD coordinates transformed from salon local space.
    local points={
        {-26,15}, {-26,39}, {26,39}, {26,15},
    }
    local phase=0
    local facing=0
    local function angleDelta(from,to)
        return (to-from+math.pi)%(2*math.pi)-math.pi
    end
    local function pivotAt(at,yaw,bob)
        rig:PivotTo(CFrame.new(at.X,rootY+(bob or 0),at.Z)*CFrame.Angles(0,yaw,0))
    end
    task.spawn(function()
        local index=1
        local startPosition=toWorld(rec,points[1][1],points[1][2],0)
        pivotAt(startPosition,facing,0)
        while salons[rec.player]==rec and rig.Parent and rec.model==rig.Parent do
            local a=points[index]
            local b=points[index%#points+1]
            local from=toWorld(rec,a[1],a[2],0)
            local dest=toWorld(rec,b[1],b[2],0)
            local direction=(dest-from).Unit
            local desiredYaw=math.atan2(-direction.X,-direction.Z) -- visor and security badge face -Z; face actual travel
            -- TURN IN PLACE rather than drifting diagonally while rotating.
            local change=angleDelta(facing,desiredYaw)
            local turnDuration=math.max(.20,math.abs(change)/2.6)
            local turnStart=os.clock()
            repeat
                if salons[rec.player]~=rec or not rig.Parent then return end
                local f=math.min(1,(os.clock()-turnStart)/turnDuration)
                f=f*f*(3-2*f)
                pivotAt(from,facing+change*f,0)
                task.wait(.04)
            until os.clock()-turnStart&gt;=turnDuration
            facing=desiredYaw
            task.wait(.22) -- stop after turning, before walking
            local distance=(dest-from).Magnitude
            local duration=distance/6.3
            local started=os.clock()
            repeat
                if salons[rec.player]~=rec or not rig.Parent then return end
                local elapsed=os.clock()-started
                local f=math.min(1,elapsed/duration)
                local at=from:Lerp(dest,f)
                local bob=.095*math.abs(math.sin(elapsed*9.0))
                pivotAt(at,facing,bob)
                -- Opposing arm/leg swing; animation never changes root position.
                for i,limb in ipairs(rec.guardSwingParts or {}) do
                    if limb and limb.Parent then
                        local sign=(i==1 or i==4) and 1 or -1
                        local swing=sign*.46*math.sin(elapsed*9.0)
                        local pivot=rig:GetPivot()
                        limb.CFrame=pivot*rec.guardSwingOffsets[i]*CFrame.Angles(swing,0,0)
                    end
                end
                task.wait(.05)
            until os.clock()-started&gt;=duration
            pivotAt(dest,facing,0)
            rig:SetAttribute("PatrolPoint",index)
            -- At the counter, pause longer, like checking the register.
            task.wait(index==2 and 1.6 or .75)
            index=index%#points+1
        end
    end)
end

local function assign(player, data)
    if not data.botUnlocked and next(data.catalog or {}) ~= nil then
        data.botUnlocked = true
    end
    player:SetAttribute("HelperUnlocked", data.botUnlocked == true)
    player:SetAttribute("LastHeistZone",math.clamp(math.floor(tonumber(data.lastHeistZone) or 1),1,5))
    local idx
	for i = 1, Settings.MaxPlayers do
		if not plotTaken[i] and plotPad(i) then
			idx = i
			break
		end
	end
	if not idx then
		Net.notify(player, "Свободных участков под салон нет.", "bad")
		return
	end

	local pad = plotPad(idx)
	plotTaken[idx] = player
	local rec = {
		player = player,
		plotIndex = idx,
        onboardingVeteran = next(data.catalog or{})~=nil,
		px = pad.Position.X,
		side = pad.Position.Z &gt;= 0 and 1 or -1,
		displays = {},
		slotCFrames = {},
		nextRaid = os.clock() + rng:NextNumber(180, 300),
		raidActive = false,
		botBusy = false,
        hiddenDisplays = {},
        theftProtectedUntil = 0,
		rideLastOccupied = os.clock(),
        nextAutoCollect = os.clock() + 15,
	}
	salons[player] = rec
    DeliveryService.setDestination(player, Vector3.new(rec.px, .35, rec.side * 25), rec.side, idx)

	buildSalon(rec)
    Tutorial.bind(player,{
        hasRide=function()return rec.rideCar~=nil or rec.botBusy end,
        zones=(function()
            local points={};local layout=require(Shared.TrackLayout)
            for zone=1,5 do points[zone]=Vector3.new(layout.districtStart(zone)+Settings.Track.DistrictLength/8,2,Settings.Track.RoadHalfWidth+Settings.Track.ParkingWidth/2)end
            return points
        end)(),
        starter=Vector3.new(require(Shared.TrackLayout).districtStart(1)+Settings.Track.DistrictLength/8,2,Settings.Track.RoadHalfWidth+Settings.Track.ParkingWidth/2),delivery=Vector3.new(rec.px,1,rec.side*25),
        shelf=toWorld(rec,-26,27,2),till=rec.tillPos,showcase=toWorld(rec,0,0,2),
        workshop=toWorld(rec,0,36,2),coins=toWorld(rec,-20,26,2),
        diamonds=toWorld(rec,20,26,2),cosmetics=toWorld(rec,-12,36,2),
    })
    startGuardPatrol(rec)
	player:SetAttribute("PlotIndex", idx)
	setPlotLabel(idx, ("САЛОН %d · %s"):format(idx, player.DisplayName))
	renderShelf(rec)
    renderTheftAccessories(rec)
    theftAttributes(player, data)
    SalonService.refresh(player)

    -- Check permanent VIP/till passes BEFORE crediting offline earnings.
    -- 12h standard; 48h VIP or independent till pass. Accrues at full rate.
    Monetization.checkTillPasses(player)
    if data.lastSeen and data.lastSeen&gt;0 then
        local now=os.time()
        local away=math.clamp(now-data.lastSeen,0,48*3600)
        local started=now-away
        local expires=math.floor(tonumber(data.vipUntil) or 0)
        local earned,hours=0,Monetization.tillHours(player)
        if Monetization.tillHours(player,started)==48 and Monetization.tillHours(player,now)==12
           and expires&gt;started and expires&lt;now then
            local vipSeconds=math.clamp(expires-started,0,away)
            local vipEarned=accrueTill(data,player,vipSeconds,48)
            local regularEarned=accrueTill(data,player,away-vipSeconds,12)
            earned=vipEarned+regularEarned
        else
            earned=accrueTill(data,player,away,Monetization.tillHours(player,started))
        end
        if earned&gt;=1 then
            Net.notify(player,("Офлайн-касса +%s · накопление до %d ч."):format(fmt(earned),hours),"good")
        end
    end

	-- появляемся у своего салона
	local function toSalon(char)
		task.wait(0.2)
		if char.Parent and salons[player] == rec then
			char:PivotTo(CFrame.new(rec.px, 5, rec.side * 36))
		end
	end
	player.CharacterAdded:Connect(toSalon)
	if player.Character then
		task.spawn(toSalon, player.Character)
	end
end

function SalonService.refresh(player)
    local rec = salons[player]
    if rec then
        local data=DataService.get(player)
        if data and rec.guardLevelText then
            local level=math.clamp(math.floor(tonumber((data.upgrades or {}).security) or 0)+math.floor(tonumber((data.coinUpgrades or {}).security) or 0),0,5)
            rec.guardLevelText.Text=("ОХРАНА · %d/5"):format(level)
            rec.guardLevelText.TextColor3=level&gt;=5 and Color3.fromRGB(255,224,126) or Color3.fromRGB(158,226,249)
            if rec.guardBadge then
                rec.guardBadge.Color=level&gt;=4 and Color3.fromRGB(243,199,95) or Color3.fromRGB(181,219,230)
                rec.guardBadge.Material=level&gt;=4 and Enum.Material.Neon or Enum.Material.Metal
            end
            rec.guardModel:SetAttribute("SecurityLevel",level)
        end
        refreshShowcase(rec)
        renderShelf(rec)
        renderTheftAccessories(rec)
    end
end

function SalonService.getInfo(player)
	local data = DataService.get(player)
	local rec = salons[player]
	if not data then
		return 0, 0, 0
	end
	return computeIncome(data, player), data.till, rec and rec.plotIndex or 0
end

function SalonService.init()
	salonsFolder = Instance.new("Folder")
	salonsFolder.Name = "Salons"
	salonsFolder.Parent = Workspace
	ridesFolder = Instance.new("Folder")
	ridesFolder.Name = "RideCars"
	ridesFolder.Parent = Workspace

	BotService.init()
	ThiefService.init()

    Net.ManageWorkshop.OnServerEvent:Connect(manageWorkshop)
    CarFactory.setPromptHandler("display",takeRide)
    CarFactory.setPromptHandler("displayTheft",stealFromSalon)
	Net.PinCar.OnServerEvent:Connect(onPin)
	Net.GetMenuData.OnServerInvoke = menuData

	local function onPlayer(player)
		DataService.onLoaded(player, function(data)
			if player.Parent then
				assign(player, data)
			end
		end)
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, p in ipairs(Players:GetPlayers()) do
		onPlayer(p)
	end
	Players.PlayerRemoving:Connect(teardown)

    -- One scoreboard read from server cache, no per-player OrderedDataStore calls.
    task.spawn(function()
        local Board=require(script.Parent.SeasonLeaderboardService)
        while true do
            task.wait(12)
            local entries=Board.getPublicSnapshot()
            for _,rec in pairs(salons) do
                local screen=rec.seasonTV
                if screen then
                    local total=#entries
                    if screen.empty then screen.empty.Visible=(total==0) end
                    for j,row in ipairs(screen.rows) do
                        local e=entries[j]
                        row.Text=e and string.format("%02d    %s      ·      $ %s",e.rank,tostring(e.name):sub(1,19),fmt(e.score)) or ""
                    end
                    screen.footer.Text="НАЖМИ E / КЛИКНИ · ОТКРЫТЬ ТОП-100"
                end
            end
        end
    end)

	-- доход, набеги воришек, брошенные поездки
	task.spawn(function()
		while true do
			task.wait(1)
			local now = os.clock()
			for player, rec in pairs(salons) do
				local data = DataService.get(player)
				if data and rec.tillLabel then
                    if now &gt;= (rec.nextIncomeUI or 0) then
                        -- Lightweight read-only income for HUD; no remote polling.
                        player:SetAttribute("SalonIncomePerHour",math.floor(computeIncome(data,player)*3600+.5))
                        rec.nextIncomeUI=now+4
                    end
                    accrueTill(data,player,1)
                    if Monetization.has(player, "autoCollect") and now &gt;= rec.nextAutoCollect then
                        local amount = math.floor(data.till)
                        if amount &gt; 0 then
                            data.till -= amount
                            DataService.addMoney(player, amount, true)
                        end
                        rec.nextAutoCollect = now + 15
                    end
                    rec.tillLabel.Text = ("КАССА · %d ч\n$ %s"):format(Monetization.tillHours(player),fmt(data.till))

                    local lesson=player:GetAttribute("TutorialStep")
                    local training=lesson=="defend"
                    local root=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
                    local near=root and(root.Position-Vector3.new(rec.px,root.Position.Y,rec.side*50)).Magnitude&lt;85
                    local ordinaryAllowed=not lesson or rec.onboardingVeteran or player:GetAttribute("TutorialDefenceLearned")==true
                    local due=training and now&gt;=(rec.nextTrainingRaid or 0)and near or not training and ordinaryAllowed and now&gt;=rec.nextRaid
                    if not rec.raidActive and due then
                        rec.nextRaid=now+rng:NextNumber(180,300);rec.nextTrainingRaid=now+35;rec.raidActive=true
                        task.spawn(function()
                            local ok,err=pcall(ThiefService.raid,rec,{training=training})
                            rec.raidActive=false
                            if not ok then warn("[Steal60 thief] "..tostring(err))end
                        end)
                    end

					if rec.rideCar and not rec.botBusy then
						local seat = rec.rideCar:FindFirstChildWhichIsA("VehicleSeat", true)
						if seat and seat.Occupant then
							rec.rideLastOccupied = now
						elseif now - rec.rideLastOccupied &gt; 90 then
							returnRide(rec)
						end
					end
				end
			end
		end
	end)
end

return SalonService
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX_NEW_UpgradeService">
          <Properties>
            <string name="Name">UpgradeService</string>
            <ProtectedString name="Source">-- Экономическая прокачка: проверка цены и лимита исключительно на сервере.
local Data = require(script.Parent.DataService)
local Net = require(script.Parent.Net)
local Upgrade = require(game.ReplicatedStorage.Shared.Config.UpgradeConfig)
local CoinUpgrade=require(game.ReplicatedStorage.Shared.Config.CoinUpgradeConfig)
local Salon = require(script.Parent.SalonService)
local Tutorial=require(script.Parent.TutorialService)
local UpgradeService = {}
local cooldown = {}
local function buy(player, id)
    if typeof(id) ~= "string" then return end
    if os.clock() - (cooldown[player] or 0) &lt; 0.25 then return end
    cooldown[player] = os.clock()
    local def = Upgrade.ById[id]
    local data = Data.get(player)
    if not def or not data then return end
    local level = (data.upgrades[id] or 0)
    local cost = Upgrade.cost(id, level)
    if not cost then
        Net.notify(player, "Улучшение уже достигло максимума.", "info")
        return
    end
    if id=="security" and level+math.floor(tonumber((data.coinUpgrades or {}).security) or 0)&gt;=5 then
        Net.notify(player,"Охрана уже достигла 5/5 (монеты и алмазы суммируются).","info")
        return
    end
    if not Data.spendDiamonds(player,cost) then
        Net.notify(player,("Не хватает алмазов: нужно %d 💎. Открой МЕНЮ → Магазин."):format(cost),"bad")
        return
    end
    data.upgrades[id] = level + 1
    Tutorial.sync(player,true)
    if id == "shelves" then
        data.shelfCapacity = 12 + data.upgrades.shelves * 3 + ((data.coinUpgrades or {}).shelves or 0) * 3
        Salon.refresh(player)
    elseif id == "income" or id == "security" then
        Salon.refresh(player)
    end
    if Net.CurrencyUpdate then Net.CurrencyUpdate:FireClient(player,data.diamonds) end
    Net.notify(player,("Улучшено: %s · %d уровень (−%d 💎)"):format(def.name,level+1,cost),"good")
end
local function buyCoin(player, id)
    if typeof(id)~="string" then return end
    if os.clock()-(cooldown[player] or 0)&lt;.20 then return end
    cooldown[player]=os.clock()
    local def=CoinUpgrade.ById[id]
    local data=Data.get(player)
    if not def or not data then return end
    data.coinUpgrades=data.coinUpgrades or {}
    local lvl=math.clamp(math.floor(tonumber(data.coinUpgrades[id]) or 0),0,def.max)
    local cost=CoinUpgrade.cost(id,lvl)
    if not cost then Net.notify(player,"Улучшение уже максимально прокачано.","info") return end
    if id=="security" and lvl+math.floor(tonumber(data.upgrades.security) or 0)&gt;=5 then
        Net.notify(player,"Охрана уже достигла общего максимума 5/5.","info")
        return
    end
    if not Data.spendMoney(player,cost) then
        Net.notify(player,("Нужно %d монет. Зарабатывай их угонами и в кассе."):format(cost),"bad")
        return
    end
    data.coinUpgrades[id]=lvl+1
    Tutorial.sync(player,true)
    if id=="shelves" then
        local premium=data.upgrades.shelves or 0
        data.shelfCapacity=12+premium*3+(data.coinUpgrades.shelves or 0)*3
    end
    if id=="security" or id=="shelves" or id=="income" then Salon.refresh(player) end
    if id=="security" then
        local total=math.min(5,lvl+1+math.floor(tonumber((data.upgrades or {}).security) or 0))
        Net.notify(player,("ОХРАНА УЛУЧШЕНА: %d/5 · против игроков только замедляет, NPC ловит чаще. −%d $"):format(total,cost),"good")
        return
    end
    if Net.CurrencyUpdate then Net.CurrencyUpdate:FireClient(player,data.diamonds) end
    Net.notify(player,("%s: %d/%d · потрачено %d $."):format(def.name,lvl+1,def.max,cost),"good")
end
function UpgradeService.init()
    Net.BuyUpgrade.OnServerEvent:Connect(buy)
    Net.BuyCoinUpgrade.OnServerEvent:Connect(buyCoin)
    game:GetService("Players").PlayerRemoving:Connect(function(player)
        cooldown[player] = nil
    end)
end
return UpgradeService
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX_NEW_MonetizationService">
          <Properties>
            <string name="Name">MonetizationService</string>
            <ProtectedString name="Source">-- Платёжные возможности: сервер проверяет владение пассами; ProcessReceipt выдаёт
-- товары идемпотентно через атомарное сохранение в DataStore профиля.
local Players = game:GetService("Players")
local Marketplace = game:GetService("MarketplaceService")
local Config = require(game.ReplicatedStorage.Shared.Config.MonetizationConfig)
local VIP = require(game.ReplicatedStorage.Shared.Config.VIPConfig)
local Data = require(script.Parent.DataService)
local Net = require(script.Parent.Net)
local M = {}
local owned = {} -- [player] = { doubleIncome = true, ... }
function M.has(player,passId)
    if owned[player] and owned[player][passId]==true then return true end
    local data=Data.get(player)
    return data~=nil and (tonumber(data.upgrades[passId]) or 0)&gt;=1
end
-- Time-limited VIP is stored as an absolute Unix timestamp. Old lifetime passes
-- continue to work for existing owners, but are not offered in the new shop.
function M.vipStatus(player, atTime)
    local data=Data.get(player)
    local untilAt=math.clamp(math.floor(tonumber(data and data.vipUntil) or 0),0,4102444800)
    local permanent=M.has(player,"vip")
    local now=math.floor(tonumber(atTime) or os.time())
    return permanent or untilAt&gt;now,untilAt,permanent
end
function M.vipCoinBonus(player)
    return M.vipStatus(player) and VIP.BONUS_COINS_PCT/100 or 0
end
function M.vipXPMultiplier(player)
    return M.vipStatus(player) and (1+VIP.BONUS_XP_PCT/100) or 1
end
function M.tillHours(player, atTime)
    return (M.vipStatus(player,atTime) or M.has(player,"till48h"))
        and VIP.CASH_HOURS or VIP.NORMAL_CASH_HOURS
end
local function syncVIP(player)
    if not player.Parent then return end
    local active,untilAt,permanent=M.vipStatus(player)
    player:SetAttribute("VIPActive",active)
    player:SetAttribute("VIPUntil",untilAt)
    player:SetAttribute("VIPPermanent",permanent)
end
local purchasing={}
local lastBuy={}
local function buyVIP(player,planId)
    if typeof(planId)~="string" then return end
    local plan=VIP.ById[planId]
    if not plan or purchasing[player] then return end
    if os.clock()-(lastBuy[player] or -10)&lt;.7 then return end
    lastBuy[player]=os.clock()
    local data=Data.get(player)
    if not data or not player.Parent then return end
    if M.has(player,"vip") then
        Net.notify(player,"У тебя уже есть бессрочный VIP — продлевать его не нужно.","info")
        return
    end
    local now=os.time()
    local oldEnd=math.clamp(math.floor(tonumber(data.vipUntil) or 0),0,4102444800)
    local nextEnd=math.max(now,oldEnd)+plan.days*86400
    -- Explicit bound protects against accidentally purchasing decades of VIP.
    if nextEnd &gt; now + VIP.MAX_EXTEND_DAYS*86400 then
        Net.notify(player,"Срок VIP уже достиг максимального ограничения.","info")
        return
    end
    if not Data.spendDiamonds(player,plan.diamonds) then
        Net.notify(player,("Недостаточно алмазов для VIP: нужно %d 💎."):format(plan.diamonds),"bad")
        return
    end
    purchasing[player]=true
    data.vipUntil=nextEnd
    -- Persist before announcing success (unless Studio has an ephemeral profile).
    local saved=true
    if Data.canSave(player) then
        saved=Data.saveNow(player)
    end
    if not saved then
        data.vipUntil=oldEnd
        data.diamonds+=plan.diamonds
        if player.Parent then
            syncVIP(player)
            if Net.CurrencyUpdate then Net.CurrencyUpdate:FireClient(player,data.diamonds) end
            Net.notify(player,"Не удалось сохранить покупку VIP. Алмазы возвращены, попробуй ещё раз.","bad")
        end
        purchasing[player]=nil
        return
    end
    if player.Parent then
        syncVIP(player)
        if Net.CurrencyUpdate then Net.CurrencyUpdate:FireClient(player,data.diamonds) end
        Net.notify(player,("VIP активирован на %d дн. · +%d%% монеты за угон · +%d%% XP · касса %d ч.%s")
            :format(plan.days,VIP.BONUS_COINS_PCT,VIP.BONUS_XP_PCT,VIP.CASH_HOURS,
            Data.canSave(player) and "" or " (только тестовая сессия)"),"good")
    end
    purchasing[player]=nil
end
function M.checkTillPasses(player)
    local r=owned[player] or {}
    owned[player]=r
    for _,id in ipairs({"vip","till48h"}) do
        if r[id]~=true then
            local pass=Config.PassById[id]
            if pass and pass.assetId&gt;0 then
                local ok,yes=pcall(function()
                    return Marketplace:UserOwnsGamePassAsync(player.UserId,pass.assetId)
                end)
                if ok and yes then r[id]=true end
                if not ok then warn("[Steal60/Till] Failed checking game pass "..id) end
            end
        end
    end
    syncVIP(player)
    return M.vipStatus(player) or M.has(player,"till48h")
end
function M.hackBonus(player)
    return M.has(player, "masterThief") and 5 or 0
end
function M.speedMultiplier(player)
    return M.has(player, "fastRide") and 1.25 or 1
end
function M.incomeMultiplier(player)
    local d = Data.get(player)
    local mult = M.has(player, "doubleIncome") and 2 or 1
    if d and (d.boostUntil or 0) &gt; os.time() then mult *= 2 end
    return mult
end
function M.showcaseSlots(player)
    return 6
end
function M.ownedPasses(player)
    local result = {}
    for _, pass in ipairs(Config.Passes) do result[pass.id] = M.has(player, pass.id) end
    return result
end
local function refreshPasses(player)
    local rec = owned[player] or {}
    owned[player] = rec
    for _, p in ipairs(Config.Passes) do
        if not player.Parent then return end
        if p.assetId &gt; 0 then
            local ok, yes = pcall(function()
                return Marketplace:UserOwnsGamePassAsync(player.UserId, p.assetId)
            end)
            if ok and yes then rec[p.id] = true end
        end
    end
end
local function applyProduct(data,id)
    local product=Config.ProductById[id]
    if not product or not product.diamonds or product.diamonds&lt;=0 then
        error("Unknown diamond product: "..tostring(id))
    end
    data.diamonds=math.clamp(math.floor(tonumber(data.diamonds) or 0)+product.diamonds,0,1000000000)
end
local function onReceipt(receipt)
    local product = Config.ProductByAsset[receipt.ProductId]
    if not product then
        warn("[Steal60] Unknown product ID: " .. tostring(receipt.ProductId))
        return Enum.ProductPurchaseDecision.NotProcessedYet
    end
    local player = Players:GetPlayerByUserId(receipt.PlayerId)
    if not player or not Data.get(player) then
        return Enum.ProductPurchaseDecision.NotProcessedYet
    end
    local ok = Data.applyReceipt(player, tostring(receipt.PurchaseId), function(profile)
        applyProduct(profile, product.id)
    end)
    if ok then
        local updated=Data.get(player)
        if Net.CurrencyUpdate and updated then Net.CurrencyUpdate:FireClient(player,updated.diamonds) end
        Net.notify(player,"Получено: "..product.name.."! Баланс алмазов обновлён.","good")
        return Enum.ProductPurchaseDecision.PurchaseGranted
    end
    return Enum.ProductPurchaseDecision.NotProcessedYet
end
function M.init()
    Marketplace.ProcessReceipt = onReceipt
    Net.BuyVIP.OnServerEvent:Connect(buyVIP)
    task.spawn(function()
        while true do
            task.wait(12)
            for _,plr in ipairs(Players:GetPlayers()) do
                if Data.get(plr) then syncVIP(plr) end
            end
        end
    end)
    Players.PlayerAdded:Connect(function(player)
        task.spawn(refreshPasses, player)
    end)
    for _, p in ipairs(Players:GetPlayers()) do task.spawn(refreshPasses, p) end
    Players.PlayerRemoving:Connect(function(p)
        owned[p] = nil
        purchasing[p] = nil
        lastBuy[p] = nil
    end)
    Marketplace.PromptGamePassPurchaseFinished:Connect(function(player, assetId, purchased)
        if not purchased then return end
        for _, pass in ipairs(Config.Passes) do
            if pass.assetId == assetId and assetId &gt; 0 then
                owned[player] = owned[player] or {}
                owned[player][pass.id] = true
                syncVIP(player)
                Net.notify(player, "Пасс активирован: " .. pass.name, "good")
                local Salon = require(script.Parent.SalonService)
                Salon.refresh(player)
                break
            end
        end
    end)
end
return M
</ProtectedString>
          </Properties>
        </Item>
      <Item class="ModuleScript" referent="RBX_CINEMATIC_WorldArtDirector"><Properties><string name="Name">WorldArtDirector</string><ProtectedString name="Source">-- Steal60 CINEMATIC EDITION. Only native Roblox Parts, SurfaceGui and Lighting.
-- All decor non-colliding and parented to a streamed district or the persistent core.
local Lighting = game:GetService("Lighting")
local P = require(script.Parent.TrackParts)
local Art = {}
local C = Color3.fromRGB
local THEMES = {
    {title="01 / OUTSKIRTS", subtitle="INDUSTRIAL YARD", accent=C(255,153,72), dark=C(44,49,59), wall=C(111,99,93), leaf=C(113,130,104)},
    {title="02 / CITY BLOCKS", subtitle="METRO DISTRICT", accent=C(93,205,255), dark=C(37,49,70), wall=C(92,105,127), leaf=C(76,144,131)},
    {title="03 / HILLS", subtitle="GARDEN AVENUE", accent=C(115,250,177), dark=C(37,75,64), wall=C(175,179,155), leaf=C(70,156,96)},
    {title="04 / GOLD COAST", subtitle="PRIVATE ESTATES", accent=C(255,202,116), dark=C(57,53,66), wall=C(207,202,181), leaf=C(64,133,103)},
    {title="05 / NEON BAY", subtitle="SUNSET RESORT", accent=C(255,116,190), dark=C(37,60,90), wall=C(176,208,213), leaf=C(63,187,145)},
}
Art.Themes = THEMES

local function part(parent,name,size,pos,color,material)
    local obj = P.part(parent,name,size,pos,color,material or Enum.Material.SmoothPlastic,false)
    obj.CastShadow = false
    return obj
end
local function glow(parent,name,size,pos,color,light)
    local obj=part(parent,name,size,pos,color,Enum.Material.Neon)
    if light then
        local p=Instance.new("PointLight")
        p.Name="SoftAccent";p.Color=color;p.Brightness=0.45;p.Range=17;p.Shadows=false;p.Parent=obj
    end
    return obj
end
local function label(block,face,title,sub,color)
    local sg=Instance.new("SurfaceGui")
    sg.Name="StreetSign";sg.Face=face;sg.AlwaysOnTop=false
    sg.SizingMode=Enum.SurfaceGuiSizingMode.PixelsPerStud;sg.PixelsPerStud=15
    sg.LightInfluence=0;sg.Parent=block
    local back=Instance.new("Frame");back.Size=UDim2.fromScale(1,1)
    back.BorderSizePixel=0;back.BackgroundColor3=C(15,23,35);back.Parent=sg
    local edge=Instance.new("Frame");edge.Size=UDim2.new(0,5,1,0)
    edge.BorderSizePixel=0;edge.BackgroundColor3=color;edge.Parent=back
    local t=Instance.new("TextLabel");t.Name="Title";t.Size=UDim2.new(1,-12,.57,0)
    t.Position=UDim2.fromOffset(8,0);t.BackgroundTransparency=1
    t.Text=title;t.Font=Enum.Font.GothamBlack;t.TextScaled=true
    t.TextXAlignment=Enum.TextXAlignment.Center;t.TextColor3=C(252,253,255);t.Parent=back
    local s=Instance.new("TextLabel");s.Name="Subtitle";s.Size=UDim2.new(1,-12,.3,0)
    s.Position=UDim2.fromScale(0,.62);s.BackgroundTransparency=1
    s.Text=sub;s.Font=Enum.Font.GothamMedium;s.TextScaled=true
    s.TextXAlignment=Enum.TextXAlignment.Center;s.TextColor3=color;s.Parent=back
end
local function sign(parent,x,z,y,width,title,sub,accent)
    -- X is the thickness: visible from the arriving direction along X.
    local b=part(parent,"CinematicSign",Vector3.new(.65,5,width),Vector3.new(x,y,z),C(18,23,32),Enum.Material.Metal)
    label(b,Enum.NormalId.Left,title,sub,accent)
    label(b,Enum.NormalId.Right,title,sub,accent)
    glow(parent,"SignEdgeTop",Vector3.new(.73,.16,width),Vector3.new(x,y+2.58,z),accent,false)
    return b
end
local function wallSign(parent,x,y,z,width,title,accent)
    local b=part(parent,"FacadeSign",Vector3.new(width,3,.25),Vector3.new(x,y,z),C(19,27,38),Enum.Material.Metal)
    local sg=Instance.new("SurfaceGui");sg.Face=Enum.NormalId.Front
    sg.PixelsPerStud=17;sg.SizingMode=Enum.SurfaceGuiSizingMode.PixelsPerStud
    sg.LightInfluence=0;sg.Parent=b
    local t=Instance.new("TextLabel");t.Size=UDim2.fromScale(1,1);t.BackgroundTransparency=1
    t.Text=title;t.TextColor3=accent;t.Font=Enum.Font.GothamBlack;t.TextScaled=true;t.Parent=sg
    return b
end
local function columnLight(parent,x,z,accent,tall)
    local h=tall or 17
    part(parent,"StreetLampBase",Vector3.new(1.2,.6,1.2),Vector3.new(x,.3,z),C(41,50,59),Enum.Material.Metal)
    part(parent,"StreetLampPost",Vector3.new(.34,h,.34),Vector3.new(x,h/2,z),C(38,46,57),Enum.Material.Metal)
    local s=(z&gt;0) and -1 or 1
    part(parent,"LampArm",Vector3.new(.28,.30,5.6),Vector3.new(x,h-.35,z+s*2.65),C(39,44,52),Enum.Material.Metal)
    glow(parent,"LEDStreetLight",Vector3.new(2.3,.20,1.5),Vector3.new(x,h-.57,z+s*5),C(255,238,196),true)
    glow(parent,"FootAccent",Vector3.new(1.05,.12,1.05),Vector3.new(x,.7,z),accent,false)
end
local function planter(parent,x,z,accent,leaf)
    part(parent,"ConcretePlanter",Vector3.new(3.8,1.2,3.8),Vector3.new(x,.72,z),C(52,60,70),Enum.Material.Concrete)
    part(parent,"PlanterRim",Vector3.new(4.05,.17,4.05),Vector3.new(x,1.38,z),accent,Enum.Material.Metal)
    P.ball(parent,"LeafBall",3.2,Vector3.new(x,2.9,z),leaf,Enum.Material.Grass,false)
end
local function palm(parent,x,z,leaf)
    local trunk=part(parent,"PalmTrunk",Vector3.new(9,.8,.8),CFrame.new(x,5.0,z)*CFrame.Angles(0,0,math.rad(90)),C(120,90,65),Enum.Material.Wood)
    trunk.Shape=Enum.PartType.Cylinder
    for i=0,5 do
        local a=math.pi*2*i/6
        local dx,dz=math.cos(a),math.sin(a)
        local p=part(parent,"PalmFrond",Vector3.new(9,.32,1.6),CFrame.new(x+3.4*dx,9.2,z+3.4*dz)*CFrame.Angles(0,-a,math.rad(-13)),leaf,Enum.Material.Grass)
        p.CanCollide=false
    end
    P.ball(parent,"PalmTop",2.0,Vector3.new(x,10.1,z),leaf,Enum.Material.Grass,false)
end
local function windowBands(parent,x,z,wide,h,color,accent)
    -- only the facade-facing plane, inexpensive faux glazing
    local rows=math.floor((h-8)/7)
    for r=1,rows do
        local y=4+r*7
        local glass=part(parent,"FacadeGlass",Vector3.new(wide,.20, .22),Vector3.new(x,y,z),C(57,91,125),Enum.Material.Glass)
        glass.Transparency=.16
        part(parent,"WindowLintel",Vector3.new(wide+.1,.14,.26),Vector3.new(x,y+1.0,z),accent,Enum.Material.Metal)
    end
end
local function medallion(parent,x,z,color)
    part(parent,"RoadReflector",Vector3.new(.48,.12,.75),Vector3.new(x,.28,z),color,Enum.Material.Neon)
end

function Art.setupLighting()
    -- V48: warmer and more natural late-afternoon lighting, less gamey saturation.
    Lighting.ClockTime=17.1
    Lighting.GeographicLatitude=36
    Lighting.Brightness=2.28
    Lighting.GlobalShadows=true
    Lighting.ExposureCompensation=.06
    Lighting.EnvironmentDiffuseScale=.82
    Lighting.EnvironmentSpecularScale=.96
    Lighting.Ambient=C(138,144,152)
    Lighting.OutdoorAmbient=C(176,180,184)
    Lighting.FogColor=C(170,180,192)
    Lighting.FogStart=300
    Lighting.FogEnd=1080
    Lighting.ShadowSoftness=.42
    local at=Lighting:FindFirstChild("S60_Atmosphere") or Instance.new("Atmosphere")
    at.Name="S60_Atmosphere";at.Density=.15;at.Offset=.04;at.Haze=1.06;at.Glare=.11
    at.Color=C(206,213,224);at.Decay=C(243,191,151);at.Parent=Lighting
    local cc=Lighting:FindFirstChild("S60_ColorGrade") or Instance.new("ColorCorrectionEffect")
    cc.Name="S60_ColorGrade";cc.Brightness=.01;cc.Contrast=.045;cc.Saturation=.02
    cc.TintColor=C(255,247,238);cc.Parent=Lighting
    local bloom=Lighting:FindFirstChild("S60_Bloom") or Instance.new("BloomEffect")
    bloom.Name="S60_Bloom";bloom.Intensity=.05;bloom.Size=10;bloom.Threshold=1.95;bloom.Parent=Lighting
    local rays=Lighting:FindFirstChild("S60_SunRays") or Instance.new("SunRaysEffect")
    rays.Name="S60_SunRays";rays.Intensity=.026;rays.Spread=.34;rays.Parent=Lighting
end

function Art.decorateCore(core, T)
    local folder=Instance.new("Folder");folder.Name="CinematicPlaza";folder.Parent=core
    local cyan=C(90,230,235);local orange=C(255,180,83)
    -- Entry identity: monumental but above traffic, no collision.
    for _,side in ipairs({-1,1}) do
        local z=side*36.3
        part(folder,"GatewayColumn",Vector3.new(2.2,17,2.2),Vector3.new(-19,8.5,z),C(30,39,52),Enum.Material.Metal)
        glow(folder,"GatewayLight",Vector3.new(2.4,15,.20),Vector3.new(-19,8.6,z-side*1.15),orange,true)
    end
    local beam=part(folder,"GatewayTop",Vector3.new(2,5,75),Vector3.new(-19,19,0),C(18,25,38),Enum.Material.Metal)
    label(beam,Enum.NormalId.Right,"УГНАТЬ ЗА 60 СЕКУНД","DRIVE · STEAL · COLLECT",orange)
    label(beam,Enum.NormalId.Left,"УГНАТЬ ЗА 60 СЕКУНД","DRIVE · STEAL · COLLECT",orange)
    glow(folder,"GatewayCrown",Vector3.new(2.1,.20,75),Vector3.new(-19,21.6,0),orange,false)
    -- Cinematic roadside lights and footpaths; do not obstruct 8 salon plots.
    for x=-40,395,56 do
        for _,side in ipairs({-1,1}) do
            columnLight(folder,x,side*36.4,cyan,17)
        end
    end
    for x=-48,388,48 do
        medallion(folder,x,21,orange)
        medallion(folder,x,-21,orange)
    end
    for _,side in ipairs({-1,1}) do
        part(folder,"AvenueEdge",Vector3.new(440,.10,.20),Vector3.new(170,.43,side*38),C(75,119,132),Enum.Material.SmoothPlastic)
    end
    -- Recessed showroom exterior: banners and stylized property planting outside plot boundaries.
    for k=1,4 do
        local px=60+(k-1)*85
        for _,side in ipairs({-1,1}) do
            local at=side*101
            part(folder,"BackLotWall",Vector3.new(69,11,2),Vector3.new(px,5.5,at),C(24,36,47),Enum.Material.Concrete)
            for j=-1,1 do
                local x=px+j*20
                glow(folder,"BackLotAccent",Vector3.new(12,.28,.18),Vector3.new(x,9.6,at-side*1.1),j==0 and orange or cyan,false)
            end
            planter(folder,px-33,side*94,orange,C(65,135,102))
            planter(folder,px+33,side*94,cyan,C(65,135,102))
        end
    end
    -- Small readable welcome sign facing arriving drivers, replaces giant floating text.
    sign(folder,28,-46,9,13,"START / 01","YOUR GARAGE",orange)
    sign(folder,365,46,10,15,"RETURN BAY","DELIVER STOLEN CARS",cyan)
    -- crosswalks and direction stripes on entry road
    for _,x in ipairs({32,355}) do
        for z=-16,16,5 do
            part(folder,"Zebra",Vector3.new(2.6,.05,2.3),Vector3.new(x,.245,z),C(226,229,228),Enum.Material.SmoothPlastic)
        end
    end
end

local function districtFacade(parent,x,side,index,theme,rng)
    -- Distinct but cohesive urban silhouettes beyond gameplay buildings.
    local z=side*(120+rng:NextInteger(0,23))
    if index==1 then
        -- Shipping yard and illuminated freight office.
        for i=0,1 do
            part(parent,"Container",Vector3.new(27,10,12),Vector3.new(x+i*5,5+i*10,z+side*i*2),
                i==0 and C(129,73,61) or C(57,98,121),Enum.Material.CorrodedMetal)
        end
        for i=-5,5 do
            part(parent,"CorrugatedRib",Vector3.new(.12,8,.3),Vector3.new(x+i*2.1,5,z-side*6.15),C(181,154,120),Enum.Material.Metal)
        end
        wallSign(parent,x,12,z-side*6.1,19,"WAREHOUSE 60",theme.accent)
    elseif index==2 then
        local h=rng:NextInteger(44,75)
        part(parent,"MidriseTower",Vector3.new(31,h,24),Vector3.new(x,h/2,z),theme.dark,Enum.Material.Concrete)
        windowBands(parent,x,z-side*12.2,25,h,theme.wall,theme.accent)
        glow(parent,"TowerCrown",Vector3.new(32,.27,24),Vector3.new(x,h+.16,z),theme.accent,false)
        wallSign(parent,x,10,z-side*12.4,19,"METRO  /  AVE",theme.accent)
    elseif index==3 then
        local h=rng:NextInteger(11,18)
        part(parent,"House",Vector3.new(25,h,25),Vector3.new(x,h/2,z),theme.wall,Enum.Material.Concrete)
        part(parent,"FlatRoof",Vector3.new(27,.8,27),Vector3.new(x,h+.4,z),theme.dark,Enum.Material.Slate)
        for u=-7,7,7 do
            part(parent,"HouseWindow",Vector3.new(4,4,.25),Vector3.new(x+u,h*.52,z-side*12.65),C(83,133,147),Enum.Material.Glass)
        end
        planter(parent,x-18,z-side*14,theme.accent,theme.leaf)
    elseif index==4 then
        local h=rng:NextInteger(22,28)
        part(parent,"DesignerResidence",Vector3.new(31,h,25),Vector3.new(x,h/2,z),C(210,208,197),Enum.Material.Marble)
        part(parent,"PanoramicWindow",Vector3.new(24,9,.28),Vector3.new(x,h*.60,z-side*12.7),C(41,82,96),Enum.Material.Glass)
        for u=-11,11,22 do
            part(parent,"VillaPier",Vector3.new(.7,h*.8,.7),Vector3.new(x+u,h*.40,z-side*12.9),theme.accent,Enum.Material.Metal)
        end
        glow(parent,"VillaRoofline",Vector3.new(32,.18,26),Vector3.new(x,h+.2,z),theme.accent,false)
    else
        local h=rng:NextInteger(48,76)
        part(parent,"BeachHotel",Vector3.new(35,h,26),Vector3.new(x,h/2,z),C(188,214,225),Enum.Material.Concrete)
        windowBands(parent,x,z-side*13.2,30,h,theme.wall,theme.accent)
        for y=9,h-5,13 do
            part(parent,"HotelBalcony",Vector3.new(33,.35,4),Vector3.new(x,y,z-side*15),C(245,245,234),Enum.Material.Concrete)
        end
        glow(parent,"HotelNeon",Vector3.new(32,.33,.30),Vector3.new(x,h+1,z-side*13),theme.accent,false)
        palm(parent,x-24,z-side*20,theme.leaf)
    end
end


-- V46 street-level facade / prop pass. Structural visual details rather than
-- giant neon outlines. All parts are client-cheap anchored, non-colliding.
local SHOP_NAMES={
 {"MOTOR / 60","REPAIR &amp; TUNING","NO. 04"},
 {"NIGHT MARKET","COFFEE • SNACKS","OPEN DAILY"},
 {"GARAGE CLUB","CUSTOM PARTS","EST. 2026"},
 {"STREET GOODS","GEAR &amp; STYLE","NEW ARRIVALS"},
 {"CITY STUDIO","DESIGN &amp; LAB","LEVEL UP"},
}
local function textPanel(parent,name,size,pos,face,headline,footline,accent)
 local body=part(parent,name,size,pos,C(22,28,40),Enum.Material.Metal)
 local gui=Instance.new("SurfaceGui")
 gui.Name="ShopfrontTypography";gui.Face=face
 gui.SizingMode=Enum.SurfaceGuiSizingMode.PixelsPerStud
 gui.PixelsPerStud=45;gui.LightInfluence=0;gui.Parent=body
 local frame=Instance.new("Frame")
 frame.Size=UDim2.fromScale(1,1);frame.BorderSizePixel=0
 frame.BackgroundColor3=C(27,34,47);frame.Parent=gui
 local stripe=Instance.new("Frame")
 stripe.Size=UDim2.new(1,0,0,.0);stripe.Size=UDim2.new(1,0,0,5)
 stripe.BorderSizePixel=0;stripe.BackgroundColor3=accent;stripe.Parent=frame
 local top=Instance.new("TextLabel")
 top.Size=UDim2.new(1,-10,.64,0);top.Position=UDim2.fromOffset(5,6)
 top.BackgroundTransparency=1;top.Text=headline;top.Font=Enum.Font.GothamBlack
 top.TextScaled=true;top.TextColor3=C(245,246,237);top.Parent=frame
 local sub=Instance.new("TextLabel")
 sub.Size=UDim2.new(1,-10,.25,0);sub.Position=UDim2.new(0,5,.70,0)
 sub.BackgroundTransparency=1;sub.Text=footline;sub.Font=Enum.Font.GothamBold
 sub.TextScaled=true;sub.TextColor3=accent;sub.Parent=frame
 return body
end
local function storefront(parent,x,side,index,t,rng,ordinal)
 local fz=side*49.4
 local bz=side*58
 local face=side==1 and Enum.NormalId.Front or Enum.NormalId.Back
 local col=({C(75,80,91),C(89,103,114),C(193,179,150),C(232,221,200),C(101,123,146)})[index]
 local trim=({C(233,159,93),C(134,196,230),C(110,172,135),C(225,195,123),C(245,134,188)})[index]
 local names=SHOP_NAMES[(ordinal+index*2)%#SHOP_NAMES+1]
 -- Narrow, convincing three-dimensional lower facade and recessed glazing.
 part(parent,"RetailStructuralShell",Vector3.new(29,14,17),Vector3.new(x,7,bz),col,Enum.Material.Brick)
 part(parent,"RetailRoofSlab",Vector3.new(31,.48,18.5),Vector3.new(x,14.3,bz),t.dark,Enum.Material.Concrete)
 part(parent,"RetailRoofCap",Vector3.new(31,.21,.7),Vector3.new(x,14.55,fz),trim,Enum.Material.Metal)
 part(parent,"StoneShopPlinth",Vector3.new(30,.65,1),Vector3.new(x,.53,fz),C(76,79,86),Enum.Material.Concrete)
 for _,dx in ipairs({-12.8,0,12.8}) do
  part(parent,"ShopVerticalMullion",Vector3.new(.55,8,.5),Vector3.new(x+dx,5.8,fz-side*.33),t.dark,Enum.Material.Metal)
 end
 for _,dx in ipairs({-7.2,7.2}) do
  local glass=part(parent,"FloorToCeilingGlass",Vector3.new(9.7,6.1,.19),
   Vector3.new(x+dx,5.35,fz-side*.48),C(96,143,161),Enum.Material.Glass)
  glass.Transparency=.24;glass.Reflectance=.14
  part(parent,"WindowBottomFrame",Vector3.new(9.8,.19,.25),Vector3.new(x+dx,2.38,fz-side*.60),t.dark,Enum.Material.Metal)
  part(parent,"WindowCrossbar",Vector3.new(9.8,.16,.25),Vector3.new(x+dx,6.0,fz-side*.60),t.dark,Enum.Material.Metal)
  part(parent,"InteriorDisplayLight",Vector3.new(6.2,.13,.12),Vector3.new(x+dx,8.12,fz+side*.4),C(255,224,166),Enum.Material.Neon)
 end
 local door=part(parent,"RecessedDoor",Vector3.new(3.8,6.8,.24),Vector3.new(x,4.4,fz-side*.53),C(41,76,95),Enum.Material.Glass)
 door.Transparency=.14
 for _,dx in ipairs({-2.15,2.15}) do
  part(parent,"DoorJamb",Vector3.new(.24,7.0,.34),Vector3.new(x+dx,4.5,fz-side*.63),trim,Enum.Material.Metal)
 end
 part(parent,"DoorPushBar",Vector3.new(.14,1.2,.2),Vector3.new(x+1.55,4.4,fz-side*.75),C(231,233,220),Enum.Material.Metal)
 part(parent,"ShopCornice",Vector3.new(30,.72,1.15),Vector3.new(x,10.2,fz-side*.40),t.dark,Enum.Material.Concrete)
 part(parent,"WeatherAwning",Vector3.new(25,.26,4.1),Vector3.new(x,10.2,fz-side*2.1),trim,Enum.Material.Fabric)
 for _,dx in ipairs({-9,-3,3,9}) do
  part(parent,"AwningStitch",Vector3.new(.18,.31,4.2),Vector3.new(x+dx,10.23,fz-side*2.1),C(239,225,198),Enum.Material.Fabric)
 end
 textPanel(parent,"PremiumStoreSign",Vector3.new(23,2.15,.28),Vector3.new(x,12.15,fz-side*.38),face,names[1],names[2],trim)
 textPanel(parent,"DoorHours",Vector3.new(2.5,1.3,.22),Vector3.new(x-1.1,5.9,fz-side*.76),face,names[3],"60 SEC",trim)
 -- Rooftop air conditioning with grille and solid equipment silhouettes.
 part(parent,"RoofPlant",Vector3.new(6,3.4,4.8),Vector3.new(x+7,16.2,bz),C(62,69,77),Enum.Material.Metal)
 for offset=-2,2,1 do
  part(parent,"CoolingVent",Vector3.new(4.2,.12,.12),Vector3.new(x+7,16.2+offset*.46,bz-side*2.51),C(160,171,176),Enum.Material.Metal)
 end
 for _,dx in ipairs({-9,9}) do
  part(parent,"WallSconceStem",Vector3.new(.20,.9,.40),Vector3.new(x+dx,9.15,fz-side*.85),t.dark,Enum.Material.Metal)
  part(parent,"WarmWallSconce",Vector3.new(.42,.32,.6),Vector3.new(x+dx,8.8,fz-side*1.0),C(255,217,154),Enum.Material.Neon)
 end
end
local function streetProps(parent,x,side,index,t)
 local z=side*40.9
 -- Road-facing bench and street bin sit behind the last sidewalk pavers.
 part(parent,"BollardBase",Vector3.new(.78,.23,.78),Vector3.new(x-12,.36,z),t.dark,Enum.Material.Metal)
 part(parent,"SafetyBollard",Vector3.new(.44,2.7,.44),Vector3.new(x-12,1.68,z),C(43,51,60),Enum.Material.Metal)
 part(parent,"BollardReflector",Vector3.new(.51,.26,.51),Vector3.new(x-12,2.39,z),t.accent,Enum.Material.Neon)
 part(parent,"ParkBenchSeat",Vector3.new(5,.32,1.15),Vector3.new(x+9,1.62,z),C(130,96,66),Enum.Material.WoodPlanks)
 part(parent,"ParkBenchBack",Vector3.new(5,1.6,.25),Vector3.new(x+9,2.47,z+side*.63),C(131,98,70),Enum.Material.WoodPlanks)
 for _,dx in ipairs({-1.85,1.85}) do
  part(parent,"BenchIronLeg",Vector3.new(.22,1.5,.3),Vector3.new(x+9+dx,.80,z),t.dark,Enum.Material.Metal)
 end
 part(parent,"WasteBin",Vector3.new(1.45,2.45,1.45),Vector3.new(x+14,1.40,z),C(52,67,77),Enum.Material.Metal)
 part(parent,"WasteBinRim",Vector3.new(1.52,.19,1.52),Vector3.new(x+14,2.69,z),t.accent,Enum.Material.Metal)
 if index==1 or index==2 then
  -- Sheet-metal fire escape and freight crates, without physical road obstacles.
  part(parent,"FireEscapeStair",Vector3.new(7,.27,2.6),CFrame.new(x-5,5.4,side*71)*CFrame.Angles(0,0,-.23),C(87,92,96),Enum.Material.Metal)
  part(parent,"FireEscapeRail",Vector3.new(7,1.4,.18),Vector3.new(x-5,6.2,side*72.3),C(84,86,90),Enum.Material.Metal)
 else
  for _,dx in ipairs({-6,0,6}) do
   local px,pz=x+dx,side*43.3
   local trunk=P.cylinderV(parent,"TreeTrunk",5.0,.65,Vector3.new(px,2.65,pz),C(108,80,58),Enum.Material.Wood)
   trunk.CanCollide=false;trunk.CanQuery=false;trunk.CanTouch=false
   P.ball(parent,"TreeCrown",3.5,Vector3.new(px,6.4,pz),t.leaf,Enum.Material.Grass,false)
  end
 end
end

function Art.decorateDistrict(model,index,x0,x1,x2)
    local t=THEMES[index];if not t then return end
    local d=Instance.new("Folder");d.Name="CinematicDistrictArt";d.Parent=model
    local rng=Random.new(index*831+25)
    local midpoint=(x1+x2)*.5
    -- Avenue visual rhythms, color-coded by district; none block traffic.
    for _,side in ipairs({-1,1}) do
        local z=side*37.0
        glow(d,"DistrictEdgeNeon",Vector3.new(x2-x1-.5,.12,.18),Vector3.new(midpoint,.41,side*37.7),t.accent,false)
        for x=x1+35,x2-30,96 do
            columnLight(d,x,z,t.accent,16)
            planter(d,x+24,side*40.6,t.accent,t.leaf)
        end
        for x=x1+55,x2-30,156 do
            districtFacade(d,x,side,index,t,rng)
        end
    end
    for x=x1+18,x2-6,28 do
        medallion(d,x,20,t.accent)
        medallion(d,x,-20,t.accent)
    end
    -- Ground-level visual storytelling every 120 studs, streamed with each zone.
    -- Visual-only detail keeps driving mechanics and parking clearance unchanged.
    for _,side in ipairs({-1,1}) do
        local count=0
        for x=x1+83,x2-60,124 do
            count+=1
            storefront(d,x,side,index,t,rng,count)
            streetProps(d,x+35,side,index,t)
            if count%2==0 then task.wait() end
        end
    end
    -- Architectural gateway near intersection, not too large for view.
    for _,side in ipairs({-1,1}) do
        part(d,"DistrictGatePillar",Vector3.new(1.4,15,1.4),Vector3.new(x1+11,7.5,side*34),t.dark,Enum.Material.Metal)
        glow(d,"GateInnerLED",Vector3.new(.2,13,.22),Vector3.new(x1+11,7.5,side*33.3),t.accent,false)
    end
    local cross=part(d,"DistrictGate",Vector3.new(1.5,4.3,70),Vector3.new(x1+11,16.7,0),t.dark,Enum.Material.Metal)
    label(cross,Enum.NormalId.Right,t.title,t.subtitle,t.accent)
    label(cross,Enum.NormalId.Left,t.title,t.subtitle,t.accent)
    glow(d,"GateTopLED",Vector3.new(1.6,.17,70),Vector3.new(x1+11,19,0),t.accent,false)
    -- Color-coded landmark every ~200 studs, themed street furniture.
    for x=x1+170,x2-30,200 do
        local z=-43
        sign(d,x,z,9,12,"60 / "..index,t.subtitle,t.accent)
        if index==1 then
            part(d,"YardCrate",Vector3.new(7,5,7),Vector3.new(x+10,2.5,-51),C(98,70,53),Enum.Material.WoodPlanks)
            part(d,"Crate",Vector3.new(5,4,5),Vector3.new(x+14,7,-52),C(139,109,73),Enum.Material.Wood)
        elseif index==2 then
            glow(d,"VendingLight",Vector3.new(3,6,2),Vector3.new(x+10,3,-42),C(42,145,242),true)
            part(d,"VendingCabinet",Vector3.new(4,6,2.5),Vector3.new(x+10,3,-43),t.dark,Enum.Material.Metal)
            wallSign(d,x+10,4.4,-41.65,3.3,"DRINK",t.accent)
        elseif index==3 then
            planter(d,x+10,-41,t.accent,t.leaf)
        elseif index==4 then
            P.cylinderV(d,"WaterBasin",.5,7,Vector3.new(x+10,.55,-43),C(71,150,174),Enum.Material.Glass)
        else
            palm(d,x+12,-44,t.leaf)
        end
    end
end

return Art
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_CINEMATIC_SalonArtDirector"><Properties><string name="Name">SalonArtDirector</string><ProtectedString name="Source">-- Polished owner showroom using only native Roblox geometry and SurfaceGui.
local P=require(script.Parent.TrackParts)
local Art={}
local C=Color3.fromRGB
local function part(p,n,size,pos,c,mat)
    local x=P.part(p,n,size,pos,c,mat or Enum.Material.SmoothPlastic,false)
    x.CastShadow=false
    return x
end
local function neon(p,n,size,pos,c,light)
    local x=part(p,n,size,pos,c,Enum.Material.Neon)
    if light then
        local l=Instance.new("PointLight")
        l.Brightness=.35;l.Range=13;l.Color=c;l.Shadows=false;l.Parent=x
    end
    return x
end
local function faceText(obj,normal,heading,small,accent)
    local g=Instance.new("SurfaceGui");g.Name="SalonMarquee"
    g.Face=normal;g.PixelsPerStud=20;g.SizingMode=Enum.SurfaceGuiSizingMode.PixelsPerStud
    g.LightInfluence=0;g.Parent=obj
    local main=Instance.new("TextLabel");main.Size=UDim2.new(1,0,.62,0)
    main.BackgroundTransparency=1;main.Text=heading;main.Font=Enum.Font.GothamBlack
    main.TextScaled=true;main.TextColor3=C(245,245,245);main.Parent=g
    local caption=Instance.new("TextLabel");caption.Position=UDim2.fromScale(0,.65)
    caption.Size=UDim2.new(1,0,.28,0);caption.BackgroundTransparency=1
    caption.Text=small;caption.TextScaled=true;caption.Font=Enum.Font.GothamBold
    caption.TextColor3=accent;caption.Parent=g
end
function Art.decorate(model, rec, W)
    local root=Instance.new("Folder");root.Name="CinematicShowroom";root.Parent=model
    local base=C(21,28,40);local trim=C(61,75,88)
    local accent=rec.side==1 and C(66,224,223) or C(253,180,92)
    -- Architectural front: thin modern metal frames and open showroom facade.
    for _,u in ipairs({-32,32}) do
        part(root,"ShowroomFrame",Vector3.new(.75,15,.75),W(u,11,7.8),base,Enum.Material.Metal)
        neon(root,"EntranceAccent",Vector3.new(.22,11,.22),W(u,10.7,8.4),accent,false)
        if u&lt;0 then
            -- Left window stays glazed. Right wall is now an entire TV-screen
            -- facing inward: don't leave overlapping glass/mullions on top.
            local glass=part(root,"SideGlass",Vector3.new(.30,9.4,29),W(u,27,6.8),C(52,91,116),Enum.Material.Glass)
            glass.Transparency=.43;glass.CanCollide=true;glass.CanQuery=true
            for _,v in ipairs({16,30,42}) do
                part(root,"WindowMullion",Vector3.new(.55,10,.32),W(u,v,6),trim,Enum.Material.Metal)
            end
        end
    end
    -- Solid canopy with luminous leading edge: stays above vehicle roof.
    part(root,"CantileverRoof",Vector3.new(67,.46,5.8),W(0,11.3,13.1),base,Enum.Material.Metal)
    part(root,"CanopyUnderTrim",Vector3.new(65,.12,.28),W(0,9.0,12.68),C(91,142,155),Enum.Material.Metal)
    part(root,"RoofParapet",Vector3.new(67,1.2,1.0),W(0,26,13.3),base,Enum.Material.Metal)
    -- Avoid huge billboard labels: one crisp SurfaceGui sign on the fascia.
    local sign=part(root,"NameMarquee",Vector3.new(35,2.6,.55),W(0,9.1,15.5),base,Enum.Material.Metal)
    faceText(sign,rec.side==1 and Enum.NormalId.Front or Enum.NormalId.Back,
        "ГАРАЖ / " .. tostring(rec.player.DisplayName):sub(1,14),"",accent)
    part(root,"MarqueeTopTrim",Vector3.new(35,.10,.55),W(0,9.1,16.87),C(80,137,145),Enum.Material.Metal)
    -- Grounded tile effect for the showcase (no colliders).
    for _,u in ipairs({-29,-15,-1,13,27}) do
        part(root,"ShowroomTileJoin",Vector3.new(.09,.06,36),W(u,26,.55),C(172,178,189),Enum.Material.Metal)
    end
    for _,v in ipairs({16,27,38}) do
        part(root,"ShowroomFloorJoint",Vector3.new(64,.06,.08),W(0,v,.55),C(174,180,191),Enum.Material.Metal)
    end
    -- Interior accent lighting highlights the accessory display, not parked cars.
    for _,u in ipairs({-24,0,24}) do
        part(root,"LightChannel",Vector3.new(4,.22,23),W(u,25,12.00),trim,Enum.Material.Metal)
        local fixture=part(root,"WarmDisplayLamp",Vector3.new(2.8,.10,10),W(u,25,11.84),C(255,248,228),Enum.Material.SmoothPlastic)
        local lamp=Instance.new("PointLight")
        lamp.Brightness=.65;lamp.Range=22;lamp.Shadows=false;lamp.Color=C(255,246,220)
        lamp.Parent=fixture
    end
    for _,v in ipairs({19,34}) do
        neon(root,"GroundLEDLeft",Vector3.new(.15,.14,11),W(-31,v,.65),accent,false)
        neon(root,"GroundLEDRight",Vector3.new(.15,.14,11),W(31,v,.65),accent,false)
    end
    -- Feature wall: colored central display panel and low showroom counters.
    part(root,"ShowcaseBackFeature",Vector3.new(24,9,.42),W(-3,42.0,6.6),base,Enum.Material.Metal)
    neon(root,"BackWallVertical",Vector3.new(.20,8.7,.48),W(-15,41.7,6.6),accent,false)
    neon(root,"BackWallVertical",Vector3.new(.20,8.7,.48),W(9,41.7,6.6),accent,false)
    local hero=part(root,"BackWallBrand",Vector3.new(15,1.7,.25),W(-3,41.6,10.1),base,Enum.Material.Metal)
    faceText(hero,rec.side==1 and Enum.NormalId.Front or Enum.NormalId.Back,"STEAL / 60","",accent)
    for _,u in ipairs({-25,25}) do
        part(root,"DecorPlinth",Vector3.new(3,1.3,2.5),W(u,40.2,1.25),trim,Enum.Material.Marble)
        neon(root,"PlinthCrown",Vector3.new(3.2,.15,2.7),W(u,40.2,1.96),accent,false)
    end
    -- Small subtle lobby trim (no giant floating messages)
    part(root,"DoorMat",Vector3.new(16,.08,4.0),W(0,8,.49),C(36,43,53),Enum.Material.Fabric)
    neon(root,"DoorMatStripe",Vector3.new(15,.10,.22),W(0,6.5,.54),accent,false)
end
return Art
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_GAMEPLAY_V2_HeistService"><Properties><string name="Name">HeistService</string><ProtectedString name="Source">-- Steal60 GAMEPLAY EDITION / server-only run bonuses, daily objectives and skill XP.
-- Client never sends rewards, grade or quest progress.
local Players = game:GetService("Players")
local Services = script.Parent
local DataService = require(Services:WaitForChild("DataService"))
local Net = require(Services:WaitForChild("Net"))
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Classes = require(Shared.Config.CarClasses)
local Rarity = require(Shared.Rarity)
local AccessoryConfig = require(Shared.Config.AccessoryConfig)
local CosmeticConfig = require(Shared.Config.CosmeticConfig)
local Monetization = require(Services:WaitForChild("MonetizationService"))
local VIPConfig = require(Shared.Config.VIPConfig)
local rng = Random.new()
local HeistService = {}

local streaks = {} -- [Player] -&gt; successful deliveries without an interruption
local RARITY_RANK = {}
for i, id in ipairs(Rarity.Order) do RARITY_RANK[id] = i end

local function dailyKey()
    return math.floor(os.time() / 86400) -- UTC calendar day, independent of server timezone
end
local function needXP(level)
    return 55 + math.floor(math.max(1,level) * 18)
end
local function getDaily(data)
    local daily = data.dailyHeists
    if type(daily) ~= "table" or daily.day ~= dailyKey() then
        daily = { day = dailyKey(), completed = 0, precise = 0, rare = 0, claimed = {} }
        data.dailyHeists = daily
    end
    daily.claimed = type(daily.claimed) == "table" and daily.claimed or {}
    daily.completed = math.max(0, tonumber(daily.completed) or 0)
    daily.precise = math.max(0, tonumber(daily.precise) or 0)
    daily.rare = math.max(0, tonumber(daily.rare) or 0)
    return daily
end
local DAILY = {
    {key = "completed", goal = 3, reward = 250, title = "Доставь 3 машины"},
    {key = "precise", goal = 2, reward = 400, title = "2 точных взлома"},
    {key = "rare", goal = 1, reward = 600, title = "Доставь редкую машину"},
}
local function sync(player, data)
    if not player.Parent then return end
    local d = getDaily(data)
    player:SetAttribute("HeistStreak", streaks[player] or 0)
    player:SetAttribute("HeistXP", data.hackXP or 0)
    player:SetAttribute("HeistXPNeed", needXP(data.hackLevel or 1))
    player:SetAttribute("HeistDailyDay", d.day)
    local claimed = 0
    for _, mission in ipairs(DAILY) do
        if d.claimed[mission.key] then claimed += 1 end
        player:SetAttribute("HeistQuest_" .. mission.key, math.min(d[mission.key] or 0, mission.goal))
        player:SetAttribute("HeistQuestClaimed_" .. mission.key, d.claimed[mission.key] == true)
    end
    player:SetAttribute("HeistQuestsDone", claimed)
end
function HeistService.onFailed(player)
    if not player then return end
    local old = streaks[player] or 0
    streaks[player] = 0
    if player.Parent then player:SetAttribute("HeistStreak", 0) end
    if old &gt;= 2 and player.Parent then
        Net.notify(player, ("Серия из %d угонов прервана. Следующая доставка начнёт новую серию."):format(old), "info")
    end
end
-- Base payout is computed by Main from verified class, rarity and variant config.
-- returns final payout and a short server-authoritative result line
function HeistService.onDelivered(player, info, baseReward, isNew)
    local data = DataService.get(player)
    if not data then return baseReward, "" end
    local d = getDaily(data)
    local streak = math.min(999, (streaks[player] or 0) + 1)
    streaks[player] = streak
    local seconds = math.max(0, tonumber(info.tripSeconds) or 9999)
    local distance = math.max(0, tonumber(info.tripDistance) or 0)
    local speed = math.clamp(tonumber(info.tripSpeed) or 60, 20, 140)
    local par = math.max(20, distance / (speed * .70) + 12)
    local speedBonus, grade = 0, "C"
    if seconds &lt;= par then speedBonus, grade = .25, "S" -- soft par, no timeout / loss
    elseif seconds &lt;= par * 1.5 then speedBonus, grade = .12, "A" end
    local precision = math.clamp(tonumber(info.lockQuality) or 0, 0, 1)
    local precisionBonus = precision &gt;= .75 and .15 or (precision &gt;= .48 and .07 or 0)
    local streakBonus = math.min(.40, math.max(0, streak - 1) * .10)
    local newBonus = isNew and .20 or 0
    local roadGates = math.clamp(tonumber(info.roadGates) or 0, 0, 2)
    local routeBonus = roadGates * .08
    local intelUntil = tonumber(player:GetAttribute("RoadIntelUntil")) or 0
    local intelBonus = intelUntil &gt; os.time() and .12 or 0
    player:SetAttribute("RoadIntelUntil", nil) -- informer bonus consumed once
    -- ALL accessory boosts add percentage POINTS to other heist bonuses.
    -- Never multiply accessories against one another; no global bonus cap.
    local accessoryBonus = AccessoryConfig.totalPct(data) / 100
    local vipBonus = Monetization.vipCoinBonus(player)
    local cosmeticsPct, heroPct, petPct = CosmeticConfig.heistBonusPct(data)
    local bonus = speedBonus + precisionBonus + streakBonus + newBonus + routeBonus + intelBonus + accessoryBonus + vipBonus + cosmeticsPct/100
    local payout = math.max(1, math.floor(baseReward * (1 + bonus) + .5))

    data.hackXP = math.max(0, math.floor(tonumber(data.hackXP) or 0))
    local class = Classes[info.classId]
    local xpBase = (class and (6 + class.order * 3) or 9) + (precision &gt;= .75 and 3 or 0)
    local xp = math.floor(xpBase * Monetization.vipXPMultiplier(player) + 0.5)
    data.hackXP += xp
    local levels = 0
    while data.hackXP &gt;= needXP(data.hackLevel) and levels &lt; 10 do
        data.hackXP -= needXP(data.hackLevel)
        data.hackLevel += 1
        levels += 1
    end

    d.completed += 1
    if precision &gt;= .75 then d.precise += 1 end
    if (RARITY_RANK[info.rarity] or 0) &gt;= (RARITY_RANK.rare or 2) then d.rare += 1 end
    local questReward = 0
    local cleared = {}
    for _, mission in ipairs(DAILY) do
        if not d.claimed[mission.key] and d[mission.key] &gt;= mission.goal then
            d.claimed[mission.key] = true
            local multiplier = 1 + math.min(2, math.floor((data.hackLevel or 1) / 20) * .25)
            local amount = math.floor(mission.reward * multiplier)
            questReward += amount
            table.insert(cleared, mission.title)
        end
    end
    if questReward &gt; 0 then
        payout += questReward
    end
    player:SetAttribute("HeistLastGrade", grade)
    player:SetAttribute("HeistLastPayout", payout)
    -- Additional random collectible reward. Stats come from server data only.
    -- A duplicate is saved for 5-copy merging, but never gives a repeated base bonus.
    local dropNotice = ""
    data.lastHeistZone=math.clamp((class and class.order) or 1,1,5)
    player:SetAttribute("LastHeistZone",data.lastHeistZone)
    if rng:NextNumber() &lt; AccessoryConfig.HEIST_DROP_CHANCE then
        local drop = AccessoryConfig.award(data, rng, data.lastHeistZone)
        if drop then
            player:SetAttribute("TheftIncomeBoostPct", AccessoryConfig.totalPct(data))
            dropNotice = AccessoryConfig.dropMessage(drop)
        end
    end
    sync(player, data)
    local line = ("Ранг %s · серия x%d · +%d XP · бонус %d%% (детали +%d%%)"):format(
        grade, streak, xp, math.floor(bonus * 100 + .5), math.floor(accessoryBonus * 100 + .5))
    if levels &gt; 0 then line ..= (" · уровень взлома %d!"):format(data.hackLevel) end
    if questReward &gt; 0 then line ..= (" · задания +%d$"):format(questReward) end
    if roadGates &gt; 0 then line ..= (" · ворота %d/2"):format(roadGates) end
    if intelBonus &gt; 0 then line ..= " · информация +12%" end
    if vipBonus &gt; 0 then line ..= (" · VIP +%d%% $ / +%d%% XP"):format(VIPConfig.BONUS_COINS_PCT,VIPConfig.BONUS_XP_PCT) end
    if heroPct &gt; 0 then line ..= (" · скин героя +%d%% $"):format(heroPct) end
    if petPct &gt; 0 then line ..= (" · питомец +%d%% $"):format(petPct) end
    if #cleared &gt; 0 then
        Net.notify(player, "Контракт выполнен: " .. table.concat(cleared, ", "), "good")
    end
    if dropNotice ~= "" then line ..= " · " .. dropNotice end
    return payout, line
end
function HeistService.init()
    Players.PlayerRemoving:Connect(function(player) streaks[player] = nil end)
    Players.PlayerAdded:Connect(function(player)
        streaks[player] = 0
        DataService.onLoaded(player, function(data)
            if type(data.hackXP) ~= "number" or data.hackXP &lt; 0 or data.hackXP ~= data.hackXP then
                data.hackXP = 0
            end
            sync(player, data)
        end)
    end)
    for _, player in ipairs(Players:GetPlayers()) do
        streaks[player] = 0
        DataService.onLoaded(player, function(data) sync(player, data) end)
    end
    -- Daily reset is silent and doesn't require rejoining.
    task.spawn(function()
        while true do
            task.wait(30)
            for _, player in ipairs(Players:GetPlayers()) do
                local data = DataService.get(player)
                if data then sync(player, data) end
            end
        end
    end)
end
return HeistService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_ROAD_EVENTS_V3"><Properties><string name="Name">RoadEventService</string><ProtectedString name="Source">-- RoadEventService / optional side activities using only native Roblox parts.
-- All money and gate rewards are checked and granted by the server.
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local DistrictManager = require(script.Parent.DistrictManager)
local DeliveryService = require(script.Parent.DeliveryService)
local DataService = require(script.Parent.DataService)
local Net = require(script.Parent.Net)
local Layout = require(Shared.TrackLayout)
local Settings = require(Shared.Config.Settings)
local P = require(script.Parent.TrackParts)

local RoadEventService = {}
local rng = Random.new()
local cooldown = {} -- [player] = {cache=clock, informant=clock}
local lastX = setmetatable({}, {__mode = "k"}) -- per-car crossing detection
local models = {}
local gates = {}
local function box(parent,name,size,pos,color,material)
    return P.part(parent,name,size,pos,color,material or Enum.Material.SmoothPlastic,false)
end
local function sign(part, words, tint)
    local bb = Instance.new("BillboardGui")
    bb.Name = "RoadLabel"; bb.Adornee = part
    bb.Size = UDim2.fromOffset(180,32)
    bb.StudsOffset = Vector3.new(0,3,0)
    bb.MaxDistance = 65; bb.AlwaysOnTop = false; bb.Parent = part
    local t = Instance.new("TextLabel")
    t.BackgroundColor3 = Color3.fromRGB(15,24,34)
    t.BackgroundTransparency = .22
    t.TextColor3 = tint or Color3.fromRGB(225,245,255)
    t.TextScaled = true; t.Font = Enum.Font.GothamBold
    t.Size = UDim2.fromScale(1,1); t.Text = words; t.Parent = bb
    local c = Instance.new("UICorner"); c.CornerRadius=UDim.new(0,7); c.Parent=t
end
local function interaction(obj, title, action, callback)
    local pr = Instance.new("ProximityPrompt")
    pr.Name="ActivityPrompt"; pr.ObjectText=title; pr.ActionText=action
    pr.HoldDuration=.65; pr.MaxActivationDistance=11
    pr.RequiresLineOfSight=false; pr.Parent=obj
    pr.Triggered:Connect(function(player)
        local char=player.Character
        local root=char and char:FindFirstChild("HumanoidRootPart")
        if not root or (root.Position-obj.Position).Magnitude &gt; 15 then return end
        local data=DataService.get(player)
        if not data then return end
        callback(player,data)
    end)
end
local function makeActivity(model,index,kind,x,z)
    local root=Instance.new("Model")
    root.Name=kind.."_"..index; root.Parent=model
    local tint=(kind=="Cache" and Color3.fromRGB(225,175,65) or Color3.fromRGB(70,209,232))
    local base=box(root,"Platform",Vector3.new(10,.55,8),Vector3.new(x,.48,z),Color3.fromRGB(34,43,55),Enum.Material.Metal)
    local counter=box(root,"Station",Vector3.new(4.3,3,2.7),Vector3.new(x,2.1,z),tint,Enum.Material.SmoothPlastic)
    box(root,"NeonBand",Vector3.new(4.5,.25,2.85),Vector3.new(x,3.8,z),tint,Enum.Material.Neon)
    box(root,"DarkWindow",Vector3.new(3.6,1.2,.12),Vector3.new(x,2.6,z-1.4),Color3.fromRGB(22,35,45),Enum.Material.Glass)
    local title=kind=="Cache" and "ТАЙНИК · НАГРАДА" or "ИНФОРМАТОР · +12%"
    sign(counter,title,tint)
    if kind=="Cache" then
        interaction(counter,"Дорожный тайник","Обыскать",function(player,data)
            cooldown[player]=cooldown[player] or {}
            local now=os.clock()
            local waitUntil=cooldown[player].cache or 0
            if now &lt; waitUntil then
                Net.notify(player,("Тайники снова доступны через %d с."):format(math.ceil(waitUntil-now)),"info")
                return
            end
            cooldown[player].cache=now+180
            local amount=35+index*22+rng:NextInteger(0,32)
            DataService.addMoney(player,amount)
            Net.notify(player,("Найден дорожный тайник: +%d$. Следующий через 3 минуты."):format(amount),"good")
        end)
    else
        interaction(counter,"Информатор","Получить наводку",function(player,data)
            cooldown[player]=cooldown[player] or {}
            local now=os.clock()
            local waitUntil=cooldown[player].informant or 0
            if now &lt; waitUntil then
                Net.notify(player,("Информатор будет готов через %d с."):format(math.ceil(waitUntil-now)),"info")
                return
            end
            cooldown[player].informant=now+150
            player:SetAttribute("RoadIntelUntil",os.time()+300)
            Net.notify(player,"Наводка получена: +12% к следующей успешной доставке (действует 5 минут).","good")
        end)
    end
end
local function makeGate(model,index,x)
    local gate=Instance.new("Model")
    gate.Name="RouteGate_"..index; gate.Parent=model
    for _,side in ipairs({-1,1}) do
        box(gate,"GatePost",Vector3.new(1.2,11,1.4),Vector3.new(x,5.5,side*22.7),Color3.fromRGB(45,130,166),Enum.Material.Metal)
        box(gate,"GateLight",Vector3.new(1.3,4,.5),Vector3.new(x,7.5,side*21.7),Color3.fromRGB(55,227,220),Enum.Material.Neon)
    end
    local beam=box(gate,"GateBeam",Vector3.new(1.0,1.5,46),Vector3.new(x,11.5,0),Color3.fromRGB(34,50,75),Enum.Material.Metal)
    local textPart=box(gate,"BonusRouteSign",Vector3.new(1.2,2,18),Vector3.new(x,10.8,0),Color3.fromRGB(34,86,111),Enum.Material.SmoothPlastic)
    P.signFace(textPart,Enum.NormalId.Right,"ЧИСТЫЙ МАРШРУТ +8%")
    P.signFace(textPart,Enum.NormalId.Left,"ЧИСТЫЙ МАРШРУТ +8%")
    gates[index]=x
end
local function onLoaded(index, districtModel)
    if models[index] then models[index]:Destroy() end
    local m=Instance.new("Folder");m.Name="RoadActivities";m.Parent=districtModel;models[index]=m
    local start=Layout.districtStart(index)
    makeActivity(m,index,"Cache",start+150,35)
    makeActivity(m,index,"Informant",start+325,-35)
    makeGate(m,index,start+465)
end
local function onUnloaded(index)
    models[index]=nil; gates[index]=nil
end
function RoadEventService.init()
    DistrictManager.onLoaded(onLoaded)
    DistrictManager.onUnloaded(onUnloaded)
    Players.PlayerRemoving:Connect(function(player) cooldown[player]=nil end)
    task.spawn(function()
        while true do
            task.wait(.2)
            for _,player in ipairs(Players:GetPlayers()) do
                local car=DeliveryService.getCarrying(player)
                if car and car.Parent then
                    local now=car:GetPivot().Position
                    local previous=lastX[car]
                    local seat=car:FindFirstChildWhichIsA("VehicleSeat",true)
                    local isDriving=seat and seat.Occupant and seat.Occupant.Parent == player.Character
                    if previous and isDriving and car:GetAttribute("Drivable") and math.abs(now.Z)&lt;=17.5 then
                        for i,x in pairs(gates) do
                            if previous &gt; x and now.X &lt;= x and not car:GetAttribute("RoadGate_"..i) then
                                car:SetAttribute("RoadGate_"..i,true)
                                local oldCount=car:GetAttribute("RoadGateCount") or 0
                                local count=math.min(2,oldCount+1)
                                car:SetAttribute("RoadGateCount",count)
                                if oldCount &lt; 2 then Net.notify(player,"Контрольные ворота пройдены! Бонус за маршрут при доставке.","good") end
                            end
                        end
                    end
                    lastX[car]=now.X
                end
            end
        end
    end)
end
return RoadEventService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_CHALLENGE_V4"><Properties><string name="Name">RoadChallengeService</string><ProtectedString name="Source">-- STEAL60 / ROAD CHALLENGES v4
-- All event creation, driving checks, and rewards are authoritative on the server.
-- No external meshes, images, asset IDs, or paid assets.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Layout = require(Shared.TrackLayout)
local Classes = require(Shared.Config.CarClasses)
local Districts = require(Shared.Config.Districts)
local ParkingService = require(script.Parent.ParkingService)
local DistrictManager = require(script.Parent.DistrictManager)
local DeliveryService = require(script.Parent.DeliveryService)
local DataService = require(script.Parent.DataService)
local TrackParts = require(script.Parent.TrackParts)
local Net = require(script.Parent.Net)

local Service = {}
local random = Random.new()
local active = {}   -- [district] -&gt; {model, road, vipCar, vipID, ...}
local sequence = 0
local crossing = setmetatable({}, {__mode="k"})
local CLASS_ORDER = {"junk", "regular", "sport", "premium", "super"}

local function part(parent, name, size, at, color, material, collision)
    return TrackParts.part(parent, name, size, at, color, material or Enum.Material.SmoothPlastic, collision)
end
local function floatingLabel(adornee, title, color, offset, distance)
    local b = Instance.new("BillboardGui")
    b.Name = "EventLabel"; b.Size = UDim2.fromOffset(200, 39)
    b.StudsOffset = offset or Vector3.new(0, 4, 0)
    b.MaxDistance = distance or 85
    b.AlwaysOnTop = false; b.Adornee = adornee; b.Parent = adornee
    local text = Instance.new("TextLabel")
    text.Size = UDim2.fromScale(1, 1)
    text.BackgroundColor3 = Color3.fromRGB(14, 22, 33)
    text.BackgroundTransparency = .12
    text.TextColor3 = color
    text.TextSize = 15
    text.Text = title
    text.Font = Enum.Font.GothamBold
    text.Parent = b
    local corner = Instance.new("UICorner"); corner.CornerRadius = UDim.new(0, 7); corner.Parent = text
    return b
end

local function clearVIP(s)
    local car = s.vipCar
    local id = s.vipID
    if car and car.Parent and car:GetAttribute("RoadVIPId") == id then
        car:SetAttribute("RoadVIPId", nil)
        car:SetAttribute("RoadVIPBonus", nil)
        local shine = car:FindFirstChild("RoadVIPGlow")
        if shine then shine:Destroy() end
        local adornee = car.PrimaryPart or car:FindFirstChildWhichIsA("BasePart", true)
        if adornee then
            local label = adornee:FindFirstChild("RoadVIPLabel")
            if label then label:Destroy() end
        end
    end
    s.vipCar = nil
    s.vipID = nil
end

local function runVIP(s)
    clearVIP(s)
    -- Cars are spawned by the existing parking system. No new car is fabricated here.
    local available = ParkingService.getAvailableCars(s.index)
    if #available == 0 then return end
    -- Prefer actual rare/epic/legendary parked cars when there is one.
    local rare = {}
    for _, candidate in ipairs(available) do
        if candidate:GetAttribute("Rarity") ~= "common" then
            table.insert(rare, candidate)
        end
    end
    local selection = #rare &gt; 0 and rare or available
    local car = selection[random:NextInteger(1,#selection)]
    if car:GetAttribute("State") ~= "available" then return end
    sequence += 1
    local id = sequence
    s.vipCar, s.vipID = car, id
    car:SetAttribute("RoadVIPId", id)
    car:SetAttribute("RoadVIPBonus", .75)
    local glow = Instance.new("Highlight")
    glow.Name = "RoadVIPGlow"
    glow.FillTransparency = 1
    glow.OutlineTransparency = .10
    glow.OutlineColor = Color3.fromRGB(255, 196, 70)
    glow.DepthMode = Enum.HighlightDepthMode.Occluded
    glow.Adornee = car
    glow.Parent = car
    local anchor = car.PrimaryPart or car:FindFirstChildWhichIsA("BasePart", true)
    if anchor then
        local label = floatingLabel(anchor,"★ ОСОБАЯ ЦЕЛЬ · +75%",Color3.fromRGB(255,223,134),Vector3.new(0,5,0),75)
        label.Name = "RoadVIPLabel"
    end
    local started = os.clock()
    task.delay(85, function()
        if active[s.index] == s and s.vipID == id and os.clock()-started&gt;=84 then
            clearVIP(s)
        end
    end)
end

local function clearRoad(s)
    local road = s.road
    if road and road.model then road.model:Destroy() end
    s.road = nil
end

local function createRoadEvent(s, kind)
    clearRoad(s)
    if not s.model or not s.model.Parent then return end
    sequence += 1
    local id = sequence
    local side = random:NextInteger(0,1) == 0 and -1 or 1
    local start = Layout.districtStart(s.index)
    local x = start + (kind == "police" and 395 or 250)
    local centerZ = side*10.5
    local model = Instance.new("Model")
    model.Name = kind == "police" and "PoliceCheckpoint" or "TemporaryRoadworks"
    model.Parent = s.model
    -- Block only one lane: the opposite lane remains open for a detour.
    local barrier = part(model,"Barricade",Vector3.new(2.6,2.6,13.8),Vector3.new(x,1.55,centerZ),Color3.fromRGB(49,54,66),Enum.Material.Metal,true)
    barrier.Transparency = .05
    -- Kinematic vehicle controller blocks only true barricades, not light cones.
    game:GetService("CollectionService"):AddTag(barrier,"S60DriveObstacle")
    for j=1,5 do
        local z=centerZ-5.5+(j-1)*2.75
        local lamp=part(model,"WarningReflector",Vector3.new(.35,.35,1.45),Vector3.new(x-1.38,2.27,z),
            (j%2==0 and Color3.fromRGB(253,170,60) or Color3.fromRGB(255,244,219)),Enum.Material.Neon,false)
        lamp.CanTouch=false
    end
    for j=1,4 do
        local z=centerZ+((j-2.5)*5)
        local cone=part(model,"Cone",Vector3.new(2.0,1.35,1.35),
            Vector3.new(x+12,1.08,z),Color3.fromRGB(239,126,39),Enum.Material.SmoothPlastic,false)
        cone.Shape=Enum.PartType.Cylinder
        cone.CFrame=cone.CFrame*CFrame.Angles(0,0,math.pi/2)
        cone.CanQuery=false
        cone.CanCollide=false
        cone.CanTouch=false
        -- Cone is light and falls away when hit. No arcade roadblock tag.
        game:GetService("CollectionService"):RemoveTag(cone,"S60DriveObstacle")
        game:GetService("CollectionService"):AddTag(cone,"S60KnockdownCone")
        local band=part(model,"ConeWhiteBand",Vector3.new(1.42,.23,1.42),
            cone.Position+Vector3.new(0,.24,0),Color3.fromRGB(255,247,213),Enum.Material.Neon,false)
        band.CanCollide=false
        band.Massless=true
        band.Anchored=false
        local weld=Instance.new("WeldConstraint")
        weld.Part0=cone;weld.Part1=band;weld.Parent=band
    end
    local post=part(model,"Post",Vector3.new(1.0,6,1),Vector3.new(x+32,3,side*24),Color3.fromRGB(55,67,85),Enum.Material.Metal,false)
    local title = kind == "police" and "ПОЛИЦИЯ · ОБЪЕЗД" or "РЕМОНТ · ОБЪЕЗД"
    floatingLabel(post,title,(kind=="police" and Color3.fromRGB(255,135,135) or Color3.fromRGB(255,211,115)),Vector3.new(0,4,0),100)
    if kind == "police" then
        for _,offset in ipairs({-1,1}) do
            local light=part(model,"PoliceBeacon",Vector3.new(1.9,.55,1.9),Vector3.new(x+4,2.65,side*24+offset*1.2),
                offset==1 and Color3.fromRGB(255,43,66) or Color3.fromRGB(48,117,255),Enum.Material.Neon,false)
            local point=Instance.new("PointLight")
            point.Color=light.Color;point.Range=18;point.Brightness=1;point.Parent=light
        end
    else
        part(model,"AsphaltPatch",Vector3.new(30,.07,12),Vector3.new(x,0.28,centerZ),Color3.fromRGB(32,32,35),Enum.Material.Asphalt,false)
    end
    s.road = {model=model, kind=kind, x=x, side=side, id=id, expires=os.clock()+65}
end

local function makeContract(data)
    local level = math.max(1, tonumber(data.hackLevel) or 1)
    local highest=1
    for i,cl in ipairs(CLASS_ORDER) do
        if (Classes[cl] and level &gt;= Classes[cl].requiredHack) then highest=i end
    end
    -- Targets always fit the player's skill, including their first on-foot heist.
    local selected = random:NextInteger(math.max(1,highest-1),highest)
    local classId=CLASS_ORDER[selected]
    local reward=100 + selected*100
    return {classId=classId, reward=reward, issued=os.time()}
end
local function setContractAttributes(player, contract)
    local def=Classes[contract.classId]
    player:SetAttribute("RoadContractTitle", "ЗАКАЗ: " .. (def and def.name or "Автомобиль"))
    player:SetAttribute("RoadContractReward", contract.reward)
end
local function playerLoaded(player,data)
    if not player.Parent then return end
    if type(data.roadContract) ~= "table"
        or type(data.roadContract.classId) ~= "string"
        or type(data.roadContract.reward) ~= "number"
        or not Classes[data.roadContract.classId] then
        data.roadContract = makeContract(data)
    end
    setContractAttributes(player,data.roadContract)
    player:SetAttribute("RoadEventHint","")
    player:SetAttribute("RoadCheckpointCount",0)
end
function Service.onDelivered(player, info, baseReward)
    local data=DataService.get(player)
    if not data then return 0,"" end
    local extra=0
    local labels={}
    if info.vipBonus and info.vipBonus &gt; 0 then
        local amount=math.floor(math.max(1,baseReward)*math.min(info.vipBonus,.75))
        extra+=amount
        table.insert(labels,("особая цель +%d$"):format(amount))
    end
    if info.policePassed == true then
        local amount=math.floor(math.max(1,baseReward)*.10)
        extra+=amount
        table.insert(labels,("объезд полиции +%d$"):format(amount))
    end
    local c=data.roadContract
    if type(c)=="table" and c.classId==info.classId then
        local amount=math.max(0,math.floor(tonumber(c.reward) or 0))
        amount=math.min(amount,1000)
        extra+=amount
        table.insert(labels,("спецзаказ +%d$"):format(amount))
        data.roadContract=makeContract(data)
        setContractAttributes(player,data.roadContract)
        Net.notify(player,"ЗАКАЗ ВЫПОЛНЕН! Новый заказ уже в навигаторе.","good")
    end
    return extra, table.concat(labels," · ")
end

-- Native, lightweight roadside furniture: multiple sign types and signal heads.
-- These decorate the district and do NOT apply violent physics to cars.
local function decorateRoadSignals(index, districtModel)
    local root=Instance.new("Folder")
    root.Name="RoadSignsAndTrafficLights"
    root.Parent=districtModel
    local start=Layout.districtStart(index)
    local palette={
        {text="40",color=Color3.fromRGB(54,112,220)},
        {text="СТОП",color=Color3.fromRGB(196,56,63)},
        {text="ПОВОРОТ",color=Color3.fromRGB(205,158,51)},
        {text="УСТУПИ",color=Color3.fromRGB(53,139,125)},
        {text="ОБЪЕЗД",color=Color3.fromRGB(210,116,38)},
    }
    for k=1,5 do
        local at=start+55+k*97
        local side=(k%2==0 and 1 or -1)
        local pole=part(root,"RoadSignPole",Vector3.new(.37,6,.37),
            Vector3.new(at,3.0,side*32),Color3.fromRGB(86,104,119),Enum.Material.Metal,false)
        local info=palette[(k+index-2)%#palette+1]
        local plate=part(root,"TrafficSign_"..info.text,Vector3.new(.42,2.7,3.0),
            Vector3.new(at,5.9,side*32),info.color,Enum.Material.SmoothPlastic,false)
        TrackParts.signFace(plate,Enum.NormalId.Left,info.text,Color3.fromRGB(255,255,255))
        TrackParts.signFace(plate,Enum.NormalId.Right,info.text,Color3.fromRGB(255,255,255))
    end
    for k=1,2 do
        local at=start+190+(k-1)*310
        local side=k==1 and -1 or 1
        part(root,"SignalPole",Vector3.new(.55,8,.55),
            Vector3.new(at,4,side*31),Color3.fromRGB(74,91,106),Enum.Material.Metal,false)
        part(root,"SignalHousing",Vector3.new(1.3,4.5,1.8),
            Vector3.new(at,8.1,side*31),Color3.fromRGB(22,33,47),Enum.Material.Metal,false)
        local lights={}
        for j,color in ipairs({Color3.fromRGB(237,74,78),Color3.fromRGB(255,192,55),Color3.fromRGB(63,227,121)}) do
            local orb=part(root,"SignalLamp_"..j,Vector3.new(.35,.8,.8),
                Vector3.new(at-.72,9.25-(j-1)*1.28,side*31),color,Enum.Material.Neon,false)
            orb.Shape=Enum.PartType.Ball
            orb.Transparency=.75
            lights[j]=orb
        end
        task.spawn(function()
            local phase=k
            while root.Parent and lights[1].Parent do
                phase=phase%3+1
                for j,lamp in ipairs(lights) do
                    lamp.Transparency=j==phase and 0 or .76
                end
                task.wait(5)
            end
        end)
    end
end

local function onDistrictLoaded(index,model)
    local s={index=index,model=model,road=nil,vipCar=nil,vipID=nil}
    active[index]=s
    decorateRoadSignals(index,model)
    task.spawn(function()
        task.wait(9) -- park spawns finish before selection
        while active[index]==s and model.Parent do
            runVIP(s)
            task.wait(15)
            if active[index]~=s then break end
            createRoadEvent(s,random:NextNumber()&lt;.55 and "police" or "repair")
            task.wait(65)
            if active[index]~=s then break end
            clearRoad(s)
            task.wait(55)
        end
    end)
end
local function onDistrictUnloaded(index)
    local s=active[index]
    if s then
        active[index]=nil
        clearVIP(s)
        clearRoad(s)
    end
end
local function vehicleOf(player)
    local car=DeliveryService.getCarrying(player)
    if not car or not car.Parent then return nil end
    local seat=car:FindFirstChildWhichIsA("VehicleSeat",true)
    if not seat or not seat.Occupant or seat.Occupant.Parent~=player.Character then return nil end
    if car:GetAttribute("Drivable") ~= true then return nil end
    return car
end

function Service.init()
    DistrictManager.onLoaded(onDistrictLoaded)
    DistrictManager.onUnloaded(onDistrictUnloaded)
    Players.PlayerAdded:Connect(function(player)
        DataService.onLoaded(player,function(data) playerLoaded(player,data) end)
    end)
    for _,player in ipairs(Players:GetPlayers()) do
        DataService.onLoaded(player,function(data) playerLoaded(player,data) end)
    end
    Players.PlayerRemoving:Connect(function(player)
        player:SetAttribute("RoadEventHint", nil)
    end)
    task.spawn(function()
        while true do
            task.wait(.22)
            for _,player in ipairs(Players:GetPlayers()) do
                local car=vehicleOf(player)
                if car then
                    local pos=car:GetPivot().Position
                    local previous=crossing[car]
                    local nearbyText=""
                    for index,s in pairs(active) do
                        local e=s.road
                        if e and e.model and e.model.Parent then
                            local distance=pos.X-e.x
                            if distance &gt; -16 and distance &lt; 145 and math.abs(pos.Z)&lt;32 then
                                nearbyText=e.kind=="police" and "ПРОВЕРКА ПОЛИЦИИ — ОБЪЕДЬ ПО СВОБОДНОЙ ПОЛОСЕ" or "РЕМОНТ ДОРОГИ — ОБЪЕЗД"
                            end
                            -- Verify an actual crossing in an eligible car, in the open lane.
                            if previous and previous&gt;e.x and pos.X&lt;=e.x and math.abs(pos.Z)&lt;19
                                and (pos.Z*e.side)&lt;-2 and e.kind=="police"
                                and car:GetAttribute("PoliceEventPassed")~=true then
                                car:SetAttribute("PoliceEventPassed",true)
                                player:SetAttribute("RoadCheckpointCount",1)
                                Net.notify(player,"Объехал полицейский пост! +10% к базовой награде при доставке.","good")
                            end
                        end
                    end
                    if player:GetAttribute("RoadEventHint")~=nearbyText then
                        player:SetAttribute("RoadEventHint",nearbyText)
                    end
                    crossing[car]=pos.X
                else
                    if player:GetAttribute("RoadEventHint")~="" then player:SetAttribute("RoadEventHint","") end
                end
            end
        end
    end)
end
return Service
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX100001"><Properties>
            <string name="Name">SeasonLeaderboardService</string>
            <ProtectedString name="Source">-- ModuleScript: ServerScriptService/Services/SeasonLeaderboardService
-- Current 30-day season, TOP-100 by coins earned (NOT wallet balance).
-- Cached on the server; one OrderedDataStore page is max 100 entries.
local Players=game:GetService("Players")
local DSS=game:GetService("DataStoreService")
local Services=script.Parent
local DataService=require(Services.DataService)
local Net=require(Services.Net)
local Board={}
local pending,working={},{}
local names,nameLoading={},{}
local activeNameRequests=0
local cached={season=-1,entries={},updatedAt=0,status="Загрузка рейтинга..."}
local readBusy=false
local storeObj,storeIndex
local UPLOAD_INTERVAL=55
local REFRESH_INTERVAL=95
local lastClientRequest={}

local function seasonStore(index)
    if storeObj and storeIndex==index then return storeObj end
    storeIndex=index
    -- Keep the EXACT v22 DataStore prefix: historical season scores remain intact.
    storeObj=DSS:GetOrderedDataStore("Steal60_Earned_30Days_v22_"..tostring(index))
    return storeObj
end
local function resolveName(id)
    local online=Players:GetPlayerByUserId(id)
    if online then return online.DisplayName end
    return names[id] or ("Игрок #"..id)
end
local function queueName(id)
    if names[id] or nameLoading[id] then return end
    local online=Players:GetPlayerByUserId(id)
    if online then names[id]=online.DisplayName;return end
    nameLoading[id]=true
    task.spawn(function()
        -- Bound concurrent lookups; a top-100 refresh should not issue 100
        -- simultaneous username requests to Roblox.
        while activeNameRequests&gt;=4 do task.wait(.2) end
        activeNameRequests+=1
        local ok,value=pcall(Players.GetNameFromUserIdAsync,Players,id)
        if ok then names[id]=value end
        activeNameRequests-=1
        nameLoading[id]=nil
    end)
end
local function upload(player)
    if working[player] then return end
    local record=pending[player]
    if not record or record.score&lt;=0 then return end
    working[player]=true
    local season,score=record.season,record.score
    local ok,err=pcall(function()
        seasonStore(season):UpdateAsync(tostring(player.UserId),function(old)
            return math.max(tonumber(old) or 0,score)
        end)
    end)
    if ok then
        local latest=pending[player]
        if latest and latest.season==season and latest.score&lt;=score then
            pending[player]=nil
        end
    else
        warn("[Steal60/Top100] Upload error: "..tostring(err))
    end
    working[player]=nil
end
local function refreshTop()
    if readBusy then return end
    readBusy=true
    local season=DataService.currentSeason()
    local ok,pages=pcall(function()
        return seasonStore(season):GetSortedAsync(false,100)
    end)
    if ok then
        local result={}
        for rank,entry in ipairs(pages:GetCurrentPage()) do
            local id=tonumber(entry.key)
            if id then
                result[#result+1]={rank=rank,userId=id,score=math.floor(tonumber(entry.value) or 0)}
                queueName(id)
            end
        end
        cached={season=season,entries=result,updatedAt=os.time(),status=""}
    else
        cached.status="Рейтинг недоступен: проверь DataStore API"
        warn("[Steal60/Top100] Read error: "..tostring(pages))
    end
    readBusy=false
end
local function getTop(player)
    local now=os.clock()
    if lastClientRequest[player] and now-lastClientRequest[player]&lt;2 then
        return {rateLimited=true}
    end
    lastClientRequest[player]=now
    local season,startAt,endAt=DataService.currentSeason()
    if cached.season~=season or os.time()-cached.updatedAt&gt;REFRESH_INTERVAL then
        task.spawn(refreshTop)
    end
    local out={season=season,startsAt=startAt,endsAt=endAt,updatedAt=cached.updatedAt,
        status=cached.status,entries={},maxEntries=100}
    if cached.season==season then
        for i,e in ipairs(cached.entries) do
            out.entries[i]={rank=e.rank,userId=e.userId,name=resolveName(e.userId),score=e.score}
        end
    end
    return out
end
function Board.init()
    Net.GetSeasonTop.OnServerInvoke=getTop
    DataService.onMoneyEarned(function(player,season,score)
        pending[player]={season=season,score=score}
    end)
    local function watch(player)
        DataService.onLoaded(player,function()
            local season,score=DataService.getSeasonScore(player)
            if season and score and score&gt;0 then pending[player]={season=season,score=score} end
        end)
    end
    Players.PlayerAdded:Connect(watch)
    for _,p in ipairs(Players:GetPlayers()) do watch(p) end
    Players.PlayerRemoving:Connect(function(p)
        local season,score=DataService.getSeasonScore(p)
        if season and score and score&gt;0 then pending[p]={season=season,score=score} end
        task.spawn(upload,p)
        lastClientRequest[p]=nil
    end)
    task.spawn(function()
        while true do
            for p in pairs(pending) do task.spawn(upload,p) end
            task.wait(UPLOAD_INTERVAL)
        end
    end)
    task.spawn(function()
        while true do
            refreshTop()
            task.wait(REFRESH_INTERVAL)
        end
    end)
end
function Board.getPublicSnapshot()
    local result={}
    for _,e in ipairs(cached.entries) do
        result[#result+1]={rank=e.rank,name=resolveName(e.userId),score=e.score}
    end
    return result
end
return Board
</ProtectedString>
          </Properties>
        </Item><Item class="ModuleScript" referent="RBXGEN_V37_CosmeticService">
          <Properties>
            <string name="Name">CosmeticService</string>
            <ProtectedString name="Source">-- Server-only cosmetic ownership, spending and replicated visuals.
-- Cosmetic visuals plus server-authoritative, additive coin heist bonuses.
local Players=game:GetService("Players")
local RS=game:GetService("ReplicatedStorage")
local Data=require(script.Parent.DataService)
local Net=require(script.Parent.Net)
local Config=require(RS.Shared.Config.CosmeticConfig)
local Wardrobe=require(script.Parent.WardrobeService)
local PetVisuals=require(RS.Shared.PetVisualLibrary)
local CarArt=require(RS.Shared.CarCosmeticArt)
local AuraVisuals=require(RS.Shared.AuraVisualLibrary)
local M={}
local cooldown={}
local purchasing={}
local petFolder=Instance.new("Folder")
petFolder.Name="Steal60CosmeticPets"
petFolder.Parent=workspace
local activePets={}
local function sanitized(data)
 data.cosmeticsOwned=type(data.cosmeticsOwned)=="table" and data.cosmeticsOwned or {}
 data.cosmeticsEquipped=type(data.cosmeticsEquipped)=="table" and data.cosmeticsEquipped or {}
 data.carCosmetics=type(data.carCosmetics)=="table" and data.carCosmetics or {}
 Config.migrateHeroOwnership(data.cosmeticsOwned)
 -- Migrate ANY v37 purchased pet into the v38 permanent pet license.
 if data.petUnlocked~=true then
  for id,has in pairs(data.cosmeticsOwned) do
   local def=Config.ById[id]
   if has==true and def and def.category=="pet" then
    data.petUnlocked=true
    break
   end
  end
 end
 if data.petUnlocked==true then
  -- A license opens all four current visuals and all future pet appearances.
  for _,def in ipairs(Config.List) do
   if def.category=="pet" then data.cosmeticsOwned[def.id]=true end
  end
 end
 data.heroSkinBonusLevel=Config.heroLevel(data)
 data.petBonusLevel=Config.petLevel(data)
 return data.cosmeticsOwned,data.cosmeticsEquipped
end
local function shallow(t)
 local c={}
 for k,v in pairs(t) do c[k]=v end
 return c
end
-- Detailed original in-game outfits; renderer is shared with 3D shop previews.
-- Cosmetics remain server-authoritative; no Marketplace asset is copied into a paid game skin.
local function applyHero(player)
 local data=Data.get(player);if not data then return end
 local owned,equip=sanitized(data)
 local def=equip.hero and Config.ById[equip.hero]
 if not def or def.category~="hero"or owned[def.id]~=true then def=nil end
 Wardrobe.request(player,def)
end
-- Quiet but distinct premium aura styles; no glowing boxes at character feet.
-- v47 delicate aura: narrow translucent light paths, a few small sparks, no floodlight.
local function applyAura(player)
 local char=player.Character;local root=char and char:FindFirstChild("HumanoidRootPart")
 if not root then return end
 local old=root:FindFirstChild("Steal60CosmeticAura");if old then old:Destroy()end
 local data=Data.get(player);if not data then return end
 local owned,equip=sanitized(data);local def=equip.aura and Config.ById[equip.aura]
 if not def or def.category~="aura"or owned[def.id]~=true then return end
 AuraVisuals.create(root,def)
end
local function makePet(player,def)
 local model=PetVisuals.create(def)
 model.Name="Питомец · "..player.Name
 model:SetAttribute("CosmeticId",def.id)
 model:SetAttribute("PetOwnerUserId",player.UserId)
 model:SetAttribute("PetMovementType",def.movement or "fly")
 -- The anchored cosmetic model is a shared replicated template. Every client
 -- smoothly positions it locally; the server never transmits 22Hz PivotTo steps.
 model:SetAttribute("PetMounted",false)
 local character=player.Character
 local root=character and character:FindFirstChild("HumanoidRootPart")
 if root then model:PivotTo(root.CFrame*CFrame.new(3.4,1.5,3.8)) end
 model.Parent=petFolder
 return model
end
local function refreshPet(player)
 if activePets[player] then activePets[player]:Destroy();activePets[player]=nil end
 local data=Data.get(player)
 if not data then return end
 local owned,equip=sanitized(data)
 local id=equip.pet
 local def=id and Config.ById[id]
 if def and def.category=="pet" and data.petUnlocked==true then
  activePets[player]=makePet(player,def)
 end
end
local function paintCar(car,def,skin)
 CarArt.finish(car,def,skin)
end
local function applyCars()
 local salons=workspace:FindFirstChild("Salons")
 local rideCars=workspace:FindFirstChild("RideCars")
 local districts=workspace:FindFirstChild("Districts")
 local stolen=workspace:FindFirstChild("StolenCars")
 local roots={salons or false,rideCars or false,districts or false,stolen or false}
 local seen={}
 -- No full-map traversal; these are the folders containing owned/display and ride cars.
 for _,folder in ipairs(roots) do
  if folder and folder~=false then
   for _,car in ipairs(folder:GetDescendants()) do
    if car:IsA("Model") and car:GetAttribute("CarId") and not seen[car] then
     seen[car]=true
     local ownerId=car:GetAttribute("DriverId") or car:GetAttribute("OwnerId")
     local player=ownerId and Players:GetPlayerByUserId(ownerId)
     local data=player and Data.get(player)
     if data then
      local owned,equip=sanitized(data)
      local carId=car:GetAttribute("CarId")
      local setting=(data.carCosmetics or {})[carId]
      setting=type(setting)=="table" and setting or {}
      local id=setting.paint
      local def=id and Config.ById[id]
      if not def or def.category~="paint" or owned[id]~=true then def=nil end
      local skinId=setting.skin
      local skin=skinId and Config.ById[skinId]
      if not skin or skin.category~="skin" or owned[skinId]~=true then skin=nil end
      local key=tostring(ownerId)..":"..tostring(id)..":"..tostring(skinId)..":"..tostring(carId)
      if car:GetAttribute("CosmeticApplied")~=key then
       paintCar(car,def,skin)
       car:SetAttribute("CosmeticApplied",key)
      end
     end
    end
   end
  end
 end
end
local function refreshAppearance(player, category)
 if category=="pet" then
  refreshPet(player)
 elseif category=="hero" then
  applyHero(player)
 elseif category=="aura" then
  applyAura(player)
 elseif category=="paint" or category=="skin" then
  for _,folderName in ipairs({"Salons","RideCars","Districts","StolenCars"}) do
   local folder=workspace:FindFirstChild(folderName)
   if folder then
    for _,car in ipairs(folder:GetDescendants()) do
     if car:IsA("Model") and (car:GetAttribute("DriverId")==player.UserId or car:GetAttribute("OwnerId")==player.UserId) then
      car:SetAttribute("CosmeticApplied",nil)
     end
    end
   end
  end
  applyCars()
 end
end
local function onAction(player,action,category,id,targetCarId)
 if typeof(action)~="string" or typeof(category)~="string" then return end
 if not ({paint=true,skin=true,hero=true,pet=true,aura=true})[category] then return end
 if not ({buy=true,buyCoins=true,buyDiamonds=true,equip=true,unequip=true,equipCar=true,unequipCar=true,
           unlockPetCoins=true,unlockPetDiamonds=true,upgradeHeroDiamonds=true,upgradeHeroCoins=true,
           upgradePetCoins=true,upgradePetDiamonds=true})[action] then return end
 if purchasing[player] or os.clock()-(cooldown[player] or -10)&lt;.23 then return end
 cooldown[player]=os.clock()
 local data=Data.get(player)
 if not data or not player.Parent then return end
 local owned,equip=sanitized(data)
 local def=typeof(id)=="string" and #id&lt;=48 and Config.ById[id] or nil
 if def and def.category~=category then return end
 if category=="hero"and action=="buyCoins"then Net.notify(player,"Образы продаются за алмазы. Выбери покупку за 💎.","info");return end
 if category=="hero"and def and(action=="buy"or action=="buyCoins"or action=="buyDiamonds"or action=="equip")then
  if def.hiddenFromShop and action~="equip"then Net.notify(player,"Этот старый вариант снят с продажи. Выбери образ из новой витрины.","info");return end
  if not Wardrobe.isReady(def)then Net.notify(player,"Каталожный образ ещё не загрузился. Покупка не выполнена.","info");return end
 end
 local old={
  money=data.money,diamonds=data.diamonds,petUnlocked=data.petUnlocked,
  heroSkinBonusLevel=data.heroSkinBonusLevel,petBonusLevel=data.petBonusLevel,
  owned=shallow(owned),equipped=shallow(equip),carCosmetics=table.clone(data.carCosmetics)
 }
 local message=nil
 local priorTargetSetting=nil
 if typeof(targetCarId)=="string" then
  local prev=data.carCosmetics[targetCarId]
  priorTargetSetting=type(prev)=="table" and shallow(prev) or nil
 end
 local needsSave=false
 local function charge(method,cost)
  if typeof(cost)~="number" or cost&lt;=0 then return false end
  if method=="coins" then
   if not Data.spendMoney(player,cost) then
    Net.notify(player,("Нужно %d монет. Зарабатывай их за угоны."):format(cost),"bad")
    return false
   end
  else
   if not Data.spendDiamonds(player,cost) then
    Net.notify(player,("Нужно %d алмазов 💎."):format(cost),"bad")
    return false
   end
  end
  return true
 end
 if action=="equipCar" or action=="unequipCar" then
  if category~="paint" and category~="skin" then return end
  if typeof(targetCarId)~="string" or #targetCarId&gt;80 or not data.catalog[targetCarId] then
   Net.notify(player,"Сначала выбери купленную машину в каталоге.","bad")
   return
  end
  local oldSetting=data.carCosmetics[targetCarId]
  local setting=type(oldSetting)=="table" and shallow(oldSetting) or {}
  if action=="equipCar" then
   if not def or owned[id]~=true then return end
   setting[category]=id
   message="Машина "..(targetCarId)..": "..def.name.." · окрашена отдельно"
  else
   setting[category]=nil
   message="Для выбранной машины убран стиль "..category.."."
  end
  data.carCosmetics[targetCarId]=setting
  needsSave=true
 elseif action=="unequip" then
  if category=="paint" or category=="skin" then return end
  if equip[category]==nil then return end
  equip[category]=nil
  message=category=="hero"and"Твой Roblox-аватар восстановлен. Костюмы остались в коллекции."or"Внешний вид снят."
  needsSave=true
 elseif action=="equip" then
  if category=="paint" or category=="skin" then return end
  if not def then return end
  if category=="pet" and data.petUnlocked~=true then return end
  if category~="pet" and owned[id]~=true then return end
  if equip[category]==id then return end
  equip[category]=id
  message="Внешний вид: "..def.name
  needsSave=true
 elseif action=="unlockPetCoins" or action=="unlockPetDiamonds" or (action=="buy" and category=="pet") then
  if category~="pet" or data.petUnlocked==true then return end
  local method=(action=="unlockPetCoins") and "coins" or "diamonds"
  local cost=(method=="coins") and Config.PET_LICENSE_COINS or Config.PET_LICENSE_DIAMONDS
  if not charge(method,cost) then return end
  data.petUnlocked=true
  for _,entry in ipairs(Config.List) do
   if entry.category=="pet" then owned[entry.id]=true end
  end
  equip.pet=def and def.id or "pet_orb"
  message="Питомец открыт навсегда! Все его облики теперь бесплатны."
  needsSave=true
 elseif action=="upgradeHeroCoins" then
  if category~="hero" then return end
  local hasSkin=false
  for id_,yes in pairs(owned) do
   local entry=Config.ById[id_]
   if yes==true and entry and entry.category=="hero" then hasSkin=true;break end
  end
  if not hasSkin then Net.notify(player,"Сначала открой любой скин героя.","info");return end
  local oldLevel=Config.heroLevel(data)
  local cost=Config.heroUpgradeCoins(oldLevel)
  if not cost then Net.notify(player,"Герой +10% · MAX","info");return end
  if not charge("coins",cost) then return end
  data.heroSkinBonusLevel=oldLevel+1
  message=("Герой: +%d%% ко всем монетам, включая кассу."):format(data.heroSkinBonusLevel)
  needsSave=true
 elseif action=="upgradeHeroDiamonds" then
  if category~="hero" then return end
  local hasSkin=false
  for id_,yes in pairs(owned) do
   local d=Config.ById[id_]
   if yes==true and d and d.category=="hero" then hasSkin=true;break end
  end
  if not hasSkin then Net.notify(player,"Сначала открой любой скин героя.","info");return end
  local oldLevel=Config.heroLevel(data)
  local cost=Config.heroUpgradeDiamonds(oldLevel)
  if not cost then Net.notify(player,"Скин героя уже +10% (MAX).","info");return end
  if not charge("diamonds",cost) then return end
  data.heroSkinBonusLevel=oldLevel+1
  message=("Герой: +%d%% ко всем монетам, включая кассу."):format(data.heroSkinBonusLevel)
  needsSave=true
 elseif action=="upgradePetCoins" or action=="upgradePetDiamonds" then
  if category~="pet" or data.petUnlocked~=true then
   Net.notify(player,"Сначала открой питомца.","info");return
  end
  local oldLevel=Config.petLevel(data)
  local method=action=="upgradePetCoins" and "coins" or "diamonds"
  local cost=method=="coins" and Config.petUpgradeCoins(oldLevel) or Config.petUpgradeDiamonds(oldLevel)
  if not cost then Net.notify(player,"Питомец уже +50% (MAX).","info");return end
  if not charge(method,cost) then return end
  data.petBonusLevel=oldLevel+1
  message=("Питомец: +%d%% ко всем монетам и кассе. Облики бесплатны."):format(data.petBonusLevel)
  needsSave=true
 elseif action=="buy" or action=="buyCoins" or action=="buyDiamonds" then
  if not def or category=="pet" then return end
  if owned[id]==true then Net.notify(player,"Уже куплено, нажми «НАДЕТЬ».","info");return end
  local method=action=="buyCoins" and "coins" or "diamonds"
  local cost
  if method=="coins" then cost=def.priceCoins else cost=def.price end
  if not cost then Net.notify(player,"Эта вещь доступна только за алмазы.","info");return end
  if not charge(method,cost) then return end
  owned[id]=true
  if category=="hero" or category=="aura" then equip[category]=id end
  message=("Куплено: %s · %d %s. %s"):format(def.name,cost,method=="coins" and "$" or "💎",
   (category=="paint" or category=="skin") and "Выбери машину и нажми ПРИМЕНИТЬ." or "Надето!")
  needsSave=true
 else return end

 if not needsSave then return end
 purchasing[player]=true
 local success=(not Data.canSave(player)) or Data.saveNow(player)
 if not success then
  data.money=old.money
  data.diamonds=old.diamonds
  data.petUnlocked=old.petUnlocked
  data.heroSkinBonusLevel=old.heroSkinBonusLevel
  data.petBonusLevel=old.petBonusLevel
  data.cosmeticsOwned=old.owned
  data.cosmeticsEquipped=old.equipped
  data.carCosmetics=old.carCosmetics
  if typeof(targetCarId)=="string" then data.carCosmetics[targetCarId]=priorTargetSetting end
  Net.notify(player,(action=="unequip"and category=="hero")and"Не удалось сохранить возвращение аватара. Попробуй ещё раз."or"Покупка не сохранена, деньги возвращены. Попробуй снова.","bad")
 else
  refreshAppearance(player,category)
  if not(action=="unequip"and category=="hero")then Net.notify(player,message,"good")end
 end
 purchasing[player]=nil
 if Net.CurrencyUpdate and player.Parent then Net.CurrencyUpdate:FireClient(player,data.diamonds) end
 if Net.CosmeticUpdate and player.Parent then Net.CosmeticUpdate:FireClient(player) end
end
function M.init()
 Wardrobe.onApplied=function(player)applyAura(player)end
 Wardrobe.init()
 Net.CosmeticAction.OnServerEvent:Connect(onAction)
 local function onPlayer(player)
  Data.onLoaded(player,function()
   if not player.Parent then return end
   sanitized(Data.get(player))
   refreshPet(player)
   if player.Character then
    task.defer(applyAura,player)
    task.defer(applyHero,player)
   end
   player.CharacterAdded:Connect(function()
    task.wait(.65)
    if player.Parent then applyAura(player);applyHero(player) end
   end)
   player.CharacterAppearanceLoaded:Connect(function(character)
    task.spawn(function()
     while purchasing[player]and player.Parent and player.Character==character do task.wait(.1)end
     if player.Parent and player.Character==character then applyHero(player)end
    end)
   end)
  end)
 end
 Players.PlayerAdded:Connect(onPlayer)
 for _,player in ipairs(Players:GetPlayers()) do onPlayer(player) end
 Players.PlayerRemoving:Connect(function(player)
  Wardrobe.remove(player)
  if activePets[player] then activePets[player]:Destroy();activePets[player]=nil end
  cooldown[player]=nil
  purchasing[player]=nil
 end)
 -- V46: no server Heartbeat pet motion / no car WeldConstraint.
 -- Server network replication of 22Hz anchored PivotTo caused visible stepping.
 -- The cosmetics LocalScript handles follow, ground, rotation and mounting per frame.
 task.spawn(function()
  while true do
   task.wait(1.1)
   applyCars()
  end
 end)
end
return M
</ProtectedString>
