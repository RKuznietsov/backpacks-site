 {id="pet_phoenix",category="pet",name="Солнечная птица",description="Крылья из объёмных перьев и три длинных хвостовых пера",price=0,color=C(245, 126, 62),movement="fly"},
 {id="pet_ufo",category="pet",name="НЛО-компаньон",description="Летающая тарелка с маленьким инопланетным пилотом",price=0,color=C(112, 228, 202),movement="fly"},
 {id="pet_cat",category="pet",name="Лунный котёнок",description="Хвост-полумесяц, большие мятные глаза и лавандовая шёрстка",price=0,color=C(149, 131, 232),movement="ground"},
 {id="pet_dog",category="pet",name="Пёс-авиатор",description="Мягкие висячие уши, очки авиатора и радостный хвост",price=0,color=C(201, 171, 108),movement="ground"},
 {id="pet_turtle",category="pet",name="Черепашка",description="Низкий сегментированный панцирь, короткие лапы и небольшая мордочка",price=0,color=C(110, 195, 127),movement="ground"},
 {id="aura_mint",category="aura",name="Изумрудный след",description="Зелёный шлейф и светлячки остаются позади при движении",price=85,color=C(88,244,181)},
 {id="aura_plasma",category="aura",name="Плазменный шлейф",description="Голубые и фиолетовые ленты тянутся за персонажем",price=160,color=C(69,216,255)},
 {id="aura_crimson",category="aura",name="Огненный след",description="Тёплые огненные ленты и затухающие искры позади",price=235,color=C(255,107,86)},
 {id="aura_gold",category="aura",name="Золотой след",description="Золотой шлейф с искрами, которые остаются в воздухе",price=410,color=C(255,220,98)},
}
-- A pet is unlocked ONCE by a license, then ALL registered pet looks are free.
-- Old pet purchases migrate to that license in CosmeticService.
-- Six real catalog-based looks. Existing IDs remain aliases; retired duplicates are not sold.
M.CatalogLooks={
 mechanic={id='mechanic',canonical='hero_premium_mech',name='AQUA PILOT',hat=1365767,face=138940480674278,jacket=71576448094265,color=C(51,163,201),pantsColor=C(25,47,72),description='Крылатый шлем Valkyrie, голубая куртка и тёмный низ.'},
 dealer={id='dealer',canonical='hero_premium_archon',name='ЗОЛОТОЙ МАГНАТ',hat=1285307,face=11748356,jacket=71576448094265,color=C(242,183,66),pantsColor=C(40,32,56),description='Sparkle Time Fedora, очки Clockwork и контрастный городской костюм.'},
 workshop={id='workshop',canonical='hero_premium_phoenix',name='DJ МАНГО',hair=89315454377282,hat=1235488,jacket=17638739844,color=C(255,152,74),pantsColor=C(42,33,66),description='Наушники Clockwork, объёмная причёска и яркая красная куртка.'},
 stylist={id='stylist',canonical='hero_premium_seraph',name='ЛУННЫЙ СТРАЖ',hat=21070012,jacket=71576448094265,color=C(184,209,242),pantsColor=C(40,52,79),description='Каталожный капюшон Dominus Empyreus и холодная сине-белая палитра.'},
 hacker={id='hacker',canonical='hero_urban',name='NEON RUNNER',hair=10376943185,face=138940480674278,jacket=96961653426478,color=C(52,187,160),pantsColor=C(22,40,51),description='Техно-маска, чёрные волосы и тактический жилет с мятным акцентом.'},
 racer={id='racer',canonical='hero_premium_ronin',name='АЛЫЙ РЕЙСЕР',hair=8022080793,face=4258680288,jacket=17638739844,color=C(223,70,94),pantsColor=C(33,34,48),description='Красный techwear, тёмная причёска и гоночные очки.'},
}
M.CatalogOrder={'mechanic','dealer','workshop','stylist','hacker','racer'}
local canonical={}
for key,preset in pairs(M.CatalogLooks)do canonical[preset.canonical]=key end
local family={phantom='hacker',stealth='hacker',plasma='hacker',cyber='hacker',ronin='racer',sport='racer',drift='racer',street='racer',astral='dealer',royal='dealer',solar='dealer',frost='stylist',pilot='workshop',sentinel='mechanic',specter='stylist'}
for _,def in ipairs(M.List)do
 if def.category=='hero'then
  def.catalogLook=canonical[def.id]or family[def.silhouette or def.style]or'hacker'
  def.hiddenFromShop=canonical[def.id]==nil
  def.premiumDesign=nil
  def.priceCoins=nil;def.currency='diamonds'
  if not def.hiddenFromShop then
   def.name=M.CatalogLooks[def.catalogLook].name
   def.description=M.CatalogLooks[def.catalogLook].description
  end
 end
end
function M.heroLookId(id)
 local def=id and M.ById and M.ById[id]
 return def and def.catalogLook
end
function M.migrateHeroOwnership(owned)
 local grants={}
 for id,yes in pairs(owned)do
  local def=M.ById[id]
  if yes==true and def and def.category=='hero'and def.catalogLook then
   grants[M.CatalogLooks[def.catalogLook].canonical]=true
  end
 end
 for id in pairs(grants)do owned[id]=true end
end
M.ById={}
for _,v in ipairs(M.List) do
 assert(not M.ById[v.id],"Duplicate cosmetic id "..v.id)
 M.ById[v.id]=v
end
function M.heroLevel(data)
 return math.clamp(math.floor(tonumber(data and data.heroSkinBonusLevel) or 0),0,M.HERO_MAX)
end
function M.petLevel(data)
 return math.clamp(math.floor(tonumber(data and data.petBonusLevel) or 0),0,M.PET_MAX)
end
function M.coinBonusPct(data)
 if type(data)~="table" then return 0,0,0 end
 local equip=type(data.cosmeticsEquipped)=="table" and data.cosmeticsEquipped or {}
 local owned=type(data.cosmeticsOwned)=="table" and data.cosmeticsOwned or {}
 local heroId=equip.hero
 local hero=heroId and M.ById[heroId]
 local heroPct=(hero and hero.category=="hero" and owned[heroId]==true) and M.heroLevel(data) or 0
 local petId=equip.pet
 local pet=petId and M.ById[petId]
 local petPct=(pet and pet.category=="pet" and data.petUnlocked==true) and M.petLevel(data) or 0
 return heroPct+petPct, heroPct, petPct
end
-- Backwards compatible alias for v38 heist module.
M.heistBonusPct=M.coinBonusPct
return M
</ProtectedString>
          </Properties>
        </Item>
        </Item>
      <Item class="ModuleScript" referent="RBX_STEAL60_AVATARSTYLES_V40">
          <Properties>
            <string name="Name">AvatarStyleLibrary</string>
            <ProtectedString name="Source">-- Player outfits use WardrobeService and real catalog descriptions.
-- This legacy geometry library is retained only for garage NPC signatures/fallbacks.
-- Steal60 / AvatarStyleLibrary v41. Original in-experience avatar costumes.
-- No third-party clothing textures, copied accessories or Marketplace asset IDs.
-- Family silhouettes are reusable for character, NPC and 3D store preview.
local M = {}
function M.hasOpenFace(def)
 return def and(def.premiumDesign=='seraph'or def.premiumDesign=='archon')or false
end
function M.keepsAvatarHair(def)
 return def and def.premiumDesign=='seraph'or false
end
local C = Color3.fromRGB
local DARK = C(14, 22, 35)
local SOFT = C(211, 228, 237)
local function lerp(a,b,alpha) return a:Lerp(b,alpha) end
local function part(container, parent, name, size, cframe, color, material, shape, kind)
    if not parent or not parent:IsA('BasePart') then return nil end
    local p = Instance.new(kind or 'Part')
    p.Name = name
    p.Size = size
    p.CFrame = parent.CFrame * cframe
    p.Color = color
    p.Material = material or Enum.Material.SmoothPlastic
    if shape and kind ~= 'WedgePart' then p.Shape = shape end
    p.Transparency = 0
    p.Reflectance = 0.03
    p.Anchored = parent.Anchored
    p.Massless = true
    p.CanCollide = false
    p.CanTouch = false
    p.CanQuery = false
    p.CastShadow = false
    p.Parent = container
    if not parent.Anchored then
        local weld = Instance.new('WeldConstraint')
        weld.Part0 = parent
        weld.Part1 = p
        weld.Parent = p
    end
    return p
end

-- V51 atelier: shaped armour, proper 3D rings, tailored layers and distinct silhouettes.
local function premiumDress(rig,def,opts)
 local torso=rig:FindFirstChild('UpperTorso')or rig:FindFirstChild('Torso')
 local head=rig:FindFirstChild('Head');if not torso or not head then return end
 local old=rig:FindFirstChild('Steal60HeroSkin');if old then old:Destroy()end
 local g=Instance.new('Folder');g.Name='Steal60HeroSkin';g.Parent=rig
 local d=def.premiumDesign
 local themes={
  archon={C(65,43,111),C(174,116,255),C(245,199,105)},
  ronin={C(216,76,123),C(100,236,226),C(255,222,169)},
  seraph={C(220,235,246),C(103,205,255),C(241,195,103)},
  mech={C(62,151,170),C(88,250,219),C(214,234,237)},
  phoenix={C(217,96,54),C(255,187,65),C(255,235,190)},
 }
 local theme=themes[d]or themes.seraph
 local primary,accent,trim=theme[1],theme[2],theme[3]
 local ink=C(23,31,52);local pearl=C(239,240,225);local dark=primary:Lerp(ink,.55)
 local tw,th,tz=torso.Size.X,torso.Size.Y,torso.Size.Z
 local hw,hh,hz=head.Size.X,head.Size.Y,head.Size.Z
 local function P(parent,n,sz,cf,c,mat,shape,kind)
  return part(g,parent,n,sz,cf,c,mat or Enum.Material.SmoothPlastic,shape,kind)
 end
 local function T(n,sz,cf,c,mat,shape,kind)return P(torso,n,sz,cf,c,mat,shape,kind)end
 local function H(n,sz,cf,c,mat,shape,kind)return P(head,n,sz,cf,c,mat,shape,kind)end
 local function O(parent,n,sz,cf,c,mat)return P(parent,n,sz,cf,c,mat,Enum.PartType.Ball)end
 local function tube(parent,n,a,b,width,c,mat)
  local length=(b-a).Magnitude
  local up=math.abs((b-a).Unit:Dot(Vector3.yAxis))&gt;.98 and Vector3.zAxis or Vector3.yAxis
  return P(parent,n,Vector3.new(length,width,width),CFrame.lookAt((a+b)/2,b,up)*CFrame.Angles(0,math.pi/2,0),c,mat or Enum.Material.Metal,Enum.PartType.Cylinder)
 end
 local function ring(parent,n,center,rx,ry,rot,c,width)
  for i=0,19 do
   local a=i*math.pi/10;local b=(i+1)*math.pi/10
   local from=center+rot*Vector3.new(math.cos(a)*rx,math.sin(a)*ry,0)
   local to=center+rot*Vector3.new(math.cos(b)*rx,math.sin(b)*ry,0)
   tube(parent,n,from,to,width,c)
  end
 end
 -- Rounded overlapping plates follow the body instead of a rectangular box.
 O(torso,'TailoredBack',Vector3.new(tw*1.04,th*.99,tz*1.12),CFrame.new(0,-th*.025,.02),dark,Enum.Material.Fabric)
 O(torso,'SculptedCuirass',Vector3.new(tw*.94,th*.66,.23),CFrame.new(0,th*.05,-tz*.61),primary,Enum.Material.Metal)
 local hips=rig:FindFirstChild('LowerTorso')
 if hips then O(hips,'TailoredHips',Vector3.new(hips.Size.X*1.04,hips.Size.Y*1.02,hips.Size.Z*1.07),CFrame.new(),dark,Enum.Material.Fabric)end
 for _,s in ipairs({-1,1})do
  T('LowerTaper',Vector3.new(tw*.48,th*.38,.20),CFrame.new(s*tw*.23,-th*.35,-tz*.55)*CFrame.Angles(0,0,-s*.12),dark,Enum.Material.Metal,nil,'WedgePart')
  tube(torso,'GoldLapel',Vector3.new(s*tw*.43,th*.34,-tz*.63),Vector3.new(s*tw*.11,-th*.08,-tz*.79),.065,trim)
  local side=s&lt;0 and 'Left'or 'Right'
  local upperArm=rig:FindFirstChild(side..'UpperArm')or rig:FindFirstChild(side..' Arm')
  local lowerArm=rig:FindFirstChild(side..'LowerArm')or upperArm
  local upperLeg=rig:FindFirstChild(side..'UpperLeg')or rig:FindFirstChild(side..' Leg')
  local lowerLeg=rig:FindFirstChild(side..'LowerLeg')or upperLeg
  if upperArm then
   O(upperArm,'FittedSleeve',Vector3.new(upperArm.Size.X*1.12,upperArm.Size.Y*.91,upperArm.Size.Z*1.12),CFrame.new(),dark,Enum.Material.Fabric)
   if d=='mech'then
  O(upperArm,'FloatingPauldron',Vector3.new(upperArm.Size.X*1.43,upperArm.Size.Y*.55,upperArm.Size.Z*1.31),CFrame.new(s*.05,upperArm.Size.Y*.27,0)*CFrame.Angles(0,0,s*.18),primary,Enum.Material.Metal)
  elseif d=='ronin'then
   for layer=0,2 do
    P(upperArm,'KabutoShoulderLamella',Vector3.new(upperArm.Size.X*1.24,.13,upperArm.Size.Z*1.32),CFrame.new(s*layer*.035,upperArm.Size.Y*.39-layer*.12,0),layer%2==0 and primary or dark,Enum.Material.Metal)
   end
  else
   O(upperArm,'DrapedShoulder',Vector3.new(upperArm.Size.X*1.26,upperArm.Size.Y*.34,upperArm.Size.Z*1.22),CFrame.new(s*.02,upperArm.Size.Y*.31,0),primary,Enum.Material.Fabric)
  end
   P(upperArm,'PauldronInlay',Vector3.new(.065,upperArm.Size.Y*.29,upperArm.Size.Z*.76),CFrame.new(s*upperArm.Size.X*.65,upperArm.Size.Y*.26,0),trim,Enum.Material.Metal)
  end
  if lowerArm then
   O(lowerArm,'FittedForearm',Vector3.new(lowerArm.Size.X*1.05,lowerArm.Size.Y*.99,lowerArm.Size.Z*1.05),CFrame.new(),dark,Enum.Material.Fabric)
   O(lowerArm,'ForearmGauntlet',Vector3.new(lowerArm.Size.X*1.17,lowerArm.Size.Y*.67,lowerArm.Size.Z*1.20),CFrame.new(0,-lowerArm.Size.Y*.13,-.015),pearl,Enum.Material.Metal)
   if d=='mech'then
    P(lowerArm,'WristScreen',Vector3.new(lowerArm.Size.X*.63,.14,.065),CFrame.new(0,-lowerArm.Size.Y*.15,-lowerArm.Size.Z*.67),accent,Enum.Material.Neon)
   end
   for i=1,3 do P(lowerArm,'GloveEtching',Vector3.new(lowerArm.Size.X*.64,.026,.04),CFrame.new(0,-lowerArm.Size.Y*(.18+i*.06),-lowerArm.Size.Z*.68),trim)end
  end
  if upperLeg then
   O(upperLeg,'TaperedTrousers',Vector3.new(upperLeg.Size.X*1.07,upperLeg.Size.Y*.94,upperLeg.Size.Z*1.08),CFrame.new(),dark,Enum.Material.Fabric)
   P(upperLeg,'TrouserPiping',Vector3.new(.045,upperLeg.Size.Y*.72,.065),CFrame.new(s*upperLeg.Size.X*.52,0,-upperLeg.Size.Z*.35),trim)
  end
  if lowerLeg then
   O(lowerLeg,'SculptedGreave',Vector3.new(lowerLeg.Size.X*1.12,lowerLeg.Size.Y*.84,lowerLeg.Size.Z*1.15),CFrame.new(0,-lowerLeg.Size.Y*.1,0),primary,Enum.Material.Metal)
   O(lowerLeg,'BootToe',Vector3.new(lowerLeg.Size.X*1.16,lowerLeg.Size.Y*.35,lowerLeg.Size.Z*1.55),CFrame.new(0,-lowerLeg.Size.Y*.45,-lowerLeg.Size.Z*.15),pearl)
   P(lowerLeg,'SoleTrim',Vector3.new(lowerLeg.Size.X*1.14,.09,lowerLeg.Size.Z*1.48),CFrame.new(0,-lowerLeg.Size.Y*.61,-lowerLeg.Size.Z*.13),trim)
   if d=='mech'then P(lowerLeg,'GreaveVent',Vector3.new(lowerLeg.Size.X*.55,.14,.055),CFrame.new(0,-lowerLeg.Size.Y*.13,-lowerLeg.Size.Z*.61),accent,Enum.Material.Neon)end
  end
 end
 -- Each archetype has its own face treatment; only the pilot is an OLED robot.
 if d=='mech'then
 O(head,'SculptedHelmet',Vector3.new(hw*1.14,hh*1.09,hz*1.12),CFrame.new(0,.015,.04),primary,Enum.Material.Metal)
 O(head,'DeepVisor',Vector3.new(hw*.99,hh*.49,.30),CFrame.new(0,hh*.045,-hz*.52),ink)
 for _,s in ipairs({-1,1})do
  O(head,'LuminousEye',Vector3.new(hw*.22,hh*.08,.055),CFrame.new(s*hw*.24,hh*.07,-hz*.70)*CFrame.Angles(0,0,-s*.13),accent,Enum.Material.Neon)
  O(head,'TempleHinge',Vector3.new(.17,hh*.27,hz*.32),CFrame.new(s*hw*.55,.01,0),trim,Enum.Material.Metal)
  tube(head,'HelmetBrow',Vector3.new(s*hw*.46,hh*.28,-hz*.47),Vector3.new(s*hw*.10,hh*.31,-hz*.59),.06,trim)
 end
 O(head,'ChinGuard',Vector3.new(hw*.65,hh*.20,.22),CFrame.new(0,-hh*.35,-hz*.47),pearl,Enum.Material.Metal)
 ring(torso,'NeckSeal',Vector3.new(0,th*.46,0),tw*.34,tz*.59,CFrame.Angles(math.pi/2,0,0),trim,.07)
 O(torso,'ReactorHousing',Vector3.new(.44,.49,.19),CFrame.new(0,th*.04,-tz*.82),trim,Enum.Material.Metal)
 O(torso,'ReactorCabochon',Vector3.new(.29,.33,.17),CFrame.new(0,th*.04,-tz*.92),accent,Enum.Material.Glass)
 O(torso,'ReactorGlint',Vector3.new(.055,.12,.025),CFrame.new(-.06,th*.12,-tz*1.03),pearl)
 elseif d=='ronin'then
  O(head,'KabutoUnderShell',Vector3.new(hw*1.13,hh*1.05,hz*1.12),CFrame.new(0,.02,.04),dark,Enum.Material.Metal)
  O(head,'OniLowerMask',Vector3.new(hw*.93,hh*.51,.22),CFrame.new(0,-hh*.20,-hz*.53),primary,Enum.Material.Metal)
  for _,side in ipairs({-1,1})do
   H('OniEyeSlit',Vector3.new(hw*.28,.09,.055),CFrame.new(side*hw*.25,hh*.14,-hz*.58)*CFrame.Angles(0,0,-side*.18),pearl)
   H('OniIvoryFang',Vector3.new(.08,hh*.27,.11),CFrame.new(side*hw*.23,-hh*.26,-hz*.69)*CFrame.Angles(0,0,side*.16),pearl,nil,nil,'WedgePart')
   tube(head,'OniSculptedBrow',Vector3.new(side*hw*.45,hh*.31,-hz*.43),Vector3.new(side*hw*.12,hh*.24,-hz*.61),.09,trim)
  end
  for i=0,3 do
   O(torso,'LacquerChestLamella',Vector3.new(tw*.86,.16,.17),CFrame.new(0,th*(.28-i*.16),-tz*.72),i%2==0 and primary or dark,Enum.Material.Metal)
  end
 elseif d=='phoenix'then
  O(head,'PhoenixCowl',Vector3.new(hw*1.16,hh*1.12,hz*1.13),CFrame.new(0,.02,.03),primary,Enum.Material.Metal)
  for _,side in ipairs({-1,1})do
   O(head,'BirdEyeSurround',Vector3.new(hw*.41,hh*.40,.18),CFrame.new(side*hw*.26,hh*.10,-hz*.52),trim)
   O(head,'BirdEye',Vector3.new(hw*.18,hh*.22,.08),CFrame.new(side*hw*.26,hh*.12,-hz*.64),ink)
   O(head,'BirdEyeGlint',Vector3.new(.04,.065,.025),CFrame.new(side*hw*.26-.03,hh*.17,-hz*.70),pearl)
   H('CheekFeather',Vector3.new(.16,hh*.42,.20),CFrame.new(side*hw*.48,-hh*.15,-hz*.39)*CFrame.Angles(0,0,-side*.27),trim,nil,nil,'WedgePart')
  end
  H('SculptedPhoenixBeak',Vector3.new(hw*.31,hh*.28,hz*.54),CFrame.new(0,-hh*.12,-hz*.65),trim,Enum.Material.Metal,nil,'WedgePart')
  for i=-1,1 do
   O(torso,'BreastFlameFeather',Vector3.new(.16,th*.55,.11),CFrame.new(i*.19,0,-tz*.79)*CFrame.Angles(0,0,-i*.17),trim,Enum.Material.Metal)
  end
 elseif d=='seraph'then
  -- The owner's own face and hair stay visible beneath an open circlet.
  for _,side in ipairs({-1,1})do
   tube(head,'OpenCirclet',Vector3.new(side*hw*.45,hh*.33,-hz*.35),Vector3.new(side*hw*.08,hh*.35,-hz*.54),.06,trim)
   O(head,'PearlEarPendant',Vector3.new(.10,.23,.10),CFrame.new(side*hw*.52,-hh*.24,0),trim)
   T('IvoryCoatTail',Vector3.new(tw*.46,th*1.42,.14),CFrame.new(side*tw*.30,-th*.69,tz*.55)*CFrame.Angles(0,0,side*.10),pearl,Enum.Material.Fabric,nil,'WedgePart')
   tube(torso,'WingedChestFiligree',Vector3.new(0,th*.02,-tz*.83),Vector3.new(side*tw*.36,th*.24,-tz*.73),.055,trim)
  end
  O(torso,'SapphirePendant',Vector3.new(.17,.27,.10),CFrame.new(0,-th*.02,-tz*.85),accent,Enum.Material.Glass)
 elseif d=='archon'then
  H('WizardBrim',Vector3.new(.11,hw*1.88,hz*1.65),CFrame.new(0,hh*.54,0)*CFrame.Angles(0,0,math.pi/2),primary,Enum.Material.Fabric,Enum.PartType.Cylinder)
  for i=0,10 do
   local diameter=hw*(1.06-i*.085)
   H('CurvedHatCrown',Vector3.new(.13,diameter,diameter),CFrame.new(i*.027,hh*(.67+i*.13),.03)*CFrame.Angles(0,0,math.pi/2),primary,Enum.Material.Fabric,Enum.PartType.Cylinder)
  end
  O(head,'HatStar',Vector3.new(.16,.21,.12),CFrame.new(.28,hh*2.05,.03),trim)
  for _,side in ipairs({-1,1})do
   T('LongMageRobe',Vector3.new(tw*.51,th*1.73,.19),CFrame.new(side*tw*.26,-th*.94,-tz*.42)*CFrame.Angles(0,0,side*.07),primary,Enum.Material.Fabric)
   T('RobeGoldHem',Vector3.new(tw*.51,.075,.21),CFrame.new(side*tw*.26,-th*1.78,-tz*.42)*CFrame.Angles(0,0,side*.07),trim)
  end
  local hand=rig:FindFirstChild('RightHand')or rig:FindFirstChild('Right Arm')
  if hand then
   tube(hand,'ArcaneStaff',Vector3.new(.27,-1.37,0),Vector3.new(.27,1.12,0),.10,dark)
   O(hand,'StaffCrystal',Vector3.new(.39,.57,.37),CFrame.new(.27,1.24,0),accent,Enum.Material.Glass)
   ring(hand,'StaffSetting',Vector3.new(.27,1.24,0),.25,.37,CFrame.new(),trim,.035)
  end
  O(torso,'ArcaneAmulet',Vector3.new(.23,.33,.13),CFrame.new(0,th*.04,-tz*.80),accent,Enum.Material.Glass)
 end
 -- Different silhouettes, not the same body recoloured five times.
 if d=='seraph'or d=='phoenix'then
  for _,s in ipairs({-1,1})do
   for layer=0,1 do for i=0,6 do
    local x=s*(tw*.54+i*.22+layer*.13)
    local y=th*(.47-i*.14)+layer*.14
    O(torso,'SculptedFlightFeather',Vector3.new(.29,th*(1.05-i*.075),.20),CFrame.new(x,y,tz*(.72+layer*.18))*CFrame.Angles(0,0,-s*(.38+i*.105)),layer==0 and pearl or(d=='seraph'and accent or trim),Enum.Material.Metal)
   end end
   for i=0,3 do
    O(torso,'WingShoulderFeather',Vector3.new(.32,.48,.22),CFrame.new(s*(tw*.54+i*.18),th*(.49-i*.06),tz*.58)*CFrame.Angles(0,0,-s*.66),primary,Enum.Material.Metal)
   end
  end
  if d=='seraph'then
   ring(head,'CelestialHalo',Vector3.new(0,hh*.73,hz*.30),hw*.86,hh*.67,CFrame.new(),trim,.06)
   for i=0,4 do local a=i*math.pi/2.5
    O(head,'HaloStar',Vector3.new(.11,.15,.10),CFrame.new(math.cos(a)*hw*.86,hh*.73+math.sin(a)*hh*.67,hz*.28),accent,Enum.Material.Neon)
   end
  else
   for i=-2,2 do
    O(head,'FlameDiadem',Vector3.new(.15,hh*(.48-math.abs(i)*.055),.18),CFrame.new(i*.20,hh*(.70-math.abs(i)*.04),-.03)*CFrame.Angles(0,0,-i*.18),i%2==0 and trim or accent)
   end
  end
 elseif d=='ronin'then
  O(head,'KabutoCrown',Vector3.new(hw*1.32,hh*.29,hz*1.28),CFrame.new(0,hh*.48,.03),dark,Enum.Material.Metal)
  for _,s in ipairs({-1,1})do
   for i=0,3 do
    O(head,'SweptKabutoHorn',Vector3.new(.18-i*.02,.29,.19),CFrame.new(s*(hw*.37+i*.105),hh*(.60+i*.14),-.03)*CFrame.Angles(0,0,-s*(.18+i*.2)),trim,Enum.Material.Metal)
    T('LacquerWaistPlate',Vector3.new(tw*.39,.14,.15),CFrame.new(s*tw*.29,-th*(.35+i*.11),-tz*.56)*CFrame.Angles(0,0,s*.09),i%2==0 and primary or dark,Enum.Material.Metal)
   end
   local a=Vector3.new(s*tw*.47,th*.90,tz*.88);local b=Vector3.new(-s*tw*.33,-th*.78,tz*.88)
   tube(torso,'CrossedScabbard',a,b,.16,dark)
   tube(torso,'KatanaGrip',a,a+(a-b).Unit*.49,.19,trim)
   O(torso,'SashKnot',Vector3.new(.30,.26,.20),CFrame.new(s*.11,-th*.43,-tz*.83),accent)
   T('SplitCoatTail',Vector3.new(tw*.49,th*1.2,.13),CFrame.new(s*tw*.35,-th*.62,tz*.66)*CFrame.Angles(0,0,s*.11),primary,Enum.Material.Fabric,nil,'WedgePart')
  end
 elseif d=='archon'then
  for _,s in ipairs({-1,1})do
   for i=0,3 do
    O(torso,'VelvetMantleFold',Vector3.new(tw*.36,th*(1.48-i*.11),.22),CFrame.new(s*(tw*.26+i*.15),-th*(.35+i*.03),tz*(.71+i*.07))*CFrame.Angles(0,0,-s*.07),i%2==0 and dark or primary,Enum.Material.Fabric)
   end
   tube(torso,'RoyalShoulderChain',Vector3.new(s*tw*.48,th*.39,-tz*.59),Vector3.new(s*tw*.28,th*.12,-tz*.77),.045,trim)
  end
  ring(torso,'VoidBackCrest',Vector3.new(0,th*.10,tz*.87),tw*.65,th*.64,CFrame.new(),trim,.045)
 elseif d=='mech'then
  for _,s in ipairs({-1,1})do
   O(torso,'TurbineShell',Vector3.new(.53,.88,.59),CFrame.new(s*tw*.43,-.06,tz*.81),pearl,Enum.Material.Metal)
   ring(torso,'TurbineNozzle',Vector3.new(s*tw*.43,-.09,tz*1.24),.21,.31,CFrame.new(),trim,.06)
   O(torso,'TurbineCore',Vector3.new(.25,.39,.10),CFrame.new(s*tw*.43,-.09,tz*1.27),accent,Enum.Material.Neon)
   T('SweptFlightFin',Vector3.new(.12,.59,.68),CFrame.new(s*tw*.78,th*.20,tz*.72)*CFrame.Angles(0,0,-s*.55),primary,Enum.Material.Metal,nil,'WedgePart')
   O(head,'FlightEarCup',Vector3.new(.24,hh*.43,hz*.50),CFrame.new(s*hw*.59,.02,.04),pearl,Enum.Material.Metal)
  end
  T('FlightSpine',Vector3.new(.14,th*.71,.14),CFrame.new(0,-th*.09,tz*.79),trim,Enum.Material.Metal)
 end
 return g
end

local function dress(rig, def, opts)
    opts = opts or {}
    if def.premiumDesign and not opts.npc then return premiumDress(rig,def,opts) end
    local torso = rig:FindFirstChild('UpperTorso') or rig:FindFirstChild('Torso')
    local head = rig:FindFirstChild('Head')
    if not torso or not head then return end
    local previous = rig:FindFirstChild('Steal60HeroSkin')
    if previous then previous:Destroy() end
    local group = Instance.new('Folder')
    group.Name = 'Steal60HeroSkin'
    group.Parent = rig
    local primary = def.color or C(50,110,180)
    local accent = def.accent or C(90,230,220)
    local trim = lerp(primary, DARK, .5)
    local metal = lerp(primary, SOFT, .24)
    local silhouette = def.silhouette or def.style or 'street'
    local tier = math.clamp(tonumber(def.tier) or 2, 1, 5)
    local featureCount = opts.npc and math.min(tier, 3) or tier
    local tw, th, tz = torso.Size.X, torso.Size.Y, torso.Size.Z
    local hw, hh, hz = head.Size.X, head.Size.Y, head.Size.Z
    local front = -tz / 2 - .13
    local hfront = -hz / 2 - .11
    local function T(name,size,cf,color,mat,shape,kind) return part(group,torso,name,size,cf,color,mat,shape,kind) end
    local function H(name,size,cf,color,mat,shape,kind) return part(group,head,name,size,cf,color,mat,shape,kind) end
    -- Uniform silhouette: shaped jacket and metallic trim, no giant cube armor.
    T('Tailored_jacket',Vector3.new(tw*.93,th*.72,.19),CFrame.new(0,-th*.055,front),primary)
    T('Underlayer',Vector3.new(tw*.48,th*.58,.07),CFrame.new(0,-th*.08,front-.14),trim,Enum.Material.Fabric)
    T('Waist_buckle',Vector3.new(tw*.88,.115,.16),CFrame.new(0,-th*.42,front),metal,Enum.Material.Metal)
    for _,side in ipairs({-1,1}) do
        T('Shoulder_carapace',Vector3.new(.37,.20,tz*.81),CFrame.new(side*tw*.51,th*.32,0)*CFrame.Angles(0,0,side*.11),primary,Enum.Material.Metal)
        T('Sleeve_trim',Vector3.new(.15,.16,tz*.85),CFrame.new(side*tw*.53,th*.17,-.02),accent,Enum.Material.Neon)
        T('Jacket_zip',Vector3.new(.085,th*.59,.10),CFrame.new(side*tw*.16,-.065,front-.11),metal,Enum.Material.Metal)
    end
    -- Give garments a coherent look in the absence of third-party clothing textures.
    if silhouette == 'phantom' or silhouette == 'stealth' then
        H('Tech_hood',Vector3.new(hw*1.22,hh*.60,hz*1.22),CFrame.new(0,hh*.28,.07),trim,Enum.Material.Fabric,Enum.PartType.Ball)
        H('Opaque_mask',Vector3.new(hw*.89,hh*.38,.19),CFrame.new(0,-hh*.18,hfront),DARK,Enum.Material.Metal)
        H('Cyber_eye_strip',Vector3.new(hw*.8,.11,.11),CFrame.new(0,hh*.09,hfront-.13),accent,Enum.Material.Neon)
        T('Harness_left',Vector3.new(.17,th*.63,.13),CFrame.new(-tw*.28,.02,front-.10)*CFrame.Angles(0,0,-.17),metal)
        T('Harness_right',Vector3.new(.17,th*.63,.13),CFrame.new(tw*.28,.02,front-.10)*CFrame.Angles(0,0,.17),metal)
    elseif silhouette == 'ronin' or silhouette == 'sport' then
        H('Ronin_helmet',Vector3.new(hw*1.22,hh*.30,hz*1.2),CFrame.new(0,hh*.38,0),trim,Enum.Material.Metal,Enum.PartType.Ball)
        H('Ronin_visor',Vector3.new(hw*.97,.20,.23),CFrame.new(0,hh*.05,hfront),accent,Enum.Material.Neon)
        for _,side in ipairs({-1,1}) do
            H('Helmet_fins',Vector3.new(.17,hh*.58,.32),CFrame.new(side*hw*.57,hh*.29,-.04)*CFrame.Angles(0,0,side*.32),metal,Enum.Material.Metal)
            T('Cape_tabs',Vector3.new(.32,th*.61,.12),CFrame.new(side*tw*.40,-th*.19,tz*.53),primary,Enum.Material.Fabric)
        end
    elseif silhouette == 'astral' or silhouette == 'royal' then
        H('Crown_base',Vector3.new(hw*1.25,.23,hz*1.26),CFrame.new(0,hh*.43,0),metal,Enum.Material.Metal)
        for _,i in ipairs({-1,0,1}) do
            H('Crown_spires',Vector3.new(.19,hh*(i==0 and .53 or .34),.19),CFrame.new(i*hw*.32,hh*.68,.0),accent,Enum.Material.Neon,Enum.PartType.Ball)
        end
        T('Regal_crest',Vector3.new(.40,.52,.11),CFrame.new(0,th*.10,front-.15),accent,Enum.Material.Neon)
        T('Cape_panel',Vector3.new(tw*.94,th*.79,.13),CFrame.new(0,-th*.38,tz*.51)*CFrame.Angles(-.12,0,0),trim,Enum.Material.Fabric)
    elseif silhouette == 'frost' then
        H('Arctic_goggles',Vector3.new(hw*1.05,.26,.22),CFrame.new(0,.03,hfront),accent,Enum.Material.Glass)
        H('Winter_hood',Vector3.new(hw*1.20,hh*.45,hz*1.18),CFrame.new(0,hh*.28,.08),metal,Enum.Material.Fabric,Enum.PartType.Ball)
        T('Frost_scarf',Vector3.new(tw*.86,.27,tz*1.0),CFrame.new(0,th*.40,0),SOFT,Enum.Material.Fabric)
        for _,side in ipairs({-1,1}) do T('Ice_chest_flake',Vector3.new(.09,.42,.09),CFrame.new(side*.36,-.05,front-.16)*CFrame.Angles(0,0,side*.32),accent,Enum.Material.Neon) end
    elseif silhouette == 'plasma' or silhouette == 'cyber' then
        H('Plasma_headpiece',Vector3.new(hw*1.09,.29,hz*1.16),CFrame.new(0,hh*.40,0),trim,Enum.Material.Metal)
        H('One_piece_visor',Vector3.new(hw*.95,hh*.33,.21),CFrame.new(0,hh*.04,hfront),accent,Enum.Material.Neon)
        for _,side in ipairs({-1,1}) do
            H('Neon_antenna',Vector3.new(.095,hh*.52,.095),CFrame.new(side*hw*.5,hh*.69,-.03),accent,Enum.Material.Neon)
            T('Circuit_panel',Vector3.new(.18,th*.49,.08),CFrame.new(side*tw*.31,-.08,front-.15),accent,Enum.Material.Neon)
        end
        T('Reactor',Vector3.new(.43,.43,.20),CFrame.new(0,th*.08,front-.23),accent,Enum.Material.Neon,Enum.PartType.Ball)
    elseif silhouette == 'drift' or silhouette == 'street' then
        H('Drifter_cap',Vector3.new(hw*1.18,.19,hz*1.14),CFrame.new(0,hh*.51,0),primary,Enum.Material.Fabric)
        H('Cap_billow',Vector3.new(hw*.88,.11,.52),CFrame.new(0,hh*.49,hfront-.25),trim)
        H('Night_goggles',Vector3.new(hw*.91,.22,.20),CFrame.new(0,hh*.02,hfront),DARK,Enum.Material.Glass)
        T('Crossbody_bag_strap',Vector3.new(.19,th*.84,.12),CFrame.new(-tw*.14,.05,front-.12)*CFrame.Angles(0,0,-.32),accent)
        T('Badge',Vector3.new(.28,.30,.11),CFrame.new(tw*.25,-th*.11,front-.19),metal,Enum.Material.Metal)
    elseif silhouette == 'specter' then
        H('Specter_halfmask',Vector3.new(hw*.98,hh*.52,.18),CFrame.new(0,-hh*.16,hfront),trim,Enum.Material.Metal)
        H('Specter_eyes',Vector3.new(hw*.84,.10,.09),CFrame.new(0,hh*.12,hfront-.15),accent,Enum.Material.Neon)
        H('Specter_hair',Vector3.new(hw*1.2,.37,hz*1.18),CFrame.new(0,hh*.54,.08),primary,Enum.Material.Fabric,Enum.PartType.Ball)
        for _,side in ipairs({-1,1}) do
            T('Scarf_tail',Vector3.new(.31,th*.72,.12),CFrame.new(side*tw*.48,-th*.3,tz*.56)*CFrame.Angles(0,0,side*.2),trim,Enum.Material.Fabric)
        end
    elseif silhouette == 'pilot' then
        H('Pilot_helmet',Vector3.new(hw*1.19,hh*.61,hz*1.15),CFrame.new(0,hh*.27,.06),primary,Enum.Material.Metal,Enum.PartType.Ball)
        H('Reflective_visor',Vector3.new(hw*.96,.32,.19),CFrame.new(0,hh*.02,hfront),accent,Enum.Material.Glass)
        T('Pilot_harness',Vector3.new(tw*.65,.24,.16),CFrame.new(0,-th*.15,front-.13),metal,Enum.Material.Metal)
        T('Life_support',Vector3.new(tw*.47,th*.47,.31),CFrame.new(0,-th*.08,tz*.58),trim,Enum.Material.Metal)
    elseif silhouette == 'sentinel' then
        H('Guardian_helmet',Vector3.new(hw*1.20,hh*.49,hz*1.22),CFrame.new(0,hh*.37,0),primary,Enum.Material.Metal,Enum.PartType.Ball)
        H('Guardian_faceplate',Vector3.new(hw*.91,hh*.64,.17),CFrame.new(0,-hh*.08,hfront),metal,Enum.Material.Metal)
        H('Guardian_eye',Vector3.new(hw*.74,.09,.09),CFrame.new(0,hh*.10,hfront-.12),accent,Enum.Material.Neon)
        for _,side in ipairs({-1,1}) do
            T('Winged_shoulders',Vector3.new(.22,th*.41,.35),CFrame.new(side*tw*.61,th*.24,-.02)*CFrame.Angles(0,0,side*.12),trim,Enum.Material.Metal)
        end
    elseif silhouette == 'solar' then
        H('Sun_circlet',Vector3.new(hw*1.25,.16,hz*1.15),CFrame.new(0,hh*.54,0),metal,Enum.Material.Metal)
        for _,side in ipairs({-1,1}) do
            H('Solar_fins',Vector3.new(.12,hh*.68,.16),CFrame.new(side*hw*.56,hh*.34,0)*CFrame.Angles(0,0,side*.23),accent,Enum.Material.Neon)
        end
        H('Sun_visor',Vector3.new(hw*.96,.24,.17),CFrame.new(0,.08,hfront),DARK,Enum.Material.Glass)
        T('Solar_core',Vector3.new(.42,.43,.14),CFrame.new(0,.05,front-.20),accent,Enum.Material.Neon,Enum.PartType.Ball)
        T('Sun_cape',Vector3.new(tw*.75,th*.87,.11),CFrame.new(0,-th*.32,tz*.56),metal,Enum.Material.Fabric)
    end
    if featureCount &gt;= 3 then
        T('Future_pack',Vector3.new(tw*.56,th*.42,.34),CFrame.new(0,-th*.10,tz*.60),trim,Enum.Material.Metal)
        for _,side in ipairs({-1,1}) do
            T('Pack_energy_rails',Vector3.new(.11,th*.3,.10),CFrame.new(side*tw*.19,-th*.09,tz*.79),accent,Enum.Material.Neon)
        end
    end
    if featureCount &gt;= 4 then
        -- Tier upgrades add detail without copy-pasted huge mesh shapes.
        T('Rank_chevron',Vector3.new(tw*.18,.13,.10),CFrame.new(0,th*.25,front-.24),SOFT,Enum.Material.Neon)
        for _,side in ipairs({-1,1}) do
            H('Temple_beacon',Vector3.new(.11,.19,.13),CFrame.new(side*hw*.49,hh*.12,-.06),accent,Enum.Material.Neon)
        end
    end
    if featureCount &gt;= 5 then
        T('Legend_backplate',Vector3.new(tw*.75,th*.24,.15),CFrame.new(0,th*.24,tz*.67),metal,Enum.Material.Metal)
        T('Rank_gem',Vector3.new(.24,.26,.12),CFrame.new(0,th*.20,front-.25),accent,Enum.Material.Neon,Enum.PartType.Ball)
    end
    -- v41: complete outfit coverage instead of a few glowing blocks on the torso.
    -- Sleeves, gloves and boots remain welded to their own limbs while animating.
    local outfitDark=lerp(primary,DARK,.42)
    for _,side in ipairs({'Left','Right'}) do
        local isLeft=side=='Left'
        local armUpper=rig:FindFirstChild(side..'UpperArm') or rig:FindFirstChild(side..' Arm')
        local armLower=rig:FindFirstChild(side..'LowerArm') or armUpper
        if armUpper and armUpper:IsA('BasePart') then
            part(group,armUpper,side..'_Sleeve',
                Vector3.new(armUpper.Size.X*1.12,armUpper.Size.Y*.81,armUpper.Size.Z*1.12),
                CFrame.new(0,.03,0),outfitDark,Enum.Material.Fabric)
            part(group,armUpper,side..'_ArmPatch',
                Vector3.new(armUpper.Size.X*.67,armUpper.Size.Y*.45,.065),
                CFrame.new(0,0,-armUpper.Size.Z*.57),primary,Enum.Material.Metal)
        end
        if armLower and armLower:IsA('BasePart') then
            part(group,armLower,side..'_Glove',
                Vector3.new(armLower.Size.X*1.13,armLower.Size.Y*.27,armLower.Size.Z*1.13),
                CFrame.new(0,-armLower.Size.Y*.33,0),trim,Enum.Material.Metal)
        end
        local legUpper=rig:FindFirstChild(side..'UpperLeg') or rig:FindFirstChild(side..' Leg')
        local legLower=rig:FindFirstChild(side..'LowerLeg') or legUpper
        if legUpper and legUpper:IsA('BasePart') then
            part(group,legUpper,side..'_Trousers',
                Vector3.new(legUpper.Size.X*1.10,legUpper.Size.Y*.86,legUpper.Size.Z*1.10),
                CFrame.new(0,.02,0),outfitDark,Enum.Material.Fabric)
            part(group,legUpper,side..'_UtilityPocket',
                Vector3.new(.16,legUpper.Size.Y*.42,.18),
                CFrame.new((isLeft and -1 or 1)*legUpper.Size.X*.55,-.09,-legUpper.Size.Z*.22),metal,Enum.Material.Metal)
        end
        if legLower and legLower:IsA('BasePart') then
            part(group,legLower,side..'_Boot',
                Vector3.new(legLower.Size.X*1.13,legLower.Size.Y*.50,legLower.Size.Z*1.22),
                CFrame.new(0,-legLower.Size.Y*.23,-.045),trim,Enum.Material.Metal)
            part(group,legLower,side..'_BootLogo',
                Vector3.new(legLower.Size.X*.65,.075,.06),
                CFrame.new(0,-legLower.Size.Y*.15,-legLower.Size.Z*.65),accent,Enum.Material.Neon)
        end
    end
    if not opts.npc then
        -- A thin family crest / zipper, not a second giant neon chest block.
        T('Tailored_outer_lapel_L',Vector3.new(.13,th*.43,.09),CFrame.new(-tw*.29,th*.06,front-.14)*CFrame.Angles(0,0,-.29),metal,Enum.Material.Metal)
        T('Tailored_outer_lapel_R',Vector3.new(.13,th*.43,.09),CFrame.new(tw*.29,th*.06,front-.14)*CFrame.Angles(0,0,.29),metal,Enum.Material.Metal)
    end
    -- Visible cuffs + trousers so costume feels like a uniform, not a chest sticker.
    for _,tag in ipairs({'LeftLowerArm','RightLowerArm'}) do
        local limb=rig:FindFirstChild(tag) or rig:FindFirstChild(tag=='LeftLowerArm' and 'Left Arm' or 'Right Arm')
        if limb and limb:IsA('BasePart') then
            part(group,limb,'Wrist_armor',Vector3.new(limb.Size.X*1.12,.19,limb.Size.Z*1.13),CFrame.new(0,-limb.Size.Y*.35,0),primary,Enum.Material.Metal)
            part(group,limb,'Wrist_light',Vector3.new(limb.Size.X*.90,.08,limb.Size.Z*1.15),CFrame.new(0,-limb.Size.Y*.27,0),accent,Enum.Material.Neon)
        end
    end
    for _,tag in ipairs({'LeftLowerLeg','RightLowerLeg'}) do
        local limb=rig:FindFirstChild(tag)
        if limb and limb:IsA('BasePart') then
            part(group,limb,'Boot_cuff',Vector3.new(limb.Size.X*1.20,.20,limb.Size.Z*1.20),CFrame.new(0,-limb.Size.Y*.33,0),trim,Enum.Material.Metal)
        end
    end

    -- Five handcrafted premium silhouettes: bespoke equipment rather than recolours.
    if not opts.npc and def.premiumDesign then
        local design=def.premiumDesign
        local function torso(name,sz,cf,col,mat,shape)
            return T(name,sz,cf,col,mat or Enum.Material.Metal,shape)
        end
        local function helm(name,sz,cf,col,mat,shape)
            return H(name,sz,cf,col,mat or Enum.Material.Metal,shape)
        end
        if design=='archon' then
            helm('Abyss_full_faceplate',Vector3.new(hw*1.03,hh*.81,.28),CFrame.new(0,-hh*.07,hfront-.08),DARK)
            helm('Abyss_twin_eyes',Vector3.new(hw*.83,.13,.095),CFrame.new(0,hh*.10,hfront-.24),accent,Enum.Material.Neon)
            for _,side in ipairs({-1,1}) do
                for i=1,3 do
                    helm('Abyss_horn_'..side..'_'..i,Vector3.new(.17,.28+i*.18,.22),
                        CFrame.new(side*(hw*.36+(i-1)*.14),hh*(.63+i*.13),-.02)*CFrame.Angles(0,0,-side*(.18+i*.16)),metal)
                end
                torso('Abyss_outer_mantle_'..side,Vector3.new(.74,th*1.05,.18),
                    CFrame.new(side*tw*.55,-th*.27,tz*.66)*CFrame.Angles(0,0,side*.20),trim,Enum.Material.Fabric)
                torso('Abyss_reactor_fin_'..side,Vector3.new(.22,th*.9,.42),
                    CFrame.new(side*tw*.62,th*.03,tz*.73)*CFrame.Angles(0,0,side*.51),accent,Enum.Material.Neon)
            end
            torso('Abyss_black_heart',Vector3.new(.49,.59,.22),CFrame.new(0,th*.08,front-.29),DARK,Enum.Material.Metal,Enum.PartType.Ball)
            torso('Abyss_heart_glow',Vector3.new(.28,.36,.24),CFrame.new(0,th*.08,front-.41),accent,Enum.Material.Neon,Enum.PartType.Ball)
        elseif design=='ronin' then
            helm('Oni_helm_base',Vector3.new(hw*1.25,.38,hz*1.18),CFrame.new(0,hh*.39,.02),DARK)
            helm('Oni_demon_mask',Vector3.new(hw*.87,hh*.64,.24),CFrame.new(0,-hh*.13,hfront-.14),primary)
            for _,side in ipairs({-1,1}) do
                helm('Oni_horn_'..side,Vector3.new(.21,hh*.67,.19),CFrame.new(side*hw*.44,hh*.80,-.06)*CFrame.Angles(0,0,-side*.33),accent,Enum.Material.Neon)
                helm('Oni_eye_'..side,Vector3.new(.24,.09,.10),CFrame.new(side*hw*.23,hh*.07,hfront-.28),accent,Enum.Material.Neon)
                torso('Ronin_blade_'..side,Vector3.new(.16,th*1.55,.18),
                    CFrame.new(side*tw*.42,th*.35,tz*.80)*CFrame.Angles(0,0,side*.37),SOFT,Enum.Material.Metal)
                torso('Ronin_blade_edge_'..side,Vector3.new(.06,th*1.36,.19),
                    CFrame.new(side*tw*.48,th*.38,tz*.83)*CFrame.Angles(0,0,side*.37),accent,Enum.Material.Neon)
                torso('Ronin_cape_wing_'..side,Vector3.new(.65,th*.96,.11),
                    CFrame.new(side*tw*.6,-th*.32,tz*.67)*CFrame.Angles(0,0,side*.20),primary,Enum.Material.Fabric)
            end
            torso('Oni_chest_seal',Vector3.new(.55,.48,.14),CFrame.new(0,.10,front-.24),accent,Enum.Material.Neon,Enum.PartType.Ball)
        elseif design=='seraph' then
            helm('Seraph_halo_front',Vector3.new(hw*1.48,.10,.10),CFrame.new(0,hh*1.08,-hz*.22),accent,Enum.Material.Neon)
            helm('Seraph_halo_back',Vector3.new(hw*1.48,.10,.10),CFrame.new(0,hh*1.08,hz*.40),accent,Enum.Material.Neon)
            for _,side in ipairs({-1,1}) do
                helm('Seraph_halo_end_'..side,Vector3.new(.10,.10,hz*.68),CFrame.new(side*hw*.74,hh*1.08,hz*.09),accent,Enum.Material.Neon)
                for feather=1,5 do
                    torso('Seraph_feather_'..side..'_'..feather,Vector3.new(.32,th*(.50+.11*feather),.13),
                        CFrame.new(side*(tw*.48+feather*.22),th*(.24-.14*feather),tz*.61)*CFrame.Angles(0,0,side*(.26+.09*feather)),
                        feather%2==0 and accent or SOFT,feather%2==0 and Enum.Material.Neon or Enum.Material.Metal)
                end
            end
            torso('Seraph_chest_crest',Vector3.new(.48,.58,.19),CFrame.new(0,0,front-.31),accent,Enum.Material.Neon,Enum.PartType.Ball)
            helm('Seraph_crown_jewel',Vector3.new(.32,.31,.20),CFrame.new(0,hh*.66,hfront-.12),accent,Enum.Material.Neon,Enum.PartType.Ball)
        elseif design=='mech' then
            helm('Storm_reinforced_visor',Vector3.new(hw*1.11,hh*.43,.26),CFrame.new(0,.045,hfront-.19),accent,Enum.Material.Glass)
            for _,side in ipairs({-1,1}) do
                torso('Storm_turbine_shell_'..side,Vector3.new(.47,.78,.57),CFrame.new(side*tw*.43,-.07,tz*.83),metal,Enum.Material.Metal,Enum.PartType.Ball)
                torso('Storm_turbine_core_'..side,Vector3.new(.31,.53,.20),CFrame.new(side*tw*.43,-.07,tz*1.20),accent,Enum.Material.Neon,Enum.PartType.Ball)
                torso('Storm_wing_'..side,Vector3.new(.72,.16,.50),CFrame.new(side*tw*.79,th*.28,tz*.79)*CFrame.Angles(0,0,side*.30),metal)
                torso('Storm_shoulder_cannon_'..side,Vector3.new(.34,.31,.78),CFrame.new(side*tw*.65,th*.41,-tz*.23),DARK)
                torso('Storm_barrel_'..side,Vector3.new(.21,.21,.91),CFrame.new(side*tw*.65,th*.41,-tz*.41),accent,Enum.Material.Neon)
            end
            torso('Storm_reactor',Vector3.new(.53,.52,.27),CFrame.new(0,th*.13,front-.33),accent,Enum.Material.Neon,Enum.PartType.Ball)
            torso('Storm_abdominal_plates',Vector3.new(tw*.85,.40,.18),CFrame.new(0,-th*.29,front-.20),primary)
        elseif design=='phoenix' then
            helm('Phoenix_brow',Vector3.new(hw*1.21,.29,hz*1.17),CFrame.new(0,hh*.46,0),DARK)
            for i=-2,2 do
                helm('Phoenix_flame_crest_'..i,Vector3.new(.14,.38+(.4-math.abs(i)*.09),.18),
                    CFrame.new(i*.21,hh*.92,-hz*.10)*CFrame.Angles(0,0,-i*.17),accent,Enum.Material.Neon)
            end
            for _,side in ipairs({-1,1}) do
                for feather=1,5 do
                    torso('Phoenix_flame_wing_'..side..'_'..feather,Vector3.new(.32,.48+feather*.20,.14),
                        CFrame.new(side*(tw*.52+feather*.17),th*(.28-feather*.22),tz*.64)*CFrame.Angles(0,0,side*(.30+.09*feather)),
                        feather%2==0 and C(255,71,48) or accent,Enum.Material.Neon)
                end
                torso('Phoenix_pauldrons_'..side,Vector3.new(.53,.29,.62),CFrame.new(side*tw*.54,th*.37,0),primary)
            end
            torso('Phoenix_ember_heart',Vector3.new(.50,.62,.22),CFrame.new(0,th*.09,front-.30),accent,Enum.Material.Neon,Enum.PartType.Ball)
            torso('Phoenix_ember_beads',Vector3.new(.95,.10,.10),CFrame.new(0,-th*.31,front-.23),C(255,83,47),Enum.Material.Neon)
        end
    end
    -- V45: light, fine-grained embroidery and faceted accents on premium suits.
    -- Attached to actual limbs so running animations do not leave costume pieces behind.
    if not opts.npc and def.premiumDesign then
        local title=def.premiumDesign
        local gild=title=='seraph' and C(248,221,157) or title=='phoenix' and C(255,178,89) or metal
        local base=title=='archon' and C(39,30,72) or title=='mech' and C(24,43,68) or trim
        for _,tag in ipairs({'LeftUpperArm','RightUpperArm'}) do
            local limb=rig:FindFirstChild(tag)
            if limb then
                for i=1,3 do
                    part(group,limb,'Etched_armour_'..i,
                        Vector3.new(limb.Size.X*.76,.055,limb.Size.Z*.18),
                        CFrame.new(0,limb.Size.Y*(.31-i*.22),-limb.Size.Z*.61),
                        (i==2 and accent or gild),i==2 and Enum.Material.Neon or Enum.Material.Metal)
                end
            end
        end
        for _,tag in ipairs({'LeftLowerLeg','RightLowerLeg'}) do
            local limb=rig:FindFirstChild(tag)
            if limb then
                part(group,limb,'Greave_arc',Vector3.new(limb.Size.X*.92,limb.Size.Y*.43,.055),
                    CFrame.new(0,-limb.Size.Y*.13,-limb.Size.Z*.66),base,Enum.Material.Metal)
                part(group,limb,'Greave_gem',Vector3.new(.11,.16,.08),
                    CFrame.new(0,-limb.Size.Y*.19,-limb.Size.Z*.74),accent,Enum.Material.Neon)
            end
        end
        for i=1,4 do
            T('Tailored_rib_'..i,Vector3.new(tw*.61,.055,.065),
                CFrame.new(0,th*(.24-i*.13),front-.17),i==2 and accent or gild,
                i==2 and Enum.Material.Neon or Enum.Material.Metal)
        end
        for _,side in ipairs({-1,1}) do
            H('Helmet_insignia_'..side,Vector3.new(.12,.25,.09),
                CFrame.new(side*hw*.37,hh*.47,hfront-.16)*CFrame.Angles(0,0,side*.20),gild,Enum.Material.Metal)
        end
    end

    -- V44 / ATELIER EDITION: crafted secondary geometry unique to each of the
    -- five premium costumes. Everything attaches to body parts and animates
    -- with the character; no external copied marketplace meshes or textures.
    if not opts.npc and def.premiumDesign then
        local d=def.premiumDesign
        local silver=C(201,217,230)
        local brass=C(248,191,87)
        local ink=C(9,15,29)
        local ash=C(46,49,60)
        local ruby=C(243,74,97)
        local ice=C(156,231,255)
        local function A(name,s,cf,c,m,shape) return T(name,s,cf,c,m or Enum.Material.Metal,shape) end
        local function B(name,s,cf,c,m,shape) return H(name,s,cf,c,m or Enum.Material.Metal,shape) end
        local function wing(n,x,y,z,w,h,col,angle)
            return A(n,Vector3.new(w,h,.16),CFrame.new(x,y,z)*CFrame.Angles(0,0,angle),col,Enum.Material.Metal)
        end
        local function stud(n,x,y,z,s,c)
            return A(n,Vector3.new(s,s,s),CFrame.new(x,y,z),c,Enum.Material.Neon,Enum.PartType.Ball)
        end
        local function armDetail(side,kind,sz,offset,col,mat)
            local limb=rig:FindFirstChild((side&lt;0 and 'Left' or 'Right')..kind)
                or rig:FindFirstChild(side&lt;0 and 'Left Arm' or 'Right Arm')
            if limb and limb:IsA('BasePart') then
                return part(group,limb,'Premium_'..d..'_'..kind,sz,offset,col,mat or Enum.Material.Metal)
            end
        end
        local function legDetail(side,kind,sz,offset,col,mat)
            local limb=rig:FindFirstChild((side&lt;0 and 'Left' or 'Right')..kind)
                or rig:FindFirstChild(side&lt;0 and 'Left Leg' or 'Right Leg')
            if limb and limb:IsA('BasePart') then
                return part(group,limb,'Premium_'..d..'_'..kind,sz,offset,col,mat or Enum.Material.Metal)
            end
        end
        if d=='archon' then
            -- Sculpted horn ridges, heavy obsidian breastplate, layered cloak.
            for _,side in ipairs({-1,1}) do
                for i=1,4 do
                    local y=hh*(.63+i*.20)
                    B('Void_spiral_horn_'..side..'_'..i,
                        Vector3.new(.27-i*.034,.29,.26-i*.035),
                        CFrame.new(side*(hw*.34+(i*.11)),y,-.12)*CFrame.Angles(0,0,-side*(.10+i*.15)),
                        i==4 and accent or C(54,55,76))
                end
                B('Void_temple_inlay',Vector3.new(.17,.44,.10),CFrame.new(side*hw*.55,.02,hfront-.18),brass)
                for i=1,4 do
                    wing('Cloak_scales_'..side..'_'..i,side*(tw*.32+i*.24),-th*(.13+i*.13),tz*.64,
                        .42,th*(.92+i*.075),i%2==0 and trim or primary,side*(.12+i*.11))
                end
                for i=1,3 do
                    wing('Rib_plate_'..side..'_'..i,side*(tw*.25),th*(.21-i*.21),front-.31,
                        .49,.14,metal,-side*.14)
                end
                armDetail(side,'LowerArm',Vector3.new(.65,.38,.69),CFrame.new(0,-.23,0),trim)
                legDetail(side,'LowerLeg',Vector3.new(.64,.32,.74),CFrame.new(0,-.37,0),brass)
            end
            A('Obsidian_royal_cuirass',Vector3.new(.97,.98,.16),CFrame.new(0,-.03,front-.28),ink)
            A('Void_cuirass_spine',Vector3.new(.18,1.02,.10),CFrame.new(0,.02,front-.39),brass)
            for i=1,3 do stud('Void_rune_'..i,0,.39-i*.29,front-.48,.12,accent) end
            A('Hanging_talisman',Vector3.new(.18,.47,.12),CFrame.new(0,-th*.57,front-.28),brass)
        elseif d=='ronin' then
            -- Kabuto, crossed wakizashi, serrated mouth mask, armour lamellae.
            B('Kabuto_vertical_crest',Vector3.new(.10,.51,.76),CFrame.new(0,hh*.83,-.02),brass)
            for _,side in ipairs({-1,1}) do
                B('Oni_cheek_fang_'..side,Vector3.new(.14,.30,.15),CFrame.new(side*.34,-hh*.31,hfront-.29)*CFrame.Angles(0,0,side*.28),silver)
                B('Oni_temple_arc_'..side,Vector3.new(.20,.28,.50),CFrame.new(side*hw*.62,hh*.29,.07),ink)
                for i=1,4 do
                    A('Ronin_waist_sash_'..side..'_'..i,Vector3.new(.44,.18,.22),
                      CFrame.new(side*(tw*.29),-th*(.33+i*.085),front-.13),i%2==0 and primary or trim,Enum.Material.Fabric)
                end
                A('Blade_grip_'..side,Vector3.new(.23,.61,.23),CFrame.new(side*tw*.43,th*.86,tz*.84)*CFrame.Angles(0,0,side*.39),ash)
                for j=1,4 do
                    A('Grip_wrapping_'..side..j,Vector3.new(.26,.06,.25),CFrame.new(side*tw*.43,th*(.60+j*.10),tz*.84)*CFrame.Angles(0,0,side*.39),ruby)
                end
                A('Sword_guard_'..side,Vector3.new(.57,.11,.25),CFrame.new(side*tw*.42,th*.53,tz*.84)*CFrame.Angles(0,0,side*.39),brass)
                armDetail(side,'LowerArm',Vector3.new(.65,.25,.66),CFrame.new(0,-.27,0),ruby)
            end
            A('Samurai_chest_scales',Vector3.new(.93,.72,.18),CFrame.new(0,.02,front-.28),ink)
            for i=1,4 do
                A('Lacquered_plates_'..i,Vector3.new(.96,.13,.11),CFrame.new(0,.27-i*.19,front-.42),i%2==0 and primary or metal)
            end
            A('Samurai_belt_knot',Vector3.new(.39,.36,.22),CFrame.new(0,-th*.40,front-.36),ruby,Enum.Material.Fabric,Enum.PartType.Ball)
        elseif d=='seraph' then
            -- Two articulated layers of opalescent wings and a segmented 3D halo.
            for _,side in ipairs({-1,1}) do
                for layer=1,2 do
                    for i=1,6 do
                        local spread=tw*.49+i*(layer==1 and .29 or .23)
                        local drop=(i-1)*.29
                        wing('Celestial_feather_'..side..'_'..layer..'_'..i,
                          side*spread,th*(.46-drop),tz*(layer==1 and .78 or .62),
                          .26,th*(.80+(6-i)*.19),layer==1 and silver or accent,
                          side*(.16+i*.10))
                    end
                end
                B('Seraph_ear_crown_'..side,Vector3.new(.19,.58,.24),CFrame.new(side*hw*.55,hh*.58,-.08)*CFrame.Angles(0,0,-side*.30),brass)
                armDetail(side,'UpperArm',Vector3.new(.58,.28,.62),CFrame.new(0,.21,0),brass)
                legDetail(side,'LowerLeg',Vector3.new(.55,.29,.62),CFrame.new(0,-.27,0),silver)
            end
            for i=1,12 do
                local a=(i-1)*math.pi/6
                B('Halo_glyph_'..i,Vector3.new(.085,.09,.30),
                  CFrame.new(math.cos(a)*hw*.80,hh*1.16,math.sin(a)*hz*.79)*CFrame.Angles(0,a,0),
                  i%3==0 and brass or accent,Enum.Material.Neon)
            end
            A('Angelic_breastbone',Vector3.new(.18,1.18,.22),CFrame.new(0,.13,front-.33),brass)
            for i=1,5 do
                stud('Starmap_node_'..i,(i-3)*.19,.31-math.abs(i-3)*.11,front-.46,.105,accent)
            end
        elseif d=='mech' then
            -- A readable exosuit with hydraulic joints and vented turbine shells.
            A('Storm_armor_chest',Vector3.new(tw*.96,th*.61,.20),CFrame.new(0,th*.10,front-.29),ink)
            for _,side in ipairs({-1,1}) do
                A('Mech_upper_piston_'..side,Vector3.new(.16,.86,.17),CFrame.new(side*tw*.55,th*.02,tz*.80)*CFrame.Angles(0,0,side*.25),silver)
                A('Turbine_side_blade_'..side,Vector3.new(.31,.70,.32),CFrame.new(side*tw*.43,-.05,tz*1.26),primary)
                for i=1,5 do
                    A('Turbine_vents_'..side..i,Vector3.new(.22,.06,.09),
                      CFrame.new(side*tw*.43,.22-i*.11,tz*1.46),i%2==0 and silver or accent)
                end
                armDetail(side,'UpperArm',Vector3.new(.66,.33,.80),CFrame.new(0,.26,0),metal)
                armDetail(side,'LowerArm',Vector3.new(.66,.45,.76),CFrame.new(0,-.28,0),ink)
                legDetail(side,'UpperLeg',Vector3.new(.75,.27,.84),CFrame.new(0,.22,-.03),metal)
                legDetail(side,'LowerLeg',Vector3.new(.62,.56,.84),CFrame.new(0,-.22,-.02),primary)
                stud('Thruster_status_'..side,side*tw*.43,.0,tz*1.48,.16,accent)
            end
            for i=1,3 do
                A('Front_chest_vents_'..i,Vector3.new(.12,.40,.11),CFrame.new((i-2)*.28,-.27,front-.43),accent,Enum.Material.Neon)
            end
            B('Mech_mouth_grille',Vector3.new(hw*.63,.19,.12),CFrame.new(0,-hh*.23,hfront-.39),silver)
        elseif d=='phoenix' then
            -- Blackened armour, layered bright-red/gold feathers and flame crown.
            local ember=C(255,96,49)
            local gold=C(255,205,86)
            A('Charred_breastplate',Vector3.new(tw*.92,th*.73,.19),CFrame.new(0,.04,front-.31),ink)
            for _,side in ipairs({-1,1}) do
                for layer=1,2 do
                    for i=1,6 do
                        local px=tw*.40+i*(layer==1 and .28 or .20)
                        wing('Solar_feather_'..side..'_'..layer..'_'..i,side*px,
                          th*(.37-i*.27),tz*(layer==1 and .82 or .64),
                          .28,.57+i*.17,layer==1 and gold or ember,side*(.20+i*.12))
                    end
                end
                B('Phoenix_brow_spike_'..side,Vector3.new(.18,.49,.25),CFrame.new(side*hw*.36,hh*.79,-.15)*CFrame.Angles(0,0,-side*.29),gold)
                armDetail(side,'LowerArm',Vector3.new(.67,.27,.68),CFrame.new(0,-.21,0),gold)
                legDetail(side,'LowerLeg',Vector3.new(.63,.44,.79),CFrame.new(0,-.22,0),ink)
            end
            for i=1,5 do
                stud('Phoenix_ember_rune_'..i,0,.46-i*.18,front-.45,.12,ember)
            end
            A('Phoenix_waist_plaque',Vector3.new(.76,.15,.15),CFrame.new(0,-th*.42,front-.32),gold)
        end
    end
    -- V47 tailoring: stitches, buckles, layered cloth panels and leg/arm accents.
    -- Proportional to the actual R15 limb sizes; these animate with the avatar.
    do
        local stitching=lerp(metal,C(245,242,223),.24)
        local under=lerp(primary,DARK,.66)
        for _,side in ipairs({-1,1}) do
            -- The jacket has asymmetric functional seams, no flat painted rectangle.
            T('V47_Lapel_'..side,Vector3.new(.12,th*.51,.075),
                CFrame.new(side*tw*.28,th*.11,front-.22)*CFrame.Angles(0,0,side*.24),stitching,Enum.Material.Fabric)
            T('V47_BreastPocket_'..side,Vector3.new(tw*.26,th*.14,.065),
                CFrame.new(side*tw*.30,th*.12,front-.30),under,Enum.Material.Fabric)
            T('V47_BreastPocketStitch_'..side,Vector3.new(tw*.24,.044,.08),
                CFrame.new(side*tw*.30,th*.19,front-.34),stitching,Enum.Material.Fabric)
            T('V47_HipStrap_'..side,Vector3.new(.15,.20,.11),
                CFrame.new(side*tw*.38,-th*.34,front-.14),trim,Enum.Material.Metal)
            T('V47_HipBuckle_'..side,Vector3.new(.11,.11,.08),
                CFrame.new(side*tw*.38,-th*.33,front-.23),metal,Enum.Material.Metal)
            local pre=side&lt;0 and 'Left' or 'Right'
            local upper=rig:FindFirstChild(pre..'UpperArm') or rig:FindFirstChild(pre..' Arm')
            if upper and upper:IsA('BasePart') then
                part(group,upper,'V47_EmbroideredArmPanel',
                    Vector3.new(upper.Size.X*.78,upper.Size.Y*.48,.06),
                    CFrame.new(0,.04,-upper.Size.Z*.60),under,Enum.Material.Fabric)
                part(group,upper,'V47_ArmBadge',
                    Vector3.new(upper.Size.X*.43,upper.Size.Y*.16,.07),
                    CFrame.new(0,.04,-upper.Size.Z*.68),accent,Enum.Material.Metal)
            end
            local leg=rig:FindFirstChild(pre..'LowerLeg') or rig:FindFirstChild(pre..' Leg')
            if leg and leg:IsA('BasePart') then
                part(group,leg,'V47_TaperedBootPanel',
                    Vector3.new(leg.Size.X*.83,leg.Size.Y*.43,.075),
                    CFrame.new(0,-leg.Size.Y*.17,-leg.Size.Z*.63),under,Enum.Material.Fabric)
                for i=1,3 do
                    part(group,leg,'V47_BootLace_'..i,
                        Vector3.new(leg.Size.X*.36,.036,.10),
                        CFrame.new(0,leg.Size.Y*(.03-i*.11),-leg.Size.Z*.72),stitching,Enum.Material.Fabric)
                end
            end
        end
        -- Only 8 small accents for NPC fallback, full chest stitching for heroes.
        if not opts.npc then
            T('V47_Zipper',Vector3.new(.050,th*.58,.07),
                CFrame.new(0,-th*.04,front-.30),metal,Enum.Material.Metal)
            T('V47_ZipPull',Vector3.new(.17,.15,.11),
                CFrame.new(0,th*.21,front-.37),stitching,Enum.Material.Metal)
            for i=1,3 do
                T('V47_StitchedSideBand_'..i,Vector3.new(tw*.50,.035,.066),
                    CFrame.new(0,-th*(.12+i*.086),front-.24),under,Enum.Material.Fabric)
            end
            -- Identity-specific emblem replaces yet another giant neon plate.
            local symbol=silhouette=='ronin' and 'Ronin' or silhouette=='frost' and 'Frost' or
              silhouette=='solar' and 'Solar' or silhouette=='sentinel' and 'Sentinel' or 'Street'
            T('V47_'..symbol..'_Insignia',Vector3.new(.22,.24,.085),
                CFrame.new(tw*.33,th*.30,front-.33),accent,Enum.Material.Metal,Enum.PartType.Ball)
        end
    end
    -- V48 tailoring pass: more readable cloth layering from gameplay distance.
    do
        local thread=lerp(primary,C(243,238,223),.26)
        local shadow=lerp(primary,DARK,.72)
        for _,side in ipairs({-1,1}) do
            local pre=side&lt;0 and 'Left' or 'Right'
            local upperLeg=rig:FindFirstChild(pre..'UpperLeg') or rig:FindFirstChild(pre..' Leg')
            if upperLeg and upperLeg:IsA('BasePart') then
                part(group,upperLeg,'V48_ThighPanel',
                    Vector3.new(upperLeg.Size.X*.78,upperLeg.Size.Y*.30,.07),
                    CFrame.new(0,-upperLeg.Size.Y*.05,-upperLeg.Size.Z*.64),shadow,Enum.Material.Fabric)
                part(group,upperLeg,'V48_ThighStitch',
                    Vector3.new(upperLeg.Size.X*.56,.035,.08),
                    CFrame.new(0,upperLeg.Size.Y*.16,-upperLeg.Size.Z*.72),thread,Enum.Material.Fabric)
            end
            local lowerArm=rig:FindFirstChild(pre..'LowerArm') or rig:FindFirstChild(pre..' Arm')
            if lowerArm and lowerArm:IsA('BasePart') then
                part(group,lowerArm,'V48_CuffBand',
                    Vector3.new(lowerArm.Size.X*.70,.10,.08),
                    CFrame.new(0,-lowerArm.Size.Y*.22,-lowerArm.Size.Z*.66),thread,Enum.Material.Fabric)
            end
        end
        if not opts.npc then
            T('V48_CollarBand',Vector3.new(tw*.48,.07,.09),
                CFrame.new(0,th*.46,front-.27),thread,Enum.Material.Fabric)
            T('V48_HemBand',Vector3.new(tw*.84,.06,.08),
                CFrame.new(0,-th*.47,front-.20),shadow,Enum.Material.Fabric)
            T('V48_ChestPin',Vector3.new(.16,.16,.08),
                CFrame.new(-tw*.30,th*.24,front-.36),accent,Enum.Material.Metal,Enum.PartType.Ball)
        end
    end
    -- V51: the jacket wraps the torso instead of sitting on the chest as a box.
    local panel=group:FindFirstChild('Tailored_jacket')
    if panel then panel:Destroy()end
    part(group,torso,'FittedWrap',Vector3.new(tw*1.03,th*.90,tz*1.10),CFrame.new(0,-th*.035,.015),trim,Enum.Material.Fabric,Enum.PartType.Ball)
    for _,s in ipairs({-1,1})do
        T('ShapedJacketPanel',Vector3.new(tw*.50,th*.72,.23),CFrame.new(s*tw*.24,th*.015,-tz*.59)*CFrame.Angles(0,0,s*.07),primary,Enum.Material.Fabric,Enum.PartType.Ball)
    end
    local lower=rig:FindFirstChild('LowerTorso')
    if lower then
        part(group,lower,'WaistTailoring',Vector3.new(lower.Size.X*1.03,lower.Size.Y*.91,lower.Size.Z*1.06),CFrame.new(),trim,Enum.Material.Fabric)
    end
    return group
end
M.apply = dress

-- Basic original NPC fashions, intentionally distinct from purchasable premium outfits.
local npcProfiles={
 {name='Скейтбордист',primary=C(222,91,97),accent=C(246,201,110),silhouette='drift'},
 {name='Диджей',primary=C(115,85,211),accent=C(78,240,241),silhouette='specter'},
 {name='Курьер',primary=C(241,167,68),accent=C(73,132,217),silhouette='drift'},
 {name='Фотограф',primary=C(93,139,167),accent=C(215,225,240),silhouette='pilot'},
 {name='Почтальон',primary=C(56,149,175),accent=C(243,193,91),silhouette='drift'},
 {name='Инженер',primary=C(62,143,107),accent=C(243,172,75),silhouette='pilot'},
 {name='Турист',primary=C(239,121,125),accent=C(244,210,147),silhouette='frost'},
 {name='Механик',primary=C(64,99,152),accent=C(225,195,96),silhouette='sentinel'},
 {name='Музыкант',primary=C(114,74,158),accent=C(252,181,91),silhouette='specter'},
 {name='Техник',primary=C(67,171,160),accent=C(51,51,67),silhouette='pilot'},
 {name='Спортсмен',primary=C(182,98,71),accent=C(241,218,155),silhouette='ronin'},
 {name='Программист',primary=C(54,61,83),accent=C(103,211,252),silhouette='phantom'},
}
M.NpcProfiles=npcProfiles
function M.applyNPC(rig, rng)
    local idx=(rng or Random.new()):NextInteger(1,#npcProfiles)
    local p=npcProfiles[idx]
    -- Reduced part count on temporary NPCs; no expensive particles.
    dress(rig,{color=p.primary,accent=p.accent,silhouette=p.silhouette,tier=2},{npc=true})
    return p.name
end
function M.makePreview(def)
    local model=Instance.new('Model')
    model.Name='OriginalCostumePreview'
    local fabric=C(39,49,68)
    local face=C(222,193,157)
    local function basic(name,sz,cf,color)
        local p=Instance.new('Part')
        p.Name=name;p.Size=sz;p.CFrame=cf;p.Color=color
        p.Material=Enum.Material.SmoothPlastic
        p.Anchored=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.CastShadow=false
        p.Parent=model
        return p
    end
    basic('UpperTorso',Vector3.new(1.50,1.42,.74),CFrame.new(0,2.91,0),fabric)
    basic('LowerTorso',Vector3.new(1.44,.58,.73),CFrame.new(0,1.91,0),fabric)
    basic('Head',Vector3.new(.94,.93,.91),CFrame.new(0,4.15,0),face)
    for _,side in ipairs({-1,1}) do
        local s=side&lt;0 and 'Left' or 'Right'
        basic(s..'UpperArm',Vector3.new(.46,.69,.49),CFrame.new(side*1.00,3.03,0),fabric)
        basic(s..'LowerArm',Vector3.new(.44,.69,.47),CFrame.new(side*1.00,2.33,0),fabric)
        basic(s..'Hand',Vector3.new(.41,.25,.43),CFrame.new(side*1.00,1.87,0),face)
        basic(s..'UpperLeg',Vector3.new(.61,.68,.69),CFrame.new(side*.42,1.35,0),fabric)
        basic(s..'LowerLeg',Vector3.new(.56,.72,.64),CFrame.new(side*.42,.69,-.025),fabric)
        basic(s..'Foot',Vector3.new(.58,.22,.83),CFrame.new(side*.42,.23,-.12),fabric)
    end
    if def.premiumDesign then
        for _,p in ipairs(model:GetChildren())do
            if p:IsA('BasePart')and not p.Name:find('Hand')and not(p.Name=='Head'and M.hasOpenFace(def))then p.Transparency=1 end
        end
        if M.hasOpenFace(def)then
            local face=model:FindFirstChild('Head');face.Shape=Enum.PartType.Ball
            for _,side in ipairs({-1,1})do
                local eye=basic('PreviewEye',Vector3.new(.055,.105,.025),face.CFrame*CFrame.new(side*.18,.02,-.455),C(33,36,45))
                eye.Shape=Enum.PartType.Ball
            end
            basic('PreviewSmile',Vector3.new(.20,.035,.025),face.CFrame*CFrame.new(0,-.19,-.45),C(104,67,66))
        end
    end
    dress(model,def,{preview=true})
    return model
end
-- The real Roblox catalog outfit remains on the vendor; bespoke props establish role.
function M.applyVendorSignature(rig,role)
 local head=rig:FindFirstChild('Head');local torso=rig:FindFirstChild('UpperTorso')or rig:FindFirstChild('Torso')
 if not head or not torso then return end
 local old=rig:FindFirstChild('Steal60VendorSignature');if old then old:Destroy()end
 local fallback=rig:FindFirstChild('Steal60HeroSkin');if fallback then fallback:Destroy()end
 local g=Instance.new('Folder');g.Name='Steal60VendorSignature';g.Parent=rig
 local gold=C(245,192,84);local cream=C(245,236,212);local ink=C(26,37,54)
 local hw,hh,hz=head.Size.X,head.Size.Y,head.Size.Z
 local tw,th,tz=torso.Size.X,torso.Size.Y,torso.Size.Z
 local function P(parent,n,sz,cf,c,mat,shape,kind)return part(g,parent,n,sz,cf,c,mat or Enum.Material.SmoothPlastic,shape,kind)end
 local function H(n,sz,cf,c,mat,shape,kind)return P(head,n,sz,cf,c,mat,shape,kind)end
 local function T(n,sz,cf,c,mat,shape)return P(torso,n,sz,cf,c,mat,shape)end
 if role=='coins'then
  local green=C(42,151,114)
  H('MechanicCap',Vector3.new(hw*1.16,hh*.34,hz*1.18),CFrame.new(0,hh*.56,0),green,nil,Enum.PartType.Ball)
  H('CapVisor',Vector3.new(hw*1.02,.09,hz*.64),CFrame.new(0,hh*.43,-hz*.55),green)
  H('CapBadge',Vector3.new(.22,.18,.07),CFrame.new(0,hh*.58,-hz*.61),gold,Enum.Material.Metal)
  T('WorkApron',Vector3.new(tw*.82,th*1.03,.12),CFrame.new(0,-th*.17,-tz*.61),C(161,104,67),Enum.Material.Fabric)
  T('ApronPocket',Vector3.new(tw*.57,th*.27,.10),CFrame.new(0,-th*.34,-tz*.72),C(107,72,53),Enum.Material.Fabric)
  for _,s in ipairs({-1,1})do T('ApronStrap',Vector3.new(.12,th*.72,.07),CFrame.new(s*tw*.27,th*.08,-tz*.69)*CFrame.Angles(0,0,s*.11),cream,Enum.Material.Fabric)end
  T('WrenchHandle',Vector3.new(.13,.72,.10),CFrame.new(tw*.34,-th*.12,-tz*.81)*CFrame.Angles(0,0,.19),gold,Enum.Material.Metal)
 elseif role=='diamonds'then
  H('ShowmanHatBrim',Vector3.new(hw*1.48,.12,hz*1.45),CFrame.new(0,hh*.55,.02),ink)
  H('ShowmanTopHat',Vector3.new(hw*.96,hh*.77,hz*.96),CFrame.new(0,hh*.91,.02),ink)
  H('HatSatinBand',Vector3.new(hw*.98,.16,hz*.98),CFrame.new(0,hh*.65,.02),C(67,190,223))
  H('HatDiamond',Vector3.new(.22,.27,.12),CFrame.new(0,hh*.70,-hz*.55),gold,Enum.Material.Metal,Enum.PartType.Ball)
  for _,s in ipairs({-1,1})do
   T('IvoryTuxedoLapel',Vector3.new(tw*.29,th*.64,.12),CFrame.new(s*tw*.23,th*.10,-tz*.61)*CFrame.Angles(0,0,-s*.28),cream,Enum.Material.Fabric)
   T('BowTie',Vector3.new(.25,.17,.12),CFrame.new(s*.14,th*.38,-tz*.72)*CFrame.Angles(0,0,-s*.15),C(67,190,223))
  end
  for i=1,3 do T('GoldButton',Vector3.new(.08,.08,.06),CFrame.new(0,th*(.20-i*.18),-tz*.73),gold,Enum.Material.Metal,Enum.PartType.Ball)end
 elseif role=='workshop'then
  local orange=C(249,173,56)
  H('SafetyHelmet',Vector3.new(hw*1.23,hh*.53,hz*1.22),CFrame.new(0,hh*.47,.02),orange,nil,Enum.PartType.Ball)
  H('HelmetBrim',Vector3.new(hw*1.36,.10,hz*1.36),CFrame.new(0,hh*.32,0),orange)
  for _,s in ipairs({-1,1})do
   H('SafetyGoggleRim',Vector3.new(hw*.43,.29,.12),CFrame.new(s*hw*.25,hh*.08,-hz*.57),ink,nil,Enum.PartType.Ball)
   H('SafetyGoggleLens',Vector3.new(hw*.32,.20,.07),CFrame.new(s*hw*.25,hh*.08,-hz*.66),C(132,226,225),Enum.Material.Glass,Enum.PartType.Ball)
   T('ReflectiveSafetyStripe',Vector3.new(.17,th*.94,.07),CFrame.new(s*tw*.31,-th*.02,-tz*.65),orange)
  end
  T('ToolBelt',Vector3.new(tw*1.08,.25,tz*1.1),CFrame.new(0,-th*.43,0),C(99,66,48),Enum.Material.Fabric)
  for i=-1,1 do T('ToolPouch',Vector3.new(.26,.32,.20),CFrame.new(i*.37,-th*.52,-tz*.62),C(143,95,58),Enum.Material.Fabric)end
 else
  local pink=C(227,105,192);local cyan=C(86,232,218)
  H('StylistBeret',Vector3.new(hw*1.27,hh*.30,hz*1.16),CFrame.new(hw*.10,hh*.57,.01)*CFrame.Angles(0,0,-.12),pink,Enum.Material.Fabric,Enum.PartType.Ball)
  for _,s in ipairs({-1,1})do
   H('OversizedHeadphone',Vector3.new(.23,hh*.46,hz*.50),CFrame.new(s*hw*.57,.08,.02),cyan,nil,Enum.PartType.Ball)
   H('GoldEarring',Vector3.new(.09,.23,.09),CFrame.new(s*hw*.56,-hh*.33,-.03),gold,Enum.Material.Metal,Enum.PartType.Ball)
   T('SatinScarf',Vector3.new(.26,th*.77,.11),CFrame.new(s*tw*.32,-th*.03,-tz*.62)*CFrame.Angles(0,0,s*.13),pink,Enum.Material.Fabric)
  end
  T('ColourPalette',Vector3.new(.48,.37,.10),CFrame.new(-tw*.29,-th*.20,-tz*.76)*CFrame.Angles(0,0,.28),cream,nil,Enum.PartType.Ball)
  for i,c in ipairs({pink,cyan,gold})do T('PaintDab',Vector3.new(.10,.10,.04),CFrame.new(-tw*.29+(i-2)*.12,-th*.20,-tz*.84),c,nil,Enum.PartType.Ball)end
 end
 return g
end

return M
</ProtectedString>
          </Properties>
