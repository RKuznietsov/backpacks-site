corner(bgb,12);stroke(bgb,C(78,243,158))
local bt=text(bgb,UDim2.new(1,-12,1,-8),UDim2.fromOffset(6,4),"▼  ТВОЙ САЛОН\n    ОСТАНОВИСЬ ЗДЕСЬ",C(126,255,176),Enum.Font.GothamBold)
