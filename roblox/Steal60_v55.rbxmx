 elseif id=='pet_star' then
  for i=1,5 do
   local a=(i-1)*math.pi*2/5+math.pi/2
   orb('Хрустальная_окантовка',math.cos(a)*.84,math.sin(a)*.84,-.19,.19,.20,.08,C(255,236,157))
  end
  for _,side in ipairs({-1,1}) do
