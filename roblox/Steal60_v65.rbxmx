  if type(inbox)~='table'or not finite(inbox.coins or 0)or(inbox.coins or 0)&lt;0 or(inbox.coins or 0)&gt;M.MAX or not finite(inbox.raids or 0)or(inbox.raids or 0)&lt;0 or type(inbox.senders or{})~='table'then return false end
