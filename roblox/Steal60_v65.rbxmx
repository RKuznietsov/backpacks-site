M.valid=valid;M.copy=copy
function M.new(name,defaults,options)
 return setmetatable({store=DSS:GetDataStore(name),backup=DSS:GetDataStore(name..'_Recovery_v65'),defaults=defaults,options=options or{},states={}},M)
end
function M:_health(player,status)
 local s=self.states[player];if s then s.status=status end
 if self.options.health then self.options.health(player,status)end
end
function M:blocked(player)local s=self.states[player];return s and(s.lost or s.status=='blocked')or false end
function M:checkLease(player)
