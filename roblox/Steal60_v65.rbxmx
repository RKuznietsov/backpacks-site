      <Item class="Script" referent="RBX29">
        <Properties>
          <string name="Name">Main</string>
          <bool name="Disabled">true</bool>
          <ProtectedString name="Source">-- Script: ServerScriptService/Main
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local Services = script.Parent:WaitForChild("Services")
local Shared = ReplicatedStorage:WaitForChild("Shared")

local CollisionService = require(Services:WaitForChild("CollisionService"))
local DataService = require(Services:WaitForChild("DataService"))
local SeasonLeaderboardService = require(Services:WaitForChild("SeasonLeaderboardService"))
local Net = require(Services:WaitForChild("Net"))
local TrackBuilder = require(Services:WaitForChild("TrackBuilder"))
local DistrictManager = require(Services:WaitForChild("DistrictManager"))
local ParkingService = require(Services:WaitForChild("ParkingService"))
local OwnerService = require(Services:WaitForChild("OwnerService"))
local PoliceService = require(Services:WaitForChild("PoliceService"))
local DriveService = require(Services:WaitForChild("DriveService"))
local DeliveryService = require(Services:WaitForChild("DeliveryService"))
local SalonService = require(Services:WaitForChild("SalonService"))
local HackService = require(Services:WaitForChild("HackService"))
local HeistService = require(Services:WaitForChild("HeistService"))
local RoadEventService = require(Services:WaitForChild("RoadEventService"))
local RoadChallengeService = require(Services:WaitForChild("RoadChallengeService"))
local UpgradeService = require(Services:WaitForChild("UpgradeService"))
local MonetizationService = require(Services:WaitForChild("MonetizationService"))
local Tutorial = require(Services:WaitForChild("TutorialService"))
local CosmeticService = require(Services:WaitForChild("CosmeticService"))
local StreetLife=require(Services.StreetLifeService)
local Language=require(Services:WaitForChild("LanguageService"))

local Districts = require(Shared.Config.Districts)
local CarClasses = require(Shared.Config.CarClasses)
local Cars = require(Shared.Config.Cars)
local Rarity = require(Shared.Rarity)
local Layout = require(Shared.TrackLayout)

ReplicatedStorage:SetAttribute('Steal60Language',"ru")
print("[Steal60] Main запущен")
Net.init()
DriveService.init()
CollisionService.init()
DataService.init()
Language.init()
Tutorial.init()
MonetizationService.init()
TrackBuilder.init()
SeasonLeaderboardService.init()
StreetLife.init()
DistrictManager.init()
ParkingService.init()
OwnerService.init()
PoliceService.init()
DeliveryService.init()
RoadEventService.init()
RoadChallengeService.init()
HeistService.init()
SalonService.init()
UpgradeService.init()
CosmeticService.init()
HackService.init()

----------------------------------------------------------------------
-- Клиентский скрипт (мини-игра, уведомления, езда) кладём каждому игроку в PlayerGui
----------------------------------------------------------------------
local clientTemplate = ServerStorage:WaitForChild("ClientTemplates"):WaitForChild("ClientMain")

local function giveClient(player)
	local playerGui = player:WaitForChild("PlayerGui")
	if playerGui:FindFirstChild("Steal60Client") then
		return
	end
	local screen = Instance.new("ScreenGui");screen.AutoLocalize=false
	screen.Name = "Steal60Client"
	screen.ResetOnSpawn = false
	screen.Parent = playerGui
	clientTemplate:Clone().Parent = screen
    local nav = ServerStorage.ClientTemplates:FindFirstChild("RouteHUD")
    if nav then nav:Clone().Parent = screen end
    local runHUD = ServerStorage.ClientTemplates:FindFirstChild("HeistHUD")
    if runHUD then runHUD:Clone().Parent = screen end
    local eventHUD = ServerStorage.ClientTemplates:FindFirstChild("RoadChallengeHUD")
    if eventHUD then eventHUD:Clone().Parent = screen end
    local theftHUD = ServerStorage.ClientTemplates:FindFirstChild("TheftHUD")
    if theftHUD then theftHUD:Clone().Parent = screen end
    local economy = ServerStorage.ClientTemplates:FindFirstChild("EconomyHUD")
    if economy then economy:Clone().Parent = screen end
    local cosmetic = ServerStorage.ClientTemplates:FindFirstChild("CosmeticHUD")
    if cosmetic then cosmetic:Clone().Parent = screen end
    local tutorial = ServerStorage.ClientTemplates:FindFirstChild("TutorialHUD")
    if tutorial then tutorial:Clone().Parent = screen end
end

----------------------------------------------------------------------
-- ВРЕМЕННО (до этапов 5-6): награда за доставку и рост уровня взлома
----------------------------------------------------------------------
DeliveryService.onDelivered(function(player, info)
	local data = DataService.get(player)
	if not data then
		return
	end
    local isNew = DataService.addToCatalog(player, info.carId, info.rarity, info.variantId)
    local firstSuccess = data.botUnlocked ~= true
    if firstSuccess then
        data.botUnlocked = true
        player:SetAttribute("HelperUnlocked", true)

    end

	local variantMult = 1
	for _, v in ipairs(Cars.Variants) do
		if v.id == info.variantId then
			variantMult = v.incomeMult
		end
	end
	local reward = math.floor(CarClasses[info.classId].baseValue * Rarity.Info[info.rarity].incomeMult * variantMult * 0.25)
    local payout, runResult = HeistService.onDelivered(player, info, reward, isNew)
    -- Extra rewards are calculated from the delivered car and persisted server contract.
    local eventBonus, eventResult = RoadChallengeService.onDelivered(player, info, reward)
    local cosmeticBonusPct=require(Shared.Config.CosmeticConfig).coinBonusPct(data)
    payout += math.floor(eventBonus*(1+cosmeticBonusPct/100)+.5)
    DataService.addMoney(player, payout, true)
    if eventResult ~= "" then runResult ..= " · " .. eventResult end
    player:SetAttribute("HeistCarrying", false)
    SalonService.openCar(player, info, isNew, payout)
    SalonService.refresh(player) -- may have won a new accessory on delivery
    Tutorial.event(player,"delivered")
    Net.notify(player,("Доставлено! +%d монет · добыча на полках."):format(payout),"good")
end)

----------------------------------------------------------------------
-- ВРЕМЕННО (тест): плашки на экране и быстрая ходьба в Studio
----------------------------------------------------------------------
local function makeLabel(gui, y, height)
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromOffset(340, height)
	label.Position = UDim2.fromOffset(10, y)
	label.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
	label.BackgroundTransparency = 0.3
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextSize = 20
	label.Font = Enum.Font.GothamBold
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Text = ""
	label.Parent = gui
	return label
end

local function setupDebug(player)
	if RunService:IsStudio() then
		local function apply(char)
			local hum = char:WaitForChild("Humanoid")
			hum.WalkSpeed = 50
		end
		player.CharacterAdded:Connect(apply)
		if player.Character then
			task.spawn(apply, player.Character)
		end
	end

	task.spawn(function()
		local gui = Instance.new("ScreenGui");gui.AutoLocalize=false
		gui.Name = "TrackDebug"
		gui.ResetOnSpawn = false
		local label = makeLabel(gui, 190, 90)
		gui.Parent = player:WaitForChild("PlayerGui")

		while player.Parent do
			local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			if hrp then
				local x = hrp.Position.X
				local idx = Layout.indexAt(x)
				local name = idx == 0 and "Зона салонов" or Districts[idx].name
				local list = DistrictManager.getLoadedIndices()
				label.Text = ("Район: %s\nЗагружены: %s\nX: %d"):format(
					name, #list &gt; 0 and table.concat(list, ", ") or "-", math.floor(x))
			end
			task.wait(0.3)
		end
	end)
end

local function setupStats(player)
	print("[Steal60] Жду данные игрока " .. player.Name)
	DataService.onLoaded(player, function(data)
        print("[Steal60] Данные загружены: " .. player.Name .. ", деньги = " .. data.money)
        if data.botUnlocked ~= true and next(data.catalog or {}) == nil then
            task.delay(5,function()
                if player.Parent and not player:GetAttribute("HelperUnlocked") then
                    Net.notify(player,"Следуй стрелке к первой машине: ВЗЛОМ 1+.","info")
                end
            end)
        end
		if player:FindFirstChild("leaderstats") then
			return
		end

		local stats = Instance.new("Folder")
		stats.Name = "leaderstats"
		local hack = Instance.new("IntValue")
		hack.Name = "Взлом"
		hack:SetAttribute('Steal60StatId','hacking')
		hack.Parent = stats
        local money=Instance.new("IntValue")
        money.Name="Деньги"
        money:SetAttribute('Steal60StatId','money');money.Parent=stats
        local gems=Instance.new("IntValue")
        gems.Name="Алмазы"
        gems:SetAttribute('Steal60StatId','diamonds');gems.Parent=stats
		stats.Parent = player

        while player.Parent do
            hack.Value = data.hackLevel
            money.Value=math.floor(data.money)
            gems.Value=math.floor(data.diamonds or 0)
            task.wait(1)
        end
	end)
end

local function onPlayer(player)
    if #Players:GetPlayers() &gt; 8 then
        player:Kick("Сервер рассчитан на 8 игроков. Попробуй другой сервер.")
        return
    end
    task.spawn(giveClient, player)
	setupStats(player)
    -- Beginning on foot: players run to the guaranteed tutorial car in the first district.
    local function giveRunSpeed(character)
        local humanoid = character:WaitForChild("Humanoid", 8)
        if humanoid then humanoid.WalkSpeed = 23 end
    end
    player.CharacterAdded:Connect(giveRunSpeed)
    if player.Character then task.spawn(giveRunSpeed, player.Character) end
	-- Cinematic edition: legacy studio debug boxes disabled; RouteHUD shows district and route progress.
end

Players.PlayerAdded:Connect(onPlayer)
for _, player in ipairs(Players:GetPlayers()) do
	onPlayer(player)
end
</ProtectedString>
        </Properties>
      </Item>
    </Item>
    <Item class="StringValue" referent="RBX1001">
      <Properties>
        <string name="Name">CarPackInfo</string>
        <string name="Value">Steal60 Stylized Realism v4: 150 original unbranded collectible cars, five gameplay tiers. Specialized roof profiles, glass, body contours, wheels with 8-12 metallic spokes, brake calipers, front DRLs, rear LEDs, cabin, bumpers, side aero, wings. Native Roblox Part geometry (not MeshPart). Built dynamically when cars spawn during Play. 12 legacy catalog IDs preserved. No external assets needed. High-detail mode; cap streaming for performance. This file is not a photorealistic 3D model pack.</string>
      </Properties>
    </Item>
  <Item class="StringValue" referent="RBX1002"><Properties><string name="Name">InstallationNotes</string><string name="Value">Steal60 v65 — проверка безопасности и надёжности сохранений.
ОДИН полный установочный файл Steal60_v65.rbxmx, русский/английский переключатель ru/en и прежняя музыка сохранены.

УСТАНОВКА
На странице файла в GitHub нажмите ↓ Download raw file. ZIP не нужен.
Остановите Play. Сохраните копию своего проекта. Замените старый установочный пакет в Workspace через Insert from File на Steal60_v65.rbxmx. Оставьте один установщик.
После Play в Output должны появиться [Steal60 v65] и [Steal60] Main запущен.
Если вы уже настроили настоящие Developer Product/Game Pass ID в своей копии MonetizationConfig, перенесите их в новый пакет перед запуском. В поставляемой конфигурации assetId по-прежнему 0: без реальных ID магазин не принимает реальные платежи.

ЧТО ИСПРАВЛЕНО
1. Сервер принимает команды действий, а цены, владение, требуемый уровень, награды, XP, кассу, алмазы и результаты взлома рассчитывает сам. Клиентского запроса «выдать деньги» или «записать профиль» нет.
2. Единая защита всех серверных RemoteEvent/RemoteFunction обработчиков: допустимые типы/длины/число аргументов, конечные числа, диапазоны управления, частотные ограничения по игроку и команде. GetMenuData/GetSeasonTop тоже ограничены. Неизвестные команды результатов не начисляют наград.
3. Сервер проверяет время удержания ProximityPrompt, расстояние, живого персонажа, готовность профиля, отмену и непрерывное пребывание рядом. Простое принудительное Triggered больше не обходит удержание. В каждый момент учитывается одно удержание игрока.
4. Сервер контролирует перемещение персонажа и машин, владельца, водителя, поколение машины и скорость. Проверка машины вызывается непосредственно перед доставкой, независимо от порядка Heartbeat. Мгновенная доставка телепортом не проходит; проверяются минимальная длительность пути, личная парковка и остановка. Обычная плавная физика водителя сохранена для производительности.
5. Профиль хранится только в Roblox DataStore. Каждая сессия получает уникальный токен, не зависящий от JobId. Запись требует своего токена и корректной ревизии. Старый сервер не может перезаписать новую сессию после истечения аренды. Блокировка обновляется при сохранениях; при длительной невозможности подтвердить сессию действия блокируются и игроку предлагается перезайти.
6. Автосохранение каждые 30 секунд. Изменения денег и ключевые действия дополнительно планируют объединённую запись примерно через 6 секунд; бесплатные переключения внешности не создают запись на каждый клик. Платные косметические покупки/VIP и Robux-чеки используют немедленную запись. Есть повторные попытки с увеличением задержки при сбоях DataStore.
7. Две чередующиеся резервные записи в отдельном серверном DataStore с ревизиями. При повреждении/отсутствии основного профиля выбирается самая новая корректная резервная запись. Существующее повреждённое сохранение без подходящей резервной копии не заменяется нулевым. Ошибка чтения также не считается новым игроком.
8. Выход игрока сохраняет данные и освобождает токен. Неудачная запись не удаляет профиль из памяти: сервер повторяет её. Выход во время первоначальной загрузки тоже освобождает полученную сессию. При штатном закрытии сервера финальные сохранения выполняются параллельно, с общим пределом ожидания 25 секунд. Временные Studio-профили не удерживают остановку сервера.
9. Robux-алмазы выдаются только через серверный MarketplaceService.ProcessReceipt с известным Product ID. PurchaseId сохраняется в профиле; повторные вызовы и потерянные ответы записи не дают повторную награду. PurchaseGranted возвращается после подтверждения основной и резервной записи. Свежий игровой профиль не заменяется старым снимком после обработки чека. Покупка пасса дополнительно проверяет владение через Roblox API.
10. Возврат денег при неудачной косметической покупке возвращает только сумму этой покупки, сохраняя параллельно заработанные монеты и полученные по чеку алмазы.
11. Для краж между игроками добавлен долговечный журнал списания и идемпотентный входящий перевод: повторная попытка или переподключение не выплачивает награду дважды. Личный cooldown и защита кассы цели сохраняются. Счётчик краж и процентный бонус награды учитываются на сервере. Сохраняется прежний предел потери кассы при PvP; полицейский штраф отдельно остаётся 5% кассы без потолка 2500.
12. В сезонный рейтинг уходит сохранённый сервером валовой заработок. Расходы, штрафы и перевод денег из кассы в кошелёк не уменьшают и не удваивают его.
13. Автоматическая выдача тестовых алмазов ограничена Studio. На опубликованных серверах новый бесплатный грант не выдаётся, даже аккаунту разработчика. Уже имеющиеся алмазы и покупки сохраняются.

СОВМЕСТИМОСТЬ
Нового сброса прогресса нет. Live-хранилище Steal60_PlayerData_v1, Studio-хранилище Steal60_PlayerData_Studio_v62 и прежний одноразовый маркер studioFreshStartV62 сохранены. Прежнее правило отдельного тестового сброса v62 не расширено. Уровень/XP взлома, существующие алмазы, покупки, предметы, машины, внешность и язык не удаляются.
Новые резервные хранилища: &lt;имя основного DataStore&gt;_Recovery_v65. Они независимы для Studio и опубликованной игры. Первая резервная запись появляется после успешного сохранения v65; отсутствующую историю резервов за старые версии восстановить задним числом нельзя.
Экономические цены/шансы, 150 машин, одновременно устанавливаемый тюнинг, оформление, NPC, музыка, эффект ноты и переключатель языка сохранены.

ПРОВЕРКИ СБОРКИ
100 скриптов окончательного XML компилируются. 43 группы проверок в макетах Roblox API прошли.
Новые проверки включают 53 сценария надёжного профиля, 135 проверок входящих команд/перемещения/удержания и 33 проверки настоящего DataService вместе с реальными ProfileStore и MonetizationService. Проверены повторные/неопределённые платежи, смена владельца сессии, одновременные покупки и заработок, повреждённые профили, резервное восстановление, сбой на выходе, выход в процессе загрузки, повторный вход, периодическое сохранение, штатное закрытие и PvP-переводы.
Дополнительно проверена доставка, включая проверку телепорта в том же кадре до Heartbeat, а также прежние механики, UI, запуск настоящего дерева модулей и всех восьми клиентских скриптов, все районы, 694 переводимых текста и музыка.
Roblox Studio/Engine здесь недоступна. Это проверки кода и макетов API, а не запуск настоящего сервера Roblox или замер FPS/задержек.

ПЕРЕД ПУБЛИЧНЫМ РЕЛИЗОМ
В приватной опубликованной игре с двумя аккаунтами:
- Настройте реальные Developer Product ID/Game Pass ID и фактические цены в Creator Hub. Для магазина из конфигурации рекомендовано 1500 алмазов за 500 Robux; реальная цена задаётся в Roblox, а не только текстом меню.
- Проверьте небольшой настоящий платёж: правильный пакет алмазов, сохранение после повторного входа, отсутствие повторной выдачи. Studio-имитация платежа этого не подтверждает.
- Заработайте/потратьте монеты, улучшите предмет, смените язык и витрину. Подождите не менее 35 секунд, выйдите и войдите. Сравните кассу, кошелёк, XP, покупки и настройки.
- Проверьте обычное закрытие тестового сервера и повторный вход на новый сервер. Проверьте кражу между двумя игроками, награду и cooldown после переподключения.
- На планшете и компьютере проверьте обычный бег/прыжки, все удержания, взлом, посадку, езду, доставку после выхода из машины, арест и возврат автомобиля. При слабой сети посмотрите, нет ли ошибочных возвратов позиции; защита не использует автоматические баны.
- Проверьте Output, максимальное число игроков 8, доступность музыкальных/аватарных assets и права на их использование в этом experience.
Studio Access to API Services требуется только для постоянных данных во время Studio-теста; Studio использует отдельное хранилище. При недоступных API тестовый профиль временный, о чём пишет Output. Это не подтверждение работы опубликованных сохранений.

ОГРАНИЧЕНИЯ
Нельзя обещать абсолютную защиту от всех эксплойтов или нулевую потерю ещё не записанных изменений при аварийном завершении процесса/сбое Roblox. Последний подтверждённый основной/резервный снимок сохраняется; небольшое окно между записями остаётся. Резерв в другом DataStore не является независимым от Roblox провайдером. Автоматизацию правильных действий и ботов одними серверными проверками полностью исключить нельзя. Не публикуйте игру как проверенную в реальном Engine до завершения приватного теста выше.

English: one full installer with ru/en. This release adds server command validation, rate limits, prompt-hold and movement checks, fenced DataStore sessions, rotating recovery records, bounded autosave/exit retries, idempotent Marketplace receipts and PvP transfers. Existing progression and economic settings are preserved. Run the private published-game save/payment/device checks before release; real Roblox Engine testing was not available here.
