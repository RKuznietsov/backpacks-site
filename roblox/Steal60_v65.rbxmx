     else reason='unreadable_profile';return nil end
    end
    if not validRecord(current)then reason='invalid_profile';return nil end
    self:_merge(current.data,current)
    current.format=65;current.lock={jobId=game.JobId,token=token,time=os.time()}
    return current
   end)
  end,deadline)
  if ok and record and record.lock and record.lock.token==token then
   state.revision=record.revision or 0;state.lastSuccess=os.clock();state.previousSeen=record.data.lastSeen or 0
   self:_health(player,'loaded');return copy(record.data)
  end
  if needRecovery then backup,readable=self:_recover(key);inspected=true
  elseif reason=='busy'and player.Parent and os.clock()&lt;deadline then task.wait(.8)
