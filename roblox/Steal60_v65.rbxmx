-- V51 sculpted companions. Major features are modelled at gameplay scale.
-- Animation pivots move whole paws/tails/wings, including their decorations.
local function atelier(m,id,col)
 local cream=C(255,240,207)
 local ink=C(26,35,61)
 local gold=C(244,190,75)
 local mint=C(100,236,215)
 local activeGroup=nil
 local function P(name,size,cf,c,shape,mat,kind)
  local p=Instance.new(kind or 'Part');p.Name=name;p.Size=size;p.CFrame=cf;p.Color=c
  if p:IsA('Part')then visualShape(p,shape) end;p.Material=mat or Enum.Material.SmoothPlastic
  p.TopSurface=Enum.SurfaceType.Smooth;p.BottomSurface=Enum.SurfaceType.Smooth
  p.Anchored=true;p.Massless=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.CastShadow=true
  if activeGroup then p:SetAttribute('PetMotionGroup',activeGroup) end
  p.Parent=m;return p
 end
 local function O(n,x,y,z,sx,sy,sz,c,mat,rot)
  return P(n,Vector3.new(sx,sy,sz),CFrame.new(x,y,z)*(rot or CFrame.new()),c,Enum.PartType.Ball,mat)
 end
 local function B(n,x,y,z,sx,sy,sz,c,rot,mat)
  return P(n,Vector3.new(sx,sy,sz),CFrame.new(x,y,z)*(rot or CFrame.new()),c,nil,mat)
 end
 local function W(n,x,y,z,sx,sy,sz,c,rot)
  return P(n,Vector3.new(sx,sy,sz),CFrame.new(x,y,z)*(rot or CFrame.new()),c,nil,nil,'WedgePart')
 end
 local function motion(n,kind,x,y,z,side,fn)
  local p=B(n,x,y,z,.05,.05,.05,ink);p.Transparency=1
  p:SetAttribute('PetMotionPivot',true);p:SetAttribute('PetAnimationKind',kind);p:SetAttribute('PetAnimationSide',side)
  local prev=activeGroup;activeGroup=n;fn();activeGroup=prev
 end
 local function eye(x,y,z,s,iris)
  local layer=O('EyeSocket',x,y,z,.45*s,.55*s,.17*s,ink)
  layer:SetAttribute('PetBlinkOpen',true);layer:SetAttribute('PetBlinkBaseTransparency',0)
  local layer=O('IvoryEye',x,y+.018*s,z-.055*s,.36*s,.43*s,.15*s,cream)
  layer:SetAttribute('PetBlinkOpen',true);layer:SetAttribute('PetBlinkBaseTransparency',0)
  local layer=O('JewelIris',x+.022*s,y-.012*s,z-.140*s,.255*s,.34*s,.09*s,iris)
  layer:SetAttribute('PetBlinkOpen',true);layer:SetAttribute('PetBlinkBaseTransparency',0)
  local layer=O('Pupil',x+.024*s,y,z-.188*s,.15*s,.24*s,.055*s,ink)
  layer:SetAttribute('PetBlinkOpen',true);layer:SetAttribute('PetBlinkBaseTransparency',0)
  local layer=O('CatchLight',x-.050*s,y+.103*s,z-.220*s,.092*s,.106*s,.036*s,C(255,255,250),Enum.Material.Neon)
  layer:SetAttribute('PetBlinkOpen',true);layer:SetAttribute('PetBlinkBaseTransparency',0)
  local layer=O('TinyCatchLight',x+.075*s,y-.07*s,z-.217*s,.043*s,.045*s,.029*s,C(255,255,250),Enum.Material.Neon)
  layer:SetAttribute('PetBlinkOpen',true);layer:SetAttribute('PetBlinkBaseTransparency',0)
  local lid=O('ClosedEye',x,y,z-.24*s,.37*s,.055*s,.055*s,ink);lid.Transparency=1;lid:SetAttribute('PetBlinkLid',true)
 end
 local function jewel(n,x,y,z,s,c)
  O(n..'Setting',x,y,z,s*1.24,s*1.24,.13,gold,Enum.Material.Metal)
  W(n..'Upper',x,y+s*.12,z-.07,s*.68,s*.68,.15,c,CFrame.Angles(0,math.pi/2,0))
  W(n..'Lower',x,y-s*.12,z-.07,s*.68,s*.68,.15,c,CFrame.Angles(0,math.pi/2,math.pi))
  O(n..'Shine',x-s*.09,y+s*.12,z-.16,s*.12,s*.23,.025,cream)
 end
 local function paws(bodyColor,tipColor)
  for _,side in ipairs({-1,1})do for i,z in ipairs({-.30,.63})do
   local x=side*.46
   motion('Paw_'..side..'_'..i,i==1 and 'walkFront' or 'walkBack',x,-.30,z,side,function()
    O('PlushLeg',x,-.51,z,.40,.55,.42,bodyColor)
    O('RoundPaw',x,-.76,z-.10,.46,.32,.53,tipColor)
    for j=-1,1 do O('PawToe',x+j*.10,-.79,z-.33,.085,.10,.065,cream)end
   end)
  end end
 end
 if id=='pet_fox' or id=='pet_cat' or id=='pet_dog' then
  local fox=id=='pet_fox';local cat=id=='pet_cat';local dog=id=='pet_dog'
  local fur=fox and C(241,146,62)or cat and C(153,134,235)or C(209,163,102)
  local shadow=fur:Lerp(ink,.18)
  O('PearBody',0,-.15,.37,1.24,1.05,1.29,shadow)
  O('FullChest',0,-.23,-.19,.83,.84,.42,cream)
  paws(fur,fox and C(105,64,58)or cream)
  motion('HeadPose','head',0,.25,-.26,1,function()
  O('SculptedHead',0,.58,-.26,1.63,1.43,1.31,fur)
  for _,s in ipairs({-1,1})do
   O('FluffyCheek',s*.59,.22,-.71,.62,.53,.49,cream)
   W('CheekTuft',s*.76,.22,-.53,.19,.46,.49,fur,CFrame.Angles(0,0,-s*.45))
   eye(s*.37,.64,-.87,1.0,fox and C(72,182,170)or cat and C(103,230,195)or C(93,171,224))
   O('SoftBlush',s*.62,.28,-.96,.19,.105,.055,C(244,153,152))
   if not dog then
    local ear=CFrame.new(s*.56,1.28,-.16)*CFrame.Angles(0,0,-s*.18)
    for _,half in ipairs({-1,1})do
     P('PointedEar',Vector3.new(.27,.91,.33),ear*CFrame.new(half*.165,0,0)*CFrame.Angles(0,-half*math.pi/2,0),shadow,nil,nil,'WedgePart')
     P('VelvetInnerEar',Vector3.new(.05,.61,.21),ear*CFrame.new(half*.105,-.025,-.155)*CFrame.Angles(0,-half*math.pi/2,0),C(255,186,183),nil,nil,'WedgePart')
    end
   else
    O('FoldedEar',s*.76,.72,-.05,.40,1.03,.51,C(136,87,66),nil,CFrame.Angles(0,0,-s*.23))
    O('EarTip',s*.83,.29,-.13,.31,.42,.40,C(155,103,74))
   end
  end
  for i=-1,1 do
   O('ForeheadTuft',i*.17,1.20,-.45,.26,.35,.32,i==0 and cream or fur,nil,CFrame.Angles(0,0,-i*.23))
  end
  O('MuzzleLeft',-.18,.20,-.96,.43,.32,.30,cream)
  O('MuzzleRight',.18,.20,-.96,.43,.32,.30,cream)
  O('ButtonNose',0,.29,-1.135,.21,.15,.13,cat and C(236,128,161)or ink)
  for _,s in ipairs({-1,1})do O('Smile',s*.075,.105,-1.105,.17,.045,.045,C(127,74,75),nil,CFrame.Angles(0,0,s*.25))end
  if dog then O('HappyTongue',0,-.005,-1.08,.18,.22,.075,C(247,128,163))end
  end)
  O('Collar',0,-.10,-.29,1.13,.18,.85,ink)
  jewel('CompanionMedallion',0,-.18,-.78,.24,fox and mint or C(255,199,95))
  if fox then
   motion('FoxTail','tail',.18,-.13,.87,1,function()
    O('FoxTailBase',.32,-.01,1.23,.57,.62,1.15,fur,nil,CFrame.Angles(-.14,.20,0))
    O('FoxTailCurve',.53,.13,1.65,.46,.52,.76,fur,nil,CFrame.Angles(-.20,.14,0))
    O('IvoryTailTip',.59,.22,1.91,.39,.44,.47,cream,nil,CFrame.Angles(-.22,.10,0))
   end)
  elseif cat then
   motion('CrescentTail','tail',.42,-.20,.88,1,function()
    local p0=Vector3.new(.42,-.20,.88);local p1=Vector3.new(1.05,-.08,1.30)
    local p2=Vector3.new(.99,1.15,1.10);local p3=Vector3.new(.40,1.12,1.03)
    for i=0,13 do
     local t=i/13;local u=1-t
     local p=p0*u^3+p1*(3*u*u*t)+p2*(3*u*t*t)+p3*t^3
     local diameter=.34-.085*t
     O('ConnectedCatTail_'..i,p.X,p.Y,p.Z,diameter,diameter,diameter,t&gt;.76 and cream or fur)
    end
   end)
   for _,s in ipairs({-1,1})do for j=1,2 do
    B('FineWhisker',s*.66,.16-j*.085,-1.0,.39,.025,.025,cream,CFrame.Angles(0,0,s*(.11-j*.13)))
   end end
  else
   motion('HappyTail','tail',0,-.15,1,1,function()
    O('CurledTail',.22,.17,1.18,.35,.62,.59,fur,nil,CFrame.Angles(-.35,0,-.4))
    O('CreamTailTip',.35,.45,1.08,.29,.31,.37,cream)
   end)
   -- Goggles share the head pose instead of floating as the dog looks around.
   activeGroup='HeadPose'
   for _,s in ipairs({-1,1})do
    O('AviatorRim',s*.33,1.10,-.76,.47,.34,.17,gold,Enum.Material.Metal)
    O('AviatorLens',s*.33,1.10,-.86,.33,.23,.09,C(82,180,206),Enum.Material.Glass)
   end
   activeGroup=nil
  end
 elseif id=='pet_turtle' then
  local green=C(143,220,158);local light=C(245,231,166)
  O('TurtleBody',0,-.17,.20,1.51,.54,1.47,green)
  O('SoftPlastron',0,-.31,.19,1.32,.23,1.37,light)
  O('ShellBorder',0,-.015,.30,1.97,.23,1.77,C(188,238,155))
