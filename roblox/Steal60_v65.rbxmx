     O('DuctGuard',x+math.cos(a)*.39,.08,z+math.sin(a)*.39,.18,.12,.18,C(148,227,234),Enum.Material.Metal)
    end
    motion('Rotor'..s..'_'..z,'rotor',x,.13,z,s*(z&lt;0 and -1 or 1),function()
     B('Propeller',x,.15,z,.70,.035,.11,ink)
