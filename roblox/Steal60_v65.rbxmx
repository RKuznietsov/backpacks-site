        <Item class="ModuleScript" referent="RBX_STEAL60_V51_CarVisualLibrary"><Properties><string name="Name">CarVisualLibrary</string><ProtectedString name="Source">-- Steal60 • Stylized Realism garage / 2026
-- 150 original, unbranded, collectible cars. No external mesh asset IDs.
-- Hand-shaped native Roblox geometry: readable silhouettes, sloping greenhouses,
-- individual doors, aerodynamic surfaces, wheel spokes, LEDs and brake hardware.
-- Model origin = center at pavement level; vehicle forward axis = +X.
-- ALL beauty parts are non-collidable and massless; invisible Body is the physics rig.
local V = {}

local C = {
    dark = Color3.fromRGB(19,23,30), tyre = Color3.fromRGB(22,24,27),
    rubber = Color3.fromRGB(40,43,46), line = Color3.fromRGB(32,40,49),
    glass = Color3.fromRGB(45,80,101), glass2 = Color3.fromRGB(65,113,136),
    rim = Color3.fromRGB(178,185,191), spoke = Color3.fromRGB(136,149,164),
    chrome = Color3.fromRGB(205,212,212), white = Color3.fromRGB(245,248,255),
    red = Color3.fromRGB(234,43,57), orange = Color3.fromRGB(255,152,62),
    seat = Color3.fromRGB(29,35,43), paint = Color3.fromRGB(151,180,195),
    brake = Color3.fromRGB(225,75,35), bronze = Color3.fromRGB(178,142,84),
}
local M = Enum.Material
local E = {
    micro={9.2,5.05,1.55,1.80,1.42,.49,-.10},classic={11.3,5.75,1.62,1.65,1.60,.42,-.09},
    van={11.7,5.8,2.05,2.35,1.68,.69,-.01},wagon={11.8,5.65,1.69,1.82,1.65,.60,-.06},
    pickup={12.8,5.95,2.05,1.73,1.96,.36,.18},liftback={10.4,5.50,1.62,1.55,1.55,.51,-.13},
    sedan={11.7,5.75,1.65,1.65,1.73,.46,-.055},crossover={11.6,6.10,2.15,1.83,2.02,.53,-.03},
    hatch={10.3,5.73,1.65,1.77,1.77,.53,-.07},minivan={13.0,6.18,2.05,2.17,1.92,.71,-.02},
    suv={12.2,6.25,2.22,1.98,2.14,.59,-.05},muscle={12.8,6.28,1.67,1.36,1.92,.39,-.16},
    coupe={11.8,6.15,1.52,1.33,1.82,.41,-.095},roadster={10.6,5.95,1.42,1.0,1.66,.35,-.10},
    gt={12.4,6.10,1.58,1.40,1.91,.45,-.075},fullsuv={13.7,6.77,2.46,2.10,2.29,.61,-.055},
    executive={13.6,6.30,1.82,1.73,1.95,.51,-.05},limo={14.9,6.40,1.88,1.85,1.97,.58,-.045},
    offroad={12.9,6.35,2.48,2.18,2.43,.50,-.045},grandwagon={13.0,6.22,1.85,1.70,2.01,.59,-.07},
    grandgt={13.4,6.35,1.71,1.46,2.04,.44,-.12},hyper={12.6,6.67,1.30,1.00,1.91,.31,-.045},
    supergt={12.5,6.65,1.40,1.10,1.99,.36,-.055},track={12.8,6.80,1.28,.92,2.04,.30,-.045},
    ev={12.4,6.38,1.32,1.12,1.93,.41,-.01},widebody={12.8,6.93,1.33,1.12,2.08,.36,-.085},
    speedster={12.0,6.45,1.33,.96,1.95,.31,-.015},
}
local sports={muscle=true,coupe=true,roadster=true,gt=true,grandgt=true}
local exotics={hyper=true,supergt=true,track=true,ev=true,widebody=true,speedster=true}
local squared={van=true,pickup=true,minivan=true,offroad=true,fullsuv=true,suv=true}
local function part(model,n,sz,cf,col,material,shape,paint)
    local obj = Instance.new(shape or 'Part')
    obj.Name=n
    obj.Size=sz
    obj.CFrame=cf
    obj.Color=col or C.paint
    obj.Material=material or M.SmoothPlastic
    obj.TopSurface=Enum.SurfaceType.Smooth
    obj.BottomSurface=Enum.SurfaceType.Smooth
    obj.Anchored=true
    obj.CanCollide=false
    obj.CanTouch=false
    obj.CanQuery=false
    obj.Massless=true
    obj.CastShadow=not (material==M.Neon)
    if paint then obj:SetAttribute('Paintable',true) end
    obj.Parent=model
    return obj
end
local function b(m,n,sx,sy,sz,x,y,z,c,mat,paint)
    return part(m,n,Vector3.new(sx,sy,sz),CFrame.new(x,y,z),c,mat,nil,paint)
end
local function ang(m,n,sx,sy,sz,x,y,z,rotation,c,mat,paint)
    return part(m,n,Vector3.new(sx,sy,sz),CFrame.new(x,y,z)*CFrame.Angles(0,0,rotation),c,mat,nil,paint)
end
local function slope(m,n,sx,sy,sz,x,y,z,rotation,c,mat,paint)
    return part(m,n,Vector3.new(sx,sy,sz),CFrame.new(x,y,z)*CFrame.Angles(0,0,rotation),c,mat,'WedgePart',paint)
end
local function ball(m,n,sx,sy,sz,x,y,z,c,mat,paint)
    local o=b(m,n,sx,sy,sz,x,y,z,c,mat,paint);o.Shape=Enum.PartType.Ball;return o
end
local function disk(m,n,rad,depth,x,y,z,c,mat)
    local o=part(m,n,Vector3.new(depth,rad*2,rad*2),CFrame.new(x,y,z)*CFrame.Angles(0,math.pi/2,0),c,mat)
    o.Shape=Enum.PartType.Cylinder
    return o
end
local function rod(m,n,xa,ya,za,xb,yb,zb,thickness,c,mat,paint)
    -- A thin part between two 3D points (all custom-made borders, pillars and spokes).
    local a=Vector3.new(xa,ya,za); local z=Vector3.new(xb,yb,zb)
    local len=(z-a).Magnitude
    if len&lt;.015 then return nil end
    local mid=(a+z)*.5
    local direction=(z-a).Unit
    local up=math.abs(direction:Dot(Vector3.yAxis))&gt;.98 and Vector3.xAxis or Vector3.yAxis
    local cf=CFrame.lookAt(mid,z,up)
    return part(m,n,Vector3.new(thickness,thickness,len),cf,c,mat,nil,paint)
end
local function wheel(m,x,z,d,style,cls,index)
    local s=z&lt;0 and -1 or 1
    local y=d*.51;local r=d*.50
    local outer=z+s*.17
    local face=outer+s*.22
    local rimCol=(cls=='super' and C.bronze) or (cls=='premium' and C.chrome) or C.spoke
    -- Black tyre is a true round silhouette rather than a square wheel.
    disk(m,'Tyre',r,.60,x,y,outer,C.tyre,M.SmoothPlastic)
    disk(m,'Sidewall',r*.82,.625,x,y,outer+s*.02,C.rubber,M.SmoothPlastic)
    disk(m,'AlloyOuterLip',r*.72,.645,x,y,outer+s*.03,C.chrome,M.Metal)
    disk(m,'RimInset',r*.64,.68,x,y,outer+s*.03,C.dark,M.Metal)
    disk(m,'BrakeRotor',r*.51,.72,x,y,outer+s*.035,C.rim,M.Metal)
    ball(m,'Caliper',.24,.43,.18,x-r*.52,y+r*.24,face,C.brake,M.Metal)
    local spokeCount= cls=='super' and 10 or cls=='premium' and 12 or (style=='retro' and 5 or 8)
    local aOffset=(index%3)*.055
    for i=1,spokeCount do
        local a=2*math.pi*i/spokeCount+aOffset
        local dx,dy=math.cos(a),math.sin(a)
        rod(m,'MachinedSpoke',x+dx*r*.14,y+dy*r*.14,face,
            x+dx*r*.61,y+dy*r*.61,face,.065,rimCol,M.Metal)
    end
    disk(m,'CenterCap',r*.145,.73,x,y,outer+s*.06,C.chrome,M.Metal)
    for i=1,5 do
        local a=2*math.pi*i/5
        ball(m,'Stud',.065,.065,.065,x+math.cos(a)*r*.24,y+math.sin(a)*r*.24,face+s*.04,C.dark,M.Metal)
    end
end
local function light(m,n,x,y,z,w,h,mat,c)
    b(m,n..'Housing',.20,h+.16,w+.11,x-.065,y,z,C.dark,M.Metal)
    b(m,n,.15,h,w,x+.035,y+.02,z,c,mat)
end
local function frontLights(m,face,L,W,H,fy,exotic)
    local x=L*.497
    local y=fy+H*.16
    if exotic then y=fy+H*.11 end
    if face=='bar' then
        b(m,'ContinuousDRL',.16,.09,W*.75,x,y+.05,0,C.white,M.Neon)
    end
    for _,s in ipairs({-1,1}) do
        local z=s*W*.333
        local ww=(exotic and W*.21 or W*.225)
        if face=='round' then
            ball(m,'RoundHeadlight',.29,.40,.55,x+.03,y,z,C.white,M.Neon)
            b(m,'RoundHeadlightRim',.11,.53,.66,x-.09,y,z,C.dark,M.Metal)
        elseif face=='pixel' then
            b(m,'LightMask',.13,.38,ww,x-.06,y,z,C.dark,M.Metal)
            for p=1,3 do
                b(m,'PixelDRL',.16,.12,.14,x+.03,y+.02,z+s*(p-2)*.18,C.white,M.Neon)
            end
        else
            light(m,'Headlamp',x,y,z,ww,(exotic or face=='slim' or face=='arrow' or face=='blade') and .16 or .26,M.Neon,C.white)
            if face=='dual' then
                light(m,'SecondaryLight',x,y,z-s*.42,.30,.19,M.Neon,C.white)
            elseif face=='blade' or face=='arrow' then
                ang(m,'AngledDRL',.12,.09,ww*.87,x+.10,y+.18,z,-s*.35,C.white,M.Neon)
            end
        end
        b(m,'AmberMarker',.13,.12,.24,L*.458,fy-H*.20,s*W*.468,C.orange,M.Neon)
    end
end
local function rearLights(m,feature,L,W,fy,H,exotic)
    local x=-L*.499
    local isBar=feature=='electric' or feature=='aero' or exotic
    if isBar then
        b(m,'RearLightBridge',.14,.11,W*.78,x,fy+H*.19,0,C.red,M.Neon)
    end
    for _,s in ipairs({-1,1}) do
        b(m,'TaillampFrame',.19,.33,W*.235,x+.01,fy+H*.17,s*W*.342,C.dark,M.Metal)
        b(m,'Taillamp',.20,.16,W*.195,x-.03,fy+H*.25,s*W*.342,C.red,M.Neon)
        b(m,'ReverseLamps',.17,.09,W*.10,x-.05,fy+H*.07,s*W*.28,C.white,M.Neon)
    end
end
local function aero(m,L,W,H,bodyTop,d,feat,exotic)
    if exotic then
        for _,s in ipairs({-1,1}) do
            -- Distinct tapered air tunnels; contrasts with bright painted body.
            ang(m,'SideIntake',L*.19,H*.33,.16,-L*.11,bodyTop-H*.32,s*W*.47,-.18,C.dark,M.Metal)
            ang(m,'DiffuserFin',L*.20,.18,.11,-L*.46,d*.36,s*W*.31,s*.13,C.dark,M.Metal)
            slope(m,'FrontSplitterCorner',L*.21,.18,W*.19,L*.43,d*.44,s*W*.34,0,C.dark,M.Metal)
        end
        b(m,'CarbonFrontSplitter',L*.24,.13,W*.82,L*.44,d*.37,0,C.dark,M.Metal)
        b(m,'RearDiffuser',L*.12,.26,W*.73,-L*.49,d*.38,0,C.dark,M.Metal)
    end
    if feat=='spoiler' or feat=='wing' or feat=='aero' then
        local wh=feat=='wing' and .72 or .35
        for _,s in ipairs({-1,1}) do
            b(m,'WingStanchion',.14,wh,.18,-L*.43,bodyTop+wh*.37,s*W*.28,C.dark,M.Metal)
        end
        ang(m,'AeroWing',.68,.12,W*.83,-L*.42,bodyTop+wh,0,-.09,C.dark,M.Metal)
        for _,s in ipairs({-1,1}) do
            b(m,'WingEndPlate',.44,.27,.10,-L*.42,bodyTop+wh,s*W*.415,C.dark,M.Metal)
        end
    elseif feat=='touring' or feat=='offroad' then
        for _,s in ipairs({-1,1}) do
            b(m,'RoofRail',L*.41,.15,.13,-L*.04,bodyTop+.95,s*W*.31,C.dark,M.Metal)
        end
    end
    if feat=='muscle' or feat=='tuner' then
        for _,s in ipairs({-1,1}) do
            ang(m,'HoodExtractor',L*.14,.10,W*.14,L*.22,bodyTop+.02,s*W*.21,-.035,C.dark,M.Metal)
            b(m,'DoubleExhaust',.29,.18,.27,-L*.49,d*.37,s*W*.32,C.chrome,M.Metal)
        end
    end
end
function V.build(car,cls)
    local shape=car.shape or 'sedan'
    local base=E[shape] or E.sedan
    local L,W,H,ch,d,canRatio,canShift=table.unpack(base)
    L=L*(car.scale or 1); W=W*(car.widthScale or 1); H=H*(car.scale or 1)
    ch=ch*(car.roofScale or 1); d=d*(car.wheelScale or 1)
    canRatio=canRatio*(car.roofScale or 1)
    canShift=canShift+(car.cabinShift or 0)
    local extreme=exotics[shape] == true
    local sporty=sports[shape] == true or extreme
    local flat=squared[shape] == true
    local cabX=L*canShift
    local cabLen=math.min(L*.74,L*canRatio)
    local frontA=cabX+cabLen*.51
    local rearA=cabX-cabLen*.51
    local frontAxle=L*(shape=='micro' and .316 or shape=='limo' and .374 or .337)
    local rearAxle=-frontAxle
    local baseY=d*.55
    local bodyY=baseY+H*.45
    local topY=baseY+H*.88
    local roofY=topY+ch*(extreme and .72 or flat and .93 or .82)
    local cabWidth=W*(extreme and .60 or flat and .79 or .72)
    local cabinFrontX=frontA-(extreme and .20 or .03)
    local cabinRearX=rearA+(extreme and .13 or .02)
    local roofLen=cabLen*(extreme and .67 or flat and .84 or .75)
    local roofStart=cabX+roofLen*.50
    local roofEnd=cabX-roofLen*.50
    local frontRise=roofY-topY
    local m=Instance.new('Model')
    m.Name=car.name or "Автомобиль"
    m:SetAttribute('DesignLength',L);m:SetAttribute('DesignWidth',W);m:SetAttribute('DesignShape',shape)
    local idx=#(car.id or '')
    local paint=C.paint
    -- Invisible physics; this preserves the original arcade handling, collision and hack prompt.
    local phys=b(m,'Body',L*.84,H*.73,W*.73,0,bodyY-.10,0,C.dark)
    phys.Transparency=1;phys.CanCollide=false;phys.CanQuery=true;phys.Massless=false
    local ground=b(m,'GroundCollider',L*.70,d*.42,W*.59,0,d*.205,0,C.dark)
    ground.Transparency=1;ground.CanCollide=false;ground.Massless=false
    -- The running gear, black waist shadow, and main tapered body shape.
    b(m,'Underbody',L*.87,.22,W*.80,0,baseY-.16,0,C.dark)
    b(m,'BodyShell',L*.78,H*.57,W*.85,0,bodyY-.16,0,paint,nil,true)
    b(m,'UpperBelt',L*.77,H*.23,W*.87,-L*.01,topY-H*.13,0,paint,nil,true)
    -- Wheel arches appear attached to the wheel line, not as floating bars.
    for _,s in ipairs({-1,1}) do
        local z=s*W*.424
        b(m,'DoorLower',L*.38,H*.42,.11,0,baseY+H*.15,z,paint,nil,true)
        for _,ax in ipairs({frontAxle,rearAxle}) do
            ball(m,'WheelArch',d*1.18,d*.70,.30,ax,d*.88,s*W*.425,paint,nil,true)
            ball(m,'InnerWheelArch',d*1.02,d*.57,.32,ax,d*.77,s*W*.465,C.dark)
        end
        b(m,'PaintedSill',L*.41,.23,.27,-.06,baseY+.005,s*W*.452,paint,nil,true)
        b(m,'BlackSideSkirt',L*.45,.11,.23,-.06,baseY-.13,s*W*.455,C.dark,M.Metal)
    end
    -- Front wedge-shaped hood, muscular shoulders, nose and bumper.
    local hoodLen=math.clamp(L*.492-frontA,L*.18,L*.49)
    local hoodCX=frontA+hoodLen*.52
    local hoodY=topY-(extreme and H*.14 or H*.055)
    local hoodSlope=extreme and -.13 or sporty and -.08 or -.045
    ang(m,'HoodSurface',hoodLen,.15,W*.82,hoodCX,hoodY,0,hoodSlope,paint,nil,true)
    for _,s in ipairs({-1,1}) do
        local z=s*W*.358
        ang(m,'HoodContour',hoodLen*.81,.09,.17,hoodCX,hoodY+.105,z,hoodSlope,paint,nil,true)
        slope(m,'FenderNose',L*.10,H*.30,W*.18,L*.438,bodyY+.025,s*W*.345,0,paint,nil,true)
        ang(m,'FrontCornerBrow',L*.185,.19,.19,L*.384,topY-H*.18,s*W*.421,hoodSlope,paint,nil,true)
    end
    b(m,'NosePaint',L*.125,H*.36,W*.83,L*.445,bodyY-H*.13,0,paint,nil,true)
    b(m,'FrontBlackRecess',.15,H*(extreme and .30 or .24),W*.66,L*.505,bodyY-H*.22,0,C.dark,M.Metal)
    for _,s in ipairs({-1,1}) do
        b(m,'CornerDuct',.16,H*.23,W*.17,L*.510,bodyY-H*.27,s*W*.345,C.dark,M.Metal)
        b(m,'CornerBlade',.17,.075,W*.17,L*.524,bodyY-H*.105,s*W*.347,paint,nil,true)
    end
    -- Distinct rear shape and rear deck.
    local deckLen=math.max(L*.12,rearA+L*.49)
    if shape~='pickup' then
        ang(m,'TailDeck',deckLen,.15,W*.84,rearA-deckLen*.47,topY-.085,0,.035,paint,nil,true)
    end
    b(m,'RearQuarter',L*.14,H*.40,W*.84,-L*.434,bodyY-.10,0,paint,nil,true)
    b(m,'RearBumperBlack',.15,H*.24,W*.77,-L*.506,bodyY-H*.33,0,C.dark,M.Metal)
    -- Roof and greenhouse: slim sloping glass, narrower than body, not a cube.
    if shape=='roadster' or shape=='speedster' then
        b(m,'OpenCabin',cabLen*.83,.10,cabWidth*.88,cabX,topY+.02,0,C.dark,M.Metal)
        for _,s in ipairs({-1,1}) do
            b(m,'SeatCushion',.76,.25,.70,cabX-.23,topY+.18,s*cabWidth*.23,C.seat)
            b(m,'BucketBack',.24,.74,.72,cabX-.66,topY+.48,s*cabWidth*.23,C.seat)
            ball(m,'RollOverBar',.26,.61,.23,cabX-.89,topY+.89,s*cabWidth*.22,C.chrome,M.Metal)
        end
    else
        b(m,'RoofPanel',roofLen,.14,cabWidth*.97,cabX,roofY,0,paint,nil,true)
        b(m,'TintedSunroof',roofLen*.49,.035,cabWidth*.58,cabX-.10,roofY+.085,0,C.glass,M.Glass).Transparency=.21
        -- The A/C pillars are slanted; this is the main silhouette improvement.
        local windowFront=cabinFrontX
        local windowRear=cabinRearX
        local glassTop=roofY-.13
        local glassBase=topY+.10
        local fX=roofStart+.11;local rX=roofEnd-.11
        local sw=math.sqrt((windowFront-fX)^2+(glassTop-glassBase)^2)
        local bw=math.sqrt((windowRear-rX)^2+(glassTop-glassBase)^2)
        local ff=(windowFront+fX)*.5
        local rr=(windowRear+rX)*.5
        local wAngle=math.atan2(glassTop-glassBase,windowFront-fX)
        local rwAngle=math.atan2(glassTop-glassBase,rX-windowRear)
        local windshield=ang(m,'PanoramicWindshield',sw,.055,cabWidth*.96,ff,(glassBase+glassTop)*.5,0,-wAngle,C.glass2,M.Glass)
        windshield.Transparency=.23
        local rearWindow=ang(m,'SlantedRearGlass',bw,.055,cabWidth*.95,rr,(glassBase+glassTop)*.5,0,rwAngle,C.glass2,M.Glass)
        rearWindow.Transparency=.24
        b(m,'Dashboard',cabWidth*.08,.22,cabWidth*.75,windowFront-.52,topY+.14,0,C.seat)
        for _,s in ipairs({-1,1}) do
            local z=s*cabWidth*.49
            local sideZ=s*(cabWidth*.50+.035)
            local middleX=cabX+(shape=='van' and .11 or -.14)
            -- side-window split with slim painted roof edges and authentic A/B/C pillars
            local paneLength=math.max(.45,(fX-rX)*.44)
            local frontSide=b(m,'DriverSideGlass',paneLength,math.max(.27,glassTop-glassBase)*.79,.07,
                middleX+paneLength*.48,(glassTop+glassBase)*.51,sideZ,C.glass,M.Glass)
            frontSide.Transparency=.23
            local rearSide=b(m,'RearSideGlass',paneLength*.85,math.max(.25,glassTop-glassBase)*.75,.07,
                middleX-paneLength*.52,(glassTop+glassBase)*.51,sideZ,C.glass2,M.Glass)
            rearSide.Transparency=.24
            rod(m,'A_Pillar',windowFront,glassBase,sideZ,fX,glassTop,sideZ,.15,paint,nil,true)
            rod(m,'B_Pillar',middleX,glassBase,sideZ,middleX,glassTop,sideZ,.13,C.dark,M.Metal)
            rod(m,'C_Pillar',windowRear,glassBase,sideZ,rX,glassTop,sideZ,.19,paint,nil,true)
            rod(m,'WindowSill',windowRear,glassBase,sideZ,windowFront,glassBase,sideZ,.12,C.dark,M.Metal)
            rod(m,'RoofSideTrim',rX,glassTop,sideZ,fX,glassTop,sideZ,.11,paint,nil,true)
            b(m,'SideMirror',.51,.21,.40,windowFront-.32,glassBase+.12,s*W*.455,C.dark,M.Metal)
            b(m,'MirrorGlass',.09,.15,.27,windowFront-.39,glassBase+.12,s*W*.49,C.chrome,M.Metal)
        end
    end
    -- Fine door gaps and inset handles that scale with body length.
    for _,s in ipairs({-1,1}) do
        local outerZ=s*W*.441
        b(m,'DoorHandleBackplate',.52,.12,.055,cabX-.14,topY-H*.26,outerZ,C.dark,M.Metal)
        b(m,'FlushDoorHandle',.40,.05,.060,cabX-.14,topY-H*.24,outerZ,C.chrome,M.Metal)
        b(m,'DoorDivider',.035,H*.37,.05,cabX-cabLen*.065,baseY+H*.35,outerZ,C.line)
        if not sporty then
            b(m,'RearDoorHandle',.39,.055,.045,cabX-cabLen*.37,topY-H*.24,outerZ,C.chrome,M.Metal)
            b(m,'DoorTwoDivider',.035,H*.36,.05,cabX-cabLen*.37,baseY+H*.35,outerZ,C.line)
        end
        rod(m,'ShoulderLine',-L*.40,topY-H*.23,outerZ,L*.35,topY-H*.17,outerZ,.045,C.chrome,M.Metal)
    end
    -- Wheel construction with individually angled spokes and calipers.
    for _,ax in ipairs({rearAxle,frontAxle}) do
        for _,s in ipairs({-1,1}) do
            local before=#m:GetChildren()
            wheel(m,ax,s*W*.48,d,car.feature,cls,idx)
            local id=(ax==frontAxle and "F" or "R")..(s==1 and "R" or "L")
            local center=Vector3.new(ax,d*.51,s*W*.48)
            local all=m:GetChildren()
            for k=before+1,#all do
                if all[k]:IsA("BasePart") then
                    all[k]:SetAttribute("WheelAssembly",id)
                    all[k]:SetAttribute("WheelAssemblyCenter",center)
                end
            end
        end
    end
    frontLights(m,car.face or 'slim',L,W,H,bodyY,extreme)
    rearLights(m,car.feature or 'city',L,W,bodyY,H,extreme)
    aero(m,L,W,H,topY,d,car.feature or 'city',extreme)
    if shape=='pickup' then
        b(m,'CargoFloor',L*.31,.17,W*.79,-L*.325,topY+.09,0,C.dark,M.Metal)
        for _,s in ipairs({-1,1}) do
            b(m,'PickupRail',L*.30,.33,.15,-L*.33,topY+.28,s*W*.40,paint,nil,true)
        end
        b(m,'TailGate',.18,.40,W*.77,-L*.488,topY+.27,0,paint,nil,true)
    end
    if flat and not extreme then
        for _,s in ipairs({-1,1}) do
            b(m,'RubberCladding',L*.41,.15,.18,0,baseY-.04,s*W*.458,C.dark,M.Metal)
        end
    end
    -- The rare neon cosmetic variant is retained, but hidden on standard cars.
    local neon=b(m,'NeonUnderglow',L*.69,.065,W*.69,0,d*.33,0,Color3.fromRGB(40,225,236),M.Neon)
    neon.Transparency=1
    neon:SetAttribute('NeonTrim',true)
    m.WorldPivot=CFrame.new(0,0,0)
    return m
end
return V
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_STEAL60_V51_CarCosmeticArt"><Properties><string name="Name">CarCosmeticArt</string><ProtectedString name="Source">-- Shared native geometry for both real cars and showroom previews. No external assets.
local M={}
local C=Color3.fromRGB
function M.clear(car)
 local old=car:FindFirstChild('Steal60CarLivery');if old then old:Destroy()end
end
function M.apply(car,paint,skin)
 M.clear(car)
 if not skin then return end
 local group=Instance.new('Folder');group.Name='Steal60CarLivery';group.Parent=car
 local white=C(246,240,220);local ink=C(21,29,48);local pink=C(255,145,189);local mint=C(99,236,208)
 local function piece(panel,n,size,cf,color,material,shape)
  local p=Instance.new('Part');p.Name=n;p.Size=size;p.CFrame=panel.CFrame*cf;p.Color=color;p.Material=material or Enum.Material.SmoothPlastic
  if shape==Enum.PartType.Ball then local mesh=Instance.new('SpecialMesh');mesh.MeshType=Enum.MeshType.Sphere;mesh.Parent=p else p.Shape=shape or Enum.PartType.Block end;p.Anchored=panel.Anchored;p.Massless=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false
  p.CastShadow=false;p:SetAttribute('CosmeticOverlay',true);p.Parent=group
  if not p.Anchored then local w=Instance.new('WeldConstraint');w.Part0=panel;w.Part1=p;w.Parent=p end
  return p
 end
 local parts=car:GetDescendants()
 for _,panel in ipairs(parts)do
  if panel:IsA('BasePart')and panel:GetAttribute('Paintable')then
   local name=panel.Name;local top=name=='HoodSurface'or name=='RoofPanel'or name=='TailDeck'
   local side=name=='DoorLower'
   if top then
    local sx,sy,sz=panel.Size.X,panel.Size.Y,panel.Size.Z
    if skin.style=='confetti'then
     local colors={pink,mint,C(255,217,116),C(149,190,255)}
     for i=1,8 do local col=colors[(i-1)%4+1];local x=(-.35+(i-1)%4*.23)*sx;local z=(i&lt;=4 and -.24 or .24)*sz
      piece(panel,'TopConfetti',Vector3.new(sx*.075,.028,sz*.09),CFrame.new(x,sy/2+.025,z)*CFrame.Angles(0,i*.67,0),col,nil,Enum.PartType.Ball)
     end
    elseif skin.style=='race'then
     for _,s in ipairs({-1,1})do
      piece(panel,'IvoryRacingStripe',Vector3.new(sx*.98,.016,sz*.105),CFrame.new(0,sy/2+.014,s*sz*.115),skin.color)
      piece(panel,'RacePinstripe',Vector3.new(sx*.98,.018,sz*.013),CFrame.new(0,sy/2+.018,s*sz*.188),ink)
     end
    elseif skin.style=='carbon'then
     piece(panel,'GraphiteSurface',Vector3.new(sx*.985,.014,sz*.985),CFrame.new(0,sy/2+.011,0),ink)
     -- Small paired graphite tiles give a woven, herringbone-like surface.
     for i=0,7 do for j=0,5 do
      local x=(i-3.5)*sx/8;local z=(j-2.5)*sz/6
      piece(panel,'CarbonWeave',Vector3.new(sx*.083,.012,sz*.023),CFrame.new(x,sy/2+.025,z)*CFrame.Angles(0,(i+j)%2==0 and .55 or -.55,0),C(54,64,81))
     end end
    elseif skin.style=='cyber'then
     for _,s in ipairs({-1,1})do
      piece(panel,'CyberInlay',Vector3.new(sx*.92,.018,sz*.022),CFrame.new(0,sy/2+.015,s*sz*.34),skin.color,Enum.Material.Neon)
     end
     for i=0,2 do piece(panel,'CyberBlade',Vector3.new(sx*.22,.019,sz*.035),CFrame.new(sx*(.1-i*.18),sy/2+.022,0)*CFrame.Angles(0,-.5,0),white)end
    elseif skin.style=='sakura'then
     for f=0,2 do
      local x=(f-1)*sx*.26;local z=(f%2==0 and -.15 or .18)*sz
      for i=0,4 do local a=i*math.pi/2.5
       piece(panel,'SakuraPetal',Vector3.new(sx*.11,.034,sz*.095),CFrame.new(x+math.cos(a)*sx*.065,sy/2+.032,z+math.sin(a)*sz*.06)*CFrame.Angles(0,-a,0),f%2==0 and pink or white,nil,Enum.PartType.Ball)
      end
      piece(panel,'FlowerHeart',Vector3.new(.09,.03,.09),CFrame.new(x,sy/2+.035,z),C(255,212,113),nil,Enum.PartType.Ball)
     end
    end
   elseif side then
    local sign=car:GetPivot():PointToObjectSpace(panel.Position).Z&gt;=0 and 1 or -1
    local z=sign*(panel.Size.Z/2+.013)
    if skin.style=='cyber'or skin.style=='race'then
     for i=0,2 do
      piece(panel,'SideLiverySlash',Vector3.new(panel.Size.X*.10,panel.Size.Y*.64,.021),CFrame.new(panel.Size.X*(.23-i*.12),0,z)*CFrame.Angles(0,0,-.40),skin.style=='cyber'and skin.color or white,skin.style=='cyber'and Enum.Material.Neon or Enum.Material.SmoothPlastic)
     end
    elseif skin.style=='sakura'then
     for f=0,1 do local x=panel.Size.X*(-.23+f*.46);local y=f==0 and .06 or -.08
      for i=0,4 do local a=i*math.pi/2.5;piece(panel,'SideSakuraPetal',Vector3.new(.24,.15,.032),CFrame.new(x+math.cos(a)*.13,y+math.sin(a)*.13,z)*CFrame.Angles(0,0,a),f==0 and pink or white,nil,Enum.PartType.Ball)end
      piece(panel,'SideFlowerHeart',Vector3.new(.09,.09,.04),CFrame.new(x,y,z+sign*.012),C(255,212,113),nil,Enum.PartType.Ball)
     end
    elseif skin.style=='confetti'then
     local colors={pink,mint,C(255,217,116),C(149,190,255)}
     for i,c in ipairs(colors)do piece(panel,'ConfettiBubble',Vector3.new(panel.Size.X*.11,panel.Size.Y*.24,.025),CFrame.new(panel.Size.X*(-.36+(i-1)*.24),i%2==0 and -.10 or .10,z),c,nil,Enum.PartType.Ball)end
    end
   end
  end
 end
 return group
end
function M.finish(car,def,skin)
 if not car or not car.Parent then return end
 M.clear(car)
 for _,part in ipairs(car:GetDescendants()) do
  if part:IsA("BasePart")and not part:GetAttribute("CosmeticOverlay")and not part:GetAttribute("TuningPart")then
   local originalColor=part:GetAttribute("CosmeticBaseColor")
   local originalMaterial=part:GetAttribute("CosmeticBaseMaterial")
   local originalTransparency=part:GetAttribute("CosmeticBaseTransparency")
   if originalColor then
    part.Color=originalColor
    part.Material=Enum.Material[originalMaterial or "SmoothPlastic"] or Enum.Material.SmoothPlastic
    part.Transparency=originalTransparency or 0
   elseif def or skin then
    if part:GetAttribute("Paintable") or part:GetAttribute("NeonTrim") then
     part:SetAttribute("CosmeticBaseColor",part.Color)
     part:SetAttribute("CosmeticBaseMaterial",part.Material.Name)
     part:SetAttribute("CosmeticBaseTransparency",part.Transparency)
    end
   end
   if part:GetAttribute("Paintable") and (def or skin) then
    local col=def and def.color or part.Color
    local lower=part.Name:lower()
    if def and def.accent and (lower:find("roof") or lower:find("крыша") or lower:find("spoiler") or lower:find("спойлер")) then
     col=def.accent
    end
    if skin then
     local name=part.Name
     if skin.style=="carbon" and (name=="HoodSurface" or name=="RoofPanel" or name=="AeroWing") then col=skin.color
     elseif skin.style=="cyber" and (name=="DoorLower" or name=="PaintedSill" or name=="RoofSideTrim") then col=skin.color end
    end
    part.Color=col
    if skin and skin.style=="carbon" and (part.Name=="RoofPanel" or part.Name=="HoodSurface") then part.Material=Enum.Material.Metal
    else part.Material=Enum.Material[(def and def.material) or "SmoothPlastic"] or Enum.Material.SmoothPlastic end
   elseif part:GetAttribute("NeonTrim") and (def or skin) then
    if (def and (def.style=="neon" or def.style=="lightning" or def.style=="sport")) or (skin and skin.style=="cyber") then
     part.Color=(skin and skin.style=="cyber" and skin.color) or (def and (def.accent or def.color)) or part.Color
     part.Material=Enum.Material.Neon
     part.Transparency=0
    end
   end
  end
 end
 M.apply(car,def,skin)
end
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_STEAL60_V51_AuraVisualLibrary"><Properties><string name="Name">AuraVisualLibrary</string><ProtectedString name="Source">-- Saturated back-mounted ribbons and a world-space plume. Movement leaves a fading wake.
local Special=require(script.Parent.AuraSpecial)
local M={};local C=Color3.fromRGB;local states=setmetatable({},{__mode='k'})
function M.create(root,def)
 local old=root:FindFirstChild('Steal60CosmeticAura');if old then old:Destroy()end
 local folder=Instance.new('Folder');folder.Name='Steal60CosmeticAura';folder.Parent=root
 local char=root.Parent;local host=char and(char:FindFirstChild('UpperTorso')or char:FindFirstChild('Torso'))or root
 if not host then host=root end
 local tracked={};local half=math.clamp(host.Size.X*.56,.65,1.1);local back=host.Size.Z*.5+.18
 local high=host.Size.Y*.35;local low=-host.Size.Y*.42
 local accent=def.id=='aura_plasma'and C(185,95,255)or def.id=='aura_crimson'and C(255,201,64)or def.id=='aura_gold'and C(255,246,173)or C(113,255,217)
 local function attach(name,pos)
  local a=Instance.new('Attachment');a.Name='Steal60BackTrail_'..name;a.Position=pos;a.Parent=host;tracked[#tracked+1]=a;return a
 end
 local function ribbon(name,a,b,lifetime,fade)
  local trail=Instance.new('Trail');trail.Name=name;trail.Attachment0=attach(name..'A',a);trail.Attachment1=attach(name..'B',b)
  trail.Enabled=false;trail.FaceCamera=true;trail.Lifetime=lifetime;trail.MinLength=.025;trail.MaxLength=32
  trail.Texture='rbxasset://textures/particles/smoke_main.dds';trail.TextureMode=Enum.TextureMode.Stretch
  trail.LightEmission=.9;trail.LightInfluence=0;trail.Color=ColorSequence.new(def.color,accent)
  trail.Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,fade),NumberSequenceKeypoint.new(.45,fade+.17),NumberSequenceKeypoint.new(1,1)})
  trail.WidthScale=NumberSequence.new({NumberSequenceKeypoint.new(0,1.15),NumberSequenceKeypoint.new(.4,1.05),NumberSequenceKeypoint.new(1,0)})
  trail.Parent=folder
 end
 ribbon('ShoulderWake',Vector3.new(-half,high,back),Vector3.new(half,high,back),1.3,.035)
 ribbon('WaistWake',Vector3.new(-half*.78,low,back+.08),Vector3.new(half*.78,low,back+.08),1.15,.10)
 ribbon('BackCore',Vector3.new(0,high+.15,back+.12),Vector3.new(0,low-.10,back+.12),1.25,.09)
 local origin=attach('Origin',Vector3.new(0,host.Size.Y*.05,back+.15))
 local function emitter(name,texture,rate,smoke)
  local e=Instance.new('ParticleEmitter');e.Name=name;e.Texture=texture;e.LockedToPart=false;e.VelocityInheritance=0;e.Rate=0;e:SetAttribute('MovingRate',rate)
  e.EmissionDirection=Enum.NormalId.Back;e.Color=ColorSequence.new(def.color,accent);e.Lifetime=smoke and NumberRange.new(.65,1.15)or NumberRange.new(.45,.85)
  e.Speed=smoke and NumberRange.new(1.8,3.8)or NumberRange.new(.7,2.1);e.Drag=2;e.Acceleration=Vector3.new(0,.35,0)
  e.SpreadAngle=Vector2.new(smoke and 25 or 45,smoke and 25 or 45);e.Rotation=NumberRange.new(0,360);e.RotSpeed=NumberRange.new(-20,20)
  e.Size=NumberSequence.new({NumberSequenceKeypoint.new(0,smoke and .45 or .10),NumberSequenceKeypoint.new(.3,smoke and 1.2 or .28),NumberSequenceKeypoint.new(1,0)})
  e.Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,smoke and .18 or .06),NumberSequenceKeypoint.new(.55,.38),NumberSequenceKeypoint.new(1,1)})
  e.LightEmission=smoke and .65 or .9;e.LightInfluence=0;e.Parent=origin
  local ref=Instance.new('ObjectValue');ref.Name='EmitterRef';ref.Value=e;ref.Parent=folder
 end
 emitter('BackPlume',def.id=='aura_crimson'and'rbxasset://textures/particles/fire_main.dds'or'rbxasset://textures/particles/smoke_main.dds',32,true)
 emitter('WorldTrailSparks','rbxasset://textures/particles/sparkles_main.dds',18,false)
 folder:SetAttribute('TrailCount',3);folder:SetAttribute('EmitterCount',2);folder:SetAttribute('AuraOrigin','Back');folder:SetAttribute('AuraId',def.id)
 Special.build(root,folder,origin,def)
 folder.Destroying:Connect(function()states[root]=nil;for _,a in ipairs(tracked)do if a.Parent then a:Destroy()end end end)
 return folder
end
local function collect(root,folder,t,previous)
 local state={folder=folder,last=previous and previous.last or root.Position,time=previous and previous.time or t,trails={},emitters={},refresh=t+1}
 local incomplete=false
 for _,obj in ipairs(folder:GetChildren())do
  if obj:IsA('Trail')then
   state.trails[#state.trails+1]=obj
   if not obj.Attachment0 or not obj.Attachment1 then incomplete=true end
  elseif obj:IsA('ObjectValue')and obj.Name=='EmitterRef'then
   if obj.Value and obj.Value.Parent then state.emitters[#state.emitters+1]=obj.Value else incomplete=true end
  end
 end
 if incomplete or #state.trails~=(folder:GetAttribute('TrailCount')or 3)or #state.emitters~=(folder:GetAttribute('EmitterCount')or 2)then state.refresh=t+.12 end
 states[root]=state;return state
end
function M.step(root,t)
 local folder=root:FindFirstChild('Steal60CosmeticAura');if not folder then states[root]=nil;return end
 local state=states[root]
 if not state or state.folder~=folder then state=collect(root,folder,t,nil)
 elseif t&gt;=state.refresh then state=collect(root,folder,t,state)end
 local delta=root.Position-state.last;local elapsed=t-state.time
 local speed=elapsed&gt;0 and Vector3.new(delta.X,0,delta.Z).Magnitude/elapsed or 0
 local teleported=delta.Magnitude&gt;18;local active=not teleported and speed&gt;.85
 for _,trail in ipairs(state.trails)do if trail.Parent then trail.Enabled=active;if teleported then trail:Clear()end end end
 for _,e in ipairs(state.emitters)do if e.Parent then e.Rate=active and(e:GetAttribute('MovingRate')or 0)or 0;if teleported then e:Clear()end end end
 Special.step(root,folder,t,speed,teleported)
 state.last=root.Position;state.time=t
end
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_STEAL60_V52_PetAnimationLibrary"><Properties><string name="Name">PetAnimationLibrary</string><ProtectedString name="Source">-- Client kinematics: no WeldConstraint/Motor6D or network-owned physics is involved.
local M={};local states=setmetatable({},{__mode='k'});local TAU=math.pi*2
local function gather(model,t)
 local previous=states[model]
 local state={groups={},pieces={},eyes={},lids={},frames={},parts={},rotors=0,nextRefresh=t+2}
 local candidates=model:GetDescendants();local groupCount=0;local incomplete=false
 for _,p in ipairs(candidates)do
  if p:IsA('BasePart')and p:GetAttribute('PetMotionPivot')then
   local bind=p:GetAttribute('PetBindCFrame');local kind=p:GetAttribute('PetAnimationKind')
   if bind and kind then
    groupCount+=1
    state.groups[p.Name]={bind=bind,kind=kind,side=p:GetAttribute('PetAnimationSide')or 1,index=groupCount}
    if kind=='rotor'then state.rotors+=1 end
   else incomplete=true end
  end
 end
 for _,p in ipairs(candidates)do
  if p:IsA('BasePart')and p~=model.PrimaryPart then
   local bind=p:GetAttribute('PetBindCFrame')
   if bind then
    local name=p:GetAttribute('PetMotionPivot')and p.Name or p:GetAttribute('PetMotionGroup')
    local group=name and state.groups[name]
    if name and not group then incomplete=true end
    state.pieces[#state.pieces+1]={part=p,bind=bind,group=group,relative=group and group.bind:ToObjectSpace(bind)or bind}
    state.parts[#state.parts+1]=p;p.LocalTransparencyModifier=0
    if p:GetAttribute('PetBlinkOpen')then state.eyes[#state.eyes+1]=p
    elseif p:GetAttribute('PetBlinkLid')then state.lids[#state.lids+1]=p end
   else
    -- A streamed-in part is hidden until its immutable bind pose arrives.
    p.LocalTransparencyModifier=1;incomplete=true
   end
  end
 end
 state.expectedParts=model:GetAttribute('PetKinematicPartCount')
 state.expectedGroups=model:GetAttribute('PetAnimationGroupCount')
 state.complete=not incomplete and #state.pieces==state.expectedParts and groupCount==state.expectedGroups
 if not state.complete then state.nextRefresh=t+.10 end
 state.phase=previous and previous.phase or 0;state.lastTime=previous and previous.lastTime
 state.smoothSpeed=previous and previous.smoothSpeed
 states[model]=state;model:SetAttribute('ClientAnimatedRotorCount',state.rotors)
 return state
end
function M.inspect(model,t)
 local state=states[model]
 if not state or t&gt;=state.nextRefresh or state.expectedParts~=model:GetAttribute('PetKinematicPartCount')or state.expectedGroups~=model:GetAttribute('PetAnimationGroupCount')then state=gather(model,t)end
 return state
end
local function pose(group,t,petId,gait,cycle,moving)
 local kind=group.kind
 if kind=='walkFront'or kind=='walkBack'then
  local phase=((group.side&gt;0)==(kind=='walkFront'))and 0 or math.pi
  local amp=(petId=='pet_turtle'and .16 or(kind=='walkFront'and .58 or .47))*(.10+.90*gait)
  return CFrame.new(0,math.max(0,math.sin(cycle+phase))*(petId=='pet_turtle'and(.01+.04*gait)or(.03+.17*gait)),0)*CFrame.Angles(math.sin(cycle+phase)*amp,0,math.sin(cycle+phase)*group.side*.06*gait)
 elseif kind=='wing'then
  local flap=math.sin(t*(petId=='pet_phoenix'and 10.8 or 8.8))*(petId=='pet_phoenix'and .50 or .34)
  return CFrame.Angles(flap*.22,0,group.side*flap)
 elseif kind=='rotor'then
  return CFrame.Angles(0,(t*19.4*group.side+group.index*.61)%TAU,0)
 elseif kind=='head'then
  return CFrame.Angles(math.sin(t*1.8)*.035,math.sin(t*.77+group.index)*.09*(moving and .35 or 1),math.sin(t*1.1)*.025)
 end
 local rate=petId=='pet_dog'and 6.6 or(petId=='pet_fox'and 5 or 3.2)
 local amp=petId=='pet_dog'and .43 or .30
 return CFrame.Angles(0,math.sin(t*rate)*amp*(moving and 1 or .55),0)
end
function M.step(model,t,speed,mounted,walkPhase)
 local root=model and model.PrimaryPart
 if not root or not model.Parent then states[model]=nil;return end
 if model:GetAttribute('PetVisualSchema')~=55 then return end
 local state=M.inspect(model,t);local petId=model:GetAttribute('CosmeticId')or''
 speed=math.clamp(tonumber(speed)or 0,0,24)
 local dt=state.lastTime and math.clamp(t-state.lastTime,0,.1)or 0;state.lastTime=t
 state.smoothSpeed=state.smoothSpeed and(state.smoothSpeed+(speed-state.smoothSpeed)*(1-math.exp(-dt*12)))or speed
 speed=state.smoothSpeed
 local ground=model:GetAttribute('PetMovementType')=='ground';local moving=not mounted and speed&gt;1.2
 local gait=ground and not mounted and math.clamp((speed-1)/10.5,0,1)or 0
 state.phase=(state.phase+dt*((moving and ground)and(5.8+speed*.42)or 2.3))%TAU
 local cycle=ground and not mounted and walkPhase or state.phase
 for _,group in pairs(state.groups)do group.world=root.CFrame*group.bind*pose(group,t,petId,gait,cycle,moving)end
 local count=0
 for _,item in ipairs(state.pieces)do
  if item.part.Parent then
   count+=1;state.parts[count]=item.part
   state.frames[count]=item.group and item.group.world*item.relative or root.CFrame*item.bind
  else state.nextRefresh=-1 end
 end
 for i=count+1,#state.parts do state.parts[i]=nil;state.frames[i]=nil end
 if #state.parts&gt;0 then
  if workspace and model:IsDescendantOf(workspace)then
   workspace:BulkMoveTo(state.parts,state.frames,Enum.BulkMoveMode.FireCFrameChanged)
  else
   for i,p in ipairs(state.parts)do p.CFrame=state.frames[i]end
  end
 end
 local seed=tonumber(model:GetAttribute('PetOwnerUserId'))or 0
 for i=1,#petId do seed+=string.byte(petId,i)*.031 end
 local blink=(t+seed*.173)%4.8&lt;.15
 if state.blink~=blink then
  for _,p in ipairs(state.eyes)do if p.Parent then p.Transparency=blink and 1 or(p:GetAttribute('PetBlinkBaseTransparency')or 0)end end
  for _,p in ipairs(state.lids)do if p.Parent then p.Transparency=blink and 0 or 1 end end
  state.blink=blink
 end
end
function M.release(model)states[model]=nil end
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_STEAL60_V54_AvatarOutfit"><Properties><string name="Name">AvatarOutfit</string><ProtectedString name="Source">-- Dress the player's existing body. Never import the mannequin's body or scale.
local M={}
local clothingFields={'Shirt','Pants','GraphicTShirt','Face','TorsoColor','LeftLegColor','RightLegColor'}
function M.compose(original,outfit)
 local result=original:Clone()
 -- Remove inherited layered garments before applying the complete classic outfit.
 result:SetAccessories({},true)
 for _,field in ipairs({'BackAccessory','FaceAccessory','FrontAccessory','HairAccessory','HatAccessory','NeckAccessory','ShouldersAccessory','WaistAccessory'})do result[field]=''end
 for _,name in ipairs(clothingFields)do result[name]=outfit[name]end
 result:SetAccessories(outfit:GetAccessories(true),true)
 return result
end
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_STEAL60_V55_TutorialConfig"><Properties><string name="Name">TutorialConfig</string><ProtectedString name="Source">-- Six short gameplay steps; the complete reference is optional.
local M={VERSION=4}
M.Steps={
 {id='start',title='К первой машине',body='Следуй стрелке над головой к подсвеченной машине «ВЗЛОМ 1+». Нажми кнопку у двери или удерживай E.',target='starter'},
 {id='lock',title='Открой замок',body='Попади белой линией в зелёную зону. Нажимай кнопку на экране или F. Промах можно повторить.',target='starter'},
 {id='delivery',title='Отвези авто в гараж',body='Следуй стрелке к своему салону. Поставь машину целиком в зелёную рамку и остановись. На планшете — кнопки справа.',target='delivery'},
 {id='loot',title='Добыча уже на полке',body='Ты получил монеты за доставку, а найденный предмет уже приносит доход на полке. Полки заполняются автоматически. Касса у входа выдаёт накопленные монеты.',target='shelf',lesson=true},
 {id='ride',title='Возьми свою машину',body='Следуй стрелке к машине на витрине. Нажми «Поехать» — теперь на ней можно добираться до новых целей.',target='showcase'},
 {id='income',title='Первое усиление дохода',body='Подойди к отмеченному мастеру на тротуаре. Купи «Увеличить доход» за монеты. Если не хватает — забери деньги в кассе у входа. Остальные возможности есть в руководстве.',target='coins'},
}
M.ById={};for i,step in ipairs(M.Steps)do step.index=i;M.ById[step.id]=step end
M.Handbook={
 {id='start',title='Твоя первая машина',body='Иди к отмеченной доступной машине в районе 1. Подойди к двери и удерживай E, чтобы начать взлом.',target='starter'},
 {id='lock',title='Открой замок',body='Нажимай F или кнопку на экране, когда указатель в зелёной зоне. Первый замок простой. После отмены или неудачи можно попробовать снова.',target='starter'},
 {id='delivery',title='Доставь машину домой',body='W/S — газ и тормоз, A/D — руль. Езжай к зелёной парковке СВОЕГО салона и полностью остановись. Если застрял, используй возврат машины.',target='delivery'},
 {id='loot',title='Первый доходный предмет',body='За доставку ты нашёл предмет. Он стоит на полке и приносит деньги в кассу каждую секунду. Нажми «Понятно», затем посмотрим, как работают автоматические полки.',target='shelf',lesson=true},
 {id='auto_shelves',title='Полки работают автоматически',body='Система сама ставит самые доходные предметы на полки, а остальные хранит в запасе. После находки, звезды или расширения полок расстановка обновится. Перетаскивать и переставлять ничего не нужно.',target='shelf',lesson=true},
 {id='till',title='Забери заработанное',body="Касса по центру сразу за входом в салон. Подойди и нажми E. Деньги переходят из кассы в кошелёк. Касса копит до 12 часов дохода (с ВИП — 48). Пустая касса не засчитывается: дай предмету поработать.",target='till'},
 {id='ride',title='Поездка на своей машине',body='Выйди к витрине и нажми E на своей машине. Каталог остаётся твоим: с витрины можно брать машину для поездки к следующему угону.',target='showcase'},
 {id='helper',title='Поручи возврат помощнику',body='Приезжай на своей машине к новой цели и начни её взлом. Помощник заберёт прошлую машину. Шаг завершится, когда она действительно вернётся в салон.',target='starter'},
 {id='copies',title='Собери 5 одинаковых предметов',body='Продолжай доставлять машины. Для первой звезды первый предмет гарантирован при первой доставке; следующие копии выпадают в соответствующем районе. Каждая копия получается только за настоящую доставку.',target='starter'},
 {id='star',title='Твоя первая золотая звезда',body='Мастер на тротуаре перед машинами → ПРЕДМЕТЫ ★ → учебный предмет → «★ УЛУЧШИТЬ». Нужны 5 копий и монеты. Звезда добавит предмету +20% дохода; всего можно получить 5 звёзд.',target='coins'},
 {id='pin',title='Закрепи любимую машину',body='МЕНЮ → КАТАЛОГ → выбери ручную витрину. Отмечай до шести машин кнопками «ОСТАВИТЬ НА ВИТРИНЕ» и «УБРАТЬ С ВИТРИНЫ». Пустые места остаются пустыми; выбор сохраняется. Кнопка автовитрины возвращает автоматический выбор. Машина для поездки остаётся в коллекции.',target='showcase'},
 {id='income',title='Улучши доход салона',body="У НПС «МАСТЕР · МОНЕТЫ» купи первое улучшение дохода за обычные монеты. Оно усиливает кассу всего салона.",target='coins'},
 {id='security',title='Найми охрану',body="У мастера монет купи улучшение охраны. Охрана замедляет налёты игроков и повышает шанс поймать НПС-воришку. Для этого урока донат не нужен.",target='coins'},
 {id='defend',title='Прогони учебного воришку',body='Вернись к салону. Воришка подойдёт с улицы через вход. Подойди к нему в пределах видимости и удерживай E «ПРОГНАТЬ». В учебном налёте деньги из кассы не теряются.',target='thief'},
 {id='parts',title='Коллекционные детали и звёзды',body='Каждые 50 успешных налётов дают коллекционную деталь. Она добавляет процент к деньгам за угон; 5 дубликатов автоматически повышают звезду, до 20 уровней. Смотреть: мастер монет → КОЛЛЕКЦИЯ. Это отдельно от доходных предметов.',target='coins',lesson=true},
 {id='puzzles',title='Все виды взлома',body='Полоса, провода, диск и код памяти используют разные подсказки на экране. Сложные машины требуют более высокого навыка. Обычный промах можно исправить; попытка открыть слишком сложный замок вызывает сигнализацию и полицию.',target='starter',lesson=true},
 {id='zones',title='Районы и рост навыка',body="Доставки дают ОПЫТ взлома. С повышением уровня открываются более ценные машины и районы. Смотри требуемый уровень на машине: редкость, вариант и район влияют на добычу. Каждая третья копия машины даёт ей звезду, до 5 звёзд.",target='delivery',lesson=true},
 {id='events',title='Задания, поездки и рейтинг',body="Следи за дорожными событиями и заказами на интерфейсе. Дневные задания и аккуратные доставки дают дополнительные монеты и ОПЫТ. МЕНЮ → ТОП-100 показывает сезонный рейтинг заработка.",target='delivery',lesson=true},
 {id='cosmetics',title='Образы, ауры и машины',body='Стилист на тротуаре перед машинами продаёт образы, ауры и стили машин за алмазы. Кнопка «ПРИМЕРИТЬ» временно меняет вид на 20 секунд без покупки. Затем прежний вид вернётся. Для машины выбери свой экземпляр с витрины или текущую поездку.',target='cosmetics',lesson=true},
 {id='pets',title='Питомец и его облики',body='Питомец открывается один раз за заработанные монеты или алмазы. После лицензии все его облики бесплатны. Общий бонус питомца сохраняется при смене облика. Покупать питомца для завершения обучения не требуется.',target='cosmetics',lesson=true},
 {id='diamonds',title="Алмазы и ВИП",body="Алмазы пополняются официальной покупкой Roblox за Робакс. Образы, ауры и премиальные улучшения покупаются за алмазы. ВИП ограничен по времени и продлевается с остатком дней. Основную игру и обучение можно пройти без платежей.",target='diamonds',lesson=true},
 {id='pvp',title='Налёты на чужие салоны',body='Чужую витрину можно временно ограбить: владелец сохраняет каталог машин. Есть личная перезарядка и защита жертвы от повторных налётов. Награда берётся из кассы жертвы; на неё действуют бонусы героя и питомца. Пустой салон не даёт денег. Доход от всех краж входит в рейтинг, траты и штрафы его не уменьшают. Налёт на другого игрока для урока не требуется.',target='showcase',lesson=true},
 {id='finish',title='Ты готов к большому угону',body='Основы освоены: кража, доставка, свой автомобиль и доход салона. Дальше можно собирать коллекцию, открывать районы, улучшать предметы до звёзд и защищать гараж. Полное руководство доступно по кнопке «РУКОВОДСТВО».',lesson=true},
}
M.Handbook[#M.Handbook+1]={title='Долгая прокачка усилений',body='Монетные усиления растут в цене по уровням; за алмазы их можно покупать сразу. Требований по уровню взлома или числу доставок нет. При смене облика бонус сохраняется. Доходные бонусы складываются, поэтому витрина больше не перемножает их в огромные значения. Уже купленные уровни и имущество сохранены.'}
M.Handbook[#M.Handbook+1]={title='Управление и звук',body='Планшет: газ, задний ход и руль справа, стандартный джойстик слева. Компьютер: W/S, A/D; R — выровнять остановившуюся машину. Примерка длится 20 секунд. Кнопка МУЗЫКА включает/выключает музыку; сирена и сигнализация остаются отдельными эффектами.'}
M.Handbook[#M.Handbook+1]={title='Полиция, сигнализация и штраф',body='Попытка открыть слишком сложную машину включает сигнализацию и вызывает патруль. Слышны сигнализация и приближающаяся сирена, у патруля мигают огни. При задержании из текущей кассы снимается 5% без верхнего предела. Кошелёк сохраняется; заработок в рейтинге не уменьшается. После возрождения есть короткая пауза до нового взлома.'}
M.Handbook[#M.Handbook+1]={title='Краска, рисунки и тюнинг',body='Во вкладке КРАСКА находятся цвета и рисунки: они сохраняются отдельно и сочетаются. Во вкладке ТЮНИНГ — десять деталей: спойлер, капот, диски, подсветка, сплиттер, диффузор, пороги, воздухозаборник, выхлоп и зеркала. Каждая деталь покупается за алмазы один раз, затем включается и снимается отдельно для каждой своей модели.',target='cosmetics',lesson=true}
M.Handbook[#M.Handbook+1]={title='Осмотр машины на дороге',body='Кнопка ПРИМЕРИТЬ на карточке краски, рисунка или тюнинга выставляет отдельную машину на дорогу на 20 секунд. Она показывает выбранную покупку вместе с уже сохранённым оформлением. Примерка не тратит валюту и не заменяет настоящую машину. В каталоге есть кнопка ПОСМОТРЕТЬ НА ДОРОГЕ. По окончании осмотра временная машина исчезает.',target='cosmetics',lesson=true}
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_STEAL60_V55_TutorialProgress"><Properties><string name="Name">TutorialProgress</string><ProtectedString name="Source">-- Pure state transitions; no remote calls, grants, or client-computed progress.
local M={}
local function owns(data,id)
 for _,list in ipairs({data.shelf or{},data.shelfStorage or{}})do for _,it in pairs(list)do if it.id==id then return true end end end
 return false
end
M.owns=owns
function M.ensure(data)
 local s=data.tutorialV2
 if type(s)~='table'or s.version~=2 then
  local veteran=next(data.catalog or{})~=nil
  s={version=2,done={},signals={},itemId='tree_fresh',forcedDrops=0,starterEligible=true}
  if veteran then
   for _,id in ipairs({'start','lock','delivery'})do s.done[id]=true end
   if (tonumber(data.tutorialStage)or 0)&gt;=6 then s.done.ride=true;s.done.helper=true end
   for _,list in ipairs({data.shelf or{},data.shelfStorage or{}})do
    for _,it in ipairs(list)do if it.id and it.id~='__empty'then s.itemId=it.id;break end end
    if owns(data,s.itemId)then break end
   end
  end
  data.tutorialV2=s
 end
 s.done=type(s.done)=='table'and s.done or{};s.signals=type(s.signals)=='table'and s.signals or{}
 s.forcedDrops=math.clamp(math.floor(tonumber(s.forcedDrops)or 0),0,5)
 return s
end
function M.record(data,event,id)
 local s=M.ensure(data)
 local simple={hack_started='start',hack_success='lock',delivered='delivery',collect_till='till',ride_started='ride',helper_returned='helper',thief_chased='defend'}
 if simple[event]then s.signals[simple[event]]=true end

 if event=='heist_failed'and not s.done.delivery and not s.signals.delivery then
  s.done.start=nil;s.done.lock=nil;s.signals.start=nil;s.signals.lock=nil
 end
end
function M.rejoin(data)
 local s=M.ensure(data)
 if not s.done.delivery and(s.replay or next(data.catalog or{})==nil)then M.record(data,'heist_failed')end

end
function M.restart(data)
 local old=M.ensure(data)
 data.tutorialV2={version=2,done={},signals={},itemId=old.itemId,forcedDrops=old.forcedDrops,starterEligible=old.starterEligible,replay=true}
end
function M.satisfied(data,step)
 local s=M.ensure(data);local id=step.id
 if step.lesson then
  if(id=='loot'or id=='auto_shelves')and not owns(data,s.itemId)then return false end
  return s.signals['read_'..id]==true
 end
 if id=='copies'then return (tonumber((data.lootCopies or{})[s.itemId])or 0)&gt;=5 or(tonumber((data.lootRanks or{})[s.itemId])or 0)&gt;=1 end
 if id=='star'then return(tonumber((data.lootRanks or{})[s.itemId])or 0)&gt;=1 end
 if id=='pin'then return #(data.showcase and data.showcase.pinned or{})&gt;0 end
 if id=='income'then return(tonumber((data.coinUpgrades or{}).income)or 0)+(tonumber((data.upgrades or{}).income)or 0)&gt;0 end
 if id=='security'then return(tonumber((data.coinUpgrades or{}).security)or 0)+(tonumber((data.upgrades or{}).security)or 0)&gt;0 end
 if id=='delivery'and not s.replay and next(data.catalog or{})~=nil then return true end
 return s.signals[id]==true
end
function M.advance(data,steps)
 local s=M.ensure(data)
 for i,step in ipairs(steps)do
  if not s.done[step.id]then
   if not M.satisfied(data,step)then return i end
   s.done[step.id]=true
  end
 end
 return #steps+1
end
function M.lesson(data,step)
 if not step or not step.lesson then return false end
 local s=M.ensure(data)
 if(step.id=='loot'or step.id=='auto_shelves')and not owns(data,s.itemId)then return false end
 s.signals['read_'..step.id]=true;return true
end
function M.forcedLoot(data)
 local s=M.ensure(data)
 if not s.replay and s.starterEligible and not s.done.delivery and s.forcedDrops&lt;1 then return s.itemId end
 return nil
end
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_STEAL60_V56_SalonLayout"><Properties><string name="Name">SalonLayout</string><ProtectedString name="Source">-- Shared layout for architecture, tutorial markers and the thief's physical route.
local M={}
M.Till={u=0,v=14}
M.VendorWalk={u=-19,v=-10,width=26,length=4}
M.Vendors={coins={u=-27,v=-10},diamonds={u=-19,v=-10},cosmetics={u=-11,v=-10}}
M.GuardPoints={{8,-7},{0,5},{-8,11},{-9,23},{15,25},{9,10},{0,5},{37,5},{37,47},{-37,47},{-37,5},{0,5}}
M.ThiefPoints={{-44,-8},{0,-8},{0,4},{0,8},{0,11}}
function M.world(rec,u,v,y)return Vector3.new(rec.px+u,y or .55,rec.side*(42+v))end
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_STEAL60_V56_ShelfPlacement"><Properties><string name="Name">ShelfPlacement</string><ProtectedString name="Source">-- Automatic arrangement; no item ownership or currency grants. Unknown saved items are retained.
local M={}
local function score(data,def)
 if not def then return -1 end
 local level=math.clamp(math.floor(tonumber((data.lootRanks or{})[def.id])or 0),0,5)
 return def.income*(1+.20*level)
end
function M.arrange(data,definitions)
 data.shelf=type(data.shelf)=='table'and data.shelf or{}
 data.shelfStorage=type(data.shelfStorage)=='table'and data.shelfStorage or{}
 local capacity=math.max(12,#data.shelf,math.floor(tonumber(data.shelfCapacity)or 12));data.shelfCapacity=capacity;local pool={}
 for _,list in ipairs({data.shelf,data.shelfStorage})do
  local keys={};for key in pairs(list)do if type(key)=='number'then keys[#keys+1]=key end end;table.sort(keys)
  for _,key in ipairs(keys)do local item=list[key]
   if type(item)=='table'and item.id and item.id~='__empty'then pool[#pool+1]={item=item,income=score(data,definitions[item.id]),index=#pool+1}end
  end
 end
 table.sort(pool,function(a,b)
  if a.income~=b.income then return a.income&gt;b.income end
  if a.item.id~=b.item.id then return tostring(a.item.id)&lt;tostring(b.item.id)end
  return a.index&lt;b.index
 end)
 local shelf,storage={},{}
 for i,record in ipairs(pool)do
  if i&lt;=capacity then shelf[i]=record.item else storage[#storage+1]=record.item end
 end
 for i=#shelf+1,capacity do shelf[i]={id='__empty'}end
 data.shelf=shelf;data.shelfStorage=storage
 return capacity
end
function M.add(data,item,definitions)
 data.shelfStorage=type(data.shelfStorage)=='table'and data.shelfStorage or{}
 data.shelfStorage[#data.shelfStorage+1]=item
 M.arrange(data,definitions)
 local sold
 if #data.shelfStorage&gt;48 then
  local lesson=data.tutorialV2;local protected=lesson and not(lesson.done or{}).loot and lesson.itemId or nil
  local copies=0
  if protected then for _,list in ipairs({data.shelf,data.shelfStorage})do for _,it in ipairs(list)do if it.id==protected then copies+=1 end end end end
  for i=#data.shelfStorage,1,-1 do
   local candidate=data.shelfStorage[i]
   if definitions[candidate.id]and not(candidate.id==protected and copies==1)then sold=table.remove(data.shelfStorage,i);break end
  end
 end
 local onShelf=false;for _,it in ipairs(data.shelf)do if it==item then onShelf=true;break end end
 return {onShelf=onShelf,stored=not onShelf and sold~=item,sold=sold}
end
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_STEAL60_V57_UIIcons"><Properties><string name="Name">UIIcons</string><ProtectedString name="Source">-- Font-independent close icons for every current and future window in the client GUI.
local M={};local glyphs={X=true,x=true,['✕']=true,['×']=true,['✖']=true,['❌']=true}
local watched=setmetatable({},{__mode='k'})
function M.close(button)
 button.Text=''
 for i,angle in ipairs({45,-45})do
  local name='Steal60CloseStroke'..i;local line=button:FindFirstChild(name)
  if not line then
   line=Instance.new('Frame');line.Name=name;line.AnchorPoint=Vector2.new(.5,.5);line.Position=UDim2.fromScale(.5,.5)
   line.Size=UDim2.fromOffset(17,2);line.Rotation=angle;line.BorderSizePixel=0;line.Active=false;line.Parent=button
  end
  line.BackgroundColor3=button.TextColor3;line.ZIndex=button.ZIndex+1
 end
 button:SetAttribute('VectorCloseIcon',true)
end
local function watchButton(button)
 if not button:IsA('TextButton')or watched[button]then return end;watched[button]=true
 local function redraw()
  if glyphs[button.Text]then M.close(button)
  elseif button:GetAttribute('VectorCloseIcon')and button.Text~=''then
   for i=1,2 do local line=button:FindFirstChild('Steal60CloseStroke'..i);if line then line:Destroy()end end
   button:SetAttribute('VectorCloseIcon',nil)
  elseif button:GetAttribute('VectorCloseIcon')then M.close(button)end
 end
 -- Clear Text before connecting its signal to avoid a recursive initial assignment.
 if glyphs[button.Text]then M.close(button)end
 local updating=false
 local function changed()
  if updating then return end;updating=true;redraw();updating=false
 end
 button:GetPropertyChangedSignal('Text'):Connect(changed)
 button:GetPropertyChangedSignal('TextColor3'):Connect(changed)
 button:GetPropertyChangedSignal('ZIndex'):Connect(changed)
end
function M.watch(gui)
 for _,object in ipairs(gui:GetDescendants())do watchButton(object)end
 gui.DescendantAdded:Connect(watchButton)
end
-- Rotation belongs to a full-size centred pivot. AnchorPoint does not change GuiObject's rotation centre.
function M.dial(parent,theme)
 local pivot=Instance.new('Frame');pivot.Name='DialNeedlePivot';pivot.AnchorPoint=Vector2.new(.5,.5)
 pivot.Position=UDim2.fromScale(.5,.5);pivot.Size=UDim2.fromScale(1,1);pivot.BackgroundTransparency=1;pivot.BorderSizePixel=0;pivot.ZIndex=3;pivot.Parent=parent
 local needle=Instance.new('Frame');needle.Name='DialNeedle';needle.AnchorPoint=Vector2.new(.5,1)
 needle.Position=UDim2.fromScale(.5,.5);needle.Size=UDim2.fromOffset(4,49);needle.BackgroundColor3=Color3.fromRGB(245,249,253);needle.BorderSizePixel=0;needle.ZIndex=4;needle.Parent=pivot
 local tip=Instance.new('Frame');tip.Name='NeedleTip';tip.AnchorPoint=Vector2.new(.5,.5);tip.Position=UDim2.fromScale(.5,0)
 tip.Size=UDim2.fromOffset(7,7);tip.Rotation=45;tip.BackgroundColor3=theme;tip.BorderSizePixel=0;tip.ZIndex=4;tip.Parent=needle
 local hub=Instance.new('Frame');hub.Name='DialCentre';hub.AnchorPoint=Vector2.new(.5,.5);hub.Position=UDim2.fromScale(.5,.5)
 hub.Size=UDim2.fromOffset(15,15);hub.BackgroundColor3=theme;hub.BorderSizePixel=0;hub.ZIndex=5;hub.Parent=parent
 local round=Instance.new('UICorner');round.CornerRadius=UDim.new(1,0);round.Parent=hub
 return pivot
end

return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_STEAL60_V58_ClientPerformance"><Properties><string name="Name">ClientPerformance</string><ProtectedString name="Source">-- Cull expensive distant decorations on touch; gameplay geometry stays intact.
local M={}
function M.start()
 local Input=game:GetService('UserInputService');if not Input.TouchEnabled then return end
 local Run=game:GetService('RunService');local Lighting=game:GetService('Lighting');local tracked={}
 Lighting.GlobalShadows=false
 local rays=Lighting:FindFirstChild('S60_SunRays');if rays then rays.Enabled=false end
 local function register(obj)
  if obj:IsA('Light')and obj.Parent and obj.Parent:IsA('BasePart')then tracked[obj]={host=obj.Parent,distance=105}
  elseif obj:IsA('SurfaceGui')and obj.Parent and obj.Parent:IsA('BasePart')then tracked[obj]={host=obj.Parent,distance=160}
  elseif obj:IsA('BasePart')then obj.CastShadow=false end
 end
 workspace.DescendantAdded:Connect(register)
 task.spawn(function()for i,obj in ipairs(workspace:GetDescendants())do register(obj);if i%250==0 then task.wait()end end end)
 local elapsed=0
 Run.Heartbeat:Connect(function(dt)
  elapsed+=dt;if elapsed&lt;.6 then return end;elapsed=0
  local camera=workspace.CurrentCamera;if not camera then return end
  for obj,entry in pairs(tracked)do
   if not obj.Parent or not entry.host.Parent then tracked[obj]=nil
   else local visible=(entry.host.Position-camera.CFrame.Position).Magnitude&lt;entry.distance;if obj.Enabled~=visible then obj.Enabled=visible end
   end
  end
 end)
end
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_STEAL60_V58_DrivePresentation"><Properties><string name="Name">DrivePresentation</string><ProtectedString name="Source">-- The driver's network-owned assembly has one motion writer. No render-time CFrame overwrites.
local M={}
function M.start(corrections)
 local Players=game:GetService('Players');local Run=game:GetService('RunService');local Collection=game:GetService('CollectionService')
 local player=Players.LocalPlayer;local Dynamics=require(script.Parent.DriveDynamics);local State=require(script.Parent.DriveState)
 local states={};local obstacles={}
 local function refresh()
  table.clear(obstacles)
  for _,part in ipairs(Collection:GetTagged('S60DriveObstacle'))do if not Collection:HasTag(part,'S60KnockdownCone')then obstacles[#obstacles+1]=part end end
 end
 refresh();Collection:GetInstanceAddedSignal('S60DriveObstacle'):Connect(refresh);Collection:GetInstanceRemovedSignal('S60DriveObstacle'):Connect(refresh)
 corrections.OnClientEvent:Connect(function(car,cf,epoch)
  local state=states[car]
  if state and car:GetAttribute('DriveEpoch')==epoch then state.forward=cf.RightVector;state.speed=0 end
 end)
 Run.PreSimulation:Connect(function(dt)
  local car=State.current(player)
  if not car or car:GetAttribute('ClientDriveOwner')~=player.UserId then table.clear(states);return end
  local body=car:FindFirstChild('Body',true)or car.PrimaryPart;local rig=car:FindFirstChild('DriveRig')
  local heading=rig and rig:FindFirstChild('DriveHeading')
  if not body or not heading or body.Anchored then return end
  local state=states[car]
  if not state or state.epoch~=car:GetAttribute('DriveEpoch')then
   state=Dynamics.new(body,car:GetAttribute('MaxSpeed'));state.epoch=car:GetAttribute('DriveEpoch');states[car]=state
  end
  local throttle,steer=State.input(car)
  local velocity,orientation,wheel=Dynamics.step(state,body.Position,throttle,steer,dt,obstacles)
  body.AssemblyLinearVelocity=velocity;body.AssemblyAngularVelocity=Vector3.zero;heading.CFrame=orientation
  for _,motor in ipairs(rig:GetChildren())do if motor:IsA('Motor6D')and motor.Name:match('^SteeringMotor_F')then motor.Transform=CFrame.Angles(0,wheel,0)end end
 end)
 player:SetAttribute('Steal60DriveControllerReady',true)
end
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_STEAL60_V58_DriveState"><Properties><string name="Name">DriveState</string><ProtectedString name="Source">-- Resolve seating continuously, including the brief SeatPart replication race on touch devices.
local M={};local inputCar;local throttle,steer=0,0
function M.setInput(car,t,s)inputCar=car;throttle=t or 0;steer=s or 0 end
function M.input(car)if car==inputCar then return throttle,steer end;return 0,0 end
function M.current(player)
 local char=player.Character;local hum=char and char:FindFirstChildOfClass('Humanoid')
 if not hum or hum.Health&lt;=0 then return nil end
 local seat=hum.SeatPart
 local car=seat and seat:IsA('VehicleSeat')and seat:FindFirstAncestorOfClass('Model')or nil
 if car and car:GetAttribute('Drivable')and car:GetAttribute('DriverId')==player.UserId then return car,seat end
 local ref=player:FindFirstChild('Steal60DriveCar');car=ref and ref.Value
 if car and car.Parent and car:GetAttribute('Drivable')and car:GetAttribute('DriverId')==player.UserId then
  local rig=car:FindFirstChild('DriveRig');seat=rig and rig:FindFirstChild('DriverSeat')
  if seat and seat.Occupant==hum then return car,seat end
 end
 return nil
end
function M.axes(seatThrottle,seatSteer,touchThrottle,touchSteer)
 return math.clamp(touchThrottle~=0 and touchThrottle or seatThrottle,-1,1),math.clamp(touchSteer~=0 and touchSteer or seatSteer,-1,1)
end
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_STEAL60_V58_HackModes"><Properties><string name="Name">HackModes</string><ProtectedString name="Source">-- Shared presentation rules; the server owns sequence progress and tap validation.
local M={Cycle={'pins','memory','wires','dial'}}
function M.plan(cursor,previous,count,first)
 local modes={}
 for i=1,count do
  if first and i==1 then modes[i]='pins';cursor=1
  else
   cursor=cursor%#M.Cycle+1
   if M.Cycle[cursor]==previous then cursor=cursor%#M.Cycle+1 end
   modes[i]=M.Cycle[cursor]
  end
  previous=modes[i]
 end
 return modes,cursor,previous
end
function M.memoryDuration(zone)return #(zone.sequence or{})*.65+.30 end
function M.memoryInput(zone,index,choice)
 local sequence=zone.sequence or{}
 if choice~=sequence[index]then return false,1,false end
 return true,index+1,index&gt;=#sequence
end
-- A numbered cue is visible briefly, followed by a dark gap between repeated keys.
function M.memoryCue(elapsed,zone)
 if elapsed&lt;0 then return nil end
 local index=math.floor(elapsed/.65)+1
 if index&gt;#(zone.sequence or{})or elapsed%.65&gt;=.47 then return nil end
 return zone.sequence[index],index
end
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_STEAL60_V58_MarqueeController"><Properties><string name="Name">MarqueeController</string><ProtectedString name="Source">-- Client-only marquee: a complete fitted name pauses for five seconds between scrolling passes.
local M={}
function M.start()
 local Run=game:GetService('RunService');local Text=game:GetService('TextService');local tracked={}
 local function register(gui)
  if not gui or gui.Name~='GarageOwnerMarquee'or tracked[gui]then return end
  local viewport=gui:FindFirstChild('NameViewport');local full=viewport and viewport:FindFirstChild('FullName');local ticker=viewport and viewport:FindFirstChild('Ticker')
  if not full or not ticker then return end
  tracked[gui]={full=full,ticker=ticker,start=os.clock()}
 end
 workspace.DescendantAdded:Connect(function(obj)
  if obj:IsA('SurfaceGui')then register(obj)
  elseif obj:IsA('TextLabel')and(obj.Name=='FullName'or obj.Name=='Ticker')then register(obj:FindFirstAncestorOfClass('SurfaceGui'))end
 end)
 task.spawn(function()for i,obj in ipairs(workspace:GetDescendants())do if obj:IsA('SurfaceGui')then register(obj)end;if i%300==0 then task.wait()end end end)
 local elapsed=0
 Run.Heartbeat:Connect(function(dt)
  elapsed+=dt;if elapsed&lt;.05 then return end;elapsed=0
  for gui,state in pairs(tracked)do
   if not gui.Parent then tracked[gui]=nil
   elseif gui.Enabled then
    local name=gui:GetAttribute('OwnerName')or'';local canvas=gui.CanvasSize.X
    if name~=state.name then
     state.name=name;state.full.Text=name;state.ticker.Text=name;state.start=os.clock()
     local ok,size=pcall(function()return Text:GetTextSize(name,60,Enum.Font.GothamBold,Vector2.new(10000,78))end)
     state.width=math.max(100,ok and size.X+30 or(utf8.len(name)or #name)*42)
     state.ticker.Size=UDim2.new(0,state.width,1,0)
    end
    local duration=math.max(4,(canvas+state.width)/160);local phase=(os.clock()-state.start)%(5+duration)
    state.full.Visible=phase&lt;5;state.ticker.Visible=phase&gt;=5
    if phase&gt;=5 then state.ticker.Position=UDim2.fromOffset(canvas-(phase-5)/duration*(canvas+state.width),0)end
   end
  end
 end)
end
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_STEAL60_V58_MusicDirector"><Properties><string name="Name">MusicDirector</string><ProtectedString name="Source">-- Warm native assets once; mode changes select an already loaded track.
local M={}
function M.start(gui)
 local Players=game:GetService('Players');local SoundService=game:GetService('SoundService');local Run=game:GetService('RunService')
 local Content=game:GetService('ContentProvider');local Tween=game:GetService('TweenService')
 local Score=require(script.Parent.MusicScore);local player=Players.LocalPlayer;local rng=Random.new()
 local live=true;local links={};local records={};local pools={ambient={},heist={},siren={},alarm={}}
 local current;local siren;local alarm;local lastTrack;local chooseMusic;local syncEffects
 local energetic=player:GetAttribute('HackActive')==true or player:GetAttribute('HeistCarrying')==true
 local police=player:GetAttribute('PoliceActive')==true
 local folder=Instance.new('Folder');folder.Name='Steal60LocalSoundtrack';folder.Parent=SoundService
 local musicGroup=Instance.new('SoundGroup');musicGroup.Name='Steal60Music';musicGroup.Volume=.45;musicGroup.Parent=SoundService
 local effectsGroup=Instance.new('SoundGroup');effectsGroup.Name='Steal60PoliceEffects';effectsGroup.Volume=.50;effectsGroup.Parent=SoundService
 local function listen(signal,fn)local c=signal:Connect(fn);links[#links+1]=c;return c end
 local function ready(entry)return entry and not entry.failed and(entry.loaded or entry.sound.IsLoaded)end
 local function pick(bank,previous)
  local available={};for _,entry in ipairs(pools[bank])do if ready(entry)then available[#available+1]=entry end end
  if #available==0 then return nil end;local index=rng:NextInteger(1,#available)
  if #available&gt;1 and available[index].id==previous then index=index%#available+1 end;return available[index]
 end
 local function fade(entry,volume)
  if entry.tween then entry.tween:Cancel()end
  entry.tween=Tween:Create(entry.sound,TweenInfo.new(.12,Enum.EasingStyle.Linear),{Volume=volume});entry.tween:Play()
 end
 local function playMusic(entry)
  if not live or not entry or(current==entry and entry.sound.IsPlaying)then return end
  local previous=current;current=entry;lastTrack=entry.id
  entry.sound.Looped=entry.bank=='ambient';entry.sound.Volume=0;entry.sound.TimePosition=0;entry.sound:Play();fade(entry,entry.bank=='heist'and .52 or .36)
  player:SetAttribute('Steal60MusicTrackId',entry.id);player:SetAttribute('Steal60AudioMode',entry.bank)
  if previous and previous~=entry then fade(previous,0);task.delay(.14,function()if live and previous~=current then previous.sound:Stop()end end)end
 end
 chooseMusic=function(forceNext)
  if not live then return end;local wanted=energetic and'heist'or'ambient'
  if not forceNext and current and current.bank==wanted and current.sound.IsPlaying then return end
  local nextTrack=pick(wanted,lastTrack)
  -- Keep the background playing while a cold heist asset downloads.
  if not nextTrack then if current and current.sound.IsPlaying then return end;nextTrack=pick('ambient',lastTrack)end
  playMusic(nextTrack)
 end
 syncEffects=function()
  if not live then return end
  for _,kind in ipairs({'siren','alarm'})do
   local old=kind=='siren'and siren or alarm
   if not police then if old then old.sound:Stop()end;if kind=='siren'then siren=nil else alarm=nil end
   elseif not old or not old.sound.IsPlaying then local entry=pick(kind)
    if entry then entry.sound.Looped=true;entry.sound.Volume=kind=='siren'and .25 or .14;entry.sound:Play();if kind=='siren'then siren=entry else alarm=entry end end
   end
  end
 end
 local function add(bank,ids)
  for _,id in ipairs(ids)do
   local sound=Instance.new('Sound');sound.Name='Cached_'..bank..'_'..id;sound.SoundId='rbxassetid://'..id;sound.Volume=0;sound.Looped=bank~='heist'
   sound.SoundGroup=(bank=='ambient'or bank=='heist')and musicGroup or effectsGroup;sound.Parent=folder
   local entry={id=id,bank=bank,sound=sound,loaded=false,failed=false};pools[bank][#pools[bank]+1]=entry;records[#records+1]=entry
   local function loaded()
    if not live or not sound.Parent then return end;entry.loaded=true;entry.failed=false
    if bank=='ambient'or bank=='heist'then chooseMusic(false)else syncEffects()end
   end
   local function failed(reason)
    if not live or entry.loaded or entry.failed then return end;entry.failed=true;warn('[Steal60 audio] Unavailable '..id..': '..tostring(reason));chooseMusic(false)
   end
   listen(sound.Loaded,loaded);listen(sound.Ended,function()if live and current==entry then chooseMusic(true)end end)
   -- Independent preloads avoid seven-second retries blocking the whole playlist.
   task.spawn(function()
    local denied=false;local ok,err=pcall(function()
     Content:PreloadAsync({sound},function(_,status)
      if not live then return end
      if status==Enum.AssetFetchStatus.Success then loaded()
      elseif status==Enum.AssetFetchStatus.Failure or status==Enum.AssetFetchStatus.TimedOut then denied=true;failed('asset unavailable')end
     end)
    end)
    if not live then return end
    if sound.IsLoaded then loaded()elseif not ok then failed(err)elseif denied then failed('asset unavailable')end
   end)
   task.delay(7,function()if live and not ready(entry)then failed('load timeout/permission')end end)
  end
 end
 add('ambient',Score.Ambient);add('heist',Score.Heists);add('siren',Score.Siren);add('alarm',Score.Alarm)
 local button=Instance.new('TextButton');button.Name='MusicToggle';button.AnchorPoint=Vector2.new(1,0);button.Position=UDim2.new(1,-14,0,14)
 button.Size=UDim2.fromOffset(44,44);button.ZIndex=120;button.Active=true;button.Selectable=true;button.Visible=true;button.Text='';button.AutoLocalize=false;button.Parent=gui
 local note=Instance.new('Frame');note.Name='NoteDrawing';note.Position=UDim2.fromOffset(0,0);note.Size=UDim2.fromScale(1,1);note.BackgroundTransparency=1;note.ZIndex=121;note.Parent=button
 local pieces={}
 local function stroke(name,size,pos,rotation,round)
  local f=Instance.new('Frame');f.Name=name;f.Size=size;f.Position=pos;f.Rotation=rotation or 0;f.BorderSizePixel=0;f.BackgroundColor3=Color3.fromRGB(177,248,219);f.ZIndex=122;f.Parent=note;pieces[#pieces+1]=f
  if round then local r=Instance.new('UICorner');r.CornerRadius=UDim.new(1,0);r.Parent=f end;return f
 end
 stroke('StemLeft',UDim2.fromOffset(3,19),UDim2.fromOffset(16,10));stroke('StemRight',UDim2.fromOffset(3,19),UDim2.fromOffset(29,8))
 stroke('Beam',UDim2.fromOffset(16,4),UDim2.fromOffset(16,9),-8)
 stroke('NoteLeft',UDim2.fromOffset(10,7),UDim2.fromOffset(9,26),-15,true);stroke('NoteRight',UDim2.fromOffset(10,7),UDim2.fromOffset(22,24),-15,true)
 local slash=stroke('MutedSlash',UDim2.fromOffset(3,34),UDim2.fromOffset(21,5),-45);slash.ZIndex=123;slash.BackgroundColor3=Color3.fromRGB(255,153,164)
 local corner=Instance.new('UICorner');corner.CornerRadius=UDim.new(0,9);corner.Parent=button
 local function refresh()
  local off=player:GetAttribute('Steal60MusicMuted')==true;musicGroup.Volume=off and 0 or .45
  local pending=false;for _,entry in ipairs(records)do if(entry.bank=='ambient'or entry.bank=='heist')and not entry.loaded and not entry.failed then pending=true;break end end
  local state=off and'ВЫКЛ'or(current and'ВКЛ'or(pending and'ЗАГРУЗКА'or'НЕТ АУДИО'))
  button:SetAttribute('MusicStatus',state);button:SetAttribute('Tooltip','Музыка: '..state);slash.Visible=off
  for _,piece in ipairs(pieces)do if piece~=slash then piece.BackgroundTransparency=off and .25 or 0 end end
  button.BackgroundColor3=off and Color3.fromRGB(74,48,57)or Color3.fromRGB(24,70,66)
 end
 local modeSerial=0
 local function modeChanged()
  modeSerial+=1;local serial=modeSerial
  local wanted=player:GetAttribute('HackActive')==true or player:GetAttribute('HeistCarrying')==true
  local function apply()
   if not live or serial~=modeSerial then return end;energetic=wanted
   player:SetAttribute('Steal60CurrentMusic',energetic and'УГОН'or'ФОНОВАЯ МУЗЫКА');chooseMusic(false);refresh()
  end
  if wanted then apply()else task.delay(.06,apply)end
 end
 listen(player:GetAttributeChangedSignal('HackActive'),modeChanged);listen(player:GetAttributeChangedSignal('HeistCarrying'),modeChanged)
 listen(player:GetAttributeChangedSignal('PoliceActive'),function()police=player:GetAttribute('PoliceActive')==true;syncEffects()end)
 listen(player:GetAttributeChangedSignal('Steal60MusicMuted'),refresh)
 listen(button.Activated,function()player:SetAttribute('Steal60MusicMuted',not player:GetAttribute('Steal60MusicMuted'))end)
 local elapsed=0
 listen(Run.Heartbeat,function(dt)
  elapsed+=dt;if elapsed&lt;.1 then return end;elapsed=0
  if police and siren then local pos=player:GetAttribute('PolicePosition');local root=player.Character and player.Character:FindFirstChild('HumanoidRootPart')
   local distance=pos and root and(pos-root.Position).Magnitude or 240;siren.sound.Volume=.12+.5*(1-math.clamp(distance/300,0,1))
  end
  refresh()
 end)
 modeChanged();syncEffects();refresh()
 gui.Destroying:Connect(function()
  live=false;for _,c in ipairs(links)do c:Disconnect()end
  for _,entry in ipairs(records)do if entry.tween then entry.tween:Cancel()end;entry.sound:Stop()end
  folder:Destroy();musicGroup:Destroy();effectsGroup:Destroy()
 end)
end
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_STEAL60_V58_MusicScore"><Properties><string name="Name">MusicScore</string><ProtectedString name="Source">-- Public Roblox catalog audio with alternatives. Availability is checked by the native Sound loader.
local M={}
M.Ambient={1848354536,1841647093,1843529601}
M.Heists={1843529634,1837875734,1840684529,1837849285,1837768517}
M.Siren={156667202,9125713501}
M.Alarm={138081500,9114393407}
function M.order(list,rng,last)
 local first=rng:NextInteger(1,#list)
 if #list&gt;1 and list[first]==last then first=first%#list+1 end
 local ordered={};for offset=0,#list-1 do ordered[#ordered+1]=list[(first+offset-1)%#list+1]end
 return ordered
end
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_STEAL60_V58_RoadSteering"><Properties><string name="Name">RoadSteering</string><ProtectedString name="Source">-- Soft curb guidance in districts. Speed survives lateral contact; walking bounds are separate.
local M={}
function M.guide(z,fx,fz,speed,dt,lastDirection)
 if math.abs(speed)&lt;2 or math.abs(z)&lt;23 then return fx,fz,lastDirection end
 local sign=speed&gt;=0 and 1 or-1;local mx,mz=fx*sign,fz*sign
 if math.abs(mx)&gt;.3 then lastDirection=mx&gt;=0 and 1 or-1 end
 local side=z&gt;=0 and 1 or-1
 if mz*side&lt;=0 then return fx,fz,lastDirection end
 local strength=math.clamp((math.abs(z)-23)/5.5,0,1)
 local tx,tz=lastDirection or(mx&gt;=0 and 1 or-1),-side*(.18+.35*strength)
 local length=math.sqrt(tx*tx+tz*tz);tx/=length;tz/=length
 local alpha=math.abs(z)&gt;=28.25 and 1 or math.clamp(dt*(3+9*strength),0,1)
 mx+=(tx-mx)*alpha;mz+=(tz-mz)*alpha;length=math.sqrt(mx*mx+mz*mz)
 if length&lt;.001 then return tx*sign,tz*sign,lastDirection end
 return mx/length*sign,mz/length*sign,lastDirection
end
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_STEAL60_V60_DriveDynamics"><Properties><string name="Name">DriveDynamics</string><ProtectedString name="Source">-- Velocity control shared by driver and server fallback. Native physics moves the car.
local Shared=script.Parent
local Settings=require(Shared.Config.Settings)
local Layout=require(Shared.TrackLayout)
local Road=require(Shared.RoadSteering)
local M={}
local function flat(v)local p=Vector3.new(v.X,0,v.Z);return p.Magnitude&gt;.001 and p.Unit or Vector3.xAxis end
function M.new(body,maximum)return{forward=flat(body.CFrame.RightVector),speed=0,maxSpeed=math.min(maximum or Settings.Drive.BaseSpeed,Settings.MaxCarSpeed)}end
function M.orientation(forward)return CFrame.fromMatrix(Vector3.zero,flat(forward),Vector3.yAxis)end
function M.blocked(from,to,obstacles)
 for _,part in ipairs(obstacles or{})do if part.Parent then
  local lo,hi=0,1;local hit=true
  for _,axis in ipairs({'X','Z'})do
   local extent=part.Size[axis]/2+(axis=='X'and 2.6 or 2.4)
   local start=from[axis]-part.Position[axis];local delta=to[axis]-from[axis]
   if math.abs(delta)&lt;.00001 then if math.abs(start)&gt;extent then hit=false;break end
   else local a=(-extent-start)/delta;local b=(extent-start)/delta;if a&gt;b then a,b=b,a end;lo=math.max(lo,a);hi=math.min(hi,b);if lo&gt;hi then hit=false;break end end
  end
  if hit and lo&lt;=1 and hi&gt;=0 then
   local before=(Vector3.new(from.X,0,from.Z)-Vector3.new(part.Position.X,0,part.Position.Z)).Magnitude
   local after=(Vector3.new(to.X,0,to.Z)-Vector3.new(part.Position.X,0,part.Position.Z)).Magnitude
   local inside=math.abs(from.X-part.Position.X)&lt;=part.Size.X/2+2.6 and math.abs(from.Z-part.Position.Z)&lt;=part.Size.Z/2+2.4
   if not inside or after&lt;before then return true end
  end
 end end
 return false
end
function M.step(state,position,throttle,steer,dt,obstacles)
 dt=math.clamp(dt,0,.08);throttle=math.clamp(throttle,-1,1);steer=math.clamp(steer,-1,1)
 local drive=Settings.Drive;local target=throttle*state.maxSpeed*(throttle&lt;0 and drive.ReverseFactor or 1)
 local acceleration=throttle==0 and drive.Coast or(state.speed*target&lt;0 and drive.Brake or drive.Accel)
 state.speed+=math.clamp(target-state.speed,-acceleration*dt,acceleration*dt)
 local grip=math.clamp(math.abs(state.speed)/16,0,1)
 local angle=-steer*drive.TurnRate*grip*dt*(state.speed&gt;=0 and 1 or-1)
 state.forward=flat(CFrame.Angles(0,angle,0):VectorToWorldSpace(state.forward))
 if position.X&gt;=Settings.Track.SalonZoneLength then
  local x,z,direction=Road.guide(position.Z,state.forward.X,state.forward.Z,state.speed,dt,state.roadDirection)
  state.forward=Vector3.new(x,0,z);state.roadDirection=direction
 end
 local velocity=state.forward*state.speed;local limit=position.X&lt;Settings.Track.SalonZoneLength and 43.5 or 28.5
 local horizon=math.max(dt,1/60)
 local vx=math.clamp(velocity.X,(-45-position.X)/horizon,(Layout.trackEnd()-9-position.X)/horizon)
 local vz=math.clamp(velocity.Z,(-limit-position.Z)/horizon,(limit-position.Z)/horizon)
 if M.blocked(position,position+Vector3.new(vx,0,vz)*horizon,obstacles)then state.speed=0;vx=0;vz=0 end
 return Vector3.new(vx,0,vz),M.orientation(state.forward),-math.rad(27)*steer*grip
end
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_STEAL60_V61_AuraSpecial"><Properties><string name="Name">AuraSpecial</string><ProtectedString name="Source">-- Bounded reusable effects. World-space samples fade behind a walking player; no parts are spawned per frame.
local M={};local states=setmetatable({},{__mode='k'});local C=Color3.fromRGB
local themes={aura_mint='emerald',aura_plasma='lightning',aura_crimson='fire',aura_gold='coins'}
function M.build(root,folder,origin,def)
 local theme=themes[def.id]or'emerald';folder:SetAttribute('SpecialTheme',theme)
 local geometry=Instance.new('Folder');geometry.Name='AuraSpecialGeometry';geometry.Parent=folder
 if theme=='fire'then
  local fire=Instance.new('ParticleEmitter');fire.Name='RisingFlameTongues';fire.Texture='rbxasset://textures/particles/fire_main.dds'
  fire.Color=ColorSequence.new(C(255,228,115),C(255,74,37));fire.Size=NumberSequence.new({NumberSequenceKeypoint.new(0,.28),NumberSequenceKeypoint.new(.35,.72),NumberSequenceKeypoint.new(1,0)})
  fire.Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,.1),NumberSequenceKeypoint.new(.6,.25),NumberSequenceKeypoint.new(1,1)})
  fire.LightEmission=1;fire.LightInfluence=0;fire.VelocityInheritance=0;fire.LockedToPart=false;fire.Rate=0;fire:SetAttribute('MovingRate',22)
  fire.Lifetime=NumberRange.new(.35,.65);fire.Speed=NumberRange.new(1.1,2.4);fire.Acceleration=Vector3.new(0,3.5,0);fire.SpreadAngle=Vector2.new(12,22)
  fire.EmissionDirection=Enum.NormalId.Back;fire.Rotation=NumberRange.new(-18,18);fire.RotSpeed=NumberRange.new(-12,12);fire.Parent=origin
  local ref=Instance.new('ObjectValue');ref.Name='EmitterRef';ref.Value=fire;ref.Parent=folder
  folder:SetAttribute('EmitterCount',(folder:GetAttribute('EmitterCount')or 2)+1)
 else
  for slot=1,6 do for piece=1,2 do
   local p=Instance.new(theme=='emerald'and'WedgePart'or'Part');p.Name=theme..'_'..slot..'_'..piece
   p.Anchored=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.CastShadow=false;p.Massless=true;p.Transparency=1
   p.CFrame=root.CFrame;p.Color=theme=='coins'and(piece==1 and C(242,182,49)or C(255,239,154))or def.color
   p.Material=theme=='coins'and Enum.Material.Metal or Enum.Material.Neon
   if theme=='coins'then p.Shape=Enum.PartType.Cylinder;p.Size=piece==1 and Vector3.new(.055,.43,.43)or Vector3.new(.066,.29,.29)
   elseif theme=='emerald'then p.Size=Vector3.new(.19,.29,.18)
   else p.Size=Vector3.new(.045,.045,.25)end
   p:SetAttribute('FxSlot',slot);p:SetAttribute('FxPiece',piece);p.Parent=geometry
  end end
 end
 folder:SetAttribute('SpecialPartCount',theme=='fire'and 0 or 12)
 folder.Destroying:Connect(function()states[folder]=nil end)
end
function M.step(root,folder,t,speed,teleported)
 local theme=folder:GetAttribute('SpecialTheme');if not theme or theme=='fire'then return end
 local state=states[folder]
 if not state then state={samples={},last=0,parts={},refresh=0};states[folder]=state end
 if t&gt;=state.refresh then
  table.clear(state.parts);local geometry=folder:FindFirstChild('AuraSpecialGeometry')
  if geometry then for _,p in ipairs(geometry:GetChildren())do if p:IsA('BasePart')then state.parts[#state.parts+1]=p end end end
  state.refresh=t+(#state.parts==(folder:GetAttribute('SpecialPartCount')or 12)and 1 or .15)
 end
 if teleported then table.clear(state.samples)end
 if not teleported and speed&gt;.85 and t-state.last&gt;=.075 then
  state.last=t;state.samples[#state.samples+1]={at=t,pos=root.CFrame*Vector3.new(0,.38,1.15)}
  if #state.samples&gt;8 then table.remove(state.samples,1)end
 end
 for _,p in ipairs(state.parts)do if p.Parent then
  local slot=p:GetAttribute('FxSlot')or 1;local piece=p:GetAttribute('FxPiece')or 1
  local sample=state.samples[#state.samples-slot+1];local age=sample and t-sample.at or 10
  if not sample or age&gt;.85 then p.Transparency=1;continue end
  local fade=math.clamp(age/.85,0,1);p.Transparency=.08+.92*fade
  if theme=='emerald'then
   local pos=sample.pos+Vector3.new(math.sin(slot*2.4)*.43,.10*math.sin(slot*1.7)+age*.25,0)
   p.CFrame=CFrame.new(pos)*CFrame.Angles(0,sample.at*2.7,0)*CFrame.new(0,piece==1 and .13 or-.13,0)*CFrame.Angles(0,0,piece==1 and 0 or math.pi)
  elseif theme=='coins'then
   p.CFrame=CFrame.new(sample.pos+Vector3.new(math.sin(slot*1.9)*.45,age*.25,0))*CFrame.Angles(0,t*3+slot,.18)*CFrame.new(piece==2 and .007 or 0,0,0)
  else
   local nextSample=state.samples[#state.samples-slot];if not nextSample or(sample.pos-nextSample.pos).Magnitude&gt;8 then p.Transparency=1;continue end
   local phase=math.floor(t*13)+slot*7;local midpoint=(sample.pos+nextSample.pos)*.5+Vector3.new(math.sin(phase*2.1)*.28,math.cos(phase*1.7)*.28,0)
   local a=piece==1 and sample.pos or midpoint;local b=piece==1 and midpoint or nextSample.pos;local length=(b-a).Magnitude
   if length&gt;.001 then p.Size=Vector3.new(piece==1 and .055 or .035,.045,length);p.CFrame=CFrame.lookAt((a+b)*.5,b)else p.Transparency=1 end
  end
 end end
end
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_STEAL60_V61_AvatarPreview"><Properties><string name="Name">AvatarPreview</string><ProtectedString name="Source">-- Rebuild a static mannequin from its joints before measuring a portrait.
-- Stray streamed accessories never dictate the camera distance.
local M={}
local function visibleBody(p,model)
 return p:IsA('BasePart')and p.Parent==model and p.Name~='HumanoidRootPart'and p.Transparency&lt;1
end
function M.prepare(model)
 local root=model:FindFirstChild('HumanoidRootPart')or model.PrimaryPart or model:FindFirstChild('Torso')
 if not root then return end
 local joints={}
 for _,j in ipairs(model:GetDescendants())do
  if(j:IsA('Motor6D')or j:IsA('Weld'))and j.Part0 and j.Part1 then joints[#joints+1]=j end
 end
 local placed={[root]=true}
 -- Solve both directions: AccessoryWeld convention often starts at Handle.
 for _=1,24 do
  local changed=false
  for _,j in ipairs(joints)do
   local a,b=j.Part0,j.Part1;local transform=j:IsA('Motor6D')and j.Transform or CFrame.identity
   if placed[a]and not placed[b]then b.CFrame=a.CFrame*j.C0*transform*j.C1:Inverse();placed[b]=true;changed=true
   elseif placed[b]and not placed[a]then a.CFrame=b.CFrame*j.C1*transform:Inverse()*j.C0:Inverse();placed[a]=true;changed=true end
  end
  if not changed then break end
 end
 for _,accessory in ipairs(model:GetChildren())do if accessory:IsA('Accessory')then
  local handle=accessory:FindFirstChild('Handle');local matched=false
  if handle and not placed[handle]then
   for _,a in ipairs(handle:GetChildren())do if a:IsA('Attachment')then
    for _,p in ipairs(model:GetChildren())do if p:IsA('BasePart')then
     local target=p:FindFirstChild(a.Name)
     if target and target:IsA('Attachment')then handle.CFrame=p.CFrame*target.CFrame*a.CFrame:Inverse();matched=true;break end
    end end
    if matched then break end
   end end
  end
 end end
 for _,p in ipairs(model:GetDescendants())do
  if p:IsA('BasePart')then p.Anchored=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false
  elseif p:IsA('BaseScript')then p:Destroy()end
 end
end
function M.bounds(model)
 local lo=Vector3.new(math.huge,math.huge,math.huge);local hi=-lo
 local function include(p)
  for _,x in ipairs({-1,1})do for _,y in ipairs({-1,1})do for _,z in ipairs({-1,1})do
   local v=p.CFrame*Vector3.new(x*p.Size.X/2,y*p.Size.Y/2,z*p.Size.Z/2)
   lo=Vector3.new(math.min(lo.X,v.X),math.min(lo.Y,v.Y),math.min(lo.Z,v.Z))
   hi=Vector3.new(math.max(hi.X,v.X),math.max(hi.Y,v.Y),math.max(hi.Z,v.Z))
  end end end
 end
 for _,p in ipairs(model:GetChildren())do if visibleBody(p,model)then include(p)end end
 if lo.X==math.huge then return model:GetBoundingBox()end
 local center=(lo+hi)*.5;local height=math.max(5,hi.Y-lo.Y)
 for _,p in ipairs(model:GetDescendants())do
  if p:IsA('BasePart')and p.Parent~=model and p.Transparency&lt;1 then
   local distance=(p.Position-center).Magnitude
   if distance&lt;height*1.3 and p.Size.Magnitude&lt;height*1.8 then include(p)end
  end
 end
 return CFrame.new((lo+hi)*.5),hi-lo
end
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_STEAL60_V61_CarGrounding"><Properties><string name="Name">CarGrounding</string><ProtectedString name="Source">-- Ground clearance comes from the real wheel geometry, never the model pivot or body height.
local M={}
local function lower(part)
 local cf=part.CFrame;local size=part.Size
 return part.Position.Y-(math.abs(cf.RightVector.Y)*size.X+math.abs(cf.UpVector.Y)*size.Y+math.abs(cf.LookVector.Y)*size.Z)*.5
end
function M.bottom(car)
 local lowest=math.huge
 for _,p in ipairs(car:GetDescendants())do if p:IsA('BasePart')and p.Name=='Tyre'then lowest=math.min(lowest,lower(p))end end
 if lowest==math.huge then
  for _,p in ipairs(car:GetDescendants())do if p:IsA('BasePart')and p.Transparency&lt;.95 and not p:GetAttribute('CosmeticOverlay')and not p:GetAttribute('TuningPart')then lowest=math.min(lowest,lower(p))end end
 end
 return lowest&lt;math.huge and lowest or car:GetPivot().Position.Y
end
function M.surface(position,exclude)
 local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude;params.FilterDescendantsInstances=exclude or{}
 -- Horizontal roads have their top at .2. Query high enough for sidewalks/showroom pads as well.
 local hit=workspace:Raycast(Vector3.new(position.X,20,position.Z),Vector3.new(0,-60,0),params)
 if hit and hit.Instance and(hit.Instance.Name=='Road'or hit.Instance.Name=='Intersection')then return hit.Position.Y end
 return .2
end
function M.place(car,surfaceY)
 local delta=(surfaceY or .2)+.055-M.bottom(car)
 if math.abs(delta)&gt;.001 then car:PivotTo(car:GetPivot()+Vector3.new(0,delta,0))end
 local body=car:FindFirstChild('Body',true)or car.PrimaryPart
 return body and body.Position.Y or car:GetPivot().Position.Y
end
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_STEAL60_V61_CarTuning"><Properties><string name="Name">CarTuning</string><ProtectedString name="Source">-- Ten independent upgrades fitted to the actual panels, axle centers and roof of each model.
local M={};local C=Color3.fromRGB;local carbon=C(25,31,40);local chrome=C(203,219,225);local cyan=C(70,237,224)
local stockNames={MachinedSpoke=true,CenterCap=true,RimInset=true,AlloyOuterLip=true}
function M.clear(car)
 local old=car:FindFirstChild('Steal60Tuning');if old then old:Destroy()end
 for _,p in ipairs(car:GetDescendants())do if p:IsA('BasePart')then
  local saved=p:GetAttribute('TuningStockTransparency')
  if saved~=nil then p.Transparency=saved;p:SetAttribute('TuningStockTransparency',nil)end
 end end
end
function M.apply(car,selection)
 M.clear(car);selection=selection or{}
 if not next(selection)then return end
 local body=car:FindFirstChild('Body',true)or car.PrimaryPart;if not body then return end
 local frame=car:GetPivot();local group=Instance.new('Folder');group.Name='Steal60Tuning';group.Parent=car
 local list=car:GetDescendants();local hood=car:FindFirstChild('HoodSurface',true);local deck=car:FindFirstChild('TailDeck',true)
 local roof=car:FindFirstChild('RoofPanel',true);local shell=car:FindFirstChild('BodyShell',true)or body
 local shellCF=frame:ToObjectSpace(shell.CFrame);local hoodCF=hood and frame:ToObjectSpace(hood.CFrame)or shellCF*CFrame.new(body.Size.X*.29,body.Size.Y*.6,0)
 local length=car:GetAttribute('DesignLength')or body.Size.X/.84;local width=car:GetAttribute('DesignWidth')or body.Size.Z/.73
 local top=hood and hood.Position.Y-frame.Position.Y+hood.Size.Y*.5 or shellCF.Position.Y+shell.Size.Y*.5
 local function piece(name,size,cf,col,material,shape,wheelId,center)
  local p=Instance.new('Part');p.Name=name;p.Size=size;p.CFrame=frame*cf;p.Color=col or carbon;p.Material=material or Enum.Material.Metal
  p.Shape=shape or Enum.PartType.Block;p.Anchored=body.Anchored;p.Massless=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.CastShadow=false
  p:SetAttribute('TuningPart',true);p.Parent=group
  if wheelId then p:SetAttribute('WheelAssembly',wheelId);p:SetAttribute('WheelAssemblyCenter',center)end
  if not p.Anchored then
   local rig=car:FindFirstChild('DriveRig');local mount=wheelId and rig and rig:FindFirstChild('WheelPivot_'..wheelId)or body
   local w=Instance.new('WeldConstraint');w.Part0=mount or body;w.Part1=p;w.Parent=p
  end
  return p
 end
 local function rod(name,a,b,thickness,color,material,wheelId,center)
  local delta=b-a;if delta.Magnitude&lt;.001 then return end
  return piece(name,Vector3.new(thickness,thickness,delta.Magnitude),CFrame.lookAt((a+b)*.5,b),color,material,nil,wheelId,center)
 end
 local function hide(p)
  if p and p:GetAttribute('TuningStockTransparency')==nil then p:SetAttribute('TuningStockTransparency',p.Transparency);p.Transparency=1 end
 end
 if selection.tune_spoiler then
  for _,p in ipairs(list)do if p:IsA('BasePart')and(p.Name=='AeroWing'or p.Name=='WingUpright'or p.Name=='WingStanchion'or p.Name=='WingEndPlate')then hide(p)end end
  local base=deck and frame:ToObjectSpace(deck.CFrame)or CFrame.new(-length*.34,roof and roof.Position.Y-frame.Position.Y or top,0)
  local wingY=(deck and deck.Size.Y*.5 or .15)+.66
  for _,s in ipairs({-1,1})do
   piece('WingPylon',Vector3.new(.16,.64,.14),base*CFrame.new(0,wingY-.34,s*width*.27),chrome)
   piece('WingEndplate',Vector3.new(.84,.39,.08),base*CFrame.new(-.04,wingY+.02,s*width*.43),carbon)
  end
  piece('CarbonAerofoil',Vector3.new(.88,.14,width*.88),base*CFrame.new(-.04,wingY,0)*CFrame.Angles(0,0,-.08),carbon)
  piece('WingTrailingLip',Vector3.new(.065,.055,width*.84),base*CFrame.new(-.47,wingY+.07,0),chrome)
 end
 if selection.tune_hood then
  for _,p in ipairs(list)do if p:IsA('BasePart')and p.Name=='HoodExtractor'then hide(p)end end
  local hx=hood and hood.Size.X or length*.28;local hz=hood and hood.Size.Z or width*.75;local hy=hood and hood.Size.Y*.5 or .1
  piece('RaisedSportHood',Vector3.new(hx*.58,.14,hz*.48),hoodCF*CFrame.new(-hx*.06,hy+.10,0),carbon)
  piece('IntakeMouth',Vector3.new(.12,.22,hz*.34),hoodCF*CFrame.new(hx*.20,hy+.19,0),C(9,14,22))
  for _,s in ipairs({-1,1})do for i=1,3 do
   piece('HoodHeatExtractor',Vector3.new(hx*.20,.07,hz*.045),hoodCF*CFrame.new(hx*(-.27+i*.14),hy+.055,s*hz*.34)*CFrame.Angles(0,s*.12,0),carbon)
  end end
 end
 if selection.tune_wheels then
  local axles={}
  for _,p in ipairs(list)do if p:IsA('BasePart')and p.Name=='Tyre'then
   local id=p:GetAttribute('WheelAssembly');local center=p:GetAttribute('WheelAssemblyCenter')
   if id and typeof(center)=='Vector3'then axles[#axles+1]={id=id,center=center,radius=p.Size.Y*.5}end
  end end
  for _,p in ipairs(list)do if p:IsA('BasePart')and p:GetAttribute('WheelAssembly')and stockNames[p.Name]then hide(p)end end
  for _,axle in ipairs(axles)do
   local s=axle.center.Z&gt;=0 and 1 or-1;local r=axle.radius;local pos=axle.center+Vector3.new(0,0,s*.49)
   piece('ForgedRimWell',Vector3.new(.045,r*1.40,r*1.40),CFrame.new(pos)*CFrame.Angles(0,math.pi/2,0),C(15,24,33),Enum.Material.Metal,Enum.PartType.Cylinder,axle.id,axle.center)
   for i=1,5 do
    local a=i*math.pi*2/5
    local inner=pos+Vector3.new(math.cos(a)*r*.16,math.sin(a)*r*.16,s*.025)
    local mid=pos+Vector3.new(math.cos(a)*r*.44,math.sin(a)*r*.44,s*.045)
    rod('ForgedSplitSpoke',inner,mid,.075,chrome,Enum.Material.Metal,axle.id,axle.center)
    for _,fork in ipairs({-.11,.11})do
     local outer=pos+Vector3.new(math.cos(a+fork)*r*.69,math.sin(a+fork)*r*.69,s*.025)
     rod('ForgedSpokeFork',mid,outer,.055,chrome,Enum.Material.Metal,axle.id,axle.center)
    end
   end
   piece('ForgedHub',Vector3.new(.055,r*.29,r*.29),CFrame.new(pos+Vector3.new(0,0,s*.05))*CFrame.Angles(0,math.pi/2,0),cyan,Enum.Material.Metal,Enum.PartType.Cylinder,axle.id,axle.center)
  end
 end
 if selection.tune_neon then
  local y=.20;local accent=car:GetAttribute('TuningNeonColor')or cyan
  for _,s in ipairs({-1,1})do
   local strip=piece('UnderbodyLightRail',Vector3.new(length*.65,.07,.10),CFrame.new(0,y,s*width*.36),accent,Enum.Material.Neon)
   local light=Instance.new('PointLight');light.Color=accent;light.Brightness=.55;light.Range=5;light.Shadows=false;light.Parent=strip
   piece('UnderbodyEndGlow',Vector3.new(.10,.07,width*.64),CFrame.new(s*length*.35,y,0),accent,Enum.Material.Neon)
  end
 end
 if selection.tune_splitter then
  for _,p in ipairs(list)do if p:IsA('BasePart')and(p.Name=='CarbonFrontSplitter'or p.Name=='FrontSplitterCorner')then hide(p)end end
  local x=length*.50;local y=math.max(.36,shellCF.Position.Y-shell.Size.Y*.43)
  piece('FrontSplitterBlade',Vector3.new(.76,.09,width*.91),CFrame.new(x-.04,y,0),carbon)
  piece('SplitterSilverEdge',Vector3.new(.055,.045,width*.91),CFrame.new(x+.32,y+.015,0),chrome)
  for _,s in ipairs({-1,1})do
   piece('SplitterWinglet',Vector3.new(.46,.16,.07),CFrame.new(x-.08,y+.08,s*width*.45),carbon)
   rod('SplitterSupport',Vector3.new(x+.12,y+.03,s*width*.26),Vector3.new(x-.04,y+.46,s*width*.26),.045,chrome)
  end
 end
 if selection.tune_diffuser then
  for _,p in ipairs(list)do if p:IsA('BasePart')and(p.Name=='RearDiffuser'or p.Name=='DiffuserFin')then hide(p)end end
  local x=-length*.49;local y=math.max(.39,shellCF.Position.Y-shell.Size.Y*.43)
  piece('RearDiffuserTray',Vector3.new(.75,.12,width*.76),CFrame.new(x+.05,y,0)*CFrame.Angles(0,0,-.08),carbon)
  for i=-2,2 do piece('RearDiffuserFin',Vector3.new(.77,.25,.055),CFrame.new(x+.08,y-.055,i*width*.115),carbon)end
 end
 if selection.tune_skirts then
  for _,p in ipairs(list)do if p:IsA('BasePart')and p.Name=='BlackSideSkirt'then hide(p)end end
  for _,s in ipairs({-1,1})do
   local y=math.max(.36,shellCF.Position.Y-shell.Size.Y*.46)
   piece('AeroSideSkirt',Vector3.new(length*.46,.16,.28),CFrame.new(-.04,y,s*width*.46),carbon)
   piece('SkirtMetalAccent',Vector3.new(length*.41,.035,.045),CFrame.new(-.04,y+.09,s*width*.48),chrome)
   piece('SkirtRearBlade',Vector3.new(.44,.28,.09),CFrame.new(-length*.22,y+.09,s*width*.48)*CFrame.Angles(0,0,-.14),carbon)
  end
 end
 if selection.tune_roofscoop then
  local panel=roof or deck or hood
  local base=panel and frame:ToObjectSpace(panel.CFrame)or hoodCF
  local y=panel and panel.Size.Y*.5 or .15
  local len=panel and math.min(1.3,panel.Size.X*.5)or .9;local w=width*.17
  piece('RoofIntakeBase',Vector3.new(len,.13,w),base*CFrame.new(0,y+.09,0),carbon)
  piece('RoofIntakeCrown',Vector3.new(len*.76,.12,w*.92),base*CFrame.new(-len*.10,y+.32,0)*CFrame.Angles(0,0,-.12),carbon)
  for _,s in ipairs({-1,1})do piece('RoofIntakeCheek',Vector3.new(len,.27,.07),base*CFrame.new(0,y+.22,s*w*.46),carbon)end
  piece('RoofIntakeMesh',Vector3.new(.07,.17,w*.78),base*CFrame.new(len*.42,y+.21,0),C(7,14,22))
 end
 if selection.tune_exhaust then
  for _,p in ipairs(list)do if p:IsA('BasePart')and p.Name=='DoubleExhaust'then hide(p)end end
  local y=math.max(.47,shellCF.Position.Y-shell.Size.Y*.40)
  for _,s in ipairs({-1,1})do for i=0,1 do
   local z=s*(width*.28+i*.26);local x=-length*.51
   piece('TitaniumExhaustTip',Vector3.new(.44,.23,.23),CFrame.new(x,y,z),chrome,Enum.Material.Metal,Enum.PartType.Cylinder)
   piece('ExhaustDarkBore',Vector3.new(.025,.17,.17),CFrame.new(x-.23,y,z),C(6,11,17),Enum.Material.Metal,Enum.PartType.Cylinder)
  end end
 end
 if selection.tune_mirrors then
  for _,p in ipairs(list)do if p:IsA('BasePart')and(p.Name=='MirrorHousing'or p.Name=='MirrorGlass'or p.Name=='MirrorStem'or p.Name=='SideMirror')then hide(p)end end
  for _,s in ipairs({-1,1})do
   local original
   for _,p in ipairs(list)do if p:IsA('BasePart')and p.Name=='SideMirror'then
    local pos=frame:PointToObjectSpace(p.Position);if pos.Z*s&gt;0 then original=pos;break end
   end end
   local center=original and original+Vector3.new(.02,0,s*.10)or Vector3.new(length*.11,top+.10,s*width*.49)
   rod('CarbonMirrorStalk',center-Vector3.new(.08,.11,s*.30),center,.075,carbon)
   piece('CarbonSportMirror',Vector3.new(.49,.23,.28),CFrame.new(center)*CFrame.Angles(0,-s*.16,0),carbon)
   piece('MirrorBlueGlass',Vector3.new(.045,.15,.23),CFrame.new(center+Vector3.new(-.245,0,0)),C(119,179,200),Enum.Material.Glass)
  end
 end
 group:SetAttribute('FittedCarId',car:GetAttribute('CarId'));return group
end
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_STEAL60_V62_CollectibleArt"><Properties><string name="Name">CollectibleArt</string><ProtectedString name="Source">-- The same sculpted collectible geometry is used in the showroom and static menu cards.
local M={};local P={}
function P.part(parent,name,size,pos,color,material)
 local p=Instance.new('Part');p.Name=name;p.Size=size;p.CFrame=CFrame.new(pos);p.Color=color;p.Material=material
 p.Anchored=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.Massless=true;p.CollisionGroup='Steal60WorldDecor';p.Parent=parent
 return p
end
function M.create(parent, itemId, at, accent, isOwned, yaw)
    local group=Instance.new("Model")
    group.Name="Предмет · "..itemId
    group.Parent=parent
    local grey=Color3.fromRGB(113,125,137)
    local color=isOwned and accent or grey
    local dark=Color3.fromRGB(30,38,50)
    local black=Color3.fromRGB(17,23,33)
    local steel=Color3.fromRGB(147,163,176)
    local light=isOwned and Color3.fromRGB(190,240,250) or steel
    local function box(name, size, delta, tint, mat)
        return P.part(group,name,size,at+delta,tint or color,mat or Enum.Material.SmoothPlastic,false)
    end
    local function sphere(name, diameter, delta, tint)
        local part=box(name,Vector3.new(diameter,diameter,diameter),delta,tint)
        part.Shape=Enum.PartType.Ball
        return part
    end
    -- Roblox cylinders point along local X, hence rotate them to face the visitor (-Z).
    local function frontDisc(name,diam,depth,delta,tint)
        local part=box(name,Vector3.new(depth,diam,diam),delta,tint or color,Enum.Material.Metal)
        part.Shape=Enum.PartType.Cylinder
        part.CFrame=CFrame.new(at+delta)*CFrame.Angles(0,math.pi/2,0)
        return part
    end
    local function ring(name,radius,tint)
        local segments=12
        local chord=2*radius*math.sin(math.pi/segments)
        for j=0,segments-1 do
            local theta=(j+.5)*2*math.pi/segments
            local offset=Vector3.new(radius*math.cos(theta),radius*math.sin(theta),-.47)
            local part=box(name..j,Vector3.new(chord+.02,.13,.15),offset,tint,Enum.Material.Metal)
            part.CFrame=CFrame.new(at+offset)*CFrame.Angles(0,0,theta+math.pi/2)
        end
    end
    local function screen(name,width,height,delta,screenColor)
        box(name.." корпус",Vector3.new(width+.12,height+.12,.14),delta+Vector3.new(0,0,.03),black)
        box(name,Vector3.new(width,height,.07),delta,screenColor or color,Enum.Material.Neon)
    end
    if itemId=="tree_fresh" or itemId=="air_freshener" then
        -- Stacked tapered evergreen, a brown stem and a visible hanging loop.
        box("Ствол ароматизатора",Vector3.new(.16,.54,.18),Vector3.new(0,-.56,-.02),Color3.fromRGB(135,94,67),Enum.Material.Wood)
        local evergreen=isOwned and Color3.fromRGB(74,210,118) or grey
        for k=0,2 do
            local y=-.28+k*.33
            box("Ветви ёлочки "..k,Vector3.new(1.22-k*.31,.29,.25),Vector3.new(0,y,-.02),evergreen)
            local cone=box("Крона "..k,Vector3.new(.90-k*.24,.40,.25),Vector3.new(0,y+.16,-.02),evergreen)
            cone.CFrame=CFrame.new(at+Vector3.new(0,y+.16,-.02))*CFrame.Angles(0,0,math.rad(45))
        end
        sphere("Отверстие для верёвки",.16,Vector3.new(0,.72,-.14),dark)
        box("Шнурок",Vector3.new(.07,.34,.07),Vector3.new(0,.84,0),steel)
    elseif itemId=="fm_radio" or itemId=="radio_old" or itemId=="radio_fm" then
        box("Магнитола - корпус",Vector3.new(2.55,1.18,.62),Vector3.new(0,0,.08),dark)
        box("Лицевая панель",Vector3.new(2.39,1.0,.10),Vector3.new(0,0,-.29),steel,Enum.Material.Metal)
        if itemId=="radio_old" then
            box("Кассетный отсек",Vector3.new(1.13,.57,.10),Vector3.new(-.23,0,-.37),black)
            box("Окошко кассеты",Vector3.new(.97,.41,.06),Vector3.new(-.23,0,-.44),Color3.fromRGB(70,92,112),Enum.Material.Glass)
            frontDisc("Левая катушка",.24,.05,Vector3.new(-.52,.00,-.48),steel)
            frontDisc("Правая катушка",.24,.05,Vector3.new(.07,.00,-.48),steel)
        else
            screen("FM дисплей",1.21,.49,Vector3.new(-.23,.08,-.41),color)
            for j=0,3 do
                box("Кнопка памяти "..j,Vector3.new(.17,.10,.07),Vector3.new(-.65+j*.25,-.32,-.39),black)
            end
        end
        frontDisc("Регулятор громкости",.36,.13,Vector3.new(.98,0,-.43),dark)
        frontDisc("Серебряный ободок",.20,.13,Vector3.new(.98,0,-.54),light)
    elseif itemId=="car_speakers" then
        for side=-1,1,2 do
            local x=side*.76
            box("Корпус колонки",Vector3.new(1.17,1.58,.73),Vector3.new(x,0,.06),dark)
            frontDisc("Басовый диффузор",.92,.12,Vector3.new(x,-.23,-.36),color)
            frontDisc("Защитная шайба",.32,.14,Vector3.new(x,-.23,-.45),black)
            frontDisc("Высокочастотный динамик",.34,.09,Vector3.new(x,.52,-.38),steel)
        end
    elseif itemId=="subwoofer" then
        box("Корпус сабвуфера",Vector3.new(2.15,1.85,.85),Vector3.new(0,0,.09),dark)
        frontDisc("Резиновый подвес",1.61,.12,Vector3.new(0,0,-.43),black)
        frontDisc("Мембрана",1.38,.14,Vector3.new(0,0,-.51),color)
        frontDisc("Пылезащитный колпачок",.53,.15,Vector3.new(0,0,-.60),black)
        box("Бас-рефлекс",Vector3.new(.26,.18,.13),Vector3.new(.83,-.68,-.42),steel)
    elseif itemId=="gps_unit" or itemId=="multimedia" or itemId=="dash_screen" then
        box("Навигатор корпус",Vector3.new(2.62,1.48,.33),Vector3.new(0,0,0),dark)
        screen("Карта навигатора",2.23,1.12,Vector3.new(0,.05,-.23),Color3.fromRGB(40,79,94))
        for j=-1,1,2 do
            box("Схема дороги",Vector3.new(.055,.84,.035),Vector3.new(j*.36,0,-.29),Color3.fromRGB(110,145,156))
        end
        box("Маршрут",Vector3.new(1.42,.075,.045),Vector3.new(0,-.13,-.32),color,Enum.Material.Neon)
        sphere("Пункт назначения",.23,Vector3.new(.52,-.13,-.37),light)
        box("Ножка навигатора",Vector3.new(.17,.42,.16),Vector3.new(0,-.88,.10),steel)
    elseif itemId=="led_trim" or itemId=="neon_kit" then
        for j=1,3 do
            local y=(j-2)*.43
            box("LED лента "..j,Vector3.new(2.52,.16,.19),Vector3.new(0,y,-.11),color,Enum.Material.Neon)
            for k=-3,3 do
                sphere("Диод",.085,Vector3.new(k*.31,y,-.23),light)
            end
        end
        box("Контроллер LED",Vector3.new(.48,.54,.39),Vector3.new(-.9,-.65,.15),dark)
    elseif itemId=="ambient_lighting" then
        box("Модуль салонного света",Vector3.new(2.32,1.40,.30),Vector3.new(0,0,.05),dark)
        for j=1,3 do
            local y=(j-2)*.41
            box("Световой контур",Vector3.new(1.92,.10,.12),Vector3.new(0,y,-.22),color,Enum.Material.Neon)
        end
        box("Кнопка оттенка",Vector3.new(.32,.32,.08),Vector3.new(.81,-.54,-.25),light)
    elseif itemId=="sport_gauges" then
        box("Панель приборов",Vector3.new(2.62,1.16,.42),Vector3.new(0,0,.08),dark)
        for j=-1,1 do
            local x=j*.75
            frontDisc("Ободок шкалы",.73,.07,Vector3.new(x,0,-.21),steel)
            frontDisc("Циферблат",.56,.07,Vector3.new(x,0,-.31),black)
            local needle=box("Стрелка приборов",Vector3.new(.30,.05,.045),Vector3.new(x+.10,.08,-.36),color)
            needle.CFrame=CFrame.new(at+Vector3.new(x+.10,.08,-.36))*CFrame.Angles(0,0,math.rad(40))
            sphere("Ось стрелки",.09,Vector3.new(x,0,-.37),light)
        end
    elseif itemId=="velour_mats" or itemId=="mats" then
        for side=-1,1,2 do
            local x=side*.64
            box("Велюровый коврик",Vector3.new(1.02,.13,1.53),Vector3.new(x,-.28,0),color,Enum.Material.Fabric)
            box("Окантовка коврика",Vector3.new(.86,.04,1.38),Vector3.new(x,-.20,0),dark,Enum.Material.Fabric)
            for j=-1,1 do
                box("Рельефная прострочка",Vector3.new(.06,.04,1.00),Vector3.new(x+j*.27,-.16,0),steel)
            end
        end
    elseif itemId=="seat_covers" or itemId=="cover_basic" or itemId=="leather" then
        for side=-1,1,2 do
            local x=side*.70
            box("Сиденье подушка",Vector3.new(1.02,.29,.94),Vector3.new(x,-.48,.21),color,Enum.Material.Fabric)
            local back=box("Чехол спинки",Vector3.new(.99,1.34,.23),Vector3.new(x,.23,.49),color,Enum.Material.Fabric)
            back.CFrame=CFrame.new(at+Vector3.new(x,.23,.49))*CFrame.Angles(math.rad(-7),0,0)
            box("Подголовник",Vector3.new(.64,.36,.26),Vector3.new(x,.89,.47),dark,Enum.Material.Fabric)
            box("Шов чехла",Vector3.new(.62,.04,.10),Vector3.new(x,.27,.31),steel)
        end
    elseif itemId=="sport_wheel" or itemId=="carbon_wheel" then
        -- True open twelve-segment steering rim rather than an opaque flat cylinder.
        ring("Оплётка спортивного руля",.80,dark)
        for j=0,2 do
            local theta=j*2*math.pi/3
            local x=.37*math.cos(theta)
            local y=.37*math.sin(theta)
            local spoke=box("Спица руля",Vector3.new(.64,.15,.14),Vector3.new(x,y,-.45),steel,Enum.Material.Metal)
            spoke.CFrame=CFrame.new(at+Vector3.new(x,y,-.45))*CFrame.Angles(0,0,theta)
        end
        frontDisc("Центральная ступица руля",.54,.19,Vector3.new(0,0,-.49),color)
        frontDisc("Кнопка сигнала",.23,.12,Vector3.new(0,0,-.62),dark)
    elseif itemId=="dash_camera" then
        box("Корпус видеорегистратора",Vector3.new(1.72,.71,.65),Vector3.new(0,-.04,.07),dark)
        frontDisc("Кольцо объектива",.53,.15,Vector3.new(.39,-.05,-.32),steel)
        frontDisc("Линза",.30,.12,Vector3.new(.39,-.05,-.43),Color3.fromRGB(31,91,139))
        box("Экран камеры",Vector3.new(.60,.38,.06),Vector3.new(-.50,-.06,-.32),color)
        box("Крепёж к стеклу",Vector3.new(.24,.43,.22),Vector3.new(0,.47,.06),steel)
        box("Присоска",Vector3.new(.95,.13,.55),Vector3.new(0,.76,.08),dark)
    elseif itemId=="carbon_kit" or itemId=="gold_kit" then
        local isGold=itemId=="gold_kit"
        local trim=isGold and Color3.fromRGB(245,199,69) or Color3.fromRGB(89,101,110)
        box("Передний сплиттер",Vector3.new(2.90,.16,.82),Vector3.new(0,-.46,.05),trim,Enum.Material.Metal)
        box("Аэродинамический плавник",Vector3.new(.18,.73,.57),Vector3.new(-.90,-.05,0),dark,Enum.Material.Metal)
        box("Крыло спойлера",Vector3.new(2.42,.15,.58),Vector3.new(0,.54,-.10),trim,Enum.Material.Metal)
        for side=-1,1,2 do
            box("Опора спойлера",Vector3.new(.13,.61,.14),Vector3.new(side*.70,.19,.09),dark)
        end
    else
        box("Корпус аксессуара",Vector3.new(1.82,1.12,.75),Vector3.zero,color,Enum.Material.Metal)
        box("Фасад",Vector3.new(1.44,.70,.12),Vector3.new(0,0,-.46),dark)
    end
    -- Star accessories stand along the LEFT wall (looking toward +X), whereas
    -- passive-income shelves face the salon entrance. Both use the same shapes.
    if yaw and math.abs(yaw)&gt;.001 then
        local center=CFrame.new(at)
        local rotation=CFrame.Angles(0,yaw,0)
        for _,piece in ipairs(group:GetDescendants()) do
            if piece:IsA("BasePart") then
                piece.CFrame=center*rotation*center:ToObjectSpace(piece.CFrame)
            end
        end
    end

    return group
end

return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_STEAL60_V62_HUDLayout"><Properties><string name="Name">HUDLayout</string><ProtectedString name="Source">-- One active modal and one opt-in, scrollable details stack; lower corners stay free.
local M={};local modals={MainMenu=true,CosmeticShopV44=true,Steal60NPCShopV35=true,Steal60Handbook=true}
local roles={HeistProgress='daily',RoadEventBoard='road',TheftProgress='theft'}
function M.driving(player)
 local ref=player:FindFirstChild('Steal60DriveCar');if ref and ref.Value then return true end
 local h=player.Character and player.Character:FindFirstChildOfClass('Humanoid');return h and h.SeatPart~=nil or false
end
function M.suppressHud(player)
 return player:GetAttribute('Steal60MenuOpen')==true or player:GetAttribute('HackActive')==true or player:GetAttribute('CosmeticPreviewToken')~=nil or player:GetAttribute('Steal60ToastActive')==true
end
function M.compactDetails(player)
 local camera=workspace.CurrentCamera;return player:GetAttribute('Steal60DetailsOpen')==true and camera and camera.ViewportSize.Y&lt;500
end
function M.detailsVisible(player,role)
 if not player:GetAttribute('Steal60DetailsOpen')or M.suppressHud(player)or M.driving(player)then return false end
 if role=='daily'then return(player:GetAttribute('HeistQuestsDone')or 0)&lt;3 end
 if role=='road'then return player:GetAttribute('RoadContractTitle')~=nil end
 return player:GetAttribute('TutorialComplete')==true
end
function M.start(gui)
 if M.started then return end;M.started=true
 local player=game:GetService('Players').LocalPlayer;local Run=game:GetService('RunService')
 local watched={};local panels={};local busy=false
 local dock=Instance.new('ScrollingFrame');dock.Name='DetailsDock';dock.AnchorPoint=Vector2.new(1,0);dock.Position=UDim2.new(1,-12,0,162);dock.Size=UDim2.fromOffset(300,320)
 dock.BackgroundTransparency=1;dock.BorderSizePixel=0;dock.ScrollBarThickness=4;dock.AutomaticCanvasSize=Enum.AutomaticSize.Y;dock.CanvasSize=UDim2.new();dock.Visible=false;dock.Parent=gui
 local list=Instance.new('UIListLayout');list.SortOrder=Enum.SortOrder.LayoutOrder;list.Padding=UDim.new(0,8);list.Parent=dock
 local function modalState()
  for frame in pairs(panels)do if frame.Parent and frame.Visible then return frame.Name end end
 end
 local function sync()
  if busy then return end
  local active=modalState();player:SetAttribute('Steal60ActiveModal',active);player:SetAttribute('Steal60MenuOpen',active~=nil)
 end
 local function watch(frame)
  if watched[frame]or not frame:IsA('Frame')then return end;watched[frame]=true
  if modals[frame.Name]then
   panels[frame]=true
   local function claim()
    if busy then return end
    if frame.Visible then
     busy=true
     for other in pairs(panels)do if other~=frame and other.Parent and other.Visible then
      other.Visible=false;if other.Name=='Steal60Handbook'then other:Destroy()end
     end end
     player:SetAttribute('Steal60DetailsOpen',false);busy=false
    end
    sync()
   end
   frame:GetPropertyChangedSignal('Visible'):Connect(claim)
   frame.Destroying:Connect(function()panels[frame]=nil;sync()end)
   if frame.Visible then claim()end
  elseif roles[frame.Name]then
   local height=frame.Size.Y.Offset;frame.Parent=dock;frame.AnchorPoint=Vector2.new(0,0);frame.Position=UDim2.new();frame.Size=UDim2.new(1,-7,0,height)
   frame.LayoutOrder=frame.Name=='HeistProgress'and 1 or frame.Name=='RoadEventBoard'and 2 or 3
  end
 end
 gui.DescendantAdded:Connect(watch);for _,frame in ipairs(gui:GetDescendants())do watch(frame)end
 local elapsed=0
 Run.Heartbeat:Connect(function(dt)
  elapsed+=dt;if elapsed&lt;.1 then return end;elapsed=0
  local camera=workspace.CurrentCamera;local width=camera and camera.ViewportSize.X or 1024;local height=camera and camera.ViewportSize.Y or 768
  local top=height&lt;500 and 66 or 162
  dock.Position=UDim2.new(1,-12,0,top);dock.Size=UDim2.fromOffset(math.min(300,width-24),math.max(45,math.min(380,height-top-180)))
  local any=false
  for _,frame in ipairs(dock:GetChildren())do local role=roles[frame.Name];if role then frame.Visible=M.detailsVisible(player,role);any=any or frame.Visible end end
  dock.Visible=any
  local status=gui:FindFirstChild('StatusHUD');if status then status.Visible=not M.suppressHud(player)end
  local trial=gui:FindFirstChild('CosmeticTryOnCountdown');if trial then trial.Position=UDim2.new(.5,0,0,56);trial.Visible=player:GetAttribute('CosmeticPreviewToken')~=nil and not player:GetAttribute('Steal60MenuOpen')end
  sync()
 end)
end
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_STEAL60_V62_MenuWidgets"><Properties><string name="Name">MenuWidgets</string><ProtectedString name="Source">-- Static illustrated cards, shared palette and explicit actions across the main menu.
local Shared=script.Parent;local Cars=require(Shared.Config.Cars);local Vehicles=require(Shared.CarVisualLibrary)
local Collectibles=require(Shared.CollectibleArt);local Pets=require(Shared.PetVisualLibrary);local Cosmetics=require(Shared.Config.CosmeticConfig)
local Avatar=require(Shared.AvatarPreview);local W={};local C=Color3.fromRGB
W.accent=C(123,232,194);W.ink=C(14,24,36);W.light=C(237,245,247)
function W.fmt(n)local s=tostring(math.floor(tonumber(n)or 0));return s:reverse():gsub('(%d%d%d)','%1 '):reverse():gsub('^ ','')end
function W.round(p,r)local c=Instance.new('UICorner');c.CornerRadius=UDim.new(0,r or 10);c.Parent=p end
function W.text(p,value,pos,size,pt,color)
 local t=Instance.new('TextLabel');t.BackgroundTransparency=1;t.Text=tostring(value or'');t.Position=pos;t.Size=size;t.Font=Enum.Font.GothamBold;t.TextSize=pt or 13;t.TextColor3=color or W.light;t.TextWrapped=true;t.TextXAlignment=Enum.TextXAlignment.Left;t.TextYAlignment=Enum.TextYAlignment.Top;t.Parent=p;return t
end
function W.button(p,value,pos,size,fn,enabled,color)
 local b=Instance.new('TextButton');b.Text=value;b.Position=pos;b.Size=size;b.Font=Enum.Font.GothamBold;b.TextSize=12;b.TextWrapped=true;b.BorderSizePixel=0;b.TextColor3=C(15,30,37);b.BackgroundColor3=enabled==false and C(76,91,103)or color or W.accent;b.Active=enabled~=false;b.AutoButtonColor=enabled~=false;b.Parent=p;W.round(b,8)
 if fn and enabled~=false then b.Activated:Connect(fn)end;return b
end
function W.order(parent,object)
 local index=(parent:GetAttribute('MenuRowSequence')or 0)+1;parent:SetAttribute('MenuRowSequence',index);object.LayoutOrder=index
end
function W.box(p,height)
 local f=Instance.new('Frame');W.order(p,f);f.Size=UDim2.new(1,-10,0,height);f.BorderSizePixel=0;f.BackgroundColor3=W.ink;f.Parent=p;W.round(f,12)
 local line=Instance.new('UIStroke');line.Thickness=1;line.Transparency=.6;line.Color=C(89,170,179);line.Parent=f
 return f
end
function W.header(p,title,description)
 local compact=p.AbsoluteSize.X&gt;0 and p.AbsoluteSize.X&lt;570
 local f=W.box(p,compact and 100 or 75);W.text(f,title,UDim2.fromOffset(14,10),UDim2.new(1,-28,0,compact and 38 or 24),compact and 15 or 18,W.accent);W.text(f,description,UDim2.fromOffset(14,compact and 54 or 39),UDim2.new(1,-28,0,compact and 38 or 30),12,C(174,204,219));return f
end
function W.summary(p,metrics)
 local f=W.box(p,92)
 for i,item in ipairs(metrics)do
  local x=(i-1)/#metrics
  W.text(f,item[1],UDim2.new(x,12,0,13),UDim2.new(1/#metrics,-22,0,22),11,C(158,197,214))
  W.text(f,item[2],UDim2.new(x,12,0,42),UDim2.new(1/#metrics,-22,0,34),19,item[3]or W.accent)
 end
 return f
end
function W.bar(parent,value,maximum,pos,width,color)
 local track=Instance.new('Frame');track.Position=pos;track.Size=UDim2.new(width or 1,-16,0,6);track.BorderSizePixel=0;track.BackgroundColor3=C(44,62,76);track.Parent=parent;W.round(track,4)
 local fill=Instance.new('Frame');fill.Size=UDim2.fromScale(math.clamp((value or 0)/math.max(1,maximum or 1),0,1),1);fill.BorderSizePixel=0;fill.BackgroundColor3=color or W.accent;fill.Parent=track;W.round(fill,4);return track
end
local function symbol(kind,color)
 local model=Instance.new('Model')
 local function part(name,size,cf,col,shape)
  local p=Instance.new('Part');p.Name=name;p.Size=size;p.CFrame=cf;p.Color=col or color;p.Material=Enum.Material.Metal;p.Anchored=true;p.CanCollide=false;p.CanQuery=false;p.Shape=shape or Enum.PartType.Block;p.Parent=model;return p
 end
 if kind=='gems'then
  for i=0,5 do local a=i*math.pi/3
   local p=Instance.new('WedgePart');p.Name='CrystalFacet';p.Size=Vector3.new(.73,1.7,.8);p.CFrame=CFrame.new(math.cos(a)*.35,0,math.sin(a)*.35)*CFrame.Angles(0,-a,0);p.Color=i%2==0 and color or C(173,247,255);p.Material=Enum.Material.Glass;p.Anchored=true;p.CanCollide=false;p.Parent=model
  end
 elseif kind=='shelves'then
  for row=0,2 do
   part('Shelf',Vector3.new(3,.13,1.3),CFrame.new(0,row-.8,0),C(92,128,147))
   for j=-1,1 do part('CollectibleBox',Vector3.new(.55,.58,.55),CFrame.new(j,row-.45,0),j==0 and color or C(183,207,190))end
  end
 elseif kind=='security'or kind=='vip'then
  part('Badge',Vector3.new(1.5,1.8,.25),CFrame.new(),color)
  part('BadgeInset',Vector3.new(1.15,1.35,.3),CFrame.new(0,0,-.03),C(37,60,80))
  for i=-2,2 do part('CrownPoint',Vector3.new(.2,.45,.32),CFrame.new(i*.28,1+math.abs(i)*.07,0),color)end
 else
  for i=0,7 do
   local column=i%3;local row=math.floor(i/3)
   part('Coin',Vector3.new(.13,.85,.85),CFrame.new((column-1)*.75,row*.16-.4,0)*CFrame.Angles(0,0,math.pi/2),i%2==0 and color or C(245,206,112),Enum.PartType.Cylinder)
  end
 end
 return model
end
function W.preview(parent,kind,id,color)
 color=color or W.accent
 local view=Instance.new('ViewportFrame');view.Name='StaticMenuIllustration';view.BackgroundColor3=C(23,38,54);view.BorderSizePixel=0;view.Ambient=C(190,205,219);view.LightColor=C(255,244,222);view.LightDirection=Vector3.new(-.7,-1,-.8);view.Parent=parent;W.round(view,10)
 local world=Instance.new('WorldModel');world.Parent=view
 local model
 if kind=='car'then local d=Cars.ById[id]or Cars[1];model=Vehicles.build(d,d.class)
 elseif kind=='item'then model=Collectibles.create(world,id,Vector3.zero,color,true,0)
 elseif kind=='pet'then model=Pets.create(Cosmetics.ById[id]or Cosmetics.ById.pet_turtle)
 elseif kind=='hero'then
  local folder=game:GetService('ReplicatedStorage'):FindFirstChild('Steal60CatalogPreviews');local d=Cosmetics.ById[id];local template=folder and folder:FindFirstChild(d and d.catalogLook or'mechanic')
  if template then model=template:Clone();Avatar.prepare(model)else model=symbol('vip',color)end
 else model=symbol(kind,color)end
 model.Parent=world
 local bounds,size
 if kind=='hero'then bounds,size=Avatar.bounds(model)else bounds,size=model:GetBoundingBox()end
 local focus=bounds.Position;local camera=Instance.new('Camera');camera.FieldOfView=35;camera.Parent=view;view.CurrentCamera=camera
 local dir=kind=='car'and Vector3.new(.65,.4,-.8)or Vector3.new(.25,.16,-1)
 camera.CFrame=CFrame.lookAt(focus+dir.Unit*math.max(size.X,size.Y,size.Z,1)*1.9,focus)
 return view
end
function W.card(p,options)
 local f=W.box(p,212);f.Name='IllustratedMenuCard'
 local compact=p.AbsoluteSize.X&gt;0 and p.AbsoluteSize.X&lt;570;local imageWidth=compact and 98 or 136;local textX=imageWidth+25;f:SetAttribute("TextColumnX",textX)
 local image=W.preview(f,options.kind or'coins',options.id,options.color);image.Position=UDim2.fromOffset(11,11);image.Size=UDim2.fromOffset(imageWidth,139)
 local title=W.text(f,options.title,UDim2.fromOffset(textX,14),UDim2.new(1,-textX-12,0,38),compact and 14 or 17,options.color or W.light);title.Name="CardTitle"
 W.text(f,options.description,UDim2.fromOffset(textX,58),UDim2.new(1,-textX-12,0,48),12,C(183,205,218))
 local value=W.text(f,options.value,UDim2.fromOffset(textX,112),UDim2.new(1,-textX-12,0,24),17,W.accent);value.Name="CardValue"
 if options.progress then W.bar(f,options.progress[1],options.progress[2],UDim2.fromOffset(textX,144),1,C(129,218,246)).Size=UDim2.new(1,-textX-14,0,6)end
 if options.action then W.button(f,options.action,UDim2.fromOffset(11,166),UDim2.new(1,-22,0,34),options.click,options.enabled,options.buttonColor)
 else W.text(f,options.footer or'',UDim2.fromOffset(12,170),UDim2.new(1,-24,0,30),11,C(160,190,206))end
 return f
end
return W
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_STEAL60_V62_MenuViews"><Properties><string name="Name">MenuViews</string><ProtectedString name="Source">-- Illustrated, read-only menu data with explicit server-validated actions.
local Shared=script.Parent;local W=require(Shared.MenuWidgets);local Cosmetics=require(Shared.Config.CosmeticConfig)
local Parts=require(Shared.Config.AccessoryConfig);local Rarity=require(Shared.Rarity);local Classes=require(Shared.Config.CarClasses)
local Cars=require(Shared.Config.Cars);local Loot=require(Shared.Config.Loot);local Packs=require(Shared.Config.MonetizationConfig);local VIP=require(Shared.Config.VIPConfig)
local M={};local actualPrices={};local C=Color3.fromRGB;local colors={common=C(194,213,219),rare=C(105,186,249),epic=C(201,137,248),legendary=C(255,210,105)}
local function invoke(a,key,...)if a[key]then a[key](...)end end
local function groupItems(data)
 local groups={}
 for _,source in ipairs({data.shelf or{},data.shelfStorage or{}})do
  for _,item in ipairs(source)do if item.id and not item.empty and not item.locked then
   local copy=groups[item.id]
   if not copy then copy=table.clone(item);copy.active=0;copy.reserve=0;groups[item.id]=copy end
   if source==data.shelf then copy.active+=1 else copy.reserve+=1 end
  end end
 end
 local list={};for _,item in pairs(groups)do list[#list+1]=item end
 table.sort(list,function(a,b)return(a.income or 0)&gt;(b.income or 0)end);return list
end
local function salon(parent,data,a)
 W.header(parent,'ТВОЙ САЛОН','Доставляй автомобили, собирай добычу и забирай доход в кассе у входа.')
 W.summary(parent,{{'КАССА',W.fmt(data.till)..' $'},{'ДОХОД В ЧАС',W.fmt((data.income or 0)*3600)..' $'},{'ОФЛАЙН',tostring(data.tillHours or 12)..' ч'}})
 local list=groupItems(data)
 W.header(parent,'ПОЛКИ И КОЛЛЕКЦИЯ',('На полках до %d предметов. Лучшие расставляются автоматически; запас сохраняется.'):format(data.shelfCapacity or 12))
 if #list==0 then W.card(parent,{kind='item',id='radio_old',title='Твоя первая добыча',description='Угони доступную машину и доставь её в зелёную рамку салона. Найденный предмет появится здесь.',value='Пока полки пусты',action='ОТКРЫТЬ РУКОВОДСТВО',click=function()invoke(a,'handbook')end})end
 for _,item in ipairs(list)do
  local copies=(data.lootCopies or{})[item.id]or item.copies or 0;local maximum=(item.stars or 0)&gt;=5
  W.card(parent,{kind='item',id=item.id,color=colors[item.rarity],title=item.name,description=('На полке: %d · в запасе: %d\nЗвёзды: %d/5 · копии для следующей: %d/5'):format(item.active,item.reserve,item.stars or 0,math.min(5,copies)),value='+'..W.fmt((item.income or 0)*3600)..' $/ч за штуку',progress={item.stars or 0,5},
   action=maximum and'МАКСИМУМ ЗВЁЗД'or('УЛУЧШИТЬ · 5 КОПИЙ + '..W.fmt(item.cost)..' $'),enabled=not maximum and copies&gt;=5 and(data.money or 0)&gt;=(item.cost or math.huge),click=function()invoke(a,'star',item.id)end})
 end
 local player=a.player
 if player then
  local done=player:GetAttribute('HeistQuestsDone')or 0
  W.header(parent,'ЕЖЕДНЕВНЫЕ ЦЕЛИ',done&gt;=3 and'Все цели дня выполнены. Новые появятся завтра.'or'Награды начисляются автоматически за доставки и точные взломы.')
  for _,q in ipairs({{'completed','Доставки',3},{'precise','Точный взлом',2},{'rare','Редкая машина',1}})do
   local value=player:GetAttribute('HeistQuest_'..q[1])or 0
   local f=W.box(parent,58);W.text(f,q[2]..'  '..value..'/'..q[3],UDim2.fromOffset(13,8),UDim2.new(1,-26,0,23),13);W.bar(f,value,q[3],UDim2.fromOffset(13,39),1)
  end
 end
end
local function collection(parent,data)
 W.header(parent,'ДЕТАЛИ ДЛЯ ТВОЕЙ КОЛЛЕКЦИИ','Добыча за доставки и налёты. Бонусы разных деталей складываются.')
 W.summary(parent,{{'ОБЩИЙ БОНУС','+'..tostring(data.theftIncomeBonusPct or 0)..'%'},{'ШАНС ЗА ДОСТАВКУ','7%'},{'НАЛЁТОВ ДО ДЕТАЛИ',tostring(50-(data.theftCount or 0)%50)}})
 for _,item in ipairs(data.theftParts or{})do
  local def=Parts.ById[item.id];local color=def and def.color or W.accent
  W.card(parent,{kind='item',id=item.id,color=color,title=item.name,description=item.owned and('Район '..item.zone..' · уровень '..item.level..'/20\n'..item.stage)or('Найди в районе '..item.zone..'. Дубликаты улучшают звёзды.'),value=item.owned and('+'..item.pct..'% к монетам')or'ЕЩЁ НЕ НАЙДЕНО',progress={item.level or 0,20},footer=item.maxed and'Коллекционная деталь улучшена полностью'or('До следующей звезды: '..tostring(item.copies or 0)..'/5 одинаковых копий')})
 end
end
local icon={speed='car',income='coins',botSpeed='car',security='security',shelves='shelves',till48h='coins',doubleIncome='coins',fastRide='car',masterThief='security',secondBot='car',autoCollect='coins'}
local function upgrades(parent,data,a)
 W.header(parent,'ПРОКАЧКА САЛОНА',"Монеты зарабатываются в игре. Алмазы ускоряют выбор; уровень взлома растёт только за ОПЫТ.")
 W.summary(parent,{{'МОНЕТЫ',W.fmt(data.money)},{'АЛМАЗЫ',W.fmt(data.diamonds)},{'ВЗЛОМ',tostring(data.hackLevel)..' ур.'}})
 for _,section in ipairs({{title='ЗА МОНЕТЫ',rows=data.coinUpgrades or{},currency='$',key='coin'},{title='ЗА АЛМАЗЫ',rows=data.upgrades or{},currency='💎',key='diamond'}})do
  W.header(parent,section.title,section.key=='coin'and'Цена растёт по мере развития. Выбирай то, что нужно сейчас.'or'Постоянные улучшения. Ограничение уровня машин сохраняется.')
  for _,item in ipairs(section.rows)do
   local balance=section.key=='coin'and data.money or data.diamonds
   W.card(parent,{kind=icon[item.id]or'coins',title=item.name,description=item.description or item.detail,value=('УРОВЕНЬ %d / %d'):format(item.level,item.max),progress={item.level,item.max},action=item.cost and('УЛУЧШИТЬ · '..W.fmt(item.cost)..' '..section.currency)or'МАКСИМАЛЬНЫЙ УРОВЕНЬ',enabled=item.cost~=nil and(balance or 0)&gt;=item.cost,click=function()invoke(a,section.key,item.id)end})
  end
 end
 W.header(parent,'МАСТЕРСТВО ГЕРОЯ И ПИТОМЦА','Бонус сохраняется при смене облика. Каждый +1% стоит 20 алмазов; монетная цена растёт.')
 for _,category in ipairs({'hero','pet'})do
  local hero=category=='hero';local level=hero and(data.heroSkinBonusLevel or 0)or(data.petBonusLevel or 0);local maximum=hero and Cosmetics.HERO_MAX or Cosmetics.PET_MAX
  local coins=hero and Cosmetics.heroUpgradeCoins(level)or Cosmetics.petUpgradeCoins(level)
  local unlocked=not hero and data.petUnlocked or false
  if hero then for id,owned in pairs(data.cosmeticsOwned or{})do local def=Cosmetics.ById[id];if owned and def and def.category=='hero'then unlocked=true;break end end end
  local id=(data.cosmeticsEquipped or{})[category]or(hero and'hero_premium_mech'or'pet_turtle')
  W.card(parent,{kind=category,id=id,title=hero and'Мастерство героя'or'Мастерство питомца',description=hero and'Надень любой свой образ — бонус действует на все монеты.'or'Один общий бонус для всех твоих питомцев.',value=('БОНУС +%d%% / +%d%%'):format(level,maximum),progress={level,maximum},action=unlocked and(level&gt;=maximum and'МАКСИМУМ'or('+1% ЗА МОНЕТЫ · '..W.fmt(coins)..' $'))or'ОТКРЫТЬ АТЕЛЬЕ',enabled=not unlocked or(level&lt;maximum and(data.money or 0)&gt;=(coins or math.huge)),click=function()if not unlocked then invoke(a,'atelier',category)else invoke(a,'mastery',category,'coins')end end})
  if unlocked and level&lt;maximum then local f=W.box(parent,48);W.button(f,'+1% ЗА 20 АЛМАЗОВ',UDim2.fromOffset(10,7),UDim2.new(1,-20,0,34),function()invoke(a,'mastery',category,'diamonds')end,(data.diamonds or 0)&gt;=20,C(130,220,249))end
 end
end
local function shop(parent,data,a)
 W.header(parent,'МАГАЗИН АЛМАЗОВ',"Выбирай оформление и удобства. Монеты и ОПЫТ по-прежнему зарабатываются в игре.")
 W.summary(parent,{{'ТВОИ АЛМАЗЫ',W.fmt(data.diamonds)},{"ВИП",data.vipActive and'АКТИВЕН'or'НЕ АКТИВЕН'}})
 for _,pack in ipairs(Packs.Products)do
  local card=W.card(parent,{kind='gems',color=C(103,220,248),title=pack.name..(pack.featured and' · РЕКОМЕНДУЕМ'or''),description=pack.description,value=pack.assetId&gt;0 and(actualPrices[pack.assetId]and(actualPrices[pack.assetId].." Робакс")or'Цена в окне Roblox')or(tostring(pack.recommendedRobux).." Робакс"),action=pack.assetId&gt;0 and'ПОСМОТРЕТЬ ЦЕНУ ROBLOX'or'СКОРО В ПРОДАЖЕ',enabled=pack.assetId&gt;0,click=function()invoke(a,'product',pack)end})
  if pack.assetId&gt;0 and not actualPrices[pack.assetId]then task.spawn(function()
   local ok,info=pcall(function()return game:GetService('MarketplaceService'):GetProductInfoAsync(pack.assetId,Enum.InfoType.Product)end)
   if ok and info and info.PriceInRobux then actualPrices[pack.assetId]=info.PriceInRobux;if card.Parent then card.CardValue.Text=tostring(info.PriceInRobux).." Робакс"end end
  end)end
 end
 W.header(parent,"ВИП БЕЗ ОБЯЗАТЕЛЬНОЙ ПОДПИСКИ","+30% монет за угон, +25% ОПЫТ и касса на 48 часов. Доступ к машинам определяется твоим уровнем.")
 for _,plan in ipairs(VIP.Plans)do
  W.card(parent,{kind='vip',color=C(246,204,100),title=plan.name,description='Продление прибавляется к оставшемуся сроку. Алмазы списываются только сервером.',value=tostring(plan.diamonds)..' 💎',action=data.vipPermanent and"БЕССРОЧНЫЙ ВИП УЖЕ ЕСТЬ"or"АКТИВИРОВАТЬ ВИП",enabled=not data.vipPermanent and(data.diamonds or 0)&gt;=plan.diamonds,click=function()invoke(a,'vip',plan.id)end})
 end
 local f=W.box(parent,54);W.button(f,'ОБРАЗЫ · ПИТОМЦЫ · ТЮНИНГ',UDim2.fromOffset(10,9),UDim2.new(1,-20,0,36),function()invoke(a,'atelier','hero')end)
end
local function oddsCard(parent,title,weights,kind,id,footer)
 local f=W.card(parent,{kind=kind or'car',id=id,title=title,description='',value='',footer=footer or'Шансы редкости; конкретная модель выбирается отдельно.'})
 local x=f:GetAttribute('TextColumnX')or 164
 local titleLabel=f:FindFirstChild('CardTitle');titleLabel.TextSize=14;titleLabel.Size=UDim2.new(1,-x-14,0,30)
 for i,rarity in ipairs(Rarity.Order)do
  local value=weights[rarity]or 0;W.text(f,Rarity.Info[rarity].name..'  '..value..'%',UDim2.fromOffset(x,49+(i-1)*28),UDim2.new(1,-x-14,0,18),11,colors[rarity]);local b=W.bar(f,value,100,UDim2.fromOffset(x,69+(i-1)*28),1,colors[rarity]);b.Size=UDim2.new(1,-x-14,0,4)
 end
end
function M.effectiveLootOdds(zone,weights)
 local out={common=0,rare=0,epic=0,legendary=0};local pools={};local all={}
 for _,item in ipairs(Loot)do if item.zone==zone then pools[item.rarity]=(pools[item.rarity]or 0)+1;all[#all+1]=item end end
 for index,desired in ipairs(Rarity.Order)do
  local amount=weights[desired]or 0;local selected
  for i=index,1,-1 do if pools[Rarity.Order[i]]then selected=Rarity.Order[i];break end end
  if selected then out[selected]+=amount elseif #all&gt;0 then for _,item in ipairs(all)do out[item.rarity]+=amount/#all end end
 end
 for id,n in pairs(out)do out[id]=math.floor(n*10+.5)/10 end;return out
end
local function odds(parent)
 W.header(parent,'ШАНСЫ БЕЗ СЕКРЕТОВ','Сначала выбирается редкость, затем доступная модель или предмет. У каждой машины указан свой уровень взлома.')
 local classList={};for id,def in pairs(Classes)do classList[#classList+1]={id=id,def=def}end;table.sort(classList,function(a,b)return a.def.order&lt;b.def.order end)
 for _,entry in ipairs(classList)do
  local carId;for _,car in ipairs(Cars)do if car.class==entry.id then carId=car.id;break end end
  oddsCard(parent,'Парковка · '..entry.def.name,entry.def.rarityWeights,'car',carId)
 end
 W.header(parent,'ДОБЫЧА ПО РАЙОНАМ','Выбери район: здесь показаны итоговые шансы только для предметов, которые в нём встречаются.')
 local selector=W.box(parent,48);local host=Instance.new('Frame');host.BackgroundTransparency=1;host.Size=UDim2.new(1,0,0,0);host.AutomaticSize=Enum.AutomaticSize.Y;W.order(parent,host);host.Parent=parent
 local list=Instance.new('UIListLayout');list.SortOrder=Enum.SortOrder.LayoutOrder;list.Padding=UDim.new(0,8);list.Parent=host
 local buttons={}
 local function showZone(zone)
  for _,child in ipairs(host:GetChildren())do if child~=list then child:Destroy()end end
  for i,b in ipairs(buttons)do b.BackgroundColor3=i==zone and W.accent or C(78,109,128)end
  local itemId;for _,item in ipairs(Loot)do if item.zone==zone then itemId=item.id;break end end
  for _,rarity in ipairs(Rarity.Order)do
   oddsCard(host,'Район '..zone..' · '..Rarity.Info[rarity].name..' авто',M.effectiveLootOdds(zone,Loot.WeightsByCarRarity[rarity]),'item',itemId,'Итоговые шансы предмета за один бросок добычи в этом районе.')
  end
 end
 for zone=1,5 do buttons[zone]=W.button(selector,'РАЙОН '..zone,UDim2.new((zone-1)/5,4,0,7),UDim2.new(1/5,-8,0,34),function()showZone(zone)end)end
 showZone(1)
 W.header(parent,'ВАРИАЦИИ АВТОМОБИЛЯ','Внешний вариант выбирается отдельно от редкости.')
 for _,variant in ipairs(Cars.Variants)do local f=W.box(parent,58);W.text(f,variant.name..'  '..variant.weight..'%',UDim2.fromOffset(12,8),UDim2.new(1,-24,0,22),14);W.bar(f,variant.weight,100,UDim2.fromOffset(12,41),1)end
end
function M.render(tab,parent,data,actions)
 if tab=='salon'then salon(parent,data,actions)elseif tab=='parts'then collection(parent,data)elseif tab=='upgrade'then upgrades(parent,data,actions)elseif tab=='shop'then shop(parent,data,actions)elseif tab=='odds'then odds(parent)else return false end
 return true
end
function M.replacement(parent,data,incoming,choose,cancel)
 W.header(parent,'ЧТО УБРАТЬ С ВИТРИНЫ?','Выбранный автомобиль займёт то же место. Убранный останется в коллекции.')
 local row=W.box(parent,48);W.button(row,'НАЗАД К КАТАЛОГУ',UDim2.fromOffset(10,7),UDim2.new(1,-20,0,34),cancel)
 for _,car in ipairs(data.catalog or{})do if car.displaySlot and car.id~=incoming then
  W.card(parent,{kind='car',id=car.id,title=car.name,description='Сейчас стоит на витрине · место '..car.displaySlot,value='ОСТАНЕТСЯ В КОЛЛЕКЦИИ',action='ЗАМЕНИТЬ ЭТУ МАШИНУ',click=function()choose(car.id)end})
 end end
end
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_STEAL60_V62_ShowcaseSelection"><Properties><string name="Name">ShowcaseSelection</string><ProtectedString name="Source">-- Atomic selection: a replacement keeps the outgoing car's exact slot.
local M={}
function M.change(current,owned,valid,limit,incoming,outgoing)
 if not owned[incoming]or not valid[incoming]then return nil,'invalid' end
 local list=table.clone(current);local index=table.find(list,incoming)
 if outgoing~=nil then
  if index or outgoing==incoming then return nil,'changed'end
  local slot=table.find(list,outgoing);if not slot then return nil,'changed'end
  list[slot]=incoming;return list,'replaced'
 end
 if index then table.remove(list,index);return list,'removed'end
 if #list&gt;=limit then return nil,'choose'end
 list[#list+1]=incoming;return list,'added'
end
return M
