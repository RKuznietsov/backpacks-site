  return self.store:UpdateAsync(key,function(old)
   if not old or not validRecord(old)then return nil end
   old.incoming=old.incoming or{coins=0,raids=0,senders={}};old.incoming.senders=old.incoming.senders or{}
   local last=old.incoming.senders[source]or 0
   if last&lt;pending.sequence then
