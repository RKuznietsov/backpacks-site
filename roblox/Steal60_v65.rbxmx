     O('RotorHub',x,.19,z,.14,.12,.14,gold,Enum.Material.Metal)
     for _,tip in ipairs({-1,1})do B('MovingRotorTip',x+tip*.30,.177,z,.13,.025,.12,mint)end
    end)
   end end
