          <Item class="ModuleScript" referent="RBX3">
            <Properties>
              <string name="Name">Settings</string>
              <ProtectedString name="Source">-- ModuleScript: ReplicatedStorage/Shared/Config/Settings
return {
	MaxPlayers = 8,
	ParkingSlotsPerDistrict = 8,       -- 4 с каждой стороны дороги
	ParkingRespawnDelay = { 10, 20 },  -- секунд, случайно в диапазоне
	ShowcaseSlots = 6,                 -- базовое число слотов витрины
	AlarmPenaltySeconds = 10,          -- блокировка взлома после ареста
	MaxCarSpeed = 84,                 -- жёсткий потолок (studs/s), нужен для подгрузки районов

	-- Размеры трассы (дорога идёт вдоль оси X, начало в X = 0)
	Track = {
		SalonZoneLength = 400,
		DistrictLength = 600,
		IntersectionLength = 40,
		RoadHalfWidth = 20,    -- проезжая часть: |z| &lt;= 20
		ParkingWidth = 10,     -- полоса парковки: 20 &lt; |z| &lt;= 30
		SidewalkWidth = 8,     -- тротуар: 30 &lt; |z| &lt;= 38
		GroundHalfWidth = 200, -- земля по бокам
		CrossRoadHalf = 80,    -- половина длины поперечной дороги на перекрёстке
	},

	-- Подгрузка районов
	DistrictLoad = {
		Behind = 1,         -- сколько районов держать позади игрока
		Ahead = 1,          -- и впереди
		UnloadDelay = 8,    -- сек. до выгрузки района, который больше не нужен
		CheckInterval = 0.5,
	},

	-- Туман скрывает подгрузку вдали
	Fog = {
		Color = Color3.fromRGB(190, 205, 225),
		Start = 300,
		End = 1000,
	},

	-- Езда (аркадная физика, считается на клиенте водителя)
	Drive = {
		BaseSpeed = 42,       -- студов/сек без прокачки
		SpeedPerLevel = 2.5,    -- прибавка за уровень прокачки скорости
        Accel = 34,
        Brake = 310, -- S reduces forward speed quickly before reverse starts
        Coast = 78, -- release gas -&gt; coasts less; starts to settle naturally
		TurnRate = 1.65,       -- рад/сек
		ReverseFactor = 0.35, -- задний ход медленнее
	},

	-- Угон
	Steal = {
		SessionTimeout = 120,  -- сек на мини-игру
		AbandonTimeout = 60,  -- сек, после которых брошенная угнанная машина исчезает
		OwnerChaseTime = 7,   -- сколько владелец бежит за машиной
		PoliceDelay = 2,      -- сек до приезда полиции
		PoliceSpeed = 55,
		AlarmSeconds = 8,
	},

	AutosaveInterval = 30,

	CollisionGroups = {
		Players = "Players",   -- игроки, пассажиры и боты
		Vehicles = "Vehicles", -- машины
        Decor = "Steal60WorldDecor", -- objects walkable for players but not solid for cars
	},
}
</ProtectedString>
            </Properties>
          </Item>
