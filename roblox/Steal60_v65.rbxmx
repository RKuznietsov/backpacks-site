<?xml version='1.0' encoding='utf-8'?>
<roblox version="4">
  <Item class="Model" referent="RBX35">
    <Properties>
      <string name="Name">Steal60_v65_Security_SaveSafety_RU_EN</string>
    </Properties>
    <Item class="Script" referent="RBX34">
      <Properties>
        <string name="Name">Installer</string>
        <ProtectedString name="Source">-- Installer: раскладывает содержимое по сервисам при запуске игры.
local RS = game:GetService("ReplicatedStorage")
local SSS = game:GetService("ServerScriptService")
local SS = game:GetService("ServerStorage")

local pack = script.Parent
if game:GetService("RunService"):IsClient() then return end
local rsContent = pack:FindFirstChild("ReplicatedStorage")
local sssContent = pack:FindFirstChild("ServerScriptService")

-- Обновление существующего проекта: меняем только содержимое пакета.
-- Посторонние модели и пользовательские CarModels не удаляем.
local function moveChildren(from, to, skipNames)
    for _, child in ipairs(from:GetChildren()) do
        if skipNames and skipNames[child.Name] then continue end
        local old = to:FindFirstChild(child.Name)
        if old and old:IsA("Folder") and child:IsA("Folder") then
            moveChildren(child, old)
            child:Destroy()
        else
            if old then old:Destroy() end
            child.Parent = to
        end
    end
end

if not SS:FindFirstChild("CarModels") then
	local f = Instance.new("Folder")
	f.Name = "CarModels"
	f.Parent = SS
end

-- 0. Шаблоны для ServerStorage (клиентский скрипт)
local ssContent = pack:FindFirstChild("ServerStorage")
if ssContent then
	moveChildren(ssContent, SS)
end

-- 1. Общие модули
if rsContent then
	moveChildren(rsContent, RS)
end

-- 2. Сервисы, затем Main (он запускается последним)
if sssContent then
	local main = sssContent:FindFirstChild("Main")
	moveChildren(sssContent, SSS, { Main = true })
    if main then
        local oldMain = SSS:FindFirstChild("Main")
        if oldMain then oldMain:Destroy() end
        main.Parent = SSS
        main.Disabled = false
    end
end

print("[Steal60 v65] Установлено: серверные проверки наград и запросов, защищённые сохранения с резервными записями, безопасная выдача покупок; ru/en и музыка сохранены.")
pack:Destroy()
</ProtectedString>
      </Properties>
    </Item>
    <Item class="Folder" referent="RBX10">
