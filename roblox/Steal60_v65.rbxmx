	{ id = "outskirts", name = "Окраина",        carClass = "junk",    requiredHack = 1,  modelName = "District_Outskirts" },
	{ id = "suburbs",   name = "Спальный район", carClass = "regular", requiredHack = 5,  modelName = "District_Suburbs"   },
	{ id = "cottages",  name = "Пригород",       carClass = "sport",   requiredHack = 10, modelName = "District_Cottages"  },
	{ id = "villas",    name = "Виллы",          carClass = "premium", requiredHack = 15, modelName = "District_Villas"    },
	{ id = "resort",    name = "Курорт",         carClass = "super",   requiredHack = 20, modelName = "District_Resort"    },
}
