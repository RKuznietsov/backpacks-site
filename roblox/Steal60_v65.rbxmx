    { id = "zantia_track", name = "Зантия Трек", class = "super", shape = "track", face = "dual", feature = "speedster", scale = 1.000, widthScale = 1.045, roofScale = 1.100, cabinShift = 0.000, wheelScale = 1.000, paints = {"EF7C42","F8E48D","64A956"} },
    { id = "solvex_aero", name = "Солвекс Аэро", class = "super", shape = "widebody", face = "oval", feature = "wing", scale = 1.035, widthScale = 1.045, roofScale = 0.920, cabinShift = 0.008, wheelScale = 1.060, paints = {"A62483","E6859D","B09A51"} },
}

Cars.Variants = {
    { id = "default", name = "Стандарт", weight = 80, incomeMult = 1 },
    { id = "retro", name = "Ретро", weight = 10, incomeMult = 1.5 },
    { id = "neon", name = "Неон", weight = 7, incomeMult = 2 },
    { id = "gold", name = "Золотая", weight = 3, incomeMult = 4 },
}

Cars.ById = {}
Cars.ByClass = {}
for _, car in ipairs(Cars) do
    Cars.ById[car.id] = car
    Cars.ByClass[car.class] = Cars.ByClass[car.class] or {}
    table.insert(Cars.ByClass[car.class], car)
end

return Cars
</ProtectedString>
