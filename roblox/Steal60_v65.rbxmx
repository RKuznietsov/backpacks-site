notice.Visible=false

local vendor="coins";local tab="coins";local drawing=false
local draw;local rebuildTabs
local function clearContent()for _,obj in ipairs(scroll:GetChildren())do if obj~=contentLayout then obj:Destroy()end end end
local function refreshAfter()task.delay(.45,function()if panel.Visible then draw()end end)end
local function makeCard(icon,titleText,detailText,color,actions,h)
    h=h or 83
    local card=Instance.new("Frame")
    card.Name="ProductCard";card.Size=UDim2.new(1,-11,0,h)
    card.BackgroundColor3=C(34,47,66);card.BorderSizePixel=0;card.Parent=scroll;round(card,11)
    local art=label(card,"ProductIcon",UDim2.fromOffset(55,55),UDim2.fromOffset(9,12),icon,Enum.Font.GothamBlack,25,color or C(255,208,127))
    art.TextXAlignment=Enum.TextXAlignment.Center;art.BackgroundTransparency=0;art.BackgroundColor3=C(21,35,53);round(art,9)
    local actionWidth=(actions and #actions&gt;0) and 155 or 0
    local left=77
    local right=actionWidth&gt;0 and actionWidth+15 or 13
    local titleLine=label(card,"ProductName",UDim2.new(1,-left-right,0,25),UDim2.fromOffset(left,11),titleText,Enum.Font.GothamBold,15,color or C(241,244,248))
    titleLine.TextTruncate=Enum.TextTruncate.AtEnd
    local details=label(card,"ProductDetails",UDim2.new(1,-left-right,0,h-39),UDim2.fromOffset(left,34),detailText,Enum.Font.GothamMedium,12,C(187,207,223))
    details.TextYAlignment=Enum.TextYAlignment.Top
    details.RichText=true -- star/stage text intentionally includes Roblox rich-text tags
    if actions and #actions&gt;0 then
        local eachHeight=(#actions&gt;1) and 42 or 47
        local gap=(#actions&gt;1) and 5 or 0
        local totalHeight=eachHeight*#actions+gap*(#actions-1)
        for i,act in ipairs(actions) do
            local ypos=math.floor((h-totalHeight)/2)+(i-1)*(eachHeight+gap)
            local b=button(card,act.text,UDim2.new(1,-actionWidth-9,0,ypos),UDim2.fromOffset(actionWidth,eachHeight),act.func,act.enabled~=false)
            if act.tint then b.BackgroundColor3=act.tint;b.TextColor3=act.enabled==false and C(160,168,182) or C(17,30,39) end
        end
    end
    return card
end

rebuildTabs=function()
 for _,obj in ipairs(tabs:GetChildren())do if obj~=rowTabs then obj:Destroy()end end
 tabs.Visible=vendor=="coins"
 scroll.Position=UDim2.fromOffset(15,vendor=="coins"and 132 or 92)
 scroll.Size=UDim2.new(1,-30,1,vendor=="coins"and-146 or-106)
 if vendor~="coins"then return end
 for _,entry in ipairs({{"coins","УЛУЧШЕНИЯ"},{"items","ПРЕДМЕТЫ ★"},{"accessories","КОЛЛЕКЦИЯ"}})do
  local b=button(tabs,entry[2],UDim2.new(),UDim2.new(1/3,-6,1,-1),function()tab=entry[1];rebuildTabs();draw()end,true)
  b.BackgroundColor3=entry[1]==tab and C(99,211,172)or C(65,95,110)
 end
end
local function drawItems(data)
 header.Text="ПРЕДМЕТЫ · АВТОРАССТАНОВКА"
 subtitle.Text="Лучшие предметы автоматически приносят доход. Улучшай их до ★5 за монеты."
 local list,byId={},{}
 for listIndex,items in ipairs({data.shelf or{},data.shelfStorage or{}})do
  for _,item in ipairs(items)do if item.id and not item.empty then
   local row=byId[item.id]
   if not row then row=table.clone(item);row.active=0;row.reserve=0;byId[item.id]=row;list[#list+1]=row end
   if listIndex==1 then row.active+=1 else row.reserve+=1 end
  end end
 end
 table.sort(list,function(a,b)if(a.income or 0)~=(b.income or 0)then return(a.income or 0)&gt;(b.income or 0)end;return a.id&lt;b.id end)
 if #list==0 then makeCard("▣","Полки пока пусты","Доставь машину: система сама поставит первые предметы.",C(180,223,216),nil,86)end
 for _,item in ipairs(list)do
  if item.locked then makeCard("?","СОХРАНЁННЫЙ ПРЕДМЕТ","Этот предмет из другого обновления сохранён в твоей коллекции.",C(212,193,143),nil,82)
  else
   local stars=tonumber(item.stars)or 0;local copies=tonumber(item.copies)or 0;local cost=tonumber(item.cost)or 0
   local details=("На полках: %d · в запасе: %d · +%s $/ч за штуку\nКопий для звезды: %d/5 · места выбираются автоматически"):format(item.active,item.reserve,fmt((item.income or 0)*3600),copies)
   local card=makeCard("▣",("%s · ★%d/5"):format(item.name,stars),details,C(255,214,126),{{
    text=stars&gt;=5 and"МАКС"or("★ УЛУЧШИТЬ\n"..fmt(cost).." $"),enabled=stars&lt;5 and copies&gt;=5 and cost&gt;0 and(data.money or 0)&gt;=cost,
    func=function()manage:FireServer("upgradeShelf",item.id);refreshAfter()end,
   }},108)
   if item.id==player:GetAttribute("TutorialItemId")and not player:GetAttribute("TutorialComplete")then
    local glow=Instance.new("UIStroke");glow.Color=C(113,234,172);glow.Thickness=2;glow.Parent=card
   end
  end
 end
end
local function drawParts(data)
 header.Text="КОЛЛЕКЦИОННЫЕ ДЕТАЛИ"
 subtitle.Text="Коллекция расставляется автоматически. Дубликаты сами повышают звёзды."
 for _,item in ipairs(data.theftParts or{})do
  makeCard(item.owned and"★"or"☆",item.name,("Район %d · %s · +%d%% за угон\n%s · %s"):format(item.zone or 1,item.owned and"НАЙДЕНО"or"НЕ НАЙДЕНО",item.pct or 0,item.stars or"☆☆☆☆☆",item.progress or"0/5"),item.owned and C(255,210,127)or C(150,163,180),nil,93)
 end
end
local function drawCoins(data)
 header.Text="МАСТЕР · УЛУЧШЕНИЯ ЗА $"
 subtitle.Text="Монеты $ "..fmt(data.money).." · обычная прокачка без доната"
 for _,up in ipairs(data.coinUpgrades or{})do
  local maximum=up.level&gt;=up.max or up.cost==nil;local price=up.cost or 0
  makeCard(up.icon or"$",up.name,("Уровень %d/%d · %s"):format(up.level,up.max,up.detail or""),C(143,234,170),{{
   text=maximum and"МАКС"or("УЛУЧШИТЬ\n"..fmt(price).." $"),enabled=not maximum and(data.money or 0)&gt;=price,
   func=function()buyCoin:FireServer(up.id);refreshAfter()end,
  }},88)
 end
end
local function drawDiamonds(data)
 header.Text="ВИП · АЛМАЗЫ"
 subtitle.Text="Баланс 💎 "..fmt(data.diamonds).." · покупки за алмазы"
 local remaining=math.max(0,math.floor((tonumber(data.vipUntil)or 0)-workspace:GetServerTimeNow()))
 local status=data.vipPermanent and"ВИП БЕССРОЧНО"or(data.vipActive and("ВИП · осталось %d д. %d ч."):format(math.floor(remaining/86400),math.floor(remaining%86400/3600))or"ВИП НЕ АКТИВЕН")
 makeCard("♛",status,("+%d%% денег за угон · +%d%% ОПЫТ · касса %d ч."):format(VIP.BONUS_COINS_PCT,VIP.BONUS_XP_PCT,VIP.CASH_HOURS),C(254,209,109),nil,78)
 for _,plan in ipairs(VIP.Plans)do
  makeCard("♛",plan.name,("%d дней. При продлении остаток сохраняется."):format(plan.days),C(250,217,134),{{
   text="КУПИТЬ ВИП\n"..fmt(plan.diamonds).." 💎",enabled=not data.vipPermanent and(data.diamonds or 0)&gt;=plan.diamonds,
   func=function()buyVIP:FireServer(plan.id);refreshAfter()end,
  }},85)
 end
 for _,up in ipairs(data.upgrades or{})do
  local maximum=up.level&gt;=up.max or up.cost==nil
  makeCard("◆",up.name,("Уровень %d/%d · %s"):format(up.level,up.max,up.description or""),C(145,202,248),{{
   text=maximum and"МАКС"or("УЛУЧШИТЬ\n"..fmt(up.cost).." 💎"),enabled=not maximum and(data.diamonds or 0)&gt;=(up.cost or 0),
   func=function()buyDiamond:FireServer(up.id);refreshAfter()end,
  }},86)
 end
 for _,prod in ipairs(Monetization.Products)do
  local valid=(tonumber(prod.assetId)or 0)&gt;0
  makeCard("💎",prod.name,valid and"Официальное пополнение через Roblox"or"Пополнение пока недоступно",C(120,210,255),{{
   text=valid and"ЗА РОБАКС"or"НЕДОСТУПНО",enabled=valid,func=function()Marketplace:PromptProductPurchase(player,prod.assetId)end,
  }},80)
 end
end
draw=function()
 if not panel.Visible or drawing then return end;drawing=true
 local ok,data=pcall(function()return getData:InvokeServer()end);clearContent()
 if not ok or type(data)~="table"then makeCard("…","Данные загружаются","Открой магазин через секунду.",C(207,224,234),nil,80)
 elseif vendor=="diamonds"then drawDiamonds(data)
 elseif tab=="items"then drawItems(data)
 elseif tab=="accessories"then drawParts(data)
 else drawCoins(data)end
 drawing=false
end
local function setOpen(open)
 panel.Visible=open;player:SetAttribute("Steal60MenuOpen",open or player:GetAttribute("Steal60ActiveModal")~=nil)
 if open then rebuildTabs();draw()end
end
close.Activated:Connect(function()setOpen(false)end)
openRemote.OnClientEvent:Connect(function(kind)
 if kind~="coins"and kind~="diamonds"then panel.Visible=false;return end
 vendor=kind;tab=kind=="coins"and player:GetAttribute("TutorialStep")=="star"and"items"or"coins"
 setOpen(true)
end)
Input.InputBegan:Connect(function(input,processed)if not processed and input.KeyCode==Enum.KeyCode.Escape and panel.Visible then setOpen(false)end end)
remotes:WaitForChild("CurrencyUpdate").OnClientEvent:Connect(function()if panel.Visible then task.defer(draw)end end)
</ProtectedString></Properties></Item><Item class="LocalScript" referent="RBXGEN_V37_CosmeticHUD">
          <Properties>
            <string name="Name">CosmeticHUD</string>
            <ProtectedString name="Source">-- STEAL60 v38: character mastery (+0-30%) and pet mastery (+0-60%).
-- All prices and rewards are authoritative on the server; this is display/actions only.
local Players=game:GetService("Players")
local RS=game:GetService("ReplicatedStorage")
local Input=game:GetService("UserInputService")
local RunService=game:GetService("RunService")
local player=Players.LocalPlayer
local remotes=RS:WaitForChild("Remotes")
local dataRequest=remotes:WaitForChild("GetMenuData")
local openNpc=remotes:WaitForChild("OpenEconomyNPC")
local action=remotes:WaitForChild("CosmeticAction")
local update=remotes:WaitForChild("CosmeticUpdate")
local currency=remotes:WaitForChild("CurrencyUpdate")
local Config=require(RS.Shared.Config.CosmeticConfig)
local Balance=require(RS.Shared.Config.EconomyBalance)
local catalogPreviews=RS:WaitForChild("Steal60CatalogPreviews")
local PetVisuals=require(RS.Shared.PetVisualLibrary)
local PetAnimation=require(RS.Shared.PetAnimationLibrary)
local CarVisuals=require(RS.Shared.CarVisualLibrary)
local CarArt=require(RS.Shared.CarCosmeticArt)
local CarTuning=require(RS.Shared.CarTuning)
local AvatarPreview=require(RS.Shared.AvatarPreview)
local AuraVisuals=require(RS.Shared.AuraVisualLibrary)
local Cars=require(RS.Shared.Config.Cars)
local gui=script.Parent
local C=Color3.fromRGB
local state="hero"
local heroPage=1
local petPage=1
local selectedCarId=nil
local currentCarSettings={}
local HERO_PAGE_SIZE=10
local PET_PAGE_SIZE=12
local busy=false
local colorBg=C(13,23,36)
local colorCard=C(34,50,67)
local colorAccent=C(117,235,193)
local function fmt(n)
 return tostring(math.floor(tonumber(n) or 0)):reverse():gsub("(%d%d%d)","%1 "):reverse():gsub("^ ","")
end
local function corner(p,r)
 local x=Instance.new("UICorner")
 x.CornerRadius=UDim.new(0,r)
 x.Parent=p
end
local function text(parent,s,size,pos,pt,col,bold)
 local t=Instance.new("TextLabel")
 t.BackgroundTransparency=1
 t.Text=s
 t.Size=size
 t.Position=pos
 t.Font=bold and Enum.Font.GothamBold or Enum.Font.Gotham
 t.TextSize=pt or 13
 t.TextColor3=col or C(222,233,242)
 t.TextXAlignment=Enum.TextXAlignment.Left
 t.TextYAlignment=Enum.TextYAlignment.Center
 t.TextWrapped=true
 t.Parent=parent
 return t
end
local function button(parent,s,size,pos,callback,color,enabled)
 local b=Instance.new("TextButton")
 b.Text=s
 b.Size=size
 b.Position=pos or UDim2.new()
 b.TextWrapped=true
 b.Font=Enum.Font.GothamBold
 b.TextSize=12
 b.TextColor3=C(13,27,37)
 b.BackgroundColor3=color or colorAccent
 b.BorderSizePixel=0
 b.Active=enabled~=false
 b.AutoButtonColor=enabled~=false
 if enabled==false then b.BackgroundColor3=C(81,96,107) end
 b.Parent=parent
 corner(b,8)
 if callback then b.Activated:Connect(function()
  if enabled==false or busy then return end
  busy=true
  callback()
  task.delay(.45,function() busy=false end)
 end) end
 return b
end
local function box(parent,h,col)
 local b=Instance.new("Frame")
 b.Size=UDim2.new(1,-14,0,h)
 b.BackgroundColor3=col or colorCard
 b.BorderSizePixel=0
 b.Parent=parent
 corner(b,11)
 return b
end

