local function clearContent()
	for _, c in ipairs(content:GetChildren()) do
		if not c:IsA("UIListLayout") then
			c:Destroy()
		end
	end
end

local function addRow(text, color, onClick, bg)
	local b = Instance.new(onClick and "TextButton" or "TextLabel")
	b.Size = UDim2.new(1, -8, 0, 30)
	b.AutomaticSize = Enum.AutomaticSize.Y
	b.BackgroundColor3 = bg or Color3.fromRGB(42, 42, 50)
	b.TextColor3 = color or Color3.new(1, 1, 1)
	b.Font = Enum.Font.Gotham
	b.TextSize = 16
	b.TextWrapped = true
	b.TextXAlignment = Enum.TextXAlignment.Left
	b.Text = " " .. text
	b.Parent = content
	if onClick then
		b.Activated:Connect(onClick)
	end
	return b
end

local currentTab = "catalog"
local renderTab

local pendingReplacement
local function renderCatalog(data)
 if pendingReplacement then
  MenuViews.replacement(content,data,pendingReplacement,function(outgoing)
   PinCar:FireServer(pendingReplacement,outgoing);pendingReplacement=nil;task.wait(.28);renderTab("catalog")
  end,function()pendingReplacement=nil;renderTab("catalog")end);return
 end
 local cars={}
 local displayCount=0
 for _,c in ipairs(data.catalog or {}) do
  if c.owned then
   cars[#cars+1]=c
   if c.displaySlot then displayCount+=1 end
  end
 end
 table.sort(cars,function(a,b)
  if a.pinned~=b.pinned then return a.pinned end
  if a.displaySlot~=nil and b.displaySlot==nil then return true end
  if b.displaySlot~=nil and a.displaySlot==nil then return false end
  if a.valueScore~=b.valueScore then return a.valueScore&gt;b.valueScore end
  return a.name&lt;b.name
 end)
 addRow(("ГАРАЖ · %d/%d машин в коллекции · на витрине %d/%d · выбрано %d"):format(
  #cars,data.total or 0,displayCount,data.slots or 6,data.pinnedCount or 0),Color3.fromRGB(120,228,194))
 addRow(data.showcaseManual and'РУЧНОЙ ВЫБОР: на витрине только отмеченные машины. Пустые места не заполняются автоматически.'or'АВТОВИТРИНА: система показывает самые ценные машины. Нажми на машину ниже, чтобы выбрать состав самостоятельно.',Color3.fromRGB(184,211,227))
 addRow(data.showcaseManual and'ВКЛЮЧИТЬ АВТОМАТИЧЕСКУЮ ВИТРИНУ'or'ВЫБИРАТЬ МАШИНЫ САМОСТОЯТЕЛЬНО',Color3.fromRGB(132,238,197),function()
  PinCar:FireServer(data.showcaseManual and'__auto'or'__manual');task.wait(.28);renderTab('catalog')
 end)
 if #cars==0 then addRow("Угони первую машину, чтобы открыть каталог.") end
 for _,c in ipairs(cars) do
  local cell=Instance.new("Frame")
  cell.Size=UDim2.new(1,-8,0,121)
  cell.BorderSizePixel=0
  cell.BackgroundColor3=c.displaySlot and Color3.fromRGB(36,67,71) or Color3.fromRGB(39,46,58)
  cell.Parent=content
  corner(cell,9)
  local title=Instance.new("TextLabel")
  title.Size=UDim2.new(1,-20,0,25)
  title.Position=UDim2.fromOffset(11,5)
  title.BackgroundTransparency=1
  title.TextColor3=rarityColor(c.bestRarity)
  title.Font=Enum.Font.GothamBold
  title.TextSize=14
  title.TextXAlignment=Enum.TextXAlignment.Left
  title.Text=(c.displaySlot and ("ВИТРИНА "..c.displaySlot.."  ·  ") or "")..c.name..(c.pinned and "  📌" or "")
  title.Parent=cell
  local detail=Instance.new("TextLabel")
  detail.Size=UDim2.new(1,-20,0,19)
  detail.Position=UDim2.fromOffset(11,28)
  detail.BackgroundTransparency=1
  detail.TextColor3=Color3.fromRGB(174,199,220)
  detail.Font=Enum.Font.GothamMedium
  detail.TextSize=11
  detail.TextXAlignment=Enum.TextXAlignment.Left
  detail.Text=("%s · %s · ★%d · копий %d · ценность %s"):format(
    c.className,rarityName(c.bestRarity),c.stars,c.count,fmt(c.valueScore or 0))
  detail.Parent=cell
  local function makeAction(label,pos,width,color,click)
   local b=Instance.new("TextButton")
   b.Size=UDim2.new(width,-8,0,29)
   b.Position=pos
   b.BackgroundColor3=color
   b.BorderSizePixel=0
   b.TextColor3=Color3.fromRGB(245,252,255)
   b.Font=Enum.Font.GothamBold
   b.TextSize=12
   b.Text=label
   b.Parent=cell
   corner(b,7)
   b.Activated:Connect(click)
  end
  makeAction((data.showcaseManual and c.pinned or not data.showcaseManual and c.displaySlot)and "УБРАТЬ С ВИТРИНЫ" or "ОСТАВИТЬ НА ВИТРИНЕ",UDim2.new(0,10,0,51),.52,
   c.pinned and Color3.fromRGB(116,82,91) or Color3.fromRGB(51,120,115),function()
    if not c.displaySlot and displayCount&gt;=(data.slots or 6)then pendingReplacement=c.id;renderTab("catalog");return end
    PinCar:FireServer(c.id)
    task.wait(.28)
    renderTab("catalog")
   end)
  makeAction("ТЮНИНГОВАТЬ АВТО",UDim2.new(.52,1,0,51),.48,Color3.fromRGB(61,105,155),function()
    panel.Visible=false
    player:SetAttribute("Steal60MenuOpen",false)
    player:SetAttribute("Steal60ShowCarPaint",nil)
    player:SetAttribute("Steal60ShowCarPaint",c.id)
   end)
  makeAction("ПОСМОТРЕТЬ НА ДОРОГЕ · 20 СЕК",UDim2.new(0,10,0,85),1,Color3.fromRGB(54,128,136),function()
   panel.Visible=false;player:SetAttribute('Steal60MenuOpen',false)
   ReplicatedStorage.Remotes.CosmeticAction:FireServer('previewVehicle','vehicle',nil,c.id)
  end)
 end
end

local function renderAccessories(data)
    addRow(("КОЛЛЕКЦИЯ ДЕТАЛЕЙ · %d видов · +%d%% к деньгам за угоны"):format(
        data.accessoryCount or 0, data.theftIncomeBonusPct or 0), Color3.fromRGB(136,248,184))
    addRow("Первая копия даёт бонус только раз. Каждые 5 дубликатов заполняют звезду: белые → зелёные → красные → сияющие золотые.", Color3.fromRGB(210,220,233))
    addRow("Один дубликат окрашивает один из 5 углов следующей звезды. Проценты разных деталей СКЛАДЫВАЮТСЯ.", Color3.fromRGB(210,220,233))
    addRow("Шанс детали при доставке: 7%. Каждые 50 налётов на чужие салоны — гарантированная деталь.", Color3.fromRGB(238,205,135))
    for _,part in ipairs(data.theftParts or {}) do
        local title = part.name.."  "..part.stars.."  "
        local state = not part.owned and "Не найдена" or (part.progress or (part.maxed and "МАКС" or (part.copies.."/5 углов")))
        local text = title..("  +%d%% · %s"):format(part.pct, state)
        local row = addRow(text, part.owned and Color3.fromRGB(224,234,244) or Color3.fromRGB(130,140,155))
        row.RichText = true
        row.TextSize = 15
        row.Size = UDim2.new(1,-8,0,34)
    end
end

local function renderSalon(data)
	addRow(("Твой участок: салон №%d"):format(data.plot), Color3.fromRGB(200, 200, 200))
	addRow(("Доход: %.1f в секунду"):format(data.income), Color3.fromRGB(120, 255, 150))
    addRow(("В кассе: %s $ · копит до %d ч (вкл. офлайн)"):format(fmt(data.till),data.tillHours or 12),Color3.fromRGB(120,255,150))
    addRow(("Вместимость по текущему доходу: %s $"):format(fmt(data.tillCapacity or 0)),Color3.fromRGB(170,198,218))
	local occupied=0
	for _,it in ipairs(data.shelf or {}) do if not it.empty then occupied+=1 end end
	addRow(("Полки: %d из %d · в запасе: %d · авторасстановка"):format(occupied, data.shelfCapacity, #(data.shelfStorage or {})), Color3.fromRGB(200, 200, 200))
	for index,it in ipairs(data.shelf or {}) do
		if it.empty then
			addRow(("Место %d · свободно"):format(index), Color3.fromRGB(120,165,173))
		else
			addRow(("%d. %s · %s · +%s/ч"):format(index,it.name,rarityName(it.rarity),fmt(it.income*3600)), rarityColor(it.rarity))
		end
	end
end

local function percent(n)
	return ("%d%%"):format(math.floor(n + 0.5))
end

local function renderOdds()
	addRow("Шансы редкости. Это шансы выбора редкости; конкретный предмет выбирается среди доступных для этого класса машин.", Color3.fromRGB(200, 200, 200))

	addRow("Редкость машины на парковке", Color3.fromRGB(255, 220, 120), nil, Color3.fromRGB(55, 50, 30))
	local classIds = {}
	for id in pairs(CarClasses) do
		table.insert(classIds, id)
	end
	table.sort(classIds, function(a, b)
		return CarClasses[a].order &lt; CarClasses[b].order
	end)
	for _, id in ipairs(classIds) do
		local w = CarClasses[id].rarityWeights
		local parts = {}
		for _, r in ipairs(Rarity.Order) do
			table.insert(parts, ("%s %s"):format(rarityName(r), percent(w[r] or 0)))
		end
		addRow(CarClasses[id].name .. ": " .. table.concat(parts, ", "))
	end

	addRow("Вариации машины", Color3.fromRGB(255, 220, 120), nil, Color3.fromRGB(55, 50, 30))
	local vparts = {}
	for _, v in ipairs(CarsCfg.Variants) do
		table.insert(vparts, ("%s %s"):format(v.name, percent(v.weight)))
	end
	addRow(table.concat(vparts, ", "))

	addRow("Предметы при вскрытии (по редкости машины)", Color3.fromRGB(255, 220, 120), nil, Color3.fromRGB(55, 50, 30))
	for _, r in ipairs(Rarity.Order) do
		local w = LootCfg.WeightsByCarRarity[r]
		local parts = {}
		for _, rr in ipairs(Rarity.Order) do
			table.insert(parts, ("%s %s"):format(rarityName(rr), percent(w[rr] or 0)))
		end
		addRow(("Машина «%s»: %s"):format(rarityName(r), table.concat(parts, ", ")), rarityColor(r))
	end
end

-- Этап 6: прокачка / этап 7: магазин. Клиент только отображает, сервер всё проверяет.
local BuyUpgrade = remotes:WaitForChild("BuyUpgrade")
local MonetizationConfig = require(Config:WaitForChild("MonetizationConfig"))
local Marketplace = game:GetService("MarketplaceService")
local TweenService = game:GetService("TweenService")

local function renderUpgrades(data)
    addRow(("Алмазы: %s 💎 · уровень взлома: %d"):format(fmt(data.diamonds or 0),data.hackLevel),Color3.fromRGB(112,220,255))
    addRow("Деньги $ — добыча, касса и лидерборд. Алмазы 💎 — исключительно улучшения.",Color3.fromRGB(169,192,209))
    addRow("Уровень взлома растёт за ОПЫТ от доставок. Точный взлом и дорогой класс дают больше ОПЫТ.", Color3.fromRGB(175, 190, 205))
    for _, u in ipairs(data.upgrades) do
        local info = ("%s  %d/%d · %s"):format(u.name, u.level, u.max, u.description)
        if u.cost then
            addRow(info .. (" · цена: %s 💎  [УЛУЧШИТЬ]"):format(fmt(u.cost)), Color3.fromRGB(160, 235, 185), function()
                BuyUpgrade:FireServer(u.id)
                task.wait(0.4)
                renderTab("upgrade")
            end)
        else
            addRow(info .. " · МАКС", Color3.fromRGB(125, 205, 240))
        end
    end
end

local function renderShop(data)
    addRow(("ТВОИ АЛМАЗЫ: %s 💎"):format(fmt(data.diamonds or 0)),Color3.fromRGB(113,221,255))
    local daysLeft=math.max(0,math.ceil(((tonumber(data.vipUntil) or 0)-os.time())/86400))
    addRow(data.vipPermanent and "ВИП: БЕССРОЧНЫЙ (старый пропуск)" or
        (data.vipActive and ("ВИП: АКТИВЕН · %d дн. осталось"):format(daysLeft) or "ВИП: НЕ АКТИВЕН"),Color3.fromRGB(252,206,126))
    addRow("ВИП 1/7/30 дней: +30% монеты за угон, +25% ОПЫТ, касса 48 ч. Покупка у ВИП-НПС в своём салоне за алмазы.",Color3.fromRGB(194,227,244))
    addRow("Алмазы используются только в разделе «Прокачка». Деньги за угоны не тратятся на улучшения.",Color3.fromRGB(179,204,220))
    addRow("НАБОРЫ АЛМАЗОВ · за Робакс",Color3.fromRGB(250,220,150))
    for _,product in ipairs(MonetizationConfig.Products) do
        if product.assetId==0 then
            addRow(product.name.." · настрой Product ID в MonetizationConfig",Color3.fromRGB(155,165,181))
        else
            addRow(product.name.." · купить за Робакс",Color3.fromRGB(133,230,255),function()
                local ok,err=pcall(function() Marketplace:PromptProductPurchase(player,product.assetId) end)
                if not ok then warn("[Steal60/Diamonds] Purchase prompt error:",err) end
            end)
        end
    end
    addRow("Алмазы доступны ТОЛЬКО за Робакс. Бесплатной выдачи нет. Без ID покупка отключена.",Color3.fromRGB(163,185,202))
end

-- Постоянная киношная HUD-панель, не мешающая мини-игре.
local hud = Instance.new("Frame")
hud.Name = "StatusHUD"
hud.Size = UDim2.fromOffset(270,36)
hud.Position = UDim2.fromOffset(12, 12)
hud.BackgroundColor3 = Color3.fromRGB(16, 21, 30)
hud.BackgroundTransparency = 0.07
hud.Parent = gui
corner(hud, 10)
local hudStroke = Instance.new("UIStroke")
hudStroke.Color = Color3.fromRGB(230, 177, 73)
hudStroke.Transparency = 0.35
hudStroke.Thickness = 1.5
hudStroke.Parent = hud
local hudText = Instance.new("TextLabel")
hudText.Size = UDim2.new(1, -18, 1, -8)
hudText.Position = UDim2.fromOffset(12, 4)
hudText.BackgroundTransparency = 1
hudText.TextColor3 = Color3.fromRGB(248, 235, 195)
hudText.Font = Enum.Font.GothamBold
hudText.TextSize = 12
hudText.TextXAlignment = Enum.TextXAlignment.Left
hudText.Text = "УГОН / 60\nЗагрузка..."
hudText.Parent = hud

task.spawn(function()
    while player.Parent do
        local ls=player:FindFirstChild("leaderstats")
        local cash=statValue(player,'money')
        local gems=statValue(player,'diamonds')
        local hourly=math.max(0,tonumber(player:GetAttribute("SalonIncomePerHour")) or 0)
        if cash and gems then
            local function short(n)
             if n&gt;=1e9 then return("%.2f млрд"):format(n/1e9)elseif n&gt;=1e6 then return("%.1f млн"):format(n/1e6)elseif n&gt;=1e4 then return("%.1f тыс."):format(n/1e3)end;return fmt(n)
            end
            hudText.Text=("$ %s · %s/ч · 💎 %s"):format(short(cash.Value),short(hourly),short(gems.Value))
            local width=game:GetService('TextService'):GetTextSize(hudText.Text,12,Enum.Font.GothamBold,Vector2.new(800,30)).X+25
            hud.Size=UDim2.fromOffset(math.clamp(width,170,345),36)
        end
        task.wait(.7)
    end
end)

local function setMenuOpen(open)
    panel.Visible = open
    hud.Visible = not HUDLayout.suppressHud(player)
    player:SetAttribute("Steal60MenuOpen", open)
    if open then
        renderTab(currentTab)
    end
end
player:SetAttribute("Steal60MenuOpen", false)
UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.KeyCode == Enum.KeyCode.Escape and panel.Visible then
        setMenuOpen(false)
    end
end)

