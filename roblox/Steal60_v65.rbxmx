intro.BackgroundColor3 = Color3.fromRGB(7, 9, 14)
intro.Size = UDim2.fromScale(1, 1)
intro.ZIndex = 100
intro.Parent = gui
local movieTitle = Instance.new("TextLabel")
movieTitle.AnchorPoint = Vector2.new(0.5, 0.5)
movieTitle.Position = UDim2.fromScale(0.5, 0.45)
movieTitle.Size = UDim2.fromScale(0.9, 0.3)
movieTitle.BackgroundTransparency = 1
movieTitle.TextColor3 = Color3.fromRGB(240, 196, 92)
movieTitle.Font = Enum.Font.GothamBlack
movieTitle.TextScaled = true
movieTitle.TextWrapped = true
movieTitle.Text = "УГНАТЬ ЗА 60 СЕКУНД"
movieTitle.ZIndex = 101
movieTitle.Parent = intro
local subtitle = Instance.new("TextLabel")
subtitle.AnchorPoint = Vector2.new(0.5, 0.5)
subtitle.Position = UDim2.fromScale(0.5, 0.64)
subtitle.Size = UDim2.fromScale(0.9, 0.08)
subtitle.BackgroundTransparency = 1
subtitle.TextColor3 = Color3.fromRGB(215, 218, 230)
subtitle.Font = Enum.Font.Gotham
subtitle.TextScaled = true
subtitle.Text = "ТВОЯ КОЛЛЕКЦИЯ. ТВОИ ПРАВИЛА."
subtitle.ZIndex = 101
subtitle.Parent = intro
task.delay(2, function()
    local info = TweenInfo.new(1.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    TweenService:Create(movieTitle, info, { TextTransparency = 1 }):Play()
    TweenService:Create(subtitle, info, { TextTransparency = 1 }):Play()
    local tween = TweenService:Create(intro, info, { BackgroundTransparency = 1 })
    tween.Completed:Connect(function() intro:Destroy() end)
    tween:Play()
end)

local tabButtons = {}
function renderTab(tab)
	currentTab = tab
	for name, btn in pairs(tabButtons) do
		btn.BackgroundColor3 = name == tab and MenuWidgets.accent or Color3.fromRGB(41,65,81)
        btn.TextColor3 = name == tab and Color3.fromRGB(16,34,39) or Color3.fromRGB(224,239,244)
	end
	clearContent()
    if tab == "top" then
        addRow("ТОП-100 · монеты, заработанные за текущий сезон (30 дней)",Color3.fromRGB(246,214,121))
        addRow("ОБНОВИТЬ СПИСОК",Color3.fromRGB(126,229,214),function()
            task.wait(2.1)
            renderTab("top")
        end)
        local ok,result=pcall(function() return GetSeasonTop:InvokeServer() end)
        if not ok or not result or result.rateLimited then
            addRow("Рейтинг загружается. Закрой и открой эту вкладку через несколько секунд.",Color3.fromRGB(241,167,109))
            return
        end
        addRow("До "..os.date("!%d.%m.%Y",result.endsAt or os.time()).." (UTC) · обновление ~95 сек.",Color3.fromRGB(167,204,220))
        if result.status and result.status~="" then addRow(result.status,Color3.fromRGB(240,173,106)) end
        if not result.entries or #result.entries==0 then
            addRow("Пока нет результатов в этом сезоне.",Color3.fromRGB(180,198,211))
        else
            for i,rec in ipairs(result.entries) do
                local c=(i&lt;=3) and Color3.fromRGB(249,209,112) or Color3.fromRGB(215,230,245)
                addRow(("%d. %s   ·   $ %s"):format(rec.rank,rec.name,fmt(rec.score)),c)
            end
        end
        return
    end
	if tab=="odds"then MenuViews.render("odds",content,{},{});return end
	local ok, data = pcall(function()
		return GetMenuData:InvokeServer()
	end)
	if not ok or not data then
		addRow("Данные ещё загружаются, попробуй через секунду.", Color3.fromRGB(255, 120, 120))
		return
	end
    if tab=='catalog'then renderCatalog(data);return end
    local function refresh()task.delay(.4,function()if panel.Visible then renderTab(currentTab)end end)end
    local function atelier(category)
     setMenuOpen(false);player:SetAttribute('Steal60AtelierTab',nil);player:SetAttribute('Steal60AtelierTab',category)
    end
    MenuViews.render(tab,content,data,{
     player=player,
     coin=function(id)remotes.BuyCoinUpgrade:FireServer(id);refresh()end,
     diamond=function(id)BuyUpgrade:FireServer(id);refresh()end,
     star=function(id)remotes.ManageWorkshop:FireServer('upgradeShelf',id);refresh()end,
     mastery=function(category,currency)
      local verb=category=='hero'and(currency=='coins'and'upgradeHeroCoins'or'upgradeHeroDiamonds')or(currency=='coins'and'upgradePetCoins'or'upgradePetDiamonds')
      remotes.CosmeticAction:FireServer(verb,category);refresh()
     end,
     vip=function(id)remotes.BuyVIP:FireServer(id);refresh()end,
     product=function(product)Marketplace:PromptProductPurchase(player,product.assetId)end,
     atelier=atelier,
     handbook=function()setMenuOpen(false);player:SetAttribute('Steal60OpenHandbook',not player:GetAttribute('Steal60OpenHandbook'))end
    })
end

for tabIndex, t in ipairs({ { "catalog", "Каталог" }, { "salon", "Салон" }, { "parts", "Детали" }, { "upgrade", "Прокачка" }, { "shop", "Магазин" }, { "odds", "Шансы" }, { "top", "Топ-100" } }) do
	local b = Instance.new("TextButton")
    b.LayoutOrder=tabIndex;b.Size=UDim2.fromOffset(91,36)
	b.TextColor3 = Color3.new(1, 1, 1)
	b.Font = Enum.Font.GothamBold
    b.TextSize = 12
	b.Text = t[2]
	b.Parent = tabsRow
	corner(b, 8)
	b.Activated:Connect(function()
		renderTab(t[1])
	end)
	tabButtons[t[1]] = b
end

local currencyUpdate=remotes:WaitForChild("CurrencyUpdate")
currencyUpdate.OnClientEvent:Connect(function()
    if panel.Visible and (currentTab=="upgrade" or currentTab=="shop") then
        task.defer(function()
            if panel.Visible then renderTab(currentTab) end
        end)
    end
end)

remotes:WaitForChild("ShowTop100").OnClientEvent:Connect(function()
    currentTab = "top"
    setMenuOpen(true)
    renderTab("top")
end)
menuBtn.Activated:Connect(function()
    setMenuOpen(not panel.Visible)
end)
closeBtn.Activated:Connect(function()
    setMenuOpen(false)
end)

----------------------------------------------------------------------
-- Окно вскрытия машины
----------------------------------------------------------------------
local revealFrame
LootReveal.OnClientEvent:Connect(function(payload)
	if revealFrame then
		revealFrame:Destroy()
	end
	local f = Instance.new("Frame")
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.Position = UDim2.fromScale(0.5, 0.45)
	f.Size = UDim2.fromOffset(440, 60 + 34 * #payload.items + (payload.gotStar and 30 or 0))
	f.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
	f.BackgroundTransparency = 0.05
	f.Parent = gui
	corner(f, 12)
	revealFrame = f

	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, -20, 0, 40)
	title.Position = UDim2.fromOffset(10, 8)
	title.BackgroundTransparency = 1
	title.TextColor3 = rarityColor(payload.carRarity)
	title.Font = Enum.Font.GothamBold
	title.TextSize = 22
	title.Text = ("%s · МАШИНА +%s$%s"):format(payload.carName,fmt(payload.carReward or 0),payload.isNew and " · НОВИНКА" or "")
	title.Parent = f

	local y = 52
	if payload.gotStar then
		local s = Instance.new("TextLabel")
		s.Size = UDim2.new(1, -20, 0, 26)
		s.Position = UDim2.fromOffset(10, y)
		s.BackgroundTransparency = 1
		s.TextColor3 = Color3.fromRGB(255, 220, 90)
		s.Font = Enum.Font.GothamBold
		s.TextSize = 18
		s.Text = "Машина получила звезду: больше предметов и дохода!"
		s.Parent = f
		y += 30
	end
	for _, it in ipairs(payload.items) do
		local r = Instance.new("TextLabel")
		r.Size = UDim2.new(1, -20, 0, 30)
		r.Position = UDim2.fromOffset(10, y)
		r.BackgroundColor3 = Color3.fromRGB(42, 42, 50)
		r.TextColor3 = rarityColor(it.rarity)
		r.Font = Enum.Font.GothamBold
		r.TextSize = 16
		r.TextXAlignment = Enum.TextXAlignment.Left
		if it.sold then
			r.Text = (" %s · %s · продано +%s"):format(it.name, rarityName(it.rarity), fmt(it.soldFor))
		else
			r.Text = (" %s · %s · +%s $/ч"):format(it.name, rarityName(it.rarity), fmt(it.income*3600))
		end
		r.Parent = f
		corner(r, 6)
		y += 34
	end

	local mine = f
	task.delay(0.95, function()
		if revealFrame == mine then
			revealFrame:Destroy()
			revealFrame = nil
		end
	end)
end)

print("[Steal60/Client] Gameplay v11: hack, steering, recovery R, salon menu ready")


----------------------------------------------------------------------
-- v22 / PERSONALISED SHOWROOM PROMPTS.
-- Only one E-button appears: ride for the owner, burglary for visitors.
-- The two server prompts retain independent hold time and server handlers.
----------------------------------------------------------------------
local function configureShowroomPrompt(prompt)
    if not prompt:IsA("ProximityPrompt") then return end
    if prompt.Name ~= "SalonRidePrompt" and prompt.Name ~= "SalonTheftPrompt" then return end
    local car=prompt:FindFirstAncestorOfClass("Model")
    if not car then return end
    local function update()
        if not prompt.Parent or not car.Parent then return end
        local isDisplay=car:GetAttribute("State")=="display"
        local mine=car:GetAttribute("OwnerId")==player.UserId
        if prompt.Name=="SalonRidePrompt" then
            local shouldEnable=isDisplay and mine
            if prompt.Enabled~=shouldEnable then prompt.Enabled=shouldEnable end
            prompt.ActionText="Поехать"
            prompt.ObjectText="Твоя машина"
        elseif prompt.Name=="SalonTheftPrompt" then
            local shouldEnable=isDisplay and not mine
            if prompt.Enabled~=shouldEnable then prompt.Enabled=shouldEnable end
            prompt.KeyboardKeyCode=Enum.KeyCode.E
            prompt.ActionText="Украсть"
        end
    end
    car:GetAttributeChangedSignal("OwnerId"):Connect(update)
    car:GetAttributeChangedSignal("State"):Connect(update)
    prompt:GetPropertyChangedSignal("Name"):Connect(update)
    -- Reapply the local visibility rule if the server refreshes Enabled.
    prompt:GetPropertyChangedSignal("Enabled"):Connect(update)
    update()
    task.defer(update)
end

for _, obj in ipairs(workspace:GetDescendants()) do
    if obj:IsA("ProximityPrompt") then configureShowroomPrompt(obj) end
end
workspace.DescendantAdded:Connect(function(obj)
    if obj:IsA("ProximityPrompt") then
        configureShowroomPrompt(obj)
    end
end)

