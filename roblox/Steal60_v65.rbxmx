player:GetAttributeChangedSignal("Steal60DetailsOpen"):Connect(updateVisibility)
player:GetAttributeChangedSignal("Steal60MenuOpen"):Connect(updateVisibility)
updateVisibility()
rounded(panel, 13)
local outline = Instance.new("UIStroke")
outline.Color = C(86, 190, 194)
outline.Transparency = .50
outline.Thickness = 1
outline.Parent = panel
text(panel, "Title", UDim2.new(1,-20,0,22), UDim2.fromOffset(13,8), Enum.Font.GothamBlack, 14, C(122,224,219), "ОПЕРАЦИЯ / 60 СЕК")
local header = text(panel, "Streak", UDim2.new(1,-20,0,20), UDim2.fromOffset(13,30), Enum.Font.GothamBold, 13, C(244,240,224), "Серия: 0 · Следующая цель")
local xp = text(panel, "XP", UDim2.new(1,-20,0,19), UDim2.fromOffset(13,54), Enum.Font.GothamMedium, 12, C(192,202,217), "Взлом · ОПЫТ 0/12")
local base = Instance.new("Frame")
base.Name="XPTrack";base.Position=UDim2.fromOffset(14,77)
base.Size=UDim2.new(1,-28,0,5);base.BorderSizePixel=0
base.BackgroundColor3=C(49,62,76);base.Parent=panel;rounded(base,3)
local fill = Instance.new("Frame")
fill.Name="XPFill";fill.Size=UDim2.fromScale(0,1)
fill.BackgroundColor3=C(99,218,162);fill.BorderSizePixel=0;fill.Parent=base;rounded(fill,3)
text(panel, "QuestHeading", UDim2.new(1,-20,0,18), UDim2.fromOffset(13,87), Enum.Font.GothamBold, 11, C(116,188,205), "ЕЖЕДНЕВНЫЕ КОНТРАКТЫ")
local questLabels = {}
for i=1,3 do
    local label=text(panel, "Daily"..i, UDim2.new(1,-25,0,17), UDim2.fromOffset(14,105+(i-1)*18), Enum.Font.GothamMedium, 12, C(204,213,223), "—")
    questLabels[i]=label
end
local status=text(panel, "Status", UDim2.new(1,-25,0,20), UDim2.fromOffset(14,166), Enum.Font.GothamBold, 11, C(244,192,110), "Доставка: без жёсткого таймера")
local names={
    {key="completed",title="Доставки",goal=3},
    {key="precise",title="Точный взлом",goal=2},
    {key="rare",title="Редкая машина",goal=1},
}
local function update()
    if not player:GetAttribute("DataLoaded") then
        header.Text="Загрузка прогресса..."
        return
    end
    local streak=player:GetAttribute("HeistStreak") or 0
    local level=statValue(player,'hacking')
    local lv=level and level.Value or 1
    header.Text=("СЕРИЯ x%d  ·  ВЗЛОМ %d"):format(streak,lv)
    local cur=player:GetAttribute("HeistXP") or 0
    local needed=math.max(1,player:GetAttribute("HeistXPNeed") or 12)
    xp.Text=("ПРОГРЕСС НАВЫКА   %d / %d ОПЫТ"):format(cur,needed)
    fill.Size=UDim2.new(math.clamp(cur/needed,0,1),0,1,0)
    for i,m in ipairs(names) do
        local value=player:GetAttribute("HeistQuest_"..m.key) or 0
        local claimed=player:GetAttribute("HeistQuestClaimed_"..m.key) == true
        local label=questLabels[i]
        label.Text=(claimed and "✓  " or "•  ")..m.title..("   %d/%d"):format(value,m.goal)
        label.TextColor3=claimed and C(108,233,160) or C(211,218,230)
    end
    if player:GetAttribute("HeistCarrying") then
        status.Text="ЦЕЛЬ: ЗЕЛЁНАЯ ПАРКОВКА ТВОЕГО САЛОНА"
        status.TextColor3=C(255,209,115)
    elseif player:GetAttribute("HelperUnlocked") ~= true then
        status.Text="ПЕРВЫЙ УГОН: БЕГИ ПЕШКОМ К МАШИНЕ"
        status.TextColor3=C(255,208,115)
    else
        local grade=player:GetAttribute("HeistLastGrade")
        if grade then
            status.Text=("ПОСЛЕДНИЙ ЗАЕЗД: %s · НОВАЯ ЦЕЛЬ"):format(grade)
        else
            status.Text="НАЙДИ МАШИНУ И ПРОЙДИ ВЗЛОМ"
        end
        status.TextColor3=C(125,222,199)
    end
end
-- Poll cheap attributes, no remotes or per-frame UI allocations.
task.spawn(function()
    while panel.Parent do
        update();updateVisibility()
        task.wait(.35)
    end
end)
</ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX_CHALLENGE_HUD_V4"><Properties><string name="Name">RoadChallengeHUD</string><ProtectedString name="Source">local HUDLayout=require(game:GetService('ReplicatedStorage').Shared.HUDLayout)
-- Compact read-only event board; all rewards originate from the server.
local player=game:GetService("Players").LocalPlayer
local gui=script.Parent
local C=Color3.fromRGB
local panel=Instance.new("Frame")
panel.Name="RoadEventBoard"
panel.AnchorPoint=Vector2.new(1,0)
panel.Position=UDim2.new(1,-18,0,228)
panel.Size=UDim2.fromOffset(290,93)
panel.BackgroundColor3=C(15,24,35)
panel.BackgroundTransparency=.08
panel.BorderSizePixel=0
panel.Parent=gui
-- Do not cover the delivery compass or contract HUD during ordinary play.
local function updateVisibility()panel.Visible=HUDLayout.detailsVisible(player,'road')end
player:GetAttributeChangedSignal("Steal60DetailsOpen"):Connect(updateVisibility)
updateVisibility()
local corner=Instance.new("UICorner");corner.CornerRadius=UDim.new(0,11);corner.Parent=panel
local stroke=Instance.new("UIStroke");stroke.Color=C(236,182,82);stroke.Transparency=.50;stroke.Parent=panel
local function row(name,y,sz,tint)
    local t=Instance.new("TextLabel")
    t.Name=name;t.BackgroundTransparency=1
    t.Position=UDim2.fromOffset(12,y)
    t.Size=UDim2.new(1,-24,0,sz+4)
    t.TextColor3=tint;t.Font=Enum.Font.GothamBold
    t.TextSize=sz;t.TextXAlignment=Enum.TextXAlignment.Left
    t.TextTruncate=Enum.TextTruncate.AtEnd
    t.Parent=panel
    return t
end
local title=row("Title",7,11,C(255,207,115))
local job=row("Contract",27,14,C(245,245,247))
local status=row("RoadStatus",54,11,C(162,208,220))
local hint=row("Bonus",73,10,C(143,214,166))
while panel.Parent do
    local name=player:GetAttribute("RoadContractTitle")
    local money=player:GetAttribute("RoadContractReward") or 0
    title.Text="СПЕЦЗАКАЗ / ГОРОДСКИЕ СОБЫТИЯ"
    job.Text=name and (name.."  ·  +"..tostring(money).."$") or "Загрузка контракта..."
    local event=player:GetAttribute("RoadEventHint")
    status.Text=(event and event~="") and event or "Ищи машины с золотой меткой ★"
    hint.Text=(player:GetAttribute("RoadCheckpointCount") or 0)&gt;0 and "Объезд полиции: +10% за поездку" or "Проезжай посты по свободной полосе"
    task.wait(.45)
end
</ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX_THEFT_HUD_V9_001"><Properties><string name="Name">TheftHUD</string><bool name="Disabled">false</bool><ProtectedString name="Source">local HUDLayout=require(game:GetService('ReplicatedStorage').Shared.HUDLayout)
-- Salon theft progress HUD with clearer progression preview.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local player = Players.LocalPlayer
local gui = script.Parent
local C = Color3.fromRGB
local AccessoryConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"):WaitForChild("AccessoryConfig"))

local panel = Instance.new("Frame")
panel.Name = "TheftProgress"
panel.AnchorPoint = Vector2.new(1,0)
panel.Position = UDim2.new(1,-18,0,340)
panel.Size = UDim2.fromOffset(290,150)
panel.BackgroundColor3 = C(21,26,38)
panel.BackgroundTransparency = .10
panel.BorderSizePixel = 0
panel.Parent = gui
local function updateVisibility()panel.Visible=HUDLayout.detailsVisible(player,'theft')end
player:GetAttributeChangedSignal("Steal60DetailsOpen"):Connect(updateVisibility)
player:GetAttributeChangedSignal("Steal60MenuOpen"):Connect(updateVisibility)
updateVisibility()
local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0,12)
corner.Parent = panel
local stroke = Instance.new("UIStroke")
stroke.Color = C(102,190,161)
stroke.Transparency = .42
stroke.Parent = panel

local function makeLabel(name,pos,size,txt,color,font,pt)
    local t=Instance.new("TextLabel")
    t.Name=name
    t.BackgroundTransparency=1
    t.Position=pos
    t.Size=size
    t.TextXAlignment=Enum.TextXAlignment.Left
    t.TextYAlignment=Enum.TextYAlignment.Top
    t.Font=font or Enum.Font.GothamMedium
    t.TextSize=pt or 12
    t.TextColor3=color or C(224,235,244)
    t.TextWrapped=true
    t.Text=txt or ""
    t.Parent=panel
    return t
end

makeLabel("Title", UDim2.fromOffset(13,8), UDim2.new(1,-26,0,18), "НАЛЁТЫ НА САЛОНЫ", C(139,242,195), Enum.Font.GothamBold, 15)
local iconBack = Instance.new("Frame")
iconBack.Position = UDim2.fromOffset(13,34)
iconBack.Size = UDim2.fromOffset(52,52)
iconBack.BackgroundColor3 = C(31,44,60)
iconBack.BorderSizePixel = 0
iconBack.Parent = panel
local ic = Instance.new("UICorner")
ic.CornerRadius = UDim.new(0,10)
ic.Parent = iconBack
local iconTitle = Instance.new("TextLabel")
iconTitle.BackgroundTransparency = 1
iconTitle.Size = UDim2.new(1,0,1,0)
iconTitle.Font = Enum.Font.GothamBlack
iconTitle.TextSize = 28
iconTitle.Text = "1"
iconTitle.TextColor3 = C(255,215,110)
iconTitle.Parent = iconBack

local progress = makeLabel("Progress", UDim2.fromOffset(75,34), UDim2.new(1,-88,0,18), "Налёт на салон: 0/50", C(243,245,248), Enum.Font.GothamBold, 15)
local itemName = makeLabel("ItemName", UDim2.fromOffset(75,56), UDim2.new(1,-88,0,18), "Следующая деталь", C(103,217,245), Enum.Font.GothamBold, 13)
local desc = makeLabel("Desc", UDim2.fromOffset(75,78), UDim2.new(1,-88,0,16), "+0% к деньгам за угоны", C(198,211,225), Enum.Font.GothamMedium, 12)
local footer = makeLabel("Footer", UDim2.fromOffset(13,119), UDim2.new(1,-26,0,14), "", C(126,255,176), Enum.Font.GothamBold, 11)

local bar = Instance.new("Frame")
bar.Position = UDim2.fromOffset(75,108)
bar.Size = UDim2.new(1,-88,0,7)
bar.BackgroundColor3 = C(50,61,74)
bar.BorderSizePixel = 0
bar.Parent = panel
local bc = Instance.new("UICorner")
bc.CornerRadius = UDim.new(0,4)
bc.Parent = bar
local fill = Instance.new("Frame")
fill.Size = UDim2.fromScale(0,1)
fill.BackgroundColor3 = C(102,240,184)
fill.BorderSizePixel = 0
fill.Parent = bar
local fc = Instance.new("UICorner")
fc.CornerRadius = UDim.new(0,4)
fc.Parent = fill

local function update()
    local count = tonumber(player:GetAttribute("TheftCount")) or 0
    local level = tonumber(player:GetAttribute("TheftLevel")) or 1
    local untilTime = tonumber(player:GetAttribute("TheftCooldownUntil")) or 0
    local bonus = tonumber(player:GetAttribute("TheftIncomeBoostPct")) or 0
    local remain = math.max(0, math.ceil(untilTime - workspace:GetServerTimeNow()))
    local need = AccessoryConfig.SALON_STEALS_PER_DROP
    local current=count%need
    local zone=math.clamp(math.floor(tonumber(player:GetAttribute("LastHeistZone")) or 1),1,5)
    local pool={}
    for _,part in ipairs(AccessoryConfig.List) do
        if part.zone==zone then table.insert(pool,part) end
    end
    local part=pool[(math.floor(count/need)%#pool)+1]
    progress.Text = ("Налёт на салон: %d/%d"):format(current,need)
    itemName.Text = "Пример: "..part.name
    itemName.TextColor3 = part.color
    desc.Text = ("Район %d · +%d%% (случайная деталь)"):format(zone,part.basePct)
    fill.Size = UDim2.new(math.clamp(current/need,0,1),0,1,0)
    fill.BackgroundColor3 = part.color
    iconTitle.Text = "★"
    iconTitle.TextColor3 = part.color
    footer.Text = remain &gt; 0 and (("Откат: %d:%02d  ·  суммарный бонус: +%d%%"):format(math.floor(remain/60), remain%60, bonus)) or (("Готов к налёту  ·  суммарный бонус: +%d%%"):format(bonus))
end
for _, attr in ipairs({"TheftCount","TheftLevel","TheftCooldownUntil","TheftIncomeBoostPct","LastHeistZone","Steal60MenuOpen","Steal60DetailsOpen"}) do
    player:GetAttributeChangedSignal(attr):Connect(update)
end
update()
task.spawn(function()
    while panel.Parent do
        task.wait(1)
        update()
        updateVisibility()
    end
end)
</ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX_TUTORIAL_HUD_V14"><Properties><string name="Name">TutorialHUD</string><ProtectedString name="Source">-- Short top-centre coach; the lower corners are reserved for mobile controls.
local Players=game:GetService('Players');local RS=game:GetService('ReplicatedStorage')
local player=Players.LocalPlayer;local gui=script.Parent;local C=Color3.fromRGB
local Config=require(RS:WaitForChild('Shared'):WaitForChild('TutorialConfig'))
local remotes=RS:WaitForChild('Remotes');local action=remotes:WaitForChild('TutorialAction')
local snapshot={index=1,total=#Config.Steps,done={}};local collapsed=false;local book
local function round(p,r)local c=Instance.new('UICorner');c.CornerRadius=UDim.new(0,r);c.Parent=p end
local function label(p,pos,size,pt,color)
 local t=Instance.new('TextLabel');t.BackgroundTransparency=1;t.Position=pos;t.Size=size;t.TextSize=pt
 t.Font=Enum.Font.GothamMedium;t.TextColor3=color;t.TextWrapped=true;t.TextXAlignment=Enum.TextXAlignment.Left;t.Parent=p;return t
end
local function button(p,text,pos,size,fn)
 local b=Instance.new('TextButton');b.Text=text;b.Position=pos;b.Size=size;b.TextSize=12;b.Font=Enum.Font.GothamBold
 b.BackgroundColor3=C(35,83,79);b.TextColor3=C(194,255,226);b.BorderSizePixel=0;b.Parent=p;round(b,8);b.Activated:Connect(fn);return b
end
local coach=Instance.new('Frame');coach.Name='Steal60LessonCoach';coach.AnchorPoint=Vector2.new(.5,0)
coach.Position=UDim2.new(.5,0,0,110);coach.Size=UDim2.new(.88,0,0,112);coach.BackgroundColor3=C(15,31,43)
coach.BackgroundTransparency=.08;coach.BorderSizePixel=0;coach.Parent=gui;round(coach,12)
local cap=Instance.new('UISizeConstraint');cap.MaxSize=Vector2.new(460,112);cap.Parent=coach
local title=label(coach,UDim2.fromOffset(13,7),UDim2.new(1,-55,0,23),15,C(132,249,189));title.Font=Enum.Font.GothamBold
local body=label(coach,UDim2.fromOffset(13,33),UDim2.new(1,-26,0,67),13,C(218,234,244));body.TextYAlignment=Enum.TextYAlignment.Top
local read=button(coach,'ПОНЯТНО',UDim2.new(1,-126,1,-35),UDim2.fromOffset(113,28),function()if snapshot.id then action:FireServer('read',snapshot.id)end end)
button(coach,'−',UDim2.new(1,-37,0,6),UDim2.fromOffset(26,25),function()collapsed=true;coach.Visible=false end)
local function openBook()
 if book then book:Destroy();book=nil;return end
 book=Instance.new('Frame');book.Name='Steal60Handbook';book.AnchorPoint=Vector2.new(.5,.5);book.Position=UDim2.fromScale(.5,.49)
 book.Size=UDim2.fromScale(.91,.82);book.BackgroundColor3=C(14,25,40);book.BorderSizePixel=0;book.ZIndex=20;book.Parent=gui;round(book,14)
 local limit=Instance.new('UISizeConstraint');limit.MaxSize=Vector2.new(730,650);limit.Parent=book
 local h=label(book,UDim2.fromOffset(15,10),UDim2.new(1,-75,0,30),19,C(236,247,244));h.Text='РУКОВОДСТВО';h.ZIndex=21
 button(book,'X',UDim2.new(1,-49,0,10),UDim2.fromOffset(35,31),function()book:Destroy();book=nil end).ZIndex=22
 button(book,'ПОВТОРИТЬ КОРОТКОЕ ОБУЧЕНИЕ',UDim2.fromOffset(12,48),UDim2.new(1,-24,0,33),function()
  action:FireServer('restart');book:Destroy();book=nil;collapsed=false
 end).ZIndex=21
 local scroll=Instance.new('ScrollingFrame');scroll.Position=UDim2.fromOffset(12,92);scroll.Size=UDim2.new(1,-24,1,-104)
 scroll.BackgroundTransparency=1;scroll.BorderSizePixel=0;scroll.ScrollBarThickness=5;scroll.CanvasSize=UDim2.new();scroll.AutomaticCanvasSize=Enum.AutomaticSize.Y;scroll.ZIndex=21;scroll.Parent=book
 local list=Instance.new('UIListLayout');list.Padding=UDim.new(0,9);list.Parent=scroll
 for i,chapter in ipairs(Config.Handbook)do
  local row=Instance.new('Frame');row.Size=UDim2.new(1,-8,0,0);row.AutomaticSize=Enum.AutomaticSize.Y
  row.BackgroundColor3=C(27,43,59);row.BorderSizePixel=0;row.LayoutOrder=i;row.ZIndex=21;row.Parent=scroll;round(row,9)
  local padding=Instance.new('UIPadding');padding.PaddingTop=UDim.new(0,10);padding.PaddingBottom=UDim.new(0,12);padding.PaddingLeft=UDim.new(0,12);padding.PaddingRight=UDim.new(0,12);padding.Parent=row
  local layout=Instance.new('UIListLayout');layout.Padding=UDim.new(0,7);layout.Parent=row
  local h=label(row,UDim2.new(),UDim2.new(1,0,0,24),14,C(138,239,192));h.Text=chapter.title;h.Font=Enum.Font.GothamBold;h.ZIndex=22
  local d=label(row,UDim2.new(),UDim2.new(1,0,0,0),13,C(205,222,236));d.Text=chapter.body;d.AutomaticSize=Enum.AutomaticSize.Y;d.ZIndex=22
 end
end
local help=button(gui,'РУКОВОДСТВО',UDim2.new(.5,-70,1,-96),UDim2.fromOffset(140,32),openBook)
local resume=button(gui,'ПОКАЗАТЬ ЦЕЛЬ',UDim2.new(.5,-70,1,-136),UDim2.fromOffset(140,32),function()collapsed=false end)
local highlight=Instance.new('Highlight');highlight.Name='TutorialTargetGlow';highlight.FillColor=C(95,255,177)
highlight.FillTransparency=.75;highlight.OutlineColor=C(150,255,205);highlight.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop;highlight.Parent=gui
local function draw()
 if book and not book.Parent then book=nil end
 local step=snapshot.id and Config.ById[snapshot.id]
 local busy=player:GetAttribute('Steal60MenuOpen')==true or player:GetAttribute('HackActive')==true or player:GetAttribute('CosmeticPreviewToken')~=nil
 coach.Visible=step~=nil and not collapsed and not book and not busy
 local refCar=player:FindFirstChild('Steal60DriveCar');local driving=refCar and refCar.Value~=nil
 help.Visible=not busy and not book and not driving;resume.Visible=step~=nil and collapsed and not busy and not book and not driving
 local ref=player:FindFirstChild('TutorialTarget');highlight.Adornee=ref and ref.Value or nil
 highlight.Enabled=step~=nil and not busy and not book and highlight.Adornee~=nil
 if not step then return end
 local camera=workspace.CurrentCamera;local compact=camera and camera.ViewportSize.Y&lt;500
 coach.Position=UDim2.new(.5,0,0,compact and(camera.ViewportSize.Y&lt;420 and 14 or 72)or 110);coach.Size=UDim2.new(.88,0,0,compact and 78 or 112)
 cap.MaxSize=Vector2.new(460,compact and 78 or 112)
 body.TextSize=compact and 11 or 13
 title.TextSize=compact and 13 or 15
 title.Text=('%d/%d · %s'):format(snapshot.index,#Config.Steps,step.title);body.Text=step.body
 read.Visible=step.lesson==true;read.Active=snapshot.canRead==true
 body.Size=UDim2.new(1,step.lesson and compact and-150 or-26,0,compact and 31 or(step.lesson and 40 or 67))
 if compact then body.Text=({start='Следуй стрелке к машине ВЗЛОМ 1+ и начни угон.',lock='Нажми в зелёной зоне. Промах можно повторить.',delivery='По стрелке к своему гаражу. В зелёной рамке остановись.',loot='Монеты получены. Предмет приносит доход на полке.',ride='Нажми «Поехать» на отмеченной своей машине.',income='Мастер → Увеличить доход за монеты. Касса у входа.'})[step.id]or step.body end
 if snapshot.awaitingShowcase then body.Text='Витрина пуста. МЕНЮ → КАТАЛОГ → ОСТАВИТЬ НА ВИТРИНЕ, затем нажми «Поехать» у машины.'end
 if step.id=='loot'and not compact then body.Text=('+монеты за доставку · %s уже на полке.\nТеперь он приносит деньги в кассу у входа.'):format(snapshot.itemName or'Найденный предмет')end
end
remotes:WaitForChild('TutorialUpdate').OnClientEvent:Connect(function(payload)
 if type(payload)~='table'then return end
 if payload.id~=snapshot.id then collapsed=false end;snapshot=payload;draw()
end)
for _,name in ipairs({'Steal60MenuOpen','HackActive'})do player:GetAttributeChangedSignal(name):Connect(draw)end
player:GetAttributeChangedSignal('Steal60OpenHandbook'):Connect(openBook)
action:FireServer('request');task.spawn(function()while gui.Parent do draw();task.wait(.25)end;highlight:Destroy()end)
</ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX_V33_ECONOMY_HUD"><Properties><string name="Name">EconomyHUD</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Static vendor interfaces: upgrades, automatic income shelves, collections and diamonds.
-- Client renders data; all purchases, prices and swaps are checked by server.
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local Marketplace = game:GetService("MarketplaceService")
local Input = game:GetService("UserInputService")
local player = Players.LocalPlayer
local gui = script.Parent
local remotes = RS:WaitForChild("Remotes")
local openRemote = remotes:WaitForChild("OpenEconomyNPC")
local getData = remotes:WaitForChild("GetMenuData")
local buyCoin = remotes:WaitForChild("BuyCoinUpgrade")
local buyDiamond = remotes:WaitForChild("BuyUpgrade")
local buyVIP = remotes:WaitForChild("BuyVIP")
local manage = remotes:WaitForChild("ManageWorkshop")
local Config = RS:WaitForChild("Shared"):WaitForChild("Config")
local Monetization = require(Config:WaitForChild("MonetizationConfig"))
local VIP = require(Config:WaitForChild("VIPConfig"))
local C = Color3.fromRGB

local function fmt(n)
    local v = math.max(0, math.floor(tonumber(n) or 0))
    return tostring(v):reverse():gsub("(%d%d%d)","%1 "):reverse():gsub("^ ","")
end
local function round(obj,rad)
    local x=Instance.new("UICorner"); x.CornerRadius=UDim.new(0,rad); x.Parent=obj
end
local function label(parent,name,size,pos,textValue,font,pt,color)
    local t=Instance.new("TextLabel")
    t.Name=name;t.Size=size;t.Position=pos;t.BackgroundTransparency=1
    t.Text=tostring(textValue or "");t.Font=font or Enum.Font.Gotham
    t.TextSize=pt or 13;t.TextColor3=color or C(222,231,239)
    t.TextWrapped=true;t.TextXAlignment=Enum.TextXAlignment.Left
    t.TextYAlignment=Enum.TextYAlignment.Center;t.Parent=parent
    return t
end
local function button(parent,textValue,pos,size,callback,enabled)
    local b=Instance.new("TextButton")
    b.Size=size;b.Position=pos;b.Font=Enum.Font.GothamBold;b.TextSize=12
    b.TextWrapped=true;b.Text=tostring(textValue or "")
    b.TextColor3=enabled==false and C(161,170,181) or C(15,28,37)
    b.BackgroundColor3=enabled==false and C(65,75,85) or C(111,222,173)
    b.BorderSizePixel=0;b.AutoButtonColor=enabled~=false
    b.Active=enabled~=false;b.Parent=parent;round(b,9)
    if callback and enabled~=false then b.Activated:Connect(callback) end
    return b
end
local panel=Instance.new("Frame")
panel.Name="Steal60NPCShopV35"
