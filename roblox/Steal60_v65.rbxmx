  if s.pendingMirror then local ok=self:_mirror(s.key,s.pendingMirror,options.deadline);if ok then s.pendingMirror=nil end;return ok,ok and nil or'backup'end
  return true
 end
 if not valid(profile)then self:_health(player,'blocked');return false,'invalid_profile'end
 local frozen=copy(profile);local grant
 if options.receipt then
  local after=copy(frozen);local ok=pcall(options.apply,after)
  if not ok or not valid(after)then return false,'invalid_grant'end
  grant=(after.diamonds or 0)-(frozen.diamonds or 0)
  if not finite(grant)or grant&lt;=0 or grant%1~=0 then return false,'invalid_grant'end
 end
