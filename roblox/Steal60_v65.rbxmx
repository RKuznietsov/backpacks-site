</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_STEAL60_V64_LanguageController"><Properties><string name="Name">LanguageController</string><ProtectedString name="Source">-- Local text binding keeps each player's world signs in their own language.
local M={}
function M.start(gui)
 local Players=game:GetService('Players');local RS=game:GetService('ReplicatedStorage')
 local Text=require(script.Parent.TextTranslator);local player=Players.LocalPlayer
 local remote=RS:WaitForChild('Remotes'):WaitForChild('SetLanguage')
 local language=player:GetAttribute('Steal60Language')=='en'and'en'or'ru';local alive=true
 local records=setmetatable({},{__mode='k'});local links={};local switching=false
 local button=Instance.new('TextButton');button.Name='LanguageToggle';button.AnchorPoint=Vector2.new(1,0)
 button.Position=UDim2.new(1,-66,0,14);button.Size=UDim2.fromOffset(44,44);button.ZIndex=120
 button.Font=Enum.Font.GothamBold;button.TextSize=16;button.TextColor3=Color3.fromRGB(185,255,227)
 button.BackgroundColor3=Color3.fromRGB(24,70,66);button.BorderSizePixel=0;button.AutoLocalize=false;button.Parent=gui
 local corner=Instance.new('UICorner');corner.CornerRadius=UDim.new(0,9);corner.Parent=button
 local function listen(signal,fn)local c=signal:Connect(fn);links[#links+1]=c;return c end
 local function update(object,record,property)
  if not alive or not object.Parent then return end
  record.writing=true;object[property]=Text.translate(record.source[property],language);record.writing=false
 end
 local function watch(object)
  if records[object]or object==button or object.Name=='FullName'or object.Name=='Ticker'then return end
  local properties;local statSource
  if object:IsA('IntValue')and object.Parent and object.Parent.Name=='leaderstats'then statSource=Text.statSource(object);if not statSource then return end;properties={'Name'}end
  if properties then
  elseif object:IsA('TextLabel')or object:IsA('TextButton')then properties={'Text'}
  elseif object:IsA('ProximityPrompt')then properties={'ActionText','ObjectText'}else return end
  local record={source={},connections={}};records[object]=record
  for _,property in ipairs(properties)do
   record.source[property]=statSource or object[property]
   record.connections[#record.connections+1]=object:GetPropertyChangedSignal(property):Connect(function()
    if not alive or record.writing then return end
    record.source[property]=statSource or object[property];update(object,record,property)
   end)
   update(object,record,property)
  end
  record.connections[#record.connections+1]=object.Destroying:Connect(function()
   for _,connection in ipairs(record.connections)do connection:Disconnect()end;records[object]=nil
  end)
 end
 local function setLanguage(value)
  if value~='ru'and value~='en'then value='ru'end
  language=value;button.Text=language
  if switching then return end;switching=true
  for object,record in pairs(records)do for property in pairs(record.source)do update(object,record,property)end end
  switching=false
 end
 listen(gui.DescendantAdded,watch);listen(workspace.DescendantAdded,watch)
 listen(Players.DescendantAdded,function(object)if object:IsA('IntValue')then watch(object)end end)
 for _,object in ipairs(Players:GetDescendants())do if object:IsA('IntValue')then watch(object)end end
 for _,object in ipairs(gui:GetDescendants())do watch(object)end
 task.spawn(function()
  for index,object in ipairs(workspace:GetDescendants())do
   if not alive then return end;watch(object);if index%300==0 then task.wait()end
  end
 end)
 listen(player:GetAttributeChangedSignal('Steal60Language'),function()setLanguage(player:GetAttribute('Steal60Language'))end)
 local lastClick=-math.huge
 listen(button.Activated,function()
  if os.clock()-lastClick&lt;.25 then return end;lastClick=os.clock()
  setLanguage(language=='ru'and'en'or'ru');remote:FireServer(language)
 end)
 setLanguage(language)
 gui.Destroying:Connect(function()
  alive=false;for _,connection in ipairs(links)do connection:Disconnect()end
  for object,record in pairs(records)do
   for _,connection in ipairs(record.connections)do connection:Disconnect()end
   if object.Parent then for property,source in pairs(record.source)do object[property]=source end end;records[object]=nil
  end
 end)
end
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_STEAL60_V64_TextTranslator"><Properties><string name="Name">TextTranslator</string><ProtectedString name="Source">-- Exact entries, formatted messages and longest literal fragments; no network translation.
local entries=require(script.Parent.LanguageCatalog)
local M={};local trie={};local buckets={};local anyPrefix={};local cache={};local cacheSize=0
local function word(byte)return byte and((byte&gt;=48 and byte&lt;=57)or(byte&gt;=65 and byte&lt;=90)or(byte&gt;=97 and byte&lt;=122)or byte==95 or byte&gt;=128)end
local function escape(text)return(text:gsub('([%^%$%(%)%%%.%[%]%*%+%-%?])','%%%1'))end
local function splitFormat(text)
 local parts={};local literal='';local kinds={};local i=1
 local function flush()if literal~=''then parts[#parts+1]={text=literal};literal=''end end
 while i&lt;=#text do
  if text:sub(i,i)=='%'then
   local tail=text:sub(i);local token=tail:match('^%%[%d%.]*[dfisq]')
   if tail:sub(1,2)=='%%'then literal..='%';i+=2
   elseif token then flush();local kind=token:sub(-1);kinds[#kinds+1]=kind;parts[#parts+1]={slot=#kinds,kind=kind};i+=#token
   else literal..='%';i+=1 end
  else literal..=text:sub(i,i);i+=1 end
 end
 flush();return parts,kinds
end
for source,target in pairs(entries)do
 local node=trie
 for i=1,#source do local b=source:byte(i);node[b]=node[b]or{};node=node[b]end
 node.value=target;node.source=source
 local from,kinds=splitFormat(source)
 if #kinds&gt;0 then
  local to,toKinds=splitFormat(target);assert(#kinds==#toKinds,'translation format arity')
  local pattern='^';local score=0;local prefix=''
  for index,part in ipairs(from)do
   if part.text then pattern..=escape(part.text);score+=#part.text;if index==1 then prefix=part.text end
   else pattern..=(part.kind=='d'or part.kind=='i')and'([%-]?%d+)'or part.kind=='f'and'([%-%d%.,]+)'or'(.-)'end
  end
  local record={pattern=pattern..'$',parts=to,score=score}
  if #prefix&gt;=3 then local key=prefix:sub(1,3);buckets[key]=buckets[key]or{};table.insert(buckets[key],record)else table.insert(anyPrefix,record)end
 end
end
local function sort(list)table.sort(list,function(a,b)return a.score&gt;b.score end)end
sort(anyPrefix);for _,list in pairs(buckets)do sort(list)end
local function fragments(text)
 local out={};local at=1
 while at&lt;=#text do
  local node=trie;local cursor=at;local best;local finish
  while cursor&lt;=#text and node[text:byte(cursor)]do
   node=node[text:byte(cursor)];cursor+=1
   if node.value then
    local first=node.source:byte(1);local last=node.source:byte(-1)
    if not(word(first)and word(text:byte(at-1)))and not(word(last)and word(text:byte(cursor)))then best=node.value;finish=cursor end
   end
  end
  if best then out[#out+1]=best;at=finish else out[#out+1]=text:sub(at,at);at+=1 end
 end
 return table.concat(out)
end
local translate
translate=function(text,depth)
 if entries[text]then return entries[text]end
 if depth&gt;3 then return fragments(text)end
 local function match(list)
  for _,record in ipairs(list or{})do
   local captures={text:match(record.pattern)}
   if #captures&gt;0 then
    local out={}
    for _,part in ipairs(record.parts)do out[#out+1]=part.text or translate(captures[part.slot],depth+1)end
    return table.concat(out)
   end
  end
 end
 return match(buckets[text:sub(1,3)])or match(anyPrefix)or fragments(text)
end
function M.translate(text,locale)
 if type(text)~='string'or locale~='en'or text==''then return text end
 local result=cache[text];if result then return result end
 result=translate(text,0)
 if cacheSize&gt;=2048 then table.clear(cache);cacheSize=0 end
 cache[text]=result;cacheSize+=1;return result
end
local labels={money={ru='Деньги',en='Coins'},diamonds={ru='Алмазы',en='Diamonds'},hacking={ru='Взлом',en='Hacking'}}
function M.stat(player,id)
 local folder=player:FindFirstChild('leaderstats');if not folder then return nil end
 for _,value in ipairs(folder:GetChildren())do if value:GetAttribute('Steal60StatId')==id then return value end end
 local label=labels[id];return label and(folder:FindFirstChild(label.ru)or folder:FindFirstChild(label.en))or nil
end
function M.statSource(value)
 local id=value:GetAttribute('Steal60StatId');if labels[id]then return labels[id].ru end
 for _,label in pairs(labels)do if value.Name==label.ru or value.Name==label.en then return label.ru end end
end
return M
</ProtectedString></Properties></Item></Item>
    </Item>
    <Item class="Folder" referent="RBX33">
      <Properties>
        <string name="Name">ServerStorage</string>
      </Properties>
      <Item class="Folder" referent="RBX32">
        <Properties>
          <string name="Name">ClientTemplates</string>
        </Properties>
        <Item class="LocalScript" referent="RBX31">
          <Properties>
            <string name="Name">ClientMain</string>
            <ProtectedString name="Source">-- LocalScript: клонируется сервером в PlayerGui (ScreenGui "Steal60Client")
-- Содержит: уведомления, мини-игру взлома, управление угнанной машиной.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local gui = script.Parent

local Shared = ReplicatedStorage:WaitForChild("Shared")
local UIIcons=require(Shared:WaitForChild("UIIcons"))
UIIcons.watch(gui)
local HUDLayout=require(Shared.HUDLayout)
local statValue=require(Shared.TextTranslator).stat
local MenuViews=require(Shared.MenuViews)
local MenuWidgets=require(Shared.MenuWidgets)
local function startOptional(name,...)
 local args={...};task.spawn(function()
  local ok,err=pcall(function()require(Shared:WaitForChild(name)).start(table.unpack(args))end)
  if not ok then warn('[Steal60 client/'..name..'] '..tostring(err))end
 end)
end
startOptional('HUDLayout',gui)
startOptional('MusicDirector',gui)
startOptional('LanguageController',gui)
startOptional('ClientPerformance')
startOptional('MarqueeController')
local DriveState=require(Shared:WaitForChild('DriveState'))
startOptional('DrivePresentation',ReplicatedStorage:WaitForChild('Remotes'):WaitForChild('DriveSnapshot'))
local HackMath = require(Shared:WaitForChild("HackMath"))
local HackModes = require(Shared:WaitForChild("HackModes"))
local Settings = require(Shared:WaitForChild("Config"):WaitForChild("Settings"))

local remotes = ReplicatedStorage:WaitForChild("Remotes")
local HackStart = remotes:WaitForChild("HackStart")
local HackResult = remotes:WaitForChild("HackResult")
local Notify = remotes:WaitForChild("Notify")

local function corner(parent, radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius or 8)
	c.Parent = parent
end

----------------------------------------------------------------------
-- Уведомления
----------------------------------------------------------------------
local toast = Instance.new("TextLabel")
toast.Name = "Toast"
toast.AnchorPoint = Vector2.new(0.5, 0)
toast.Position = UDim2.new(0.5, 0, 0, 110)
toast.Size = UDim2.fromOffset(480, 36)
toast.BackgroundColor3 = Color3.fromRGB(30, 30, 36)
toast.BackgroundTransparency = 0.15
toast.TextColor3 = Color3.new(1, 1, 1)
toast.Font = Enum.Font.GothamBold
toast.TextSize = 20
toast.TextWrapped = true
toast.Visible = false
toast.Parent = gui
corner(toast, 10)

local toastId = 0
local closeHack -- функция закрытия мини-игры (если открыта)
local function isDrivingNow()
    local car,seat=DriveState.current(player)
    return car and car:GetAttribute("Drivable") and true or false
end
local function refreshToastLayout(driving)
 local camera=workspace.CurrentCamera;local compact=camera and camera.ViewportSize.Y&lt;500
 toast.AnchorPoint=Vector2.new(.5,0);toast.Position=UDim2.new(.5,0,0,compact and 1 or 7)
 toast.Size=UDim2.new(.8,0,0,compact and 26 or 36);toast.TextSize=compact and 11 or 13;toast.ZIndex=150
end
local toastLimit=Instance.new('UISizeConstraint');toastLimit.MaxSize=Vector2.new(480,36);toastLimit.Parent=toast

refreshToastLayout(false)

Notify.OnClientEvent:Connect(function(text, kind)
    if kind=="hack_success"then return end
	if kind == "closehack" then
		if closeHack then
			closeHack()
		end
		return
	end
	if kind == "bad" then
		toast.BackgroundColor3 = Color3.fromRGB(150, 40, 40)
	elseif kind == "good" then
		toast.BackgroundColor3 = Color3.fromRGB(40, 130, 70)
	else
		toast.BackgroundColor3 = Color3.fromRGB(30, 30, 36)
	end
	if type(text)=='string'and text:find('Предпросмотр',1,true)and player:GetAttribute('CosmeticPreviewToken')then return end
	local driving = isDrivingNow()
	refreshToastLayout(driving)
	toast.Text = text
	toast.Visible = true
    player:SetAttribute("Steal60ToastActive",true)
	toastId += 1
	local id = toastId
	local toastSeconds = (type(text)=="string" and text:find("Доставлено!",1,true)) and 0.85 or (driving and 1.6 or 4.5)
	task.delay(toastSeconds, function()
		if id == toastId then
			toast.Visible = false
            player:SetAttribute("Steal60ToastActive",false)
		end
	end)
end)

----------------------------------------------------------------------
-- V6 EASY LOCKWORK: Three looks, one action, wide zones and automatic assistance
-- A tap carries NO client timestamps: server checks its own clock.
----------------------------------------------------------------------
local TweenService = game:GetService("TweenService")
local HackTap = remotes:WaitForChild("HackTap")
local HackStep = remotes:WaitForChild("HackStep")
local activeHackStep

local function runMinigame(params)
    if closeHack then closeHack() end
    local palettes={
        pins=Color3.fromRGB(73,232,165),
        dial=Color3.fromRGB(255,194,91),
        wires=Color3.fromRGB(96,205,245),
        signal=Color3.fromRGB(191,137,251),
        memory=Color3.fromRGB(255,171,218),
    }
    local names={pins="ЛИЧИНКА ЗАМКА",dial="ПОВЕРНИ ДИСК",wires="СОЕДИНИ ПРОВОД",signal="СИНХРОНИЗАЦИЯ СИГНАЛА",memory="ЗАПОМНИ КОД"}
    local descriptions={
        memory="Запомни мигающие кнопки и повтори их порядок.",
        pins="Останови белую линию внутри зелёной зоны.",
        dial="Попади стрелкой в подсвеченный сектор.",
        wires="Выбери провод нужного цвета — без таймера.",
        signal="Нажми, когда фиолетовый импульс совпадёт с кольцом.",
    }
    local colors={Color3.fromRGB(237,91,104),Color3.fromRGB(72,171,255),Color3.fromRGB(80,218,147)}
    local colorNames={"КРАСНЫЙ","СИНИЙ","ЗЕЛЁНЫЙ"}
    local current=params
    local theme=palettes[current.mode] or palettes.pins
    local finished=false
    local waiting=false
    local victoryShown=false
    local renderConn,inputConn

    local root=Instance.new("Frame")
    root.Name="HackVarietyV26"
    root.AnchorPoint=Vector2.new(.5,.5)
    root.Position=UDim2.fromScale(.5,.48)
    root.Size=UDim2.new(.93,0,0,350)
    root.BackgroundColor3=Color3.fromRGB(13,19,28)
    root.BackgroundTransparency=.035
    root.BorderSizePixel=0
    root.Parent=gui
    corner(root,15)
    local constraint=Instance.new("UISizeConstraint")
    constraint.MaxSize=Vector2.new(550,350)
    constraint.MinSize=Vector2.new(300,350)
    constraint.Parent=root
    local border=Instance.new("UIStroke")
    border.Color=theme
    border.Transparency=.24
    border.Thickness=2
    border.Parent=root

    local function label(text,y,size,color)
        local t=Instance.new("TextLabel")
        t.BackgroundTransparency=1
        t.Position=UDim2.fromOffset(21,y)
        t.Size=UDim2.new(1,-55,0,size+11)
        t.Text=text
        t.Font=Enum.Font.GothamBold
        t.TextSize=size
        t.TextColor3=color or Color3.fromRGB(239,245,252)
        t.TextXAlignment=Enum.TextXAlignment.Left
        t.TextTruncate=Enum.TextTruncate.AtEnd
        t.Parent=root
        return t
    end
    local eyebrow=label("УГОН 60 / ВЗЛОМ · КОРОТКИЕ ИСПЫТАНИЯ",8,11,theme)
    local title=label("",29,21)
    local hint=label("",62,13,Color3.fromRGB(190,205,221))
    local cancel=Instance.new("TextButton")
    cancel.Name="Cancel";cancel.Size=UDim2.fromOffset(34,32)
    cancel.Position=UDim2.new(1,-44,0,12)
    cancel.BackgroundColor3=Color3.fromRGB(76,45,52)
    cancel.Text="X";cancel.Font=Enum.Font.GothamBold;cancel.TextSize=17
    cancel.TextColor3=Color3.new(1,1,1)
    cancel.Parent=root;corner(cancel,7)

    local progress=Instance.new("Frame")
    progress.Position=UDim2.fromOffset(22,99)
    progress.Size=UDim2.new(1,-44,0,12)
    progress.BackgroundTransparency=1
    progress.Parent=root
    local progressLayout=Instance.new("UIListLayout")
    progressLayout.FillDirection=Enum.FillDirection.Horizontal
    progressLayout.Padding=UDim.new(0,6)
    progressLayout.Parent=progress
    local lamps={}
    for i=1,math.max(1,params.rounds or 1) do
        local cell=Instance.new("Frame")
        cell.Size=UDim2.new(1/(params.rounds or 1),-6,1,0)
        cell.BorderSizePixel=0
        cell.BackgroundColor3=Color3.fromRGB(52,66,79)
        cell.Parent=progress;corner(cell,3)
        lamps[i]=cell
    end

    local puzzle=Instance.new("Frame")
    puzzle.Name="PuzzleArea"
    puzzle.Position=UDim2.new(0,22,0,123)
    puzzle.Size=UDim2.new(1,-44,0,133)
    puzzle.BackgroundColor3=Color3.fromRGB(27,37,52)
    puzzle.BorderSizePixel=0
    puzzle.ClipsDescendants=true
    puzzle.Parent=root;corner(puzzle,9)

    -- A: sweeping lock bar.
    local lane=Instance.new("Frame")
    lane.Name="LineLock"
    lane.Position=UDim2.new(.07,0,.40,0)
    lane.Size=UDim2.new(.86,0,0,35)
    lane.BackgroundColor3=Color3.fromRGB(47,62,81)
    lane.Parent=puzzle;corner(lane,6)
    local zone=Instance.new("Frame")
    zone.Name="TargetZone"
    zone.BackgroundColor3=palettes.pins
    zone.BackgroundTransparency=.22
    zone.BorderSizePixel=0
    zone.Parent=lane;corner(zone,5)
    local marker=Instance.new("Frame")
    marker.Name="Cursor";marker.AnchorPoint=Vector2.new(.5,.5)
    marker.Size=UDim2.fromOffset(5,49)
    marker.BackgroundColor3=Color3.new(1,1,1)
    marker.BorderSizePixel=0
    marker.ZIndex=3;marker.Parent=lane;corner(marker,3)
    local lineLabel=Instance.new("TextLabel")
    lineLabel.BackgroundTransparency=1;lineLabel.Text="НАЖМИ F В ЗОНЕ"
    lineLabel.TextSize=11;lineLabel.Font=Enum.Font.GothamBold
    lineLabel.TextColor3=Color3.fromRGB(156,171,191)
    lineLabel.Position=UDim2.new(0,0,0,8)
    lineLabel.Size=UDim2.new(1,0,0,20);lineLabel.Parent=puzzle

    -- B: actual round dial with ring sectors instead of a second bar.
    local dialFrame=Instance.new("Frame")
    dialFrame.Name="CircularDial"
    dialFrame.BackgroundTransparency=1
    dialFrame.Size=UDim2.fromOffset(122,122)
    dialFrame.AnchorPoint=Vector2.new(.5,.5)
    dialFrame.Position=UDim2.fromScale(.5,.5)
    dialFrame.Parent=puzzle
    local dialBody=Instance.new("Frame")
    dialBody.Size=UDim2.fromOffset(100,100)
    dialBody.Position=UDim2.fromOffset(11,11)
    dialBody.BackgroundColor3=Color3.fromRGB(38,49,65)
    dialBody.Parent=dialFrame;corner(dialBody,55)
    local ds=Instance.new("UIStroke");ds.Color=palettes.dial;ds.Thickness=2;ds.Parent=dialBody
    local dialTicks={}
    for i=0,30 do
        local fraction=i/30
        local deg=math.rad(fraction*360-90)
        local tick=Instance.new("Frame")
        tick.Name="DialSector"..i
        tick.AnchorPoint=Vector2.new(.5,.5)
        tick.Position=UDim2.fromOffset(61+53*math.cos(deg),61+53*math.sin(deg))
        tick.Size=UDim2.fromOffset(3,10)
        tick.Rotation=fraction*360
        tick.BackgroundColor3=Color3.fromRGB(91,102,121)
        tick.BorderSizePixel=0
        tick.Parent=dialFrame
        dialTicks[i+1]=tick
    end
    local dialNeedlePivot=UIIcons.dial(dialFrame,palettes.dial)

    -- C: choose one of three colored physical wires, mouse/touch or 1/2/3.
    local wirePanel=Instance.new("Frame")
    wirePanel.Name="WirePicker"
    wirePanel.BackgroundTransparency=1
    wirePanel.Size=UDim2.fromScale(1,1)
    wirePanel.Parent=puzzle
    local wireTarget=Instance.new("TextLabel")
    wireTarget.Position=UDim2.new(0,4,0,5)
    wireTarget.Size=UDim2.new(1,-8,0,32)
    wireTarget.BackgroundTransparency=1
    wireTarget.Font=Enum.Font.GothamBold
    wireTarget.TextSize=17
    wireTarget.Parent=wirePanel
    local wireButtons={}
    for i=1,3 do
        local b=Instance.new("TextButton")
        b.Name="Wire"..i
        b.Position=UDim2.new((i-1)/3,8,0,50)
        b.Size=UDim2.new(1/3,-16,0,66)
        b.BackgroundColor3=colors[i]
        b.TextColor3=Color3.fromRGB(8,17,28)
        b.Text=tostring(i)
        b.Font=Enum.Font.GothamBold
        b.TextSize=30
        b.TextStrokeTransparency=1
        b.TextScaled=false
        b.AutoButtonColor=true
        b.Parent=wirePanel;corner(b,10)
        local bs=Instance.new("UIStroke")
        bs.Color=Color3.fromRGB(229,238,248);bs.Transparency=.65;bs.Thickness=1;bs.Parent=b
        wireButtons[i]=b
    end

    -- D: four large touch targets, a short reveal, then server-confirmed input.
    local memoryPanel=Instance.new("Frame");memoryPanel.Name="MemoryCode"
    memoryPanel.Size=UDim2.fromScale(1,1);memoryPanel.BackgroundTransparency=1;memoryPanel.Parent=puzzle
    local memoryButtons={}
    for i=1,4 do
        local b=Instance.new("TextButton");b.Name="MemoryKey"..i
        b.Position=UDim2.new((i-1)/4,7,0,30);b.Size=UDim2.new(.25,-14,0,78)
        b.BackgroundColor3=Color3.fromRGB(62,55,81);b.TextColor3=Color3.fromRGB(255,240,250)
        b.Text=tostring(i);b.Font=Enum.Font.GothamBold;b.TextSize=30;b.Parent=memoryPanel;corner(b,10)
        memoryButtons[i]=b
    end

    -- Legacy radio pulse. Player matches the expanding filled ring to the target ring.
    local pulsePanel=Instance.new("Frame")
    pulsePanel.Name="PulseSync"
    pulsePanel.Size=UDim2.fromScale(1,1)
    pulsePanel.BackgroundTransparency=1
    pulsePanel.Parent=puzzle
    local pulseTarget=Instance.new("Frame")
    pulseTarget.AnchorPoint=Vector2.new(.5,.5)
    pulseTarget.Position=UDim2.fromScale(.5,.5)
    pulseTarget.BackgroundTransparency=1
    pulseTarget.Parent=pulsePanel;corner(pulseTarget,99)
    local ps=Instance.new("UIStroke")
    ps.Color=palettes.signal;ps.Thickness=5;ps.Parent=pulseTarget
    local pulse=Instance.new("Frame")
    pulse.AnchorPoint=Vector2.new(.5,.5)
    pulse.Position=UDim2.fromScale(.5,.5)
    pulse.BackgroundTransparency=.73
    pulse.BackgroundColor3=palettes.signal
    pulse.Parent=pulsePanel;corner(pulse,99)
    local pulseStroke=Instance.new("UIStroke")
    pulseStroke.Color=Color3.fromRGB(247,236,255)
    pulseStroke.Thickness=2;pulseStroke.Parent=pulse
    local pulseDot=Instance.new("Frame")
    pulseDot.AnchorPoint=Vector2.new(.5,.5)
    pulseDot.Position=UDim2.fromScale(.5,.5)
    pulseDot.Size=UDim2.fromOffset(12,12)
    pulseDot.BackgroundColor3=Color3.fromRGB(239,228,255)
    pulseDot.Parent=pulsePanel;corner(pulseDot,8)

    local status=label("ПОДГОТОВКА...",259,13,Color3.fromRGB(208,223,234))
    local action=Instance.new("TextButton")
    action.Name="HackAction"
    action.Position=UDim2.new(0,22,0,289)
    action.Size=UDim2.new(1,-44,0,44)
    action.BackgroundColor3=theme
    action.TextColor3=Color3.fromRGB(14,21,31)
    action.Font=Enum.Font.GothamBold
    action.TextSize=15
    action.Parent=root;corner(action,9)

    local function close()
        if finished then return end
        finished=true
        if renderConn then renderConn:Disconnect() end
        if inputConn then inputConn:Disconnect() end
        if activeHackStep then activeHackStep:Disconnect() end
        activeHackStep=nil
        closeHack=nil
        root:Destroy()
    end
    closeHack=close

    local function redraw()
        theme=palettes[current.mode] or palettes.pins
        border.Color=theme;eyebrow.TextColor3=theme
        title.Text=names[current.mode] or names.pins
        hint.Text=descriptions[current.mode] or descriptions.pins
        local mode=current.mode or "pins"
        lane.Visible=(mode=="pins")
        lineLabel.Visible=(mode=="pins")
        dialFrame.Visible=(mode=="dial")
        wirePanel.Visible=(mode=="wires")
        pulsePanel.Visible=(mode=="signal")
        memoryPanel.Visible=(mode=="memory")
        action.Visible=(mode~="wires"and mode~="memory")
        action.Text="ПОПАСТЬ  ·  [F]"
        action.BackgroundColor3=theme
        for i,cell in ipairs(lamps) do
            cell.BackgroundColor3=i&lt;current.round and theme
                or (i==current.round and Color3.fromRGB(236,242,250) or Color3.fromRGB(58,71,83))
        end
        if mode=="wires" then
            local target=current.zone and current.zone.target or 1
            wireTarget.Text="ВЫБЕРИ: "..colorNames[target].."  (1 / 2 / 3)"
            wireTarget.TextColor3=Color3.fromRGB(246,249,254)
            wireTarget.TextStrokeTransparency=1
        elseif mode=="dial" then
            local z=current.zone
            for i,tick in ipairs(dialTicks) do
                local f=(i-1)/30
                local delta=math.abs(f-z.c)
                delta=math.min(delta,1-delta)
                tick.BackgroundColor3=delta&lt;=z.w*.5 and Color3.fromRGB(104,238,171) or Color3.fromRGB(91,102,121)
            end
        end
    end
    local function submit(actionName)
        if victoryShown then close();return end
        if finished or waiting or workspace:GetServerTimeNow() &lt; (current.startAt or 0) then return end
        if current.mode=="memory"then
            if workspace:GetServerTimeNow()&lt;(current.startAt or 0)+HackModes.memoryDuration(current.zone)then return end
            if not actionName or not actionName:match("^memory_[1234]$")then return end
            waiting=true;HackTap:FireServer(actionName);return
        end
        local isWire=current.mode=="wires"
        if isWire then
            if not actionName or not actionName:match("^wire_[123]$") then return end
        elseif actionName~="tap" then
            return
        end
        waiting=true
        status.Text="ПРОВЕРКА..."
        HackTap:FireServer(actionName)
    end
    local function cancelAction()
        if finished then return end
        HackTap:FireServer("cancel")
        close()
    end
    for i,b in ipairs(wireButtons) do
        b.Activated:Connect(function() submit("wire_"..i) end)
    end
    for i,b in ipairs(memoryButtons)do b.Activated:Connect(function()submit("memory_"..i)end)end
    action.Activated:Connect(function()
        if victoryShown then close() else submit("tap") end
    end)
    cancel.Activated:Connect(cancelAction)
    activeHackStep=HackStep.OnClientEvent:Connect(function(state)
        if finished or type(state)~="table" then return end
        if state.state=="success" then
            victoryShown=true
            waiting=false
            title.Text="ДОСТАВЬ АВТО В ГАРАЖ"
            title.Position=UDim2.fromOffset(16,17);title.Size=UDim2.new(1,-32,0,27);title.TextSize=17
            root.AnchorPoint=Vector2.new(.5,0);root.Position=UDim2.new(.5,0,0,112);root.Size=UDim2.new(.88,0,0,64)
            constraint.MinSize=Vector2.new(260,64);constraint.MaxSize=Vector2.new(390,64)
            hint.Visible=false;eyebrow.Visible=false;status.Visible=false
            puzzle.Visible=false;progress.Visible=false;cancel.Visible=false;action.Visible=false
            task.delay(1,close)
        elseif state.state=="memory_progress"then
            current.memoryIndex=state.memoryIndex;waiting=false
            status.Text=("КОД: %d / %d"):format((current.memoryIndex or 1)-1,#current.zone.sequence)
        elseif state.state=="alarm" then
            waiting=true
            status.Text="ТРЕВОГА: "..tostring(state.reason or "замок заблокирован")
            task.delay(1.5,close)
        elseif state.state=="cancelled" then
            close()
        elseif state.state=="next" or state.state=="retry" then
            current=state
            waiting=false
            redraw()
            if state.state=="retry" then
                status.TextColor3=Color3.fromRGB(255,162,121)
                status.Text=(current.helpLevel or 0)&gt;=3 and "ПОМОЩЬ ВКЛЮЧЕНА · ПОВТОРИ" or "ПОЧТИ! ПОВТОРИ, ОШИБКА НЕ СБРАСЫВАЕТ ПРОГРЕСС"
            else
                status.TextColor3=Color3.fromRGB(129,246,181)
                status.Text=("✓ УСПЕХ! СЛЕДУЮЩИЙ ЭТАП %d/%d"):format(current.round,current.rounds)
            end
        end
    end)
    inputConn=UserInputService.InputBegan:Connect(function(input,processed)
        if finished then return end
        if victoryShown then
            if input.KeyCode==Enum.KeyCode.F or input.KeyCode==Enum.KeyCode.Escape then close() end
            return
        end
        if processed then return end
        if current.mode=="memory"then
            local keys={Enum.KeyCode.One,Enum.KeyCode.Two,Enum.KeyCode.Three,Enum.KeyCode.Four}
            for i,key in ipairs(keys)do if input.KeyCode==key then submit("memory_"..i);break end end
        elseif current.mode=="wires" then
            local code=input.KeyCode
            if code==Enum.KeyCode.One then submit("wire_1")
            elseif code==Enum.KeyCode.Two then submit("wire_2")
            elseif code==Enum.KeyCode.Three then submit("wire_3") end
        elseif input.KeyCode==Enum.KeyCode.F then
            submit("tap")
        end
    end)
    renderConn=RunService.RenderStepped:Connect(function()
        if finished or victoryShown then return end
        local t=workspace:GetServerTimeNow()-(current.startAt or 0)
        if t&lt;0 then
            if not waiting then status.Text=string.format("ПОДГОТОВКА · %.1f сек",-t) end
            return
        end
        local mode=current.mode
        if mode=="memory"then
            local cue=HackModes.memoryCue(t,current.zone)
            local watching=t&lt;HackModes.memoryDuration(current.zone)
            local help=not watching and(current.helpLevel or 0)&gt;=3 and current.zone.sequence[current.memoryIndex or 1]
            for i,b in ipairs(memoryButtons)do
                b.BackgroundColor3=((watching and cue==i)or help==i)and palettes.memory or Color3.fromRGB(62,55,81)
                b.Active=not watching and not waiting
            end
            if not waiting then status.Text=watching and"ЗАПОМИНАЙ ПОРЯДОК..."or("ПОВТОРИ КОД: %d / %d"):format((current.memoryIndex or 1)-1,#current.zone.sequence)end
        elseif mode~="wires" then
            local pos=HackMath.markerPos(t,current.period,mode)
            local z=current.zone
            local center=HackMath.zonePos(t,current.period,mode,current.round,z.c,z.w)
            if mode=="pins" then
                marker.Position=UDim2.new(pos,0,.5,0)
                zone.Position=UDim2.new(center-z.w*.5,0,0,0)
                zone.Size=UDim2.new(z.w,0,1,0)
            elseif mode=="dial" then
                dialNeedlePivot.Rotation=pos*360
            elseif mode=="signal" then
                local maxD=119
                local movingD=17+pos*maxD
                local goalD=17+center*maxD
                pulse.Size=UDim2.fromOffset(movingD,movingD)
                pulseTarget.Size=UDim2.fromOffset(goalD,goalD)
            end
        end
        if mode~="memory"and not waiting and status.Text:find("ПОДГОТОВКА") then
            status.Text=(mode=="wires") and "НАЖМИ 1/2/3 ИЛИ ВЫБЕРИ МЫШКОЙ" or "ЛОВИ МОМЕНТ И НАЖМИ F"
        end
    end)
    redraw()
end

HackStart.OnClientEvent:Connect(runMinigame)

----------------------------------------------------------------------
-- V7: WASD / VehicleSeat / touch input -&gt; SERVER. All physics is server-owned.
----------------------------------------------------------------------
local DriveInput = remotes:WaitForChild("DriveInput")
local RecoverCar = remotes:WaitForChild("RecoverCar")
local lastCar, lastSent, driveIndicator = nil, 0, nil
local touchThrottle, touchSteer = 0, 0
local touchWidgets = {}
local heldInputs={}
UserInputService.InputEnded:Connect(function(input)local fn=heldInputs[input];if fn then heldInputs[input]=nil;fn()end end)
UserInputService.WindowFocusReleased:Connect(function()for input,fn in pairs(heldInputs)do heldInputs[input]=nil;fn()end end)
local driveUI = Instance.new("Frame")
driveUI.Name = "DriveTouchControls"
driveUI.AnchorPoint = Vector2.new(1, 1)
driveUI.Position = UDim2.new(1, -14, 1, -16)
driveUI.Size = UDim2.fromOffset(248, 150)
driveUI.BackgroundTransparency = 1
driveUI.Visible = false
driveUI.Parent = gui

local function driveTouchButton(name, symbol, pos, axis, value)
    local btn = Instance.new("TextButton")
    btn.Name = name
    btn.Position = pos
    btn.Size = UDim2.fromOffset(72, 65)
    btn.Text = symbol
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 24
    btn.TextColor3 = Color3.fromRGB(247, 250, 255)
    btn.BackgroundColor3 = Color3.fromRGB(28, 45, 60)
    btn.BackgroundTransparency = .14
    btn.Parent = driveUI
    corner(btn, 12)
    local function press()
        if axis == "throttle" then touchThrottle = value else touchSteer = value end
        btn.BackgroundColor3 = Color3.fromRGB(43, 124, 102)
    end
    local function release()
        if axis == "throttle" and touchThrottle == value then touchThrottle = 0 end
        if axis == "steer" and touchSteer == value then touchSteer = 0 end
        btn.BackgroundColor3 = Color3.fromRGB(28, 45, 60)
    end
    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then heldInputs[input]=release;press() end
    end)
    btn.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then heldInputs[input]=nil;release() end
    end)
    table.insert(touchWidgets, btn)
end

driveTouchButton("Left", "◀", UDim2.fromOffset(0, 74), "steer", -1)
driveTouchButton("Right", "▶", UDim2.fromOffset(80, 74), "steer", 1)
driveTouchButton("Reverse", "▼", UDim2.fromOffset(160, 74), "throttle", -1)
driveTouchButton("Go", "▲", UDim2.fromOffset(160, 0), "throttle", 1)
local recoverButton = Instance.new("TextButton")
recoverButton.Name = "RecoverVehicle"
recoverButton.Position = UDim2.fromOffset(0, 12)
recoverButton.Size = UDim2.fromOffset(150, 45)
recoverButton.Text = "↻  ВЫРОВНЯТЬ"
recoverButton.TextColor3 = Color3.fromRGB(240,248,255)
recoverButton.TextSize = 15
recoverButton.Font = Enum.Font.GothamBold
recoverButton.BackgroundColor3 = Color3.fromRGB(52,84,111)
recoverButton.Parent = driveUI
corner(recoverButton,10)
recoverButton.Activated:Connect(function()
    if lastCar and lastCar.Parent then RecoverCar:FireServer(lastCar) end
end)

local driveHint = Instance.new("TextLabel")
driveHint.Name = "DriveHint"
driveHint.AnchorPoint = Vector2.new(.5, 1)
driveHint.Position = UDim2.new(.5, 0, 1, -16)
driveHint.Size = UDim2.fromOffset(360, 34)
driveHint.Font = Enum.Font.GothamBold
driveHint.TextSize = 16
driveHint.Text = "W/S — газ  ·  A/D — руль  ·  R — выровнять"
driveHint.TextColor3 = Color3.fromRGB(245, 246, 251)
driveHint.BackgroundColor3 = Color3.fromRGB(18, 30, 42)
driveHint.BackgroundTransparency = .1
driveHint.Visible = false
driveHint.Parent = gui
corner(driveHint, 9)

local hiddenBillboardNames = {
    CarLabel = true,
    RoadLabel = true,
    EventLabel = true,
    RoadVIPLabel = true,
}
local worldLabelsVisible=true
local worldLabels=setmetatable({},{__mode='k'})
local function registerLabel(obj)
 if obj:IsA('BillboardGui')and hiddenBillboardNames[obj.Name]then worldLabels[obj]=true;obj.Enabled=worldLabelsVisible end
end
workspace.DescendantAdded:Connect(registerLabel)
task.spawn(function()
 for i,obj in ipairs(workspace:GetDescendants())do registerLabel(obj);if i%300==0 then task.wait()end end
end)
local function setWorldLabelsVisible(visible)
 if worldLabelsVisible==visible then return end;worldLabelsVisible=visible
 for label in pairs(worldLabels)do if label.Parent then label.Enabled=visible else worldLabels[label]=nil end end
end

UserInputService.InputBegan:Connect(function(input, processed)
    if not processed and input.KeyCode == Enum.KeyCode.R and lastCar and lastCar.Parent then
        RecoverCar:FireServer(lastCar)
    end
end)

local lastDrivingState = false
RunService.Heartbeat:Connect(function(dt)
    local car,seat=DriveState.current(player)
    if not car or not car:GetAttribute("Drivable") then
        if lastDrivingState then
            lastDrivingState = false
            setWorldLabelsVisible(true)
            refreshToastLayout(false)
        end
        lastCar = nil
        driveUI.Visible = false
        driveHint.Visible = false
        touchThrottle, touchSteer = 0, 0
        return
    end
    if not lastDrivingState then
        lastDrivingState = true
        setWorldLabelsVisible(true)
        refreshToastLayout(true)
    end
    if car ~= lastCar then
        lastCar = car
        lastSent = 0
    end
    local menuActive=player:GetAttribute('Steal60MenuOpen')==true or player:GetAttribute('HackActive')==true
    driveUI.Visible = UserInputService.TouchEnabled and not menuActive
    driveHint.Visible = not UserInputService.TouchEnabled and not menuActive
    if menuActive then touchThrottle,touchSteer=0,0 end
    local throttle,steer=DriveState.axes(seat.ThrottleFloat,seat.SteerFloat,touchThrottle,touchSteer)
    if not UserInputService.TouchEnabled then
        local keyThrottle = (UserInputService:IsKeyDown(Enum.KeyCode.W) or UserInputService:IsKeyDown(Enum.KeyCode.Up)) and 1 or
            ((UserInputService:IsKeyDown(Enum.KeyCode.S) or UserInputService:IsKeyDown(Enum.KeyCode.Down)) and -1 or 0)
        local keySteer = (UserInputService:IsKeyDown(Enum.KeyCode.A) or UserInputService:IsKeyDown(Enum.KeyCode.Left)) and -1 or
            ((UserInputService:IsKeyDown(Enum.KeyCode.D) or UserInputService:IsKeyDown(Enum.KeyCode.Right)) and 1 or 0)
        if keyThrottle ~= 0 then throttle = keyThrottle end
        if keySteer ~= 0 then steer = keySteer end
    end
    if menuActive then throttle,steer=0,0 end
    DriveState.setInput(car,throttle,steer)
    if os.clock() - lastSent &gt;= .08 then
        lastSent = os.clock()
        DriveInput:FireServer(car,throttle,steer,player:GetAttribute('Steal60DriveControllerReady')and 60 or 0,car:GetAttribute('DriveEpoch'))
    end
end)

----------------------------------------------------------------------
-- Меню: каталог, салон, шансы. И окно вскрытия машины.
----------------------------------------------------------------------
local Rarity = require(Shared:WaitForChild("Rarity"))
local Config = Shared:WaitForChild("Config")
local CarClasses = require(Config:WaitForChild("CarClasses"))
local LootCfg = require(Config:WaitForChild("Loot"))
local CarsCfg = require(Config:WaitForChild("Cars"))
local PinCar = remotes:WaitForChild("PinCar")
local GetMenuData = remotes:WaitForChild("GetMenuData")
local GetSeasonTop=remotes:WaitForChild("GetSeasonTop")
local LootReveal = remotes:WaitForChild("LootReveal")

local function rarityColor(r)
	local info = Rarity.Info[r]
	return info and info.color or Color3.new(1, 1, 1)
end

local function rarityName(r)
	local info = Rarity.Info[r]
	return info and info.name or "?"
end

local function fmt(n)
	local s = tostring(math.floor(n))
	local out = s:reverse():gsub("(%d%d%d)", "%1 "):reverse()
	return (out:gsub("^ ", ""))
end

-- Кнопка меню
local menuBtn = Instance.new("TextButton")
menuBtn.AnchorPoint = Vector2.new(0.5, 1)
menuBtn.Position = UDim2.new(0.5, 0, 1, -18)
menuBtn.Size = UDim2.fromOffset(132, 44)
menuBtn.BackgroundColor3 = Color3.fromRGB(60, 120, 220)
menuBtn.TextColor3 = Color3.new(1, 1, 1)
menuBtn.Font = Enum.Font.GothamBold
menuBtn.TextSize = 18
menuBtn.Text = "МЕНЮ"
menuBtn.Parent = gui
corner(menuBtn, 10)

local panel = Instance.new("Frame")
panel.Name="MainMenu"
panel.AnchorPoint = Vector2.new(0.5, 0.5)
panel.Position = UDim2.fromScale(0.5, 0.5)
