  for k,v in pairs(value)do
   if(type(k)~='string'and type(k)~='number')or not walk(k,depth+1)or not walk(v,depth+1)then return false end
  end;return true
 end
 if not walk(data,0)then return false end
 for _,key in ipairs({'money','till','diamonds','hackLevel','hackXP','theftCount','receiptDiamondTotal','incomingCoinApplied','incomingRaidApplied'})do
  if data[key]~=nil and(not finite(data[key])or data[key]&lt;0)then return false end
 end
 for _,key in ipairs({'upgrades','coinUpgrades','catalog','showcase','shelf','shelfStorage','processedReceipts','cosmeticsOwned','cosmeticsEquipped','carCosmetics'})do
  if data[key]~=nil and type(data[key])~='table'then return false end
 end
 return true
end
local function validRecord(record)
 if type(record)~='table'or not valid(record.data)then return false end
