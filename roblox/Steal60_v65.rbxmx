  return self.store:UpdateAsync(s.key,function(old)
   -- Observing our operation in a later atomic callback proves the earlier write committed.
   if old and validRecord(old)and old.lastCommit==operation then proof=copy(old);return old end
   if not old or not old.lock or old.lock.token~=s.token or(old.revision or 0)&lt;s.revision then rejected=true;return nil end
   if not validRecord(old)then rejected=true;return nil end
   local snapshot=copy(frozen);self:_merge(snapshot,old)
   if options.receipt and not snapshot.processedReceipts[options.receipt]then
    snapshot.diamonds=(snapshot.diamonds or 0)+grant;snapshot.receiptDiamondTotal=(snapshot.receiptDiamondTotal or 0)+grant
    snapshot.processedReceipts[options.receipt]=true
   end
   if not valid(snapshot)then return nil end
   old.lastCommit=operation;old.data=snapshot;old.revision=(old.revision or 0)+1;old.format=65
