 end
end

function M.create(def)
 local model=Instance.new("Model")
 model.Name="Питомец · "..tostring(def.name or def.id)
 local base=make(model,"Root",Vector3.new(.1,.1,.1),Vector3.new(),DARK)
 base.Transparency=1
 model.PrimaryPart=base
 local col=def.color or C(117,210,203)
 local id=def.id
 atelier(model,id,col)
 -- Purely visual, anchored parts. The client computes every pose; no physics joints.
 local minY=math.huge;local count=0;local groups=0
 for _,p in ipairs(model:GetDescendants())do
  if p:IsA("BasePart")then
   p.Anchored=true;p.Massless=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false
   if p~=base then
    p:SetAttribute("PetBindCFrame",base.CFrame:ToObjectSpace(p.CFrame))
    p:SetAttribute("PetBaseTransparency",p.Transparency)
    count+=1
    if p:GetAttribute("PetMotionPivot")then groups+=1 end
   end
   if p.Transparency&lt;1 then
    for _,sx in ipairs({-1,1})do for _,sy in ipairs({-1,1})do for _,sz in ipairs({-1,1})do
     minY=math.min(minY,(p.CFrame*Vector3.new(sx*p.Size.X/2,sy*p.Size.Y/2,sz*p.Size.Z/2)).Y)
    end end end
   end
  end
 end
 model:SetAttribute("PetGroundOffset",minY&lt;math.huge and -minY or .89)
 model:SetAttribute("PetVisualSchema",55)
 model:SetAttribute("PetKinematicPartCount",count)
 model:SetAttribute("PetAnimationGroupCount",groups)
 base.Anchored=true

 return model
end
return M
