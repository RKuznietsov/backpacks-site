          <Item class="ModuleScript" referent="RBX5">
            <Properties>
              <string name="Name">CarClasses</string>
              <ProtectedString name="Source">-- ModuleScript: ReplicatedStorage/Shared/Config/CarClasses
-- requiredHack  — минимальный уровень взлома, чтобы угнать без тревоги
-- ownerSpeed    — скорость владельца (формальность, у дорогих чуть быстрее)
-- lootRolls     — сколько предметов выпадает при вскрытии
-- rarityWeights — шансы редкости машины при появлении на парковке
return {
	junk = {
		name = "Хлам", order = 1, requiredHack = 1, ownerSpeed = 6, lootRolls = 2,
		baseValue = 50,
		rarityWeights = { common = 75, rare = 20, epic = 4, legendary = 1 },
	},
	regular = {
		name = "Обычные", order = 2, requiredHack = 5, ownerSpeed = 8, lootRolls = 3,
		baseValue = 300,
		rarityWeights = { common = 70, rare = 22, epic = 6, legendary = 2 },
	},
	sport = {
		name = "Спорт", order = 3, requiredHack = 10, ownerSpeed = 10, lootRolls = 3,
		baseValue = 2000,
		rarityWeights = { common = 65, rare = 24, epic = 8, legendary = 3 },
	},
	premium = {
		name = "Премиум", order = 4, requiredHack = 15, ownerSpeed = 12, lootRolls = 4,
		baseValue = 15000,
		rarityWeights = { common = 60, rare = 25, epic = 11, legendary = 4 },
	},
	super = {
		name = "Суперкары", order = 5, requiredHack = 20, ownerSpeed = 14, lootRolls = 5,
		baseValue = 100000,
		rarityWeights = { common = 55, rare = 25, epic = 14, legendary = 6 },
	},
}
