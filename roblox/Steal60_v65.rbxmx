 snapshot.incomingRaidApplied=math.max(raids,snapshot.incomingRaidApplied or 0)
end
function M:load(player,imported)
 local key='Player_'..player.UserId;local token=Http:GenerateGUID(false)
 local state={key=key,token=token,lastSuccess=os.clock(),revision=0,status='loading'};self.states[player]=state
