        <Item class="ModuleScript" referent="RBX_STEAL60_V53_WardrobeService"><Properties><string name="Name">WardrobeService</string><ProtectedString name="Source">-- Real Roblox HumanoidDescriptions, with serialized application and exact avatar restoration.
local RS=game:GetService('ReplicatedStorage')
local Config=require(RS.Shared.Config.CosmeticConfig)
local Owner=require(script.Parent.OwnerService)
local Styles=require(RS.Shared.AvatarStyleLibrary)
local Outfit=require(RS.Shared.AvatarOutfit)
local AvatarPreview=require(RS.Shared.AvatarPreview)
local Net=require(script.Parent.Net)
local M={};local templates={};local states={};local started=false
local previous=RS:FindFirstChild('Steal60CatalogPreviews');if previous then previous:Destroy()end
local previews=Instance.new('Folder');previews.Name='Steal60CatalogPreviews';previews.Parent=RS
local function cleanupLegacy(char)
 for _,name in ipairs({'Steal60HeroSkin','Steal60VendorSignature'})do local old=char:FindFirstChild(name);if old then old:Destroy()end end
 for _,obj in ipairs(char:GetDescendants())do
  if obj:IsA('BasePart')or obj:IsA('Decal')or obj:IsA('Texture')then
   for _,key in ipairs({'Steal60BodyTransparency','Steal60FaceTransparency','Steal60SavedTransparency'})do
    local before=obj:GetAttribute(key)
    if before~=nil then obj.Transparency=before;obj:SetAttribute(key,nil)end
   end
  end
 end
end
function M.init()
 if started then return end;started=true
 local remaining=#Config.CatalogOrder
 for _,key in ipairs(Config.CatalogOrder)do
  task.spawn(function()
   local preset=Config.CatalogLooks[key]
   local ok,rig
   for attempt=1,3 do
    ok,rig=pcall(Owner.catalogRig,preset)
    if ok and rig and rig:GetAttribute('MarketplaceLook')and rig:GetAttribute('FullOutfit')then break end
    if ok and rig then rig:Destroy();rig=nil end
    if attempt&lt;3 then task.wait(attempt*.75)end
   end
   if ok and rig and rig:GetAttribute('MarketplaceLook')==true and rig:GetAttribute('FullOutfit')==true then
    local hum=rig:FindFirstChildOfClass('Humanoid')
    local loaded,desc=pcall(function()return hum:GetAppliedDescription()end)
    if loaded and desc then
     templates[key]={description=desc,role=preset.role}
     rig.Name=key;AvatarPreview.prepare(rig);rig:PivotTo(CFrame.new())
     for _,obj in ipairs(rig:GetDescendants())do
      if obj:IsA('BasePart')then obj.Anchored=true;obj.CanCollide=false;obj.CanTouch=false;obj.CanQuery=false
      elseif obj:IsA('BaseScript')then obj:Destroy()end
     end
     rig:SetAttribute('CatalogReady',true);rig.Parent=previews
     previews:SetAttribute(key,true);previews:SetAttribute('Revision',(previews:GetAttribute('Revision')or 0)+1)
    else rig:Destroy()end
   elseif ok and rig then rig:Destroy()end
   if not templates[key]then
    previews:SetAttribute(key..'_Unavailable',true);previews:SetAttribute('Revision',(previews:GetAttribute('Revision')or 0)+1)
    warn('[Steal60 Wardrobe] Catalog outfit unavailable: '..key)
   end
   remaining-=1
   if remaining==0 then previews:SetAttribute('LoadFinished',true)end
  end)
 end
end
function M.isReady(def)return def and templates[def.catalogLook]~=nil end
local function run(player,state)
 while player.Parent and not state.dead do
  local revision=state.revision;local look=state.look;local tag=state.tag
  local char=player.Character;local hum=char and char:FindFirstChildOfClass('Humanoid')
  if not char or not hum then break end
  if state.character~=char then
   if state.original then state.original:Destroy()end
   state.character=char;state.original=nil;state.changed=false
  end
  if not look and not state.changed then
   cleanupLegacy(char)
   if state.hadSelection then Net.notify(player,'Твой Roblox-аватар восстановлен. Купленные образы сохранены.','good');state.hadSelection=false end
   break
  end
  local deadline=os.clock()+20
  while player.Parent and player.Character==char and revision==state.revision and not player:HasAppearanceLoaded()and os.clock()&lt;deadline do task.wait(.1)end
  if player.Character~=char or revision~=state.revision then continue end
  if not player:HasAppearanceLoaded()then
   Net.notify(player,'Внешность Roblox ещё загружается. Попробуй надеть образ чуть позже.','info');break
  end
  if not state.original then
   cleanupLegacy(char)
   local ok,description=pcall(function()return hum:GetAppliedDescription()end)
   if not ok then break end
   state.original=description
  end
  while look and not templates[look]and not previews:GetAttribute('LoadFinished')and revision==state.revision and player.Parent and os.clock()&lt;deadline do task.wait(.1)end
  if revision~=state.revision or player.Character~=char then continue end
  local entry=look and templates[look]
  if look and not entry then
   Net.notify(player,'Этот каталожный образ сейчас не загрузился. Твой аватар сохранён.','info');break
  end
  cleanupLegacy(char)
  local description=entry and Outfit.compose(state.original,entry.description)or state.original:Clone()
  local ok,err=pcall(function()hum:ApplyDescriptionResetAsync(description)end);description:Destroy()
  if not ok then
   warn('[Steal60 Wardrobe] ApplyDescription failed: '..tostring(err))
   -- Restore immediately, even when the failed API call partially modified the rig.
   if state.original then
    local original=state.original:Clone();pcall(function()hum:ApplyDescriptionResetAsync(original)end);original:Destroy()
   end
   state.changed=false
   Net.notify(player,'Roblox не применил образ. Возвращён твой аватар.','info')
  else state.changed=look~=nil end
  if player.Character==char and revision==state.revision then
   if ok and entry and entry.role then pcall(Styles.applyVendorSignature,char,entry.role)end
   char:SetAttribute('Steal60CatalogLook',ok and look or nil)
   if ok and not look then Net.notify(player,'Твой Roblox-аватар восстановлен. Купленные образы сохранены.','good');state.hadSelection=false end
   if M.onApplied then pcall(M.onApplied,player,ok,tag)end
  end
  if revision==state.revision then break end
 end
 state.running=false
end
function M.request(player,def,tag)
 M.init()
 local state=states[player]
 local look=def and def.catalogLook or nil
 if state and state.character==player.Character and state.look==look and state.tag==tag and(state.running or state.changed==(look~=nil))then return end
 if not state then state={revision=0};states[player]=state end
 state.look=look;state.tag=tag;if look then state.hadSelection=true end;state.revision+=1
 if not state.running then
  state.running=true
  task.spawn(function()
   local ok,err=pcall(run,player,state);state.running=false
   if not ok then
    warn('[Steal60 Wardrobe] Worker failed: '..tostring(err))
    if player.Parent then Net.notify(player,'Roblox не завершил смену внешности. Попробуй ещё раз.','info')end
   end
  end)
 end
end
function M.remove(player)
 local state=states[player]
 if state then state.dead=true;state.revision+=1;if state.original then state.original:Destroy();state.original=nil end end
 states[player]=nil
end
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_STEAL60_V55_TutorialService"><Properties><string name="Name">TutorialService</string><ProtectedString name="Source">-- Server-owned onboarding. Clients can acknowledge explanations, never gameplay steps.
local Players=game:GetService('Players')
local RS=game:GetService('ReplicatedStorage')
local Workspace=game:GetService('Workspace')
local Data=require(script.Parent.DataService)
local Net=require(script.Parent.Net)
local Config=require(RS.Shared.TutorialConfig)
local Progress=require(RS.Shared.TutorialProgress)
local Loot=require(RS.Shared.Config.Loot)
local M={};local sessions={};local started=false
local function session(player)
 local s=sessions[player];if not s then s={index=0,openedAt=0,lastAction=-10};sessions[player]=s end;return s
end
local function saveSoon(player,s)
 s.dirty=true;if s.saving then return end;s.saving=true
 task.spawn(function()
  while s.dirty and player.Parent do
   s.dirty=false;task.wait(.5)
   if Data.canSave(player)then Data.saveNow(player)end
  end
  s.saving=false
 end)
end
local function target(player,step,s)
 if not step then return nil end
 local ctx=s.context or{};local kind=step.target
 if kind=='starter'then
  local root=player.Character and player.Character:FindFirstChild('HumanoidRootPart')
  local origin=root and root.Position or Vector3.zero
  local best,score=nil,math.huge;local districts=Workspace:FindFirstChild('Districts');local data=Data.get(player)
  local item=Loot.ById[Progress.ensure(data).itemId]
  local wantedZone=step.id=='copies'and item and item.zone or nil
  local picked
  if districts then for _,district in ipairs(districts:GetChildren())do
   local cars=district:FindFirstChild('Cars')
   if cars then for _,car in ipairs(cars:GetChildren())do
    if car:IsA('Model')and car:GetAttribute('State')=='available'and(car:GetAttribute('RequiredHack')or 1)&lt;=(data.hackLevel or 1)then
     local position=car:GetPivot().Position;local cost=(position-origin).Magnitude+(car:GetAttribute('TutorialStarter')and 0 or 250)
     if cost&lt;score then best=position;picked=car;score=cost end
    end
   end end
  end end
  -- Keep the busy target while its own lock is open.
  if step.id=='lock'and s.targetCar and s.targetCar.Parent and s.targetCar:GetAttribute('LockedBy')==player.UserId then
   picked=s.targetCar;best=picked:GetPivot().Position
  end
  s.targetCar=picked
  return best or(wantedZone and ctx.zones and ctx.zones[wantedZone])or ctx.starter
 elseif kind=='showcase'and ctx.getShowcaseCar then
  local car=ctx.getShowcaseCar();s.targetCar=car;if car then return car:GetPivot().Position end
 elseif(kind=='shelf'or kind=='till')and ctx.entry then
  local root=player.Character and player.Character:FindFirstChild('HumanoidRootPart')
  if root and math.abs(root.Position.Z)&lt;55 then return ctx.entry end
  return ctx[kind]
 elseif kind=='thief'then
  local thieves=Workspace:FindFirstChild('Thieves')
  if thieves then for _,rig in ipairs(thieves:GetChildren())do if rig:GetAttribute('SalonOwnerId')==player.UserId and rig.PrimaryPart then return rig.PrimaryPart.Position end end end
  return ctx.till
 end
 return ctx[kind]
end
function M.sync(player,force)
 local data=Data.get(player);if not data or not player.Parent then return end
 local s=session(player);local p=Progress.ensure(data)
 if not p.done.loot and not Progress.owns(data,p.itemId)then
  for _,list in ipairs({data.shelf or{},data.shelfStorage or{}})do
   for _,it in ipairs(list)do if Loot.ById[it.id]then p.itemId=it.id;break end end
   if Progress.owns(data,p.itemId)then break end
  end
 end

 local index=Progress.advance(data,Config.Steps);local step=Config.Steps[index]
 local changed=index~=s.index
 if changed then
  if s.index&gt;0 and s.index&lt;=#Config.Steps and index&gt;#Config.Steps then Net.notify(player,'Готово! Основы освоены. Всё остальное — в РУКОВОДСТВЕ.','good')end
  s.index=index;s.openedAt=os.clock();saveSoon(player,s)
 end
 local legacy=step and({start=1,lock=2,delivery=3,loot=4,ride=4,income=5})[step.id]or 6
 data.tutorialStage=legacy
 player:SetAttribute('TutorialStage',legacy)
 player:SetAttribute('TutorialStep',step and step.id or nil)
 player:SetAttribute('TutorialStepIndex',index)
 player:SetAttribute('TutorialComplete',step==nil)
 player:SetAttribute('TutorialDefenceLearned',p.done.defend==true)
 local position=target(player,step,s)
 player:SetAttribute('TutorialTargetPosition',position)
 local ref=player:FindFirstChild('TutorialTarget')or Instance.new('ObjectValue');ref.Name='TutorialTarget';ref.Parent=player
 ref.Value=step and((step.target=='starter'or step.target=='showcase')and s.targetCar or nil)or nil
 player:SetAttribute('TutorialItemId',p.itemId)
 local item=Loot.ById[p.itemId]
 local canRead=step and step.lesson==true
 local awaitingShowcase=step and step.id=='ride'and s.context and s.context.getShowcaseCar and s.context.getShowcaseCar()==nil
 local awaitingLoot=step and step.id=='loot'and not Progress.owns(data,p.itemId)
 if awaitingLoot then canRead=false;player:SetAttribute('TutorialTargetPosition',target(player,Config.ById.start,s))end
 if canRead and({cosmetics='cosmetics',pets='cosmetics',diamonds='diamonds',parts='coins'})[step.id]then
  canRead=p.signals['open_'..({cosmetics='cosmetics',pets='cosmetics',diamonds='diamonds',parts='coins'})[step.id]]==true
 end
 if changed or force then
  Net.TutorialUpdate:FireClient(player,{index=index,total=#Config.Steps,id=step and step.id,canRead=canRead,
   awaitingLoot=awaitingLoot,awaitingShowcase=awaitingShowcase,itemId=p.itemId,itemZone=item and item.zone or 1,itemName=item and item.name or'учебный предмет',copies=tonumber((data.lootCopies or{})[p.itemId])or 0,
   stars=tonumber((data.lootRanks or{})[p.itemId])or 0,done=table.clone(p.done)})
 end
end
function M.bind(player,context)session(player).context=context;M.sync(player,true)end
function M.event(player,event,id)
 local data=Data.get(player);if not data then return end
 Progress.record(data,event,id);M.sync(player,true)
end
function M.vendor(player,kind)
 local data=Data.get(player);if not data then return end
 local p=Progress.ensure(data);p.signals['open_'..kind]=true
 M.sync(player,true)
end
function M.lootOverride(player,zone)
 local data=Data.get(player);if not data then return nil end
 local id=Progress.forcedLoot(data);local def=id and Loot.ById[id]
 if def and def.zone==zone then return def end
 return nil
end
function M.usedLootOverride(player)
 local data=Data.get(player);if data then local p=Progress.ensure(data);p.forcedDrops+=1 end
end
function M.isFirstHeist(player)
 local data=Data.get(player);if not data then return false end
 return not Progress.ensure(data).done.delivery
end
function M.init()
 if started then return end;started=true
 Net.TutorialAction.OnServerEvent:Connect(function(player,action,id)
  local s=session(player)
  if typeof(action)~='string'or os.clock()-s.lastAction&lt;.2 then return end;s.lastAction=os.clock()
  if action=='request'then M.sync(player,true);return end
  if action=='restart'then
   local data=Data.get(player);if not data then return end
   Progress.restart(data);M.sync(player,true);return
  end
  if action~='read'or typeof(id)~='string'or #id&gt;32 then return end
  local data=Data.get(player);if not data then return end
  local index=Progress.advance(data,Config.Steps);local step=Config.Steps[index]
  if not step or step.id~=id or not step.lesson then return end
  local needed=({cosmetics='cosmetics',pets='cosmetics',diamonds='diamonds',parts='coins'})[id]
  if needed and not Progress.ensure(data).signals['open_'..needed]then return end
  if Progress.lesson(data,step)then M.sync(player,true)end
 end)
 local function onPlayer(player)
  Data.onLoaded(player,function(data)Progress.rejoin(data);M.sync(player,true)end)
  local function onCharacter(char)
   -- Carrying a car cannot survive respawn; always recover even if death occurred before the first listener.
   M.event(player,'heist_failed')
   local hum=char:WaitForChild('Humanoid',8)
   if hum then hum.Died:Connect(function()M.event(player,'heist_failed')end)end
  end
  player.CharacterAdded:Connect(onCharacter)
  if player.Character then task.spawn(onCharacter,player.Character)end
 end
 Players.PlayerAdded:Connect(onPlayer)
 for _,player in ipairs(Players:GetPlayers())do onPlayer(player)end
 Players.PlayerRemoving:Connect(function(player)sessions[player]=nil end)
 task.spawn(function()
  while true do task.wait(2)
   for player in pairs(sessions)do if player.Parent then M.sync(player,true)end end
  end
 end)
end
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_STEAL60_V55_NPCNavigator"><Properties><string name="Name">NPCNavigator</string><ProtectedString name="Source">-- Physical humanoid navigation. Failed paths stop/replan; they never fall back to teleporting.
local Pathfinding=game:GetService('PathfindingService')
local Workspace=game:GetService('Workspace')
local M={};M.__index=M
function M.new(rig,options)
 local self=setmetatable({rig=rig,hum=rig:FindFirstChildOfClass('Humanoid'),root=rig:FindFirstChild('HumanoidRootPart'),tracks={},radius=options and options.radius or 1.65},M)
 self.ray=RaycastParams.new();self.ray.FilterType=Enum.RaycastFilterType.Exclude;self.ray.FilterDescendantsInstances={rig};self.ray.RespectCanCollide=true;self.ray.CollisionGroup=self.root.CollisionGroup
 self.hum.AutoRotate=true
 for _,p in ipairs(rig:GetDescendants())do if p:IsA('BasePart')then p.Anchored=false end end
 self.root.CanCollide=false;pcall(function()self.root:SetNetworkOwner(nil)end)
 local animator=self.hum:FindFirstChildOfClass('Animator')or Instance.new('Animator');animator.Parent=self.hum
 for name,id in pairs({idle=507766666,walk=507777826,run=507767714})do
  local animation=Instance.new('Animation');animation.AnimationId='rbxassetid://'..id
  local ok,track=pcall(function()return animator:LoadAnimation(animation)end);animation:Destroy()
  if ok then track.Looped=true;track.Priority=name=='idle'and Enum.AnimationPriority.Idle or Enum.AnimationPriority.Movement;self.tracks[name]=track end
 end
 self:setMotion('idle');return self
end
function M:alive()return self.rig.Parent~=nil and self.root.Parent~=nil and self.hum.Health&gt;0 end
function M:setMotion(name)
 if self.action and name~='idle'then self.action:Stop(.15);self.action:Destroy();self.action=nil end
 if self.motion==name then return end;self.motion=name
 for key,track in pairs(self.tracks)do if key==name then track:Play(.18)else track:Stop(.18)end end
end
function M:gesture()
 local animator=self.hum:FindFirstChildOfClass('Animator');if not animator then return end
 local animation=Instance.new('Animation');animation.AnimationId='rbxassetid://507770453'
 local ok,track=pcall(function()return animator:LoadAnimation(animation)end);animation:Destroy()
 if ok then
  if self.action then self.action:Destroy()end;self.action=track;track.Priority=Enum.AnimationPriority.Action;track:Play(.15)
 end
end
function M:stop()
 if self:alive()then self.hum:MoveTo(self.root.Position)end;self:setMotion('idle')
end
function M:blocked(goal)
 local delta=Vector3.new(goal.X-self.root.Position.X,0,goal.Z-self.root.Position.Z)
 if delta.Magnitude&lt;.15 then return false end
 local length=math.min(delta.Magnitude,1.6)
 local hit=Workspace:Blockcast(CFrame.new(self.root.Position),Vector3.new(2.3,3.6,2.3),delta.Unit*length,self.ray)
 return hit~=nil
end
function M:go(goal,cancel,seconds)
 local deadline=os.clock()+(seconds or 18)
 for attempt=1,3 do
  if not self:alive()or(cancel and cancel())or os.clock()&gt;=deadline then self:stop();return false end
  local path=Pathfinding:CreatePath({AgentRadius=self.radius,AgentHeight=5.5,AgentCanJump=false,AgentCanClimb=false,WaypointSpacing=4})
  local ok=pcall(function()path:ComputeAsync(self.root.Position,goal)end)
  if not ok or path.Status~=Enum.PathStatus.Success then path:Destroy();self:stop();return false end
  local waypoints=path:GetWaypoints();local retry=false
  for _,wp in ipairs(waypoints)do
   if not self:alive()or(cancel and cancel())then path:Destroy();self:stop();return false end
   local flat=Vector3.new(wp.Position.X-self.root.Position.X,0,wp.Position.Z-self.root.Position.Z)
   if flat.Magnitude&gt;1.5 then
    self:setMotion(self.hum.WalkSpeed&gt;17 and'run'or'walk');self.hum:MoveTo(wp.Position)
    local best=flat.Magnitude;local lastProgress=os.clock();local lastCommand=os.clock()
    while self:alive()do
     if(cancel and cancel())or os.clock()&gt;=deadline then path:Destroy();self:stop();return false end
     flat=Vector3.new(wp.Position.X-self.root.Position.X,0,wp.Position.Z-self.root.Position.Z)
     if flat.Magnitude&lt;=1.6 then break end
     if flat.Magnitude&lt;best-.15 then best=flat.Magnitude;lastProgress=os.clock()end
     if self:blocked(wp.Position)or os.clock()-lastProgress&gt;1.5 then retry=true;break end
     if os.clock()-lastCommand&gt;.7 then self.hum:MoveTo(wp.Position);lastCommand=os.clock()end
     task.wait(.08)
    end
   end
   if retry or not self:alive()then break end
  end
  path:Destroy()
  local distance=Vector3.new(goal.X-self.root.Position.X,0,goal.Z-self.root.Position.Z).Magnitude
  if self:alive()and not retry and distance&lt;=2.8 then self:stop();return true end
  self:stop();task.wait(.15)
 end
 return false
end
function M:lookAt(position,cancel,duration)
 self:stop();local begin=os.clock();local from=self.root.CFrame
 local destination=CFrame.lookAt(self.root.Position,Vector3.new(position.X,self.root.Position.Y,position.Z))
 while self:alive()and os.clock()-begin&lt;(duration or .35)do
  if cancel and cancel()then return false end
  local alpha=math.clamp((os.clock()-begin)/(duration or .35),0,1);alpha=alpha*alpha*(3-2*alpha)
  self.root.CFrame=from:Lerp(destination,alpha);task.wait(.04)
 end
 return self:alive()
end
function M:destroy()
 if self.action then self.action:Stop();self.action:Destroy();self.action=nil end
 for _,track in pairs(self.tracks)do track:Stop();track:Destroy()end
end
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_STEAL60_V56_CosmeticPreview"><Properties><string name="Name">CosmeticPreview</string><ProtectedString name="Source">-- Ephemeral visual selection. No inventory/profile references are stored or modified.
local M={};M.__index=M
function M.new(clock,delay,changed)
 return setmetatable({clock=clock,delay=delay,changed=changed,states={},serial=0},M)
end
function M:get(player)return self.states[player]end
function M:cancel(player,reason)
 local state=self.states[player];if not state then return end
 self.states[player]=nil;self.changed(player,'ended',state,reason or'cancelled')
end
function M:begin(player,selection)
 self:cancel(player,'replaced');self.serial+=1
 local state={token=self.serial,category=selection.category,id=selection.id,carId=selection.carId,name=selection.name,pending=true}
 self.states[player]=state;self.changed(player,'pending',state)
 self.delay(30,function()if self.states[player]==state and state.pending then self:cancel(player,'load_timeout')end end)
 return state
end
function M:activate(player,token)
 local state=self.states[player]
 if not state or state.token~=token or not state.pending then return false end
 state.pending=false;state.untilAt=self.clock()+20
 self.changed(player,'active',state)
 self.delay(20,function()if self.states[player]==state then self:cancel(player,'expired')end end)
 return true
end
function M:remove(player)self.states[player]=nil end
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_STEAL60_V57_CatalogOutfits"><Properties><string name="Name">CatalogOutfits</string><ProtectedString name="Source">-- Resolve complete classic shirt+pants pairs. Cache contains asset IDs, never player inventory.
local AvatarEditor=game:GetService('AvatarEditorService')
local DataStores=game:GetService('DataStoreService')
local M={};local cache={};local loading={};local usedShirts={};local usedPants={}
local store;pcall(function()store=DataStores:GetDataStore('Steal60_CatalogOutfit_v57')end)
local function valid(pair)return type(pair)=='table'and type(pair.shirt)=='number'and pair.shirt&gt;0 and type(pair.pants)=='number'and pair.pants&gt;0 end
local function free(pair,key)return(not usedShirts[pair.shirt]or usedShirts[pair.shirt]==key)and(not usedPants[pair.pants]or usedPants[pair.pants]==key)end
local function claim(pair,key)
 if not valid(pair)or not free(pair,key)then return nil end
 usedShirts[pair.shirt]=key;usedPants[pair.pants]=key;cache[key]=pair;return pair
end
local function words(name)
 local out={};for token in string.lower(tostring(name)):gmatch('[a-z0-9]+')do
  if not({shirt=true,pants=true,matching=true,outfit=true,uniform=true,with=true,["for"]=true})[token]then out[token]=true end
 end;return out
end
local function overlap(a,b)local score=0;for w in pairs(a)do if b[w]then score+=1 end end;return score end
local function typeName(value)
 if type(value)=='string'then return value end
 if value==11 then return'Shirt'elseif value==12 then return'Pants'end
 return tostring(value):match('([^%.]+)$')
end
local function search(query)
 local params=CatalogSearchParams.new();params.SearchKeyword=query
 params.AssetTypes={Enum.AvatarAssetType.Shirt,Enum.AvatarAssetType.Pants};params.IncludeOffSale=false
 params.SortType=Enum.CatalogSortType.Relevance;params.Limit=120
 local pages=AvatarEditor:SearchCatalogAsync(params);local shirts,pants={},{}
 for page=1,2 do
  for _,item in ipairs(pages:GetCurrentPage())do
   local kind=typeName(item.AssetType);local id=tonumber(item.Id)
   if item.ItemType=='Asset'and id and id&gt;0 and(kind=='Shirt'or kind=='Pants')then
    local record={id=id,name=item.Name or'',creator=item.CreatorTargetId,words=words(item.Name)}
    table.insert(kind=='Shirt'and shirts or pants,record)
   end
  end
  if #shirts&gt;0 and #pants&gt;0 or pages.IsFinished then break end
  pages:AdvanceToNextPageAsync()
 end
 return shirts,pants
end
local function pin(key,pair)
 if not store then return pair end
 local ok,all=pcall(function()
  return store:UpdateAsync('outfit:'..key,function(previous)
   if valid(previous)and free(previous,key)then return previous end
   return pair
  end)
 end)
 if not ok then return pair end -- Studio without DataStore access still has a session cache.
 return valid(all)and all or nil
end
function M.resolve(profile)
 local key=profile.id;local query=profile.outfitQuery
 if not key or not query then return nil end
 if cache[key]then return cache[key]end
 if loading[key]then
  local deadline=os.clock()+25
  while loading[key]and os.clock()&lt;deadline do task.wait(.1)end
  return cache[key]
 end
 loading[key]=true
 local ok,result=pcall(function()
  if store then
   local loaded,saved=pcall(function()return store:GetAsync('outfit:'..key)end)
   if not loaded then saved=nil end
   if valid(saved)and free(saved,key)then return saved end
  end
  for _,term in ipairs({query,profile.outfitFallbackQuery or query})do
   local shirts,pants=search(term);local candidates={};local requested=words(term)
   for _,shirt in ipairs(shirts)do for _,trousers in ipairs(pants)do
    local pair={shirt=shirt.id,pants=trousers.id,shirtName=shirt.name,pantsName=trousers.name,query=term}
    if free(pair,key)then
     local sameCreator=shirt.creator and shirt.creator~=0 and shirt.creator==trousers.creator
     candidates[#candidates+1]={pair=pair,score=overlap(shirt.words,trousers.words)*8+overlap(shirt.words,requested)*4+overlap(trousers.words,requested)*4+(sameCreator and 6 or 0)}
    end
   end end
   table.sort(candidates,function(a,b)
    if a.score~=b.score then return a.score&gt;b.score end
    if a.pair.shirt~=b.pair.shirt then return a.pair.shirt&lt;b.pair.shirt end
    return a.pair.pants&lt;b.pair.pants
   end)
   for i=1,math.min(8,#candidates)do local pinned=pin(key,candidates[i].pair);if pinned and free(pinned,key)then return pinned end end
  end
  return nil
 end)
 loading[key]=nil
 if not ok then warn('[Steal60 outfit] '..tostring(key)..': '..tostring(result));return nil end
 return result and claim(result,key)or nil
end
function M.apply(desc,pair)
 assert(valid(pair),'Complete shirt and pants required')
 desc.Shirt=pair.shirt;desc.Pants=pair.pants
end
function M.isComplete(rig)
 local shirt=rig:FindFirstChildOfClass('Shirt');local pants=rig:FindFirstChildOfClass('Pants')
 return shirt~=nil and pants~=nil and type(shirt.ShirtTemplate)=='string'and shirt.ShirtTemplate~=''and type(pants.PantsTemplate)=='string'and pants.PantsTemplate~=''
end
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_STEAL60_V57_NPCBody"><Properties><string name="Name">NPCBody</string><ProtectedString name="Source">-- Rounded native Robloxian body for NPCs only. Player body assets are never copied from it.
local Assets=game:GetService('AssetService')
local M={};local body;local loading=false
local fields={'Torso','LeftArm','RightArm','LeftLeg','RightLeg'}
local fallback={Torso=86500008,LeftArm=86500036,RightArm=86500054,LeftLeg=86500064,RightLeg=86500078}
local function load()
 if body then return body end
 if loading then
  local deadline=os.clock()+8;while loading and os.clock()&lt;deadline do task.wait(.1)end
  return body or fallback
 end
 loading=true
 local ok,details=pcall(function()return Assets:GetBundleDetailsAsync(311)end)
 local found={}
 if ok and type(details)=='table'then
  for _,item in ipairs(details.Items or{})do
   if item.Type=='Asset'then
    local kind=item.AssetType
    if not kind then for _,field in ipairs(fields)do if tostring(item.Name):gsub('%s',''):find(field,1,true)then kind=field;break end end end
    if table.find(fields,kind)then found[kind]=tonumber(item.Id)end
   end
  end
 end
 for _,field in ipairs(fields)do if not found[field]or found[field]&lt;=0 then found[field]=fallback[field]end end
 body=found;loading=false;return body
end
function M.apply(desc,rng)
 local values=load();for _,field in ipairs(fields)do desc[field]=values[field]end
 desc.BodyTypeScale=.35;desc.ProportionScale=0
 desc.HeightScale=rng and rng:NextNumber(.96,1.05)or 1
 desc.WidthScale=rng and rng:NextNumber(.88,.96)or .92
 desc.DepthScale=.92;desc.HeadScale=rng and rng:NextNumber(.95,1.02)or 1
end
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_STEAL60_V58_EarningsLedger"><Properties><string name="Name">EarningsLedger</string><ProtectedString name="Source">-- Gross earned coins, independent of wallet spending, fines and till transfers.
local M={}
local function valid(amount)return type(amount)=='number'and amount==amount and amount~=math.huge and amount~=-math.huge and amount&gt;0 end
function M.add(data,amount)
 if not valid(amount)then return 0 end
 local value=amount+math.clamp(tonumber(data.seasonEarningsFraction)or 0,0,.999999999)
 local whole=math.floor(value+1e-8)
 data.seasonEarningsFraction=math.max(0,value-whole)
 if whole&gt;0 then data.seasonEarnings=math.max(0,math.floor(tonumber(data.seasonEarnings)or 0))+whole end
 return whole
end
function M.migrationAmount(data)
 if data.grossTillLedgerV58==true then return 0 end
 data.grossTillLedgerV58=true
 return valid(data.till)and data.till or 0
end
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_STEAL60_V58_GuardService"><Properties><string name="Name">GuardService</string><ProtectedString name="Source">-- A catalog-dressed humanoid patrols the lobby and the exterior using physical navigation.
local Owner=require(script.Parent.OwnerService)
local Navigator=require(script.Parent.NPCNavigator)
local Collision=require(script.Parent.CollisionService)
local Data=require(script.Parent.DataService)
local Shared=game:GetService('ReplicatedStorage').Shared
local Layout=require(Shared.SalonLayout)
local M={}
function M.start(rec,alive)
 task.spawn(function()
  local rig=Owner.newRig(nil,'guard');if not rig then return end
  if not alive()then rig:Destroy();return end
  local hum=rig:FindFirstChildOfClass('Humanoid');local root=rig:FindFirstChild('HumanoidRootPart')
  if not hum or not root then rig:Destroy();return end
  local first=Layout.GuardPoints[1];local at=Layout.world(rec,first[1],first[2],.44+hum.HipHeight+root.Size.Y/2)
  rig.Name='Охранник · патруль';rig:PivotTo(CFrame.lookAt(at,at+Vector3.new(0,0,rec.side)))
  hum.WalkSpeed=6.5;hum.DisplayDistanceType=Enum.HumanoidDisplayDistanceType.None;rig.Parent=rec.model
  Collision.applyPlayer(rig);rec.guardModel=rig;rec.guardPatrolActive=true;rig:SetAttribute('PatrolActive',true)
  local head=rig:FindFirstChild('Head');local bb=Instance.new('BillboardGui');bb.AutoLocalize=false;bb.Name='GuardLevelStatus';bb.Adornee=head
  bb.Size=UDim2.fromOffset(140,25);bb.StudsOffsetWorldSpace=Vector3.new(0,2.1,0);bb.MaxDistance=22;bb.Parent=rig
  local label=Instance.new('TextLabel');label.Name='GuardLevelText';label.Size=UDim2.fromScale(1,1);label.BackgroundTransparency=1
  label.Font=Enum.Font.GothamBold;label.TextSize=12;label.TextColor3=Color3.fromRGB(158,226,249)
  local data=Data.get(rec.player);local level=data and math.min(5,(data.upgrades.security or 0)+((data.coinUpgrades or{}).security or 0))or 0
  label.Text=('ОХРАНА · %d/5'):format(level);label.Parent=bb;rec.guardLevelText=label
  local nav=Navigator.new(rig,{radius=1.2});local index=2;local failures=0
  while alive()and nav:alive()do
   local point=Layout.GuardPoints[index]
   if nav:go(Layout.world(rec,point[1],point[2],.5),function()return not alive()end,22)then
    failures=0;rig:SetAttribute('PatrolState','walking');rig:SetAttribute('PatrolPoint',index);task.wait(index==5 and 2.3 or .7);index=index%#Layout.GuardPoints+1
   else failures+=1;rig:SetAttribute('PatrolState','replanning');if failures&gt;=2 then index=index%#Layout.GuardPoints+1;failures=0 end;task.wait(.6)end
  end
  nav:destroy();if rig.Parent then rig:Destroy()end
 end)
end
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_STEAL60_V61_CarPreviewService"><Properties><string name="Name">CarPreviewService</string><ProtectedString name="Source">-- One temporary inspection car per player. Never reserves a ride, grants ownership or accepts theft.
local Shared=game:GetService('ReplicatedStorage').Shared
local Cars=require(Shared.Config.Cars)
local Factory=require(script.Parent.CarFactory)
local Art=require(Shared.CarCosmeticArt)
local Tuning=require(Shared.CarTuning)
local Grounding=require(Shared.CarGrounding)
local Layout=require(Shared.TrackLayout)
local M={};local active={};local folder=Instance.new('Folder');folder.Name='Steal60VehiclePreviews';folder.Parent=workspace
function M.clear(player)
 local car=active[player];active[player]=nil
 local ref=player:FindFirstChild('Steal60PreviewCar');if ref then ref.Value=nil end
 if car then Art.clear(car);Tuning.clear(car);Factory.release(car)end
end
function M.show(player,id,appearance,rarity,variant)
 M.clear(player)
 local definition=Cars.ById[id];local char=player.Character;local root=char and char:FindFirstChild('HumanoidRootPart')
 if not definition or not root then return false end
 local car
 local ok,err=pcall(function()
  car=Factory.acquire(definition,definition.class);car.Parent=folder;Art.clear(car);Tuning.clear(car)
  Factory.dress(car,definition,definition.class,rarity or'common',variant or'default',Random.new())
  car:SetAttribute('State','cosmetic_preview');car:SetAttribute('CosmeticPreviewOwner',player.UserId)
  car:SetAttribute('OwnerId',nil);car:SetAttribute('DriverId',nil);car:SetAttribute('Drivable',nil)
  local side=root.Position.Z&gt;=0 and 1 or-1;local chosen
  for _,lane in ipairs({side*11,-side*11})do
   for _,offset in ipairs({14,-14,34,-34,54,-54})do
    local pos=Vector3.new(math.clamp(root.Position.X+offset,-30,Layout.trackEnd()-18),.25,lane)
    local free=true
    for _,other in ipairs(Factory.getLiveCars())do
     if other~=car and other.Parent then
      local at=other:GetPivot().Position
      if math.abs(at.X-pos.X)&lt;17 and math.abs(at.Z-pos.Z)&lt;8 then free=false;break end
     end
    end
    if free then chosen=pos;break end
   end
   if chosen then break end
  end
  chosen=chosen or Vector3.new(math.clamp(root.Position.X+14,-30,Layout.trackEnd()-18),.25,-side*11)
  car:PivotTo(CFrame.new(chosen));car.Parent=folder
  Art.finish(car,appearance.paint,appearance.skin);Tuning.apply(car,appearance.tuning)
  Grounding.place(car,Grounding.surface(chosen,{car,char,folder}))
  for _,obj in ipairs(car:GetDescendants())do
   if obj:IsA('ProximityPrompt')then obj.Enabled=false
   elseif obj:IsA('BillboardGui')then obj.Enabled=false
   elseif obj:IsA('BasePart')then obj.Anchored=true;obj.CanCollide=false;obj.CanTouch=false;obj.CanQuery=false end
  end
  local body=car:FindFirstChild('Body',true)or car.PrimaryPart
  local attachment=body and body:FindFirstChild('CarLabelRoofAnchor')
  if attachment then
   local bb=Instance.new('BillboardGui');bb.AutoLocalize=false;bb.Name='CarInspectionLabel';bb.Adornee=attachment;bb.Size=UDim2.fromOffset(240,42);bb.AlwaysOnTop=true;bb.MaxDistance=90;bb.Parent=body
   local text=Instance.new('TextLabel');text.Size=UDim2.fromScale(1,1);text.BackgroundTransparency=1;text.Text='ПРЕДПРОСМОТР · 20 СЕК\n'..definition.name;text.Font=Enum.Font.GothamBold;text.TextSize=13;text.TextColor3=Color3.fromRGB(133,243,224);text.TextStrokeTransparency=.25;text.Parent=bb
  end
  active[player]=car
  local ref=player:FindFirstChild('Steal60PreviewCar')or Instance.new('ObjectValue');ref.Name='Steal60PreviewCar';ref.Value=car;ref.Parent=player
 end)
 if not ok then if car then Art.clear(car);Tuning.clear(car);Factory.release(car)end;warn('[Steal60 vehicle preview] '..tostring(err));return false end
 return true
end
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_STEAL60_V62_StudioTestProfile"><Properties><string name="Name">StudioTestProfile</string><ProtectedString name="Source">-- Studio-only test reset. Live profiles and receipt history are never edited by this module.
local M={USERNAME='HarDvRaiN',FLAG='studioFreshStartV62',FALLBACK_LEVEL=15}
function M.allowed(player,isStudio)return isStudio and string.lower(player.Name)==string.lower(M.USERNAME)end
function M.reset(data,player,isStudio,temporary)
 if not M.allowed(player,isStudio)or data[M.FLAG]then return false end
 local level=data.hackLevel;local xp=data.hackXP;local gems=data.diamonds
 if temporary and(level or 1)==1 then level=M.FALLBACK_LEVEL end
 for _,key in ipairs({'money','till','seasonEarnings','seasonEarningsFraction','heroSkinBonusLevel','petBonusLevel','theftCount','theftNextAt','boostUntil','masterKeyTokens','penaltyUntil','vipUntil'})do data[key]=0 end
 for _,key in ipairs({'upgrades','coinUpgrades','catalog','shelf','shelfStorage','lootCopies','lootRanks','theftParts','accessoryOrder','dailyHeists','roadContract','tutorialV2'})do data[key]={}end
 data.upgrades={speed=0,income=0,botSpeed=0,security=0,shelves=0}
 data.showcase={recent={},pinned={},manual=false};data.shelfCapacity=12;data.botUnlocked=false;data.tutorialStage=0;data.theftLevel=1;data.lastHeistZone=1;data.lastSeen=0
 data.hackLevel=level or 1;data.hackXP=xp or 0;data.diamonds=gems or 0
 data.grossTillLedgerV58=true;data[M.FLAG]=true
 return true
end
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_STEAL60_V62_StreetLifeService"><Properties><string name="Name">StreetLifeService</string><ProtectedString name="Source">-- A small streamed cast of physical pedestrians. No per-frame server teleporting.
local Players=game:GetService('Players');local Shared=game:GetService('ReplicatedStorage').Shared
local Districts=require(script.Parent.DistrictManager);local Owner=require(script.Parent.OwnerService)
local Navigator=require(script.Parent.NPCNavigator);local Collision=require(script.Parent.CollisionService);local Layout=require(Shared.TrackLayout)
local M={};local count=0;local MAX=6;local records={}
local function prop(rig,name,size,cf,color,host,shape)
 local p=Instance.new('Part');p.Name=name;p.Size=size;p.CFrame=cf;p.Color=color;p.Shape=shape or Enum.PartType.Block
 p.Anchored=false;p.Massless=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.Parent=rig
 local weld=Instance.new('WeldConstraint');weld.Part0=host;weld.Part1=p;weld.Parent=p;return p
end
local function coffee(rig)
 local hand=rig:FindFirstChild('RightHand')or rig:FindFirstChild('Right Arm');if not hand then return end
 local f=Instance.new('Folder');f.Name='Coffee';f.Parent=rig
 local at=hand.CFrame*CFrame.new(0,-.2,-.12)*CFrame.Angles(0,0,math.pi/2)
 prop(f,'PaperCup',Vector3.new(.36,.24,.24),at,Color3.fromRGB(226,205,174),hand,Enum.PartType.Cylinder)
 prop(f,'CoffeeLid',Vector3.new(.06,.27,.27),at*CFrame.new(.2,0,0),Color3.fromRGB(44,43,42),hand,Enum.PartType.Cylinder)
 local joint=rig:FindFirstChild('RightShoulder',true)or rig:FindFirstChild('Right Shoulder',true);local before=joint and joint.C0
 if joint then joint.C0=before*CFrame.Angles(-1.05,0,-.18)end
 return function()if joint and joint.Parent then joint.C0=before end;f:Destroy()end
end
local function headphones(rig)
 local head=rig:FindFirstChild('Head');if not head then return end
 local f=Instance.new('Folder');f.Name='Headphones';f.Parent=rig
 for _,side in ipairs({-1,1})do prop(f,'EarCup',Vector3.new(.18,.49,.42),head.CFrame*CFrame.new(side*.68,.04,0),Color3.fromRGB(44,65,87),head,Enum.PartType.Cylinder)end
 for i=0,6 do local a=math.pi*i/6
  prop(f,'HeadphoneBand',Vector3.new(.27,.09,.18),head.CFrame*CFrame.new(math.cos(a)*.67,math.sin(a)*.67,0)*CFrame.Angles(0,0,a+math.pi/2),Color3.fromRGB(60,193,185),head)
 end
 return function()f:Destroy()end
end
local function nearby(root)
 for _,p in ipairs(Players:GetPlayers())do local r=p.Character and p.Character:FindFirstChild('HumanoidRootPart');if r and(r.Position-root.Position).Magnitude&lt;220 then return true end end
 return false
end
local function spawnActor(index,model,ordinal)
 if count&gt;=MAX then return end;count+=1
 local record={active=true};records[model]=records[model]or{};table.insert(records[model],record)
 task.spawn(function()
  local rig;local nav;local cleanup
  local ok,err=pcall(function()
   rig=Owner.newRig();if not rig then return end
   if not record.active or not model.Parent then rig:Destroy();return end
   local hum=rig:FindFirstChildOfClass('Humanoid');local root=rig:FindFirstChild('HumanoidRootPart');if not hum or not root then rig:Destroy();return end
   local side=ordinal==1 and 1 or-1;local x=Layout.districtStart(index)+100+(ordinal-1)*170;local z=side*34.5
   rig.Name='Горожанин';rig:PivotTo(CFrame.new(x,.4+hum.HipHeight+root.Size.Y/2,z));rig.Parent=model;record.rig=rig
   hum.DisplayDistanceType=Enum.HumanoidDisplayDistanceType.None;Collision.applyPlayer(rig);nav=Navigator.new(rig,{radius=1.1})
   local step=ordinal+index
   while record.active and model.Parent and nav:alive()do
    if not nearby(root)then nav:stop();task.wait(1.2);continue end
    local mode=step%4;rig:SetAttribute('StreetActivity',mode==0 and'coffee'or mode==1 and'music'or mode==2 and'jog'or'walk')
    if mode==0 or mode==1 then
     nav:stop();cleanup=mode==0 and coffee(rig)or headphones(rig)
     local untilAt=os.clock()+7
     while record.active and nav:alive()and os.clock()&lt;untilAt do task.wait(.4)end
     if cleanup then cleanup();cleanup=nil end
    else
     hum.WalkSpeed=mode==2 and 15 or 6.5
     local goal=Vector3.new(x+(step%2==0 and 90 or-35),.4,z)
     nav:go(goal,function()return not record.active or not model.Parent end,25)
    end
    step+=1;task.wait(.5)
   end
  end)
  if cleanup then cleanup()end;if nav then nav:destroy()end;if rig and rig.Parent then rig:Destroy()end
  record.active=false;local list=records[model];if list then local i=table.find(list,record);if i then table.remove(list,i)end end;count-=1;if not ok then warn('[Steal60 street life] '..tostring(err))end
 end)
end
function M.init()
 Districts.onLoaded(function(index,model)
  for i=1,2 do spawnActor(index,model,i)end
 end)
 task.spawn(function()while true do task.wait(4)
  for _,index in ipairs(Districts.getLoadedIndices())do local model=Districts.getModel(index);if model then
   local alive=0;for _,record in ipairs(records[model]or{})do if record.active then alive+=1 end end
   if alive&lt;2 and count&lt;MAX then spawnActor(index,model,alive+1)end
  end end
 end end)
 Districts.onUnloaded(function(_,model)
  for _,record in ipairs(records[model]or{})do record.active=false;if record.rig and record.rig.Parent then record.rig:Destroy()end end;records[model]=nil
 end)
end
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_STEAL60_V64_LanguageService"><Properties><string name="Name">LanguageService</string><ProtectedString name="Source">-- Per-player preference only. No currency changes and no new reset marker.
local Players=game:GetService('Players');local Data=require(script.Parent.DataService);local Net=require(script.Parent.Net)
local M={};local pending={};local serials={};local last={}
local function valid(value)return value=='ru'or value=='en'end
local function persist(player)
 local token=(serials[player]or 0)+1;serials[player]=token
 task.delay(2,function()
  if serials[player]~=token or not player.Parent or not Data.canSave(player)then return end
  local ok,err=pcall(Data.requestSave or Data.saveNow,player);if not ok then warn('[Steal60 language] '..tostring(err))end
 end)
end
local function apply(player,language)
 local data=Data.get(player)
 if not data then pending[player]=language;return end
 if data.language~=language then data.language=language;persist(player)end
 player:SetAttribute('Steal60Language',language)
end
function M.init()
 Net.SetLanguage.OnServerEvent:Connect(function(player,language)
  if not player or not player.Parent or not valid(language)then return end
  local now=os.clock();if last[player]and now-last[player]&lt;.1 then return end;last[player]=now
  apply(player,language)
 end)
 local function bind(player)
  Data.onLoaded(player,function(data)
   if not player.Parent then return end
   local language=pending[player]or(valid(data.language)and data.language or'ru');pending[player]=nil
   apply(player,language)
  end)
 end
 Players.PlayerAdded:Connect(bind);for _,player in ipairs(Players:GetPlayers())do bind(player)end
 Players.PlayerRemoving:Connect(function(player)pending[player]=nil;serials[player]=nil;last[player]=nil end)
end
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_v65_SecurityService"><Properties><string name="Name">SecurityService</string><ProtectedString name="Source">-- Server ingress: bounded commands, token buckets, movement and real hold duration.
local Players=game:GetService('Players');local Run=game:GetService('RunService');local Workspace=game:GetService('Workspace')
local Settings=require(game:GetService('ReplicatedStorage').Shared.Config.Settings)
local M={};local buckets={};local movement={};local started=false;local driveCheck;local activeHolds={}
local function finite(n)return type(n)=='number'and n==n and n~=math.huge and n~=-math.huge end
local function stringId(v,maximum)return type(v)=='string'and #v&gt;0 and #v&lt;=(maximum or 80)end
local function model(v)return typeof(v)=='Instance'and v:IsA('Model')end
local rules={
 HackTap={12,12,1,function(a)return stringId(a,16)and(a=='tap'or a=='cancel'or a:match('^wire_[123]$')or a:match('^memory_[1234]$'))end},
 DriveInput={35,60,5,function(car,t,s,protocol,epoch)return model(car)and finite(t)and finite(s)and math.abs(t)&lt;=1 and math.abs(s)&lt;=1 and(protocol==0 or protocol==60)and finite(epoch)and epoch%1==0 end},
 RecoverCar={1,2,1,model},PinCar={2,3,2,function(id,out)return stringId(id)and(out==nil or stringId(out))end},
 ManageWorkshop={3,3,2,function(action,id)return action=='upgradeShelf'and stringId(id,48)end},
 BuyUpgrade={4,4,1,stringId},BuyCoinUpgrade={4,4,1,stringId},BuyVIP={1.5,2,1,stringId},
 CosmeticAction={5,6,4,function(action,category,id,car)return stringId(action,32)and stringId(category,16)and(id==nil or stringId(id,48))and(car==nil or stringId(car))end},
 TutorialAction={3,4,2,function(action,id)return stringId(action,16)and(id==nil or stringId(id,32))end},
 SetLanguage={4,4,1,function(value)return value=='ru'or value=='en'end},GetMenuData={2.5,4,0},GetSeasonTop={.5,2,0},
}
function M.allow(player,key,rate,burst)
 if not player or not player.Parent then return false end
 local list=buckets[player];if not list then list={};buckets[player]=list end
 local now=os.clock();local b=list[key]
 if not b then b={at=now,tokens=burst};list[key]=b end
 b.tokens=math.min(burst,b.tokens+math.max(0,now-b.at)*rate);b.at=now
 if b.tokens&lt;1 then return false end;b.tokens-=1;return true
end
function M.setDriveValidator(fn)driveCheck=fn end
local function rootOf(player)
 local char=player.Character;local hum=char and char:FindFirstChildOfClass('Humanoid');local root=char and char:FindFirstChild('HumanoidRootPart')
 if not char or not char.Parent or not root or not hum or hum.Health&lt;=0 then return end
 return root,hum,char
end
function M.teleport(player,cf)
 local root,_,char=rootOf(player);if not root then return false end
 char:PivotTo(cf);movement[player]={char=char,last=root.Position,at=os.clock(),budget=12};return true
end
function M.movement(player)
 local root,hum,char=rootOf(player);if not root then return false end
 local now=os.clock();local r=movement[player];local position=root.Position
 if not r or r.char~=char then r={char=char,last=position,at=now,budget=12};movement[player]=r end
 if r.deniedUntil and now&lt;r.deniedUntil then return false end
 if hum.SeatPart and driveCheck then
  local point=driveCheck(player,hum.SeatPart)
  if point and(position-point).Magnitude&lt;=14 then r.last=position;r.at=now;r.budget=12;return true end
 end
 local speed=Run:IsStudio()and 60 or 34
 r.budget=math.min(80,r.budget+math.max(0,now-r.at)*speed);r.at=now
 local dx,dz=position.X-r.last.X,position.Z-r.last.Z;local travel=math.sqrt(dx*dx+dz*dz)
 local invalid=not finite(position.X)or not finite(position.Y)or not finite(position.Z)or travel&gt;r.budget+2
  or position.X&lt; -65 or position.X&gt;Settings.Track.SalonZoneLength+5*(Settings.Track.DistrictLength+Settings.Track.IntersectionLength)+20
  or math.abs(position.Z)&gt;Settings.Track.GroundHalfWidth+5 or position.Y&gt;28 or position.Y&lt; -45
 if invalid then
  r.deniedUntil=now+.5;r.budget=0
  char:PivotTo(CFrame.new(r.safe or r.last));root.AssemblyLinearVelocity=Vector3.zero;root.AssemblyAngularVelocity=Vector3.zero
  return false
 end
 r.budget=math.max(0,r.budget-travel);r.last=position;if position.Y&gt;=-5 then r.safe=position end;return true
end
function M.wrap(name,handler)
 return function(player,...)
  local rule=rules[name];if not rule or select('#',...)&gt;rule[3]then return end
  if not M.allow(player,'all',100,140)or not M.allow(player,name,rule[1],rule[2])then return end
  if rule[4]and not rule[4](...)then return end
  if name~='SetLanguage'and not(name=='TutorialAction'and select(1,...)=='request')then
   if player:GetAttribute('DataLoaded')~=true or player:GetAttribute('GameplayReady')~=true then return end
   if name~='DriveInput'and not M.movement(player)then return end
  end
  local ok,result=pcall(handler,player,...)
  if not ok then if M.allow(player,'error_'..name,.1,1)then warn('[Steal60 security] rejected failing handler '..name)end;return end
  return result
 end
end
function M.proxy(remote)
 local event
 return setmetatable({}, {
  __index=function(_,key)
   if key=='OnServerEvent'then
    if not event then event={Connect=function(_,fn)return remote.OnServerEvent:Connect(M.wrap(remote.Name,fn))end}end
    return event
   end
   if key=='OnServerInvoke'then return remote[key]end
   local value=remote[key]
   if type(value)=='function'then return function(_,...)return value(remote,...)end end
   return value
  end,
  __newindex=function(_,key,value)remote[key]=key=='OnServerInvoke'and M.wrap(remote.Name,value)or value end,
 })
end
local function promptPosition(prompt)
 local parent=prompt.Parent;if not parent then return end
 if parent:IsA('Attachment')then return parent.WorldPosition elseif parent:IsA('BasePart')then return parent.Position elseif parent:IsA('Model')then return parent:GetPivot().Position end
end
function M.prompt(prompt,handler)
 local holds={};local connections={}
 local function near(player)
  if not prompt.Parent or not prompt.Enabled or not prompt:IsDescendantOf(Workspace)or player:GetAttribute('GameplayReady')~=true or not M.movement(player)then return false end
  local root=rootOf(player);local point=promptPosition(prompt)
  return root and point and(root.Position-point).Magnitude&lt;=(prompt.MaxActivationDistance or 10)+2
 end
 connections[#connections+1]=prompt.PromptButtonHoldBegan:Connect(function(player)
  if not M.allow(player,'hold',6,8)or not near(player)then return end
  local previous=activeHolds[player];if previous then previous.holds[player]=nil end
  holds[player]={at=os.clock(),duration=math.max(0,prompt.HoldDuration),position=promptPosition(prompt)}
  activeHolds[player]={prompt=prompt,holds=holds,near=near}
 end)
 connections[#connections+1]=prompt.PromptButtonHoldEnded:Connect(function(player)
  local held=holds[player];if held then held.ended=os.clock();if held.ended-held.at&lt;held.duration-.05 then holds[player]=nil end end
 end)
 connections[#connections+1]=prompt.Triggered:Connect(function(player)
  if not M.allow(player,'prompt',6,8)or not near(player)then return end
  local duration=math.max(0,prompt.HoldDuration)
  if duration&gt;0 then
   local held=holds[player];holds[player]=nil;activeHolds[player]=nil
   if not held or os.clock()-held.at&lt;math.max(duration,held.duration)-.05 or os.clock()-held.at&gt;math.max(duration,held.duration)+3
    or(held.ended and os.clock()-held.ended&gt;.4)or(promptPosition(prompt)-held.position).Magnitude&gt;3 then return end
  end
  handler(player)
 end)
 connections[#connections+1]=prompt:GetPropertyChangedSignal('Enabled'):Connect(function()if not prompt.Enabled then table.clear(holds)end end)
 connections[#connections+1]=prompt.AncestryChanged:Connect(function()table.clear(holds)end)
 connections[#connections+1]=prompt.Destroying:Connect(function()for _,c in ipairs(connections)do c:Disconnect()end;table.clear(holds)end)
 return connections
end
function M.init()
 if started then return end;started=true
 local function bind(player)
  player.CharacterAdded:Connect(function(char)
   movement[player]=nil;local root=char:WaitForChild('HumanoidRootPart',8)
   if root and player.Character==char then movement[player]={char=char,last=root.Position,at=os.clock(),budget=12}end
  end)
 end
 Players.PlayerAdded:Connect(bind);for _,p in ipairs(Players:GetPlayers())do bind(p)end
 Players.PlayerRemoving:Connect(function(player)buckets[player]=nil;movement[player]=nil;local held=activeHolds[player];if held then held.holds[player]=nil end;activeHolds[player]=nil end)
 local elapsed=0;Run.Heartbeat:Connect(function(dt)
  elapsed+=dt;if elapsed&lt;.2 then return end;elapsed=0
  for _,p in ipairs(Players:GetPlayers())do if p.Character then M.movement(p)end end
  for player,active in pairs(activeHolds)do local held=active.holds[player];if not held or not active.near(player)or os.clock()-held.at&gt;held.duration+3 then active.holds[player]=nil;activeHolds[player]=nil end end
 end)
end
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_v65_ProfileStore"><Properties><string name="Name">ProfileStore</string><ProtectedString name="Source">-- Fenced profile leases, atomic commerce ledger and two rotating recovery snapshots.
local DSS=game:GetService('DataStoreService');local Http=game:GetService('HttpService')
