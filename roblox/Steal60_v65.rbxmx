          <Item class="ModuleScript" referent="RBX7">
            <Properties>
              <string name="Name">Loot</string>
              <ProtectedString name="Source">-- ModuleScript: ReplicatedStorage/Shared/Config/Loot
-- income — доход предмета на полке (в секунду). minClass — с какого класса машины (order) он может выпасть.
local Loot = {
	{ zone = 1, id = "tree_fresh",   name = "Ёлочка-ароматизатор", rarity = "common",    income = 1,   minClass = 1 },
	{ zone = 1, id = "cover_basic",  name = "Простой чехол",       rarity = "common",    income = 2,   minClass = 1 },
	{ zone = 2, id = "mats",         name = "Коврики",             rarity = "common",    income = 4,   minClass = 2 },
	{ zone = 1, id = "radio_old",    name = "Кассетная магнитола", rarity = "rare",      income = 8,   minClass = 1 },
	{ zone = 2, id = "radio_fm",     name = "Магнитола ФМ",        rarity = "rare",      income = 15,  minClass = 2 },
	{ zone = 2, id = "subwoofer",    name = "Сабвуфер",            rarity = "rare",      income = 30,  minClass = 2 },
	{ zone = 3, id = "neon_kit",     name = "Неоновая подсветка",  rarity = "epic",      income = 70,  minClass = 3 },
	{ zone = 3, id = "leather",      name = "Кожаные чехлы",       rarity = "epic",      income = 110, minClass = 3 },
	{ zone = 3, id = "carbon_wheel", name = "Карбоновый руль",     rarity = "epic",      income = 180, minClass = 3 },
	{ zone = 4, id = "multimedia",   name = "Мультимедиа-система", rarity = "legendary", income = 300, minClass = 4 },
	{ zone = 4, id = "dash_screen", name = "Тач-дисплей", rarity = "rare", income = 240, minClass = 4 },
	{ zone = 5, id = "carbon_kit",   name = "Карбоновый обвес",    rarity = "legendary", income = 450, minClass = 5 },
	{ zone = 5, id = "gold_kit",     name = "Золотой комплект",    rarity = "legendary", income = 500, minClass = 5 },
}

-- Шансы редкости предмета в зависимости от редкости машины
Loot.WeightsByCarRarity = {
	common    = { common = 70, rare = 25, epic = 4,  legendary = 1  },
	rare      = { common = 50, rare = 35, epic = 12, legendary = 3  },
	epic      = { common = 30, rare = 40, epic = 24, legendary = 6  },
	legendary = { common = 15, rare = 35, epic = 35, legendary = 15 },
}

Loot.ById = {}
for _, item in ipairs(Loot) do
	Loot.ById[item.id] = item
end

return Loot
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX_NEW_UpgradeConfig">
            <Properties>
              <string name="Name">UpgradeConfig</string>
              <ProtectedString name="Source">-- Единственная валюта для ВСЕХ улучшений: алмазы (не обычные деньги).
-- Цены задаются здесь, валидируются и списываются только на сервере.
local U = {
    { id="speed", name="Скорость", description="+2,5 к скорости машины", base=12, growth=1.45, max=12 },
    { id="income", name="Доход", description="+3% дохода полок", base=15, growth=1.52, max=15 },
    { id="botSpeed", name="Соучастник", description="Быстрее возвращает машину", base=14, growth=1.55, max=8 },
    { id="security", name="Охрана", description="Замедляет кражи игроков и ловит НПС", base=18, growth=1.65, max=5 },
    { id="shelves", name="Полки", description="+3 места для добычи", base=24, growth=1.75, max=2 },
    { id="till48h", name="Касса на 48 часов", description="Постоянная вместимость кассы вместо 12 ч", base=95, growth=1, max=1 },
    { id="doubleIncome", name="Двойной доход", description="x2 дохода салона навсегда", base=150, growth=1, max=1 },
    { id="fastRide", name="Спорт-двигатель", description="+25% скорость собственных машин", base=95, growth=1, max=1 },
    { id="masterThief", name="Мастер взлома", description="+8 п.п. к зоне успеха; уровень обязателен", base=130, growth=1, max=1 },
    { id="secondBot", name="Второй помощник", description="Возврат предыдущей машины на 35% быстрее", base=100, growth=1, max=1 },
    { id="autoCollect", name="Автокасса", description="Собирает деньги каждые 15 секунд", base=125, growth=1, max=1 },
}
U.ById={}
for _,u in ipairs(U) do
    assert(U.ById[u.id]==nil,"Повторное улучшение: "..u.id)
    U.ById[u.id]=u
end
function U.cost(id,level)
    local u=U.ById[id]
    if not u or type(level)~="number" or level&lt;0 or level&gt;=u.max then return nil end
    return math.max(1,math.floor(u.base*(u.growth^level)+.5))
end
return U
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX_NEW_MonetizationConfig">
            <Properties>
              <string name="Name">MonetizationConfig</string>
              <ProtectedString name="Source">-- Only diamond packs are sold directly for Robux. Other upgrades cost diamonds.
-- Create FOUR Developer Products in Creator Hub and replace assetId=0 with real product IDs.
-- Robux prices are configured in Roblox Creator Hub, NOT hardcoded here.
local C={}
-- Legacy passes are recognized for players who already owned them (do NOT sell in the new shop).
C.Passes={
    {id="doubleIncome",name="x2 доход (старый пропуск)",assetId=0},
    {id="fastRide",name="Быстрая машина (старый пропуск)",assetId=0},
    {id="masterThief",name="Мастер-вор (старый пропуск)",assetId=0},
    {id="secondBot",name="Второй помощник (старый пропуск)",assetId=0},
    {id="extraShowcase",name="Витрина (старый пропуск)",assetId=0},
    {id="autoCollect",name="Автосбор (старый пропуск)",assetId=0},
    {id="vip",name="ВИП (старый пропуск)",assetId=0},
    {id="till48h",name="Касса 48 ч (старый пропуск)",assetId=0},
}
C.Products={
    {id="gems50",name="250 алмазов",description="Первый образ или несколько усилений",diamonds=250,recommendedRobux=99,assetId=0},
    {id="gems150",name="700 алмазов",description="Образ, ВИП или набор тюнинга",diamonds=700,recommendedRobux=249,assetId=0},
    {id="gems400",name="1 500 алмазов",description="Основной набор для коллекции и усилений",diamonds=1500,recommendedRobux=500,featured=true,assetId=0},
    {id="gems1000",name="3 300 алмазов",description="Большой набор с выгодой за объём",diamonds=3300,recommendedRobux=999,assetId=0},
}
C.PassById,C.ProductById,C.ProductByAsset={},{},{}
for _,v in ipairs(C.Passes) do C.PassById[v.id]=v end
for _,v in ipairs(C.Products) do
    C.ProductById[v.id]=v
    if v.assetId&gt;0 then
        assert(C.ProductByAsset[v.assetId]==nil,"Developer Product ID repeated: "..v.assetId)
        C.ProductByAsset[v.assetId]=v
    end
end
return C
</ProtectedString>
            </Properties>
          </Item>
        <Item class="ModuleScript" referent="RBX_ACCESSORY_CONFIG_V12"><Properties><string name="Name">AccessoryConfig</string><ProtectedString name="Source">-- Shared car accessory configuration. Add new rows here for future content.
-- Unlock: first drop grants basePct ONCE. Each five duplicates are consumed for a star.
-- Gold stars 1-5 -&gt; red 1-5 -&gt; green 1-5 (best). No global bonus ceiling.
local AccessoryConfig = {}
AccessoryConfig.COPIES_PER_STAR = 5
AccessoryConfig.MAX_LEVEL = 20
AccessoryConfig.HEIST_DROP_CHANCE = 0.07 -- one roll per successfully delivered car
AccessoryConfig.SALON_STEALS_PER_DROP = 50 -- guaranteed milestone, unchanged from v9
AccessoryConfig.List = {
    {zone=1,id="air_freshener", name="Пахучка", basePct=2, color=Color3.fromRGB(126,246,148)},
    {zone=1,id="fm_radio", name="Магнитола", basePct=3, color=Color3.fromRGB(77,201,249)},
    {zone=2,id="car_speakers", name="Колонки", basePct=3, color=Color3.fromRGB(199,123,245)},
    {zone=2,id="led_trim", name="Светодиодная подсветка", basePct=4, color=Color3.fromRGB(255,118,195)},
    {zone=2,id="subwoofer", name="Сабвуфер", basePct=4, color=Color3.fromRGB(250,199,90)},
    {zone=3,id="sport_gauges", name="Спорт-приборы", basePct=3, color=Color3.fromRGB(255,129,93)},
    {zone=3,id="velour_mats", name="Коврики", basePct=2, color=Color3.fromRGB(169,211,230)},
    {zone=4,id="seat_covers", name="Чехлы", basePct=3, color=Color3.fromRGB(255,156,151)},
    {zone=4,id="sport_wheel", name="Спорт-руль", basePct=4, color=Color3.fromRGB(245,221,110)},
    {zone=5,id="gps_unit", name="Навигатор", basePct=3, color=Color3.fromRGB(108,211,250)},
    {zone=5,id="dash_camera", name="Видеорегистратор", basePct=2, color=Color3.fromRGB(196,176,255)},
    {zone=5,id="ambient_lighting", name="Подсветка салона", basePct=4, color=Color3.fromRGB(118,233,207)},
}
AccessoryConfig.ById = {}
for _, def in ipairs(AccessoryConfig.List) do
    assert(not AccessoryConfig.ById[def.id], "Duplicate accessory ID")
    AccessoryConfig.ById[def.id] = def
end

function AccessoryConfig.read(raw)
    -- v9-v11 saved INTEGER counts. Preserve all previous drops and convert lazily.
    if type(raw) == "number" then
        local n = math.max(0, math.floor(raw == raw and math.min(raw, 1000000) or 0))
        if n == 0 then return false, 0, 0 end
        local level = math.min(AccessoryConfig.MAX_LEVEL, math.floor((n-1) / AccessoryConfig.COPIES_PER_STAR))
        local copies = level &gt;= AccessoryConfig.MAX_LEVEL and 0 or ((n-1) % AccessoryConfig.COPIES_PER_STAR)
        return true, level, copies
    end
    if type(raw) == "table" and raw.owned == true then
        local level = math.clamp(math.floor(tonumber(raw.level) or 0), 0, AccessoryConfig.MAX_LEVEL)
        local copies = level &gt;= AccessoryConfig.MAX_LEVEL and 0
            or math.clamp(math.floor(tonumber(raw.copies) or 0), 0, AccessoryConfig.COPIES_PER_STAR - 1)
        return true, level, copies
    end
    return false, 0, 0
end

function AccessoryConfig.bonusPct(def, level)
    -- +1 per white, +2 per green, +3 per red, +6 per final shining gold star.
    -- Bonus from different items is added, NEVER multiplied; no total ceiling.
    return def.basePct + math.min(level,5)*1 + math.clamp(level-5,0,5)*2
        + math.clamp(level-10,0,5)*3 + math.clamp(level-15,0,5)*6
end

function AccessoryConfig.totalPct(data)
    local total = 0
    local owned = type(data.theftParts) == "table" and data.theftParts or {}
    for _, def in ipairs(AccessoryConfig.List) do
        local have, level = AccessoryConfig.read(owned[def.id])
        if have then total += AccessoryConfig.bonusPct(def,level) end
    end
    return total -- additive across DIFFERENT items; no arbitrary total cap
end

local STAGES={
    {name="БЕЛЫЕ",hex="#EDF2FF",color=Color3.fromRGB(238,244,255)},
    {name="ЗЕЛЁНЫЕ",hex="#72F2AC",color=Color3.fromRGB(92,237,160)},
    {name="КРАСНЫЕ",hex="#FF777B",color=Color3.fromRGB(255,103,114)},
    {name="ЗОЛОТЫЕ СИЯЮЩИЕ",hex="#FFD962",color=Color3.fromRGB(255,215,87)},
}
function AccessoryConfig.stageIndex(level)
    return math.clamp(math.floor(math.max(0,level)/5)+1,1,4)
end
function AccessoryConfig.stageColor(level)
    return STAGES[AccessoryConfig.stageIndex(level)].color
end
function AccessoryConfig.starsRich(level)
    local stage=AccessoryConfig.stageIndex(level)
    local done=math.clamp(level-5*(stage-1),0,5)
    local hex=STAGES[stage].hex
    local rows={}
    for i=1,5 do
        local lit=level&gt;=AccessoryConfig.MAX_LEVEL or i&lt;=done
        local shade=lit and hex or "#526071"
        rows[i]='&lt;font color="'..shade..'"&gt;'..(lit and "★" or "☆")..'&lt;/font&gt;'
    end
    return table.concat(rows)
end
function AccessoryConfig.progressRich(level,copies)
    if level&gt;=AccessoryConfig.MAX_LEVEL then return "МАКС · сияющее золото" end
    local stage=STAGES[AccessoryConfig.stageIndex(level)]
    local marks={}
    for i=1,5 do
        marks[i]='&lt;font color="'..(i&lt;=copies and stage.hex or "#59697B")..'"&gt;◆&lt;/font&gt;'
    end
    return stage.name.." "..table.concat(marks).." "..copies.."/5"
end
function AccessoryConfig.stageName(level)
    return level&gt;=AccessoryConfig.MAX_LEVEL and "МАКС · ЗОЛОТЫЕ" or STAGES[AccessoryConfig.stageIndex(level)].name
end

function AccessoryConfig.listForClient(data)
    local rows = {}
    local owned = type(data.theftParts) == "table" and data.theftParts or {}
    for _, def in ipairs(AccessoryConfig.List) do
        local have,level,copies = AccessoryConfig.read(owned[def.id])
        table.insert(rows,{
            id=def.id,name=def.name,owned=have,level=level,copies=copies,
            pct=have and AccessoryConfig.bonusPct(def,level) or 0,zone=def.zone,
            stars=AccessoryConfig.starsRich(level),stage=AccessoryConfig.stageName(level),
            progress=AccessoryConfig.progressRich(level,copies),
            maxed=have and level&gt;=AccessoryConfig.MAX_LEVEL,
        })
    end
    return rows
end

function AccessoryConfig.award(data, rng, zone)
    zone=math.clamp(math.floor(tonumber(zone) or 1),1,5)
    data.theftParts = type(data.theftParts) == "table" and data.theftParts or {}
    -- Avoid useless max-tier duplicate drops while uncompleted items exist.
    local pool = {}
    for _, def in ipairs(AccessoryConfig.List) do
        local have,level = AccessoryConfig.read(data.theftParts[def.id])
        if def.zone==zone and (not have or level &lt; AccessoryConfig.MAX_LEVEL) then
            table.insert(pool,def)
        end
    end
    if #pool == 0 then return nil end
    local def = pool[rng:NextInteger(1,#pool)]
    local have,level,copies = AccessoryConfig.read(data.theftParts[def.id])
    local kind = "first"
    if have then
        copies += 1
        kind = "duplicate"
        if copies &gt;= AccessoryConfig.COPIES_PER_STAR then
            copies = 0
            level += 1
            kind = "upgrade"
        end
    end
    data.theftParts[def.id] = {owned=true, level=level, copies=copies}
    return {
        id=def.id,name=def.name,kind=kind,level=level,copies=copies,
        pct=AccessoryConfig.bonusPct(def,level),zone=zone,
        totalPct=AccessoryConfig.totalPct(data),
        stars=AccessoryConfig.starsRich(level),
    }
end

function AccessoryConfig.dropMessage(drop)
    if not drop then return "" end
    if drop.kind == "first" then
        return ("НОВАЯ ДЕТАЛЬ: %s · +%d%% к деньгам за угон!"):format(drop.name,drop.pct)
    elseif drop.kind == "upgrade" then
        return ("УЛУЧШЕНИЕ: %s · %d/20 ★ · теперь +%d%% за угон!"):format(drop.name,drop.level,drop.pct)
    end
    return ("ДУБЛИКАТ: %s · %d/5 к следующей звезде (бонус не повторяется)"):format(
        drop.name,drop.copies)
end
return AccessoryConfig
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_HACK_REQUIREMENTS_V13"><Properties><string name="Name">HackRequirements</string><ProtectedString name="Source">-- Steal60 v13: server authoritative lock requirement from district + body type + rarity.
-- Five districts: 1-5 / 5-10 / 10-15 / 15-20 / 20-25. Shared level at borders.
-- One vehicle's required level is fixed at spawn and shown above that vehicle.
local Req = {}
Req.DistrictMin = { 1, 5, 10, 15, 20 }
Req.DistrictMax = { 5, 10, 15, 20, 25 }
Req.RarityExtra = { common=0, rare=1, epic=2, legendary=3 }
Req.BodyExtra = {
  -- Sedans and compact city cars are simplest. SUVs +1, large utility +2.
  sedan=0, classic=0, executive=0, limo=0, micro=0, hatch=0,
  liftback=0, wagon=0, grandwagon=0, coupe=0, gt=0, grandgt=0,
  roadster=0, muscle=0, speedster=0,
  suv=1, crossover=1, fullsuv=1, offroad=1, widebody=1,
  van=2, minivan=2, pickup=2, hyper=2, supergt=2, track=2, ev=1,
}
function Req.get(districtIndex, carDef, rarity)
  local index = math.clamp(math.floor(tonumber(districtIndex) or 1), 1, #Req.DistrictMin)
  local shape = carDef and carDef.shape or 'sedan'
  local body = Req.BodyExtra[shape] or 0
  local rare = Req.RarityExtra[rarity] or 0
  return math.clamp(Req.DistrictMin[index] + body + rare,
    Req.DistrictMin[index], Req.DistrictMax[index])
end
function Req.range(districtIndex)
  local index = math.clamp(math.floor(tonumber(districtIndex) or 1), 1, #Req.DistrictMin)
  return Req.DistrictMin[index], Req.DistrictMax[index]
end
function Req.canHack(data,required)
 local level=tonumber(data and data.hackLevel)or 1;local need=tonumber(required)or 1
 if level~=level or need~=need or level==math.huge or need==math.huge then return false end
 return math.floor(level)&gt;=math.max(1,math.floor(need))
end
return Req
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_V33_COIN_UPGRADE_CONFIG">
            <Properties>
              <string name="Name">CoinUpgradeConfig</string>
              <ProtectedString name="Source">-- Free progression. Costs use ordinary earned coins; diamonds remain Robux-only.
local U={
 {id="income",name="Увеличить доход",detail="+4% к доходу кассы",base=90,growth=1.9,max=24,icon="💵"},
 {id="security",name="Улучшить охрану",detail="Замедляет налёты игроков и чаще ловит НПС",base=2400,growth=8,max=5,icon="🛡"},
 {id="speed",name="Доработать двигатель",detail="+1 к максимальной скорости",base=4500,growth=2.5,max=12,icon="🚗"},
 {id="botSpeed",name="Обучить помощника",detail="Быстрее возвращает машину",base=3000,growth=2.45,max=12,icon="👷"},
 {id="shelves",name="Дополнительная полка",detail="+3 места для добычи в гараже",base=180000,growth=18,max=2,icon="📦"},
}
U.ById={}
for _,v in ipairs(U) do U.ById[v.id]=v end
function U.cost(id,level)
 local v=U.ById[id]
 if not v or type(level)~="number" or level&lt;0 or level&gt;=v.max then return nil end
 if id=="income"and level==0 then return 45 end
 return math.floor(v.base*v.growth^level+0.5)
end
return U
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX_V34_VIP_CONFIG">
            <Properties>
              <string name="Name">VIPConfig</string>
              <ProtectedString name="Source">-- STEAL60 VIP subscription packs (bought with diamonds only).
-- Prices are test values. Edit here without changing saved VIP expiration.
-- Diamonds remain obtainable only via verified Roblox Developer Product receipts
-- (except the explicitly whitelisted developer test account).
local VIP={}
VIP.BONUS_COINS_PCT=30  -- bonus to base heist payout, additive with item bonuses
VIP.BONUS_XP_PCT=25     -- bonus to skill XP earned on a delivered car
VIP.CASH_HOURS=48       -- maximum uncollected till accumulation window
VIP.NORMAL_CASH_HOURS=12
VIP.MAX_EXTEND_DAYS=3650
VIP.Plans={
    {id="day", name="ВИП · 1 ДЕНЬ", days=1, diamonds=40, icon="☀"},
    {id="week", name="ВИП · 7 ДНЕЙ", days=7, diamonds=200, icon="★"},
    {id="month", name="ВИП · 30 ДНЕЙ", days=30, diamonds=650, icon="◆"},
}
VIP.ById={}
for _,plan in ipairs(VIP.Plans) do VIP.ById[plan.id]=plan end
return VIP
</ProtectedString>
            </Properties>
          </Item>
        <Item class="ModuleScript" referent="RBXGEN_V37_CosmeticConfig">
          <Properties>
            <string name="Name">CosmeticConfig</string>
            <ProtectedString name="Source">-- STEAL60 v38: hero and pet collector upgrades, plus cosmetic car styles.
-- IDs remain permanent across updates; never reuse an ID for a different item.
local C=Color3.fromRGB
local M={}
local Balance=require(script.Parent.EconomyBalance)
-- Global, persistent bonuses; one point per purchase, never attached to a specific appearance.
M.HERO_MAX=30
M.PET_MAX=60
M.PET_LICENSE_COINS=18000
M.PET_LICENSE_DIAMONDS=240
function M.heroUpgradeCoins(level)return Balance.masteryCost('hero',level)end
function M.heroUpgradeDiamonds(level)
 level=math.clamp(math.floor(tonumber(level) or 0),0,M.HERO_MAX)
 if level&gt;=M.HERO_MAX then return nil end
 return 20
end
function M.petUpgradeCoins(level)return Balance.masteryCost('pet',level)end
function M.petUpgradeDiamonds(level)
 level=math.clamp(math.floor(tonumber(level) or 0),0,M.PET_MAX)
 if level&gt;=M.PET_MAX then return nil end
 return 20
end
